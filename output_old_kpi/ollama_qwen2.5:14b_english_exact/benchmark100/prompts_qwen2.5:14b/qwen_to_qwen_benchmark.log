---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Easyrsa init-pki
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa init-pki"
  args:
    creates: /etc/openvpn/easy-rsa/pki/index.txt

- name: Easyrsa build-ca
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa build-ca nopass"
  args:
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Easyrsa gen-dh
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa gen-dh"
  args:
    creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa build-server-full server nopass"
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa build-client-full client nopass"
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

- name: Easyrsa gen-crl
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa gen-crl"
  args:
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  with_items:
    - src: "{{ easy_rsa_path }}/pki/ca.crt"
      dest: /etc/openvpn/server/ca.crt
      mode: '0644'
    - src: "{{ easy_rsa_path }}/pki/tls-crypt.key"
      dest: /etc/openvpn/server/tls-crypt.key
      mode: '0600'
    - src: "{{ easy_rsa_path }}/pki/dh.pem"
      dest: /etc/openvpn/server/dh.pem
      mode: '0644'
    - src: "{{ easy_rsa_path }}/pki/issued/server.crt"
      dest: /etc/openvpn/server/server.crt
      mode: '0644'
    - src: "{{ easy_rsa_path }}/pki/private/server.key"
      dest: /etc/openvpn/server/server.key
      mode: '0600'
    - src: "{{ easy_rsa_path }}/pki/ta.key"
      dest: /etc/openvpn/server/ta.key
      mode: '0600'

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  with_items:
    - src: "{{ easy_rsa_path }}/pki/ca.crt"
      dest: /etc/openvpn/ca.crt
      mode: '0644'
    - src: "{{ easy_rsa_path }}/pki/crl.pem"
      dest: /etc/openvpn/crl.pem
      mode: '0644'

- name: Place server.conf
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify: restart openvpn


