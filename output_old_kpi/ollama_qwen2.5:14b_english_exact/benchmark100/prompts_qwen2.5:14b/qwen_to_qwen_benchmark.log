  include_tasks: install_package.yml

- name: Install repository for RedHat
  include_tasks: repo_redhat.yml

- name: Configure debian
  include_tasks: repo_debian.yml

- name: Install required package gpg
  apt:
    name: gnupg2
    state: present
  when: ansible_os_family == "Debian"

- name: Install apt key for Debian
  apt_key:
    data: "{{ hashicorp_gpg_key }}"
    id: "{{ hashicorp_gpg_id }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install repository for Debian
  apt_repository:
    filename: "/etc/apt/sources.list.d/hashicorp.list"
    filename_hash: sha256
    repo: "deb {{ hashicorp_repo_url }} {{ ansible_distribution_release }} {{ ansible_distribution_version }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  include_tasks: install_package_no_version.yml

- name: Install versioned hashicorp product using package
  include_tasks: install_package_version.yml

- name: Install manually
  include_tasks: install_manual.yml

- name: Install hashicorp product manually
  unarchive:
    src: "{{ hashicorp_source_file }}"
    dest: "{{ hashicorp_install_dir }}"
    remote_src: yes
    owner: "{{ hashicorp_owner }}"
    group: "{{ hashicorp_group }}"
    mode: "{{ hashicorp_mode }}"
  when: hashicorp_install_method == "manual"


