---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  lineinfile:
    dest: /etc/dpkg/dpkg.cfg.d/01_nodistupgrade
    create: yes
    line: 'avoid-upgrade postfix'
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postix_virtual_alias_maps is defined

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify: [validate_transport_maps, rebuild_transport_maps]

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify: [validate_header_checks, reload_postfix]

- name: Setting values for main.cf (1/2)
  set_fact:
    main_cf_restriction_recipient: "{{ 'check_sender_access pcre:/etc/postfix/sender_access' if postfix_sender_access is defined else '' }}"
    main_cf_restriction_sender: "{{ 'check_recipient_access pcre:/etc/postfix/recipient_access' if postfix_recipient_access is defined else '' }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    main_cf_mynetworks: "{{ postfix_mynetworks if postfix_mynetworks is defined else '127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128' }}"
    main_cf_mydestination: "{{ postfix_mydestination if postfix_mydestination is defined else 'localhost {{ ansible_fqdn }}' }}"
    main_cf_relay_domains: "{{ postfix_relay_domains if postfix_relay_domains is defined else [] }}"
    main_cf_smtpd_recipient_restrictions: "{{ main_cf_restriction_recipient if main_cf_restriction_recipient is defined else '' }}"
    main_cf_smtpd_sender_restrictions: "{{ main_cf_restriction_sender if main_cf_restriction_sender is defined else '' }}"
    main_cf_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains if postfix_virtual_mailbox_domains is defined else [] }}"
    main_cf_virtual_alias_domains: "{{ postfix_virtual_alias_domains if postfix_virtual_alias_domains is defined else [] }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: [validate_main_cf, restart_postfix]

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: [validate_master_cf, restart_postfix]

- name: Creates cert/key directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: 0700
  with_items:
    - {path: "{{ postfix_smtpd_tls_cert_file | dirname }}"}
    - {path: "{{ postfix_smtpd_tls_key_file | dirname }}"}

- name: Deploy Postfix TLS server certificate
  copy:
    src: tls_cert_file
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: 0644
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: tls_key_file
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: 0600
  notify: reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    src: aliases
    dest: /etc/postfix/aliases
  notify: [rebuild_aliases, reload_postfix]

- name: Configure sender_access
  copy:
    src: sender_access
    dest: /etc/postfix/sender_access
  notify: [rebuild_sender_access, reload_postfix]

- name: Configure recipient_access
  copy:
    src: recipient_access
    dest: /etc/postfix/recipient_access
  notify: [validate_recipient_access, rebuild_recipient_access, reload_postfix]

- name: Place sasl_password_map
  copy:
    src: sasl_password_map
    dest: /etc/postfix/sasl_password_map
  notify: rebuild_sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: true

