---
- name: Download RKE2 kubeconfig to localhost
  copy:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    remote_src: yes
  delegate_to: localhost
  when: rke2_download_kubeconf | default(false) and inventory_hostname == groups['rke2_servers_group_name'][0]

- name: Replace loopback IP by master server IP
  ansible.builtin.replace:
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: '(127\\.0\\.0\\.1|::1)'
    replace: "{{ rke2_api_ip | default(groups['rke2_servers_group_name'][0]['ansible_all_ipv4_addresses'][0]) }}"
  when: not ansible_check_mode and rke2_download_kubeconf | default(false) and inventory_hostname == groups['rke2_servers_group_name'][0]


