---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/bin/python3.11/EXTERNALLY-MANAGED
    state: file
  register: python3_11_file_exists
  changed_when: false

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: /usr/bin/python3.11/EXTERNALLY-MANAGED
    dest: /usr/bin/python3.11/EXTERNALLY-MANAGED.old
    state: link
  when: python3_11_file_exists.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/bin/python3.12/EXTERNALLY-MANAGED
    state: file
  register: python3_12_file_exists
  changed_when: false

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: /usr/bin/python3.12/EXTERNALLY-MANAGED
    dest: /usr/bin/python3.12/EXTERNALLY-MANAGED.old
    state: link
  when: python3_12_file_exists.stat.exists

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  remote_src: yes
  when: True

- name: Install python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ansible.builtin.template:
    src: templates/pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host'
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: latest
    extra_args: "--upgrade --upgrade-strategy eager"
  when: python_pip_update and ansible_facts.os_info.release not in ['bookworm', 'noble'] and ansible_facts.os_info.name != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: ansible_facts.os_info.release not in ['bookworm', 'noble'] and ansible_facts.os_info.name != 'Alpine'


