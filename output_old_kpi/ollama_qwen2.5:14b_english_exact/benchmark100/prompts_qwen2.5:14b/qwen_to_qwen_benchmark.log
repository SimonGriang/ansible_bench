---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  ansible.builtin.a2enmod:
    modnames: [proxy, proxy_http]
  when: ansible_facts['os_family'] in ['Debian', 'Suse']

- name: Use location.conf.j2 template to configure Apache location blocks
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  with_items: "{{ httpd_locations }}"
  notify: httpd configuration test and restart

- name: Ensure httpd service is reloaded
  ansible.builtin.meta:
    invoke: handler


