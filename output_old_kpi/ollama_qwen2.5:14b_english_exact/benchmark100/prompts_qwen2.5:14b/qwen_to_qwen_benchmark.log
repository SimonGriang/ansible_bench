---
- import_tasks: assert.yml
  remote_user: root
  run_once: true
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"
  notify:
    - set_root_password
    - systemctl_daemon_reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    line: "{{ item.option }} = {{ item.value }}"
    create: yes
  loop: "{{ mysql_configuration_options }}"
  notify: restart_mysql_server

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    line: "socket={{ mysql_socket_path }}"
    create: yes

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when:
    - ansible_facts['os_family'] == 'Alpine'
    - ansible_facts['os_family'] == 'Archlinux'

- name: Start and enable mysql
  service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  become: true
  become_user: root

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  become: true
  become_user: root

- name: Flush handlers again
  meta: flush_handlers


