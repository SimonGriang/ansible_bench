- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL=/bin/bash"
    mode: '0644'
  notify: restart_cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    mode: '0644'
  notify: restart_cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ mailto }}"
    mode: '0644'
  notify: restart_cron

- name: Start and enable cron
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ""
  tags: cron

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_time: "{{ item.special_time }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs | length > 0
  tags: cron_jobs


