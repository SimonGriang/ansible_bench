---
- name: Ensure the unzip package is available on the target system
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - apt:
        name: unzip
        state: latest
        update_cache: yes
    - yum:
        name: unzip
        state: latest

- name: Create a system group for promtail
  ansible.builtin.group:
    name: promtail
    system: yes
    state: present
    gid: null
    append: no
    ignore_errors: no
    state: present

- name: Create the promtail user
  ansible.builtin.user:
    name: promtail
    system: yes
    state: present
    shell: /usr/sbin/nologin
    group: promtail
    groups: null
    append: no
    create_home: no
    uid: null
    gid: promtail
    password: ''
    expires: ''
    move_home: no
    generate_ssh_key: no
    ssh_key_bits: 2048
    ssh_key_file: ''
    ssh_key_options: ''
    ssh_key_type: rsa
    umask: 077
    update_password: on_create
    purge_ssh_keys: no
    remove: no
    shell: /usr/sbin/nologin
    state: present

- name: Ensure the /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: promtail
    group: promtail
    recurse: no
  loop:
    - { path: /etc/promtail, mode: '0750' }
    - { path: /etc/promtail/config, mode: '0750' }

- name: Create application directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: promtail
    group: promtail
    recurse: no
  loop:
    - { path: /opt/promtail, mode: '0755' }
    - { path: /opt/promtail/bin, mode: '0755' }

- name: Check if the promtail binary exists
  ansible.builtin.stat:
    path: /opt/promtail/bin/promtail
  register: promtail_binary_stat

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: https://github.com/prometheus/promtail/releases/download/v{{ promtail_version }}/promtail-{{ promtail_version }}.linux.amd64.tar.gz
    dest: /tmp/promtail.tar.gz
  when: promtail_binary_stat.stat is defined and not promtail_binary_stat.stat.exists and promtail_binary_distributed == 'remote'

- name: Propagate locally distributed promtail archive
  ansible.builtin.copy:
    src: /local/path/to/promtail.tar.gz
    dest: /tmp/promtail.tar.gz
  when: promtail_binary_stat.stat is defined and not promtail_binary_stat.stat.exists and promtail_binary_distributed == 'local'

- name: Download promtail binaries to controller node
  ansible.builtin.get_url:
    url: https://github.com/prometheus/promtail/releases/download/v{{ promtail_version }}/promtail-{{ promtail_version }}.linux.amd64.tar.gz
    dest: /tmp/promtail.tar.gz
  when: promtail_binary_stat.stat is defined and not promtail_binary_stat.stat.exists and promtail_binary_distributed == 'remote-propagation'

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: /tmp/promtail.tar.gz
    dest: /tmp/promtail.tar.gz
  when: promtail_binary_stat.stat is defined and not promtail_binary_stat.stat.exists and promtail_binary_distributed == 'local-propagation'

- name: Unpack promtail binaries
  ansible.builtin.unarchive:
    src: /tmp/promtail.tar.gz
    dest: /opt/promtail/bin
    extra_opts: --strip-components=1
    creates: /opt/promtail/bin/promtail
    mode: 0755
    remote_src: yes
    remote_src: yes
    no_ignore_errors: no

- name: Create symlink to latest version
  ansible.builtin.file:
    src: /opt/promtail/bin/promtail
    dest: /usr/local/bin/promtail
    state: link
  notify:
    - restart promtail service

- name: Write configuration
  ansible.builtin.template:
    src: templates/promtail-config.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0640'
    owner: promtail
    group: promtail
  notify:
    - restart promtail service

- name: Create systemd service unit
  ansible.builtin.template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  notify:
    - restart promtail service

- name: Ensure promtail service is enabled and running
  ansible.builtin.service:
    name: promtail
    enabled: yes
    state: started
  when: promtail_enabled is defined and promtail_enabled

- name: Ensure promtail service is disabled and stopped
  ansible.builtin.service:
    name: promtail
    enabled: no
    state: stopped
  when: promtail_enabled is defined and not promtail_enabled

- name: Ensure promtail service is restarted
  ansible.builtin.service:
    name: promtail
    state: restarted
  notify:
    - restart promtail service

  handlers:
    - name: restart promtail service
      ansible.builtin.service:
        name: promtail
        state: restarted


