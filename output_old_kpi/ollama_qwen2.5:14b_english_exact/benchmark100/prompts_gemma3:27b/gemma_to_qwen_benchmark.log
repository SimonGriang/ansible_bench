---
- import_tasks: assert.yml
  remote_user: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  block:
    - name: Ensure pip configuration directory exists
      file:
        path: /etc/pip.conf
        state: touch
        mode: '0644'
    - name: Configure pip proxy settings
      lineinfile:
        path: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        regexp: '^index-url\s*=\s*'
        insertafter: EOF
  when: python_pip_proxy is defined

- name: Trust hosts
  block:
    - name: Ensure pip configuration directory exists
      file:
        path: /etc/pip.conf
        state: touch
        mode: '0644'
    - name: Configure trusted hosts
      lineinfile:
        path: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        regexp: '^trusted-host\s*=\s*'
        insertafter: EOF
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: ansible_distribution not in ['Debian'] and ansible_distribution_release not in ['bookworm', 'noble', 'alpine']

- name: Install requested modules
  pip:
    name: "{{ item }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution not in ['Debian'] and ansible_distribution_release not in ['bookworm', 'noble', 'alpine']
  loop_control:
    label: "{{ item.name }}"

