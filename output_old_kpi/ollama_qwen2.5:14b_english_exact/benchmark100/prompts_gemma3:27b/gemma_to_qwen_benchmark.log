---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "{{ helm_bin_path }} version"
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download helm
  unarchive:
    src: "{{ helm_repo_url }}{{ helm_repo_path }}-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: yes
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout.find(helm_version) == -1

- name: Copy helm binary into place
  copy:
    src: /tmp/{{ helm_platform }}-{{ helm_arch }}/helm
    dest: "{{ helm_bin_path }}"
    mode: 0755
    remote_src: yes
  become: true
  when: helm_download.changed

