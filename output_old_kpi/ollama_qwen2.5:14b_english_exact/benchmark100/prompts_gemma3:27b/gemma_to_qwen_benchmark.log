        state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB
  block:
    - name: Copy DEB to /tmp/
      copy:
        src: "{{ java_deb_path }}"
        dest: /tmp/oracle-java.deb
    - name: Install Oracle Java DEB
      package:
        name: /tmp/oracle-java.deb
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ oracle_java_rpm_name }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ java_install_dir }}"
        state: directory
        mode: '0755'
    - name: Extract Oracle Java Archive
      unarchive:
        src: "{{ java_targz_path }}"
        dest: "{{ java_install_dir }}"
        remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_zip_path }}"
    dest: "{{ java_install_dir }}/lib/security"
    remote_src: yes
  when: java_jce is true and java_version == 8 and java_vendor == "oracle"

- name: Set alternative (targz)
  command: alternatives --install /usr/bin/java java /usr/java/default/bin/java 20000 --slave /etc/alternatives/java_sdk /usr/java/default/bin/java --slave /etc/alternatives/java_javac /usr/java/default/bin/javac --slave /etc/alternatives/java_jar /usr/java/default/bin/jar
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_home_res
  changed_when: false
  delegate_to: localhost

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME={{ java_home_res.stdout.split("/")[:-1]|join("/") }}'
    create: yes
  when: java_home_res is changed
```


