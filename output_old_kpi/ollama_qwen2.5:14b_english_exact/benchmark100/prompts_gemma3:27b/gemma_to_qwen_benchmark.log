  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    host: "{% if 'ansible_ssh_host' in ansible_host|d('', true) %}{{ ansible_ssh_host }}{% else %}{{ ansible_host | default(inventory_hostname) }}{% endif %}"
    timeout: "{{ bootstrap_timeout }}"
  connection: local
  when: >
    ansible_connection not in ['docker', 'container'] and bootstrap_wait_for_host | default(true) | bool

- name: Prepare the system
  block:
    - name: Test the connection
      wait_for_connection:
      register: bootstrap_connect
      failed_when: bootstrap_connect is not defined

    - name: Debug connection timeout if connection fails
