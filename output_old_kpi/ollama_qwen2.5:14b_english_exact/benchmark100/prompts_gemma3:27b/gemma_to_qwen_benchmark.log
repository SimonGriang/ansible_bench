---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    regexp: '^SHELL='
    create: true
    mode: "0600"
  notify: Restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    regexp: '^PATH='
    create: true
    mode: "0600"
  notify: Restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    regexp: '^MAILTO='
    create: true
    mode: "0600"
  notify: Restart cron

- name: Start and enable cron
  ansible.builtin.service:
    name: "{{ cron_service }}"
    enabled: true
    state: started
  when: cron_service is defined and cron_service|length > 0

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined

