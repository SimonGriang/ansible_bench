```yaml
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install using package
  block:
    - name: Install repository for RedHat
      copy:
        dest: /etc/yum.repos.d/hashicorp.repo
        src: "{{ lookup('file', 'hashicorp_repo_rhel') }}"
        mode: 0640
      when: ansible_os_family in ['RedHat', 'Rocky']

    - name: Configure debian
      block:
        - name: Install required package gpg
          apt:
            name: gpg
            state: present
          when: ansible_os_family == 'Debian'

        - name: Install apt key for Debian
          apt_key:
            url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x5a3803c0d9f8d4d5e5b8d64a631b1d96a52c8f7b
            validate_certs: false
          when: ansible_os_family == 'Debian'

        - name: Install repository for Debian
          apt_repository:
            repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
            state: present
          when: ansible_os_family == 'Debian'
      when: ansible_os_family == 'Debian'

    - name: Install hashicorp product using package
      block:
        - name: Install latest hashicorp product using package
          package:
            name: "{{ item }}"
            state: latest
          loop: "{{ hashicorp_products }}"
          when: hashicorp_products | default([]) | count > 0
          loop_control:
            label: "Installing {{ item }}"
          register: install_result

        - name: Install versioned hashicorp product using package
          package:
            name: "{{ item.name }}{{ version_coupler }}{{ item.version }}"
            state: present
          loop: "{{ hashicorp_products }}"
          when: item.version is defined
          loop_control:
            label: "Installing {{ item.name }} {{ item.version }}"
          register: install_result
      when: hashicorp_products | default([]) | count > 0
  when: hashicorp_installation_method == 'package'

- name: Install manually
  block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ item.src }}"
        dest: "{{ item.destination_directory }}"
        remote_src: yes
        group: "{{ item.group | default('root') }}"
        mode: "{{ item.mode | default('0755') }}"
        owner: "{{ item.owner | default('root') }}"
      loop: "{{ hashicorp_products }}"
      when: hashicorp_installation_method == 'manual'
      loop_control:
        label: "Installing {{ item.name }}"
      register: install_result
