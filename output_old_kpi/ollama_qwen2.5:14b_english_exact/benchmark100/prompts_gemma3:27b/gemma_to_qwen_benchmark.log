Description Task 2: Configure sudo access for a group by templating a sudoers file. The template `sudo_group.j2` is used, and the resulting file is placed in `/etc/sudoers.d/` with a name derived from `group.name` (replacing periods with "dot"). The file permissions are set to 0640, and visudo is used to validate the file. This task only runs if the variable `group.sudo_options` is defined. The loop control label is set to the `group.name`.


- Last generated (faulty) playbook: 
---
- name: Manage group
  ansible.builtin.group:
    name: "{{ group.name }}"
    state: "{{ group.state | default('present') }}"
    gid: "{{ group.gid | default('') }}"
    system: "{{ group.system | default('no') | lower }}"

- name: Set sudo options for group
  ansible.builtin.template:
    src: sudo_group.j2
    dest: /etc/sudoers.d/{{ group.name | replace('.', 'dot') }}
    owner: root
    group: root
    mode: '0640'
  when: group.sudo_options is defined
  loop_control:
    label: "{{ group.name }}"
  become: true
  become_user: root
  notify: Validate sudoers file

