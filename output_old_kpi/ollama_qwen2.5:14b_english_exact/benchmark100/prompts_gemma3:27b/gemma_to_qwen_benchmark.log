---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: "{{ rke2_template_source }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0640'
    owner: root
    group: root
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ rke2_template_source }}"
    dest: /etc/rancher/rke2/kubelet.yaml
    mode: '0640'
    owner: root
    group: root
  notify: Config file changed
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_template_source }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0640'
    owner: root
    group: root
  notify: Config file changed
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and rke2_server.service is defined and rke2_server.service.enabled == false }}"
  when: rke2_etcd_snapshot_file is defined

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined }}"
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create destination directory
      file:
        path: /var/lib/rancher/rke2/agent/kubelet/pods
        state: directory
        mode: '0750'

    - name: Copy snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/kubelet/pods/etcd-snapshot.tar.gz
        mode: '0640'
        owner: root
        group: root

    - name: Restore etcd
      command: "{{ rke2_server_command }} etcd --snapshot=/var/lib/rancher/rke2/agent/kubelet/pods/etcd-snapshot.tar.gz --data-dir=/var/lib/rancher/rke2/agent/etcd"
      args:
        warn: false

- name: Restore etcd from s3
  command: "{{ rke2_server_command }} etcd --snapshot-s3={{ rke2_etcd_snapshot_s3_options }}"
  args:
    warn: false
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    enabled: yes
    state: started
    environment: "RKE2_TOKEN={{ rke2_token }}"
