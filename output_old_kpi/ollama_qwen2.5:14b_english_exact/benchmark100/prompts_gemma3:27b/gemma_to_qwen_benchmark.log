---
- name: Download RKE2 installation script
  block:
    - name: Download RKE2 installation script
      get_url:
        url: "{{ rke2_install_url }}"
        dest: "/usr/local/bin/{{ rke2_installer_script }}"
      when: not airgap_mode

- name: Copy local RKE2 installation script
  block:
    - name: Copy RKE2 installation script
      copy:
        src: "{{ rke2_installer_local_path }}"
        dest: "/usr/local/bin/{{ rke2_installer_script }}"
      when: airgap_mode and rke2_installer_implementation == 'copy'

- name: Create RKE2 artifacts folder
  block:
    - name: Create RKE2 artifacts folder
      file:
        path: "{{ rke2_artifact_path }}"
        state: directory
        mode: '0755'
      when: airgap_mode and rke2_installer_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Attempt to download RKE2 artifacts and checksums remotely
      get_url:
        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_artifact_path }}/"
      when: airgap_mode
      register: remote_download_result
      until: remote_download_result is success or remote_download_result is skipped
      retries: 3
      delay: 10
    - name: Download locally and copy to remote hosts
      block:
        - name: Download RKE2 artifacts locally
          get_url:
            url: "{{ rke2_local_artifact_url }}"
            dest: "{{ rke2_local_artifact_path }}/"
        - name: Copy RKE2 artifacts to remote hosts
          copy:
            src: "{{ rke2_local_artifact_path }}/"
            dest: "{{ rke2_artifact_path }}/"
      when: airgap_mode and not remote_download_result is success

- name: Copy local RKE2 artifacts
  block:
    - name: Copy local RKE2 artifacts
      copy:
        src: "{{ rke2_local_artifact_path }}/"
        dest: "{{ rke2_artifact_path }}/"
      when: airgap_mode and rke2_installer_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Copy additional tarball images for RKE2 components
      copy:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
      loop: "{{ rke2_additional_images }}"
      when: airgap_mode and item is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts exist and have appropriate permissions
      file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: '0644'
      loop: "{{ rke2_artifacts }}"
      when: airgap_mode and airgap_artifact_check and item.stat.mode | int > 644

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  filesystem_stat:
    path: /usr/local

- name: Check if separate partition
  block:
    - name: Determine if /usr/local is on a separate partition
      setup:
      register: facts
    - name: Check if /usr/local is on a separate partition
      set_fact:
        separate_partition: "{{ facts.ansible_facts.filesystem.stat.mnt.usr_local.stat.dev != facts.ansible_facts.filesystem.stat.dev }}"
      when: not facts.ansible_facts.filesystem.stat.mnt.usr_local.stat.dev == facts.ansible_facts.filesystem.stat.dev

- name: Set RKE2 bin path
  block:
    - name: Set the path to the RKE2 binary based on filesystem configuration
      set_fact:
        rke2_bin_path: "{{ rke2_bin_path }}"
      when: facts.ansible_facts.filesystem.stat.mnt.usr_local.stat.dev == facts.ansible_facts.filesystem.stat.dev

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_check
  failed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_check.stdout_lines[0] }}"
    rke2_running_version: "{{ rke2_version_check.stdout_lines[2] }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_running_version is version('>=', rke2_target_version)
    fail_msg: "Downgrade to RKE2 version {{ rke2_target_version }} is not allowed unless explicitly permitted."
    success_msg: "RKE2 downgrade to {{ rke2_target_version }} is permitted."

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }}/rke2 install --token={{ rke2_token }} --install-rke2-server --kubelet-arg='RotateKubeletServerCertificate=true' --kubelet-arg='RotateKubeletVolumeOwnership=true' --kubelet-arg='RotateKubeletClientCertificate=true'"
  environment:
    KUBECONFIG: "/etc/rancher/rke2/rke2.yaml"
    RKE2_DATASTORE_ENDPOINT: "etcd://{{ rke2_etcd_endpoint }}"
    RKE2_ETCD_CA_FILE: "/etc/rancher/rke2/etcd-ca.pem"
    RKE2_ETCD_CERT_FILE: "/etc/rancher/rke2/etcd-client.pem"
    RKE2_ETCD_KEY_FILE: "/etc/rancher/rke2/etcd-client-key.pem"

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_dir }}/manifests/"
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_dir }}/static-pods/"
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_data_dir }}/env.yaml"}


