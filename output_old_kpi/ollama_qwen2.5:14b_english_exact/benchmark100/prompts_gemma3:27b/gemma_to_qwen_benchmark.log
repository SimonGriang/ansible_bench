---
- import_tasks: assert.yml
  remote_user: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_name }}-server.cnf"
    line: "{{ item }}"
    create: yes
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_name }}-client.cnf"
    line: "socket={{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    target: "{{ item.target | default('') }}"
    encoding: "{{ item.encoding | default('utf8') }}"
    collation: "{{ item.collation | default('utf8_general_ci') }}"
  loop: "{{ mysql_databases }}"
  become_user: root
  become: yes
  login_user: root
  login_password: "{{ mysql_root_password }}"
  login_host: localhost
  login_port: 3306
  login_unix_socket: "{{ mysql_socket }}"

- name: List databases
  mysql_info:
    pattern: ".+"
  register: mysql_info_output
  become_user: root
  become: yes
  login_user: root
  login_password: "{{ mysql_root_password }}"
  login_host: localhost
  login_port: 3306
  login_unix_socket: "{{ mysql_socket }}"
  vars:
    msg: "{{ mysql_info_output | to_json }}"
  tags: debug

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import_target | default('') }}"
    import: "{{ item.target }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import_target is defined and item.initial_import_target != ''
  become_user: root
  become: yes
  login_user: root
  login_password: "{{ mysql_root_password }}"
  login_host: localhost
  login_port: 3306
  login_unix_socket: "{{ mysql_socket }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host | default('localhost') }}"
  loop: "{{ mysql_users }}"
  become_user: root
  become: yes
  login_user: root
  login_password: "{{ mysql_root_password }}"
  login_host: localhost
  login_port: 3306
  login_unix_socket: "{{ mysql_socket }}"

- name: Flush handlers again
  meta: flush_handlers

