"{{ python_pip_modules }}"\n  when: >\n    (ansible_distribution != "Debian" or (ansible_distribution == "Debian" and (ansible_distribution_release != \'bookworm\' and ansible_distribution_release != \'noble\')))\n    and ansible_os_family != "Alpine"\n  label: "Install module {{ item.name }}"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-05T23:33:26.20196226Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11417441439, 'load_duration': 92807397, 'prompt_eval_count': 989, 'prompt_eval_duration': 400042928, 'eval_count': 627, 'eval_duration': 10909686466, 'model_name': 'qwen2.5:14b'} id='run--859c188a-ce1e-4782-8950-b9316c349b7c-0' usage_metadata={'input_tokens': 989, 'output_tokens': 627, 'total_tokens': 1616}
