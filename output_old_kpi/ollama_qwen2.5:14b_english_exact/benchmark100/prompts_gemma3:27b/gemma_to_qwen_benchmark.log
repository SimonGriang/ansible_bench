  meta: flush_handlers

- name: Configure selinux
  when: ansible_selinux.status is defined and not ansible_facts.systemd.unit == 'docker'
  selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  notify: Reboot

- name: Manage selinux booleans
  when: selinux_booleans is defined
  block:
    - name: Set selinux boolean state
      seboolean:
        name: "{{ item.boolean }}"
        value: "{{ item.value|default('yes') }}"
        persist: "{{ item.persist|default(true) }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.boolean }}"

