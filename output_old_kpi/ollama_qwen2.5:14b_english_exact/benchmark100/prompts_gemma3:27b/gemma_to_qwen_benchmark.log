d.conf.j2\n    dest: /etc/named.conf\n    mode: 0640\n    owner: "{{ dns_owner }}"\n    group: "{{ dns_group }}"\n  notify: Restart dns\n\n- name: Place systemd override\n  block:\n    - file:\n        path: /etc/systemd/system/{{ dns_service }}.d\n        state: directory\n        mode: 0755\n        owner: root\n        group: root\n      when: ansible_systemd\n    - copy:\n        src: "{{ item }}"\n        dest: /etc/systemd/system/{{ dns_service }}.d/{{ item | basename }}\n        mode: 0644\n        owner: root\n        group: root\n      when: ansible_systemd\n    - command: systemctl daemon-reload\n      when: ansible_systemd\n  loop:\n    - templates/systemd_override.conf.j2\n\n- name: Start and enable dns\n  service:\n    name: "{{ dns_service }}"\n    enabled: yes\n    state: started' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-05T23:17:30.451729156Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11113524008, 'load_duration': 80502416, 'prompt_eval_count': 758, 'prompt_eval_duration': 282071865, 'eval_count': 745, 'eval_duration': 10736979696, 'model_name': 'qwen2.5:14b'} id='run--2aee0de5-d1a7-4b0b-9352-ac94a7c4df86-0' usage_metadata={'input_tokens': 758, 'output_tokens': 745, 'total_tokens': 1503}
