---
- name: Run assert tasks
  assert:
    that: true
  src: assert.yml
  dest: /dev/null
  when: False
  register: assert_result
  changed_when: assert_result is defined

- name: Install vsftpd package
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd using a template
  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode }}"
  notify: Restart vsftpd

- name: Start and enable vsftpd service
  systemd:
    name: vsftpd
    state: started
    enabled: yes

