---
- name: Task 1: Create and configure vault file
  copy:
    dest: /etc/vault/config.json
    content: |
      {
        "disable_pgp_key": true,
        "disable_prerelease": true
      }
    owner: root
    group: root
    mode: '0644'

- name: Task 2: Limit vault service to localhost
  lineinfile:
    path: /etc/ssh/sshd_config
    regexp: '^#*.*ListenAddress'
    line: 'ListenAddress 127.0.0.1'
    insertafter: 'EOL'
    owner: root
    group: root
    mode: '0644'

- name: Task 3: Configure vault service to start at boot
  systemd:
    name: vault
    enabled: yes
    state: started

- name: Task 4: Configure SELinux / AppArmor
  block:
    - name: Ensure SELinux policy is targeted and enforcing
      when: vault_hardening_configure_selinux_apparmor|default(false) and ansible_facts['ansible_selinux']['status'] == "enabled"
      package:
        name: selinux-policy
        state: present
      setsebool:
        name: targeted
        state: on
    - name: Ensure AppArmor is configured if enabled
      when: vault_hardening_configure_selinux_apparmor|default(false) and ansible_facts['ansible_apparmor']['status'] == "enabled"
      # Add AppArmor configuration tasks here if needed
      debug:
        msg: "AppArmor configuration is not implemented yet."


