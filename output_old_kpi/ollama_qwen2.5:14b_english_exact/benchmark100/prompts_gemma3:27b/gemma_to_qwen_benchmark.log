---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: /usr/local/bin/rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0640'
  notify: restart_rke2_service

- name: Copy kubelet config
  copy:
    src: /usr/local/bin/kubelet.yaml.j2
    dest: /etc/systemd/system/rke2.kubelet.service
    owner: root
    group: root
    mode: '0640'
  when: rke2_kubelet_config|length > 0
  notify: restart_rke2_service

- name: Copy Containerd Registry Configuration file
  copy:
    src: /usr/local/bin/containerd-template.toml.j2
    dest: /etc/rancher/rke2/90-containerd-registry.toml
    owner: root
    group: root
    mode: '0640'
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0
  notify: restart_rke2_service

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2
    state: started
    enabled: yes
    daemon_reload: yes
    environment: 'RKE2_TOKEN={{ rke2_token }}'
  retries: 10
  delay: 10
  register: rke2_start
  notify: restart_rke2_service

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: rke2-{{ rke2_type }}
    state: masked
    enabled: no
  when: rke2_type not in ['agent', 'server']

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    set -euo pipefail
    until kubectl get nodes --no-headers | grep -c 'Ready' | grep -q '^{{ groups['rke2_servers']|length }}$' || kubectl get nodes --no-headers | grep -c 'NotReady' | grep -q '^{{ groups['rke2_servers']|length }}$'; do
      sleep 1
    done
  args:
    executable: /bin/bash
  when: rke2_cni == 'none' and (inventory_hostname == rke2_active_server or inventory_hostname == rke2_first_server)

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    set -euo pipefail
    until kubectl get nodes -o json | jq -r '.items[] | select(.status.conditions[] | .type == "Ready" and .status == "True") | .metadata.name' | wc -l | grep -q '^{{ groups['rke2_servers']|length }}$'; do
      sleep 1
    done
  args:
    executable: /bin/bash
  when: rke2_cni != 'none' and (inventory_hostname == rke2_active_server or inventory_hostname == rke2_first_server)

