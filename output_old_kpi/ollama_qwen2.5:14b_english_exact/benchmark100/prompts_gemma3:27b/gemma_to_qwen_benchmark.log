---
- name: Ensure the easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize the easy-rsa PKI
  ansible.builtin.command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  register: pki_init_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/index.txt').exists)

- name: Build the Certificate Authority (CA)
  ansible.builtin.command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  register: ca_build_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/ca.crt').exists)

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  register: dh_gen_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/dh.pem').exists)

- name: Build the server certificate
  ansible.builtin.command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  register: server_cert_build_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/issued/server.crt').exists)

- name: Build the client certificate
  ansible.builtin.command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  register: client_cert_build_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/issued/client.crt').exists)

- name: Generate the Certificate Revocation List (CRL)
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  register: crl_gen_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/crl.pem').exists)

- name: Generate TLS authentication key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa
  register: tls_key_gen_result
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/ta.key').exists)

- name: Copy PKI files to the server configuration directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - client.crt
    - server.crt
    - ca.key
    - client.key
    - server.key

- name: Copy ca.crt and ta.key to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - ta.key

- name: Place the server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: root
    mode: '0640'
  notify: Restart openvpn

