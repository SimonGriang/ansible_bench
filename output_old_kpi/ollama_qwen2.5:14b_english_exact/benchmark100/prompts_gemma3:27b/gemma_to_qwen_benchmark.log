---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install dns
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ dns_packages }}"

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0750
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes
  when: dns_group is defined

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: yes
    group: "{{ dns_group }}"
  when: dns_owner is defined

- name: Generate rndc key
  command: rndc-confgen -a -f {{ dns_confdir }}/rndc.key
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  register: rndc_key_generation

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    mode: 0640
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_owner is defined and dns_group is defined

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns is true
  notify: Rndc reload

- name: Create zone file
  block:
    - copy:
        src: templates/dns_zone.j2
        dest: "{{ item.key }}.db"
        mode: 0640
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
      vars:
        zone: "{{ item.key }}"
        reverse: "{{ item.value }}"
      register: zone_file_creation
      notify: Rndc reload
    - command: named-checkzone {{ item.key }} {{ item.key }}.db
      register: zone_file_validation
      notify: Rndc reload
  loop: "{{ dns_zones | dict2items }}"
  when: dns_zones is defined

- name: Add zones to configuration
  template:
    src: templates/named.conf.j2
    dest: /etc/named.conf
    mode: 0640
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Restart dns

- name: Place systemd override
  block:
    - file:
        path: /etc/systemd/system/{{ dns_service }}.d
        state: directory
        mode: 0755
        owner: root
        group: root
      when: ansible_systemd is true
    - copy:
        src: "{{ item }}"
        dest: /etc/systemd/system/{{ dns_service }}.d/{{ item | basename }}
        mode: 0644
        owner: root
        group: root
      when: ansible_systemd is true
    - command: systemctl daemon-reload
      when: ansible_systemd is true
  loop:
    - templates/systemd_override.conf.j2

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    enabled: true
    state: started


