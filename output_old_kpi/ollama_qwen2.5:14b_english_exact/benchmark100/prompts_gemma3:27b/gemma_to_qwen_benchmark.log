---
- import_tasks: assert.yml
 delegate_to: localhost
  when: true

- name: Wait for port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection is not 'docker'
    - bootstrap_wait_for_host|bool

- name: Prepare system
  block:
    - name: Test connection and sudo
      command: whoami
      become: "{{ bootstrap_become }}"
      check_mode: no
  rescue:
    - name: Gather facts
      setup: {}
    - name: Install bootstrap packages via raw
      raw: "{{ bootstrap_raw }}"
      when: bootstrap_raw is defined
    - name: Ensure libdnf5 is present on RedHat
      yum:
        name: libdnf5
        state: present
      when:
        - ansible_os_family == 'RedHat'
        - ansible_pkg_mgr == 'yum'

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
    state: present
  become: "{{ bootstrap_become }}"

