---
- name: Create ssh_key_directory for user
  ansible.builtin.file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key|default(false)

- name: Manage user account
  ansible.builtin.user:
    name: "{{ user.name }}"
    comment: "{{ user.comment|default('') }}"
    create_home: "{{ user.create_home|default('yes') }}"
    password: "{{ user.password|default('') }}"
    uid: "{{ user.uid|default('') }}"
    group: "{{ user.group|default('') }}"
    shell: "{{ user.shell|default('') }}"
    expiry: "{{ user.expiry|default('') }}"
  register: user_info

- name: Set sudo options for user
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  ansible.builtin.template:
    src: "templates/sudoers.j2"
    dest: "/etc/sudoers.d/{{ item.name }}"
    validate: 'visudo -cf %s'
  when: item.sudo_options is defined

- name: Remove sudo options for user
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  when: item.sudo_options is not defined

- name: Generate private ssh key for user
  ansible.builtin.command: ssh-keygen -t rsa -f "{{ user.ssh_key_directory }}/{{ user.name }}.key" -N ''
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}.key"
  register: private_key_gen
  when: user.manage_ssh_key|default(false)
  changed_when: private_key_gen.changed
  check_mode: no
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Generate public ssh key for user
  ansible.builtin.command: ssh-keygen -y -f "{{ user.ssh_key_directory }}/{{ user.name }}.key" > "{{ user.ssh_key_directory }}/{{ user.name }}.pub"
  register: public_key_gen
  when: user.manage_ssh_key|default(false)
  changed_when: public_key_gen.changed
  check_mode: no
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Convert ssh key to ppk for user
  ansible.builtin.command: ssh-keygen -p -f "{{ user.ssh_key_directory }}/{{ user.name }}.key" -N ''
  register: ppk_gen
  when: user.manage_ssh_key|default(false)
  changed_when: ppk_gen.changed
  check_mode: no
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Get or set the home directory for user
  block:
    - name: Determine user's home directory
      ansible.builtin.getent:
        database: passwd
        key: "{{ user.name }}"
      register: passwd_entry
      changed_when: false
      failed_when: false

    - name: Set fact for base directory
      ansible.builtin.set_fact:
        user_home: "{{ passwd_entry.entry.home_directory|default('/home') }}"
  when: user.name is defined

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.manage_ssh_key|default(false) or private_keys is defined

- name: Deploy authorized keys for user
  loop: "{{ user.authorized_keys }}"
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for user
  loop: "{{ user.unauthorized_keys }}"
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for user
  ansible.builtin.copy:
    content: "{{ lookup('file', user.ssh_key_directory + '/' + user.name + '.key') }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key|default(false)

- name: Check users password valid time
  ansible.builtin.shell: awk -F: -v user="{{ user.name }}" '{if ($1 == user) print $3}' /etc/shadow
  register: pass_valid_time

- name: Set users password valid time
  ansible.builtin.shell: chage -M "{{ user.pass_max_days }}" -m "{{ user.pass_min_days }}" -W "{{ user.pass_warn_age }}" {{ user.name }}
  when: user.pass_max_days is defined and user.pass_min_days is defined and user.pass_warn_age is defined

- name: Place private key file for user
  ansible.builtin.copy:
    content: "{{ lookup('file', user.private_key_file) }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys|default(false)

