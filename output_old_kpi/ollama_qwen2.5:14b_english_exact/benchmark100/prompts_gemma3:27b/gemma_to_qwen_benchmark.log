ple\n\n- name: Start and enable httpd\n  systemd:\n    name: "{{ httpd_service }}"\n    enabled: yes\n    state: started' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-05T23:55:16.167578255Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9388051360, 'load_duration': 82697642, 'prompt_eval_count': 814, 'prompt_eval_duration': 351710295, 'eval_count': 532, 'eval_duration': 8942803329, 'model_name': 'qwen2.5:14b'} id='run--75e169bc-be27-4aad-8d7a-4c48a658a217-0' usage_metadata={'input_tokens': 814, 'output_tokens': 532, 'total_tokens': 1346}
