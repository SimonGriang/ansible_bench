---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: 0664
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: 0664
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  when: grub_options is defined and grub_options | length > 0
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_CMDLINE_LINUX={{ item }}"
    create: yes
    mode: 0664
    loop: "{{ grub_options }}"
    loop_control:
      label: "{{ item }}"
  notify: Update grub

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password is defined and grub_set_password == True

- name: Flush handlers
  meta: flush_handlers

