---
- name: Gather service facts
  ansible.builtin.service_facts:

- name: Set the active_server variable
  block:
    - name: Determine the active RKE2 server
      ansible.builtin.set_fact:
        active_server: "{{ inventory_hostname }}"
      when: "'{{ inventory_hostname }}' in groups['{{ rke2_servers_group_name }}'] and rke2_cluster_group_name.services['rke2-server.service']['active'] == 'active'"
    - name: Delegate to current host
      ansible.builtin.meta:
        clear_facts: true
      delegate_to: "{{ inventory_hostname }}"
      when: "'{{ inventory_hostname }}' in groups['{{ rke2_servers_group_name }}'] and rke2_cluster_group_name.services['rke2-server.service']['active'] == 'active'"

