  apply: {when: "'localhost' in groups['all']"}

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: "No configuration"
    vtype: select
  when: ansible_os_family == "Debian"

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == "Debian"

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: (postfix_virtual_mailbox_maps_use_mysql or postfix_virtual_domains_use_mysql) and ansible_os_family == "Debian"

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
    owner: root
    group: root
    mode: 0644
  notify: validate_transport_maps
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: 0644
  notify: validate_header_checks
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_facts: "{{ postfix_main_cf_facts | default({}) | combine({item.key: item.value}) }}"
  loop: "{{ postfix_main_cf_facts | default({}) | dict2items }}"
  when: postfix_main_cf_facts is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_facts: "{{ postfix_main_cf_facts | default({}) | combine({item.key: item.value}) }}"
  loop: "{{ postfix_main_cf_facts | default({}) | dict2items }}"
  when: postfix_main_cf_facts is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: 0644
  notify:
    - validate_main_cf
    - rebuild_database

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: 0644
  notify:
    - validate_master_cf
    - rebuild_database

- name: Creates cert/key directory
  file:
    path: "{{ postfix_cert_key_dir }}"
    state: directory
    mode: 0755
  when: postfix_cert_key_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_server_cert }}"
    dest: /etc/postfix/tls/server.crt
  when: postfix_tls_server_cert is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_server_key }}"
    dest: /etc/postfix/tls/server.key
  when: postfix_tls_server_key is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    content: "{{ postfix_aliases | to_nice_yaml }}"
    dest: /etc/postfix/aliases
  when: postfix_aliases is defined

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access }}"
    dest: /etc/postfix/sender_access
  when: postfix_sender_access is defined

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access }}"
    dest: /etc/postfix/recipient_access
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
  when: postfix_sasl_password_map is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

