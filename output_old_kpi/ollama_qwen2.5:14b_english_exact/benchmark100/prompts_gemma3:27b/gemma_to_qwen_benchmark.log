---
- name: Enable the Backports repository for Debian
  apt:
    repo: "deb http://deb.debian.org/debian {{ ansible_facts.os_release.version|default('jessie', True) }}-backports main"
    filename: "backports-{{ ansible_facts.os_release.version|default('jessie', True) }}.list"
    state: present
  when: ansible_facts.os_family == "Debian" and ansible_facts.os_release.version_id|int < 9
  notify: update_apt_cache

- name: Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: "{{ 'jessie-backports' if ansible_facts.os_release.version_id|int < 9 else '' }}"
  when: ansible_facts.os_family == "Debian" and ansible_facts.os_release.version_id|int < 9

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    install_recommends: false
    release: "{{ ansible_default_release }}"
  when: ansible_default_release is defined

