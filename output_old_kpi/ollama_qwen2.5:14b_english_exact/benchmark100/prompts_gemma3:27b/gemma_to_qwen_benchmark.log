ount': 429, 'eval_duration': 6894486274, 'model_name': 'qwen2.5:14b'} id='run--374cd061-940a-4174-bdf6-42d0948655b7-0' usage_metadata={'input_tokens': 1149, 'output_tokens': 429, 'total_tokens': 1578}
