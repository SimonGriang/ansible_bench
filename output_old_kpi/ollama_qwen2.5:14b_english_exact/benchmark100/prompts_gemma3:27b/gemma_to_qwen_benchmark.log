---
- name: Migrate from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "architecture.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('8') }}"
    java_open_jdk_repo_key: "{{ java_open_jdk_repo_key | default('') }}"
    java_open_jdk_repo_url: "{{ java_open_jdk_repo_url | default('') }}"
    java_open_jdk_repo_enabled: "{{ java_open_jdk_repo_enabled | default('1') }}"
    java_open_jdk_repo_gpgcheck: "{{ java_open_jdk_repo_gpgcheck | default('1') }}"
    java_open_jdk_libs_repo_key: "{{ java_open_jdk_libs_repo_key | default('') }}"
    java_open_jdk_libs_repo_url: "{{ java_open_jdk_libs_repo_url | default('') }}"
    java_open_jdk_libs_repo_enabled: "{{ java_open_jdk_libs_repo_enabled | default('1') }}"
    java_open_jdk_libs_repo_gpgcheck: "{{ java_open_jdk_libs_repo_gpgcheck | default('1') }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-openjdk') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-8-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Remove deprecated repositories (Debian)
  apt:
    name: "{{ java_deprecated_repositories_adoptopenjdk }}"
    state: absent
  when: ansible_distribution == 'Debian' and java_jdk_vendor == 'adoptopenjdk'

- name: Install extra apt tools (Debian)
  apt:
    name: "{{ java_open_jdk_apt_extra_packages }}"
    state: present
  when: ansible_distribution == 'Debian'

- name: Add required key repositories (Debian)
  apt_key:
    url: "{{ item }}"
  with_items: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_distribution == 'Debian'

- name: Add required repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: present
  with_items: "{{ java_required_repositories_openjdk }}"
  when: ansible_distribution == 'Debian'

- name: Add required key repositories (RedHat)
  rpm_key:
    key: "{{ item }}"
  with_items: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_os_family == 'RedHat'

- name: Add required repositories (RedHat)
  yum_repository:
    name: "{{ item.name }}"
    description: "{{ item.description }}"
    baseurl: "{{ item.baseurl }}"
    gpgcheck: "{{ item.gpgcheck | default('1') }}"
    enabled: "{{ item.enabled | default('1') }}"
  with_items: "{{ java_required_repositories_openjdk }}"
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_required_libs_openjdk }}"

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version }}"
    state: present
  when: ansible_distribution == 'Debian'

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}-{{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables
  lineinfile:
    path: /etc/profile
    line: source /etc/profile.d/jdk.sh

- name: Correct java version selected (Debian, Java < 11)
  command: alternatives --set java /usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/jre/bin/java
  when: ansible_distribution == 'Debian' and java_open_jdk_version is version('11', '<')

- name: Correct java version selected (Debian, Java >= 11)
  command: alternatives --set java /usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java
  when: ansible_distribution == 'Debian' and java_open_jdk_version is version('11', '>=')

