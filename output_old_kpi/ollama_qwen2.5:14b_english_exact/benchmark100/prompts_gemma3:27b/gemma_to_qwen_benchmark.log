---
- import_tasks: assert.yml
  remote_src: yes
  run_once: true
  delegate_to: localhost

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "{{ java_package_name }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "-Dnptl -O2"

- name: Install RPM
  block:
    - name: Copy RPM to /tmp/
      copy:
        src: "{{ java_rpm_path }}"
        dest: /tmp/oracle-java.rpm
    - name: Install Oracle Java RPM
      package:
        name: /tmp/oracle-java.rpm
        state: present
