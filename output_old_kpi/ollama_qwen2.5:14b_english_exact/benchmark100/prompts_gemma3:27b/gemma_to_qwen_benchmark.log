---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install fail2ban
  apt:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  loop: "{{ query('ansible.builtin.to_json', fail2ban_filterd_path) | from_json }}"
  notify: Restart fail2ban
  when: fail2ban_filterd_path is defined

- name: Configure fail2ban.local
  ini_file:
    dest: /etc/fail2ban/fail2ban.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0640
  loop: >-
    {%- set conf_list = fail2ban_base_configuration + fail2ban_configuration -%}
    {%- for item in conf_list -%}
      {{ item }}
    {%- endfor -%}
  notify: Restart fail2ban
  loop_control:
    label: "{{ item.option }}"

- name: Configure jail.local
  ini_file:
    dest: /etc/fail2ban/jail.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0640
  loop: >-
    {%- set conf_list = fail2ban_base_jail_configuration + fail2ban_jail_configuration -%}
    {%- for item in conf_list -%}
      {{ item }}
    {%- endfor -%}
  notify: Restart fail2ban
  loop_control:
    label: "{{ item.option }}"

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  when: fail2ban_auth.stat.exists is not defined or fail2ban_auth.stat.exists == false

- name: Start and enable fail2ban
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: yes

