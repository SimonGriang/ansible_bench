remove_example | bool\n\n- name: Start and enable httpd\n  systemd:\n    name: "{{ httpd_service }}"\n    enabled: true\n    state: started\n```' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-05T23:56:07.182263907Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9575893403, 'load_duration': 112321899, 'prompt_eval_count': 1383, 'prompt_eval_duration': 16683223, 'eval_count': 540, 'eval_duration': 9431074519, 'model_name': 'qwen2.5:14b'} id='run--8064c68d-3032-4361-93f0-c98c08808a57-0' usage_metadata={'input_tokens': 1383, 'output_tokens': 540, 'total_tokens': 1923}
