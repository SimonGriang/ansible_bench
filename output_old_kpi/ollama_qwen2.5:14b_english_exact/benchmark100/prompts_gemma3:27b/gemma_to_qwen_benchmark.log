- name: Place private key file for user
  ansible.builtin.copy:
    content: "{{ lookup('file', user.private_key_file) }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys | bool
