---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install requirements
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements | default([]) }}"

- name: Set sysctl setting
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: "{{ sysctl_set | default(True) }}"
    sysctl_reload: "{{ sysctl_reload | default(True) }}"
  loop: "{{ sysctl_items | default([]) }}"
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
    - ansible_local is not defined
  register: sysctl_results
  loop_control:
    label: "{{ item.name }}"

