content='---\n- name: gather bootstrap facts using raw command\n  raw: "cat /etc/os-release"\n  register: bootstrap_facts\n  become: false\n\n- name: set bootstrap facts (I) based on OS release information\n  set_fact:\n    bootstrap_distribution: "{{ item.key }}"\n    bootstrap_distribution_major_version: "{{ matched_version }}"\n  when:\n    - bootstrap_facts.rc == 0\n    - bootstrap_distribution is not defined\n    - bootstrap_facts.stdout is search(item.key)\n  loop: "{{ bootstrap_os_family_map }}"\n  loop_control:\n    label: "{{ item.key }}"\n  vars:\n    matched_version: >-\n      {{ item.value.stdout_lines | regex_search(\'^VERSION_ID=\\"([0-9]+)\', \'\\\\1\') | default(\'unknown\') | split(\'.\') | first }}\n  register: _\n\n- name: set bootstrap facts (II) based on OS family\n  set_fact:\n    bootstrap_os_family: "{{ item.0 }}"\n  when: bootstrap_distribution is defined and bootstrap_distribution in item.1\n  loop: "{{ bootstrap_os_family_map.items() }}"\n  loop_control:\n    label: "{{ item.0 }}"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-05T23:21:10.103711786Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4093578323, 'load_duration': 78610072, 'prompt_eval_count': 831, 'prompt_eval_duration': 34834843, 'eval_count': 235, 'eval_duration': 3974542140, 'model_name': 'qwen2.5:14b'} id='run--ca66dcc0-ad2f-41c1-8ce5-d47f8c38565d-0' usage_metadata={'input_tokens': 831, 'output_tokens': 235, 'total_tokens': 1066}
