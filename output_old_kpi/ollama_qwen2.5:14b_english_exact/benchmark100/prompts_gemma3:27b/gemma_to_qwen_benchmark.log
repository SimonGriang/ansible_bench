: 7102564755, 'load_duration': 93125585, 'prompt_eval_count': 674, 'prompt_eval_duration': 273133613, 'eval_count': 477, 'eval_duration': 6730156587, 'model_name': 'qwen2.5:14b'} id='run--02f634b0-fb13-4a08-a6fb-fd0301912dc5-0' usage_metadata={'input_tokens': 674, 'output_tokens': 477, 'total_tokens': 1151}
