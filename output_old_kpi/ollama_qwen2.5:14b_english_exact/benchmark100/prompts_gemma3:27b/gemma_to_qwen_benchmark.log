---
- name: gather bootstrap facts using raw command
  raw: "cat /etc/os-release"
  register: bootstrap_facts
  become: false
  gather_facts: false

- name: set bootstrap facts (I) based on OS release information
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ item.value.matched_version }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is search(item.key)
  loop: "{{ bootstrap_os_family_map }}"
  register: _
  loop_control:
    label: "{{ item.key }}"
  vars:
    item_value: "{{ item.value }}"
    matched_version: "{{ item_value.stdout_lines | regex_search('^VERSION_ID=\"([0-9]+)', '\\1') }}"
    matched_version: "{{ matched_version | default('unknown') }}"
    matched_version: "{{ matched_version.split('.')[0] }}"
    matched_version: "{{ matched_version | default('unknown') }}"
  vars:
    matched_version: "{{ matched_version }}"
    item_value: "{{ item_value }}"
    bootstrap_search: "{{ item.key }}"
    bootstrap_distribution: "{{ bootstrap_distribution }}"
    bootstrap_distribution_major_version: "{{ bootstrap_distribution_major_version }}"
    bootstrap_facts: "{{ bootstrap_facts }}"
  loop: "{{ bootstrap_os_family_map }}"

- name: set bootstrap facts (II) based on OS family
  set_fact:
    bootstrap_os_family: "{{ item.0 }}"
  when: bootstrap_distribution is defined and bootstrap_distribution in item.1
  loop: "{{ bootstrap_os_family_map.items() }}"
  loop_control:
    label: "{{ item.0 }}"

