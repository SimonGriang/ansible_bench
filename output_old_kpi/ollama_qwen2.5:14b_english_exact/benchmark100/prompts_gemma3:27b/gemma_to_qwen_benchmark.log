rue, 'done_reason': 'stop', 'total_duration': 7220306928, 'load_duration': 90744195, 'prompt_eval_count': 783, 'prompt_eval_duration': 288927816, 'eval_count': 485, 'eval_duration': 6834892792, 'model_name': 'qwen2.5:14b'} id='run--eb73275b-287c-4923-8f96-b07eee74aaf6-0' usage_metadata={'input_tokens': 783, 'output_tokens': 485, 'total_tokens': 1268}
