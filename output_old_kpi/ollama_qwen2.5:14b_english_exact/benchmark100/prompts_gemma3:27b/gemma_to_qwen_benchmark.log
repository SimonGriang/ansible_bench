    name: "{{ item.name }}"
    privatekey_path: "{{ item.privatekey_path }}"
    certificate_path: "{{ item.certificate_path }}"
    mode: 0640
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ pkcs12_files }}"
  register: pkcs12_result

- name: read private key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
