---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_addr: localhost

- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements is defined and users_requirements|length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  when: users_groups is defined
  loop_control:
    label: "{{ item.name }}"

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "includedir {{ users_sudo_includedir }}"
    regexp: "^includedir {{ users_sudo_includedir }}"
    validate: '/usr/sbin/visudo -cf %s'

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  when: users is defined
  loop_control:
    label: "{{ item.name }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | bool

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | bool


