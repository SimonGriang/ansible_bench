  when: ansible_version.version | float < 2.12 or ansible_facts.os_family not in ['RedHat', 'Debian']
  ignore_errors: "{{ ansible_check_mode | bool }}"

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: yes
  notify: restart docker
  when: ansible_version.version | float >= 2.12 and ansible_facts.os_family in ['RedHat', 'Debian']
  ignore_errors: "{{ ansible_check_mode | bool }}"

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  when: docker_install_compose_plugin | bool and (ansible_version.version | float < 2.12 or ansible_facts.os_family not in ['RedHat', 'Debian'])
  ignore_errors: "{{ ansible_check_mode | bool }}"

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  when: docker_install_compose_plugin | bool and ansible_version.version | float >= 2.12 and ansible_facts.os_family in ['RedHat', 'Debian']
  ignore_errors: "{{ ansible_check_mode | bool }}"

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: 0750
  when: docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    src: "{{ docker_daemon_options_src }}"
    dest: /etc/docker/daemon.json
    owner: root
    group: root
    mode: 0644
  notify: restart docker
  when: docker_daemon_options | length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode | bool }}"

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: "tasks/docker-compose.yml"
  when: docker_install_compose | bool

- name: Get docker group info using getent
  shell: getent group docker
