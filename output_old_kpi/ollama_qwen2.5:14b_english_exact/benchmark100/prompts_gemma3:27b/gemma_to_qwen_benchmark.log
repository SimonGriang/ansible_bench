---
- name: Create document roots for virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: httpd_vhosts is defined and item.documentroot is defined and item.create_docroot

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts
  command: a2ensite "{{ item.name }}"
  loop: "{{ httpd_vhosts }}"
  changed_when: "'already enabled' not in a2ensite.stdout"
  when: ansible_os_family == 'Debian'
  notify:
    - Test httpd configuration validity
    - Restart httpd
  register: a2ensite
  changed_when: a2ensite.changed

