---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  check_mode: false
  become: false
  changed_when: false

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.value[0] }}"
    bootstrap_distribution_major_version: "{{ item.value[1] }}"
  loop: "{{ bootstrap__os_family_map }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout.find(item.value[0]) >= 0
  register: set_bootstrap_facts_I
  failed_when: false
  loop_control:
    label: "{{ item.key }}"
  when: bootstrap_facts.rc == 0
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value
  register: set_bootstrap_facts_II
  failed_when: false
  loop_control:
    label: "{{ item.key }}"
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"

