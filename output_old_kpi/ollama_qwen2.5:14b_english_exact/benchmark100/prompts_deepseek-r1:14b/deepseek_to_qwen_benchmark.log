---
- name: Install Keepalived service when HA mode is enabled
  when: cluster_mode == 'ha' and ha_mode == 'vip'
  yum:
    name: keepalived
    state: present

- name: Download and install RKE2
  get_url:
    url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.sh"
    dest: /usr/local/bin/rke2-install
  args:
    register: rke2_download_result
  when: rke2_version is defined
  become: yes

- name: Perform CIS hardening when CIS profile is defined
  when: cis_profile is defined
  import_tasks: cis-hardening.yml

- name: Find and identify the active server in the cluster
  command: kubectl get nodes -o json
  register: node_info
  when: active_server is not defined
  become: yes

- name: Enable the IPVS kernel module for load balancing
  when: cluster_mode == 'ha' and ha_mode == 'ipvs'
  block:
    - name: Install ipvsadm
      package:
        name: ipvsadm
        state: present
    - name: Enable IPVS kernel module
      command: modprobe -- ip_vs
    - name: Persist IPVS kernel module
      lineinfile:
        path: /etc/modules-load.d/ipvs.conf
        line: ip_vs

- name: Copy kube-vip manifests to the master node
  when: cluster_mode == 'ha' and ha_mode == 'vip'
  copy:
    src: manifests/kube-vip.yaml
    dest: /etc/kubernetes/kube-vip.yaml
    owner: root
    group: root
    mode: '0644'

- name: Copy ingress-nginx manifests to the master node
  when: ingress_nginx is defined
  copy:
    src: manifests/ingress-nginx.yaml
    dest: /etc/kubernetes/ingress-nginx.yaml
    owner: root
    group: root
    mode: '0644'

- name: Prepare the first server node in the cluster
  when: first_server is defined
  block:
    - name: Execute preflight checks
      command: /usr/local/bin/rke2-install --check-version-kube
    - name: Install RKE2
      command: /usr/local/bin/rke2-install server --kube-config=/etc/rancher/rke2/rke2.yaml --write-kubeconfig-mode=0644 --token=abcd1234
      register: rke2_install_result
      changed_when: "'failed' not in rke2_install_result.stdout"
    - name: Add RKE2 systemd service
      copy:
        src: rke2.service
        dest: /etc/systemd/system/rke2-server.service
      notify: restart_rke2

- name: Perform etcd restore tasks
  when: etcd_backup is defined
  block:
    - name: Download etcd backup
      get_url:
        url: "{{ etcd_backup }}"
        dest: /tmp/etcd-backup.tar.gz
    - name: Restore etcd data
      unarchive:
        src: /tmp/etcd-backup.tar.gz
        dest: /var/lib/rancher/rke2/server/etcd/
        remote_src: yes
      register: etcd_restore_result

- name: Download the kubeconfig file to the Ansible localhost
  when: download_kubeconfig is defined
  get_url:
    url: "{{ kubeconfig_url }}"
    dest: "{{ kubeconfig_dest }}"

- name: Prepare and join remaining cluster nodes
  when: active_server is defined
  block:
    - name: Execute preflight checks
      command: /usr/local/bin/rke2-install --check-version-kube
    - name: Join RKE2 cluster
      command: /usr/local/bin/rke2-install agent --token=abcd1234 --server={{ active_server }}
      register: rke2_join_result
      changed_when: "'failed' not in rke2_join_result.stdout"

- name: Perform rolling restart of server nodes when version changes
  when: rke2_version is changed
  block:
    - name: Drain node
      command: kubectl drain "{{ inventory_hostname }}" --ignore-daemonsets --delete-local-data --force
      register: drain_result
      failed_when: "'ErrImagePull' in drain_result.stdout or 'ImagePullBackOff' in drain_result.stdout"
      until: "'ErrImagePull' not in drain_result.stdout and 'ImagePullBackOff' not in drain_result.stdout"
      retries: 5
      delay: 30
    - name: Restart RKE2 server
      command: systemctl restart rke2-server
      register: restart_result
      retries: 3
      delay: 10
    - name: Uncordon node
      command: kubectl uncordon "{{ inventory_hostname }}"
      register: uncordon_result

- name: Perform rolling restart of agent nodes when version changes
  when: rke2_version is changed
  block:
    - name: Restart RKE2 agent
      command: systemctl restart rke2-agent
      register: restart_result
      retries: 3
      delay: 10

- name: Flush all registered handlers
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
  when: config_files is changed
  block:
    - name: Restart RKE2 server
      command: systemctl restart rke2-server
      register: restart_result
      retries: 3
      delay: 10
    - name: Notify agents of config change
      command: kubectl rollout restart daemonset/rke2-agent -n kube-system

- name: Perform final steps including a summary
  block:
    - name: Display summary
      debug:
        msg: "RKE2 cluster setup is complete. Active server: {{ active_server }}"
      when: active_server is defined
  # Ensure there is a newline at the end of the file
