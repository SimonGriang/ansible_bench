content='---\n- name: gather_facts | Lookup bootstrap facts\n  ansible.builtin.slurp:\n    path: /etc/os-release\n  register: os_release_content\n\n- name: gather_facts | Set bootstrap facts (I)\n  ansible.builtin.set_fact:\n    distro_name: "{{ (os_release_content.content | b64decode | from_json).NAME }}"\n    distro_major_version: "{{ (os_release_content.content | b64decode | from_json).VERSION_ID.split(\'.\')[0] }}"\n\n- name: gather_facts | Set bootstrap facts (II)\n  ansible.builtin.set_fact:\n    os_family: "{{ lookup(\'ansible.builtin.mapping\', distro_name, default=\'unknown\', null=\'unknown\', mapping={\n        \'CentOS Linux\': \'RedHat\',\n        \'Fedora\': \'RedHat\',\n        \'Red Hat Enterprise Linux\': \'RedHat\',\n        \'Ubuntu\': \'Debian\',\n        \'Debian\': \'Debian\'\n    }) }}"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-04T10:02:11.022501151Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5338910601, 'load_duration': 74633193, 'prompt_eval_count': 362, 'prompt_eval_duration': 91281621, 'eval_count': 203, 'eval_duration': 5168688352, 'model_name': 'qwen2.5:14b'} id='run--9bd0670d-2b51-491f-8e73-d16087b22bec-0' usage_metadata={'input_tokens': 362, 'output_tokens': 203, 'total_tokens': 565}
