---
- import_tasks: assert.yml

- name: Install using package
  when: install_method == "package"
  block:
    - name: Install HashiCorp product using package manager
      become: yes
      ansible.builtin.package:
        name: "{{ product_name }}"
        state: present
      when: ansible_os_family == "RedHat" and install_method == "package"

    - name: Install HashiCorp product using package manager
      become: yes
      ansible.builtin.package:
        name: "{{ product_name }}"
        state: present
      when: ansible_os_family == "Debian" and install_method == "package"

- name: Configure debian
  when: ansible_os_family == "Debian"
  block:
    - name: Add HashiCorp GPG key
      ansible.builtin.get_url:
        url: "https://apt.releases.hashicorp.com/gpg"
        dest: "/usr/share/keyrings/hashicorp-archive-keyring.gpg"
        mode: "0644"

    - name: Add HashiCorp apt repository
      ansible.builtin.get_url:
        url: "https://apt.releases.hashicorp.com/{{ product_name }}.list"
        dest: "/etc/apt/sources.list.d/{{ product_name }}.list"
        mode: "0644"

- name: Install hashicorp product using package
  when: install_method == "package"
  block:
    - name: Install HashiCorp product using package manager
      become: yes
      ansible.builtin.package:
        name: "{{ product_name }}"
        state: latest
      when: product_version == "latest"

    - name: Install HashiCorp product using package manager
      become: yes
      ansible.builtin.package:
        name: "{{ product_name }}={{ product_version }}"
        state: present
      when: product_version != "latest"

- name: Install manually
  when: install_method == "manual"
  block:
    - name: Extract files to destination
      ansible.builtin.unarchive:
        src: "{{ product_url }}"
        dest: "/usr/local/bin/"
        remote_src: yes

    - name: Set permissions
      ansible.builtin.file:
        path: "/usr/local/bin/{{ product_name }}"
        mode: "0755"
        owner: root
        group: root

