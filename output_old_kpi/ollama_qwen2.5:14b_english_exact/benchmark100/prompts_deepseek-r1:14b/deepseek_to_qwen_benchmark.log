  ansible.builtin.template:
    src: systemd.j2
    dest: "{{ item }}"
    mode: '0755'  # Ensuring correct file permissions
  loop: "{{ service_list }}"
  when: service_template == 'systemd'

- name: Configure sysvinit service
  ansible.builtin.template:
    src: sysvinit.j2
    dest: "{{ item }}"
    mode: '0755'  # Ensuring correct file permissions
  loop: "{{ service_list }}"
  when: service_template == 'sysvinit'

- name: Manage service
  ansible.builtin.service:
    name: "{{ item.service }}"
    enabled: "{{ item.enabled | default(true) | bool }}"
    state: "{{ item.state }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta:
    cmd: flush_handlers

