---
- name: Create the OpenVPN client configuration directory
  file:
    path: /etc/openvpn/client
    state: directory
    owner: root
    group: openvpn_group
    mode: '0750'

- name: Place the OpenVPN client configuration file
  template:
    src: client.conf.j2
    dest: /etc/openvpn/client.conf
    owner: root
    group: openvpn_group
    mode: '0640'
  notify: Restart openvpn

