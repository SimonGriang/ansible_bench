---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    insertbefore: EOF
    create: yes
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    insertbefore: EOF
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: present
  when: ansible_distribution != "bookworm" and ansible_distribution != "noble" and ansible_os_family != "Alpine"

- name: Install Python modules
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ python_pip_modules[item] }}"
  loop: "{{ python_pip_modules.keys()|list }}"
  when: ansible_distribution != "bookworm" and ansible_distribution != "noble" and ansible_os_family != "Alpine"

