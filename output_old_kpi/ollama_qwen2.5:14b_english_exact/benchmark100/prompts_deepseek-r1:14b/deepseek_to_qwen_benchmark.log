---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  remote_src: yes
  vars:
    ansible_host: localhost

- name: Install cron packages
  ansible.builtin.yum:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron.conf
    line: 'SHELL=/bin/bash'
    create: yes
  notify: Restart cron service

- name: Configure cron path
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron.conf
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    create: yes
  notify: Restart cron service

- name: Configure cron mailto
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron.conf
    line: 'MAILTO=root'
    create: yes
  notify: Restart cron service

- name: Start and enable cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service | length > 0

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs | length > 0

- name: Register cron jobs
  ansible.builtin.meta:
    clear: True
  notify: Restart cron service

  handlers:

  - name: Restart cron service
    ansible.builtin.service:
      name: cron
      state: restarted

