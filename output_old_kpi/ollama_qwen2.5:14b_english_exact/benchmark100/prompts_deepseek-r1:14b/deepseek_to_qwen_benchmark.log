---
- name: Ensure Vault package is installed
  ansible.builtin.package:
    name: vault
    state: present

- name: Configure Vault with environment variables
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: VAULT_CACERT=/path/to/ca.pem
    create: yes
  vars:
    vault_cacert_path: /path/to/ca.pem

- name: Initialize Vault
  ansible.builtin.command: vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json
  register: vault_init_output
  changed_when: "'keys_json' in vault_init_output.stdout"
  failed_when: "'keys_json' not in vault_init_output.stdout"

- name: Unseal Vault
  ansible.builtin.command: vault operator unseal "{{ vault_unseal_key }}"
  vars:
    vault_unseal_key: "{{ vault_init_output.stdout.unseal_keys_hex[0] }}"
  register: vault_unseal_output
  changed_when: "'Key is not yet sealed' in vault_unseal_output.stdout"
  failed_when: "'Key is not yet sealed' not in vault_unseal_output.stdout"

- name: Login to Vault and configure token
  ansible.builtin.command: vault login "{{ vault_root_token }}"
  vars:
    vault_root_token: "{{ vault_init_output.stdout.root_token }}"
  register: vault_login_output
  changed_when: "'token lookup succeeded' in vault_login_output.stdout"
  failed_when: "'token lookup succeeded' not in vault_login_output.stdout

- name: Configure Vault policies
  ansible.builtin.command: vault policy write my-policy /path/to/policy.hcl
  register: vault_policy_output
  changed_when: "'Policy written to' in vault_policy_output.stdout"
  failed_when: "'Policy written to' not in vault_policy_output.stdout

