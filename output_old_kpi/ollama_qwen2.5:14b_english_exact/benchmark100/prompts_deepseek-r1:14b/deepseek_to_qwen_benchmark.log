  block:
    - name: Check If We Can Connect To The Remote Host
      ansible.builtin.shell: echo "Hello"
      register: connection_test
      changed_when: false
      failed_when: false

    - name: Report Failure If We Can't Connect
      ansible.builtin.fail:
        msg: "Could not connect to the remote host"
      when: connection_test is failed

    - name: Gather Facts
      ansible.builtin.setup:

    - name: Install Raw Bootstrap Packages
      ansible.builtin.raw: "{{ bootstrap_cmd }}"
      args:
        warn: false

- name: Ensure System Preparation With Ansible Modules
  block:
    - name: Gather Facts
      ansible.builtin.setup:

    - name: Ensure Bootstrap Packages Are Installed
      ansible.builtin.dnf:
        name: "{{ item }}"
        state: present
      when: ansible_os_family == "RedHat"
      loop: "{{ bootstrap_packages }}"
      register: yum_out
      changed_when: "'No such file or directory' in yum_out.msg"

    - name: Ensure Bootstrap Packages Are Installed
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      when: ansible_os_family == "Debian"
      loop: "{{ bootstrap_packages }}"
      register: apt_out
      changed_when: "'No such file or directory' in apt_out.msg"
