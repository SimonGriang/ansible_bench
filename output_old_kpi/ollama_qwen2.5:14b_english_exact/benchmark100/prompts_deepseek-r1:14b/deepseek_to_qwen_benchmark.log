---
- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    system: yes
    state: present

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    create_home: no
    shell: /usr/sbin/nologin
    state: present

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /etc/promtail
    - /var/lib/promtail

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: root
    group: root
  loop:
    - /opt/promtail
    - /var/log/promtail

- name: Check promtail binary existence
  stat:
    path: /opt/promtail/promtail
  register: promtail_binary_exists

- name: Download promtail binaries
  get_url:
    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip"
    dest: "/tmp/promtail-linux-amd64.zip"
    sha256sum: "{{ promtail_sha256 }}"
  when: not promtail_binary_exists.stat.exists

- name: Propagate local promtail binaries
  copy:
    src: "files/promtail-linux-amd64"
    dest: "/tmp/promtail-linux-amd64"
    mode: '0755'
  when: promtail_binary_exists.stat.exists

- name: Download promtail binaries for controller node
  get_url:
    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip"
    dest: "/tmp/promtail-linux-amd64.zip"
    sha256sum: "{{ promtail_sha256 }}"
  when: inventory_hostname == "controller-node"

- name: Propagate promtail binaries
  copy:
    src: "/tmp/promtail-linux-amd64"
    dest: "/tmp/promtail-linux-amd64"
    mode: '0755'
  when: inventory_hostname != "controller-node"

- name: Unpack promtail binaries
  unarchive:
    src: "/tmp/promtail-linux-amd64.zip"
    dest: /opt/promtail
    remote_src: yes
    owner: promtail
    group: promtail
    mode: '0750'
    creates: /opt/promtail/promtail

- name: Create symlink to latest promtail version
  file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
    force: yes
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail.yml
    mode: '0640'
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
