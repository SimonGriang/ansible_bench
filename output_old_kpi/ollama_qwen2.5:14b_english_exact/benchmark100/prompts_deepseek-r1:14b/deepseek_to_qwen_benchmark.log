---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: config/mysqld.cnf.j2
    dest: /etc/mysql/mysqld.cnf
    mode: '0644'
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/debian-client.cnf
    regexp: '^socket='
    line: 'socket={{ mysql_socket }}'

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    enabled: yes
    state: started

- name: Place my.cnf
  template:
    src: config/my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.database }}.*:{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers

