---
- name: Set the package state based on how Ansible is installed
  ansible.builtin.set_fact:
    ansible_package_state: present
  when: ansible_facts.bin_ansible_local_file is defined and ansible_facts.bin_ansible_local_file.stat.pip_install == true

- name: Set the package state based on how Ansible is installed
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_facts.bin_ansible_local_file is not defined

- name: Set up Ansible on RedHat
  ansible.builtin.include_tasks: setup-RedHat.yml
  when: ansible_facts.system.os_family == 'RedHat' and ansible_facts.system.distribution is not defined or ansible_facts.system.distribution != 'Fedora' and ansible_facts.ansible_package_state == 'present'

- name: Set up Ansible on Fedora
  ansible.builtin.include_tasks: setup-Fedora.yml
  when: ansible_facts.system.distribution == 'Fedora' and ansible_facts.ansible_package_state == 'present'

- name: Set up Ansible on Ubuntu
  ansible.builtin.include_tasks: setup-Ubuntu.yml
  when: ansible_facts.system.distribution == 'Ubuntu' and ansible_facts.ansible_package_state == 'present'

- name: Set up Ansible on Debian
  ansible.builtin.include_tasks: setup-Debian.yml
  when: ansible_facts.system.distribution == 'Debian' and ansible_facts.ansible_package_state == 'present'

- name: Set up Ansible using Pip
