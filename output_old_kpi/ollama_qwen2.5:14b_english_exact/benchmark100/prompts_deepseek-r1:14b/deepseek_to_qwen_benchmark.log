---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_version[:3] }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_jdk_version: "{{ java_jdk_version | default('8') }}"
    java_jdk_repo: "{{ java_jdk_repo | default('default_repo') }}"
    java_jdk_libs: "{{ java_jdk_libs | default('default_libs') }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_jdk_path: "{{ java_jdk_path | default('/usr/lib/jvm') }}"
    java_jdk_package: "{{ java_jdk_package | default('openjdk-{{ java_jdk_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_jdk_path }}/{{ java_jdk_package }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_key:
        id: "{{ deprecated_repo_key }}"
        state: absent
      when: ansible_facts['os_family'] == 'Debian' and deprecated_repo_key is defined

    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
          - software-properties-common
        state: present
      when: ansible_facts['os_family'] == 'Debian'

    - name: Add key repositories
      apt_key:
        url: "{{ key_repo_url }}"
        state: present
      when: ansible_facts['os_family'] == 'Debian' and key_repo_url is defined

    - name: Add required repositories
      apt_repository:
        repo: "{{ required_repo }}"
        state: present
      when: ansible_facts['os_family'] == 'Debian' and required_repo is defined

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ key_repo_key }}"
        state: present
      when: ansible_facts['os_family'] == 'RedHat' and key_repo_key is defined

    - name: Add required repositories
      yum_repository:
        name: "{{ required_repo }}"
        description: "{{ required_repo_description }}"
        baseurl: "{{ required_repo_url }}"
        enabled: "{{ required_repo_enabled | bool }}"
        state: present
      when: ansible_facts['os_family'] == 'RedHat' and required_repo is defined

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_jdk_libs }}"
  loop_control:
    extended: true

- name: Install Java, Debian
  apt:
    name: "{{ java_jdk_package }}"
    state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_jdk_package }}"
    state: present
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
  template:
    src: java-env.j2
    dest: /etc/profile.d/java-env.sh

- name: Source environment variables
  lineinfile:
    path: /etc/bash.bashrc
    line: source /etc/profile.d/java-env.sh
    create: yes

- name: Correct java version selected for Java < 11
  command: alternatives --set java /usr/lib/jvm/{{ java_jdk_package }}/jre/bin/java
  when: java_jdk_version | int < 11

- name: Correct java version selected for Java >= 11
  command: alternatives --set java /usr/lib/jvm/{{ java_jdk_package }}/bin/java
  when: java_jdk_version | int >= 11


