---
- name: Create the RKE2 manifests directory
  file:
    path: /opt/rke2/manifests
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  copy:
    src: templates/kube-vip-config.yaml
    dest: /opt/rke2/data/kube-vip-config.yaml
    mode: '0644'
    owner: root
    group: root

- name: Copy kube-vip load balancer manifests to first server
  block:
    - copy:
        src: templates/kube-vip-loadbalancer.yaml
        dest: /opt/rke2/manifests/kube-vip-loadbalancer.yaml
        mode: '0644'
        owner: root
        group: root
      when: kube_vip_cloud_provider_enabled | default(false)

