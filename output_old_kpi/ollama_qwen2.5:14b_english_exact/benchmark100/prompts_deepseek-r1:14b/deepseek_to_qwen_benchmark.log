---
- name: Import assertion tasks
  block:
    - ansible.builtin.import_tasks: assert.yml

- name: Install required software packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements|length > 0

- name: Manage user groups
  ansible.builtin.include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group

- name: Configure sudoers directory inclusion
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    regexp: '^#\!includedir /etc/sudoers.d$'
    line: '!includedir /etc/sudoers.d'
    validate: '/usr/sbin/visudo -cf %s'

- name: Manage user configurations
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user

- name: Configure cron allow permissions
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow

- name: Remove cron allow file if not needed
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


