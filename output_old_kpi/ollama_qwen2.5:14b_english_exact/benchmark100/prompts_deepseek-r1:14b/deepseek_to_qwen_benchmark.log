```yaml
- import_tasks: assert.yml
  delegate_to: localhost
  when: assert.yml is defined

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  check_mode: no

- name: Configure apt
  apt:
    upgrade: dist
    options: ['--force-yes', '--allow-downgrades', '--allow-remove-essential', '--allow-change-held-packages']
    force_apt_get: yes
  check_mode: no

- name: Update all software (dnf)
  dnf:
    name: "@System"
    update_cache: yes
    upgrade: min
    exclude: kernel*
  check_mode: no

- name: Update all software (pacman)
  pacman:
    sync: '@system'
    refresh: yes
    upgrade: yes
  check_mode: no

- name: Configure yum
  block:
    - dnf:
        name: "@System"
        update_cache: yes
        upgrade: min
        exclude: kernel*
      when: ansible_distribution_major_version == '6'
      check_mode: no
    - yum:
        name: "@System"
        update_cache: yes
        upgrade: min
        exclude: kernel*
      when: ansible_distribution_major_version != '6'
      check_mode: no
    - yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != '6'
      check_mode: no
  check_mode: no

- name: Update all software (zypper)
  zypper:
    name: "@System"
    update: yes
  check_mode: no
```


