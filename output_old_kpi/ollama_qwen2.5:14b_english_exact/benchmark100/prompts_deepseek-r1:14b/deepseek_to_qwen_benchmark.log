  when: rsyslog_deploy_default_config is not defined or not rsyslog_deploy_default_config

- name: Configuring additional config files
  copy:
    src: "{{ item.value.src }}"
    dest: /etc/rsyslog.d/{{ item.key }}.conf
    mode: "{{ item.value.mode }}"
    owner: "{{ item.value.owner }}"
    group: "{{ item.value.group }}"
  loop: "{{ rsyslog_rsyslog_d_files }}"
  when: item.value.state is defined
  notify: Restart rsyslog

- name: Start and enable rsyslog
  systemd:
    name: "{{ rsyslog_service }}"
    enabled: yes
    state: started


