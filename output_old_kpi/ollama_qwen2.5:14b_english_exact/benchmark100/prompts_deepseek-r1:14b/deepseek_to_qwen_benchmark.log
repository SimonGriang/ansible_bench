---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ packages }}"
  notify:
    - set root password
    - systemctl daemon-reload

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_conf_dir }}/{{ item }}"
    line: "{{ item }}"
  with_items: "{{ options }}"
  notify:
    - restart mysql

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: "socket={{ mysql_socket }}"
  notify:
    - restart mysql

- name: Initialize mysql
  command: "{{ mysql_init_db_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: mysql.cnf.j2
    dest: /etc/mysql/conf.d/custom.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ databases }}"
  when: not initial_import

- name: List databases
  mysql_db:
    name: "{{ item }}"
    state: present
  register: db_check
  with_items: "{{ databases }}"

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ initial_import }}"
    target_opts: --dump-dir
  when: initial_import and not db_check.results[item].changed

- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.database }}.*:{{ item.privileges }}"
  with_items: "{{ users }}"
  notify:
    - restart mysql

- name: Flush handlers again
  meta: flush_handlers

