---
- name: Check if EFI firmware exists on the system
  stat:
    path: /sys/firmware/efi/efivars/
  register: efi_firmware

- name: Remove GRUB configuration file on EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_firmware.stat.exists

- name: Install custom user template for GRUB
  copy:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: '0755'

- name: Add EFI password protection to GRUB
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^password_pbkdf2.*'
    line: 'password_pbkdf2 grub_user_pbkdf2 --flag=grub_user_pbkdf2'
    owner: root
    group: root
    mode: '0600'
  when: efi_firmware.stat.exists

- name: Add MBR password protection to GRUB
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^password_pbkdf2.*'
    line: 'password_pbkdf2 grub_user_pbkdf2 --flag=grub_user_pbkdf2'
    owner: root
    group: root
    mode: '0600'
  when: not efi_firmware.stat.exists

- name: Add unrestricted access to GRUB password entries
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^password_pbkdf2.*'
    line: 'password_pbkdf2 grub_user_pbkdf2 --flag=grub_user_pbkdf2 --unrestricted'
    owner: root
    group: root
    mode: '0600'
  when: efi_firmware.stat.exists and enabled | bool

- name: Add unrestricted access to GRUB password entries for MBR
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^password_pbkdf2.*'
    line: 'password_pbkdf2 grub_user_pbkdf2 --flag=grub_user_pbkdf2 --unrestricted'
    owner: root
    group: root
    mode: '0600'
  when: not efi_firmware.stat.exists and enabled | bool

