---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml
  run_once: true

- name: Install required packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ service_required_packages }}"
  notify: Gather facts

