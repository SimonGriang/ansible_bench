content='---\n- name: Remove old Docker versions\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: Add Docker GPG key\n  when: docker_add_repo | bool\n  rpm_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n\n- name: Add Docker repository\n  when: docker_add_repo | bool\n  copy:\n    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    content: "{{ lookup(\'url\', docker_yum_repo_url) }}"\n    owner: root\n    group: root\n    mode: \'0644\'\n\n- name: Configure Docker Nightly repo\n  when: docker_add_repo | bool\n  lineinfile:\n    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    regexp: \'^enabled=1$\'\n    line: "enabled={{ \'1\' if docker_yum_repo_enable_nightly | bool else \'0\' }}"\n    backrefs: yes\n\n- name: Configure Docker Test repo\n  when: docker_add_repo | bool\n  lineinfile:\n    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    regexp: \'^enabled=1$\'\n    line: "enabled={{ \'1\' if docker_yum_repo_enable_test | bool else \'0\' }}"\n    backrefs: yes\n\n- name: Configure containerd on RHEL 8\n  when: ansible_facts.distribution_major_version == \'8\'\n  block:\n    - name: Remove runc package\n      yum:\n        name: runc\n        state: absent\n    - name: Ensure container-selinux is installed\n      yum:\n        name: container-selinux\n        state: present\n    - name: Ensure containerd.io is installed\n      yum:\n        name: containerd.io\n        state: present' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-04T10:07:24.466509499Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8613395496, 'load_duration': 97767811, 'prompt_eval_count': 564, 'prompt_eval_duration': 356371938, 'eval_count': 403, 'eval_duration': 8144126125, 'model_name': 'qwen2.5:14b'} id='run--df69d94d-5d4a-4032-adc1-59c70f4b90d2-0' usage_metadata={'input_tokens': 564, 'output_tokens': 403, 'total_tokens': 967}
