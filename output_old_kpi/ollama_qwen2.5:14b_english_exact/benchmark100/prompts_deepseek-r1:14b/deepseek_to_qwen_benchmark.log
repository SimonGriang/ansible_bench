    path: /etc/environment
    line: VAULT_CACERT=/path/to/ca.pem
    create: yes
  vars:
    vault_cacert_path: /path/to/ca.pem

- name: Initialize Vault
  ansible.builtin.command: vault operator init -recovery-shares=1 -recovery-threshold=1 -format=json
  register: vault_init_output
  changed_when: vault_init_output.stdout|from_json.keys_json is defined
  failed_when: vault_init_output.stdout|from_json.keys_json is not defined

- name: Unseal Vault
  ansible.builtin.command: vault operator unseal "{{ vault_unseal_key }}"
  vars:
    vault_unseal_key: "{{ vault_init_output.stdout|from_json.unseal_keys_hex[0] }}"
  register: vault_unseal_output
  changed_when: vault_unseal_output.stdout is search('Key is not yet sealed')
  failed_when: vault_unseal_output.stdout is not search('Key is not yet sealed')

- name: Login to Vault and configure token
  ansible.builtin.command: vault login "{{ vault_root_token }}"
  vars:
    vault_root_token: "{{ vault_init_output.stdout|from_json.root_token }}"
  register: vault_login_output
  changed_when: vault_login_output.stdout is search('token lookup succeeded')
  failed_when: vault_login_output.stdout is not search('token lookup succeeded')

- name: Configure Vault policies
  ansible.builtin.command: vault policy write my-policy /path/to/policy.hcl
  register: vault_policy_output
  changed_when: vault_policy_output.stdout is search('Policy written to')
  failed_when: vault_policy_output.stdout is not search('Policy written to')


