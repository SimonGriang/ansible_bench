---
- import_tasks: assert.yml
  name: Import assertion tasks from assert.yml for validation and run them once on localhost

- name: Install all necessary packages required for Vault installation
  apt:
    name: "{{ vault_prerequisites }}"
    state: present
  when: ansible_os_family == "Debian"
  become: yes

- name: Install all necessary packages required for Vault installation
  yum:
    name: "{{ vault_prerequisites }}"
    state: present
  when: ansible_os_family == "RedHat"
  become: yes

- name: Include tasks from a file named after the installation method specified in the variable vault_installation_method
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add environment variables to the Vault configuration file
  lineinfile:
    path: /etc/vault.d/vault.env
    mode: 0644
    create: yes
    line: "{{ item }}"
  loop: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Include security hardening tasks
  import_tasks: hardening.yml

- name: Start and enable vault (for OSS type)
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault (for non-OSS type)
  service:
    name: vault
    enabled: yes
  when: vault_type != "oss"

