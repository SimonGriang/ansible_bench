---
- import_tasks: assert.yml
  delegate_to: localhost
  when: assert.yml is defined

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
    yes: true
  check_mode: no

- name: Configure apt
  apt:
    upgrade: dist
    options: ['--force-yes', '--allow-downgrades', '--allow-remove-essential', '--allow-change-held-packages']
    force_apt_get: yes
  check_mode: no

- name: Update all software (dnf)
  dnf:
    name: "@System"
    update_cache: yes
    upgrade: min
    exclude: kernel*
  check_mode: no

- name: Update all software (pacman)
  pacman:
    sync: '@system'
    refresh: yes
    upgrade: yes
  check_mode: no

- name: Configure yum
