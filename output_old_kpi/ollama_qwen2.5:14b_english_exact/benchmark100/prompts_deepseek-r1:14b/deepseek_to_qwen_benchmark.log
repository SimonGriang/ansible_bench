    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip"
    dest: "/tmp/promtail-linux-amd64.zip"
    sha256sum: "{{ promtail_sha256 }}"
  when: inventory_hostname == "controller-node"

- name: Propagate promtail binaries
  copy:
    src: "/tmp/promtail-linux-amd64"
    dest: "/tmp/promtail-linux-amd64"
    mode: '0755'
  when: inventory_hostname != "controller-node"

- name: Unpack promtail binaries
  unarchive:
    src: "/tmp/promtail-linux-amd64.zip"
    dest: /opt/promtail
    remote_src: yes
    owner: promtail
    group: promtail
    mode: '0750'
    creates: /opt/promtail/promtail

- name: Create symlink to latest promtail version
  file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
    force: yes
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail.yml
    mode: '0640'
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
  notify: restart promtail

