---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    mode: 0750
    owner: "{{ user_name }}"
    group: "{{ user_name }}"

- name: Manage user account
  user:
    name: "{{ user_name }}"
    state: present
    comment: "{{ user_comment }}"
    home: "/home/{{ user_name }}"
    shell: "/bin/bash"
    uid: "{{ user_uid }}"
    gid: "{{ user_gid }}"
    groups: "{{ user_groups }}"

- name: Set sudo options for user
  lineinfile:
    path: "/etc/sudoers.d/{{ user_name }}"
    line: "{{ user_name }} ALL=(ALL) NOPASSWD:ALL"
    create: yes
    mode: 0440
    owner: root
    group: root

- name: Generate private SSH key for user
  command: ssh-keygen -t rsa -f /home/{{ user_name }}/.ssh/id_rsa -N ''
  args:
    creates: /home/{{ user_name }}/.ssh/id_rsa

- name: Generate public SSH key for user
  command: ssh-keygen -y -f /home/{{ user_name }}/.ssh/id_rsa > /home/{{ user_name }}/.ssh/id_rsa.pub

- name: Convert SSH key to ppk format for user
  command: puttygen /home/{{ user_name }}/.ssh/id_rsa -o /home/{{ user_name }}/.ssh/id_rsa.ppk -O force-dsa

- name: Get or set the home directory for user
  command: getent passwd {{ user_name }} | cut -d: -f6
  register: user_home
  changed_when: false
  failed_when: false
  when: user_home is defined
  register: user_home_dir
  changed_when: false
  failed_when: false
  when: user_home_dir.stdout == ""

- name: Create .ssh directory for user
  file:
    path: "/home/{{ user_home_dir.stdout }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user_name }}"
    group: "{{ user_name }}"

- name: Deploy authorized keys for user
  copy:
    src: /path/to/authorized_keys
    dest: "/home/{{ user_name }}/.ssh/authorized_keys"
    mode: 0600
    owner: "{{ user_name }}"
    group: "{{ user_name }}"

- name: Remove unauthorized keys for user
  command: ssh-keygen -f /home/{{ user_name }}/.ssh/authorized_keys -R {{ unauthorized_keys }}

- name: Copy generated private SSH key for user
  copy:
    src: /home/{{ user_name }}/.ssh/id_rsa
    dest: /home/{{ user_name }}/.ssh/id_rsa.copy
    mode: 0600
    owner: "{{ user_name }}"
    group: "{{ user_name }}"

- name: Check users password valid time for user
  command: chage -l {{ user_name }}
  register: password_validity
  changed_when: false
  failed_when: false

- name: Set users password valid time for user
  command: chage -M {{ max_days }} -m {{ min_days }} -W {{ warn }} -I {{ inactive }} -E {{ expire }} {{ user_name }}

- name: Place private key file for user
  copy:
    src: /home/{{ user_name }}/.ssh/id_rsa
    dest: "/home/{{ user_name }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user_name }}"
    group: "{{ user_name }}"

