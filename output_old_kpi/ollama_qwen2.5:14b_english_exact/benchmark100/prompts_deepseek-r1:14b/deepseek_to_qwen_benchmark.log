---
- import_tasks: assert.yml
 delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"

- name: Configure selinux
  when: selinux_enabled
  seboolean:
    name: "{{ item.key }}"
    state: "{{ item.value }}"
  loop: "{{ httpd_selinux_booleans|default({})|dict2items }}"
  notify: test httpd configuration
  notify: restart httpd

- name: Configure httpd
  template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: '0644'
  notify: test httpd configuration
  notify: restart httpd

- name: Activate httpd module | Debian
  when: ansible_os_family == 'Debian'
  shell: a2enmod "{{ item }}"
  args:
    creates: "/etc/apache2/mods-enabled/{{ item }}"
  loop: "{{ httpd_modules }}"
  register: _output
  changed_when: "'enabled' in _output.stdout"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations|length > 0

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts|length > 0

- name: Configure ports
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_conf_src }}"
    dest: "{{ httpd_ports_conf_dest }}"
  notify: test httpd configuration
  notify: restart httpd

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories|length > 0

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ item }}"
    state: absent
  loop: "{{ httpd_remove_example|default([]) }}"
  when: httpd_remove_example|length > 0

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes

