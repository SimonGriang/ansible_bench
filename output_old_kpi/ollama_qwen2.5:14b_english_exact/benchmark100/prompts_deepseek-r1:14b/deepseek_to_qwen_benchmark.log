    - epel-next-release
  when: epel_next == true and (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or ansible_distribution == 'RedHat' and (ansible_distribution_major_version == '7' or ansible_distribution_major_version == '8' or ansible_distribution_major_version == '9'))
