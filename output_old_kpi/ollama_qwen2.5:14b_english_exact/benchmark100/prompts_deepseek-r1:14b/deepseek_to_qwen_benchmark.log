---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install fail2ban
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ fail2ban_packages }}"

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/{{ item | basename }}
    owner: root
    group: root
    mode: 0640
  loop: "{{ fail2ban_filters }}"
  when: fail2ban_filterd_path is defined
  notify: Restart fail2ban handler

- name: Configure fail2ban.local
  lineinfile:
    path: /etc/fail2ban/fail2ban.local
    regexp: '^{{ item.option }}='
    line: "{{ item.option }}={{ item.value }}"
    mode: 0640
  with_items: "{{ fail2ban_base_configuration | community.general.dict2items }}"
  notify: Restart fail2ban handler
  loop: "{{ fail2ban_configuration | community.general.dict2items }}"
  when: item.option not in fail2ban_base_configuration
  loop_control:
    label: "{{ item.option }}"

- name: Configure jail.local
  lineinfile:
    path: /etc/fail2ban/jail.local
    regexp: '^{{ item.option }}='
    line: "{{ item.option }}={{ item.value }}"
    mode: 0640
  with_items: "{{ fail2ban_base_jail_configuration | community.general.dict2items }}"
  notify: Restart fail2ban handler
  loop: "{{ fail2ban_jail_configuration | community.general.dict2items }}"
  when: item.option not in fail2ban_base_jail_configuration
  loop_control:
    label: "{{ item.option }}"

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  when: fail2ban_auth.stat.exists is not defined

- name: Start and enable fail2ban
  systemd:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: yes

