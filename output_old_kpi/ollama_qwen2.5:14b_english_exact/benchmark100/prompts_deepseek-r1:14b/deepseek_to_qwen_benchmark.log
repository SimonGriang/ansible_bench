---
- name: Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: /etc/ssl/private/private.key
    mode: '0600'
    owner: root
    group: root
  tags:
    - ssl-key

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/private/private.csr
    privatekey_path: /etc/ssl/private/private.key
    country: US
    state: New York
    locality: NY
    organization: Example Inc.
    organizational_unit: IT
    common_name: example.com
    mode: '0600'
  tags:
    - ssl-csr

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: /etc/ssl/private/certificate.crt
    privatekey_path: /etc/ssl/private/private.key
    csr_path: /etc/ssl/private/private.csr
    provider: selfsigned
    mode: '0600'
  tags:
    - ssl-cert

- name: Create a PKCS#12 file
  openssl_pkcs12:
    export: true
    path: /etc/ssl/private/private.p12
    name: example.com
    certificate: /etc/ssl/private/certificate.crt
    privatekey: /etc/ssl/private/private.key
    privatekey_pass: "{{ vault_ssl_key_password }}"
    cacerts: /etc/ssl/private/certificate.crt
    mode: '0600'
  tags:
    - ssl-pkcs12

- name: Read the private key content
  slurp:
    src: /etc/ssl/private/private.key
  register: ssl_private_key
  tags:
    - ssl-read-private-key

- name: Read the certificate content
  slurp:
    src: /etc/ssl/private/certificate.crt
  register: ssl_certificate
  tags:
    - ssl-read-certificate

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ ssl_private_key.content | b64decode }}"
    dest: /etc/ssl/private/combined.pem
    mode: '0600'
  when: ssl_private_key is defined
  notify:
    - add certificate content to combined.pem
  tags:
    - ssl-combined-file

- name: Add certificate content to combined.pem
  lineinfile:
    path: /etc/ssl/private/combined.pem
    line: "{{ ssl_certificate.content | b64decode }}"
    insertafter: EOF
    mode: '0600'
  when: ssl_certificate is defined
  tags:
    - ssl-combined-file

