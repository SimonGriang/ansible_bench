---
- import_tasks: assert.yml

- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  getent:
    database: passwd
    key: user
  register: user_check
  changed_when: false
  failed_when: false

- name: Create git config directory
  file:
    path: "{{ lookup('env', 'HOME') }}/git/config"
    state: directory
    mode: '0755'
  when: user_check is defined

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ lookup('env', 'HOME') }}/.gitconfig"
    mode: '0644'
  when: user_check is defined

- name: Create repository destination
  file:
    path: /opt/git_repos
    state: directory
    mode: '0755'

- name: Clone all repositories
  git:
    repo: "{{ item['repo'] }}"
    dest: "{{ item['dest'] }}"
    version: "{{ item['version'] }}"
    update: yes
    clone: yes
    force: yes
    accept_hostkey: yes
    executable: /usr/bin/git
    update_on_change: no
  with_items:
    - { repo: 'https://example.com/repo1.git', dest: '/opt/git_repos/repo1', version: 'master' }
    - { repo: 'https://example.com/repo2.git', dest: '/opt/git_repos/repo2', version: 'develop' }
  notify: Set repository permissions
  when: user_check is defined

- name: Set repository permissions
  file:
    path: "{{ item.item['dest'] }}"
    mode: '0755'
  with_items: "{{ ansible_results }}"
  when: user_check is defined

