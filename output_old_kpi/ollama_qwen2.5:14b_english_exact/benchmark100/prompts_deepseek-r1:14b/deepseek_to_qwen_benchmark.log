---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main/rfc
    value: no
    vtype: select
  when: ansible_facts['os_family'] == 'Debian'

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_use_mysql|default(False) == True

- name: Configure postfix (transport_maps)
  template:
    src: transport.conf.j2
    dest: /etc/postfix/transport
  notify: validate_transport_maps
  notify: rebuild_transport_database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify: validate_header_checks
  notify: reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_recipient_restrictions: "{{ postfix_main_recipient_restrictions|default(['permit_mynetworks', 'reject_unauth_destination']) }}"
    postfix_main_sender_access: "{{ postfix_main_sender_access|default('permit_mynetworks') }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mydestination: "{{ postfix_mydestination|default(['localhost', 'localhost.localdomain']) }}"
    postfix_relay_domains: "{{ postfix_relay_domains|default([]) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: validate_maincf
  notify: restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: validate_mastercf
  notify: restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0700
  with_items:
    - /etc/postfix/ssl
  notify: reload_postfix

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ item }}"
    dest: /etc/postfix/ssl/smtpd.cert
    mode: 0600
  notify: reload_postfix
  when: item is defined
  with_items:
    - "{{ postfix_tls_server_cert }}"

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ item }}"
    dest: /etc/postfix/ssl/smtpd.key
    mode: 0600
  notify: reload_postfix
  when: item is defined
  with_items:
    - "{{ postfix_tls_server_key }}"

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/postfix/aliases
    line: "{{ item }}"
  with_items:
    - "testuser: testuser"
  notify: rebuild_aliases
  notify: reload_postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item }}"
  with_items:
    - "testuser: permit"
  notify: rebuild_sender_access
  notify: reload_postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item }}"
  with_items:
    - "testuser: testuser@domain.com"
  notify: validate_recipient_access
  notify: rebuild_recipient_access
  notify: reload_postfix

- name: Place sasl_password_map
  copy:
    src: /path/to/sasl_password_map
    dest: /etc/postfix/sasl_password
  notify: rebuild_sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

