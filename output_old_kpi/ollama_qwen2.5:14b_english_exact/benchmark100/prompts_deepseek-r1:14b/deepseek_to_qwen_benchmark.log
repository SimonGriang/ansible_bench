---
- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: root
    group: root
    backup: yes

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/private/myapp.csr
    privatekey_path: /etc/ssl/private/myapp.key
    country_name: US
    state_or_province_name: New York
    locality_name: New York City
    organization_name: MyCompany Inc.
    common_name: myapp.example.com
    mode: '0600'
    owner: root
    group: root
    backup: yes

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: /etc/ssl/certs/myapp.crt
    privatekey_path: /etc/ssl/private/myapp.key
    csr_path: /etc/ssl/private/myapp.csr
    provider: selfsigned
    mode: '0644'
    owner: root
    group: root
    backup: yes

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    export: yes
    path: /etc/ssl/private/myapp.p12
    name: "{{ 'myapp.example.com' }}"
    certificate: /etc/ssl/certs/myapp.crt
    privatekey: /etc/ssl/private/myapp.key
    mode: '0644'
    owner: root
    group: root
    backup: yes

- name: Read private key content
  slurp:
    src: /etc/ssl/private/myapp.key
  register: private_key_content

- name: Read certificate content
  slurp:
    src: /etc/ssl/certs/myapp.crt
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content['content'] + certificate_content['content'] }}"
    dest: /etc/ssl/private/myapp.pem
    mode: '0644'
    owner: root
    group: root
    backup: yes

