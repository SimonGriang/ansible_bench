---
- ansible.builtin.import_tasks: assert.yml

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ packages }}"
  notify:
    - set_root_password
    - ansible.builtin.systemctl_daemon_reload

- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: "{{ mysql_conf_dir }}/{{ item }}"
    line: "{{ options[item] }}"
  with_items: "{{ options }}"
  notify:
    - restart_mysql

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: "socket={{ mysql_socket }}"
  notify:
    - restart_mysql

- name: Initialize mysql
  ansible.builtin.command:
    cmd: "{{ mysql_init_db_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: mysql.cnf.j2
    dest: /etc/mysql/conf.d/custom.cnf
    mode: '0644'

- name: Create databases
  ansible_community_mitogen.mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ databases }}"
  when: not initial_import

- name: List databases
  ansible_community_mitogen.mysql_db:
    name: "{{ item }}"
    state: present
  register: db_check
  with_items: "{{ databases }}"

- name: Import database
  ansible_community_mitogen.mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ initial_import }}"
  when: initial_import and not db_check.results[item].changed

- name: Create users
  ansible_community_mitogen.mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.database }}.*:{{ item.privileges }}"
  with_items: "{{ users }}"
  notify:
    - restart_mysql

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

