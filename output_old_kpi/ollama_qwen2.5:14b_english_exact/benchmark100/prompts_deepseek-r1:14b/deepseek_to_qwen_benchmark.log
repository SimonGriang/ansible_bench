- name: locations | Enable modules
  ansible.builtin.a2enmod:
    mod_names:
      - proxy
      - proxy_http
  when: ansible_facts["os_family"] == "Debian"

- name: locations | Enable modules
  ansible.builtin.yum:
    name: "mod_proxy"
    state: present
  when: ansible_facts["os_family"] == "RedHat"

- name: locations | Enable modules
  ansible.builtin.yum:
    name: "mod_proxy_http"
    state: present
  when: ansible_facts["os_family"] == "RedHat"

- name: locations | Configure locations
  template:
    src: httpd-locations.conf.j2
    dest: /etc/apache2/sites-available/httpd-locations.conf
  loop: "{{ httpd_locations }}"
  notify: restart apache
  when: ansible_facts["os_family"] == "Debian"

