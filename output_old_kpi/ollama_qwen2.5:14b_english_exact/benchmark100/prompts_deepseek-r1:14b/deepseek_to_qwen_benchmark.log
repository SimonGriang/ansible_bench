---
- import_tasks: assert.yml
  name: Import assertion tasks from assert.yml to validate logrotate setup.

- name: Install logrotate package using the package name specified in logrotate_packages variable.
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate by templating the configuration file from logrotate_config_file.j2 to the specified directory.
  template:
    src: "{{ logrotate_config_file }}"
    dest: /etc/logrotate.conf
    owner: root
    group: root
    mode: '0644'

- name: Generate logrotate.d configuration files using templates for each entry in logrotate_entries, skipping entries marked as absent.
  template:
    src: "{{ item.src }}"
    dest: "/etc/logrotate.d/{{ item.dest }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries|rejectattr('absent', 'defined')|list }}"

- name: Remove logrotate.d files for entries marked as absent in logrotate_entries.
  file:
    path: "/etc/logrotate.d/{{ item }}"
    state: absent
  loop: "{{ logrotate_entries|json_query('[].dest ? (@.absent == true)')|list }}"

- name: Start and enable the logrotate service if logrotate_service is defined, using the specified service state and enabled parameters.
  service:
    name: "{{ logrotate_service }}"
    enabled: "{{ logrotate_service_enabled|default('yes') }}"
    state: "{{ logrotate_service_state|default('started') }}"

