---
- name: Import assertion file
  include_tasks: assert.yml
  remote_src: yes
  args:
    path: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  when: java_vendor == "openjdk"
  package:
    name: "{{ lookup('ansible_distribution_release') == 'ol' ? 'java-1.8.0-openjdk' : 'default-jre' }}"
    state: present

- name: Install Oracle Java RPM from local
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: "{{ java_rpm_path }}"
    dest: /tmp/java.rpm
  package:
    name: /tmp/java.rpm
    state: present
  notify: setup_java_home

- name: Install Oracle Java DEB from local
  when: java_source == "local" and java_format == "deb"
  copy:
    src: "{{ java_deb_path }}"
    dest: /tmp/java.deb
  package:
    name: /tmp/java.deb
    state: present
  notify: setup_java_home

- name: Install Oracle Java RPM from repository
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ lookup('ansible_distribution_release') == 'ol' ? 'java-1.8.0-oracle' : 'oracle-java8-installer' }}"
    state: present
  notify: setup_java_home

- name: Configure Oracle Java targz installation
  when: java_format == "targz" and java_vendor == "oracle"
  unarchive:
    src: "{{ java_targz_path }}"
    dest: /opt
    remote_src: yes
  file:
    path: /opt/jdk1.8.0_{{ java_version_short }}/jre/bin/java
    mode: 'u+x'
  notify: setup_java_home

- name: Install Oracle Java JCE policy
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  copy:
    src: "{{ java_jce_policy_path }}"
    dest: /usr/java/jdk1.8.0_{{ java_version_short }}-jre/lib/security
    remote_src: yes
    owner: root
    group: root
    mode: 0644

- name: Set Java alternative
  when: java_format == "targz" and not ansible_distribution == "Alpine"
  command: alternatives --install /usr/bin/java java /opt/jdk1.8.0_{{ java_version_short }}/jre/bin/java 20000
  notify: setup_java_home

- name: Find Java home directory
  command: readlink -f /usr/bin/java
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home.stdout }}"
    create: yes
  notify: setup_java_home

