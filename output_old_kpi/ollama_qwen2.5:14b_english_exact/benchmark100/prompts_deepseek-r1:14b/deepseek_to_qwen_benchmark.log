---
- name: Import assertion tasks from assert.yml and run them once on localhost
  ansible.builtin.import_tasks: assert.yml
  vars:
    remote_addr: localhost

- name: Install OpenVPN packages specified in the openvpn_packages variable
  ansible.builtin.package:
    name: "{{ openvpn_packages }}"
    state: present

- name: Include tasks from either openvpn-server.yml or openvpn-client.yml
  ansible.builtin.include_tasks: "{{ openvpn_role }}.yml"

- name: Start and enable the OpenVPN service
  ansible.builtin.systemd:
    name: "{{ openvpn_service }}"
    state: started
    enabled: true


