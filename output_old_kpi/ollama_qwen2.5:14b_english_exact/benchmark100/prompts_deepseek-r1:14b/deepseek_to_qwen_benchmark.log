content='---\n- name: Download RKE2 installation script\n  ansible.builtin.get_url:\n    url: "{{ rke2_install_url }}"\n    dest: "{{ rke2_install_script_path }}"\n    mode: 0700\n  when: airgap is not defined or airgap != True\n\n- name: Copy local RKE2 installation script\n  ansible.builtin.copy:\n    src: "{{ rke2_install_local_script }}"\n    dest: "{{ rke2_install_script_path }}"\n    mode: 0700\n  when: airgap is defined and airgap == True and rke2_implementation == \'copy\'\n\n- name: Create RKE2 artifacts folder\n  ansible.builtin.file:\n    path: "{{ rke2_artifacts_path }}"\n    state: directory\n    mode: 0700\n  when: airgap is defined and airgap == True and rke2_implementation != \'exists\'\n\n- name: Download RKE2 checksum and artifacts\n  ansible.builtin.get_url:\n    url: "{{ rke2_artifacts_url }}"\n    dest: "{{ rke2_artifacts_path }}"\n    mode: 0700\n    force_basic_auth: true\n    validate_certs: "{{ validate_certs }}"\n  register: rke2_artifacts_download\n  retries: 3\n  delay: 5\n  until: rke2_artifacts_download is success\n  when: airgap is not defined or airgap != True\n\n- name: Copy local RKE2 artifacts\n  ansible.builtin.copy:\n    src: "{{ rke2_artifacts_local }}"\n    dest: "{{ rke2_artifacts_path }}"\n    mode: 0640\n  when: airgap is defined and airgap == True and rke2_implementation == \'copy\'\n\n- name: Airgap mode - additional images tarballs\n  block:\n    - name: Create additional images tarballs directory\n      ansible.builtin.file:\n        path: "{{ rke2_additional_images_path }}"\n        state: directory\n        mode: 0700\n      when: airgap is defined and airgap == True and rke2_additional_images is defined\n\n    - name: Copy additional images tarballs\n      ansible.builtin.copy:\n        src: "{{ item }}"\n        dest: "{{ rke2_additional_images_path }}"\n        mode: 0700\n      loop: "{{ rke2_additional_images }}"\n      when: airgap is defined and airgap == True and rke2_additional_images is defined\n\n  when: airgap is defined and airgap == True\n\n- name: Airgap mode - ensure artifacts exist and have acceptable permissions\n  block:\n    - name: Ensure RKE2 artifacts exist\n      ansible.builtin.stat:\n        path: "{{ rke2_artifacts_path }}"\n      register: rke2_artifacts_stat\n\n    - name: Ensure RKE2 artifacts are read-only\n      ansible.builtin.file:\n        path: "{{ rke2_artifacts_path }}"\n        state: file\n        mode: 0440\n      when: rke2_artifacts_stat.stat.exists and rke2_implementation == \'exists\'\n\n    - name: Ensure RKE2 install script exists\n      ansible.builtin.stat:\n        path: "{{ rke2_install_script_path }}"\n      register: rke2_install_stat\n\n    - name: Ensure RKE2 install script is executable\n      ansible.builtin.file:\n        path: "{{ rke2_install_script_path }}"\n        state: file\n        mode: 0700\n      when: rke2_install_stat.stat.exists and rke2_implementation == \'exists\'\n\n  when: airgap is defined and airgap == True and rke2_implementation == \'exists\'\n\n- name: Populate service facts\n  ansible.builtin.setup:\n    filter: service.*\n  when: airgap is not defined or airgap != True\n\n- name: Get stats of the FS object\n  ansible.builtin.stat:\n    path: /usr/local\n  register: fs_stat\n  when: airgap is not defined or airgap != True\n\n- name: Set RKE2 bin path\n  ansible.builtin.set_fact:\n    rke2_bin_path: "{{ \'/usr/local/bin\' if fs_stat.stat.isdir and fs_stat.stat.isblk else \'/opt/bin\' }}"\n  when: airgap is not defined or airgap != True\n\n- name: Check RKE2 version\n  ansible.builtin.shell: "{{ rke2_bin_path }}/rke2 version --format \'{{.BinaryName}} {{.Version}} {{.GitCommit}} {{.GoVersion}} {{.UserAgent}}\'"\n  register: rke2_version\n  failed_when: false\n  when: airgap is not defined or airgap != True\n\n- name: Prevent accidental RKE2 downgrade\n  ansible.builtin.shell: "echo {{ rke2_version.stdout }} | grep -qP \'rke2 v\\\\d+\\\\.\\\\d+\\\\.\\\\d+(\\\\-[0-9a-z]+)?\'"\n  register: rke2_version_r