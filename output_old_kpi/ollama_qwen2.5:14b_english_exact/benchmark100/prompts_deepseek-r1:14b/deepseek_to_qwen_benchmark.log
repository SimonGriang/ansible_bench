---
- import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - selinux_status is defined
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']
  block:
    - name: Task 4.1: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Task 4.2: Manage SELinux booleans
      when: selinux_booleans is defined
      loop: "{{ selinux_booleans }}"
      register: boolean_results
      selboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      notify: Reboot
  # Corrected the indentation and split the long line to adhere to yamllint standards

