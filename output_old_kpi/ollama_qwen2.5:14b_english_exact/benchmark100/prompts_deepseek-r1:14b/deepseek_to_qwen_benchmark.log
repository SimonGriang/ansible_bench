---
- name: Install EPEL repository on compatible systems
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - epel-release
    - epel-next-release
  when: epel_next and (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or ansible_distribution == 'RedHat' and (ansible_distribution_major_version == '7' or ansible_distribution_major_version == '8' or ansible_distribution_major_version == '9'))
  loop_control:
    extended: true

- name: Install EPEL GPG key
  ansible.builtin.yum:
    name: "https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}"
    state: present
    update_cache: yes

- name: Install EPEL release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
    update_cache: yes

- name: Install EPEL next release package (conditional)
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
    update_cache: yes
  when: epel_next

