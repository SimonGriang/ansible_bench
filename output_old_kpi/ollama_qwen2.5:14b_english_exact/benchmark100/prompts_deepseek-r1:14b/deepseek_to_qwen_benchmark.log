---
- name: Install EPEL GPG key
  rpm_key:
    key: "{{ epel_key }}"
  when: ansible_os_family == "RedHat" and (ansible_distribution_version in ['7', '8', '9', '10'] or ansible_distribution == "Amazon" and ansible_distribution_major_version == "2")

- name: Install EPEL-release package
  yum:
    name: "{{ epel_url }}"
    state: present
  when: ansible_os_family == "RedHat" and (ansible_distribution_version in ['7', '8', '9', '10'] or ansible_distribution == "Amazon" and ansible_distribution_major_version == "2")

- name: Install EPEL-next-release package
  yum:
    name: "{{ epel_next_url }}"
    state: present
  when: ansible_os_family == "RedHat" and (ansible_distribution_version in ['7', '8', '9', '10'] or ansible_distribution == "Amazon" and ansible_distribution_major_version == "2") and epel_next|default(false)|bool

- name: Update package cache
  meta: flush_cache
  listen: update_package_cache

