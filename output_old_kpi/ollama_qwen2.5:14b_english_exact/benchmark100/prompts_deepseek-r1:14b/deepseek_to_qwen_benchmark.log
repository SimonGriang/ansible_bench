```yaml
- name: Include OS-specific variables
  include_vars:
    dir: vars/
    recursive: true
    file: "{{ ansible_distribution }}.yml, {{ ansible_os_family }}.yml"

- name: Include OS family specific tasks
  include_tasks: "{{ ansible_os_family }}-setup.yml"

- name: Install Docker packages
  ansible.builtin.yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    disable_gpg_key_check: true
  notify: restart docker
  register: package_result
  when: ansible_version.version_info.major | int < 2 or ansible_distribution_family not in ['redhat', 'debian']

- name: Install Docker packages with downgrade option
  ansible.builtin.yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    disable_gpg_key_check: true
    enablerepo: docker-ce-{{ ansible_distribution_major_version }}
  notify: restart docker
  register: package_result
  when: ansible_version.version_info.major | int >= 2 and ansible_distribution_family in ['redhat', 'debian']

- name: Install docker-compose plugin
  ansible.builtin.yum:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    disable_gpg_key_check: true
  notify: restart docker
  register: package_result
  when: docker_install_compose_plugin and (ansible_version.version_info.major | int < 2 or ansible_distribution_family not in ['redhat', 'debian'])

- name: Install docker-compose-plugin with downgrade option
  ansible.builtin.yum:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    disable_gpg_key_check: true
    enablerepo: docker-ce-{{ ansible_distribution_major_version }}
  notify: restart docker
  register: package_result
  when: docker_install_compose_plugin and ansible_version.version_info.major | int >= 2 and ansible_distribution_family in ['redhat', 'debian']

- name: Ensure /etc/docker directory exists
  ansible.builtin.file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  ansible.builtin.copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: docker_daemon_options is defined

- name: Ensure Docker service is started and enabled
  ansible.builtin.systemd:
    name: docker
    state: started
    enabled: "{{ docker_service_enabled }}"
    daemon_reload: yes
  ignore_errors: "{{ ansible_check_mode | bool }}"
  when: docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  ansible.builtin.meta:
    flush_handlers: true

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  ansible.builtin.getent:
    database: group
    key: docker
  register: group_result
  when: docker_users is defined

- name: Set fact for user modification
  ansible.builtin.set_fact:
    user_modification_required: "{{ group_result | failed | bool or (docker_users | length > 0 and docker_users | difference(group_result.results | selectattr('group', 'defined') | map(attribute='group.gr_mem')) | length > 0) }}"
  when: docker_users is defined

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: user_modification_required
```


