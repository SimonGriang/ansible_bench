---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  when: node_type == 'server'
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^#?\s*taints:'
    line: 'taints: [\'node-role.kubernetes.io/control-plane=:noSchedule\''
    insertafter: '^#?\s*taints:'

- name: Set agent taints
  when: node_type == 'agent'
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^#?\s*taints:'
    line: 'taints: [\'node-role.kubernetes.io/worker=:noSchedule\''
    insertafter: '^#?\s*taints:'

- name: Copy RKE2 configuration file
  copy:
    src: rke2-config.yaml.j2
    dest: /etc/rke2/config.yaml
    mode: '0640'
  notify: restart_rke2

- name: Copy Kubelet configuration file
  when: kubelet_config is defined
  copy:
    src: kubelet-config.yaml.j2
    dest: /etc/systemd/system/kubelet.service.d/10-kubelet.yaml
    mode: '0640'
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  when: containerd_registry_config is defined
  copy:
    src: "{{ containerd_registry_config }}"
    dest: /etc/containerd/config.toml
    mode: '0640'
  notify: restart_rke2

- name: Start RKE2 service on other nodes
  when: inventory_hostname != node_name
  systemd:
    name: rke2
    state: started
    enabled: yes
  notify: restart_rke2

- name: Mask other RKE2 services on nodes
  when: node_type == 'server'
  block:
    - systemd:
        name: rke2-agent
        state: masked

  when: node_type == 'agent'
  block:
    - systemd:
        name: rke2-server
        state: masked

- name: Wait for remaining nodes to be ready - no CNI
  when: cni == 'none'
  block:
    - wait_for:
        host: "{{ item }}"
        port: 6443
        timeout: 60
      register: node_ready
      until: node_ready is succeeded
      retries: 60
      delay: 1

- name: Wait for remaining nodes to be ready - with CNI
  when: cni is defined
  block:
    - wait_for:
        host: "{{ item }}"
        port: 6443
        timeout: 60
      register: node_ready
      until: node_ready is succeeded
      retries: 60
      delay: 1

