---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  remote_host: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ service_required_packages }}"
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: "{{ item }}"
  loop: "{{ service_list }}"
  when: service_template == 'systemd'

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: "{{ item }}"
  loop: "{{ service_list }}"
  when: service_template == 'sysvinit'

- name: Manage service
  service:
    name: "{{ item.service }}"
    enabled: "{{ item.enabled | default(true) | bool }}"
    state: "{{ item.state }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers

