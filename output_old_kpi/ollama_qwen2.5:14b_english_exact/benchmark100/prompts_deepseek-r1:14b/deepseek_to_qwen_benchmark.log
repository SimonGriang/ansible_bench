---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  ansible.builtin.command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate OpenVPN CA certificate
  ansible.builtin.command: easyrsa build-ca nopass
  vars:
    EASYRSA_BATCH: yes
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate server certificate
  ansible.builtin.command: easyrsa build-server-full server nopass
  vars:
    EASYRSA_BATCH: yes
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate client certificate
  ansible.builtin.command: easyrsa build-client-full client nopass
  vars:
    EASYRSA_BATCH: yes
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate Certificate Revocation List
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate OpenVPN TA key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0640'
  loop:
    - src: /etc/openvpn/easy-rsa/pki/ca.crt
      dest: /etc/openvpn/server/ca.crt
    - src: /etc/openvpn/easy-rsa/pki/tls-crypt.key
      dest: /etc/openvpn/server/tls-crypt.key
    - src: /etc/openvpn/easy-rsa/pki/ta.key
      dest: /etc/openvpn/server/ta.key

- name: Copy additional PKI files to /etc/openvpn directory
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0640'
  loop:
