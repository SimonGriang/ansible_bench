---
- import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - connection is 'network'
    - ansible_facts['network'] is defined

- name: Prepare system
  block:
    - name: Test connection and sudo access
      command: whoami
      changed_when: False
      failed_when: False
      become: no
      delegate_to: localhost

    - name: Gather facts and install packages
      block:
        - setup:
            gather_subset:
              - "min"

        - raw: yum makecache
          when: ansible_facts['os_family'] == 'RedHat'
          delegate_to: localhost
          changed_when: False
          failed_when: False

        - raw: dnf makecache
          when: ansible_facts['os_family'] != 'RedHat'
          delegate_to: localhost
          changed_when: False
          failed_when: False

      rescue:
        - name: Install libdnf5 on RedHat
          package:
            name: libdnf5
            state: present
          when: ansible_facts['os_family'] == 'RedHat'
          delegate_to: localhost

- name: Gather ansible facts
  setup:
  when: connection is not 'network'

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"

