```yaml
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  ansible.builtin.set_fact:
    rke2_server_node_taints: "{{ rke2_server_node_taints | default('') }}"
  when: is_rke2_server

- name: Copy RKE2 configuration file
  ansible.builtin.copy:
    src: "{{ rke2_config_file }}"
    dest: /etc/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
    notify: restart_rke2

- name: Copy kubelet configuration file
  ansible.builtin.copy:
    src: "{{ rke2_kubelet_config_file }}"
    dest: /etc/rke2/kubelet.yaml
    mode: '0644'
    owner: root
    group: root
    notify: restart_rke2
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_config_file }}"
    dest: /etc/rke2/registries.yaml
    mode: '0644'
    owner: root
    group: root
    notify: restart_rke2
  when: rke2_containerd_config is defined and rke2_containerd_config | length > 0

- name: Register etcd restore from file
  ansible.builtin.set_fact:
    etcd_restore_from_file: "{{ etcd_restore_file is defined and etcd_restore_file | length > 0 and not rke2_service_active }}"

- name: Register etcd restore from S3
  ansible.builtin.set_fact:
    etcd_restore_from_s3: "{{ etcd_s3_bucket is defined and etcd_s3_bucket | length > 0 and etcd_s3_prefix is defined and etcd_s3_prefix | length > 0 and not rke2_service_active }}"

- name: Restore etcd from file
  block:
    - name: Create etcd restore directory
      file:
        path: /var/lib/rke2/etcd-restore
        state: directory
        mode: '0750'
        owner: root
        group: root
    - name: Copy etcd snapshot file
      ansible.builtin.copy:
        src: "{{ etcd_restore_file }}"
        dest: /var/lib/rke2/etcd-restore/snapshot.db
        mode: '0644'
        owner: root
        group: root
    - name: Run etcd restore from file
      ansible.builtin.shell: >
        /usr/local/bin/etcdctl snapshot restore /var/lib/rke2/etcd-restore/snapshot.db
        --data-dir=/var/lib/rke2/data
        --name=etcd
        --initial-cluster={{ rke2_cluster_name }}:https://{{ rke2_node_name }}:2380
        --initial-cluster-state=new
        --initial-advertise-peer-urls=https://{{ rke2_node_name }}:2381
        --listen-peer-urls=https://{{ rke2_node_name }}:2381
        --listen-client-urls=https://{{ rke2_node_name }}:2379
      environment:
        ETCDCTL_API: "3"
        ETCDCTL_CACERT: "{{ rke2_etcd_ca }}"
        ETCDCTL_CERT: "{{ rke2_etcd_cert }}"
        ETCDCTL_KEY: "{{ rke2_etcd_key }}"
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Create etcd restore directory
      file:
        path: /var/lib/rke2/etcd-restore
        state: directory
        mode: '0750'
        owner: root
        group: root
    - name: Download etcd snapshot file from S3
      ansible.builtin.shell: >
        aws s3 cp s3://{{ etcd_s3_bucket }}/{{ etcd_s3_prefix }}
        /var/lib/rke2/etcd-restore/snapshot.db --region {{ etcd_s3_region }}
      args:
        creates: /var/lib/rke2/etcd-restore/snapshot.db
    - name: Run etcd restore from file
      ansible.builtin.shell: >
        /usr/local/bin/etcdctl snapshot restore /var/lib/rke2/etcd-restore/snapshot.db
        --data-dir=/var/lib/rke2/data
        --name=etcd
        --initial-cluster={{ rke2_cluster_name }}:https://{{ rke2_node_name }}:2380
        --initial-cluster-state=new
        --initial-advertise-peer-urls=https://{{ rke2_node_name }}:2381
        --listen-peer-urls=https://{{ rke2_node_name }}:2381
        --listen-client-urls=https://{{ rke2_node_name }}:2379
      environment:
        ETCDCTL_API: "3"
        ETCDCTL_CACERT: "{{ rke2_etcd_ca }}"
        ETCDCTL_CERT: "{{ rke2_etcd_cert }}"
        ETCDCTL_KEY: "{{ rke2_etcd_key }}"
  when: etcd_restore_from_s3

- name: Start RKE2 service
  ansible.builtin.service:
    name: rke2-server
    enabled: yes
    state: started
    environment:
      RKE2_TOKEN: "{{ rke2_token | default('') }}"
    notify: notify_rke2_start

- name: Mask RKE2 agent service
  ansible.builtin.service:
    name: rke2-agent
    enabled: no
    state: stopped

- name: Wait for first server to be ready (no CNI)
  ansible.builtin.wait_for:
    path: http://{{ rke2_cluster_name }}:8080/api/v1/nodes/{{ rke2_node_name }}
    state: started
    delay: 10
    timeout: 600
  when: rke2_cni == 'none'

- name: Wait for first server to be ready (with CNI)
  ansible.builtin.wait_for:
    path: http://{{ rke2_cluster_name }}:8080/api/v1/nodes/{{ rke2_node_name }}
    state: started
    delay: 10
    timeout: 600
  when: rke2_cni != 'none'

- name: Restore etcd
  block:
    - name: Remove old etcd node
      ansible.builtin.shell: >
        kubectl delete node {{ rke2_node_name }}
        kubectl delete secret etcd-certs-{{ rke2_node_name }} -n kube-system
    when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ rke2_node_name }}"
  delegate_to: all
```


