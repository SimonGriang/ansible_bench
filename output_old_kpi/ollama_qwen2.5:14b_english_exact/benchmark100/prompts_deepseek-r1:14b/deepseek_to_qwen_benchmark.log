  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: not (ansible_connection == 'container' or ansible_connection == 'docker' or ansible_connection == 'community.docker.docker')

- name: Prepare system for bootstrap
  command: true
  timeout: "{{ bootstrap_timeout }}"
  become: "{{ bootstrap_become }}"
  rescue:
    - name: Gather ansible facts
      setup: {}
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"

