---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_data_dir }}", mode: "0750", owner: "{{ dns_owner }}", group: "{{ dns_owner }}"}
    - { path: "{{ dns_conf_dir }}", mode: "0750", owner: "{{ dns_owner }}", group: "{{ dns_owner }}"}

- name: Create group
  group:
    name: "{{ dns_group }}"
    system: yes

- name: Create user
  user:
    name: "{{ dns_owner }}"
    uid: "{{ dns_uid }}"
    system: yes

- name: Generate rndc key
  command: "{{ dns_conf_dir }}/rndc-keygen"
  args:
    creates: "{{ dns_conf_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_conf_dir }}/rndc.key"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_data_dir }}/hints"
    mode: "0644"
  when: dns_caching_dns

- name: Create zone file
  block:
    - name: Create DNS zone file from template
      template:
        src: "{{ item }}"
        dest: "{{ dns_data_dir }}/{{ item | basename }}"
      notify: Rndc reload
    - name: Validate DNS zone file
      command: "{{ dns_conf_dir }}/dnssec-keygen -r {{ dns_data_dir }}/random -P -a hmac-md5 -b 128 -k {{ dns_conf_dir }}/rndc.key -K {{ dns_conf_dir }} {{ dns_data_dir }}/{{ item | basename }}"
      register: dns_validation_result
      failed_when: dns_validation_result.rc != 0
  loop: "{{ dns_zone_files }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: dns.conf.j2
    dest: "{{ dns_conf_dir }}/named.conf"
  notify: Restart dns

- name: Place systemd override
  copy:
    src: "{{ dns_systemd_override }}"
    dest: "{{ dns_systemd_override_dest }}"
    mode: "0644"
  when: dns_systemd_override is defined

- name: Start and enable dns
  service:
    name: "{{ dns_service_name }}"
    enabled: true
    state: started

