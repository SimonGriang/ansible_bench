---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize OpenVPN PKI structure
  command: easyrsa init-pki chdir=/etc/openvpn/easy-rsa

- name: Generate OpenVPN CA certificate
  command: EASYRSA_BATCH=yes easyrsa build-ca nopass chdir=/etc/openvpn/easy-rsa

- name: Generate Diffie-Hellman parameters
  command: easyrsa gen-dh chdir=/etc/openvpn/easy-rsa

- name: Generate server certificate
  command: EASYRSA_BATCH=yes easyrsa build-server-full server nopass chdir=/etc/openvpn/easy-rsa

- name: Generate client certificate
  command: EASYRSA_BATCH=yes easyrsa build-client-full client nopass chdir=/etc/openvpn/easy-rsa

- name: Generate Certificate Revocation List
  command: easyrsa gen-crl chdir=/etc/openvpn/easy-rsa

- name: Generate OpenVPN TA key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: 0640
  loop:
    - { src: "/etc/openvpn/easy-rsa/pki/ca.crt", dest: "/etc/openvpn/server/ca.crt" }
    - { src: "/etc/openvpn/easy-rsa/pki/tls-crypt.key", dest: "/etc/openvpn/server/tls-crypt.key" }
    - { src: "/etc/openvpn/easy-rsa/pki/ta.key", dest: "/etc/openvpn/server/ta.key" }

- name: Copy additional PKI files to /etc/openvpn directory
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: 0640
  loop:
    - { src: "/etc/openvpn/easy-rsa/pki/ca.crt", dest: "/etc/openvpn/ca.crt" }
    - { src: "/etc/openvpn/easy-rsa/pki/ta.key", dest: "/etc/openvpn/ta.key" }

- name: Place OpenVPN server configuration file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: 0640
    owner: root
    group: root
  notify: restart openvpn

