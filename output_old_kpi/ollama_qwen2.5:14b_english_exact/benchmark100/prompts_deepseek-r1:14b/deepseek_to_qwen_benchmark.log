---
- name: Import assertion file
  import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Enable Redis module stream for RHEL 8
  dnf:
    name: redis
    state: enabled
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install Redis package
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart_redis

- name: Start and enable Redis service
  service:
    name: "{{ redis_service }}"
