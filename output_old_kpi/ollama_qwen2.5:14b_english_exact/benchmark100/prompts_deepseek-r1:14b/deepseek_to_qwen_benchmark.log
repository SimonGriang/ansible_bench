---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_systemd is defined
    fail_msg: "System must use systemd as the init system."
    success_msg: "System uses systemd as the init system."

- name: Get latest release and set promtail version
  get_url:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    return_content: yes
  register: loki_release_info
  changed_when: false
  delegate_to: localhost

- name: Set promtail_version variable
  set_fact:
    promtail_version: "{{ loki_release_info.json.tag_name.split('v')[-1] }}"

- name: Test if zip local archive exists and assert local binary exists
  block:
    - name: Check if local binary archive exists
      stat:
        path: "path/to/local/archive.zip"
      register: archive_stat
    - name: Assert local binary archive exists
      assert:
        that:
          - archive_stat.stat.exists
        fail_msg: "Local binary archive does not exist."

- name: Get checksum list and set checksum for target architecture
  get_url:
    url: "https://promtail.checksums.example.com/{{ promtail_version }}/checksums.txt"
    return_content: yes
  register: checksum_list
  changed_when: false
  delegate_to: localhost

- name: Set checksum for target architecture
  set_fact:
    promtail_checksum: "{{ checksum_list.content.splitlines()|select('match', 'amd64')|first }}"

