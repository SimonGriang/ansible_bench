---
- name: Check if Java certificates exist
  ansible.builtin.file:
    path: "{{ item }}"
    state: file
  loop: "{{ java_certs }}"
  register: java_cert_check

- name: Fail if Java certificates are missing
  ansible.builtin.fail:
    msg: "Java certificate does not exist at path {{ item.item }}"
  loop_control:
    label: "{{ item.item }}"
  loop: "{{ java_cert_check.results }}"
  when: not item.stat.exists

- name: Set keystore directory for Java versions less than 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security/cacerts"

- name: Set keystore directory for Java versions 11 or newer
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security/jssecacerts"
  when: jdk_version is versioncmp "11" >=

- name: Import SSL certificates into Java keystore
  ansible.builtin.command: >
    "{{ java_home }}/bin/keytool -import -alias {{ item.1.alias }} -file {{ item.1.path }} -keystore {{ java_keystore_dir }} {{ item.1.properties }}"
  loop: "{{ java_certificates | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  notify: restart_service
  register: import_certificate_result
  failed_when: false
  changed_when: "'Certificate was added to keystore' in import_certificate_result.stdout or 'Certificate already exists in store' in import_certificate_result.stdout`

handlers:
  - name: restart_service
    ansible.builtin.service:
      name: example-service
      state: restarted

