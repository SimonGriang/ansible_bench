    state: present
    update_cache: yes

- name: Install EPEL release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
    update_cache: yes

- name: Install EPEL next release package (conditional)
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
    update_cache: yes
  when: epel_next == true

