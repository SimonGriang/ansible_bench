---
- name: Import assertion file
  import_tasks: assert.yml
  remote_addr: localhost

- name: Install cron package
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages }}"
  when: cron_packages is defined

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL=/bin/bash"
    create: yes
    regexp: "^SHELL="
    insertafter: EOF
  when: cron_config is defined

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    create: yes
    regexp: "^PATH="
    insertafter: EOF
  when: cron_config is defined

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    regexp: "^MAILTO="
    insertafter: EOF
  when: cron_config is defined

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: "{{ 'cron_service' in hostvars|dict2items|map(attribute='key')|list }}"
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_days: "{{ item.special_days }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

