---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2-server
    state: restarted
    enabled: yes
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    namespace: kube-system
    resource: node
    wait: yes
    timeout: 1500
    wait_timeout: 15000
    wait_for: "{{ rke2_nodes_count }}"
    wait_condition: Ready=True
  register: node_ready_status
  delegate_to: "{{ groups['rke2_servers_group_name'][0] | default('localhost') }}"
  retries: 100
  delay: 15
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    resource: pod
    wait: yes
    timeout: 1500
    wait_timeout: 15000
    wait_for: "pods_ready"
    wait_condition: Ready=True
  delegate_to: "{{ groups['rke2_servers_group_name'][0] | default('localhost') }}"
  retries: 100
  delay: 15
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready | default(False)

