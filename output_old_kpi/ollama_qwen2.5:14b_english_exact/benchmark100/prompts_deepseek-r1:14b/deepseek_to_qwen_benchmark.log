---
- import_tasks: assert.yml
  args:
    remote_addr: localhost
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Set SELinux state and policy
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"

    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.boolean }}"
        state: "{{ item.state }}"
        persist: yes
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
  notify: Reboot


