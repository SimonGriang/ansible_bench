---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.slurp:
    src: /etc/os-release
  register: os_release_content
  tags:
    - gather_facts

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    distro_name: "{{ os_release_content.content | b64decode | regex_search('NAME="(.*?)"', '\\1') }}"
    distro_major_version: "{{ os_release_content.content | b64decode | regex_search('VERSION_ID=\"(\\d+)\\..*\"', '\\1') }}"
  tags:
    - gather_facts

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: "{{ lookup('ansible.builtin.fixed_var', distro_name | lower ~ '_' ~ distro_major_version) }}"
  vars:
    ubuntu_18: 'debian'
    ubuntu_20: 'debian'
    centos_7: 'redhat'
    centos_8: 'redhat'
  tags:
    - gather_facts

