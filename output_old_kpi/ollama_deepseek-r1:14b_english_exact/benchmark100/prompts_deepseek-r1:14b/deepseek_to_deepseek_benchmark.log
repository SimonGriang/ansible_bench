- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Configure apk
  become: true
  changed_when: false
  community.general.apk:
    state: update
    upgrade: true

- name: Configure apt
  become: true
  ansible.builtin.apt:
    name:
      "*": present
      bind9: absent
      vsftpd: absent
    update: true
    noinput: true
  changed_when: false

- name: Update all software (dnf)
  become: true
  ansible.builtin.dnf:
    name:
      "*": present
      kernel: absent
      kernel-devel: absent
    state: update

- name: Update all software (pacman)
  become: true
  community.general.pacman:
    state: update

- name: Configure yum
  become: true
  changed_when: false
  block:
    - name: Ensure dnf is available for RHEL/CentOS 6
      when: ansible_distribution in ['centos', 'el'] and
            ansible_distribution_major_version == '6'
      ansible.builtin.dnf:
        name:
          "*": present
          python3-dnf: present
      register: dnf_installed
    - name: Use yum for other distributions
      when: not (ansible_distribution in ['centos', 'el'] and
            ansible_distribution_major_version == '6')
      ansible.legacy.yum:
        name:
          "*": present
          yum-utils: present

- name: Update all software (zypper)
  become: true
  community.general.zypper:
    name:
      "*": present
    state: update


