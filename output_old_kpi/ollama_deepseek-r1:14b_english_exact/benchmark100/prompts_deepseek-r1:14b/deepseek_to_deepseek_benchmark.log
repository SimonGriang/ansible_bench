---
- name: lookup bootstrap facts (raw)
  command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  set_fact:
    ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  shell: |
    echo "{{ bootstrap_facts.stdout | regex_replace('\n', '') }}” | grep VERSION_ID= | cut -d'=' -f2 | cut -d'.' -f1
    echo "{{ bootstrap_facts.stdout | regex_replace('\n', '') }}” | grep PRETTY_NAME= | cut -d'=' -f2
  register: dist_info
  changed_when: false
  become: yes
  set_fact:
    bootstrap_distribution: "{{ dist_info.stdout.split(' ', 2)[0] | lower }}”
    bootstrap_distribution_major_version: "{{ dist_info.stdout.split(' ', 2)[1] | lower }}”

- name: set bootstrap facts (II)
  loop: "{{ bootstrap__os_family_map }}"
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop_control:
    label: "{{ item.key }}"
  become: yes


