---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Configure apk
  become: yes
  apk:
    state: update
    upgrade: yes
  changed_when: false

- name: Configure apt
  become: yes
  apt:
    name:
      "*": present
      bind9: absent
      vsftpd: absent
    update: yes
    noinput: true

- name: Update all software (dnf)
  become: yes
  dnf:
    name:
      "*": present
      kernel: absent
      kernel-devel: absent
    state: update

- name: Update all software (pacman)
  become: yes
  pacman:
    state: update

- name: Configure yum
  become: yes
  block:
    - name: Ensure dnf is available for RHEL/CentOS 6
      when: ansible_distribution in ['centos', 'el'] and ansible_distribution_major_version == '6'
      dnf:
        name:
          "*": present
          python3-dnf: present
        state: latest
      register: dnf_installed
    - name: Use yum for other distributions
      when: not (ansible_distribution in ['centos', 'el'] and ansible_distribution_major_version == '6')
      yum:
        name:
          "*": present
          yum-utils: present
        state: latest
  changed_when: false

- name: Update all software (zypper)
  become: yes
  zypper:
    name:
      "*": present
    state: update


