---
- name: Import assertion file
  ansible.builtin.include_tasks:
    file: assert.yml
  args:
    host: localhost
    limit: 1

- name: Install cron package
  ansible.builtin.apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  ansible.builtin.set_fact:
    cron_shell_env: "{{ cron_shell_env }}"

- name: Configure cron path environment
  ansible.builtin.set_fact:
    cron_path_env: "{{ cron_path_env }}"

- name: Configure cron mailto settings
  ansible.builtin.set_fact:
    cron_mailto: "{{ cron_mailto }}"

- name: Start and enable cron service
  ansible.builtin.service:
    name: "{{ cron_service | default('cron') }}"
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    cron_file: "{{ item.cron_file | default('crontab') }}"
    cron: "{{ item.schedule }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"


