---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
  tags:
    - always

- name: Manage automatic service management
  block:
    - name: Copy policy-rc.d for disabled autostart
      ansible.builtin.copy:
        content: "exit 101"
        dest: /usr/sbin/policy-rc.d
        mode: "0755"
      when: apt_autostart_state == 'disabled'
      tags:
        - always
    - name: Remove policy-rc.d for enabled autostart
      ansible.builtin.file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == 'enabled'
      tags:
        - always


