---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
  skip: "{{ connection in ['container', 'docker', 'community.docker.docker'] }}"

- name: Prepare system for bootstrap
  setup:
    module_name: "setup"
    filter: "ansible_distribution,ansible_distribution_version,ansible_os_family"
    changed_when: false
  register: system_facts
  ignore_errors: yes
  rescue:
    - name: Gather facts and install bootstrap packages
      setup:
        module_name: "setup"
        filter: "ansible_distribution,ansible_distribution_version,ansible_os_family"
        changed_when: false
      register: system_facts
      ignore_errors: no

- name: Gather ansible facts
  setup:
    become: false

- name: Install bootstrap packages
  apt:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    become: "{{ bootstrap_become | default('yes') | lower == 'yes' }}"


