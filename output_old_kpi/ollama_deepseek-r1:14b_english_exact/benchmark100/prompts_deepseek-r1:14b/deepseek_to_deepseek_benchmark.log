---
- import_tasks: assert.yml
  loop: "{{ assert_tasks }}"

- name: Install all necessary packages required for Vault installation
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ vault_prerequisites }}"

- name: Include tasks based on installation method
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add environment variables to Vault configuration
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    validate: true
  loop: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Include security hardening tasks
  include_tasks: hardening.yml

- name: Start and enable Vault service (OSS type)
  systemd:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable Vault service (non-OSS type)
  systemd:
    name: vault
    enabled: yes
  when: vault_type != "oss"


