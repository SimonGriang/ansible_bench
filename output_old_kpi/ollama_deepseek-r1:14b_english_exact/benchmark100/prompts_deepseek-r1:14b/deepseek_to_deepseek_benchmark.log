---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  community.general.wait_for_port:
    port: "{{ some_port }}"
    timeout: "{{ bootstrap_timeout }}"
  become: false
  no_log: true

- name: Prepare system
  block:
    - name: Test connection and sudo access
      command: whoami
      changed_when: false
      failed_when: false
      ignore_errors: true
    - name: Gather facts
      ansible.builtin.setup:
        gather_subset: all
        ignore_errors: true
    - name: Install packages
      ansible.builtin.raw:
        cmd: "{{ package_command }}"
      become: true
      when: ansible_distribution == "RedHat"
  rescue:
    - name: Gather facts
      ansible.builtin.setup:
        gather_subset: all
    - name: Install libdnf5
      ansible.builtin.raw:
        cmd: "dnf install libdnf5"
      become: true
  delegate_to: all

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


