---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  tags:
    - assertion
  become: yes
  delegate_to: localhost
  run_once: yes

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts
  become: yes

- name: Flush handlers
  flush_handlers:
    name: ""

- name: Configure selinux
  when: selinux_status is defined and ansible_connection not in ['container', 'docker', 'community.docker.docker']
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
      become: yes

    - name: Manage SELinux booleans
      loop: "{{ selinux_booleans }}"
      become: yes
      name: "{{ item.name }}"
      selinux_bool:
        state: "{{ item.state | default('enforcing') }}"
        persistent: yes
        label: "{{ item.name }}"
      when: selinux_booleans is defined


