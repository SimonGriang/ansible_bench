ased systems\n      ansible.builtin.apt:\n        name: "{{ item }}"\n        state: present\n        purge: false\n      loop:\n        - libapache2-mod-proxy\n        - libapache2-mod-proxy_http\n      when: ansible_os_family == "Debian"\n\n    - name: Enable Apache modules for SUSE-based systems\n      ansible.legacy.suse:\n        name: "{{ item }}"\n        state: installed\n        provide: true\n      loop:\n        - apache2-mod-proxy\n        - apache2-mod-proxy_http\n      when: ansible_os_family == "Suse"\n\n- name: "Configure Apache location configurations using a template file"\n  ansible.builtin.template:\n    src: httpd_locations.j2\n    dest: /etc/apache2/sites-available/locations.conf\n    owner: root\n    group: root\n    mode: 420\n  vars:\n    httpd_locations: "{{ httpd_locations }}"\n\n- name: Restart Apache\n  ansible.builtin.systemd:\n    name: apache2\n    state: restarted\n  become: true\n  become_user: root\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-04T14:00:16.288803491Z', 'done': True, 'done_reason': 'stop', 'total_duration': 22774055436, 'load_duration': 85899845, 'prompt_eval_count': 6864, 'prompt_eval_duration': 5850680885, 'eval_count': 683, 'eval_duration': 16836596004, 'model_name': 'deepseek-r1:14b'} id='run--ca66456b-b391-4aff-b652-9151a7465dc9-0' usage_metadata={'input_tokens': 6864, 'output_tokens': 683, 'total_tokens': 7547}
