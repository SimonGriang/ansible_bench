---
- name: gather_facts | Lookup bootstrap facts
  shell: cat /etc/os-release
  register: os_release_facts

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    distribution: "{{ os_release_facts.stdout_lines | select('startswith', 'NAME=') | map('split', '=', 2) | map('last') | join(' ') }}"
    major_version: "{{ os_release_facts.stdout_lines | select('startswith', 'VERSION_ID=') | map('split', '=', 2) | map('last') | join(' ') }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: "{{ {
      'CentOS Linux': 'RedHat',
      'Fedora': 'RedHat',
      'RedHat Enterprise Linux': 'RedHat',
      'Ubuntu': 'Debian',
      'Debian GNU/Linux': 'Debian',
      'AlmaLinux': 'RedHat',
      'Rocky Linux': 'RedHat'
    }[distribution] | default('Unknown') }}"


