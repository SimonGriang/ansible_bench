---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  host: localhost

- name: Install required packages
  apt:
    name: "{{ service_required_packages }}"
    state: installed
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/="{{ item.name }}.service"
    mode: 0644
  with_items: "{{ service_list }}"

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/="{{ item.name }}"
    mode: 0755
  with_items: "{{ service_list }}"

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  with_items: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


