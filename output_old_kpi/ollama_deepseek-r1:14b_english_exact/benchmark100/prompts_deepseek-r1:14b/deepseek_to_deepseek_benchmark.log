---
- name: Validate all variables are set correctly
  block:
    - import_tasks: assert.yml
  args:
    state: started

- name: Wait for host to be available
  tasks:
    - name: Ensure target host is reachable
      wait_for:
        port: 22
        state: started
        timeout: 30

- name: Prepare system for bootstrap
  tasks:
    - name: Test connection
      ping:

    - name: Gather facts
      setup:

    - name: Install bootstrap packages
      yum:
        name: "{{ packages }}"
        state: present
      become: yes
      when: ansible_os_family == 'RedHat'

    - name: Install bootstrap packages
      apt:
        name: "{{ packages }}"
        state: present
      become: yes
      when: ansible_os_family == 'Debian'

- name: Ensure system preparation with Ansible modules
  tasks:
    - name: Gather facts
      setup:

    - name: Update package lists
      apt:
        update_cache: yes
      become: yes
      when: ansible_os_family == 'Debian'

    - name: Install system packages
      apt:
        name: "{{ packages }}"
        state: present
      become: yes
      when: ansible_os_family == 'Debian'

    - name: Update package lists
      yum:
        update_cache: yes
      become: yes
      when: ansible_os_family == 'RedHat'

    - name: Install system packages
      yum:
        name: "{{ packages }}"
        state: present
      become: yes
      when: ansible_os_family == 'RedHat'

    - name: Ensure user exists
      user:
        name: "{{ user_name }}"
        state: present
        shell: /bin/bash


