---
- name: Install EPEL on compatible systems
  dnf:
    name:
      - epel-release
    state: present
    when: ansible_os_family in ['RedHat', 'Amazon']

- name: Install EPEL GPG key
  rpm_key:
    key: "{{ epel_gpg_key_url }}"
    state: present
    validate_certs: no

- name: Install EPEL-release package
  dnf:
    name:
      - "{{ epel_release_package }}"
    state: present

- name: Install EPEL-next-release package
  dnf:
    name:
      - "{{ epel_next_release_package }}"
    state: present
    when: epel_next | bool

- name: Update package cache
  dnf:
    cacheonly: true


