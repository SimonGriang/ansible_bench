---
- name: Import assert.yml
  import_tasks: assert.yml
  loop: "{{ assert_tasks }}"

- name: Pre-configure debian systems
  debconf_set:
    question: postfix/mailname
    value: "{{ ansible_hostname }}"
    priority: critical
  debconf_set:
    question: postfix/allow_mail_recipient_relay
    value: 'false'
    priority: critical
  debconf_set:
    question: postfix/allow_mail_relay
    value: 'false'
    priority: critical

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
    when: postfix_mysql_available

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport
    group: root
    mode: 0640
  notify: rebuild_postfix_maps

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
    group: root
    mode: 0640
  notify: reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_recipient_access_restriction: "{{ postfix_recipient_access_restriction }}"
    postfix_sender_access_restriction: "{{ postfix_sender_access_restriction }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: "{{ postfix_mynetworks }}"
    postfix_mydestination: "{{ postfix_mydestination }}"
    postfix_relay_domains: "{{ postfix_relay_domains }}"

- name: Configure postfix (main.cf)
  template:
    src: postfix_main.cf.j2
    dest: /etc/postfix/main.cf
    group: root
    mode: 0640
  notify: restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: postfix_master.cf.j2
    dest: /etc/postfix/master.cf
    group: root
    mode: 0640
  notify: restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0700
  loop: "{{ tls_directories }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: /etc/ssl/certs/postfix.pem
    dest: /etc/ssl/certs/postfix.pem
    remote_src: yes
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: /etc/ssl/private/postfix.key
    dest: /etc/ssl/private/postfix.key
    remote_src: yes
  notify: reload_postfix

- name: Flush handlers
  flush_handlers: true

- name: Configure aliases
  template:
    src: postfix_aliases.j2
    dest: /etc/postfix/aliases
    group: root
    mode: 0640
  notify: rebuild_postfix_maps

- name: Configure sender_access
  template:
    src: postfix_sender_access.j2
    dest: /etc/postfix/sender_access
    group: root
    mode: 0640
  notify: rebuild_postfix_maps

- name: Configure recipient_access
  template:
    src: postfix_recipient_access.j2
    dest: /etc/postfix/recipient_access
    group: root
    mode: 0640
  notify: rebuild_postfix_maps

- name: Place sasl_password_map
  template:
    src: postfix_sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    group: root
    mode: 0640
  notify: rebuild_sasl_map

- name: Flush handlers again
  flush_handlers: true

- name: Start and enable postfix
  service:
    name: postfix
