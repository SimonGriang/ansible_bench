- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  apt-get:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: mysql_server.conf.j2
    dest: /etc/mysql/conf.d/mysql_server.cnf
    mode: 0644
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  ini_file:
    path: /etc/mysql/my.cnf
    sections:
      client:
        key: socket
        value: "{{ mysql_client_socket }}"

- name: Initialize mysql
  ansible.builtin.command:
    cmd: mysql_install_db --user=mysql --basedir=/usr
  when: distribution in ['alpine', 'archlinux']

- name: Start and enable mysql
  systemd:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ db_name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases

- name: Create users
  mysql_user:
    name: "{{ user }}"
    password: "{{ password }}"
    priv: "DB '{{ db_name }}'.* TABLE"
  loop: "{{ mysql_users }}"
  when: mysql_users

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true


