---
- name: Install EPEL repository on compatible systems
  when: ansible_distribution in ['amzn2', 'redhat'] and ansible_distribution_major_version in ['7','8','9']
  shell: >
    echo "{{ epel_gpg_key }}" > /etc/yum/epel.key && 
    yum install -y epel-release && 
    test "{{ epel_next | default('no') }}" = "yes" && yum install -y epel-next-release
  notify: update_package_cache

- name: Install EPEL GPG key
  shell: echo "{{ epel_gpg_key }}" > /etc/yum/epel.key

- name: Install EPEL release package
  shell: yum install -y "{{ epel_url }}"

- name: Install EPEL next release package (conditional)
  shell: yum install -y "{{ epel_next_url }}"
  when: epel_next | default(False)

handlers:
  - name: Update package cache
    meta: update_cache


