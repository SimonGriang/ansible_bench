- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    ignore_errors: true
  run_once: true
  localhost: true

- name: Install using package
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items:
    - hashicorp
  when: ansible_os_family in ["Debian", "RedHat", "Other"]

- name: Configure debian
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  with_items:
    - hashicorp.list.deb
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items:
    - hashicorp
  when: ansible_os_family in ["Debian", "RedHat", "Other"]

- name: Install manually
  ansible.builtin.unarchive:
    remote_src: yes
    src: "{{ hashicorp_product_url }}"
    dest: "{{ hashicorp_product_dest }}"
    mode: '0755'
  when: hashicorp_install_method == 'manual'


