---
- name: Import assertion tasks
  import_tasks: assert.yml
  host: localhost

- name: Install required software packages
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements | default([]) | list }}"
  when: users_requirements | list

- name: Manage user groups
  include_tasks: group.yml
  loop: "{{ users_groups | default([]) | list }}"

- name: Configure sudoers directory inclusion
  lineinfile:
    path: /etc/sudoers
    line: "# {{ inventory_hostname }} - /etc/sudoers.d "
    mode: '0644'
    create: yes
  notify: visudo
  become: yes

