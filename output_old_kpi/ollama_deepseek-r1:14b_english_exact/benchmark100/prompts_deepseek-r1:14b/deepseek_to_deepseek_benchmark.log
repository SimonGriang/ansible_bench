d be made.\n\nNow, putting it all together, I\'ll outline each task with the correct modules and arguments, making sure to include all necessary parameters and that the facts are set correctly.\n\nFinally, I\'ll format the YAML correctly, ensuring that each task is a dictionary under the tasks key, and that the entire playbook starts with --- as specified.\n</think>\n\n```yaml\n---\n- name: lookup bootstrap facts (raw)\n  command: cat /etc/os-release\n  register: bootstrap_facts\n  changed_when: false\n  set_fact:\n    ansible_user: "{{ bootstrap_user }}"\n\n- name: set bootstrap facts (I)\n  shell: |\n    echo "{{ bootstrap_facts.stdout | regex_replace(\'\\n\', \'\') }}” | grep VERSION_ID= | cut -d\'=\' -f2 | cut -d\'.\' -f1\n    echo "{{ bootstrap_facts.stdout | regex_replace(\'\\n\', \'\') }}” | grep PRETTY_NAME= | cut -d\'=\' -f2\n  register: dist_info\n  changed_when: false\n  become: yes\n  set_fact:\n    bootstrap_distribution: "{{ dist_info.stdout.split(\' \', 2)[0] | lower }}”\n    bootstrap_distribution_major_version: "{{ dist_info.stdout.split(\' \', 2)[1] | lower }}”\n\n- name: set bootstrap facts (II)\n  loop: "{{ bootstrap__os_family_map }}"\n  set_fact:\n    bootstrap_os_family: "{{ item.value }}"\n  loop_control:\n    label: "{{ item.key }}"\n  become: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-04T13:10:13.517413733Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14955550261, 'load_duration': 90111795, 'prompt_eval_count': 437, 'prompt_eval_duration': 135305475, 'eval_count': 723, 'eval_duration': 14729609899, 'model_name': 'deepseek-r1:14b'} id='run--c403f16e-a6a9-4620-a09f-8923a5189e72-0' usage_metadata={'input_tokens': 437, 'output_tokens': 723, 'total_tokens': 1160}
