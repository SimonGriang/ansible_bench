- task 1: install unzip package
  name: Install unzip package
  apt:
    name: unzip
    state: present

- task 2: create system group for promtail
  name: Create promtail system group
  group:
    name: promtail
    state: present
    system: yes
    gid: 1000
  become: yes
  become_user: root

- task 3: create system user for promtail
  name: Create promtail system user
  user:
    name: promtail
    state: present
    system: yes
    groups: promtail
    create_home: no
    shell: /sbin/nologin
  become: yes
  become_user: root

- task 4: ensure /usr/local/bin directory exists
  name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  become: yes
  become_user: root

- task 5: create config directories
  name: Create config directories
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- task 6: create application directories
  name: Create application directories
  file:
    path: "{{ promtail_app_dir }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- task 7: check promtail binary existence
  name: Check promtail binary existence
  stat:
    path: "{{ promtail_binary_path }}"
  register: binary_exists

- task 8: download promtail binaries
  name: Download promtail binaries
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: "{{ promtail_binaries_tmp }}"
    checksum: "{{ promtail_distribution_checksum }}"
  when: not binary_exists.stat.exists

- task 9: propagate local promtail binaries
  name: Propagate local promtail binaries
  copy:
    src: "{{ promtail_binaries_local }}"
    dest: "{{ promtail_binaries_tmp }}"
    remote_src: yes
  when: promtail_binaries_local is defined

- task 10: download promtail binaries for controller node
  name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_distribution_controller_url }}"
    dest: "{{ promtail_binaries_tmp_controller }}"
    checksum: "{{ promtail_distribution_controller_checksum }}"
  when: controller_node

- task 11: propagate promtail binaries
  name: Propagate promtail binaries
  copy:
    src: "{{ promtail_binaries_tmp }}"
    dest: "{{ promtail_binaries_dist }}"
    remote_src: yes

- task 12: unpack promtail binaries
  name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_binaries_tmp }}/*"
    dest: "{{ promtail_binaries_dir }}"
    remote_src: yes
   业主: promtail
    group: promtail
    mode: '0755'

- task 13: create symlink to latest promtail version
  name: Create symlink to latest promtail version
  file:
    path: "{{ promtail_binary_path }}"
    state: link
    target: "{{ promtail_binary_dir }}/latest"
  notify: promtail restart

- task 14: write promtail config file
  name: Write promtail config file
  template:
    src: promtail-config.j2
    dest: "{{ promtail_config_dir }}/promtail.yml"
    owner: promtail
    group: promtail
    mode: '0644'

- task 15: create systemd service unit
  name: Create systemd service unit
  template:
    src: promtail systemd.j2
    dest: "/etc/systemd/system/promtail.service"
    owner: root
    group: root
    mode: '0644'
  notify: promtail restart


