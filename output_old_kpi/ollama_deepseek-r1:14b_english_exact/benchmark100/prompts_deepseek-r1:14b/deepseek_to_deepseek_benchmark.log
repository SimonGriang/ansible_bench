---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  tags: []

- name: Install mysql
  ansible.builtin.yum:
    name: "{{ packages }}"
    state: present
  notify:
    - mysql_root_password_handler
    - mysql_systemctl_daemon_reexecuted
  tags: []

- name: Configure mysql server
  ansible.builtin.template:
    dest: /etc/mysql/my.cnf
    mode: 0644
  notify:
    - mysql_server_restarted
  tags: []

- name: Configure mysql client
  ansible.builtin.template:
    dest: /etc/mysql/my.cnf
    mode: 0644
  tags: []

- name: Initialize mysql
  ansible.builtin.command:
    cmd: /usr/bin/mysql_install_db --user=mysql
  tags: []

- name: Start and enable mysql
  ansible.builtin.systemctl:
    name: "{{ service_name }}"
    state: started
    enabled: yes
  tags: []

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true
  tags: []

- name: Place my.cnf
  ansible.builtin.file:
    path: /etc/mysql/my.cnf
    state: file
    mode: 0644
  tags: []

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
    skip_if_initial_import: "{{ initial_import | default('') | bool }}"
  loop: "{{ databases }}"
  tags: []

- name: List databases
  ansible.builtin.mysql_db:
    name: "*"
    state: list
  tags: []

- name: Import database
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: import
    import: "{{ initial_import | default('') | string }}"
    skip_if_initial_import: "{{ initial_import | default('') | bool }}"
  loop: "{{ databases }}"
  tags: []

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ user.name }}"
    host: "{{ user.host }}"
    priv: "{{ user.privileges }}"
    state: present
  loop: "{{ users }}"
  notify:
    - mysql_server_restarted
  tags: []

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true
  tags: []


