---
- name: Copy Vault certificate
  copy:
    remote_src: no
    src: /path/to/VAULT_CRT
    dest: /etc/vault.d/vault.crt
    remote_user: vault

- name: Install Vault package
  apt:
    name: vault
    state: present
    update_cache: yes

- name: Configure Vault server settings
  template:
    src: vault.conf.j2
    dest: /etc/vault.d/vault.conf
    dir_mode: 755
    mode: 644

- name: Start Vault service
  service:
    name: vault
    state: started
    enabled: yes

- name: Wait for Vault to be ready
  wait_for_port:
    host: 127.0.0.1
    port: 8200
    timeout: 60

- name: Get Vault initial root token
  command: vault operator init -init-root-token
  register: vault_root_token
  changed_when: false


