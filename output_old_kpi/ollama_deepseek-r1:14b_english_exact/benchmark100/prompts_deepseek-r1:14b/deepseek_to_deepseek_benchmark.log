---
- name: Assert usage of systemd as an init system
  shell: systemctl --version
  changed_when: false
  register: systemd_check

  assert:
    that:
      - systemd_check.rc == 0
    msg: "System does not use systemd as init system"

- name: Get latest release and set promtail version
  github_info:
    repo: "Grafana/loki"
    owner: "Grafana"
    version: latest
  register: latest_release

  set_fact:
    promtail_version: "{{ latest_release.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: "{{ local_binary_archive | default('') }}"
  register: binary_check

  assert:
    that:
      - binary_check.stat.exists
    msg: "Local binary archive does not exist"

- name: Get checksum list and set checksum for target architecture
  uri:
    url: "https://raw.githubusercontent.com/Grafana/loki/{{ promtail_version }}/buildinfo/checksums.txt"
  register: checksum_info

  set_fact:
    checksum_{{ target_arch }}: "{{ checksum_info.content | regex_replace('^---\\n') | split('\\n') | selectattr('contains', search=' sha256') | map('split') | map('last') | list }}"


