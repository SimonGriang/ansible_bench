---
- name: Import assertion file
  include_tasks: assert.yml

- name: Install system requirements
  apt:
    name: bash
    state: present

- name: Install OpenJDK Java
  apt:
    name: openjdk
    state: present
  when:
    - java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  become: true
  become_user: root
  copy:
    src: oracle-jdk.rpm
    dest: /tmp/
  dnf:
    name: /tmp/oracle-jdk.rpm
    state: present
  when:
    - java_source == "local"
    - java_format == "rpm"

- name: Install Oracle Java DEB from local
  become: true
  become_user: root
  copy:
    src: oracle-jdk.deb
    dest: /tmp/
  apt:
    name: /tmp/oracle-jdk.deb
    state: present
  when:
    - java_source == "local"
    - java_format == "deb"

- name: Install Oracle Java RPM from repository
  dnf:
    name: oracle-jdk
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"

- name: Configure Oracle Java targz installation
  become: true
  become_user: root
  unarchive:
    src: oracle-jdk.tgz
    dest: /opt/jdk
    remote_src: yes
  dnf:
    name: /opt/jdk/oracle-jdk.rpm
    state: present
  when:
    - java_format == "targz"
    - java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  apt:
    name: oracle-jce
    state: present
  when:
    - java_jce
    - java_version == 8
    - java_vendor == "oracle"

- name: Set Java alternative
  alternatives:
    name: java
    path: /usr/bin/java
    state: present
  when:
    - java_format == "targz"
    - distribution != "Alpine"

- name: Find Java home directory
  set_fact:
    java_home: "{{ansible_facts.command.java | community.general.json_query}}"
  when: ansible_facts.command.java is defined

- name: Set JAVA_HOME in environment
  become: true
  become_user: root
  copy:
    content: |
      JAVA_HOME={{ java_home }}
    dest: /etc/profile.d/java_home.sh
    mode: 0755


