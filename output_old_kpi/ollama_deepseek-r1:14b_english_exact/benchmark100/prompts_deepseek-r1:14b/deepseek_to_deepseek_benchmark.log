---
- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
    check_path: yes
  register: certificates_exists
  with_items: "{{ java_certs | map(attribute='path') | list }}"
  changed_when: false
  ignore_errors: yes

- name: Fail if Java certificates are missing
  ansible.builtin.fail:
    msg: "Missing Java certificate at {{ item.path }}"
  when: certificates_exists.results | selectattr('ansible_facts.stat.exists', 'bool') | list | not
  with_items: "{{ java_certs }}"

- name: Set keystore directory for Java versions less than 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/jre/lib/security"
  when: java_version | version_compare('<', '11')

- name: Set keystore directory for Java versions 11 or newer
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security"
  when: java_version | version_compare('>=', '11')

- name: Import SSL certificates into Java keystore
  shell: keytool -import -alias {{ item.alias }} -file {{ item.path }} -keystore {{ java_keystore_dir }}/{{ keystore_name }} -storepass {{ keystore_password }}
  args:
    chdir: /path/to/keystore
  with_items: "{{ java_certs }}"
  register: imported_certs
  changed_when: false


