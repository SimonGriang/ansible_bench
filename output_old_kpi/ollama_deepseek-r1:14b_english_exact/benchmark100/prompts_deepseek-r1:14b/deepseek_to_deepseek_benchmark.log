- name: Create the RKE2 manifests directory
  file:
    path: "{{ rke2_data_dir }}/manifests"
    state: directory
    mode: 0755
    owner: rke2user
    group: rke2group

- name: Copy kube-vip files to first server
  copy:
    remote_src: yes
    src: "{{ kubevip_path }}/templates"
    dest: "{{ rke2_data_dir }}/manifests"
    file_mode: 0644
    owner: rke2user
    group: rke2group

- name: Copy kube-vip load balancer manifests to first server
  copy:
    remote_src: yes
    src: "{{ kubevip_path }}/templates/lb"
    dest: "{{ rke2_data_dir }}/manifests"
    file_mode: 0644
    owner: rke2user
