    ini: true

- name: Install cron packages
  apt:
    name: "{{ cron_packages }}"
    state: present
    update_cache: yes

- name: Configure cron shell
  ansible.posix.cron:
    name: SHELL
    value: /bin/bash
    state: present
    cron_file: /etc/crontab
    notify: restart cron

- name: Configure cron path
  ansible.posix.cron:
    name: PATH
    value: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present
    cron_file: /etc/crontab
    notify: restart cron

- name: Configure cron mailto
  ansible.posix.cron:
    name: MAILTO
    value: "{{ cron_mailto }}"
    state: present
    cron_file: /etc/crontab
