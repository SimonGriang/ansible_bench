---
- name: Install unzip package
  ansible.builtin.apt:
    name: unzip
    state: present

- name: Create system group for promtail
  ansible.builtin.group:
    name: promtail
    state: present
    system: true

- name: Create system user for promtail
  ansible.builtin.user:
    name: promtail
    group: promtail
    createhome: true
    state: present
    groups: ['sudo']

- name: Ensure /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '755'

- name: Create config directories
  ansible.builtin.file:
    path: /etc/promtail
    state: directory
    mode: '755'
    owner: promtail
    group: promtail

- name: Create application directories
  ansible.builtin.file:
    path: /var/lib/promtail
    state: directory
    mode: '755'
    owner: promtail
    group: promtail

- name: Check promtail binary existence
  ansible.builtin.stat:
    path: /usr/local/bin/promtail
    state: present

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.zip
    checksum: "{{ promtail_checksum }}"

- name: Propagate local promtail binaries
  ansible.builtin.copy:
    src: /path/to/local/promtail.zip
    dest: /tmp/promtail.zip

- name: Download promtail binaries for controller node
  ansible.builtin.get_url:
    url: "{{ promtail_controller_url }}"
    dest: /tmp/controller-promtail.zip
    checksum: "{{ controller_promtail_checksum }}"

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: /path/to/controller/promtail.zip
    dest: /tmp/controller-promtail.zip

- name: Unpack promtail binaries
  ansible.builtin.unzip:
    src: /tmp/promtail.zip
    dest: /usr/local/bin

- name: Create symlink to latest promtail version
  ansible.builtin.file:
    state: link
    src: /usr/local/bin/promtail
    dest: /usr/local/bin/promtail-latest
    owner: promtail
    group: promtail
    notify: restart_promtail

- name: Write promtail config file
  ansible.builtin.template:
    src: promtail-config.j2
    dest: /etc/promtail/config.yml
    owner: promtail
    group: promtail

- name: Create systemd service unit
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '644'
    notify: restart_systemd


