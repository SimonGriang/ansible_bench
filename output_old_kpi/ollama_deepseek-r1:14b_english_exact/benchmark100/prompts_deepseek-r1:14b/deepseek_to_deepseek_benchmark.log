---
- name: Import assertion tasks
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
    state: present
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: latest
  when:
    - ansible_distribution != "bookworm"
    - ansible_distribution != "noble"
    - not ansible_os_family == "Alpine"

- name: Install Python modules
  ansible.builtin.pip:
    name: "{{ item.0 }}"
    version: "{{ item.1 | default('latest') }}"
    state: present
  loop: "{{ (python_pip_modules | dict_output) | items }}"
  when:
    - ansible_distribution != "bookworm"
    - ansible_distribution != "noble"
    - not ansible_os_family == "Alpine"


