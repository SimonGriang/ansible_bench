- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories | default([]) }}"
  loop_control:
    loop_var: directory

- name: Configure directories
  ansible.builtin.template:
    src: directory.conf.j2
    dest: /etc/httpd/conf.d/{{ directory }}.conf
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd
  loop: "{{ httpd_directories | default([]) }}"
  loop_control:
    loop_var: directory


