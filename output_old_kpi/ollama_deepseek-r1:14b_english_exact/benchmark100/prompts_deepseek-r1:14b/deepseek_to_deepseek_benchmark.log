---
- name: Import assertion tasks
  ansible.builtin.include_tasks:
    file: assert.yml
    vars:
      ansible_run_once: true
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  ansible.builtin.package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install Docker Compose binary
  block:
    - name: Install required packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      with_items:
        - docker.io
        - git

    - name: Download Docker Compose binary
      ansible.builtin.get_url:
        url: https://github.com/docker/compose/releases/download/v
          {{ docker_compose_version }}/docker-compose-{{ ansible_system }}
          -{{ ansible_architecture }}
        dest: /usr/local/bin/docker-compose
        mode: 0o755

    - name: Ensure binary mode is correct
      ansible.builtin.file:
        path: /usr/local/bin/docker-compose
        state: file
        mode: 0o755
  when: installation_type == "binary"


