restored\n\n- name: Restore etcd from S3\n  ansible.command:\n    cmd: |\n      mkdir -p /var/lib/rke2/etcd\n      curl -o /var/lib/rke2/etcd/etcd-snapshot.bin https://s3.{{ rke2_etcd_s3_bucket }}.s3.amazonaws.com/{{ rke2_etcd_s3_prefix }}/etcd-snapshot.bin\n      rke2-etcd restore from-file=/var/lib/rke2/etcd/etcd-snapshot.bin\n  when: rke2_etcd_restore_from_s3\n  notify: rke2_etcd_restored\n\n- name: Start RKE2 service\n  ansible.systemd:\n    name: rke2.service\n    state: started\n    enabled: yes\n    environment: "RKE2_TOKEN={{ rke2_token }}"\n  notify: rke2_service_started\n\n- name: Mask RKE2 agent service\n  ansible.systemd:\n    name: rke2-agent.service\n    state: masked\n\n- name: Wait for first server to be ready (no CNI)\n  wait_for_task:\n    path: /usr/bin/rke2-cni\n    state: absent\n    retries: 30\n    delay: 10\n\n- name: Wait for first server to be ready (with CNI)\n  wait_for_task:\n    path: /usr/bin/rke2-cni\n    state: present\n    retries: 30\n    delay: 10\n\n- name: Restore etcd\n  ansible.command:\n    cmd: |\n      systemctl stop rke2.service\n      rke2-etcd delete-node --name=$(hostname)\n      rke2-etcd restore {{ (rke2_etcd_restore_from_file | boolean) | ternary(\'from-file=/var/lib/rke2/etcd/etcd-snapshot.bin\',\'from-s3\') }}\n  when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3\n  notify: rke2_etcd_restored\n\n- name: Set Active Server variable\n  ansible.set_fact:\n    rke2_active_server: "{{ inventory_hostname }}"\n  delegate_to: all\n  run_once: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-04T14:52:33.621889173Z', 'done': True, 'done_reason': 'stop', 'total_duration': 28527564141, 'load_duration': 92621497, 'prompt_eval_count': 2151, 'prompt_eval_duration': 9710379, 'eval_count': 1565, 'eval_duration': 28424403008, 'model_name': 'deepseek-r1:14b'} id='run--6723eb0c-91bf-4e93-aa68-c5e5b57768be-0' usage_metadata={'input_tokens': 2151, 'output_tokens': 1565, 'total_tokens': 3716}
