---
- name: gather_facts | Lookup bootstrap facts
  shell: |
    cat /etc/os-release
  register: os_release
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    distribution: |
      "{{ os_release.stdout | regex_replace('ID=.*\"(.*)\".*', '\\1') }}"
    major_version: |
      "{{ os_release.stdout | regex_replace('VERSION_ID=\".*?(\\d+).*', '\\1') }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: |
      "((('RedHat' if distribution == 'centos' or distribution == 'rhel' else 'Debian') if distribution else 'unknown'))"


