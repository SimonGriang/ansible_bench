ce_restart\n\n- name: Activate httpd module | Debian\n  when: ansible_os_family == \'Debian\'\n  command: a2enmod\n  args:\n    modules: "{{ item }}"\n  with_items: "{{ httpd_modules_to_activate_with_command }}"\n\n- name: Import ssl.yml\n  import_tasks: ssl.yml\n  when: https_ssl_enable\n\n- name: Import locations.yml\n  import_tasks: locations.yml\n  when: httpd_locations is defined\n\n- name: Import vhosts.yml\n  import_tasks: vhosts.yml\n  when: httpd_vhosts is defined\n\n- name: Configure ports\n  when: ansible_os_family in [\'Debian\', \'Suse\']\n  template:\n    src: "{{ httpd_ports_config_src }}"\n    dest: "{{ httpd_ports_config_dest }}"\n    mode: 0644\n  notify: \n    - httpd_config_test\n    - httpd_service_restart\n\n- name: Import directories.yml\n  import_tasks: directories.yml\n  when: httpd_directories is defined\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  when: httpd_remove_example\n  file:\n    path: "{{ httpd_data_directory }}/example.html"\n    state: absent\n\n- name: Start and enable httpd\n  when: ansiblevérsion("2.10.0") and httpd_service | bool\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-04T14:06:36.564001134Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16261282832, 'load_duration': 90604002, 'prompt_eval_count': 1220, 'prompt_eval_duration': 57837822, 'eval_count': 810, 'eval_duration': 16112079324, 'model_name': 'deepseek-r1:14b'} id='run--b194c423-01dd-4a01-9958-ebb28b1ad61f-0' usage_metadata={'input_tokens': 1220, 'output_tokens': 810, 'total_tokens': 2030} 46%|████▌     | 46/100 [1:45:25<2:09:07, 143.48s/it]
