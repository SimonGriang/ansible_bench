---
- name: Remove external apt configurations
  shell: |
    rm -rf /etc/apt/sources.list.d/*
    rm -rf /etc/apt/preferences.d/*
    apt update
  changed_when: false

- name: Install pip
  apt:
    name: python3-pip
    state: present

- name: Install python3-packaging
  apt:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    virtualenv: "{{ item.virtualenv | default('none') }}"
    extra_args: "{{ item.extra_args | default('') }}"
  loop: "{{ pip_install_packages | default([]) }}"



