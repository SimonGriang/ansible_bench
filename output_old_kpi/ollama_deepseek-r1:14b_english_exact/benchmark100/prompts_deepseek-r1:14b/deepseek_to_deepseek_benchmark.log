    args: ['--nopass', 'server']
    environment: { EASYRSA_BATCH: 'yes' }
    cwd: /etc/openvpn/easy-rsa

- name: Generate client certificate
  ansible.builtin.command:
    cmd: /usr/sbin/easyrsa build-client-full
    args: ['--nopass', 'client']
    environment: { EASYRSA_BATCH: 'yes' }
    cwd: /etc/openvpn/easy-rsa

- name: Generate Certificate Revocation List
  ansible.builtin.command:
    cmd: /usr/sbin/easyrsa gen-crl
    cwd: /etc/openvpn/easy-rsa

- name: Generate OpenVPN TA key
  ansible.builtin.command:
    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
    cwd: /etc/openvpn/easy-rsa

- name: Copy PKI files to /etc/openvpn/server directory
  ansible.builtin.copy:
    remote_src: true
    dest: /etc/openvpn/server
    mode: '640'
    files:
      - src: /etc/openvpn/easy-rsa/pki/ca.crt
      - src: /etc/openvpn/easy-rsa/pki/ta.key
      - src: /etc/openvpn/easy-rsa/pki/dh.pem
      - src: /etc/openvpn/easy-rsa/pki/private/ca.key

- name: Copy additional PKI files to /etc/openvpn directory
  ansible.builtin.copy:
    remote_src: true
    dest: /etc/openvpn
    mode: '640'
    files:
      - src: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Place OpenVPN server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '640'
    owner: openvpn
    group: openvpn
  notify: restart_openvpn


