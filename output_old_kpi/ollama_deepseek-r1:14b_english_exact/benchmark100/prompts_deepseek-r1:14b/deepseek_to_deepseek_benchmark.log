---
- name: Import assertion file
  remote_host: localhost
  block:
    - name: Import assertion file
      ansible.builtin.assert:
        file: assert.yml

- name: Enable Redis module stream for RHEL 8
  ansible.builtin.dnf:
    name: ".redis-module-redislabs"
    state: present

- name: Install Redis package
  ansible.builtin.package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  ansible.builtin.template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart_redis

- name: Start and enable Redis service
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


