    path: /etc/ssl/private/myPrivateKey.pem
  register: private_key_content

- name: Read the certificate content
  ansible.builtin.read_file:
    path: /etc/ssl/certs/myCertificate.pem
  register: certificate_content

- name: Combine private key and certificate into a single file
  ansible.builtin.template:
    src: combined.pem.j2
    dest: /etc/ssl/combined/combined.pem
    mode: "0644"


