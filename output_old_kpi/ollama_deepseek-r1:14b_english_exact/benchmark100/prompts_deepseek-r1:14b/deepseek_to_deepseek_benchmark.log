---
- name: Create the OpenVPN client configuration directory
  ansible.builtin.file:
    state: directory
    path: /etc/openvpn/client
    owner: root
    group: openvpn_group
    mode: 493  # 0750 in decimal

- name: Place the OpenVPN client configuration file
  ansible.builtin.template:
    src: client.conf.j2
    dest: /etc/openvpn/client.conf
    owner: root
    group: openvpn_group
    mode: 384  # 0640 in decimal
  notify: Restart openvpn


