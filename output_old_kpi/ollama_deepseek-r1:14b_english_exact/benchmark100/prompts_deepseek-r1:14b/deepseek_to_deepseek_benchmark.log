  tags: [variables]

- name: Include OS family specific tasks
  import_tasks: tasks/{redhat,debian}/setup.yml
  when: ansible_os_family in ['RedHat', 'Debian']
  tags: [os-setup]

- name: Install Docker packages
  apt:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    tags: [docker]
  become: yes
  when:
    - ansible_version < "2.12"
    - ansible_os_family not in ['RedHat', 'Debian']
  notify: restart docker
  ignore_errors: true

- name: Install Docker packages with downgrade option
  apt:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    tags: [docker]
    version: ">{{ docker_downgrade_version }}"
  become: yes
  when:
    - ansible_version >= "2.12"
    - ansible_os_family in ['RedHat', 'Debian']
  notify: restart docker
  ignore_errors: true

- name: Install docker-compose plugin
  apt:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    tags: [docker-compose]
  become: yes
  when:
    - docker_install_compose_plugin
    - ansible_version < "2.12"
    - ansible_os_family not in ['RedHat', 'Debian']
  notify: restart docker
  ignore_errors: true

- name: Install docker-compose-plugin with downgrade option
  apt:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    tags: [docker-compose]
    version: ">{{ docker_downgrade_version }}"
  become: yes
  when:
    - docker_install_compose_plugin
    - ansible_version >= "2.12"
    - ansible_os_family in ['RedHat', 'Debian']
  notify: restart docker
  ignore_errors: true

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options | any
  tags: [docker-config]

- name: Configure Docker daemon options
  copy:
    remote_src: yes
    content: "{{ docker_daemon_options | json_dumps }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  when: docker_daemon_options | any
  notify: restart docker
  tags: [docker-config]

- name: Ensure Docker service is started and enabled
  service:
    name: "{{ docker_service_name }}"
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: docker_service_manage
  ignore_errors: true
  tags: [docker-service]

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers
  tags: [handlers]

- name: Include docker-compose.yml tasks
  import_tasks: tasks/docker-compose.yml
  when: docker_install_compose
  tags: [docker-compose]

- name: Get docker group information
  shell: getent group docker
  ignore_errors: true
  tags: [docker-users]

- name: Set fact for user modification
  set_fact:
    users_need_modification: "{{ users_need_modification | default(false) }}"
  when:
    - users_to_add | any
    - users_in_docker | selectattr('gid', '!=', docker_gid) | any
  tags: [docker-users]

- name: Include docker-users.yml tasks
  import_tasks: tasks/docker-users.yml
  when: users_need_modification
  tags: [docker-users]


