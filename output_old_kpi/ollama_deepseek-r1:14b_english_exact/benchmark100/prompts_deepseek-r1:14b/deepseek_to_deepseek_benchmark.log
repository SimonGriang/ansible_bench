ded corrected playbook, \'state: latest\' was removed, so I\'ll make sure that\'s done.\n\nPutting it all together, I\'ll adjust each task\'s action to use the correct FQCN, reorganize the keys where necessary, and ensure no \'latest\' is used in package states. This should fix all the linting issues while keeping the original functionality intact.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  ansible.builtin.import_tasks:\n    file: assert.yml\n  delegate_to: localhost\n\n- name: Configure apk\n  become: true\n  community.general.apk:\n    state: update\n    upgrade: true\n  changed_when: false\n\n- name: Configure apt\n  become: true\n  ansible.builtin.apt:\n    name:\n      "*": present\n      bind9: absent\n      vsftpd: absent\n    update: true\n    noinput: true\n\n- name: Update all software (dnf)\n  become: true\n  ansible.builtin.dnf:\n    name:\n      "*": present\n      kernel: absent\n      kernel-devel: absent\n    state: update\n\n- name: Update all software (pacman)\n  become: true\n  community.general.pacman:\n    state: update\n\n- name: Configure yum\n  become: true\n  block:\n    - name: Ensure dnf is available for RHEL/CentOS 6\n      when: ansible_distribution in [\'centos\', \'el\'] and\n            ansible_distribution_major_version == \'6\'\n      ansible.builtin.dnf:\n        name:\n          "*": present\n          python3-dnf: present\n      register: dnf_installed\n    - name: Use yum for other distributions\n      when: not (ansible_distribution in [\'centos\', \'el\'] and\n            ansible_distribution_major_version == \'6\')\n      ansible.builtin.yum:\n        name:\n          "*": present\n          yum-utils: present\n  changed_when: false\n\n- name: Update all software (zypper)\n  become: true\n  community.general.zypper:\n    name:\n      "*": present\n    state: update\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-04T13:13:24.837609694Z', 'done': True, 'done_reason':