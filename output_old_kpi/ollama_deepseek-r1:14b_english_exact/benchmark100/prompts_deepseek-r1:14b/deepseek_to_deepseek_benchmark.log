---
- name: Update apt cache
  apt:
    state: updated

- name: Update dnf cache
  dnf:
    state: update

- name: Install packages
  apt:
    name: keepalived
    state: present
  when:
    - ansible_distribution_family == "debian"

- name: Install packages
  dnf:
    name: keepalived
    state: present
  when:
    - ansible_distribution_family == "redhat"

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: 755

- name: Create Kubernetes API health check script for Debian OS family
  copy:
    content: |
      #!/bin/bash
      # Health check script for Kubernetes API
      echo "Checking Kubernetes API health"
    remote_src: yes
    dest: /usr/local/bin/k8s-api-check.sh
    mode: 755
  when:
    - ansible_distribution_family == "debian"

- name: Create Kubernetes API health check script for RedHat OS famliy
  copy:
    content: |
      #!/bin/bash
      # Health check script for Kubernetes API
      echo "Checking Kubernetes API health"
    remote_src: yes
    dest: /usr/local/bin/k8s-api-check.sh
    mode: 755
  when:
    - ansible_distribution_family == "redhat"

- name: Create RKE2 Server health check script for Debian OS family
  copy:
    content: |
      #!/bin/bash
      # Health check script for RKE2 server
      echo "Checking RKE2 server health"
    remote_src: yes
    dest: /usr/local/bin/rke2-server-check.sh
    mode: 755
  when:
    - ansible_distribution_family == "debian"

- name: Create RKE2 Server health check script for RedHat OS family
  copy:
    content: |
      #!/bin/bash
      # Health check script for RKE2 server
      echo "Checking RKE2 server health"
    remote_src: yes
    dest: /usr/local/bin/rke2-server-check.sh
    mode: 755
  when:
    - ansible_distribution_family == "redhat"

- name: Create keepalived config file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    mode: 644

- name: Enable keepalived and make sure it is not masked
  systemctl:
    name: keepalived
    state: started
    enabled: yes
    masked: no

- name: Flush handlers
  meta: flush_handlers


