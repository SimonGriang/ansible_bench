  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts if httpd_vhosts is defined else [] }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - create_docroot | default(true)

- name: Configure virtual host settings
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts }}"

- name: Enable virtual hosts on Debian systems
  a2ensite:
    site: "{{ item.name }}"
    state: present
    create_symlink: yes
    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == "Debian"
  notify:
    - Test httpd configuration validity
    - Restart httpd


