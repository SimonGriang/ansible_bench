- name: Import assertion file
  ansible.posix.file:
    path: /etc/ansible/assertions
    state: directory
    ini: true

- name: Install cron packages
  apt:
    name: "{{ cron_packages }}"
    state: present
    update_cache: yes

- name: Configure cron shell
  ansible.posix.cron:
    name: SHELL
    value: /bin/bash
    state: present
    cron_file: /etc/crontab
    notify: restart cron

- name: Configure cron path
  ansible.posix.cron:
    name: PATH
    value: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present
    cron_file: /etc/crontab
    notify: restart cron

- name: Configure cron mailto
  ansible.posix.cron:
    name: MAILTO
    value: "{{ cron_mailto }}"
    state: present
    cron_file: /etc/crontab
    notify: restart cron

- name: Start and enable cron service
  ansible systemd:
    name: cron
    state: started
    enabled: true
  when: cron_service | bool

- name: Schedule cron jobs
  ansible.posix.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    command: "{{ item.command }}"
    state: present
    cron_file: /etc/crontab
    notify: restart cron
  with_items: "{{ cron_jobs | default([]) }}"


