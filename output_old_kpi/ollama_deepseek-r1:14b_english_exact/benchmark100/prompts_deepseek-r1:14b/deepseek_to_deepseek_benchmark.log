---
- name: Include tasks for installing Keepalived when HA mode is enabled
  ansible.builtin.include_tasks: tasks/keepalived.yml
  when: ha_mode_enabled and (specific_conditions_are_met)

- name: Download and install RKE2 with specified version
  rke2Installer:
    version: "{{ rke2_version }}"
    install_url: "{{ rke2_download_url }}"
    state: present

- name: Perform CIS hardening when a CIS profile is defined
  ansible.builtin.include_tasks: tasks/cis-hardening.yml
  when: cis_profile_defined

- name: Find and identify the active server in the cluster
  ansible.builtin.command:
    cmd: find_active_server.sh
    args:
      chdir: /path/to/scripts

- name: Enable the IPVS kernel module for load balancing
  ansible.posix.kmod:
    name: ip_vs
    state: loaded
  when: specific_ha_conditions_are_met

- name: Copy kube-vip manifests to the master node
  ansible.builtin.copy:
    remote_src: true
    src: /path/to/kube-vip/manifests/
    dest: /etc/kubernetes/manifests/
    directory_mode: 755
    file_mode: 644
  when: specific_ha_conditions_are_met

- name: Copy ingress-nginx manifests to the master node
  ansible.builtin.copy:
    remote_src: true
    src: /path/to/ingress-nginx/manifests/
    dest: /etc/kubernetes/manifests/
    directory_mode: 755
    file_mode: 644
  when: ingress_nginx_values_defined

- name: Prepare the first server node in the cluster
  ansible.builtin.include_tasks: tasks/prepare-first-node.yml
  when: specific_conditions_are_met

- name: Perform etcd restore tasks when specific conditions are met
  ansible.builtin.include_tasks: tasks/etcd-restore.yml
  when: etcd_restore_needed

- name: Download the kubeconfig file to the Ansible localhost
  ansible.builtin.fetch:
    src: /path/to/kubeconfig
    dest: /path/to/download/directory/
    flat: true
  when: download_kubeconfig_enabled

- name: Prepare and join remaining cluster nodes
  ansible.builtin.include_tasks: tasks/join-nodes.yml
  when: active_server_defined

- name: Perform rolling restart of server nodes
  ansible.posix.systemd:
    name: kubelet
    state: restarted
    delay: 10s
  when: version_changed

- name: Perform rolling restart of agent nodes
  ansible.posix.systemd:
    name: kube-proxy
    state: restarted
    delay: 10s
  when: version_changed

- name: Flush all registered handlers
  ansible.ansible.flush_handlers:

- name: Perform rolling restart when configuration files change
  ansible.builtin.include_tasks: tasks/rolling-restart.yml
  when: config_files_changed

- name: Perform final steps including a summary
  ansible.builtin.include_tasks: tasks/final-steps.yml


