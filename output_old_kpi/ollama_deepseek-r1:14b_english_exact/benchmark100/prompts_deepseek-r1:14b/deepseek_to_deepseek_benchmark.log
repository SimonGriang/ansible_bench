    java_distribution: "{{ openjdk_distribution|default('temurin') }}"
    java_packages:
      - openjdk-{{ java_version }}-jdk
      - openjdk-{{ java_version }}-jre
    java_repositories:
      debian: "{{ openjdk_debian_repository }}"
      redhat: "{{ openjdk_redhat_repository }}"
  when: java_jdk_vendor is defined

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_install_path: "/usr/lib/jvm/java-{{ java_version }}"
    java_package_name: "{{ java_package_name|default('openjdk-{{ java_version }}-jdk') }}"
  when: java_jdk_vendor is defined

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}"
  when: java_jdk_vendor is defined

- name: Debian pre-requisites
  apt:
    name: "{{ item }}"
    state: present
  with_items: '{{ openjdk_debian_prerequisites }}'
  when: ansible_distribution in ['debian', 'ubuntu']

- name: RedHat pre-requisites
  yum:
    name: "{{ item }}"
    state: present
  with_items: '{{ openjdk_redhat_prerequisites }}'
  when: ansible_distribution in ['centos', 'redhat', 'ol']

- name: Install required libs
  block:
    - name: Install required libs for Debian
      apt:
        name: "{{ item }}"
        state: present
      with_items: '{{ required_libs_debian }}'
      when: ansible_distribution in ['debian', 'ubuntu']
      ignore_errors: yes

    - name: Install required libs for RedHat
      yum:
        name: "{{ item }}"
        state: present
      with_items: '{{ required_libs_redhat }}'
      when: ansible_distribution in ['centos', 'redhat', 'ol']
      ignore_errors: yes

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    version: "{{ java_version }}"
    state: present
  when: ansible_distribution in ['debian', 'ubuntu']

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    version: "{{ java_version }}"
    state: present
  when: ansible_distribution in ['centos', 'redhat', 'ol']

- name: Export environment variables
  template:
    src: templates/java_env.conf.j2
    dest: /etc/profile.d/java_env.sh
    mode: 0755

- name: Source environment variables
  shell: source /etc/profile.d/java_env.sh
  when: ansible_distribution in ['debian', 'ubuntu', 'centos', 'redhat', 'ol']

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    state: link
    value: /usr/lib/jvm/java-{{ java_version }}/jre/bin/java
  when: java_version|int < 11

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    state: link
    value: /usr/lib/jvm/java-{{ java_version }}/bin/java
  when: java_version|int >= 11


