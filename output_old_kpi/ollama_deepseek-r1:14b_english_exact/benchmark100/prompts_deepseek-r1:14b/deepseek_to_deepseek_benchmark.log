---
- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost
  remote_user: root

- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  user:
    name: "{{ user_name }}"
    state: absent
    check: yes

- name: Create git config directory
  directory:
    path: "{{ user_home }}/.gitconfig.d"
    state: directory
    mode: 0o700
    owner: "{{ user_name }}"

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig"
    mode: 0o600
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Create repository destination
  directory:
    path: "{{ repo_destination_dir }}"
    state: directory
    mode: 0o700
    owner: "{{ user_name }}"

- name: Clone all repositories
  git:
    repo: "{{ repo_url }}"
    dest: "{{ item.destination }}"
    branch: "{{ item.branch }}"
    remote_user: "{{ user_name }}"
    groups: "{{ user_group }}"
  loop:
    - { destination: "{{ repo_destination_dir }}/repo1", branch: "main" }
    - { destination: "{{ repo_destination_dir }}/repo2", branch: "main" }


