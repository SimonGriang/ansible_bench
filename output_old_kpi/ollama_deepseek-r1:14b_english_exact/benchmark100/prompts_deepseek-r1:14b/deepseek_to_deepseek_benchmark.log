---
- name: Check current docker-compose version
  command:
    cmd: /usr/local/bin/docker-compose --version
  register: docker_compose_version

- name: Set fact for docker-compose current version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version.stdout | regex_replace('.*?v?(.*).*', '\\1') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when:
    - current_docker_compose_version != expected_docker_compose_version

- name: Install Docker Compose (if configured)
  file:
    path: /usr/local/bin/docker-compose
    src: "{{ docker_compose_url }}"
    state: link
    force: yes
    executable: yes
  when:
    - ansible_facts.packages.docker-compose is defined
    - ansible_version_compare("{{ current_docker_compose_version | default('0.0.0') }}", ">", "{{ expected_docker_compose_version }}")


