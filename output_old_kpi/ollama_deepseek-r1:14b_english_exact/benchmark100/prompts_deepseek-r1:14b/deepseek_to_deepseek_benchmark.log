---
- name: Import assertion tasks
  include_tasks:
    file: assert.yml
    vars:
      ansible_run_once: true
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install Docker Compose binary
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - docker.io
    - git
  when: installation_type == "binary"

  get_url:
    url: "https://github.com/docker/compose/releases/download/v{{ docker_compose_version }}/docker-compose-{{ ansible_system }}-{{ ansible_architecture }}"
    dest: /usr/local/bin/docker-compose
    mode: 0755
  when: installation_type == "binary"

  file:
    path: /usr/local/bin/docker-compose
    state: file
    mode: 0755
  when: installation_type == "binary"


