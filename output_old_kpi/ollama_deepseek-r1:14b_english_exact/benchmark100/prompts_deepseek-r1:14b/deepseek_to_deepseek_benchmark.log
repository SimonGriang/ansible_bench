---
- name: Import assert.yml
  import_tasks: assert.yml
  vars:
    logrotate_assertions: "{{ logrotate_assertions | default([]) }}"

- name: Install logrotate
  apt:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: logrotate_config_file.j2
    dest: "{{ logrotate_config_file }}"

- name: Generate logrotate.d files
  template:
    src: logrotate_d.j2
    dest: "{{ item.dest }}"
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
    mode: "{{ item.mode | default('0644') }}"
  with_items: "{{ logrotate_entries | rejectattr('state', '==', 'absent') | list }}"

- name: Remove logrotate.d files
  file:
    path: "{{ item.dest }}"
    state: absent
  with_items: "{{ logrotate_entries | selectattr('state', '==', 'absent') | list }}"

- name: Start logrotate
  systemd:
    name: "{{ logrotate_service | default('logrotate') }}"
    state: "{{ logrotate_service_state | default('started') }}"
    enabled: "{{ logrotate_service_enabled | default(true) }}"
  when: logrotate_service is defined


