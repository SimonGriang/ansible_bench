---
- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy_package: "{{ selinux_policy }}"
  notify: Reboot
  when: selinux_booleans is defined

- name: Manage SELinux booleans
  seboolean:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    persistent: yes
  loop: "{{ selinux_booleans | default([]) }}"
  when: selinux_booleans is defined


