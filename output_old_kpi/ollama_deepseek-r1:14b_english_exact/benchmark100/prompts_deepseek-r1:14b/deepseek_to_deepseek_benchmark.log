---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns packages
  ansible.builtin.apt:
    name: "{{ dns_packages }}"
    state: present
  become: true

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
  loop: "{{ dns_directories }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  ansible.dns.rndc_keygen:
    keyfile: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ rndc_key_path }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "https://www.root-verzeichnis.de/files/root.hints"
    dest: "{{ dns_config_dir }}/root.hints"
    mode: "0644"
    owner: "root"
    group: "root"
  when: dns_caching_dns

- name: Create zone file
  ansible.builtin.template:
    src: "{{ item.template | default('dns/zone.j2') }}"
    dest: "{{ item.path }}"
    mode: "0644"
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
  loop: "{{ zone_files }}"
  notify: Rndc reload

- name: Add zones to configuration
  ansible.builtin.template:
    src: "{{ item.template | default('dns/config.j2') }}"
    dest: "{{ item.path }}"
    mode: "0644"
    owner: "root"
    group: "root"
  loop: "{{ zones }}"
  notify: Restart dns

- name: Place systemd override
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0644"
    owner: "root"
    group: "root"
  loop: "{{ systemd_overrides }}"
  when: ansible_system == "Linux" and ansible_service_manager == "systemd"

- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: true


