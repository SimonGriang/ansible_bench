: rke2_service_started\n\n- name: Mask RKE2 agent service\n  ansible.systemd:\n    name: rke2-agent.service\n    state: masked\n\n- name: Wait for first server to be ready (no CNI)\n  wait_for_task:\n    path: /usr/bin/rke2-cni\n    state: absent\n    retries: 30\n    delay: 10\n\n- name: Wait for first server to be ready (with CNI)\n  wait_for_task:\n    path: /usr/bin/rke2-cni\n    state: present\n    retries: 30\n    delay: 10\n\n- name: Restore etcd\n  ansible.command:\n    cmd: |\n      systemctl stop rke2.service\n      rke2-etcd delete-node --name=$(hostname)\n      rke2-etcd restore {{ (rke2_etcd_restore_from_file | boolean) | ternary(\'from-file=/var/lib/rke2/etcd/etcd-snapshot.bin\',\'from-s3\') }}\n  when: rke2_etcd_restore_from_file | boolean or rke2_etcd_restore_from_s3 | boolean\n  notify: rke2_etcd_restored\n\n- name: Set Active Server variable\n  ansible.set_fact:\n    rke2_active_server: "{{ inventory_hostname }}"\n  delegate_to: all\n  run_once: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-04T14:51:36.419526588Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26594144008, 'load_duration': 99337100, 'prompt_eval_count': 2128, 'prompt_eval_duration': 390379310, 'eval_count': 1455, 'eval_duration': 26102894680, 'model_name': 'deepseek-r1:14b'} id='run--397ce04a-183f-4845-86fc-4bc2be54980f-0' usage_metadata={'input_tokens': 2128, 'output_tokens': 1455, 'total_tokens': 3583}
