  when: certificates_exists.rc != 0

- name: Set keystore directory for Java versions less than 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/jre/lib/security"
  when: java_version | version_compare('>', '11')

- name: Set keystore directory for Java versions 11 or newer
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security"
  when: java_version | version_compare('>=', '11')

- name: Import SSL certificates into Java keystore
  shell: keytool -import
         -alias {{ item.alias }}
         -file {{ item.path }}
         -keystore {{ java_keystore_dir }}/{{ keystore_name }}
         -storepass {{ keystore_password }}
  args:
    chdir: /path/to/keystore
  loop: "{{ java_certs }}"
  register: imported_certs
  changed_when: false

