    enabled: yes
  tags: []

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true
  tags: []

- name: Place my.cnf
  ansible.builtin.file:
    path: /etc/mysql/my.cnf
    state: file
    mode: 0644
  tags: []

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
    skip_if_initial_import: "{{ initial_import | default('') | string }}"
  loop: "{{ databases }}"
  tags: []

- name: List databases
  ansible.builtin.mysql_db:
    name: "*"
    state: list
  tags: []

- name: Import database
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: import
    import: "{{ initial_import | default('') | string }}"
    skip_if_initial_import: "{{ initial_import | default('') | string }}"
  loop: "{{ databases }}"
  tags: []

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ user.name }}"
    host: "{{ user.host }}"
    priv: "{{ user.privileges }}"
    state: present
  loop: "{{ users }}"
  notify: 
    - mysql_server_restarted
  tags: []

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true
  tags: []


