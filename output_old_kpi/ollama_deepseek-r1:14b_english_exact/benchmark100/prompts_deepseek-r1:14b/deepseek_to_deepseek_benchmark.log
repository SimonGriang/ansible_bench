---
- name: hardening | Disable swap
  shell: |
    swapoff -a && sysctl -p
  args:
    chdir: /
  poll: 0
  changed_when: false
  ignore_errors: yes
  vars:
    vault_hardening_disable_swap: true

- name: hardening | Disable core dumps
  template:
    dest: /etc/security/pam.d/*
    owner: root
    group: root
    mode: 0644
    force: yes
  args:
    template: "{{ lookup('template', 'files/pam_core_dump.j2') }}"
  vars:
    vault_hardening_disable_core_dumps: true

- name: hardening | Disable Shell Command History
  file:
    path: /etc/profile.d/vault.sh
    state: present
    mode: 0755
  vars:
    vault_hardening_disable_shell_command_history: true

- name: hardening | Configure SELinux / AppArmor
  shell: |
    setenforce enforcing && aa-enforce /etc/apparmor.d/ Vault
  args:
    chdir: /
  poll: 0
  changed_when: false
  ignore_errors: yes
  vars:
    vault_hardening_configure_selinux_apparmor: true

