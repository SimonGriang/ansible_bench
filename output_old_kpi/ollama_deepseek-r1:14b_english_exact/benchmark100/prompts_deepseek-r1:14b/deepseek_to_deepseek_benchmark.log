- name: Install EPEL on compatible systems
  become: true
  become_flags:
    user: epel
    executable: /bin/bash
  tasks:
    - name: Install EPEL GPG key
      rpm_key:
        key: "{{ epel_gpg_key | default('https://download.example.com/epel.gpg') }}"
        state: present
      become: false

    - name: Install EPEL-release package
      yum:
        name: "{{ epel_release_package | default('https://download.example.com/epel-release-latest.noarch.rpm') }}"
        state: present
      become: false

    - name: Install EPEL-next-release package
      yum:
        name: "{{ epel_next_release_package | default('https://download.example.com/epel-next-release-latest.noarch.rpm') }}"
        state: present
      become: false
      when: (epel_next | default(false)) | bool

    - name: Update package cache
      meta:
        update_cache: yes
      become: false

