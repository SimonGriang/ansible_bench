- name: Install Ansible Python package using pip
  pip:
    executable: /usr/bin/python3
    version: 2.9.2
    extra_args: --user

- name: Create /etc/ansible directory
  file:
    path: /etc/ansible
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create /etc/ansible.cfg file
  template:
    src: ansible.cfg.j2
    dest: /etc/ansible.cfg
    mode: '0644'
    owner: root
    group: root

- name: Create /etc/ansible/ansible.cfg file
  template:
    src: ansible.cfg.j2
    dest: /etc/ansible/ansible.cfg
    mode: '0644'
    owner: root
    group: root

- name: Create /etc/ansible/hosts directory
  file:
    path: /etc/ansible/vars
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create /etc/ansible/vars/ansible_vars.yml file
  template:
    src: ansible_vars.yml.j2
    dest: /etc/ansible/vars/ansible_vars.yml
    mode: '0644'
    owner: root
    group: root

- name: Create /etc/ansible/keys directory
  file:
    path: /etc/ansible/keys
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create /etc/ansible/keys/ansible_key.pub file
  template:
    src: ansible_key.pub.j2
    dest: /etc/ansible/keys/ansible_key.pub
    mode: '0644'
    owner: root
    group: root

- name: Create /etc/ansible/keys/ansible_key file
  template:
    src: ansible_key.j2
    dest: /etc/ansible/keys/ansible_key
    mode: '0644'
    owner: root
    group: root

- name: Update Python path
  environment:
    PATH: "{{ ansible_python.path }}"
  become: yes

- name: Verify Ansible installation
  command: ansible --version
  register: ansible_version

- name: Display Ansible version
  debug:
    msg: "Ansible version: {{ ansible_version.stdout }}"


