---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2
    state: directory
    mode: 0755

- name: Set server taints
  k8s_auth:
    role: taint
    node: "{{ ansible_hostname }}"
    taints:
      - key: node-role.kubernetes.io/server
        value: true
        effect: NoExecute

- name: Set agent taints
  k8s_auth:
    role: taint
    node: "{{ ansible_hostname }}"
    taints:
      - key: node-role.kubernetes.io/agent
        value: true
        effect: NoExecute

- name: Copy RKE2 configuration file
  template:
    src: "{{ rke2_config_template }}"
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: 0644
  notify: restart_rke2

- name: Copy Kubelet configuration file
  template:
    src: "{{ kubelet_config_template }}"
    dest: /etc/rke2/kubelet.yaml
    owner: root
    group: root
    mode: 0644
  when: kubelet_config is not None
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config }}"
    dest: /etc/containerd/registry.json
    owner: root
    group: root
    mode: 0644
  when: custom_registry is not None
  notify: restart_containerd

- name: Start RKE2 service on other nodes
  service:
    name: rke2
    state: started
    enabled: yes
  notify: restart_rke2

- name: Mask other RKE2 services on nodes
  command: systemctl mask rke2-agent
  when: node_type == "server"
  ignore_errors: yes

- name: Mask other RKE2 services on nodes
  command: systemctl mask rke2-server
  when: node_type == "agent"
  ignore_errors: yes

- name: Wait for remaining nodes to be ready - no CNI
  shell: kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status} {end}' | tr -s ' ' | cut -d' ' -f2 | grep -q "True"
  args:
    chdir: /usr/local/bin
  register: node_ready
  until: node_ready.stdout contains "True"
  retries: 50
  delay: 30
  when: not cni_configured

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status} {end}' | tr -s ' ' | cut -d' ' -f2 | grep -q "True"
  args:
    chdir: /usr/local/bin
  register: node_ready
  until: node_ready.stdout contains "True"
  retries: 50
  delay: 30
  when: cni_configured


