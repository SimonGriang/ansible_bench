---
- name: Include tasks for installing Keepalived when HA mode is enabled
  include_tasks: "{{ ha_mode_dir }}/keepalived.yml" 
  when: ha_mode is true

- name: Download and install RKE2
  include_tasks: "{{ rke2_dir }}/rke2.yml"

- name: Perform CIS hardening when a CIS profile is defined
  include_tasks: "{{ cis_dir }}/cis.yml" 
  when: cis_profile is not None

- name: Find and identify the active server in the cluster
  include_tasks: "{{ active_server_dir }}/active_server.yml"

- name: Enable the IPVS kernel module for load balancing
  include_tasks: "{{ ipvs_dir }}/ipvs.yml" 
  when: ha_mode is true

- name: Copy kube-vip manifests to the master node
  include_tasks: "{{ kubevip_dir }}/kubevip.yml" 
  when: ha_mode is true

- name: Copy ingress-nginx manifests to the master node
  include_tasks: "{{ ingressnginx_dir }}/ingressnginx.yml" 
  when: ingressnginx_values is not None

- name: Prepare the first server node in the cluster
  include_tasks: "{{ first_server_dir }}/first_server.yml" 
  when: first_server is true

- name: Perform etcd restore tasks when specific conditions are met
  include_tasks: "{{ etcd_dir }}/etcd.yml" 
  when: etcd_restore is true

- name: Download the kubeconfig file to the Ansible localhost
  include_tasks: "{{ kubeconfig_dir }}/kubeconfig.yml" 
  when: download_kubeconfig is true

- name: Prepare and join remaining cluster nodes
  include_tasks: "{{ join_nodes_dir }}/join_nodes.yml" 
  when: active_server is defined

- name: Perform rolling restart of server nodes
  include_tasks: "{{ rolling_restart_server_dir }}/rolling_restart_server.yml" 
  when: version_changed is true

- name: Perform rolling restart of agent nodes
  include_tasks: "{{ rolling_restart_agent_dir }}/rolling_restart_agent.yml" 
  when: version_changed is true

- name: Flush all registered handlers
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
  include_tasks: "{{ rolling_restart_config_dir }}/rolling_restart_config.yml" 
  when: config_changed is true

- name: Perform final steps including a summary
  include_tasks: "{{ final_steps_dir }}/final_steps.yml"


