- name: Check if EFI firmware exists on the system
  stat:
    path: /sys/firmware/efi/efivars/
    register: efir_result

- name: Remove GRUB configuration file on EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when:
    - efir_result.stat.exists

- name: Install custom user template for GRUB
  copy:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: '0755'

- name: Add EFI password protection to GRUB
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: "password_pbkdf2 {{ grub_password }}"
    create: yes
  when:
    - efir_result.stat.exists

- name: Add MBR password protection to GRUB
  lineinfile:
    path: /etc/grub2.cfg
    line: "password_pbkdf2 {{ grub_password }}"
    create: yes
  when:
    - not efir_result.stat.exists

- name: Add unrestricted access to GRUB password entries
  lineinfile:
    path: /etc/grub2.cfg
    line: "password_pbkdf2 {{ grub_password }} --unrestricted"
    create: yes
  when:
    - efir_result.stat.exists


