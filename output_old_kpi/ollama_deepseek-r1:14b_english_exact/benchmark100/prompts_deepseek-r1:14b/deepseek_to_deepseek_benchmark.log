---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  shell: helm version
  register: helm_existing_version
  ignore_errors: true

- name: Download helm
  unarchive:
    url: https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz
    remote_src: yes
    dest: /tmp/helm
    register: helm_download
  when:
    - not helm_check.stat.exists
    - bool(helm_existing_version.stdout.helm_version != helm_version)

- name: Copy helm binary into place
  copy:
    src: /tmp/helm/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: 0o755
  when: helm_download is succeeded
  become: true


