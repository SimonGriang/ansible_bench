---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  setsebool:
    name: httpd_enable_cgi
    state: on
  when: ansible_facts.selinux.status == "enabled"
  register: selinux_result

- name: Allow connections to specified ports
  shell: setsebool -P httpd_port_t 1
  when: ansible_facts.selinux.status == "enabled"

- name: Restart httpd after selinux changes
  shell: systemctl restart httpd
  when: ansible_facts.selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_config_template }}"
    dest: "{{ httpd_config_file }}"
    mode: 0644
  notify: httpd_config_test

- name: Activate specific Apache modules | Debian
  apt:
    name: "{{ item }}"
    state: present
    mode: a2enmod
  with_items: "{{ httpd_modules }}"
  changed_when: false

- import_tasks: ssl.yml
  delegate_to: localhost

- import_tasks: locations.yml
  delegate_to: localhost

- import_tasks: vhosts.yml
  delegate_to: localhost

- name: Configure Apache ports
  apt:
    name: "{{ httpd_port }}"
    state: present
  when: ansible_os_family in ["Debian", "Suse"]

- import_tasks: directories.yml
  delegate_to: localhost

- name: Flush handlers
  meta: flush_handlers

- name: Remove the default Apache HTML file
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  systemctl:
    name: httpd
    state: started
    enabled: yes


