---
- name: Import assertion file
  include_tasks:
    file: assert.yml
  args:
    host: localhost
    limit: 1

- name: Install cron package
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  cron:
    name: "@reboot"
    shell: "{{ cron_shell_env }}"
    state: present

- name: Configure cron path environment
  cron:
    name: "@reboot"
    path: "{{ cron_path_env }}"
    state: present

- name: Configure cron mailto settings
  cron:
    name: "@reboot"
    mailto: "{{ cron_mailto }}"
    state: present

- name: Start and enable cron service
  service:
    name: "{{ cron_service | default('cron') }}"
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    cron_file: "{{ item.cron_file | default('crontab') }}"
    schedule: "{{ item.schedule }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"


