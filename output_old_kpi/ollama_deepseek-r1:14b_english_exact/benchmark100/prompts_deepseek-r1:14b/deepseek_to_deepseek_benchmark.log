---
- name: Import assertion tasks
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  ini_file:
    path: /etc/pip.conf
    section: global
    key: index-url
    value: "{{ python_pip_proxy }}"
    state: present
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  ini_file:
    path: /etc/pip.conf
    section: global
    key: trusted-host
    value: "{{ python_pip_trusted_host }}"
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when:
    - ansible_distribution != "bookworm"
    - ansible_distribution != "noble"
    - not ansible_os_family == "Alpine"

- name: Install Python modules
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ item_version | default('latest') }}"
  loop: "{{ python_pip_modules | default([]) | dict_output }}"
  when:
    - ansible_distribution != "bookworm"
    - ansible_distribution != "noble"
    - not ansible_os_family == "Alpine"


