---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  community.general.wait_for_port:
    port: "{{ some_port }}"
    timeout: "{{ bootstrap_timeout }}"
  no_log: true

- name: Prepare system
  block:
    - name: Test connection and sudo access
      ansible.builtin.command: whoami
      changed_when: false
    - name: Gather facts
      ansible.builtin.setup:
        gather_subset: all
  rescue:
    - name: Gather facts
      ansible.builtin.setup:
        gather_subset: all
    - name: Install libdnf5
      ansible.builtin.raw: "dnf install libdnf5"
      become: true
      changed_when: false

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


