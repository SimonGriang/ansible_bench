---
- name: Restore etcd - get all nodes
  kubectl:
    command: get
    args:
      - nodes
      - --output=name
    register: node_names

- name: Restore etcd - remove old nodes
  kubectl:
    command: delete
    args:
      - nodes
      - "{{ item }}"
    when: item not in groups[rke2_cluster_group_name]
    with_items: "{{ node_names.items }}"


