---
- name: Create the RKE2 config directory
  ansible.posix.file:
    path: /etc/rke2
    state: directory
    mode: 0755
    owner: rke2
    group: rke2

- name: Set server taints
  kubernetes.core.k8s_set_node_taints:
    taints: "{{ rke2_server_node_taints | default([]) }}"
  when: "'server' in rke2_node_roles"

- name: Copy RKE2 configuration file
  ansible.copy:
    src: "{{ rke2_config_source | default('default') }}"
    dest: /etc/rke2/config.yaml
    mode: 0644
    owner: rke2
    group: rke2
  notify: rke2_config_updated

- name: Copy kubelet configuration file
  ansible.copy:
    src: "{{ rke2_kubelet_config_source | default('default') }}"
    dest: /etc/rke2/kubelet.yaml
    mode: 0644
    owner: rke2
    group: rke2
  when: rke2_kubelet_config | default('') | length > 0
  notify: rke2_kubelet_config_updated

- name: Copy Containerd Registry Configuration file
  ansible.copy:
    src: "{{ rke2_containerd_registry_config_source | default('default') }}"
    dest: /etc/rke2/registry.json
    mode: 0644
    owner: rke2
    group: rke2
  when: rke2_containerd_registry_config | default('') | length > 0
  notify: rke2_containerd_registry_config_updated

- name: Register etcd restore from file
  ansible.set_fact:
    rke2_etcd_restore_from_file: "{{ (rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file is not empty) and (rke2_service_state == 'running') }}"

- name: Register etcd restore from S3
  ansible.set_fact:
    rke2_etcd_restore_from_s3: "{{ (rke2_etcd_s3_bucket is defined and rke2_etcd_s3_bucket is not empty) and (rke2_etcd_s3_prefix is defined and rke2_etcd_s3_prefix is not empty) }}"

- name: Restore etcd from file
  ansible.command:
    cmd: >
      mkdir -p /var/lib/rke2/etcd && 
      cp "{{ rke2_etcd_snapshot_file }}" /var/lib/rke2/etcd/etcd-snapshot.bin && 
      rke2-etcd restore from-file=/var/lib/rke2/etcd/etcd-snapshot.bin
  when: rke2_etcd_restore_from_file | bool
  notify: rke2_etcd_restored

- name: Restore etcd from S3
  ansible.command:
    cmd: >
      mkdir -p /var/lib/rke2/etcd && 
      curl -o /var/lib/rke2/etcd/etcd-snapshot.bin https://s3.{{ rke2_etcd_s3_bucket }}.s3.amazonaws.com/{{ rke2_etcd_s3_prefix }}/etcd-snapshot.bin && 
      rke2-etcd restore from-file=/var/lib/rke2/etcd/etcd-snapshot.bin
  when: rke2_etcd_restore_from_s3 | bool
  notify: rke2_etcd_restored

- name: Start RKE2 service
  ansible systemd:
    name: rke2.service
    state: started
    enabled: yes
    environment: "RKE2_TOKEN={{ rke2_token }}"
  notify: rke2_service_started

- name: Mask RKE2 agent service
  ansible systemd:
    name: rke2-agent.service
    state: masked

- name: Wait for first server to be ready (no CNI)
  wait_for_task:
    path: /usr/bin/rke2-cni
    state: absent
    retries: 30
    delay: 10

- name: Wait for first server to be ready (with CNI)
  wait_for_task:
    path: /usr/bin/rke2-cni
    state: present
    retries: 30
    delay: 10

- name: Restore etcd
  ansible.command:
    cmd: >
      systemctl stop rke2.service && 
      rke2-etcd delete-node --name=$(hostname) && 
      rke2-etcd restore {{ rke2_etcd_restore_from_file | bool | ternary('from-file=/var/lib/rke2/etcd/etcd-snapshot.bin','from-s3') }}
  when: rke2_etcd_restore_from_file | bool or rke2_etcd_restore_from_s3 | bool
  notify: rke2_etcd_restored

- name: Set Active Server variable
  ansible.set_fact:
    rke2_active_server: "{{ inventory_hostname }}"
  delegate_to: all
  run_once: yes


