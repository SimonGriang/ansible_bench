- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_download_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    skip: "{{ airgap_mode | bool }}"
  when: not airgap_mode | bool

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    remote_src: yes
  when: airgap_mode | bool

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when: airgap_mode | bool and not exists_implemented | bool

- name: Download RKE2 checksum and artifacts
  ansible.builtin.get_url:
    url: "{{ rke2_checksum_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0700
    checksum: "{{ rke2_checksum }}"
    skip: "{{ airgap_mode | bool }}"
  when: not airgap_mode | bool

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_local_artifacts_path }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0640
    remote_src: yes
  when: airgap_mode | bool

- name: Airgap mode - additional images tarballs
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
  with_items: "{{ additional_tarballs | default([]) }}"
  when: additional_tarballs | bool

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ rke2_artifacts_path }}"
    state: file
    mode: 0644
  when: airgap_mode | bool and exists_implemented | bool

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ rke2_install_script_path }}"
    state: file
    mode: 0700
  when: airgap_mode | bool and exists_implemented | bool

- name: Populate service facts
  ansible.builtin.service_facts:
    |

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: usrl_local_stat

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  ansible.builtin.shell:
    cmd: "{{ rke2_bin_path }}/rke2 version --output json"
    changed_when: false
  register: rke2_version_output

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - rke2_downgrade_allowed | bool
      - current_version | int <= cleaned_current_version | int
    fail_on_rematch: false

- name: Run RKE2 install script
  ansible.builtin.shell:
    cmd: "{{ rke2_install_script_path }} '{{ rke2_install_args | join(' ') }}'"
    environment:
      RKE2_VERSION: "{{ rke2_version }}"
    changed_when: false
  when: not airgap_mode | bool

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ item.path }}"
    dest: "{{ rke2_manifests_path }}"
    remote_src: yes
    mode: 0644
  with_items: "{{ custom_manifests }}"

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item.path }}"
    dest: "{{ rke2_static_pods_path }}"
    remote_src: yes
    mode: 0644
  with_items: "{{ static_pods }}"
  when: static_pods | bool

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_dest }}"
    remote_src: yes
    mode: 0644
  when: rke2_env_file | bool
