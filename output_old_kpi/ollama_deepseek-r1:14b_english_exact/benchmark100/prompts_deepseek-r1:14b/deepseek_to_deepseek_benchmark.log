---
- name: Restart RKE2 service on {{ rke2_node_name }}
  shell: systemctl force-restart rke2
  register: rke2_service_result
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    resource: nodes
    args: '--field-selector', 'spec.nodeName={{ rke2_node_name }}'
    format: json
  register: nodes_status
  until: "'Ready' in (item.status.conditions | list | map('get', 'type'))"
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_servers_group_name | first }}"

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    resource: pods
    args: '--all-namespaces'
    format: json
  register: pods_status
  until: "'Ready' in (item.status.conditions | list | map('get', 'type'))"
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_servers_group_name | first }}"
  when: rke2_wait_for_all_pods_to_be_ready


