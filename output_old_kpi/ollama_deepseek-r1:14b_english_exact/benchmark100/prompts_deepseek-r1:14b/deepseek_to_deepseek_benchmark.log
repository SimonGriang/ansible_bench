- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rke2/manifests
    state: directory
    owner: rke2
    group: root
    mode: "0755"

- name: Copy ingress-nginx files to first server
  ansible.builtin.copy:
    remote_src: true
    src: "{{ item }}"
    dest: /etc/rke2/manifests/ingress-nginx/
    owner: rke2
    group: root
    mode: "0755"
  with_items:
    - ingress-nginx.yml
    - rke2-ingress-nginx-servicelabels.yml


