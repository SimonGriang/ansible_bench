---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml

- name: Install dns
  ansible.builtin.apt:
    state: installed
    packages:
      - "{{ dns_packages }}"

- name: Create directories
  file:
    state: directory
    path: "{{ dns_data_dir }}"
    mode: "{{ directory_mode }}"
    owner: "{{ user }}"
    group: "{{ group }}"

- name: Create group
  group:
    name: "{{ group_name }}"
    state: present
    system: yes

- name: Create user
  user:
    name: "{{ user_name }}"
    state: present
    system: yes
    shell: /sbin/nologin
    manage_home: yes

- name: Generate rndc key
  ansible.commands.command:
    cmd: "dns-keygen -r -a {{ rndc_algorithm }}"
  register: rndc_key
  changed_when: false

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_file }}"
    mode: "{{ rndc_key_mode }}"
    owner: "{{ user }}"
    group: "{{ group }}"
    state: file

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/named.root"
    mode: 0644

- name: Create zone file
  ansible.builtin.template:
    src: "{{ templates_dir }}/zone.j2"
    dest: "{{ zones_dir }}/{{ zone_name }}.zone"
    mode: 0644

- name: Add zones to configuration
  ansible.builtin.template:
    src: "{{ templates_dir }}/named.conf.j2"
    dest: "{{ named_conf_file }}"
    mode: 0644

- name: Place systemd override
  file:
    path: "{{ systemd_override_dir }}/named.service"
    content: "{{ lookup('file', 'systemd_override/named.service') }}"
    mode: 0644

- name: Start and enable dns
  ansible.builtin.systemctl:
    name: named
    state: started
    enabled: yes



