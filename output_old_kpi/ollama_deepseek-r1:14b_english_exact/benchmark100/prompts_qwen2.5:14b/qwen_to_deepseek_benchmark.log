---
- name: Update apt cache
  apt:
    state: updated

- name: Update dnf cache
  dnf:
    state: updated

- name: Install packages
  shell: apt install -y keepalived || yum install -y keepalived
  become: yes

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
