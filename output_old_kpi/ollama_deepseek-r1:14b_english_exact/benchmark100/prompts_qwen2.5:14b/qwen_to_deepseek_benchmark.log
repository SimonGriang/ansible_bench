---
- name: Import assert.yml
  include_tasks:
    file: assert.yml
  args:
    host_list: "{{ assert_host }}"

- name: Install logrotate
  apt:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file.j2 }}"
    dest: "{{ logrotate_config_directory }}/{{ logrotate_config_file }}"
    mode: 0o0644

- name: Generate logrotate.d files
  template:
    src: "{{ item.template }}"
    dest: "{{ logrotate_config_directory }}/logrotate.d/{{ item.name }}"
    mode: 0o0644
  loop: "{{ logrotate_entries | default([]) if not (item.state and item.state == 'absent') | list }}"
  loop_control:
    loop_var: item

- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_config_directory }}/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries | selectattr('state') | select('==', 'absent') | list }}"
  loop_control:
    loop_var: item

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined



