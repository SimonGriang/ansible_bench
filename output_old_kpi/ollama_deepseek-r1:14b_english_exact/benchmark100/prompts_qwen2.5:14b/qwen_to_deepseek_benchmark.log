---
- name: Assert usage of systemd as an init system
  ansible.builtin.systemd:
    name: systemd
    state: started
    changed_when: false

- name: Get latest release of promtail
  ansible.builtin.github:
    repo: Grafana/loki
    path: promtail
    version: latest
    list_releases: yes
  register: promtail_releases

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip"
  register: promtail_archive_status

- name: Assert local binary exists
  ansible.builtin.file:
    path: "{{ promtail_binary_local_dir }}/promtail"
    state: file
  when: promtail_binary_local_dir is defined
  ignore_errors: yes

- name: Get checksum list
  ansible.builtin.shell:
    cmd: curl -s https://raw.githubusercontent.com/Grafana/loki/main/CHANGELOG.md
  register: checksum_list

- name: Get checksum for specific architecture
  ansible.builtin.json_query:
    query: "{{ checksum_list.stdout | json_query('releases[] as $r | $r.checksum | select(contains($r.arch, {{ go_arch }}))') }}"
  register: promtail_checksum



