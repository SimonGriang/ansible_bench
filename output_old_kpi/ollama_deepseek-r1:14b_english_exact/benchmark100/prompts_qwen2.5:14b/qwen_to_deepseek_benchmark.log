---
- name: Import assert.yml
  import_tasks:
    file: files/assert.yml
    remote_host: localhost

- name: Configure apk - import gpg key
  become: true
  become_user: root
  apt:
    action: import
    key: "https://dl.alpinelinux.org/dl/cpk/gnupg/A3BA21F40615FC53.gpg"

- name: Configure apk
  become: true
  become_user: root
  shell: apk update && apk upgrade
  notify: reboot

- name: Configure apt - prevent upgrade
  become: true
  become_user: root
  apt:
    action: upgrade
    state: upgrade
    only_trusted: true
    upgrade_ignored_packages: ['linux-unsigned', 'linux-lts-unsigned', 'backportsg-keyring']

- name: Configure apt - autoremove
  become: true
  become_user: root
  shell: apt autoremove --unused
  notify: reboot

- name: Update all software (dnf)
  become: true
  become_user: root
  dnf:
    name: '*'
    state: present
    exclude: ['kernel*']
  notify: reboot

- name: Update all software (pacman)
  become: true
  become_user: root
  pacman:
    name: '*'
    state: present
  notify: reboot

- name: Configure yum
  become: true
  become_user: root
  yum:
    name: yum
    state: present
    update_cache: true
  shell: yum install yum-utils -y
  notify: reboot

- name: Update all software (zypper)
  become: true
  become_user: root
  zypper:
    name: '*'
    state: present
  notify: reboot



