---
- name: Import assert.yml
  ansible.builtin.import_playbook:
    playbook: assert.yml

- name: Uninstall conflicting systemd-logger
  ansible.builtin.apt:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  ansible.builtin.apt:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ rsyslog_features }}"

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: default_config.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: "0755"
  when: rsyslog_deploy_default_config

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward_rule.j2
    dest: /etc/rsyslog.d/50-forward.conf
    owner: root
    group: root
    mode: "0755"
  when: not rsyslog_deploy_default_config

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: /etc/rsyslog.d/{{ item.dest }}
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  with_items: "{{ rsyslog_additional_configs }}"

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true



