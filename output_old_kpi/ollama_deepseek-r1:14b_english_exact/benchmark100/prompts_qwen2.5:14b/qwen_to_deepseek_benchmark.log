- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snapshot_file is not empty) and (rke2_server.service | default('disabled') == 'disabled' or rke2_server.service is undefined) }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_file is not empty) and (rke2_etcd_snapshot_s3_options is not empty) }}"

- name: Restore etcd from file
  when: do_etcd_restore | default(false)
  become: yes
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshots
    cp /etc/rancher/rke2/etcd/{{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd/snapshots/
    rke2-restore --config /etc/rancher/rke2/config.yaml

- name: Restore etcd from s3
  when: do_etcd_restore_from_s3 | default(false)
  become: yes
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshots
    rke2-restore --config /etc/rancher/rke2/config.yaml --from-s3

- name: Start RKE2 service on the first server
  become: yes
  service:
    name: rke2-server
    state: started
    enabled: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service on the first server
  become: yes
  service:
    name: rke2-agent
    state: stopped
    enabled: no

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: http://localhost:6443/healthz
    state: started
    timeout: 600
  when: rke2_cni | installed == false

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: http://localhost:6443/healthz
    state: started
    timeout: 600
  when: rke2_cni | installed == true

- name: Restore etcd
  become: yes
  shell: |
    rke2-get-nodes && rke2-remove-old-secrets && rke2-remove-old-nodes

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: rke2_server_type == 'server'



