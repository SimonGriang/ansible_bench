    src: /path/to/ingress-nginx/manifests/
    dest: /etc/kubernetes/manifests/
  when: ingress_nginx_config

- name: Prepare very first server node in the cluster
  command: rke2 CLI bootstrap
  when: first_node and k8s_version is not None

- name: Restore etcd specific tasks
  command: etcd-restore.sh
  when: etcd_restore

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/kubeconfig
    dest: /path/to/kubeconfig
    flat: yes
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  command: rke2 CLI join
  when: active_server

- name: Rolling cordon and drain restart when version changes - servers
  command: rolling-restart.sh servers
  when: k8s_version changed

- name: Rolling cordon and drain restart when version changes - agents
  command: rolling-restart.sh agents
  when: k8s_version changed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  command: systemctl restart rke2-node
  when: config_files_changed

- name: Final steps
  command: |
    cleanup && reboot



