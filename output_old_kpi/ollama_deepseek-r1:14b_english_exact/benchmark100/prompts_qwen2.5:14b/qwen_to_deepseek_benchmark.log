---
- name: gather_facts | Lookup bootstrap facts
  shell: cat /etc/os-release
  register: os_release
  changed_when: false
  ignore_errors: yes

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value.match if item.value.match else '' }}"
    bootstrap_distribution_version: "{{ item.version.match if item.version.match else '' }}"
  loop: "{{ query('vars', 'bootstrap_os_family_map') | dict2list }}"
  when: "'{{ item.key }}' in {{ os_release.stdout | regex_replace('/PRETTY_NAME="(.*)"/', '\\1') | lower() }}"
  changed_when: false

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: "{{ item.value }}"
  loop: "{{ query('vars', 'bootstrap_os_family_map') | dict2list }}"
  when: "'{{ item.key }}' in {{ bootstrap_distribution | lower() }}"
  changed_when: false



