- name: Create etcd group
  group:
    name: etcd
    state: present
    comment: etcd group

- name: Create etcd user
  user:
    name: etcd
    shell: /bin/nologin
    group: etcd
    comment: etcd user
    state: present

- name: Copy systemctl config file for kernel hardening
  copy:
    remote_src: yes
    src: "{{ lookup('file', '/usr/local/share/rke2/rke2-cis-sysctl.conf') if stat('/usr/local').writable else '/opt/rke2/share/rke2/rke2-cis-sysctl.conf' | join(',') | first_found }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
  notify: restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers



