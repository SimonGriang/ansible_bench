al_duration': 29746009005, 'model_name': 'deepseek-r1:14b'} id='run--54163d38-3c3b-4d11-814f-80a25d25f42e-0' usage_metadata={'input_tokens': 997, 'output_tokens': 1397, 'total_tokens': 2394}
