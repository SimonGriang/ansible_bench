---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Easyrsa init-pki
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: pki_init
  until: pki_init is not changed
  retries: 3

- name: Build the Certificate Authority (CA)
  command: easyrsa build-ca --subject "CN=OpenVPN-CA"
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: ca_build
  until: ca_build is not changed
  retries: 3
  when: "{{ lookup('file', '/etc/openvpn/easy-rsa/pki/ca.crt') | bool | not }}"

- name: Generate Diffie-Hellman parameters
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: dh_gen
  until: dh_gen is not changed
  retries: 3
  when: "{{ lookup('file', '/etc/openvpn/easy-rsa/pki/dh.pem') | bool | not }}"

- name: Build a server certificate and key
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: server_cert
  until: server_cert is not changed
  retries: 3
  when: "{{ lookup('file', '/etc/openvpn/easy-rsa/pki/issued/server.crt') | bool | not }}"

- name: Build a client certificate and key
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: client_cert
  until: client_cert is not changed
  retries: 3
  when: "{{ lookup('file', '/etc/openvpn/easy-rsa/pki/issued/client.crt') | bool | not }}"

- name: Generate a Certificate Revocation List (CRL)
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: crl_gen
  until: crl_gen is not changed
  retries: 3
  when: "{{ lookup('file', '/etc/openvpn/easy-rsa/pki/crl.pem') | bool | not }}"

- name: Generate a static key for the OpenVPN tunnel
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: yes
  changed_when: false
  register: ta_key_gen
  until: ta_key_gen is not changed
  retries: 3
  when: "{{ lookup('file', '/etc/openvpn/easy-rsa/pki/ta.key') | bool | not }}"

- name: Copy necessary files to /etc/openvpn/server
  copy:
    remote_src: /etc/openvpn/easy-rsa/pki
    dest: /etc/openvpn/server/
    files:
      - ca.crt
      - dh.pem
      - server.crt
      - server.key
      - ta.key
      - crl.pem
  file_mode: yes
  dir_mode: 0755

- name: Copy necessary files to /etc/openvpn
  copy:
    remote_src: /etc/openvpn/easy-rsa/pki
    dest: /etc/openvpn/
    files:
      - ca.crt
      - dh.pem
      - crl.pem
  file_mode: yes
  dir_mode: 0755

- name: Place server configuration file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: 0644
  notify: restart_openvpn



