---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml

- name: Install required software
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements | default([]) }}"
  when: users_requirements is not empty
  register: software_installation

- name: Loop over users_groups
  ansible.builtin.include_tasks:
    file: group.yml
  loop: "{{ users_groups | default([]) }}"

- name: Ensure the /etc/sudoers.d directory is included
  ansible.builtin.sudoers:
    name: "{{ users_sudo_includedir | default('includedir /etc/sudoers.d')}}"
    state: present

- name: Loop over users
  ansible.builtin.include_tasks:
    file: user.yml
  loop: "{{ users | default([]) }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0o644
  when: users_cron_allow is defined

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined



