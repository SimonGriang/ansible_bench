---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ ansible_env.HOME }}/.ssh"
    state: directory
    mode: 0750
  when: user.manage_ssh_key
  run_once: true

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default('') | password_hash('sha512') }}"
    sudoable: "{{ user.sudoable | default('yes') }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    comment: "{{ user.comment | default('') }}"
    system_user: "{{ user.system_user | default('no') }}"
    groups: "{{ user.groups | default('') }}"

- name: Set sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: present
    content: "{{ user.sudo_options | default('') }}"
    mode: 0640
  when: user.sudo_options is defined
  register: sudoers_file

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: not user.sudo_options

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.ssh_keygen:
    generate_private_key: yes
    key_name: "{{ user.name }}_ssh"
    private_key_file: "~/.ssh/{{ user.name }}_ssh"
    public_key_file: "~/.ssh/{{ user.name }}_ssh.pub"
    key_type: rsa
    size: 2048
  when: user.manage_ssh_key
  run_once: true

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.ssh_keygen:
    generate_public_key: yes
    key_name: "{{ user.name }}_ssh"
    public_key_file: "~/.ssh/{{ user.name }}_ssh.pub"
  when: user.manage_ssh_key
  run_once: true

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.ssh_keygen:
    convert_to_ssh_dot_com: yes
    key_name: "{{ user.name }}_ssh"
    ppk_file: "~/.ssh/{{ user.name }}_ssh.ppk"
  when: user.manage_ssh_key
  run_once: true

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.stat:
    path: "{{ user.name }}"
  register: user_home
  run_once: true

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ ansible_env.HOME }}/.ssh"
    state: directory
    mode: 0750
  when: user.manage_ssh_key or user.private_keys | default([]) | length > 0

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ key }}"
    path: "~/.ssh/authorized_keys"
    manage_dir: yes
    mode: 0600
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ key }}"
    path: "~/.ssh/authorized_keys"
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    content: "{{ lookup('file', '~/.ssh/{{ user.name }}_ssh') }}"
    dest: "{{ ansible_env.HOME }}/.ssh/"
    mode: 0600
    remote_src: yes
  when: user.copy_private_key | default('no')

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    content: "{{ lookup('file', '~/.ssh/{{ user.name }}_ssh') }}"
    dest: "{{ ansible_env.HOME }}/.ssh/"
    mode: 0600
    remote_src: yes
  when: user.private_keys | default([]) | length > 0

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.stat:
    path: "/etc/shadow"
    name: "{{ user.name }}"
  register: password_validity
  run_once: true

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    password_validity_days: "{{ user.password_validity_days | default('365') }}"
  when: user.password_validity_days is defined and password_validity.stat | default('') != '365'

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ ansible_env.HOME }}/.ssh"
    state: directory
    mode: 0750
  when: user.manage_ssh_key or user.private_keys | default([]) | length > 0


