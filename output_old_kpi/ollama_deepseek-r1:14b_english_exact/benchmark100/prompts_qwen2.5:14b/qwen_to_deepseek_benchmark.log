---
- name: Check if Helm binary exists
  command: which helm
  args:
    executable: /usr/local/bin/helm
  register: helm_exists
  changed_when: false
  ignore_errors: yes

- name: Check Helm version
  command: helm version --short
  args:
    executable: /usr/local/bin/helm
  register: helm_version
  changed_when: false
  when: ansible.builtin.bool(helm_exists) is true

- name: Download helm
  apt:
    name: '{{ item }}'
    state: present
    update_cache: yes
  with_items:
    - apt-transport-https
    - ca-certificates
    - curl
  when:
    - ansible.builtin.not_exists('/usr/local/bin/helm') is true
    - ansible.builtin.bool(helm_version) is true

- name: Copy helm binary into place
  copy:
    remote_src: yes
    src: '{{ helm_DOWNLOAD_URL }}'
    dest: /usr/local/bin/helm
    mode: '0755'
  when:
    - ansible.builtin.not_exists('/usr/local/bin/helm') is true
    - ansible.builtin.bool(helm_version) is true
  become: yes



