---
- name: Set defaults for boolean variables
  ansible.builtin.set_fact:
    https_ssl_enabled: "{{ https_ssl_enabled | default(false) | bool }}"
    locations_defined: "{{ locations_defined | default(false) | bool }}"
    vhosts_defined: "{{ vhosts_defined | default(false) | bool }}"
    directories_defined: "{{ directories_defined | default(false) | bool }}"

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present
  yum:
    name: "{{ httpd_packages }}"
    state: present
  become: true

- name: Configure selinux
  setsebool:
    name: "{{ item }}"
    value: "{{ item_value }}"
  loop: "{{ httpd_selinuxBOOLENS | default([]) }}"

- name: Configure httpd
  template:
    src: "{{ httpd_template_src }}"
    dest: "{{ httpd_template_dest }}"
  notify: httpd_test_and_restart

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_enable_modules | default([]) }}"
  notify: httpd_test_and_restart

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enabled | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: locations_defined | bool

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: vhosts_defined | bool

- name: Configure ports
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
  notify: httpd_test_and_restart
  when: ansible_distribution in ['debian', 'suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: directories_defined | bool

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_html_path }}"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes
  become: true



