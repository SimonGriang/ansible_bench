---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "{{ ansible_distribution | lower }}/vars.yml"
    ignore_errors: yes

- name: Include architecture-specific variables
  include_vars:
    file: "{{ ansible_architecture }}/vars.yml"
    ignore_errors: yes

- name: Set OS-specific variables (part I)
  include_vars:
    file: "{{ ansible_distribution | lower }}/os_vars.yml"
    ignore_errors: yes

- name: Set OS and architecture-specific variables (part II)
  include_vars:
    file: "{{ ansible_distribution | lower }}/{{ ansible_architecture }}/vars.yml"
    ignore_errors: yes

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}-openjdk-{{ java_version }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated Java repository
      apt:
        name: "{{ java_repositories }}"
        state: absent
      when: ansible_distribution | lower == 'debian'

    - name: Install extra apt tools
      apt:
        name: ['python3-software-properties']
        state: present

    - name: Add key repositories
      apt:
        key: "{{ item }}"
        state: present
      loop: "{{ java_key_repositories }}"

    - name: Add repositories
      apt:
        repo: "{{ item.apt_repository }}"
        state: present
      loop: "{{ java_repositories }}"

  when: ansible_distribution | lower == 'debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum:
        key: "{{ item }}"
        state: present
      loop: "{{ java_key_repositories }}"

    - name: Add repositories
      yum:
        repo: "{{ item.yum_repository }}"
        state: present
      loop: "{{ java_repositories }}"

  when: ansible_distribution | lower == 'redhat'

- name: Install required libraries
  apt:
    name: "{{ java_required_packages }}"
    state: present
  when: ansible_distribution | lower == 'debian'

  dnf:
    name: "{{ java_required_packages }}"
    state: present
  when: ansible_distribution | lower == 'redhat'

- name: Install Java, Debian
  apt:
    name: "{{ java_packages }}"
    state: present
    cache_valid_time: 3600
  when: ansible_distribution | lower == 'debian'

- name: Install Java, RedHat
  dnf:
    name: "{{ java_packages }}"
    state: present
    cache_valid_time: 3600
  when: ansible_distribution | lower == 'redhat'

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh

- name: Source environment variables
  shell: source /etc/profile.d/java.sh

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    state: selected
    value: "/usr/lib/jvm/{{ java_jdk_vendor }}-openjdk-{{ java_version }}/bin/java"
  when: java_version|int < 11 and ansible_distribution | lower == 'debian'

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    state: selected
    value: "/usr/lib/jvm/{{ java_jdk_vendor }}-openjdk-{{ java_version }}/bin/java"
  when: java_version|int >= 11 and ansible_distribution | lower == 'debian'



