---
- name: Import assert.yml
  import_playbook:
    name: assert.yml
    only_once: true
    localhost: true

- name: Install requirements
  apt:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_path: /etc/sysctl.conf
  with_items: "{{ sysctl_items }}"
  when:
    - sysctl_items is defined
    - not containerized



