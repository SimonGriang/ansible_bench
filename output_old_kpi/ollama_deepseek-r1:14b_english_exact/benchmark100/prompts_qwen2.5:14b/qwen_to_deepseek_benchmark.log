---
- name: Create ssl key
  openssl_privatekey:
    generate: true
    size: 4096
    path: /etc/ssl/private/{{ inventory_hostname }}.key
    owner: root
    mode: 0600

- name: Create ssl csr
  openssl_csr:
    generate: true
    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key
    common_name: "{{ inventory_hostname }}"
    path: /etc/ssl/csr/{{ inventory_hostname }}.csr
    owner: root
    mode: 0600

- name: Create ssl certificates
  openssl_certificate:
    generate: selfsigned
    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key
    csr_path: /etc/ssl/csr/{{ inventory_hostname }}.csr
    valid_days: 365
    path: /etc/ssl/certs/{{ inventory_hostname }}.crt
    owner: root
    mode: 0600

- name: Create PKCS#12 file
  openssl_pkcs12:
    generate: true
    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key
    certificate_path: /etc/ssl/certs/{{ inventory_hostname }}.crt
    name: "{{ inventory_hostname }}.p12"
    path: /etc/ssl/pkcs12/{{ inventory_hostname }}.p12
    password: "changeit"
    owner: root
    mode: 0600

- name: Read private key
  read_file:
    path: /etc/ssl/private/{{ inventory_hostname }}.key
  register: private_key

- name: Read certificate
  read_file:
    path: /etc/ssl/certs/{{ inventory_hostname }}.crt
  register: certificate

- name: Create combined private_key and certificate file
  ansible.builtin.file:
    path: /etc/ssl/combined/{{ inventory_hostname }}.pem
    content: "{{ private_key.content }}{{ certificate.content }}"
    owner: root
    mode: 0600



