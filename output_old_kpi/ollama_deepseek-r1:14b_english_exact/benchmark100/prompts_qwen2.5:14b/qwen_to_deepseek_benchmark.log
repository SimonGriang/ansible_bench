te/{{ inventory_hostname }}.key\n    owner: root\n    mode: 0600\n\n- name: Create ssl csr\n  openssl_csr:\n    generate: true\n    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key\n    common_name: "{{ inventory_hostname }}"\n    path: /etc/ssl/csr/{{ inventory_hostname }}.csr\n    owner: root\n    mode: 0600\n\n- name: Create ssl certificates\n  openssl_certificate:\n    generate: selfsigned\n    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key\n    csr_path: /etc/ssl/csr/{{ inventory_hostname }}.csr\n    valid_days: 365\n    path: /etc/ssl/certs/{{ inventory_hostname }}.crt\n    owner: root\n    mode: 0600\n\n- name: Create PKCS#12 file\n  openssl_pkcs12:\n    generate: true\n    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key\n    certificate_path: /etc/ssl/certs/{{ inventory_hostname }}.crt\n    name: "{{ inventory_hostname }}.p12"\n    path: /etc/ssl/pkcs12/{{ inventory_hostname }}.p12\n    password: "changeit"\n    owner: root\n    mode: 0600\n\n- name: Read private key\n  read_file:\n    path: /etc/ssl/private/{{ inventory_hostname }}.key\n  register: private_key\n\n- name: Read certificate\n  read_file:\n    path: /etc/ssl/certs/{{ inventory_hostname }}.crt\n  register: certificate\n\n- name: Create combined private_key and certificate file\n  ansible.builtin.file:\n    path: /etc/ssl/combined/{{ inventory_hostname }}.pem\n    content: "{{ private_key.content }}{{ certificate.content }}"\n    owner: root\n    mode: 0600\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-02T08:43:03.177266203Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14658463134, 'load_duration': 93299731, 'prompt_eval_count': 546, 'prompt_eval_duration': 240719413, 'eval_count': 891, 'eval_duration': 14322976367, 'model_name': 'deepseek-r1:14b'} id='run--323cd1dd-9b77-42cd-97e1-8cc5e7b9dbf1-0' usage_metadata={'input_tokens': 546, 'output_tokens': 891, 'total_tokens': 1437}
