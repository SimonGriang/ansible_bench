---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    username: "{{ vault_user }}"
    system: true
    home: disabled
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  get_url:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}/vault"
    mode: 0755
    owner: root
    group: root

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_exists

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_path_exists.stat.exists

- name: Create directories in vault_path
  loop: "{{ vault_directories }}"
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Create data directory
  loop: "{{ vault_data_directories }}"
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Generate TLS key and certificate
  command: |
    openssl req -x509 -newkey rsa:2048 -keyout {{ vault_data_directory }}/tls/vault.key
    -out {{ vault_data_directory }}/tls/vault.crt
    -days 1095 -nodes -subj "/C=US/ST=California/L=SanFrancisco/O=Vault/OU=Vault/CN=Vault"
  notify: Restart vault

- name: Set ownership of TLS files
  loop: "{{ vault_tls_files }}"
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: 0755
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    path: /usr/bin/vault
    cap: cap_ipc_lock=ep
    state: present
  changed_when: false

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: 0644
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755

- name: Copy Vault service file
  copy:
    src: templates/vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
  notify: Daemon reload
  when: ansible_service_manager == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers



