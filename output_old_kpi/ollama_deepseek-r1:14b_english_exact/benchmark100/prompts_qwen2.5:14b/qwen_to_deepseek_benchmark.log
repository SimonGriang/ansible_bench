 format, starting with \'---\', and make sure it\'s properly indented and valid for an Ansible Role.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  become: false\n  tags:\n    - assert\n\n- name: Install docker-compose package\n  apt:\n    name: docker-compose\n    state: present\n  when: installation_type == "package"\n  tags:\n    - docker-compose\n\n- name: Install docker-compose as a binary\n  when: installation_type == "binary"\n  become: true\n  steps:\n    - name: Check if docker-compose is already installed\n      command: docker-compose --version\n      ignore_errors: true\n    - name: Install required packages\n      apt:\n        name: "{{ item }}"\n        state: present\n      loop: [\'docker.io\', \'docker-compose\']\n    - name: Download docker-compose binary\n      get_url:\n        url: "https://github.com/docker/compose/releases/download/v{{ docker-compose_version }}/docker-compose-{{ ansible_system }}.tar.gz"\n        dest: /usr/local/bin/docker-compose\n        mode: \'0755\'\n        force: yes\n    - name: Extract and install docker-compose\n      command: /usr/local/bin/docker-compose\n      changed_when: false\n  tags:\n    - docker-compose\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-02T07:18:21.754981713Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12602653682, 'load_duration': 2784766293, 'prompt_eval_count': 369, 'prompt_eval_duration': 313459626, 'eval_count': 690, 'eval_duration': 9503106997, 'model_name': 'deepseek-r1:14b'} id='run--2dfaaac0-754d-4540-874c-3fac030ee1c2-0' usage_metadata={'input_tokens': 369, 'output_tokens': 690, 'total_tokens': 1059}
