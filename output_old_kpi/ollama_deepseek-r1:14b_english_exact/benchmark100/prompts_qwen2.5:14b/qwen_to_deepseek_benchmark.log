---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  apt:
    name: "{{ cron_packages }}"
    state: present
  become: true

- name: Configure shell
  cron:
    name: "@reboot"
    shell: "{{ shell_path }}"
    state: present
  notify: restart_cron

- name: Configure path
  cron:
    name: "@reboot"
    path: "{{ path }}"
    state: present
  notify: restart_cron

- name: Configure mailto
  cron:
    name: "@reboot"
    mailto: "{{ mailto_address }}"
    state: present
  notify: restart_cron

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service | bool

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    schedule: "{{ item.schedule }}"
    state: "{{ item.state }}"
  loop: cron_jobs

handlers:
  - name: restart_cron
    command: systemctl restart cron


