- name: Import assert.yml
  import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  shell: dnf enable redis:{{ redis_version }}
  changed_when: false

- name: Install redis
  dnf:
    name: "{{ redis_packages }}"
