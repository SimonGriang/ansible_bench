---
- name: Import assert.yml
  import_tasks:
    path: assert.yml
  args:
    only_once: true
  run_once: true
  host: localhost

- name: Install php
  become: true
  yum:
    name: "{{ php_packages }}"
    state: installed

- name: Find used php.ini
  shell: php --ini
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.php_ini_location) }}"
    owner: root
    group: root
    mode: 0644
  notify: httpd_restart


