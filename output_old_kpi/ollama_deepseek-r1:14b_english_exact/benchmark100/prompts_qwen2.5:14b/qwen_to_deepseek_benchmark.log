    wait: yes
    timeout: 100
    interval: 15
  delegate_to: "{{ active_server | default(first_server_in_group)}}"

- name: Wait for all pods to be ready again
  kubernetes.core.wait_for_pods:
    state: present
    wait: yes
    timeout: 100
    interval: 15
  delegate_to: "{{ active_server | default(first_server_in_group)}}"



