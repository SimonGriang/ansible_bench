    db: user
    key: "{{ user_name }}"
    state: present

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "{{ git_config_dir }}"
    state: directory
    mode: 0755
  when: user_exists and git_config_dir is defined

- name: Place git configuration
  ansible.builtin.template:
    src: "{{ git_config_template | default('git_config.j2') }}"
    dest: "{{ user_home }}/.gitconfig"
    mode: 0644
  when: user_exists and git_config_dir is defined and git_config_template is defined

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ repository_destination }}"
    state: directory
    mode: 0755
  when: repository_destination is defined and user_exists

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ repo_url }}"
    dest: "{{ repository_destination }}"
    branch: "{{ repo_branch | default('main') }}"
    depth: "{{ repo_depth | default('1') }}"
  when: git Repositories are defined and user_exists
  become: yes
  become_user: git



