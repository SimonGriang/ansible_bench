---
- name: Ensure the unzip package is available on the target system
  become: yes
  apt:
    name: unzip
    state: present
    update_cache: yes
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - ansible_distribution_major_version | int >= '2004'

- name: Install unzip via yum
  become: yes
  yum:
    name: unzip
    state: present
  when:
    - ansible_distribution not in ['Debian', 'Ubuntu']

- name: Create a system group for promtail
  become: yes
  group:
    name: promtail
    system: yes
    state: present

- name: Create a system user for promtail
  become: yes
  user:
    name: promtail
    system: yes
    group: promtail
    state: present

- name: Ensure the /usr/local/bin directory exists
  become: yes
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  become: yes
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  loop:
    - /etc/promtail
    - /var/log/promtail

- name: Create application directories
  become: yes
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  loop:
    - /usr/local/bin/promtail
    - /usr/local/share/promtail

- name: Check if the promtail binary exists
  become: yes
  command: ls /usr/local/bin/promtail
  ignore_errors: yes
  changed_when: false

- name: Download promtail binaries
  become: yes
  get_url:
    url: "https://example.com/promtail/{{ ansible_distribution }}/latest.zip"
    dest: /usr/local/bin/promtail-latest.zip
  when:
    - promtail_binary_exists is not succeeded
    - promtail_archive_local is false

- name: Propagate locally distributed promtail archive
  become: yes
  copy:
    src: /path/to/local/promtail.zip
    dest: /usr/local/bin/promtail-latest.zip
  when:
    - promtail_binary_exists is not succeeded
    - promtail_archive_local is true

- name: Download promtail binaries to controller node
  become: yes
  get_url:
    url: "https://example.com/promtail/{{ ansible_distribution }}/latest.zip"
    dest: /usr/local/bin/promtail-latest.zip
  when:
    - promtail_binary_exists is not succeeded
    - promtail_binaries_propagated is true

- name: Propagate promtail binaries
  become: yes
  copy:
    src: /path/to/promtail-latest.zip
    dest: /usr/local/bin/
  when:
    - promtail_binaries_propagated is true

- name: Unpack promtail binaries
  become: yes
  unzip:
    src: /usr/local/bin/promtail-latest.zip
    dest: /usr/local/bin/promtail
    mode: '0755'
    ignore_errors: yes
    checksum: yes

- name: Create symlink to latest version
  become: yes
  link:
    path: /usr/local/bin/promtail
    target: /usr/local/bin/promtail/latest
    state: present
  notify: promtail-restart

- name: Write configuration
  become: yes
  template:
    src: promtail.conf.j2
    dest: /etc/promtail/promtail.conf
    mode: '0644'
    owner: promtail
    group: promtail
  notify: promtail-restart

- name: Create systemd service unit
  become: yes
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  notify: promtail-restart



