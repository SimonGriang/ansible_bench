---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  run_once: yes
  host: localhost

- name: Install requirements
  apt:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install pip packages
  pip:
    name: "{{ item }}"
    state: present
  when: openssl_pip_packages is not empty
  with_items: "{{ openssl_pip_packages }}"

- name: Create key directory
  file:
    state: directory
    path: "{{ openssl_key_directory }}"
    mode: 700
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create csr directory
  file:
    state: directory
    path: "{{ openssl_csr_directory }}"
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create crt directory
  file:
    state: directory
    path: "{{ openssl_crt_directory }}"
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml
  import_tasks: create.yml
  loop: "{{ openssl_items }}"
  when: openssl_items is defined and not empty


