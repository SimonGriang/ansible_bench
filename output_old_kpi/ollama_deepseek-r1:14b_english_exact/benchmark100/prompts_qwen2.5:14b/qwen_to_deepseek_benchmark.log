---
- name: Populate services facts
  ansible.builtin.gathering_facts:
    gather_subset:
      - services

- name: Set the Active Server variable
  ansible.builtin.set_fact:
    active_server: "{% for host in groups['rke2_cluster_group_name'] %}{{ host }}{% endfor %}"
  loop: "{{ groups['rke2_cluster_group_name'] | default([]) }}"
  when:
    - "'rke2_servers_group_name' in groups"
    - "item in groups['rke2_servers_group_name']"
  register: active_server_fact

- name: Ensure rke2-server.service is running
  ansible.builtin.command:
    cmd: systemctl status rke2-server.service
    check_connection: yes
    changed_when: false
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_cluster_group_name'] | default([]) }}"
  when:
    - "'rke2_servers_group_name' in groups"
    - "item in groups['rke2_servers_group_name']"
  register: service_status
  ignore_errors: yes

- name: Set active server fact
  ansible.builtin.set_fact:
    active_server: "{{ hostvars[service_status.results[0].host].ansible_hostname }}"
  when:
    - "'rke2_servers_group_name' in groups"
    - "service_status.results[0].rc == 0"
  delegate_to: "{{ service_status.results[0].host }}"



