 their respective modules and conditions. I\'ll use the correct variable names and ensure the playbook starts with \'---\' and is valid for Ansible\'s standards.\n</think>\n\n```yaml\n---\n- name: Download RKE2 kubeconfig to localhost\n  ansible.posix.fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    flat: yes\n  when:\n    - rke2_download_kubeconf\n    - inventory_hostname == first_host_in_rke2_servers_group_name\n\n- name: Replace loopback IP by master server IP\n  ansible.posix.replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    remote_src: true\n    patterns:\n      - 127.0.0.1\n      - ::1\n    replace: "{{ master_ip }}"\n  when:\n    - notansible_check_mode\n    - rke2_download_kubeconf\n    - inventory_hostname == first_host_in_rke2_servers_group_name\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-02T10:03:31.822970881Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13925062148, 'load_duration': 78404916, 'prompt_eval_count': 529, 'prompt_eval_duration': 324584197, 'eval_count': 693, 'eval_duration': 13520950586, 'model_name': 'deepseek-r1:14b'} id='run--6531c4fd-c30f-480c-8209-6ab05015655c-0' usage_metadata={'input_tokens': 529, 'output_tokens': 693, 'total_tokens': 1222}
