emote_src: /etc/openvpn/easy-rsa/pki\n    dest: /etc/openvpn/\n    files:\n      - ca.crt\n      - dh.pem\n      - crl.pem\n  file_mode: yes\n  dir_mode: 0755\n\n- name: Place server configuration file\n  template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server.conf\n    mode: 0644\n  notify: restart_openvpn\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-02T08:35:55.551826657Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24842155053, 'load_duration': 92417955, 'prompt_eval_count': 1774, 'prompt_eval_duration': 955263410, 'eval_count': 1208, 'eval_duration': 23793859753, 'model_name': 'deepseek-r1:14b'} id='run--c58847de-77f1-437f-99ae-32860d500aa1-0' usage_metadata={'input_tokens': 1774, 'output_tokens': 1208, 'total_tokens': 2982}
