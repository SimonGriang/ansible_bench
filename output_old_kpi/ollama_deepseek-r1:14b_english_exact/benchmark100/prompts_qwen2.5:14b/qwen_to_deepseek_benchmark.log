---
- name: Import assert.yml
  import_tasks:
    file: files/assert.yml
    remote_host: localhost

- name: Configure apk
  become: true
  become_user: root
  apt:
    name: apk
    state: present
  shell: apk update && apk upgrade
  notify: reboot

- name: Configure apt
  become: true
  become_user: root
  apt:
    action: upgrade
    state: upgrade
  shell: apt autoremove --unused
  notify: reboot

- name: Update all software (dnf)
  become: true
  become_user: root
  dnf:
    name: '*'
    state: present
    exclude: ['kernel*']
  notify: reboot

- name: Update all software (pacman)
  become: true
  become_user: root
  pacman:
    name: '*'
    state: present
  notify: reboot

- name: Configure yum
  become: true
  become_user: root
  yum:
    name: yum
    state: present
    update_cache: true
  shell: yum install yum-utils -y
  notify: reboot

- name: Update all software (zypper)
  become: true
  become_user: root
  zypper:
    name: '*'
    state: present
  notify: reboot



