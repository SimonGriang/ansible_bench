---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: "No configuration"

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps
    - postfix_virtual_mailbox_domains
    - postix_virtual_alias_maps

- name: Configure postfix (transport_maps)
  template:
    src: transport.j2
    dest: /etc/postfix/transport
  notify: postfix_transport_map_handler

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify: postfix_header_checks_handler

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_smtpd_sasl_auth_enable: "{{ postfix_smtpd_sasl_auth_enable | default('yes') | lower | bool }}"
  
- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_smtpd_sasl_security_options: "{{ postfix_smtpd_sasl_security_options | default('none') }}"
    postfix_smtpd_sasl_tls_security_level: "{{ postfix_smtpd_sasl_tls_security_level | default('tls') }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: postfix_main_config_handler

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: postfix_master_config_handler

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
  with_items:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    owner: root
    group: postfix
  notify: postfix_reload

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    owner: root
    group: postfix
  notify: postfix_reload

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
  notify: postfix_alias_handler

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify: postfix_sender_handler

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify: postfix_recipient_handler

- name: Place sasl_password_map
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
  notify: postfix_sasl_handler

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes



