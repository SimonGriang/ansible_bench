---
- name: Ensure old versions of Docker are not installed
  dnf:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-client
    - docker-engine
    - docker-engine-selinux
    - containerd
    - runc

- name: Add Docker GPG key
  rpm_key:
    key: "https://download.docker.com/linux/centos/gpg"
    state: present

- name: Add Docker repository
  rpm_repository:
    name: "Docker"
    description: "Docker repository"
    baseurl: "https://download.docker.com/linux/centos/7/x86_64/stable"
    enabled: 1

- name: Configure Docker Nightly repo
  rpm_repository:
    name: "Docker Nightly"
    description: "Docker nightly repository"
    baseurl: "https://download.docker.com/linux/centos/7/x86_64/nightly"
    enabled: 1

- name: Configure Docker Test repo
  rpm_repository:
    name: "Docker Test"
    description: "Docker test repository"
    baseurl: "https://download.docker.com/linux/centos/7/x86_64/test"
    enabled: 1

- name: Configure containerd on RHEL 8
  dnf:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - container-selinux
    - containerd.io
  register: containerd_packages

- name: Ensure runc is not installed on RHEL 8
  dnf:
    name: runc
    state: absent



