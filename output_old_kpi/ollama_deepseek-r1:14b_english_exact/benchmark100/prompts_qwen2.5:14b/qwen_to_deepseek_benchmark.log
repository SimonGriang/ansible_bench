---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  apt:
    name: "{{ cron_packages }}"
    state: present
  when: cron_packages | bool

- name: Configure shell
  cron:
    name: "{{ cron_shell }}"
    type: "shell"
    value: "SHELL={{ cron_shell }}"
    state: present
    notify: Restart cron
  become: yes
  when: cron_shell | bool

- name: Configure path
  cron:
    name: "{{ cron_path }}"
    type: "path"
    value: "PATH={{ cron_path }}"
    state: present
    notify: Restart cron
  become: yes
  when: cron_path | bool

- name: Configure mailto
  cron:
    name: "{{ cron_mailto }}"
    type: "mailto"
    value: "MAILTO={{ cron_mailto }}"
    state: present
    notify: Restart cron
  become: yes
  when: cron_mailto | bool

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service | bool

- name: Schedule requested cron jobs
  cron_job:
    name: "{{ item.name }}"
    schedule: "{{ item.schedule | default('0 * * * *') }}"
    command: "{{ item.command }}"
    state: present
  loop: "{{ cron_jobs }}"
  when: cron_jobs | bool



