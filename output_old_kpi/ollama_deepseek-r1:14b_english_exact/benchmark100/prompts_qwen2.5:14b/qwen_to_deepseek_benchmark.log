---
- name: Create ssl key
  ssl_keygen:
    path: "/etc/ssl/private/{{ item.key }}.key"
    mode: '0640'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_certs }}"

- name: Create ssl csr
  ssl_csr:
    path: "/etc/ssl/csr/{{ item.csr }}.csr"
    mode: '0644'
    owner: 'root'
    group: 'root'
    cn: "{{ item.common_name }}"
  with_items: "{{ ssl_certs }}"

- name: Create ssl certificates
  ssl_cert:
    path: "/etc/ssl/certs/{{ item.certificate }}.crt"
    csr_path: "/etc/ssl/csr/{{ item.csr }}.csr"
    privateKey_path: "/etc/ssl/private/{{ item.key }}.key"
    mode: '0644'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_certs }}"

- name: Create PKCS#12 file
  pkcs12:
    path: "/etc/ssl/pkcs12/{{ item.pkcs12 }}.p12"
    cert: "/etc/ssl/certs/{{ item.certificate }}.crt"
    key: "/etc/ssl/private/{{ item.key }}.key"
    friendly_name: "{{ item.common_name }}"
    mode: '0640'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_certs }}"

- name: Read private key
  read_file:
    path: "/etc/ssl/private/{{ item.key }}.key"
  register: private_key_content
  with_items: "{{ ssl_certs }}"

- name: Read certificate
  read_file:
    path: "/etc/ssl/certs/{{ item.certificate }}.crt"
  register: certificate_content
  with_items: "{{ ssl_certs }}"

- name: Create combined private_key and certificate file
  combine:
    join: newline
    list: "{{ item.private_key_content | default('') }}{{ item.certificate_content | default('') }}"
  with_items: "{{ ssl_certs | map('fileglob', 'path=ssl_certs/*') | list }}"
  vars:
    item.private_key_content: "{{ private_key_content.results }}"
    item.certificate_content: "{{ certificate_content.results }}"
  create_file:
    path: "/etc/ssl/combined/{{ item.key }}.pem"
    content: "{{ item.result.stdout | default('') }}"
    mode: '0640'
    owner: 'root'
    group: 'root'



