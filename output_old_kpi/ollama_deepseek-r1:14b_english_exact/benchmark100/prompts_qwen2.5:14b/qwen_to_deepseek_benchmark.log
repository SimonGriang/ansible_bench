port_tasks: assert.yml\n\n- name: Install required packages\n  apt:\n    name: "{{ service_required_packages }}"\n    state: present\n  notify: Gather facts\n  become: yes\n\n- name: Configure systemd service\n  template:\n    src: systemd.j2\n    dest: /etc/systemd/system/{{ item.name }}.service\n    owner: root\n    group: root\n    mode: 0644\n  notify: Systemctl daemon-reload\n  become: yes\n  with_items: service_list\n  when: service_manager == \'systemd\'\n\n- name: Configure sysvinit service\n  file:\n    path: /etc/init.d/{{ item.name }}\n    src: sysvinit.j2\n    owner: root\n    group: root\n    mode: 0755\n  notify: Systemctl daemon-reload\n  become: yes\n  with_items: service_list\n  when: service_manager in [\'sysvinit\', \'upstart\', \'openrc\']\n\n- name: Manage service\n  systemd:\n    name: "{{ item.name }}"\n    state: "{{ item.state | default(\'started\') }}"\n    enabled: "{{ item.enabled | default(\'yes\') }}"\n  notify: Systemctl daemon-reload\n  become: yes\n  with_items: service_list\n  when: service_manager == \'systemd\'\n\n- name: Flush handlers\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-02T07:43:41.451266652Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13463176077, 'load_duration': 87935091, 'prompt_eval_count': 526, 'prompt_eval_duration': 277747920, 'eval_count': 704, 'eval_duration': 13096301324, 'model_name': 'deepseek-r1:14b'} id='run--940e2884-61c9-440c-a26b-b76c20e90dc1-0' usage_metadata={'input_tokens': 526, 'output_tokens': 704, 'total_tokens': 1230}
