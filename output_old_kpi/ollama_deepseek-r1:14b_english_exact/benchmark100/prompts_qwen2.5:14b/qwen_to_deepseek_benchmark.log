---
- name: lookup bootstrap facts (raw)
  command:
    cmd: cat /etc/os-release
  register: bootstrap_raw_facts

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: >
      {{ bootstrap_raw_facts.stdout | regex_replace('^[^"]*"[^"]*"\n', '') | 
         regex_replace('^VERSION_ID=.*"\n', '') | 
         regex_replace('^ID=.*"\n', '') | 
         split(' ') | 
         first }}
    bootstrap_major_version: >
      {{ bootstrap_raw_facts.stdout | regex_replace('^[^"]*"[^"]*"\n', '') | 
         regex_replace('^VERSION_ID=.*"\n', '') | 
         regex_replace('^ID=.*"\n', '') | 
         split(' ') | 
         last }}

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: >
      {{ lookup('vars', 'bootstrap__os_family_map') | 
         selectattr('distribution', 'eq', bootstrap_distribution) | 
         first | 
         attr('family') }}



