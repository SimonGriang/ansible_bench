---
- name: Check if certificates exist
  java_cert:
    certificate: "{{ item }}"
    state: present
    validate_certs: no
  loop: "{{ java_certs }}"
  register: cert_status

- name: Fail if some certificate doesn't exist
  fail:
    msg: "Certificate(s) not found: {{ missing_certs | join(', ') }}"
  when: cert_status.results | selectattr('failed') | list | count > 0

- name: Setting keystore variables in java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_open_jdk_version_major < 11

- name: Setting keystore variables in java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_open_jdk_version_major >= 11

- name: Import SSL certificates
  java_cert:
    certificate: "{{ item.cert }}"
    alias: "{{ item.alias | default('default') }}"
    keystore_path: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    action: import
    state: present
    validate_certs: no
  loop: "{{ java_certs }}"



