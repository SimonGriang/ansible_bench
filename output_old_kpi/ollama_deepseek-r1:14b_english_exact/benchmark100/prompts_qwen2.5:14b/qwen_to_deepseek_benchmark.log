---
- name: hardening | Disable swap
  ansible.builtin.set_fact:
    vault_hardening_swap_disabled: true
  when: vault_hardening_disable_swap
  register: swap_disabled

- name: hardening | Disable swap now
  ansible.builtin.command:
    cmd: swapoff -a
  when: ansible_facts.vault_hardening_swap_disabled
  ignore_errors: yes

- name: hardening | Disable swap permanently
  ansible.builtin.file:
    path: /etc/fstab
    state: present
    content: |
      # swap was disabled
      # swapUUID=swapTYPE none swap defaults 0 0
    append: yes
  when: vault_hardening_disable_swap | bool()

- name: hardening | Disable core dumps
  ansible.builtin.sysctl:
    name: fs.suid_dumpable
    value: 0
    state: present
    reload: yes
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable core dumps (sysctl)
  ansible.builtin.sysctl:
    name: kernel.coredumpctl
    value: 'never'
    state: present
    reload: yes
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  ansible.builtin.file:
    path: /etc/profile.d/disable_history.sh
    state: present
    content: |
      #!/bin/bash
      export HISTCONTROL="ignoreboth:erasedups"
  when: vault_hardening_disable_shell_command_history | bool()

- name: hardening | Configure SELinux / AppArmor
  ansible.builtin.set_fact:
    vault_selinux_configured: true
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Enable SELinux
  ansible.builtin.yum:
    name: selinux-policy
    state: present
  when: vault_selinux_configured | bool()

- name: hardening | Install selinux-policy
  ansible.builtin.apt:
    name: selinux-policy
    state: present
  when: not (ansible_distribution_facts.packages.selinux-policy | exists)
         and vault_selinux_configured | bool()

- name: hardening | Set SELinux policy
  ansible.builtin.command:
    cmd: setenforce 1
  when: vault_selinux_configured | bool()

- name: hardening | Enable AppArmor (enforcing)
  ansible.builtin.command:
    cmd: aa-enabled
  when: vault_hardening_configure_selinux_apparmor



