---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  state: present

- name: Wait for port to be available
  wait_for_port:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started

- name: Prepare system
  raw:
    cmd: echo "Testing connection and sudo access"
  become: true
  become_method: sudo
  ignore_errors: true

- name: Gather additional facts on preparation failure
  setup:
    gather_subset: all
  rescue: true
  when: prepare_system failed

- name: Install bootstrap packages (raw)
  raw:
    cmd: "{{ 'apt-get update && apt-get install -y' if os_family == 'Debian' else 'yum install -y' | \
           'zypper refresh && zypper install -y' if os_family == 'SUSE' else 'dnf install -y' }}"
  become: true
  become_method: sudo
  ignore_errors: true

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  when: os_family in ['Fedora', 'RedHat']

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: true
  become: true
  become_method: sudo



