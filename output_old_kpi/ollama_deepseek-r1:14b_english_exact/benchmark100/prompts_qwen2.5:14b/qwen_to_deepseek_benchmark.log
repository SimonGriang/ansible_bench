---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  kubernetes.core.wait_for_nodes:
    state: present
    wait: true
    timeout: 100
    interval: 15
  delegate_to: "{{ active_server | default(first_server_in_group) }}"

- name: Wait for all pods to be ready again
  kubernetes.core.wait_for_pods:
    state: present
    wait: true
    timeout: 100
    interval: 15
  delegate_to: "{{ active_server | default(first_server_in_group) }}"


