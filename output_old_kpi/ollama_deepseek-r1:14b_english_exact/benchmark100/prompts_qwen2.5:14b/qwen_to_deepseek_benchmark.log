ks\' descriptions. By following these steps, the playbook should meet all the user\'s requirements and fit seamlessly into an Ansible Role under the tasks directory.\n</think>\n\n```yaml\n---\n- name: Ensure document root directories are created for each virtual host\n  file:\n    path: "{{ item.document_root }}"\n    state: directory\n    mode: \'0755\'\n  loop: "{{ httpd_vhosts | default([]) | list }}"\n  when:\n    - item.document_root is defined\n    - item.create_docroot | default(True) | bool\n  changed_when: false\n\n- name: Create virtual host configuration files\n  template:\n    src: vhost_conf_template\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    group: root\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts | default([]) | list }}"\n  notify:\n    - Test Apache configuration\n    - Restart Apache\n  changed_when: false\n\n- name: Enable virtual hosts on Debian-based systems\n  command: a2ensite "{{ item.name }}"\n  loop: "{{ httpd_vhosts | default([]) | list }}"\n  when:\n    ansible_os_family == \'Debian\'\n  args:\n    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n  notify:\n    - Test Apache configuration\n    - Restart Apache\n  changed_when: false\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-02T08:59:59.186004575Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11081929059, 'load_duration': 93034185, 'prompt_eval_count': 476, 'prompt_eval_duration': 106261863, 'eval_count': 707, 'eval_duration': 10881604528, 'model_name': 'deepseek-r1:14b'} id='run--583a45b8-d702-4214-9f3b-0a922da2068f-0' usage_metadata={'input_tokens': 476, 'output_tokens': 707, 'total_tokens': 1183}
