---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: kubectl cordon {{ rke2_node_name }} && kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-emptydir-volumes=false --{{ rke2_drain_additional_args }}
  args:
    chdir: "{{ rke2_data_path }}"
  register: drain_output
  until: drain_output.results | json_query('[].stderr' ) | join() | contains("node problem")
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
    restart: force-reload
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl_wait:
    resource: nodes
    state: present
    timeout: 60s
    wait_for: status.phase=Ready
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  shell: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubectl_wait:
    resource: pods
    state: present
    timeout: 60s
    wait_for: status.phase in [Running,Succeeded]
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubectl_wait:
    resource: pods
    state: present
    timeout: 60s
    wait_for: status.conditions.ready=TRUE
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy



