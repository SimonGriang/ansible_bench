---
- name: cadvisor | create directories
  file:
    path: /opt/cadvisor
    state: directory
    mode: '755'

- name: cadvisor | download
  apt:
    update_cache: yes
    state: present
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3
  apt:
    name: wget
    state: present
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3
  shell: wget --no-check-certificate --directory /opt/cadvisor https://github.com/google/cadvisor/releases/download/v{{ cadvisor_version }}/cadvisor-linux-amd64
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /path/to/local/cadvisor
    dest: /opt/cadvisor
    remote_src: yes
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3
  notify: restart cadvisor service

- name: cadvisor | symlink
  ln:
    src: /opt/cadvisor/cadvisor-linux-amd64
    dest: /usr/local/bin/cadvisor
    state: symlink
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: 755
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: test_task
  service:
    name: cadvisor
    state: started
    enable: yes
  register: service_active
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  shell: systemctl enable cadvisor
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: cadvisor | start server systemd
  shell: systemctl start cadvisor && systemctl status cadvisor
  become: true
  become_method: sudo
  become_flags: -H
  vars:
    ansible_python_interpreter: /usr/bin/python3



