---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: "0755"
    timeout: "{{ rke2_download_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: "0700"
    force: yes
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: "0700"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode != "download"
    - rke2_airgap_implementation != "download"

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ item.url }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
    timeout: "{{ rke2_download_timeout }}"
  loop:
    - {url: "{{ rke2_checksum_url }}", dest: "{{ rke2_checksum_path }}", mode: "0644"}
    - {url: "{{ rke2_artifacts_url }}", dest: "{{ rke2_artifacts_path }}/rke2.tar.gz", mode: "0644"}
    - {url: "{{ rke2_install_script_url }}", dest: "{{ rke2_install_script_path }}", mode: "0755"}
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

- name: Rescue for failed download
  become: yes
  ansible.builtin.shell:
    cmd: mkdir -p "{{ rke2_artifacts_path }}" && wget "{{ rke2_artifacts_url }}" -O "{{ rke2_artifacts_path }}/rke2.tar.gz"
  ignore_errors: yes
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

