---
- name: Create document root directories for each virtual host
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: "{{ create_docroot_mode | default('omit') }}"
  loop: "{{ httpd_vhosts | default([]) }}"
  vars:
    create_docroot_mode: "{{ (item.create_docroot | default('true')) | ternary('0755', 'omit') }}"

- name: Configure virtual hosts using a template
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    vars:
      vhost: "{{ item }}"
  loop: "{{ httpd_vhosts | default([]) }}"
  loop_var: item

- name: Test httpd configuration
  ansible.builtin.command:
    cmd: /usr/sbin/apachectl configtest
    changed_when: false

- name: Restart httpd service
  ansible.builtin.service:
    name: httpd
    state: restarted



