---
- name: Check if python is installed
  command: which python
  args:
    executable: /usr/bin/python
  ignore_errors: yes

- name: Check if python3 is installed
  command: which python3
  args:
    executable: /usr/bin/python3
  ignore_errors: yes

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ (ansible_python.path | default('python not found')) }}"

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ (ansible_python3.path | default('python3 not found')) }}"

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  apt:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
    requirements: "{{ ansible_dir }}/requirements.txt"

- name: Create key directory
  file:
    path: /etc/ssl/private
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Create csr directory
  file:
    path: /etc/ssl/csr
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Create crt directory
  file:
    path: /etc/ssl/crt
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Include create.yml
  include_tasks: create.yml



