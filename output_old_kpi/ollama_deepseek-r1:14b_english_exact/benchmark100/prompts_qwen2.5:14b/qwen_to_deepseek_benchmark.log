---
- name: Check if the system is EFI
  command: stat /sys/firmware/efi/efivars
  changed_when: false
  register: efi_firmware
  ignore_errors: yes

- name: Remove the grub.cfg file if the system is EFI
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_firmware is not None

- name: Install a user template for GRUB
  template:
    src: /path/to/template
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: 0700
  notify: update_grub

- name: Add a password to the EFI GRUB configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: GRUB_USER_PASSWORD="your_password"
    create: yes
  notify: update_grub

- name: Add a password to the MBR GRUB configuration
  lineinfile:
    path: /etc/grub2.cfg
    line: GRUB_USER_PASSWORD="your_password"
    create: yes
  notify: update_grub

- name: Add --unrestricted option to specified files
  lineinfile:
    path: "{{ item }}"
    line: "CLASS=\"{{ class }} --unrestricted\""
    regex: CLASS=".*"
  with_items: "{{ grub_password_unrestricted_files | default([]) }}"
  notify: update_grub
  when: grub_password_unrestricted | default(false)



