---
- name: Import assert.yml
  import_tasks: files/assert.yml

- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  become:
    become_user: root
  apt:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  become:
    become_user: root
  rpm:
    name: "{{ java_rpm }}"
    state: present
    force: yes

- name: Install DEB
  become:
    become_user: root
  deb:
    name: "{{ java_deb }}"
    state: present
    force: yes

- name: Install oracle java (rpm) (repository)
  become:
    become_user: root
  apt:
    name: oracle-java
    state: present
    repo: "{{ oracle_java_repo }}"

- name: Configure oracle targz
  become:
    become_user: root
  unzip:
    name: "{{ oracle_targz }}"
    state: present
    remote_src: yes
    dest: "{{ oracle_targz_dest }}"
    creates: "{{ oracle_targz_dest }}/jdk1.8.0_{{ java_version }}"
  
  file:
    path: "{{ oracle_targz_dest }}"
    state: directory

- name: Install oracle java policy software (targz)
  become:
    become_user: root
  unzip:
    name: "{{ java_policy_targz }}"
    state: present
    remote_src: yes
    dest: "{{ java_policy_targz_dest }}"

- name: Set alternative (targz)
  become:
    become_user: root
  alternatives:
    name: java
    path: "{{ oracle_targz_dest }}/jdk1.8.0_{{ java_version }}/bin/java"
    state: present
    priority: 100
  when: ansible_distribution != "Alpine"

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  become:
    become_user: root
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME={{ java_home_result.stdout }}"
    state: present



