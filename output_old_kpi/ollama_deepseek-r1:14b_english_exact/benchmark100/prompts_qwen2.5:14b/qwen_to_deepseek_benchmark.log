---
- name: Load OS-specific vars
  include_vars:
    name: "{{ ansible_os_family }}"
    file: "vars/os-family/{{ ansible_os_family }}.yml"
  when: ansible_os_family is defined

- name: Include RedHat-specific setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: Include Debian-specific setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages (apt)
  apt:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  when: ansible_version < "2.12" or ansible_os_family in ['RedHat', 'Debian']
  ignore_errors: true

- name: Install Docker packages (yum)
  yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  when: ansible_version < "2.12" or ansible_os_family in ['RedHat', 'Debian']
  notify: restart docker
  ignore_errors: true

- name: Install Docker packages (with downgrade option)
  apt:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    force: true
  when: ansible_version >= "2.12" and ansible_os_family in ['RedHat', 'Debian']

- name: Install Docker packages (yum with downgrade)
  yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    force: true
  when: ansible_version >= "2.12" and ansible_os_family in ['RedHat', 'Debian']
  notify: restart docker

- name: Install docker-compose plugin (apt)
  apt:
    name: docker-compose-plugin
    state: present
  when: docker_install_compose_plugin and (ansible_version < "2.12" or ansible_os_family not in ['RedHat', 'Debian'])

- name: Install docker-compose plugin (yum)
  yum:
    name: docker-compose-plugin
    state: present
  when: docker_install_compose_plugin and (ansible_version < "2.12" or ansible_os_family not in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin (with downgrade option)
  apt:
    name: docker-compose-plugin
    state: present
    force: true
  when: docker_install_compose_plugin and (ansible_version >= "2.12" and ansible_os_family in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin (yum with downgrade)
  yum:
    name: docker-compose-plugin
    state: present
    force: true
  when: docker_install_compose_plugin and (ansible_version >= "2.12" and ansible_os_family in ['RedHat', 'Debian'])
  notify: restart docker

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    mode: "{{ docker_daemon_options_mode | default('0755') }}"
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_yaml }}"
    dest: /etc/docker/daemon.json
    mode: "{{ docker_daemon_options_mode | default('0644') }}"
  when: docker_daemon_options is defined
  notify: restart docker

- name: Ensure Docker is started and enabled at boot
  systemd:
    name: docker
    state: started
    enabled: "{{ docker_service_enabled | default('yes') }}"
    mode: "{{ docker_service_mode | default('true') }}"
  when: docker_service_state == 'started'
  ignore_errors: true

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta:
    flush_handlers: true

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    group: docker

- name: Check if there are any users to add to the docker group
  set_fact:
    has_docker_users: "{{ (docker_users | default([]) | list | selectattr('user') | list | count) > 0 }}"

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: has_docker_users



