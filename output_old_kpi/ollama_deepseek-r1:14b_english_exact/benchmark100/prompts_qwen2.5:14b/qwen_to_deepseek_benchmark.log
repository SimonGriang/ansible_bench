---
- name: Update apt cache
  ansible.builtin.apt:
    state: present
  changed_when: false

- name: Update dnf cache
  ansible.builtin.dnf:
    state: present

- name: Install packages
  ansible.builtin.apt:
    name: keepalived
    state: present
  become: true
  when: ansible_os_family == 'Debian'

- name: Install packages
  ansible.builtin.yum:
    name: keepalived
    state: present
  become: true
  when: ansible_os_family == 'RedHat'

- name: Create directory for keepalived
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    mode: "0755"

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.template:
    src: k8s_api_debian.sh.j2
    dest: /etc/keepalived/k8s_api_check.sh
    mode: "0755"
  notify: restart_keepalived
  when: ansible_os_family == 'Debian'

- name: Create Kubernetes API health check script for RedHat OS family
  ansible.builtin.template:
    src: k8s_api_redhat.sh.j2
    dest: /etc/keepalived/k8s_api_check.sh
    mode: "0755"
  notify: restart_keepalived
  when: ansible_os_family == 'RedHat'

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.template:
    src: rke2_server_debian.sh.j2
    dest: /etc/keepalived/rke2_server_check.sh
    mode: "0755"
  notify: restart_keepalived
  when: ansible_os_family == 'Debian'

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.template:
    src: rke2_server_redhat.sh.j2
    dest: /etc/keepalived/rke2_server_check.sh
    mode: "0755"
  notify: restart_keepalived
  when: ansible_os_family == 'RedHat'

- name: Create keepalived config file
  ansible.builtin.template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    mode: "0644"
  notify: restart_keepalived

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.service:
    name: keepalived
    state: started
    enabled: true
  become: true
  notify: restart_keepalived

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true



