Task 6: Install requested modules
Description Task 6: Install Python modules specified in the python_pip_modules variable. This task uses a loop to iterate over the list of modules and installs them based on the state and version defined for each module. This task runs only if the distribution release is not bookworm or noble, and the os family is not Alpine.


- Last generated (faulty) playbook: 
---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  apt:
    name: python-pip
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    state: present
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ item }}"
    state: present
  loop: "{{ python_pip_trusted_host | default([]) | list }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when:
    - python_pip_update | default(false)
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family not in ['Alpine']

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ python_pip_modules | default([]) | list }}"
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family not in ['Alpine']



