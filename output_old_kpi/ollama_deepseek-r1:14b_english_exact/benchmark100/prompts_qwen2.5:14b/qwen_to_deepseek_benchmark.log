---
- name: check if all variables have been set correctly
  ansible.builtin.assert:
    that: var1 is defined and var2 is defined
    fail_on_any: yes
  vars:
    var1: "{{ var1 | default('not_set') }}"
    var2: "{{ var2 | default('not_set') }}"

- name: wait for host (when configured)
  ansible.builtin.metadata:
    wait_for: true
  when: bootstrap_wait_for_host

- name: prepare system
  ansible.builtin.ansible:
    module_name: setup
    gather_facts: yes
  register: setup_result
  ignore_errors: yes
  changed_when: false

- name: include tasks to gather bootstrap facts (raw)
  ansible.builtin.include_tasks:
    file: tasks/bootstrap_facts_raw.yml

- name: install bootstrap packages (raw)
  ansible.builtin.raw:
    cmd: "{{ bootstrap_install.raw | default('echo no packages to install') }}"
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"

- name: ensure system is prepared by issuing ansible modules
  ansible.builtin.ansible:
    module_name: package
    args: "{{ packages_to_install | default([]) | json_query('[]') | join(' ') }}"
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"



