---
- name: Lookup bootstrap facts
  command:
    executable: cat
    args: /etc/os-release
  register: ansible_output
  changed_when: false

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ ansible_output.stdout | regex_replace('ID="','') | regex_replace('"','') }}"
    bootstrap_distribution_major_version: "{{ ansible_output.stdout | regex_replace('VERSION_ID="','') | regex_replace('"','') }}"
  changed_when: false

- name: Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution] }}"
  changed_when: false

vars:
  bootstrap_os_family_map:
    centos: redhat
    rhel: redhat
    fedora: redhat
    ubuntu: debian
    debian: debian
    amazon: amazon



