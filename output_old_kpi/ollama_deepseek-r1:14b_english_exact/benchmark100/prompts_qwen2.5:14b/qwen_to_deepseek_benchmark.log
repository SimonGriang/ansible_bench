---
- name: Import assert.yml
  import_playbook:
    file: assert.yml

- name: Wait for port to be available
  wait_for_port:
    port: "{{ port }}"
    host: "{{ ansible_hostname }}"
    timeout: "{{ bootstrap_timeout }}"
    delegate_to: localhost
    become: false
    tags: [always]

- name: Prepare system
  raw:
    cmd: which python
  changed_when: false
  ignore_errors: yes
  register: python_check

- name: Test sudo availability
  raw:
    cmd: sudo -n true
  changed_when: false
  ignore_errors: yes
  register: sudo_check

- name: Gather bootstrap facts
  setup:
    gather_subset: all
  when: python_check.rc != 0 or sudo_check.rc != 0

- name: Install necessary packages
  raw:
    cmd: apt-get update && apt-get install -y python sudo
  when: python_check.rc != 0 or sudo_check.rc != 0
  changed_when: false

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes



