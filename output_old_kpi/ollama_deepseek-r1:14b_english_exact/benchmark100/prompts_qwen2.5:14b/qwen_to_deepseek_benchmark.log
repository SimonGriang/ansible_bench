---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql_server.conf.j2
    dest: /etc/mysql/mysql.conf.d/mysqld.cnf
    owner: root
    group: root
    mode: 0644

- name: Configure mysql client
  template:
    src: mysql_client.conf.j2
    dest: /etc/mysql/mysql.conf.d/client.cnf
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  command: mysql_install_db
  become: yes
  become_user: mysql
  when:
    - ansible_distribution == 'alpine'
    - ansible_distribution == 'archlinux'

- name: Start mysql service
  service:
    name: mysql
    state: started

- name: Enable mysql service
  enable:
    name: mysql
    state: enabled

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    db_user: root
    db_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases | default([]) | list }}"

- name: List databases
  shell: "mysql -u root -p{{ mysql_root_password }} -e 'SHOW DATABASES;'"
  register: listed_databases

- name: Import database
  shell: |
    mysql -u root -p{{ mysql_root_password }}
    {{ item.database_name }}
    < {{ item.sql_file }}
  when: item.import_from is undefined
  loop: "{{ mysql_databases | default([]) | list }}"

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users | default([]) | list }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


