---
- name: Import assert.yml
  import_tasks:
    file: files/assert.yml
    remote_host: localhost

- name: Configure apk
  become: yes
  become_user: root
  apt:
    name: apk
    state: present
  shell: apk update && apk upgrade
  notify: reboot

- name: Configure apt
  become: yes
  become_user: root
  apt:
    name: apt
    state: present
  apt:
    action: upgrade
    state: upgrade
  shell: apt autoremove --unused
  notify: reboot

- name: Update all software (dnf)
  become: yes
  become_user: root
  dnf:
    name: '*'
    state: present
    exclude: kernel*
  notify: reboot

- name: Update all software (pacman)
  become: yes
  become_user: root
  pacman:
    name: '*'
    state: present
  notify: reboot

- name: Configure yum
  become: yes
  become_user: root
  yum:
    name: yum
    state: present
    update_cache: yes
  shell: yum install yum-utils -y
  notify: reboot

- name: Update all software (zypper)
  become: yes
  become_user: root
  zypper:
    name: '*'
    state: present
  notify: reboot



