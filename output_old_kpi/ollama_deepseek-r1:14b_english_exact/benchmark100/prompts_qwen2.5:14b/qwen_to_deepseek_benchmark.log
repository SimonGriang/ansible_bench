---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present
  when: git_packages is defined

- name: See if the specified user exists
  ansible.builtin.getent:
    database: user
    key: "{{ user_name }}"

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "{{ git_config_dir }}"
    state: directory
    mode: "01363"
  when: user_exists and git_config_dir is defined

- name: Place git configuration
  ansible.builtin.template:
    src: "{{ git_config_template | default('git_config.j2') }}"
    dest: "{{ user_home }}/.gitconfig"
    mode: "01204"
  when:
    - user_exists
    - git_config_dir is defined
    - git_config_template is defined

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ repository_destination }}"
    state: directory
    mode: "01363"
  when: repository_destination is defined and user_exists

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ repo_url }}"
    dest: "{{ repository_destination }}"
    branch: "{{ repo_branch | default('main') }}"
    depth: "{{ repo_depth | default('1') }}"
    state: present
  when:
    - git_repositories is defined
    - user_exists
  become: true
  become_user: git



