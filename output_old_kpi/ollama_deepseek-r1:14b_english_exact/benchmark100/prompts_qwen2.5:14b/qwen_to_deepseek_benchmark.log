  get_url:
    url: "{{ item.url }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
    timeout: "{{ rke2_download_timeout }}"
  loop:
    - { url: "{{ rke2_checksum_url }}", dest: "{{ rke2_checksum_path }}", mode: "0644" }
    - { url: "{{ rke2_artifacts_url }}", dest: "{{ rke2_artifacts_path }}/rke2.tar.gz", mode: "0644" }
    - { url: "{{ rke2_install_script_url }}", dest: "{{ rke2_install_script_path }}", mode: "0755" }
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

- name: Rescue for failed download
  become: yes
  ansible.builtin.shell:
    cmd: mkdir -p "{{ rke2_artifacts_path }}" && wget "{{ rke2_artifacts_url }}" -O "{{ rke2_artifacts_path }}/rke2.tar.gz"
  ignore_errors: yes
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_path }}"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
    mode: "0640"
    force: yes
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "copy"
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}/images"
    remote_src: yes
    mode: "0640"
    force: yes
  loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_copy_additional_tarballs | length > 0
    - rke2_airgap_implementation is not defined or rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item.path }}"
    state: file
    mode: "{{ item.mode }}"
  loop:
    - { path: "{{ rke2_artifacts_path }}", mode: "0700" }
    - { path: "{{ rke2_install_script_path }}", mode: "0755" }
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "exists"
    - rke2_airgap_implementation == "exists"

- name: Populate service facts
  setup:
    gather_subset: services

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  shell: grep -q '^/usr/local' /proc/mounts
  register: is_separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_install_script_path }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_version
  changed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | regex_replace('.*v=', '') | regex_replace(' .*', '') }}"
    rke2_running_version: "{{ ansible_check_mode | ternary('unknown', 'unknown') }}"

- name: Prevent accidental RKE2 downgrade
  shell: test -z "{{ rke2_installed_version }}" || test "{{ rke2_installed_version }}" -le "{{ rke2_running_version }}"
  when:
    - not ansible_check_mode
    - rke2_installed_version is defined
    - rke2_running_version is defined

- name: Run RKE2 install script
  shell: {{ rke2_bin_path }}/rke2 install {{ rke2_install_args }}
  when:
    - not ansible_check_mode
    - rke2_installed_version != rke2_running_version
    - rke2_airgap_mode is not defined or rke2_airgap_mode == "download"

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_path }}"
    dest: "{{ rke2_data_path }}/manifests"
    remote_src: yes
  when:
    - rke2_custom_manifests_path is defined
    - stat(rke2_custom_manifests_path).exists

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_path }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
    remote_src: yes
  when:
    - rke2_static_pods_path is defined
    - stat(rke2_static_pods_path).exists

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "/etc/rke2.env"
  when:
    - rke2_env_file is defined
    - stat(rke2_env_file).exists



