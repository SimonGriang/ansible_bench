- name: Configure mysql client
  ansible.builtin.template:
    src: "{{ mysql_configuration_source }}/{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf}"

- name: Initialize mysql
  ansible.builtin.shell:
    cmd: "{{ mysql_initialize_command }}"

- name: Start and enable mysql
  ansible.services.systemd:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.flush_handlers:

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0600

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ user }}"
    host: "{{ host }}"
    priv: "{{ privileges }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.flush_handlers:



