---
- name: Enable proxy modules in Apache
  ansible.builtin.apt:
    name: apache2-utils
    state: present
  notify: apache2handler

- name: Enable proxy modules in Apache
  ansible.builtin.template:
    src: proxy_modules.conf.j2
    dest: /etc/apache2/mods-enabled/proxy.conf
    mode: "0644"
  notify: apache2handler

- name: Enable proxy modules in Apache
  ansible.builtin.template:
    src: proxy_modules.conf.j2
    dest: /etc/apache2/mods-available/proxy_http.load
    mode: "0644"
  notify: apache2handler

- name: Configure Apache locations using a template
  ansible.builtin.template:
    src: apache_config.conf.j2
    dest: /etc/apache2/sites-available/myapp.conf
    mode: "0644"
  notify: apache2handler


