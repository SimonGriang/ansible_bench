---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  shell: 
    ls /usr/lib/python3.11/EXTERNALLY-MANAGED 2>/dev/null 
    | grep EXTERNALLY-MANAGED
  changed_when: false

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  shell: 
    mv /usr/lib/python3.11/EXTERNALLY-MANAGED 
    /usr/lib/python3.11/EXTERNALLY-MANAGED.old 2>/dev/null
  changed_when: false

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  shell: 
    ls /usr/lib/python3.12/EXTERNALLY-MANAGED 2>/dev/null 
    | grep EXTERNALLY-MANAGED
  changed_when: false

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  shell: 
    mv /usr/lib/python3.12/EXTERNALLY-MANAGED 
    /usr/lib/python3.12/EXTERNALLY-MANAGED.old 2>/dev/null
  changed_when: false

- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost
  become: no

- name: Install python pip
  apt:
    name: python3-pip
    state: present

- name: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_proxy is defined

- name: Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_trusted_host is not None

- name: Update pip
  pip:
    name: pip
    state: latest
    upgrade: true
  when: python_pip_update and (ansible_distribution not in ["bookworm", "noble", "Alpine"])

- name: Install requested modules
  pip:
    requirements: "{{ python_pip_modules | join(',') }}"
    state: present
  when: ansible_distribution not in ["bookworm", "noble", "Alpine"]



