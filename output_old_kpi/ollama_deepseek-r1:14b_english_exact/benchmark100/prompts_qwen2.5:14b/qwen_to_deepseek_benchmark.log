---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when:
    - ha_mode | bool
    - k8s_role == "server"

- name: Download and install RKE2
  apt:
    repo: "deb https://apt.rancher.com/rke2/ stable"
    state: present
    update_cache: yes
  when: k8s_version is not None

- name: CIS Hardening
  yum:
    name: "{{ item }}"
    state: present
    update_cache: yes
  when: cis_profile | bool
  with_items: "{{ cis_packages }}"

- name: Find Active Server
  command: kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[*].message}{if $index>0},{end}' | grep -i "ready"
  register: active_server
  when: k8s_cluster_info is not None

- name: Enable IPVS kernel module
  sysctl:
    name: net.netfilter.ipvs
    value: 1
    state: present
    reboot: false
  when:
    - kube_vip | bool
    - ha_mode | bool

- name: Copy kube-vip manifests to the masternode
  copy:
    remote_src: true
    src: /path/to/kube-vip/manifests/
    dest: /etc/kubernetes/manifests/
  when: kube_vip | bool

- name: Copy ingress-nginx manifests to the masternode
  copy:
    remote_src: true
    src: /path/to/ingress-nginx/manifests/
    dest: /etc/kubernetes/manifests/
  when: ingress_nginx_config | bool

- name: Prepare very first server node in the cluster
  command: rke2 CLI bootstrap
  when: first_node and k8s_version is not None

- name: Restore etcd specific tasks
  command: etcd-restore.sh
  when: etcd_restore | bool

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/kubeconfig
    dest: /path/to/kubeconfig
    flat: yes
  when: download_kubeconfig | bool

- name: Prepare and join remaining nodes of the cluster
  command: rke2 CLI join
  when: active_server | bool

- name: Rolling cordon and drain restart when version changes - servers
  command: rolling-restart.sh servers
  when: k8s_version changed | bool

- name: Rolling cordon and drain restart when version changes - agents
  command: rolling-restart.sh agents
  when: k8s_version changed | bool

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  command: systemctl restart rke2-node
  when: config_files_changed | bool

- name: Final steps
  command: |
    cleanup && reboot



