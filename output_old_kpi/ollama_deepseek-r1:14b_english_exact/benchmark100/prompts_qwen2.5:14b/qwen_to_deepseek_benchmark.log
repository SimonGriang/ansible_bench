---
- name: Check if Helm binary exists
  command: which helm
  args:
    executable: /usr/local/bin/helm
  register: helm_exists
  changed_when: false
  ignore_errors: yes

- name: Check Helm version
  command: helm version --short
  args:
    executable: /usr/local/bin/helm
  register: helm_version
  changed_when: false
  when: helm_exists.rc == 0

- name: Download helm
  apt:
    name: '{{ item }}'
    state: present
    update_cache: yes
  with_items:
    - apt-transport-https
    - ca-certificates
    - curl
  when: helm_exists.rc != 0 or (helm_version.stdout | version_compare('3.9.0', 'version', 'geq') | bool)

- name: Copy helm binary into place
  copy:
    remote_src: yes
    src: '{{ helm_DOWNLOAD_URL }}'
    dest: /usr/local/bin/helm
    mode: '0755'
  when: helm_exists.rc != 0 or (helm_version.stdout | version_compare('3.9.0', 'version', 'geq') | bool)
  become: yes



