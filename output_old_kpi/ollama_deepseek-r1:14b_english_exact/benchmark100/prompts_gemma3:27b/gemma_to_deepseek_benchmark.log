resent\n  when: python_pip_proxy is defined\n\n- name: Configure trusted hosts\n  lineinfile:\n    path: /etc/pip.conf\n    line: trusted-host = {{ python_pip_trusted_host }}\n    state: present\n  when: python_pip_trusted_host is defined\n\n- name: Update pip\n  pip:\n    name: pip\n    version: "{{ python_pip_pip_package }}"\n    state: "{{ python_pip_pip_state }}"\n  when:\n    - ansible_distribution == \'Debian\'\n    - ansible_distribution_version not in [\'bookworm\', \'noble\']\n    - ansible_distribution != \'Alpine\'\n\n- name: Install requested modules\n  pip:\n    name: "{{ item.name }}"\n    version: "{{ item.version | default(\'\') }}"\n    state: "{{ item.state | default(\'present\') }}"\n  loop: "{{ python_pip_modules }}"\n  label: "Install {{ item.name }}"\n  when:\n    - ansible_distribution == \'Debian\'\n    - ansible_distribution_version not in [\'bookworm\', \'noble\']\n    - ansible_distribution != \'Alpine\'\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T12:21:41.926109782Z', 'done': True, 'done_reason': 'stop', 'total_duration': 69069836833, 'load_duration': 93515215, 'prompt_eval_count': 1654, 'prompt_eval_duration': 300230331, 'eval_count': 2988, 'eval_duration': 68674221519, 'model_name': 'deepseek-r1:14b'} id='run--b7e34ca5-8d6f-4212-ba5f-9821e0ae278e-0' usage_metadata={'input_tokens': 1654, 'output_tokens': 2988, 'total_tokens': 4642} 26%|██▌       | 26/100 [1:03:05<3:27:06, 167.92s/it]
