---
- name: Create Vault group
  ansible.builtin.group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  ansible.builtin.user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: no

- name: Create Vault download directory
  ansible.builtin.file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Download Vault binary
  ansible.builtin.get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    dest: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    validate_certs: no
  ansible.builtin.unarchive:
    path: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    dest: "{{ vault_download_path }}"
    remote_src: yes

- name: Check if vault_path exists
  ansible.builtin.stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exists
  ansible.builtin.file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  when:
    - not vault_check_path.stat.exists
    - "{{ vault_path }}" != ""

- name: Create directory in vault_path
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  ansible.builtin.file:
    path: "{{ vault_data_directory }}/{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  ansible.builtin.command:
    cmd: openssl req -x509 -newkey rsa:2048 -keyout tls.key -out tls.crt -days 365 -sha256 -set_serial 0
    chdir: "{{ vault_data_directory }}/tls"
  notify: Restart vault

- name: Set ownership of tls material
  ansible.builtin.file:
    path: "{{ vault_data_directory }}/tls/{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  ansible.builtin.copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: 0755
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  ansible.builtin.setcap:
    path: /usr/bin/vault
    cap: cap_ipc_lock=ep
    state: present

- name: Touch vault.env
  ansible.builtin.file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    no_change: yes
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy Vault service file
  ansible.builtin.copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644
  notify: Daemon reload
  when:
    - ansible_system == "Linux"

- name: Copy vault configuration
  ansible.builtin.copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  ansible.builtin.handlers:
    name: all


