---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  ansible.builtin.template:
    src: grub_timeout.j2
    dest: /etc/default/grub
    owner: root
    group: root
    mode: 4120
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ansible.builtin.template:
    src: grub_recordfail_timeout.j2
    dest: /etc/default/grub
    owner: root
    group: root
    mode: 4120
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  when: grub_options is defined and length(grub_options) > 0
  loop: "{{ grub_options }}"
  loop_control:
    loop_var: option
  ansible.builtin.template:
    src: grub_cmdline_linux.j2
    dest: /etc/default/grub
    owner: root
    group: root
    mode: 4120
  notify: Update grub

- name: Import password.yml
  ansible.builtin.import_tasks: password.yml
  when: grub_set_password is true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


