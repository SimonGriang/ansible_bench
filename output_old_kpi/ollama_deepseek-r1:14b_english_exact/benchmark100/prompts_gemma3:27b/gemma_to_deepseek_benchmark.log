---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  args:
    run_once: true
  register: assert_result
  host: localhost

- name: Install php
  apt:
    name: "{{ php_packages }}"
    state: present
    update_cache: yes
    force_apt_get: yes

- name: Find used php.ini
  command: "{{ php_ini_command }}"
  no_log: true
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: 0644
  notify: Restart httpd


