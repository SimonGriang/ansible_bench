y parameters and tags.\n\nI should also make sure there are no comments or explanations, just the YAML content starting with \'---\' and followed by the tasks.\n</think>\n\n```yaml\n---\n- name: Run preflight checks\n  include_tasks: preflight.yml\n  tags: [promtail_install, promtail]\n\n- name: Install promtail\n  include_tasks: install.yml\n  become: true\n  tags: [promtail_install, promtail]\n\n- name: Start and enable promtail service\n  systemd:\n    name: "{{ promtail_systemd_service }}"\n    state: started\n    enabled: yes\n  become: true\n  tags: [promtail_run, promtail]\n  notify: systemctl reloaded\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T13:12:01.997841877Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12062201687, 'load_duration': 85462375, 'prompt_eval_count': 403, 'prompt_eval_duration': 132496348, 'eval_count': 603, 'eval_duration': 11842707075, 'model_name': 'deepseek-r1:14b'} id='run--eb6258d9-c6bb-4d88-b041-f56322a55576-0' usage_metadata={'input_tokens': 403, 'output_tokens': 603, 'total_tokens': 1006}
