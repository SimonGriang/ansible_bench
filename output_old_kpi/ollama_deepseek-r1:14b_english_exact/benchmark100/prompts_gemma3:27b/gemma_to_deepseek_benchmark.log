---
- name: Remove old Docker packages
  apt:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  when: "ansible_facts.packages | bool and docker_obsolete_packages | bool"
  tags:
    - docker
  become: true

- name: Remove old Docker packages (YUM based systems)
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  when: "ansible_facts.packages | bool and docker_obsolete_packages | bool and ansible_os_family == 'RedHat'"
  tags:
    - docker
  become: true

- name: Add Docker GPG key
  apt_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo | bool
  tags:
    - docker
  become: true
  become_user: root

- name: Add Docker GPG key (RHEL based systems)
  rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: "docker_add_repo | bool and ansible_os_family == 'RedHat'"
  tags:
    - docker
  become: true
  become_user: root

- name: Add Docker repository
  get_url:
    url: "{{ docker_yum_repo_url }}"
    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    mode: 0644
    remote_src: yes
  when: docker_add_repo | bool
  tags:
    - docker
  become: true
  become_user: root

- name: Set ownership and permissions for Docker repo file
  file:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    owner: "root"
    group: "root"
    mode: 0644
  when: docker_add_repo | bool
  tags:
    - docker
  become: true
  become_user: root

- name: Configure Docker Nightly repo
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    line: "enabled={{ docker_yum_repo_enable_nightly }}"
    state: present
    create: yes
  when: docker_add_repo | bool
  tags:
    - docker
  become: true
  become_user: root

- name: Configure Docker Test repo
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    line: "enabled={{ docker_yum_repo_enable_test }}"
    state: present
    create: yes
  when: docker_add_repo | bool
  tags:
    - docker
  become: true
  become_user: root

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is uninstalled
      apt:
        name: "runc"
        state: absent
      when: ansible_facts.distribution_major_version == 8
      tags:
        - containerd
      become: true

    - name: Ensure runc is uninstalled (YUM based systems)
      yum:
        name: "runc"
        state: absent
      when: "ansible_facts.distribution_major_version == 8 and ansible_os_family == 'RedHat'"
