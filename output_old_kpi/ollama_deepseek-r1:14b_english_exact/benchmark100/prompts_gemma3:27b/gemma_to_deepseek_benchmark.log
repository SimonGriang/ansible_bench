---
- name: Migrate from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}/{{ ansible_distribution_major_version }}.yml"
  tags: [variables]

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml
  tags: [variables]

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('8') }}"
    java_open_jdk_repository: "{{ java_open_jdk_repository | default('') }}"
    java_open_jdk_jce: "{{ java_open_jdk_jce | default('unlimited') }}"
  tags: [variables]

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk1') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-{{ java_open_jdk_version }}-jdk') }}"
  tags: [variables]

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Remove deprecated repositories (Debian)
  apt:
    name: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu"
  tags: [repos]

- name: Install extra apt tools (Debian)
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu"
  tags: [tools]

- name: Add required key repositories (Debian)
  apt_key:
    keyserver: keyserver.ubuntu.com
    key: "{{ item }}"
  loop: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu"
  tags: [repos]

- name: Add required repositories (Debian)
  apt_repository:
    repo: "deb {{ java_open_jdk_repository_ux }} {{ ansible_distribution_version }} main"
    state: present
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu"
  tags: [repos]

- name: Add required key repositories (RedHat)
  rpm_key:
    keyserver: keyserver.ubuntu.com
    key: "{{ item }}"
  loop: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_distribution == "redhat" or ansible_distribution == "centos"
  tags: [repos]

- name: Add required repositories (RedHat)
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk }}"
  when: ansible_distribution == "redhat" or ansible_distribution == "centos"
  tags: [repos]

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs_openjdk }}"
  tags: [libs]

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version }}"
    state: present
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu"
  tags: [java]

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version }}"
    state: present
  when: ansible_distribution == "redhat" or ansible_distribution == "centos"
  tags: [java]

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
  tags: [env]

- name: Source environment variables
  shell: source /etc/profile
  tags: [env]

- name: Correct java version selected (Debian, Java < 11)
  apt:
    name: java
    version: "{{ item }}"
    state: latest
    alias: '{{ item }}'
  loop: "{{ java_versions }}"
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu" and java_open_jdk_version|int < 11
  tags: [java]

- name: Correct java version selected (Debian, Java >= 11)
  apt:
    name: java
    version: "{{ item }}"
    state: latest
    alias: '{{ item }}'
  loop: "{{ java_versions }}"
  when: ansible_distribution == "debian" or ansible_distribution == "ubuntu" and java_open_jdk_version|int >= 11
  tags: [java]


