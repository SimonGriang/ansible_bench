ions, just the YAML structure. I\'ll double-check the syntax to comply with yamllint and ansible-lint standards.\n\nFinally, I\'ll ensure that the playbook starts with \'---\' and that each task uses the correct module and parameters as specified. I\'ll avoid adding any extra tasks or modifying the existing ones.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: yes\n\n- name: Install requirements\n  apt:\n    name: "{{ openssl_requirements }}"\n    state: present\n\n- name: Install pip packages\n  pip:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ openssl_pip_packages | default([]) }}"\n  when: openssl_pip_packages is defined and openssl_pip_packages | length > 0\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    mode: \'0700\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    mode: \'0755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    mode: \'0755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Include create.yml\n  import_tasks: create.yml\n  loop: "{{ openssl_items | default([]) }}"\n  loop_control:\n    loop_var: item\n    label: "{{ item.name }}"\n  when: openssl_items is defined and openssl_items | length > 0\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T12:57:40.099542734Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15947683528, 'load_duration': 83505969, 'prompt_eval_count': 594, 'prompt_eval_duration': 351598445, 'eval_count': 801, 'eval_duration': 15511508281, 'model_name': 'deepseek-r1:14b'} id='run--a7383c39-b110-42e4-908a-925071ac39af