---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ (bootstrap_facts.stdout_lines | regex_search('PRETTY_NAME=".*?\((.*)\)"')) }}"
  with_items: "{{ bootstrap__os_family_map.items() }}"
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - "'{{ item.value }}' in bootstrap_facts.stdout"
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  with_items: "{{ bootstrap__os_family_map.items() }}"
  loop_control:
    label: "{{ item.key }}"
  when:
    - bootstrap_distribution in "{{ item.value }}"
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"


