d that each task is correctly formatted.\n</think>\n\n```yaml\n---\n- name: Gather service facts\n  ansible.builtin.service_facts:\n    state: gathered\n\n- name: Set the active_server variable\n  loop: "{{ groups[\'rke2_cluster_group_name\'] }}"\n  delegate_to: "{{ item }}"\n  tasks:\n    - name: Check if host is in rke2_servers_group_name group\n      ansible.builtin.group_facts:\n        group: rke2_servers_group_name\n      register: is_in_group\n\n    - name: Check if rke2-server.service is running\n      ansible systemd:\n        name: rke2-server.service\n        state: started\n      register: service_status\n\n    - name: Set active_server fact\n      ansible.builtin.set_fact:\n        active_server: "{{ inventory_hostname }}"\n      when: is_in_group and service_status\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T14:31:33.7271107Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11096924936, 'load_duration': 2251191751, 'prompt_eval_count': 358, 'prompt_eval_duration': 282727670, 'eval_count': 616, 'eval_duration': 8562349588, 'model_name': 'deepseek-r1:14b'} id='run--34f6705d-5c11-4b77-af1d-e3552c2af3e9-0' usage_metadata={'input_tokens': 358, 'output_tokens': 616, 'total_tokens': 974}
