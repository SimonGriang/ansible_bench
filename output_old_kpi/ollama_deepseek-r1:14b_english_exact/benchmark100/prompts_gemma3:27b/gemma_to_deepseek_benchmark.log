rs since this is part of an Ansible Role under tasks/main.yml.\n\nI think that\'s all. Now, I\'ll format this into a valid YAML playbook as specified.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  state: present\n  no_need_to_change: yes\n\n- name: Wait for port to be available\n  wait_for_port:\n    port: "{{ ansible_port | default(22) }}"\n    timeout: "{{ bootstrap_timeout }}"\n  when:\n    - ansible_connection is not container\n    - bootstrap_wait_for_host\n\n- name: Prepare system\n  command: whoami\n  no Become\n  ignore_errors: yes\n  register: test_connection\n  changed_when: false\n\n  rescue:\n\n    name: Gather bootstrap facts\n    apt:\n      name: "{{ bootstrap_facts_packages | default([]) | list }}"\n      state: present\n      force: yes\n\n- name: Gather ansible facts\n  setup:\n    gather_subset: all\n\n- name: Install bootstrap packages (package)\n  apt:\n    name: "{{ bootstrap_facts_packages | default([]) | list }}"\n    state: present\n    force: yes\n  become: "{{ bootstrap_become | default(\'yes\') | bool }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T12:26:17.697807121Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13675516153, 'load_duration': 86139598, 'prompt_eval_count': 508, 'prompt_eval_duration': 128661293, 'eval_count': 676, 'eval_duration': 13459610214, 'model_name': 'deepseek-r1:14b'} id='run--adf243ff-4fcd-44b7-8ac8-7c3316304976-0' usage_metadata={'input_tokens': 508, 'output_tokens': 676, 'total_tokens': 1184}
