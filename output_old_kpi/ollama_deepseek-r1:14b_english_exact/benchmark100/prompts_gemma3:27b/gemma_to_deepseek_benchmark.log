ice }}"\n    state: started\n    enabled: yes\n  when:\n    - cron_service\n\n- name: Schedule requested cron jobs\n  cron:\n    name: "{{ item.name }}"\n    minute: "{{ item.minute }}"\n    hour: "{{ item.hour }}"\n    day: "{{ item.day }}"\n    month: "{{ item.month }}"\n    weekday: "{{ item.weekday }}"\n    special_time: "{{ item.special_time }}"\n    command: "{{ item.command }}"\n    shell: "{{ item.shell }}"\n    notification: "{{ item.notification }}"\n    state: "{{ item.state }}"\n  loop:\n    - "{{ cron_jobs }}"\n  when:\n    - cron_jobs\n  tags:\n    - cron\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T15:13:55.371985688Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13507388383, 'load_duration': 92155017, 'prompt_eval_count': 1193, 'prompt_eval_duration': 14708339, 'eval_count': 634, 'eval_duration': 13398802321, 'model_name': 'deepseek-r1:14b'} id='run--e6cdac17-635a-4b65-83f1-562e916a1989-0' usage_metadata={'input_tokens': 1193, 'output_tokens': 634, 'total_tokens': 1827} 85%|████████▌ | 85/100 [3:55:18<58:40, 234.73s/it]
