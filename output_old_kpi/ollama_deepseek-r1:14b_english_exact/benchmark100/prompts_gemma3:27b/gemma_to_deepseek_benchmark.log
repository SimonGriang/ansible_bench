ible-lint guidelines without altering the intended functionality. I\'ll ensure that all task names and variables remain the same to maintain the original structure and requirements.\n</think>\n\n```yaml\n---\n- name: vault hardening task 1\n  ansible.posix.sudoers:\n    name: vault\n    state: absent\n    shell: /sbin/nologin\n    update_cache: yes\n\n- name: disable .ssh directory\n  file:\n    path: /home/vault/.ssh\n    state: directory\n    mode: 755\n    owner: vault\n    group: vault\n  when: stat.stat.path.exists\n  register: stat\n\n- name: ensure vault service is running and enabled\n  ansible.posix.systemctl:\n    name: vault\n    state: started\n    enabled: yes\n\n- name: configure selinux and apparmor\n  block:\n    - name: configure selinux\n      ansible.posix.yum:\n        name: selinux-policy\n        state: present\n      when:\n        - vault_hardening_configure_selinux_apparmor\n        - ansible_selinux.status | ansible.utils.condition("== enabled")\n      vars:\n        ansible_python_interpreter: /usr/bin/python3\n\n    - name: set selinux enforcing mode\n      ansible.posix.systemctl:\n        name: selinux\n        state: started\n        mode: targeted\n        enforcing: yes\n\n    - name: configure apparmor\n      ansible.posix.yum:\n        name: apparmor\n        state: present\n      when:\n        - vault_hardening_configure_selinux_apparmor\n        - ansible_apparmor.status | ansible.utils.condition("== enabled")\n      vars:\n        ansible_python_interpreter: /usr/bin/python3\n\n    - name: set apparmor enforcing mode\n      ansible.posix.systemctl:\n        name: apparmor\n        state: started\n        enforcing: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T11:32:39.242784985Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26139475644, 'load_duration': 84535881, 'prompt_eval_count': 731, 'prompt_eval_duration': 53197919, 'eval_count': 1260, 'eval_duration': 