---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: /etc/mysql/{{ mysql_name }}.cnf
  notify: Restart mysql server

- name: Configure mysql client
  file:
    path: /etc/mysql/{{ mysql_name }}-client.cnf
    mode: 0640
    content: "socket={{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: distribution in ['Alpine', 'Archlinux']
  become: true

- name: Start and enable mysql
  systemctl:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: all privileges
    host: "{{ item.host }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


