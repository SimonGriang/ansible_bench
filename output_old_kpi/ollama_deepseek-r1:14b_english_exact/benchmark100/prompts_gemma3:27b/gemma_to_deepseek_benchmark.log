```yaml
- name: Install dns packages
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create DNS directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ dns_directories }}"

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    shell: /sbin/nologin
    home: /nonexistent

- name: Generate rndc key
  command: rndc-confgen -a -u "{{ dns_owner }}" -g "{{ dns_group }}" > "{{ rndc_key_path }}"
  args:
    chdir: "{{ dns_confdir }}"
  changed_when: false
  register: rndc_key_file

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_path }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0640

- name: Get the hints/root file
  get_url:
    url: "https://{{ rrtype }}.{{ domain }}/{{ zone_name }}.zone"
    dest: "{{ dns_datadir }}/hints"
    mode: 0644
    remote_src: false
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: "{{ dns_zone_template }}"
    dest: "{{ item.destination }}"
    mode: 0640
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ dns_zones }}"
  notify: Rndc reload
  register: zone_file

- name: Validate zone file
  command: named-checkzone "{{ item.zone_name }}" "{{ item.destination }}"
  with_items: "{{ zone_file.results }}"

- name: Add zones to configuration
  template:
    src: "{{ named_config_template }}"
    dest: "{{ named_config_file }}"
    mode: 0640
    owner: "{{ named_config_owner }}"
    group: "{{ named_config_group }}"
  notify: Restart dns

- name: Place systemd override
  file:
    path: "/etc/systemd/system/{{ dns_service }}.service"
    state: file
    content: |
      [Service]
     ExecStartPre=-/bin/sh -c 'test -f /run/named/named.pid && kill -HUP $(cat /run/named/named.pid)'
      Restart=on-abort
    mode: 0644
  when: ansible_system == "Linux"
  notify: systemd-daemon reload

- name: Start and enable dns service
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true
```


