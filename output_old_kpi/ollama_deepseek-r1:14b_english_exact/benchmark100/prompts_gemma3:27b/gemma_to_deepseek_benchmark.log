    - is_defined(java_keystore_dir)
    - java_open_jdk_version_major >= 11

- name: Import SSL Certificates into Java Keystore
  java_cert:
    path: "{{ item }}"
    keystore: "{{ java_open_jdk_home }}/jre/lib/security/{{ java_keystore_dir }}"
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ (item.split('/') | last).regex_replace('.cer', '') }}"
    state: present
  loop: "{{ java_certs }}"
  createKeystoreIfNotExists: true


