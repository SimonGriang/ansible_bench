```yaml
- name: Import assert.yml
  import_tasks:
    path: assert.yml
  args:
    once: true
  delegate_to: localhost
  run_once: true

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: present
  when:
    - ansible_os_family == 'RedHat'
    - ansible_major_version == '8'

- name: Install redis
  apt:
    name: "{{ redis_packages }}"
    state: present
  become: yes
  become_method: sudo

- name: Configure redis
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis
  systemctl:
    name: "{{ redis_service }}"
    state: started
    enabled: yes
```


