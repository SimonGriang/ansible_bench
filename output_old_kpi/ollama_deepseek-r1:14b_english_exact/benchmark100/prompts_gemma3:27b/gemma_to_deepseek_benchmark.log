    upgrade: true
  notify: Reboot

- name: Configure apt
  ansible.builtin.apt:
    update_cache: true
    upgrade: no
    autoremove: true
    update_excluded_packages: "{{ update_excluded_packages | default([]) }}"
  notify: Reboot

