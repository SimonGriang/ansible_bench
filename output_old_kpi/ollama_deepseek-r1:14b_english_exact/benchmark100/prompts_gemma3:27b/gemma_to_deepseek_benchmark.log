---
- name: Configure sysvinit service scripts
  tasks:
    - block:
        - name: Check if service manager is sysvinit, upstart, or openrc
          ansible.builtin.raw: echo "service_manager={{ ansible_service_mgr | default('none') }}"
          register: service_manager
          changed_when: false
          delegate_to: localhost

        - name: Create sysvinit service scripts
          template:
            src: sysvinit.j2
            dest: /etc/init.d/{{ item.name }}
            mode: 0755
          with_items: "{{ service_list }}"
          when: service_manager.stdout in ['sysvinit', 'upstart', 'openrc']
      changed_when: service_manager.stdout in ['sysvinit', 'upstart', 'openrc']


