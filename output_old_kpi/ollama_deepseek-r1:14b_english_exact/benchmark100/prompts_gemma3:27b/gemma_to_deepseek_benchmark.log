---
- import_tasks: assert.yml
  delegate_to: localhost
  tags:
    - assert

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  cronConfiguration:
    path: "{{ cron_configuration }}"
    name: SHELL
    value: "{{ cron_shell }}"
    regex: '^SHELL=.*$'
    create: yes
    mode: 0600
  notify: Restart cron

- name: Configure path
  cronConfiguration:
    path: "{{ cron_configuration }}"
    name: PATH
    value: "{{ cron_path }}"
    regex: '^PATH=.*$'
    create: yes
    mode: 0600
  notify: Restart cron

- name: Configure mailto
  cronConfiguration:
    path: "{{ cron_configuration }}"
    name: MAILTO
    value: "{{ cron_mailto }}"
    regex: '^MAILTO=.*$'
    create: yes
    mode: 0600
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when:
    - cron_service

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    command: "{{ item.command }}"
    shell: "{{ item.shell }}"
    notification: "{{ item.notification }}"
    state: "{{ item.state }}"
  loop:
    - "{{ cron_jobs }}"
  when:
    - cron_jobs
  tags:
    - cron


