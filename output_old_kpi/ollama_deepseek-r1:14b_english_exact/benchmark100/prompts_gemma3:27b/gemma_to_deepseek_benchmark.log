---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for_port:
    port: "{{ bootstrap_port | default(22) | int }}"
    timeout: "{{ bootstrap_timeout | default(600) | int }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'container'
    - bootstrap_wait_for_host

- name: Prepare system
  raw: echo "test"
  register: test_connection
  ignore_errors: yes

  rescue:
    - name: Gather facts in rescue
      setup:
        gather_subset: all

    - name: Install bootstrap packages via raw
      raw: "{{ bootstrap_facts_packages | join(' ') | default('') }}"
        shell: dnf install -y {{ item }}
      with_items: "{{ bootstrap_facts_packages | default([]) }}"

    - name: Ensure libdnf5 is present on RedHat-based systems
      raw: dnf install -y libdnf5
      when: ansible_distribution == 'RedHat'

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages | default([]) | list }}"
    state: present
    update_cache: yes
    become: "{{ bootstrap_become | default(true) }}"


