---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be reachable
  wait_for:
    port: 22
    host: >-
      {{ansible_ssh_host|default(ansible_host|default(inventory_hostname))}}
    state: started
    timeout: "{{bootstrap_timeout}}"
  become: yes
  become_user: "{{bootstrap_user}}"
  connection: local
  when:
    - ansible_connection not in ["container", "docker"]
    - bootstrap_wait_for_host

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{bootstrap_timeout}}"
        register: bootstrap_connect
      ignore_errors: yes

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml
      vars:
        gather_facts_mode: bootstrap
  always: yes

- name: Install bootstrap packages
  raw:
    cmd: >-
      {{bootstrap_packages_command}}
  register: bootstrap_install_packages
  changed_when: >-
    ('{{ansible_distribution}}' in ['alpine', 'arch', 'gentoo'] or
     ('{{ansible_distribution}}' not in ['debian', 'redhat', 'rocky', 'suse'] and
     '{{ansible_distribution_version}}' is defined))
  become: yes
  become_user: "{{bootstrap_user}}"
  vars:
    ansible_user: "{{bootstrap_user}}"

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:
        gather_subset: all

    - name: Install packages listed in bootstrap__facts_packages
      package:
        name: "{{bootstrap__facts_packages}}"
        state: present
        update_cache: yes
  when: "{{bootstrap__facts_packages is defined}}"


