---
- name: Enable Apache modules
  become: yes
  apache_module:
    state: present
    name: "{{ item }}"
  when: ansible_os_family in ['Debian', 'Suse']
  loop:
    - proxy
    - proxy_http

- name: Configure Apache locations
  template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}"
    mode: 0644
  notify:
    - Test httpd configuration validity
    - Restart httpd
  loop: httpd_locations


