---
- name: Run assert tasks
  include_tasks:
    path: assert.yml
  run_once: true
  host: localhost

- name: Install vsftpd package
  apt:
    name: vsftpd
    state: present

- name: Configure vsftpd using a template
  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file | default('/etc/vsftpd.conf') }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode | default('644') }}"
  notify: Restart vsftpd

- name: Start and enable vsftpd service
  service:
    name: vsftpd
    state: started
    enabled: true


