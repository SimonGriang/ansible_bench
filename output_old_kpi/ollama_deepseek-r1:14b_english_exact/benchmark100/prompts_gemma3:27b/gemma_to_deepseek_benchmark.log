---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  state: true

- name: Wait for port to be available
  wait_for_port:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    ansible_connection is not container and bootstrap_wait_for_host is true

- name: Prepare system
  block:
    - name: Command task
      command: whoami
      ignore_errors: true
      register: test_connection
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      apt:
        name: "{{ bootstrap_facts_packages | default([]) | list }}"
        state: present
        force: yes
  become: false

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages (package)
  apt:
    name: "{{ bootstrap_facts_packages | default([]) | list }}"
    state: present
    force: yes
  become: true 31%|███       | 31/100 [1:09:55<2:08:50, 112.04s/it]

