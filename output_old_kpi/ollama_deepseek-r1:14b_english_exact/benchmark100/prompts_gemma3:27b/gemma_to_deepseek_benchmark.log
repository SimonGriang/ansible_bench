    - { name: 'ssl privateKey' }

- name: read certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    dest: "{{ item.name }}_crt-content"
  register: openssl_certificate
  with_items:
    - { name: 'ssl certificate' }

- name: create combined private_key and certificate file
  ansible.builtin.copy:
    content: |
      {{ openssl_private_key.decode('utf-8') }}
      {{ openssl_certificate.decode('utf-8') }}
    dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
    mode: 600
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items:
    - { name: 'ssl combined' } 37%|███▋      | 37/100 [1:38:47<4:17:00, 244.78s/it]

