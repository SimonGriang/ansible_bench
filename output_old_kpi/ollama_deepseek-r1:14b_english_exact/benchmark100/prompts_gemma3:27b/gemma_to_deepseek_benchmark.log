- name: Create the /etc/openvpn/client directory
  ansible.builtin.file:
    path: /etc/openvpn/client
    state: directory
    mode: "0750"
    owner: root
    group: "{{ openvpn_group }}"

- name: Deploy the OpenVPN client configuration file
  ansible.builtin.template:
    src: client.conf.j2
    dest: "{{ openvpn_configuration_directory }}/client.conf"
    mode: "0640"
    owner: root
    group: "{{ openvpn_group }}"
  notify: Restart openvpn


