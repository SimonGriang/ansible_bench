---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
    node_name: "{{ rke2_node_name }}"
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: "{{ rke2_data_path }}/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].status.phase' | grep -v Ready | wc -l"
  register: ready_nodes_check
  until: ready_nodes_check.stdout == 0
  retries: 100
  delay: 15
  delegate_to: "{{ansible_hostname | default('localhost')}}"
  delegate_to: "{{ rke2_active_server | default(rke2_servers_group_name[0]) }}"
  run_once: true

- name: Wait for all pods to be ready
  shell: "{{ rke2_data_path }}/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o json | jq -r '.items[].status.phase' | grep -v 'Running'| grep -v 'Succeeded' | wc -l"
  register: pod_ready_check
  until: pod_ready_check.stdout == 0
  retries: 100
  delay: 15
  delegate_to: "{{ansible_hostname | default('localhost')}}"
  delegate_to: "{{ rke2_active_server | default(rke2_servers_group_name[0]) }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready and not ansible_check_mode


