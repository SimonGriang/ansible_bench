---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  host: localhost

- name: Configure apk
  command: apk update && apk upgrade
  args:
    chdir: /some/directory
  notify: Reboot

- name: Configure apt
  apt:
    state: present
    update_cache: yes
    upgrade: yes
    exclude_packages: "{{ update_excluded_packages }}"
    autoremove: yes
  notify: Reboot

- name: Update all software (dnf)
  dnf:
    name:
      - "*"
      - exclude: "{{ update_excluded_packages }}"
    state: latest
  notify: Reboot
  when:
    - ansible_pkg_mgr == "dnf"
    - ansible_pkg_mgr == "dnf5"

- name: Update all software (pacman)
  pacman:
    state: present
    update_cache: yes
    upgrade: yes
  notify: Reboot
  when: ansible_pkg_mgr == "pacman"

- name: Configure yum
  yum:
    name:
      - "*"
      - exclude: "{{ update_excluded_packages }}"
    state: latest
  notify: Reboot
  when: ansible_pkg_mgr == "yum"

- name: Update all software (zypper)
  zypper:
    name:
      - "*"
    state: latest
  notify: Reboot
  when: ansible_pkg_mgr == "zypper"


