---
- name: gather bootstrap facts using raw command
  raw: uname -a
  register: bootstrap_facts
  become: false
  gather_facts: false

- name: set bootstrap facts (I) based on OS release information
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ major_version }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when:
    - (bootstrap_facts.rc == 0
      and not bootstrap_distribution
      and "'{{ item.value.distributions }}' in {{ bootstrap_facts.stdout }}")
  vars:
    bootstrap_search: "{{ item.value.distributions | join(',') }}"
    major_version: "{{ lookup('ansible.utils.regex', 'pattern=(\\d+)', input=bootstrap_facts.stdout_lines, ignore_errors=True) | default(0) }}"

- name: set bootstrap facts (II) based on OS family
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map.keys() }}"
  when: bootstrap_distribution in "{{ item.value }}"
  loop_control:
    label: "{{ item.key }}"

