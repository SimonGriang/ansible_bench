---
- name: Import assert tasks
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install docker-compose using a package manager
  apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ docker_compose_package_name }}"
  when: docker_compose_installation_type == 'package'

- name: Install docker-compose as a binary
  block:
    - name: Install required packages for binary installation
      apt:
        name: "{{ item }}"
        state: present
      with_items: "{{ docker_compose_binary_required_packages }}"

    - name: Download and install docker-compose binary
      get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
