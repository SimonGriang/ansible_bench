---
- name: Task 1: Import assert.yml
  import_tasks: assert.yml

- name: Task 2: Install python pip
  apt:
    name: "{{ python_pip_packages }}"
    state: present

- name: Task 3: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_proxy is defined

- name: Task 4: Configure trusted hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_trusted_host is defined

- name: Task 5: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: not (ansible_distribution_version | version_compare('=', 'bookworm') or
            ansible_distribution_version | version_compare('=', 'noble') or
            ansible_distribution == 'Alpine')

- name: Task 6: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    state: "{{ item.state | default('present') }}"
    executable: "{{ python_pip_executable }}"
    loop: "{{ python_pip_modules }}"
  when: not (ansible_distribution_version | version_compare('=', 'bookworm') or
            ansible_distribution_version | version_compare('=', 'noble') or
            ansible_distribution == 'Alpine')


