---
- name: Conditionally include Debian 12 tasks
  ansible.builtin.include_tasks: debian12.yml
  when: ansible_distribution == 'debian' and ansible_distribution_version >= 12

- name: Install Pip
  ansible.builtin.apt:
    name: python3-pip
    state: present

- name: Install python3-packaging
  ansible.builtin.apt:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    requirements: "{{ pip_install_packages }}"
    pip_executable: "{{ pip_executable | default('pip3') }}"
    virtualenv: "{{ item.virtualenv | default(None) }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(None) }}"
    extra_args: "{{ item.extra_args | default('') }}"
  loop: "{{ pip_install_packages | default([]) | map('filebase') | list }}"


