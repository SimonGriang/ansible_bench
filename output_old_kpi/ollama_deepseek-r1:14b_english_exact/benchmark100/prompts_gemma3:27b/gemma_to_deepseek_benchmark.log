---
- name: Load OS-specific variables
  vars_files:
    - "{{ ansible_os_family }}/vars.yml"
    - "{{ ansible_distribution }}/vars.yml"
    - "vars/main.yml"

- name: Include RedHat setup tasks
  include_tasks: redhat_setup.yml
  when:
    ansible_facts:
      os_family: RedHat

- name: Include Debian setup tasks
  include_tasks: debian_setup.yml
  when:
    ansible_facts:
      os_family: Debian

- name: Install Docker packages
  become: true
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when:
    - ansible_version|version_compare("2.12")|lt
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install Docker packages (specifically for newer versions)
  become: true
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when:
    - ansible_version|version_compare("2.12")|gte
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install Docker Compose plugin
  become: true
  include_tasks: docker-compose.yml
  when:
    - docker_install_compose_plugin
    - ansible_version|version_compare("2.12")|lt
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install Docker Compose plugin (specifically for newer versions)
  become: true
  include_tasks: docker-compose.yml
  when:
    - docker_install_compose_plugin
    - ansible_version|version_compare("2.12")|gte
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install Docker Compose
  become: true
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Service status and enablement
  become: true
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true

- name: Flush handlers
  meta: flush_handlers

- name: Gather information about the docker group
  getent:
    id: docker
    group: yes
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: >-
      {{ (docker_users | default([]) | difference(docker_group_info.gid.members) | list) | not_empty }}

- name: Add users to docker group if needed
  become: true
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify


