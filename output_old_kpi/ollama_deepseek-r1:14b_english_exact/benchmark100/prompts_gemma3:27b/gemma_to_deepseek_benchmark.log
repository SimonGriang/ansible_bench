t vault\n\n- name: Create /usr/lib/systemd/system\n  ansible.builtin.file:\n    path: /usr/lib/systemd/system\n    state: directory\n    owner: root\n    group: root\n    mode: 0755\n\n- name: Copy Vault service file\n  ansible.builtin.copy:\n    src: vault.service.j2\n    dest: /usr/lib/systemd/system/vault.service\n    owner: root\n    group: root\n    mode: 0644\n  notify: Daemon reload\n  when:\n    - ansible_system == "Linux"\n\n- name: Copy vault configuration\n  ansible.builtin.copy:\n    src: vault.hcl\n    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n    owner: root\n    group: root\n    mode: 0644\n  notify: Restart vault\n\n- name: Flush handlers\n  ansible.builtin.handlers:\n    name: all\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T11:28:37.510197962Z', 'done': True, 'done_reason': 'stop', 'total_duration': 48301342065, 'load_duration': 94336466, 'prompt_eval_count': 2238, 'prompt_eval_duration': 12806799, 'eval_count': 2174, 'eval_duration': 48192728283, 'model_name': 'deepseek-r1:14b'} id='run--e4156b7e-3b03-4e56-927b-e1bf5a4ede72-0' usage_metadata={'input_tokens': 2238, 'output_tokens': 2174, 'total_tokens': 4412}
