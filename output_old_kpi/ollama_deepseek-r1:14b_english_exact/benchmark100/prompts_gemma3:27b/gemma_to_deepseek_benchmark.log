---
- name: Assert systemd as init system
  ansible.builtin.systemd:
    state: running
    name: systemd
  register: systemd_status
  ignore_errors: true
  changed_when: false

- name: Get latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases
    method: GET
    no_log: true
    retries: 5
    retry_interval: 10
  register: _latest_release
  environment:
    GH_USER: "{{ lookup('env', 'GH_USER') }}"
    GH_TOKEN: "{{ lookup('env', 'GH_TOKEN') }}"

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] | default('latest') }}"
  when: promtail_version = "latest"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}"
  register: promtail_binary_local_archive

- name: Assert local binary exists
  assert:
    that: promtail_binary_local_archive.stat is not null
    msg: "Local promtail binary archive not found at {{ promtail_binary_local_dir }}"
  when: promtail_binary_local_dir is defined
  ignore_errors: true
  changed_when: false

- name: Get checksum list
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}"
    url: "/SHA256SUMS"
    method: GET
    no_log: true
  register: __promtail_checksums

- name: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: "{{ item.checksum }}"
  with_items: "{{ __promtail_checksums.json }}"
  when: promtail_binary_local_dir is not defined


