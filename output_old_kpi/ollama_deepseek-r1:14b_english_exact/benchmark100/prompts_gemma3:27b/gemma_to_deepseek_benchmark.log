e clean.\n\nFinally, I\'ll compile all the tasks into the main.yml, starting with \'---\' and ensuring each task follows correctly. I\'ll review the playbook to confirm it meets all the given instructions and adheres to Ansible\'s standards.\n</think>\n\n```yaml\n---\n- name: Check for EFI directory\n  stat:\n    path: /sys/firmware/efi/efivars/\n  register: grub_efi\n\n- name: Remove existing grub.cfg on EFI systems\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Install user template for grub\n  template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    group: root\n    mode: 0700\n  notify: Update grub\n\n- name: Add password to grub configuration on EFI systems\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: password_pbkdf2 {{ grub_user }} {{ grub_password }}\n    regexp: \'^password_pbkdf2 {{ grub_user }} {{ grub_password }}$\'\n    insertafter: EOF\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add password to grub configuration on MBR systems\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: password_pbkdf2 {{ grub_user }} {{ grub_password }}\n    regexp: \'^password_pbkdf2 {{ grub_user }} {{ grub_password }}$\'\n    insertafter: EOF\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add --unrestricted flag to grub configuration\n  replace:\n    path: "{{ item }}"\n    regexp: \'CLASS=([^"]+)\'\n    replace: \'CLASS="{{ CLASS }}" --unrestricted\'\n    when: grub_password_unrestricted\n  with_items: "{{ grub_password_unrestricted_files }}"\n  notify: Update grub\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T11:38:59.616750263Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15615148062, 'load_duration': 92106129, 'prompt_eval_count': 770, 'prompt_eval_duration': 297894538, 'eval_count': 869, 'eval_duration': 15223679496, 'model_name': 'deepseek-r1:14b'} id='