---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: 0755

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default([]) | join(',') }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: /path/to/template
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
    mode: 0644
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: /path/to/template
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
    mode: 0644
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: /path/to/template
    dest: /etc/rancher/rke2/registries.yaml
    owner: rancher
    group: rancher
    mode: 0644
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or \
        rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snapshot_file is defined) and (not rke2_server.service.enabled or rke2_server.service.defined) }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_file is defined) and (rke2_etcd_snapshot_s3_options is defined) }}"

- name: Restore etcd from file
  shell: |
    mkdir -p /var/lib/rke2/etcd && \
    cp {{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd/etcd-snapshot.bin && \
    rke2 server --config=/etc/rancher/rke2/config.yaml --etcd-snapshot-restore=/var/lib/rke2/etcd/etcd-snapshot.bin
  when: do_etcd_restore

- name: Restore etcd from s3
  shell: |
    rke2 server --config=/etc/rancher/rke2/config.yaml --etcd-snapshot-restore-s3 "{{ rke2_etcd_snapshot_s3_options | join(' ')" }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token | default('') }}"
  when: ansible_hostname == (rke2_cluster_nodes | first)

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    state: masked
    enabled: no
  when: ansible_hostname == (rke2_cluster_nodes | first)

- name: Wait for the first server be ready - no CNI
  wait_for:
    command: kubectl get pods -n kube-system
    state: started
    timeout: 600
    exact: true
  when: not rke2_cni_plugin

- name: Wait for the first server be ready - with CNI
  wait_for:
    command: kubectl get pods -n kube-system | grep -E 'calico|flannel'
    state: ready
    timeout: 600
    exact: true
  when: rke2_cni_plugin

- name: Restore etcd
  shell: |
    rke2 server --config=/etc/rancher/rke2/config.yaml --etcd-restore
  when: do_etcd_restore

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: "{{ rke2_cluster_group_name | default('rke2-cluster') }}"
  run_once: yes


