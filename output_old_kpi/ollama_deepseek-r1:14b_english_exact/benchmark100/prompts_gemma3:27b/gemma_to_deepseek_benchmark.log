---
- name: Create ssh_key_directory for user
  become: false
  become_user: root
  local_action:
    module: file
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: '0755'
  when: user.manage_ssh_key

- name: Manage user account
  become: yes
  module: user
  args:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    comment: "{{ user.comment }}"
    home: "{{ user.home }}"
    password: "{{ user.password | default('!') }}"
    uid: "{{ user.uid | default('unspecified') }}"
    group: "{{ user.group | default('unspecified') }}"
    shell: "{{ user.shell | default('/bin/sh') }}"
    expiry: "{{ user.expiry | default('unlimited') }}"
  register: user_info

- name: Set sudo options for user
  become: yes
  loop: "{{ user.sudo_users | default([]) }}"
  loop_var: user_name
  block:
    - name: Create sudoers file for user
      template:
        src: "{{ user.sudo_template | default('sudoers.j2') }}"
        dest: "/etc/sudoers.d/{{ user_name }}"
        validate_on_reload: yes
      when: user.sudo_options

- name: Remove sudo options for user
  become: yes
  loop: "{{ user.sudo_users | default([]) }}"
  loop_var: user_name
  block:
    - name: Remove sudoers file for user
      file:
        path: "/etc/sudoers.d/{{ user_name }}"
        state: absent
      when: not user.sudo_options

- name: Generate private ssh key for user
  become: false
  become_user: root
  local_action:
    module: command
    cmd: ssh-keygen -q -f "{{ user.ssh_private_key_path }}" -N ""
  changed_when: false
  when: user.manage_ssh_key

- name: Generate public ssh key for user
  become: false
  become_user: root
  local_action:
    module: shell
    cmd: ssh-keygen -f "{{ user.ssh_private_key_path }}" -y -e > "{{ user.ssh_public_key_path }}"
  changed_when: false
  when: user.manage_ssh_key

- name: Convert ssh key to ppk for user
  become: false
  become_user: root
  local_action:
    module: command
    cmd: ssh-keygen -p -f "{{ user.ssh_private_key_path }}" -N "" -o -t rsa -m pkcs8
  changed_when: false
  when: user.manage_ssh_key

- name: Get or set the home directory for user
  become: yes
  module: shell
  args:
    cmd: getent passwd "{{ user.name }}" | awk -F: '{print $6}'
  register: user_home_dir
  changed_when: false
  when: user.home is not defined

- name: Create .ssh directory for user
  become: yes
  module: file
  path: "{{ user.home }}/.ssh"
  state: directory
  mode: '0700'
  when: user.manage_ssh_key or user.private_keys

- name: Deploy authorized keys for user
  become: yes
  module: authorized_key
  key_file: "{{ user.home }}/.ssh/authorized_keys"
  user: "{{ user.name }}"
  state: present
  when: user.authorized_keys is defined
  loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  become: yes
  module: authorized_key
  key_file: "{{ user.home }}/.ssh/authorized_keys"
  user: "{{ user.name }}"
  state: absent
  when: user.unauthorized_keys is defined
  loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  become: yes
  module: copy
  content: "{{ lookup('file', user.ssh_private_key_path) | ansible.builtin.slurp }}"
  dest: "{{ user.home }}/.ssh/"
  remote_src: yes
  mode: '0600'
  when: user.copy_private_key

- name: Check users password valid time
  become: yes
  module: shell
  args:
    cmd: grep -E -o '(?:^|:)[^:]+(?::|$)' /etc/shadow | awk '{print $1}'
  register: user_password_time
  changed_when: false
  when: user.password_validity is defined

- name: Set users password valid time
  become: yes
  module: shell
  args:
    cmd: chage -M "{{ user.password_max_days }}" -m "{{ user.password_min_days }}" "{{ user.name }}"
  when: user.password_validity is defined

- name: Place private key file for user
  become: yes
  module: copy
  src: "{{ user.private_key_content | default('') }}"
  dest: "{{ user.home }}/.ssh/"
  remote_src: no
  mode: '0600'
  when: user.private_keys
