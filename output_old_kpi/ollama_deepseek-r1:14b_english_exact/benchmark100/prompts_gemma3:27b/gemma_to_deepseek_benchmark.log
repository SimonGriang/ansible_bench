---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: installed
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: /etc/mysql/conf.d/{{ mysql_name }}-server.cnf
    remote_src: yes
  vars:
    mysql_configuration_options: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: /etc/mysql/conf.d/{{ mysql_name }}-client.cnf
    remote_src: yes
  vars:
    mysql_configuration_options: "{{ mysql_configuration_options }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  executable: /bin/sh
  when: ansible_distribution in ['alpine', 'archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    db: information_schema
    query: "SELECT SCHEMA_NAME, CREATE_USER, COLLATION_NAME, DEFAULT_CHARACTER_SET_NAME FROM SCHEMATA"
  register: databases
  ignore_errors: yes
  vars:
    mysql_socket: "{{ mysql_socket }}"
    mysql_root_password: "{{ mysql_root_password }}"

- name: Import database
  mysql_import:
    name: "{{ item.name }}"
    target: "{{ item.target }}"
    state: present
    import: "{{ item.import_from }}"
    ignore_errors: yes
  loop: "{{ mysql_databases }}"
  when:
    - mysql_import_target is defined
    - item.exists | default(false) == false

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


