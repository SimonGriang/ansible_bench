---
- name: Load OS-specific variables
  vars_files:
    - "{{ ansible_os_family }}/vars.yml"
    - "{{ ansible_distribution }}/vars.yml"
    - "vars/main.yml"

- name: Include RedHat setup tasks
  include_tasks: redhat_setup.yml
  when:
    ansible_facts:
      os_family: RedHat

- name: Include Debian setup tasks
  include_tasks: debian_setup.yml
  when:
    ansible_facts:
      os_family: Debian

- name: Install Docker packages
  become: true
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when:
    - ansible_version < "2.12"
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install Docker packages (with downgrade option)
  become: true
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    version: "{{ docker_packages_version }}"
  notify: restart docker
  ignore_errors: true
  when:
    - ansible_version >= "2.12"
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install docker-compose plugin
  become: true
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: true
  when:
    - docker_install_compose_plugin
    - ansible_version < "2.12"
    - ansible_facts.os_family in [RedHat, Debian]

- name: Install docker-compose-plugin (with downgrade option)
  become: true
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    version: "{{ docker_compose_package_version }}"
  notify: restart docker
  ignore_errors: true
  when:
    - docker_install_compose_plugin
    - ansible_version >= "2.12"
    - ansible_facts.os_family in [RedHat, Debian]

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    mode: "{{ docker_dir_mode }}"
  when: docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    remote_src: true
    content: "{{ docker_daemon_options | json_dumps }}"
    dest: /etc/docker/daemon.json
    mode: "{{ docker_daemon_config_mode }}"
  when: docker_daemon_options | length > 0
  notify: restart docker

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    id: docker
    group: yes
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ (docker_users | default([]) | difference(docker_group_info.gid.members) | list) | not_empty }}"

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify

