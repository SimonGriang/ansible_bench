---
- name: Ensure the easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the easy-rsa PKI
  ansible.builtin.command:
    cmd: easyrsa init-pki
    chdir: /etc/openvpn/easy-rsa
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki')

- name: Build the Certificate Authority (CA)
  ansible.builtin.command:
    cmd: EASYRSA_BATCH=yes easyrsa build-ca nopass
    chdir: /etc/openvpn/easy-rsa
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki/ca.crt')

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command:
    cmd: easyrsa gen-dh
    chdir: /etc/openvpn/easy-rsa
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki/dh.pem')

- name: Build the server certificate
  ansible.builtin.command:
    cmd: EASYRSA_BATCH=yes easyrsa build-server-full server nopass
    chdir: /etc/openvpn/easy-rsa
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki/issued/server.crt')

- name: Build the client certificate
  ansible.builtin.command:
    cmd: EASYRSA_BATCH=yes easyrsa build-client-full client nopass
    chdir: /etc/openvpn/easy-rsa
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki/issued/client.crt')

- name: Generate the Certificate Revocation List (CRL)
  ansible.builtin.command:
    cmd: easyrsa gen-crl
    chdir: /etc/openvpn/easy-rsa
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki/crl.pem')

- name: Generate TLS authentication key
  ansible.builtin.command:
    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  when:
    not file.exists('/etc/openvpn/easy-rsa/pki/ta.key')

- name: Copy PKI files to the server configuration directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,dh.pem,ta.key,client*.crt,server*.crt,ca.key,client*.key,server*.key}
    dest: /etc/openvpn/server
    mode: 0640
    remote_src: yes

- name: Copy ca.crt and ta.key to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,ta.key}
    dest: /etc/openvpn
    mode: 0640
    remote_src: yes

- name: Place the server configuration file
  ansible.builtin.template:
    src: "{{ openvpn_configuration_directory }}/server.conf.j2"
    dest: /etc/openvpn/server.conf
    mode: 0640
    owner: openvpn
    group: openvpn
  notify: Restart openvpn


