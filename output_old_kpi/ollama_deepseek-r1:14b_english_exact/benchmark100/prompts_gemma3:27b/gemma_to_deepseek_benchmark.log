---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Disable automatic service management
  file:
    path: /usr/sbin/policy-rc.d
    content: 'exit 101'
    mode: '755'
    state: present
  remote_src: no
  when: apt_autostart_state | bool == 'disabled'

- name: Enable automatic service management
  file:
    path: /usr/sbin/policy-rc.d
    state: absent
  remote_src: no
  when: apt_autostart_state | bool == 'enabled'

