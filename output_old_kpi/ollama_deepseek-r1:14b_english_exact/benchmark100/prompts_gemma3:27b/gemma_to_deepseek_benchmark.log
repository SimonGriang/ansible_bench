---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  become: false
  tags: []

- name: Install cron
  become: yes
  package:
    name: '{{ cron_packages }}'
    state: present
  tags: []

- name: Configure shell
  become: yes
  file:
    path: '{{ cron_configuration }}'
    line: 'SHELL={{ cron_shell }}'
    state: present
    create: true
    mode: '0600'
    owner: root
    group: root
  notify: Restart cron
  tags: []

- name: Configure path
  become: yes
  file:
    path: '{{ cron_configuration }}'
    line: 'PATH={{ cron_path }}'
    state: present
    create: true
    mode: '0600'
    owner: root
    group: root
  notify: Restart cron
  tags: []

- name: Configure mailto
  become: yes
  file:
    path: '{{ cron_configuration }}'
    line: 'MAILTO={{ cron_mailto }}'
    state: present
    create: true
    mode: '0600'
    owner: root
    group: root
  notify: Restart cron
  tags: []

- name: Start and enable cron
  become: yes
  service:
    name: '{{ cron_service }}'
    state: started
    enabled: true
  when: cron_service | length > 0
  tags: []

- name: Schedule requested cron jobs
  become: yes
  cron:
    name: '{{ item.name }}'
    minute: '{{ item.minute }}'
    hour: '{{ item.hour }}'
    day: '{{ item.day }}'
    month: '{{ item.month }}'
    weekday: '{{ item.weekday }}'
    special_time: '{{ item.special_time }}'
    job: '{{ item.job }}'
    state: '{{ item.state }}'
    user: '{{ item.user }}'
  loop: '{{ cron_jobs }}'
  loop_control:
    loop_var: item
    label: '{{ item.name }}'
  tags: []


