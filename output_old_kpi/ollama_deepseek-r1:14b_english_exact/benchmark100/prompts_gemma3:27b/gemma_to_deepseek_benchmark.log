---
- name: Import assert.yml
  include_tasks: assert.yml
  vars:
    ansible_host: localhost
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  notify: Reboot

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: none
    autoremove: yes
    update_excluded_packages: "{{ update_excluded_packages | default([]) }}"
  notify: Reboot

- name: Update all software (dnf)
  dnf:
    update: yes
    skip_list: "{{ update_excluded_packages | default([]) }}"
  notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  pacman:
    upgrade: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  yum:
    name: "*"
    state: present
    update_cache: yes
    skip_list: "{{ update_excluded_packages | default([]) }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  zypper:
    update: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'


