---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  become: yes

- name: Install requirements
  apt:
    name: bash
    state: present
  become: yes

- name: Install openjdk java (package)
  apt:
    name: openjdk
    state: present
    universe: yes
  environment:
    USE: '-minimal'
  become: yes
  when: java_vendor | bool

- name: Install RPM
  apt:
    name: "{{ rpm_package_name }}"
    state: present
  become: yes
  when: java_source | bool and java_format | bool
  vars:
    rpm_package_name: oracle-java-{{ java_version }}-rpm

- name: Install DEB
  apt:
    name: "{{ deb_package_name }}"
    state: present
  become: yes
  when: java_source | bool and java_format | bool
  vars:
    deb_package_name: oracle-java-{{ java_version }}-deb

- name: Install oracle java (rpm) (repository)
  apt:
    name: oracle-java
    state: present
  become: yes
  when: java_source | bool and java_format | bool

- name: Configure oracle targz
  shell: tar -xzf /tmp/oracle-jdk-{{ java_version }}.tar.gz --strip-components=1 --directory /usr/local/java
  become: yes
  when: java_format | bool and java_vendor | bool
  vars:
    java_install_dir: /usr/local/java
  pre_tasks:
    - name: Ensure install directory exists
      file:
        path: "{{ java_install_dir }}"
        state: directory

- name: Install oracle java policy software (targz)
  shell: unzip /tmp/jce_policy_{{ java_version }}.zip -d /usr/local/java/jce
  become: yes
  when: java_jce | bool and java_version | bool and java_vendor | bool
  vars:
    jce_policy_zip: jce_policy_{{ java_version }}.zip
  post_tasks:
    - name: Set permissions on JCE
      file:
        path: /usr/local/java/jce
        state: directory
        mode: 755

- name: Set alternative (targz)
  shell: alternatives --install /usr/bin/java {{ java_version }} /usr/local/java/jre/bin/java
  become: yes
  when: java_format | bool and ansible_distribution != 'Alpine' and java_vendor | bool

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java | xargs dirname
  register: java_home_result
  become: yes

- name: Set JAVA_HOME in /etc/environment
  file:
    path: /etc/profile.d/java_home.sh
    content: export JAVA_HOME="{{ java_home_result.stdout }}"
    mode: 755
    create: yes

