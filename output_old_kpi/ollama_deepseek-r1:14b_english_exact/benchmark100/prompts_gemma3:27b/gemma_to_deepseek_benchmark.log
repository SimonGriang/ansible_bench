---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  state: present

- name: Install fail2ban
  apt:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  copy:
    remote_src: yes
    src: "{{ fail2ban_filterd_path }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  notify: Restart fail2ban
  condition: { 'ansible.builtin.condition': "'{{ fail2ban_filterd_path }}' is defined" }

- name: Configure fail2ban.local
  ini_file:
    path: /etc/fail2ban/fail2ban.local
    value: "{{ item.value }}"
    section: "{{ item.section }}"
    key: "{{ item.key }}"
    label: "{{ item.option }}"
  loop: "{{ fail2ban_base_configuration + fail2ban_jail_configuration }}"
  notify: Restart fail2ban
  args:
    mode: 0640

- name: Configure jail.local
  ini_file:
    path: /etc/fail2ban/jail.local
    value: "{{ item.value }}"
    section: "{{ item.section }}"
    key: "{{ item.key }}"
    label: "{{ item.option }}"
  loop: "{{ fail2ban_base_jail_configuration + fail2ban_jail_configuration }}"
  notify: Restart fail2ban
  args:
    mode: 0640

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  condition: { 'ansible.builtin.condition': "'{{ fail2ban_auth.stat.exists }}' is defined and ('{{ fail2ban_auth.stat.exists }}' == false)" }

- name: Start and enable fail2ban
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true

