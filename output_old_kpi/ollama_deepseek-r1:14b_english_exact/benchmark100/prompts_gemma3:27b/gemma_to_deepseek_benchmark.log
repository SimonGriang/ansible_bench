---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_host: localhost
  state: present

- name: Install git
  become: yes
  package:
    name: '{{ git_packages }}'

- name: See if the specified user exists
  become: yes
  getent:
    user: '{{ git_username }}'
    state: present
  register: user_exists
  ignore_errors: true

- name: Check if user exists
  fail:
    msg: "User '{{ git_username }}' does not exist and fail_key is true"
  when:
    - user_exists.rc != 0 and fail_key | default(true)

- name: Create directory for git configuration
  become: yes
  file:
    path: /home/{{ git_username }}
    state: directory
    owner: '{{ git_username }}'
    mode: 0755

- name: Place git configuration
  become: yes
  copy:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    owner: '{{ git_username }}'
    mode: 0644

- name: Create repository_destination
  become: yes
  file:
    path: '{{ git_repository_destination }}'
    state: directory
    owner: '{{ git_username }}'
    mode: 0777

- name: Clone all roles
  become: yes
  git:
    remote_path: '{{ item.repository_url }}'
    repo: '{{ git_repository_destination }}/{{ item.destination }}'
    branch: '{{ item.version }}'
    force: '{{ item.force | default(no) }}'
    delegate_to: localhost
  loop: '{{ git_repositories }}'
  loop_control:
    label: "Cloning repository '{{ item.repository_url }}' to {{ git_repository_destination }}/{{ item.destination }}"


