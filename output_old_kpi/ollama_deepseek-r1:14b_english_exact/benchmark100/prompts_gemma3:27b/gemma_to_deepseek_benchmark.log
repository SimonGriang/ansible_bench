    upgrade: true
  notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  ansible.builtin.yum:
    name: "*"
    state: present
    update_cache: true
    skip_list: "{{ update_excluded_packages | default([]) }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  community.general.zypper:
    update: true
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'


