the YAML as required.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install required packages\n  apt:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify: Gather facts\n\n- name: Flush handlers\n  flush_handlers:\n\n- name: Configure selinux\n  command: "{{ item }}"\n  loop:\n    - setenforce "{{ selinux_state }}"  # For enforcing/relaxing\n    - setsebool -P {{ selinux_policy }} {{ selinux_policy_value }}\n  when:\n    - ansible_selinux.status is defined\n    - ansible_connection != \'docker\'\n  notify: Reboot\n\n- name: Manage selinux booleans\n  command: setsebool -P {{ item.key }} {{ item.value }}\n  loop: "{{ selinux_booleans | dictinterator }}"\n  when: selinux_booleans is defined\n  register: selinux_boolean_result\n  changed_when: selinux_boolean_result.stdout != \'already set\'\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T12:04:53.13495125Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9962530334, 'load_duration': 101809706, 'prompt_eval_count': 489, 'prompt_eval_duration': 76174510, 'eval_count': 659, 'eval_duration': 9783169588, 'model_name': 'deepseek-r1:14b'} id='run--c8cd14ec-e0b3-4a3d-aa84-bc35a51efcae-0' usage_metadata={'input_tokens': 489, 'output_tokens': 659, 'total_tokens': 1148}
