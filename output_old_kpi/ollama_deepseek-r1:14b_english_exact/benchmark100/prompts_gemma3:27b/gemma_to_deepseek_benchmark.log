e: gather_facts | Set bootstrap facts (I)\n  set_fact:\n    bootstrap_distribution: "{{ item.value }}"\n    bootstrap_distribution_major_version: "{{ (bootstrap_facts.stdout | regex_search(\'PRETTY_NAME=".*? (\\\\d+).*\') | first) | int }}"\n  loop: "{{ bootstrap_os_family_map.items() }}"\n  when:\n    - bootstrap_facts.rc == 0\n    - not (bootstrap_distribution is defined)\n    - ("{{ item.value }}" in bootstrap_facts.stdout)\n  vars:\n    bootstrap_search: "{{ item.value }}"\n\n- name: gather_facts | Set bootstrap facts (II)\n  set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  loop: "{{ bootstrap_os_family_map.items() }}"\n  when: bootstrap_distribution is in item.value\n  loop_control:\n    label: "{{ item.key }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T12:30:02.739629437Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12841917284, 'load_duration': 90549123, 'prompt_eval_count': 797, 'prompt_eval_duration': 43066809, 'eval_count': 646, 'eval_duration': 12707084825, 'model_name': 'deepseek-r1:14b'} id='run--6c708df0-f2cc-43e3-b73a-91e89000df3f-0' usage_metadata={'input_tokens': 797, 'output_tokens': 646, 'total_tokens': 1443}
