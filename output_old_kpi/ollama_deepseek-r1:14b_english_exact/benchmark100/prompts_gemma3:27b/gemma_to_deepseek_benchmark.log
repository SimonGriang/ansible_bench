---
- name: vault hardening task 1
  ansible.posix.sudoers:
    name: vault
    state: absent
    shell: /sbin/nologin
    update_cache: yes

- name: disable .ssh directory
  file:
    path: /home/vault/.ssh
    state: directory
    mode: 755
    owner: vault
    group: vault
  when: stat.path.exists

- name: ensure vault service is running and enabled
  ansible.posix.systemctl:
    name: vault
    state: started
    enabled: yes

- name: configure selinux and apparmor
  block:
    - name: configure selinux
      ansible.posix.yum:
        name: selinux-policy
        state: present
      when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
      vars:
        ansible_python_interpreter: /usr/bin/python3

    - name: set selinux enforcing mode
      ansible.posix.systemctl:
        name: selinux
        state: started
        mode: targeted
        enforcing: yes

    - name: configure apparmor
      ansible.posix.yum:
        name: apparmor
        state: present
      when: vault_hardening_configure_selinux_apparmor and ansible_apparmor.status == "enabled"
      vars:
        ansible_python_interpreter: /usr/bin/python3

    - name: set apparmor enforcing mode
      ansible.posix.systemctl:
        name: apparmor
        state: started
        enforcing: yes


