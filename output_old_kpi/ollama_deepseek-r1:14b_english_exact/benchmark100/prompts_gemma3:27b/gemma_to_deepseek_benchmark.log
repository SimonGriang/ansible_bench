usr/bin/java {{ java_version }} /usr/local/java/jre/bin/java\n  when: \n    - java_format == "targz"\n    - ansible_distribution != \'Alpine\'\n    - java_vendor == "oracle"\n  become: yes\n\n- name: Find JAVA_HOME\n  shell: readlink -f /usr/bin/java | xargs dirname\n  register: java_home_result\n  become: yes\n\n- name: Set JAVA_HOME in /etc/environment\n  file:\n    path: /etc/profile.d/java_home.sh\n    content: export JAVA_HOME="{{ java_home_result.stdout }}"\n    mode: 755\n    create: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T15:39:42.183992868Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20278006343, 'load_duration': 79987255, 'prompt_eval_count': 1479, 'prompt_eval_duration': 355906627, 'eval_count': 1146, 'eval_duration': 19841242133, 'model_name': 'deepseek-r1:14b'} id='run--485b9f5a-101a-4b31-9d52-1e097cc03e99-0' usage_metadata={'input_tokens': 1479, 'output_tokens': 1146, 'total_tokens': 2625}
