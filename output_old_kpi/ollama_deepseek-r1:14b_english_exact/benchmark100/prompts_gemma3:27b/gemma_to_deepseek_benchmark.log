---
- name: Enable the Backports repository for Debian
  apt_repository:
    repo: "deb http://mirrors.debian.org/debian-backports/ {{ ansible_distribution_version }} main"
    filename: "backports-{{ ansible_distribution_version }}.list"
    state: present
  apt_update: true
  when: ansible_distribution_version|int < 9

- name: Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: "backports-{{ ansible_distribution_version }}"
  when: ansible_distribution_version|int < 9

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    release: "{{ ansible_default_release }}"


