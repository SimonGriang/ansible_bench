---
- name: create ssl key
  community.crypto.openssl_privatekey:
    path: "{{ openssl_key_directory }}/ssl.key"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: create ssl csr
  community.crypto.openssl_csr:
    path: "{{ openssl_csr_directory }}/ssl.csr"
    privatekey_path: "{{ openssl_key_directory }}/ssl.key"
    common_name: "{{ item.common_name }}"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items: "{{ ssl_csr_config }}"

- name: create ssl certificates
  community.crypto.x509_certificate:
    path: "{{ openssl_crt_directory }}/ssl.crt"
    privatekey_path: "{{ openssl_key_directory }}/ssl.key"
    csr_path: "{{ openssl_csr_directory }}/ssl.csr"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ openssl_key_directory }}/ssl.p12"
    friendly_name: "{{ item.name }}"
    privatekey_path: "{{ openssl_key_directory }}/ssl.key"
    certificate_path: "{{ openssl_crt_directory }}/ssl.crt"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items: "{{ pkcs12_config }}"

- name: read private key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/ssl.key"
    dest: /dev/null
    register: openssl_private_key

- name: read certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/ssl.crt"
    dest: /dev/null
    register: openssl_certificate

- name: create combined private_key and certificate file
  ansible.builtin.copy:
    content: "{{ openssl_private_key.content | b64decode | trim() }}{{ '\n' }}{{ openssl_certificate.content | b64decode | trim() }}"
    dest: "{{ openssl_key_directory }}/ssl.keycrt"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"


