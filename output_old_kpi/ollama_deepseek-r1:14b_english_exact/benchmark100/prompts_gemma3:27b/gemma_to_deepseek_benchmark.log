---
- name: gather_facts | Lookup bootstrap facts
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ (bootstrap_facts.stdout | regex_search('PRETTY_NAME=".*? (\\d+).*') | first) | int }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when:
    - bootstrap_facts.rc == 0
    - not (bootstrap_distribution is defined)
    - ("{{ item.value }}" in bootstrap_facts.stdout)
  vars:
    bootstrap_search: "{{ item.value }}"
  with_items: "{{ bootstrap_os_family_map.items() }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when: bootstrap_distribution is in item.value
  loop_control:
    label: "{{ item.key }}"


