---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0755
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_install_script }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0755
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0755
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts (remote first, fallback local)
  block:
    - name: Try downloading RKE2 artifacts remotely
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: 0755
      ignore_errors: yes
      register: download_remote_artifacts

    - name: Download locally if remote failed
      get_url:
        url: "{{ local_rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: 0755
      when: download_remote_artifacts.failed

  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_rke2_artifacts }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0755
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0755
  loop: "{{ additional_image_tarballs | default([]) }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item }}"
    state: file
    mode: "{{ item_permissions | default('0644') }}"
  loop: "{{ rke2_artifacts_files | default([]) }}"

- name: Populate service facts
  ansible.builtin.fact_path:
    path: /etc/service/*

- name: Get stats of the FS object
  file.stat:
    path: /usr/local

- name: Check if separate partition
  shell: "df /usr/local | grep -q '/usr/local on /dev'"
  register: is_separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }} version"
  register: rke2_version

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout }}"
    rke2_running_version: "{{ rke2_version.stdout }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "rke2InstalledVersion is version or downgrade_allowed"

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }} install --config={{ rke2_config_file }}"
  environment: "{{ rke2_install_env }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_dir }}/"
    dest: "{{ rke2_data_dir }}/manifests"
    recursive: yes

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_dir }}/"
    dest: "{{ rke2_agent_dir }}/staticPods"
    recursive: yes

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_dest }}"
    mode: 0644


