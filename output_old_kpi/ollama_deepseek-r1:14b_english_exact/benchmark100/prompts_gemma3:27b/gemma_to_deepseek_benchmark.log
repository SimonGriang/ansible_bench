- name: Copy ca.crt and ta.key to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/
    remote_src: yes
    files:
      - ca.crt
      - ta.key
    mode: 640

- name: Place the server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: 640
  notify: Restart openvpn


