---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  remote_host: localhost

- name: Pre-configure debian systems
  debconf_set:
    name: postfix
    question: postfix/mailname
    value: 'localhost'
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_use_virtual_MAILBOXES or postfix_use_virtual_DOMAINS

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: postfix
    group: postfix
    mode: 0644
  notify: postfix_validate
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: postfix
    group: postfix
    mode: 0644
  notify: postfix_validate
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_maincf_content: "{{ lookup('template', 'main.cf.j2') | combine({ 'smtp_sasl_password_maps': 'hash:/etc/postfix/sasl_password_map' if postfix_sasl_password_map else '' }) }}"
  when: postfix_maincf_template is defined or postfix_sasl_password_map is defined

