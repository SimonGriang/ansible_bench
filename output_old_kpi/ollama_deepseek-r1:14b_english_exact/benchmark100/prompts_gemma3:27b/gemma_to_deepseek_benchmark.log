---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    host: localhost
    run_once: true

- name: Install required software
  ansible.builtin.apt:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements is defined and users_requirements is not empty

- name: Loop over users_groups
  ansible.builtin.include_tasks:
    file: group.yml
    loop: "{{ users_groups }}"
    loop_var: group
    label: "{{ group.name }}"
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: "##includedir={{ users_sudo_includedir }}"
    create: true
    create_mode: '0644'
  when: users_sudo_includedir is defined

- name: Loop over users
  ansible.builtin.include_tasks:
    file: user.yml
    loop: "{{ users }}"
    loop_var: user
    label: "{{ user.name }}"
  when: users is defined

- name: Manage cron permission
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow is true

- name: Check existence of /etc/cron.allow
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is false

