---
- name: Import assert.yml
  ansible.legacy.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: /etc/mysql/{{ mysql_name }}.cnf
  notify: Restart mysql server

- name: Configure mysql client
  ansible.builtin.template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: /etc/mysql/{{ mysql_name }}-client.cnf
    mode: '0640'

- name: Initialize mysql
  ansible.builtin.command:
    command: "{{ mysql_initialize_command }}"
    when: distribution in ['Alpine', 'Archlinux']
    become: true

- name: Start and enable mysql
  ansible.builtin.systemctl:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: all privileges
    host: "{{ item.host }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true


