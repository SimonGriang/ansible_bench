---
- import_tasks: assert.yml
  only: true
  localhost: true

- block:
    - name: Install using package
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ hashicorp_products }}"
      label: "{{ item }}"
  when: hashicorp_installation_method == 'package'

- name: Install repository for RedHat
  get_url:
    url: "https://releases.hashicorp.com/{{ item.product }}/hashicorp.repo"
    dest: "/etc/yum.repos.d/hashicorp.repo"
    mode: 0640
  when: ansible_os_family in ['RedHat', 'Rocky']

- block:
    - name: Configure debian
      apt:
        state: present

    - name: Install required package gpg
      apt:
        name: gpg
        state: present

    - name: Install apt key for Debian
      apt_key:
        key: "https://apt.releases.hashicorp.com/GPG-KEY-HASHICORP-2023"
        state: present
        validate_certs: no

    - name: Install repository for Debian
      apt_repository:
        repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] https://apt.releases.hashicorp.com/{{ item.product }} {{ ansible_distribution_release }}"
        state: present
      loop: "{{ hashicorp_products }}"
  when: ansible_os_family == "Debian"

- block:
    - name: Install hashicorp product using package
      apt:
        name: "{{ item.product }}"
        state: present
      loop: "{{ hashicorp_products }}"
      label: "{{ item.product }}"
      when: hashicorp_products

    - name: Install latest hashicorp product using package
      apt:
        name: "{{ item.product }}"
        state: latest
      loop: "{{ hashicorp_products }}"
      label: "{{ item.product }}"

    - name: Install versioned hashicorp product using package
      apt:
        name: "{{ item.product }}{{ version_coupler }}{{ item.version if item.version is defined else '' }}"
        state: present
      loop: "{{ hashicorp_products }}"
      label: "{{ item.product }}"
  when: hashicorp_products is defined

- block:
    - name: Install manually
      unarchive:
        remote_src: true
        src: "{{ hashicorp_src }}"
        dest: "{{ hashicorp_dest_dir }}"
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
      loop: "{{ hashicorp_products }}"
      label: "{{ item }}"
  when: hashicorp_installation_method == 'manual'


