---
- name: Remove old Docker apt key file
  file:
    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent
    remote_src: no

- name: Remove old Docker source list file
  file:
    path: /etc/apt/sources.list.d/{{ docker_apt_ansible_distribution }}
    state: absent
    remote_src: no

- name: Remove obsolete Docker packages
  apt:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent
    remote_src: no

- name: Install Docker dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Manage Docker repository
  deb822_repository:
    filename: "{{ docker_apt_filename }}"
    repo: "{{ docker_repo_url }}"
    state: "{{ docker_add_repo | default('present') }}"
    distributions: "{{ ansible_facts.distribution }}"
    codenames: "{{ ansible_facts.distribution_release }}"
    components: "{{ docker_apt_release_channel }}"
    key: "{{ docker_apt_gpg_key }}"
    notify: apt update

- name: Flush handlers
  meta:
    flush_handlers: true


