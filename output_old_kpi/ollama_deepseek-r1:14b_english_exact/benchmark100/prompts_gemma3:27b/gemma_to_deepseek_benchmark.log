---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: 0755
    owner: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    remote_src: true
    dest: /etc/rancher/rke2/config.yaml
    mode: 0644
    owner: rancher
  notify: rke2_config_handler

- name: Copy kubelet config
  copy:
    remote_src: true
    dest: /etc/rancher/rke2/kubelet.yaml
    mode: 0644
    owner: rancher
  when: rke2_kubelet_config | length > 0
  notify: rke2_config_handler

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: true
    dest: /etc/rancher/rke2/registry.yaml
    mode: 0644
    owner: rancher
  when:
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs | length > 0
  notify: rke2_config_handler

- name: Start RKE2 service on the rest of the nodes
  service:
    name: rke2
    state: started
    enabled: yes
    retries: 3
    delay: 10s
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  register: service_result
  notify: rke2_service_handler

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: "{{ item }}"
    state: masked
    enabled: no
  loop: "{{ lookup('ansible.utils.listify', rke2_mask_services) }}"
  when: rke2_type in ['server', 'agent']

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o json | jq -r '.items[].status.conditions[] | select(.type == "Ready") | .status' | grep -q 'True'
  until: |
    kubectl get nodes -o json | jq -r '.items[].status.conditions[] | select(.type == "Ready") | .status' | grep -q 'True'
  retries: 30
  delay: 10
  when: rke2_cni == 'none' and (ansible_hostname == rke2_active_server or ansible_hostname == rke2_server_1)

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes -l '!node-role.kubernetes.io/master'
    | grep -c 'Ready'
  until: |
    kubectl get nodes -l '!node-role.kubernetes.io/master' | grep -c 'Ready' | awk '{print $1}' | egrep '^(node_count)'
  retries: 30
  delay: 10
  when: rke2_cni != 'none' and (ansible_hostname == rke2_active_server or ansible_hostname == rke2_server_1)


