---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost
  become: false

- name: Install required packages
  yum:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  ansible.builtin.command: selinux --status
  changed_when: false
  register: selinux_status
  ignore_errors: yes
  delegate_to: localhost

  vars:
    is_selinux_installed: "{{ selinux_status.stdout | bool }}"

  when:
    - is_selinux_installed
    - ansible_connection != 'docker'
    - ansible_connection != 'containerd'
    - ansible_connection != 'podman'

  blocks:
    - name: Set SELinux state
      command: "{{ item.state }} selinux"
      args:
        state: "{{ selinux_state }}"
      notify: Reboot
      delegate_to: localhost
      become: true
      become_user: root
      ignore_errors: yes
      register: selinux_state_result
      when: selinux_status.stdout | bool

    - name: Set SELinux policy
      semodule:
        name: "{{ item.policy }}"
        state: "{{ selinux_policy }}"
      delegate_to: localhost
      become: true
      become_user: root
      notify: Reboot
      when: selinux_status.stdout | bool

- name: Manage selinux booleans
  when: selinux_booleans is defined
  loop: "{{ selinux_booleans | dictitems() }}"
  loop_control:
    loop_var: boolean
  vars:
    boolean_name: "{{ boolean.0 }}"
    boolean_value: "{{ boolean.1 }}"
  block:

    - name: Set boolean value
      setsebool:
        name: "{{ boolean_name }}"
        state: "{{ boolean_value | default('yes') }}"
      delegate_to: localhost
      become: true
      become_user: root
      ignore_errors: yes

    - name: Enable persistence if defined
      semodule:
        name: "{{ boolean_name }}"
        persist: yes
      delegate_to: localhost
      become: true
      become_user: root
      when: boolean.1.persist | default(false)


