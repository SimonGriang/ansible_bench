---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  register: assertions
  changed_when: false
  failed_when: false
  ignore_errors: yes
  once: true

- name: Install requirements
  become: yes
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements | default([]) }}"

- name: Set sysctl setting
  become: yes
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    set: "{{ sysctl_set | default('true') }}"
    reload: "{{ sysctl_reload | default('true') }}"
  loop: "{{ sysctl_items | default([]) }}"
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
    - not containerized
  register: sysctl_settings
  changed_when: result.rc != 0


