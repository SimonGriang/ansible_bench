---
- name: Import assert.yml
  import_playbook:
    - assert.yml
  run_once: true
  host: localhost

- name: Install php
  apt:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  command: "{{ php_ini_command }}"
  register: php_found_ini_location
  when: php_ini_location is not defined
  changed_when: false

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: 0644
  notify: Restart httpd
  when: php_ini_location is not defined or php_ini_location is defined


