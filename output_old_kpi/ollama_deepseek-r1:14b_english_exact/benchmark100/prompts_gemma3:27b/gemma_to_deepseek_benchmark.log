- name: Generate Diffie-Hellman parameters
  ansible.builtin.command:
    cmd: easyrsa gen-dh
    chdir: /etc/openvpn/easy-rsa
  when: >
    not file.exists('/etc/openvpn/easy-rsa/pki/dh.pem')

- name: Build the server certificate
  ansible.builtin.command:
    cmd: EASYRSA_BATCH=yes easyrsa build-server-full server nopass
    chdir: /etc/openvpn/easy-rsa
  when: >
