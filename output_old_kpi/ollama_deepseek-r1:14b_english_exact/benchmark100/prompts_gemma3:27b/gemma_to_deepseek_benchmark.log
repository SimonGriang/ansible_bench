d Docker packages\n  apt:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n  when:\n    - ansible_facts.packages is defined\n    - docker_obsolete_packages is defined\n  tags:\n    - docker\n  become: true\n\n- name: Remove old Docker packages (YUM based systems)\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n  when:\n    - ansible_facts.packages is defined\n    - docker_obsolete_packages is defined\n    - ansible_os_family == "RedHat"\n  tags:\n    - docker\n  become: true\n\n- name: Add Docker GPG key\n  apt_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when:\n    - docker_add_repo\n  tags:\n    - docker\n  become: true\n  become_user: root\n\n- name: Add Docker GPG key (RHEL based systems)\n  rpm_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when:\n    - docker_add_repo\n    - ansible_os_family == "RedHat"\n  tags:\n    - docker\n  become: true\n  become_user: root\n\n- name: Add Docker repository\n  get_url:\n    url: "{{ docker_yum_repo_url }}"\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    mode: 0644\n    remote_src: yes\n  when:\n    - docker_add_repo\n  tags:\n    - docker\n  become: true\n  become_user: root\n\n- name: Set ownership and permissions for Docker repo file\n  file:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    owner: "root"\n    group: "root"\n    mode: 0644\n  when:\n    - docker_add_repo\n  tags:\n    - docker\n  become: true\n  become_user: root\n\n- name: Configure Docker Nightly repo\n  lineinfile:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    line: "enabled={{ docker_yum_repo_enable_nightly }}"\n    state: present\n    create: yes\n  when:\n    - docker_add_repo\n  tags:\n    - docker\n  become: true\n  become_user: root\n\n- name: Configure Docker Test repo\n  lineinfile:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    line: "enabled={{ docker_yum_repo_enable_test }}"\n    state: present\n    create: yes\n  when:\n    - docker_add_repo\n  tags:\n    - docker\n  become: true\n  become_user: root\n\n- name: Configure containerd on RHEL 8\n  block:\n    - name: Ensure runc is uninstalled\n      apt:\n        name: "runc"\n        state: absent\n      when: ansible_facts.distribution_major_version == 8\n      tags:\n        - containerd\n      become: true\n\n    - name: Ensure runc is uninstalled (YUM based systems)\n      yum:\n        name: "runc"\n        state: absent\n      when:\n        - ansible_facts.distribution_major_version == 8\n        - ansible_os_family == "RedHat"\n      tags:\n        - containerd\n      become: true\n\n    - name: Ensure container-selinux is installed\n      apt:\n        name: "container-selinux"\n        state: present\n        update_cache: yes\n      when: ansible_facts.distribution_major_version == 8\n      tags:\n        - containerd\n      become: true\n\n    - name: Ensure container-selinux is installed (YUM based systems)\n      yum:\n        name: "container-selinux"\n        state: present\n        update_cache: yes\n      when:\n        - ansible_facts.distribution_major_version == 8\n        - ansible_os_family == "RedHat"\n      tags:\n        - containerd\n      become: true\n\n    - name: Ensure containerd.io is installed\n      apt:\n        name: "containerd.io"\n        state: present\n        update_cache: yes\n      when: ansible_facts.distribution_major_version == 8\n      tags:\n        - containerd\n      become: true\n\n    - name: Ensure containerd.io is installed (YUM based systems)\n      yum:\n        name: "containerd.io"\n        state: present\n        update_cache: yes\n      when:\n        - ansible_facts.distribution_major_version == 8\n        - ansible_os_family == "RedHat"\n      tags:\n        - containerd\n      become: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-06T11:58:27.446167688Z', 'done': True, 'done_re