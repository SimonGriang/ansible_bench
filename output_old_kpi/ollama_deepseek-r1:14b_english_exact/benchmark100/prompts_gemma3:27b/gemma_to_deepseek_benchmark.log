---
- name: Create document roots for virtual hosts
  file:
    state: directory
    path: "{{ item.documentroot }}"
    mode: '0755'
  loop: "{{ httpd_vhosts | default([]) if httpd_vhosts | default([]) is defined and item.documentroot | default('') is defined and httpd_vhosts is not empty | default(false) }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - httpd_vhosts | default([]) is not empty

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template | default('') }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts | default([]) if httpd_vhosts | default([]) is defined }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts
  command:
    cmd: "{{ a2ensite }} {{ item.name }}"
    args:
      check: yes
  loop: "{{ httpd_vhosts | default([]) if ansible_os_family == 'Debian' | default([]) is defined }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  when:
    - ansible_os_family == 'Debian'


