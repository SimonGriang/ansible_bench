---
- name: create ssl key
  community.crypto.openssl_privatekey:
    file: "{{ openssl_key_directory }}/{{ item.name }}.key"
    state: present
    chmod: 600
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - { name: 'ssl privateKey' }

- name: create ssl csr
  community.crypto.openssl_csr:
    file: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    privatekey_file: "{{ openssl_key_directory }}/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
    state: present
    chmod: 640
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - { name: 'ssl csr', common_name: 'ansible.example.com' }

- name: create ssl certificates
  community.crypto.x509_certificate:
    file: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    privatekey_file: "{{ openssl_key_directory }}/{{ item.name }}.key"
    csr_file: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    state: present
    chmod: 640
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - { name: 'ssl certificate' }

- name: create PKCS#12 file
  community.crypto.openssl_pkcs12:
    file: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    friendly_name: "{{ item.name }}"
    privatekey_file: "{{ openssl_key_directory }}/{{ item.name }}.key"
    certificate_file: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    state: present
    chmod: 600
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - { name: 'ssl pkcs12' }

- name: read private key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
    dest: "{{ item.name }}_key-content"
  register: openssl_private_key
  loop:
    - { name: 'ssl privateKey' }

- name: read certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    dest: "{{ item.name }}_crt-content"
  register: openssl_certificate
  loop:
    - { name: 'ssl certificate' }

- name: create combined private_key and certificate file
  ansible.builtin.copy:
    content: |
      {{ openssl_private_key.decode('utf-8') }}
      {{ openssl_certificate.decode('utf-8') }}
    dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
    mode: 600
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - { name: 'ssl combined' }


