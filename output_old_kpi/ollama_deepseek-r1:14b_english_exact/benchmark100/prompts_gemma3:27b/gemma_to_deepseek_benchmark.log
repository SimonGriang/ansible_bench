---
- name: Import assert.yml
  import_tasks: assert.yml
  loop:
    - dummy
  delegate_to: localhost
  run_once: true

- name: Install dns packages
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create DNS directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dir_mode }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: true
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: rndc-confgen -a -f /tmp/rndc.key && mv /tmp/rndc.key "{{ dns_confdir }}rndc.key"
  creates: "{{ dns_confdir }}rndc.key"

- name: Set permissions on rndc.key
  file:
    path: "{{ dns_confdir }}rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_key_mode }}"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: "{{ item.template }}"
    dest: "{{ item.zone_file }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_zone_mode }}"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Validate zone file
  command: named-checkzone "{{ item.domain }}" "{{ item.zone_file }}"
  loop: "{{ dns_zones }}"

- name: Update named configuration
  template:
    src: "dns.conf.j2"
    dest: "/etc/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  notify: Restart dns

- name: Validate named configuration
  command: named-checkconf /etc/named.conf

- name: Place systemd override
  block:
    - name: Ensure override directory exists
      file:
        path: "/etc/systemd/system/{{ dns_service }}.d"
        state: directory
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: "0755"
    - name: Copy override configuration
      copy:
        src: "override.conf"
        dest: "/etc/systemd/system/{{ dns_service }}.d/override.conf"
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: "0644"
  when: ansible_system == "Linux"
  notify: Reload systemd

- name: Start and enable dns service
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


