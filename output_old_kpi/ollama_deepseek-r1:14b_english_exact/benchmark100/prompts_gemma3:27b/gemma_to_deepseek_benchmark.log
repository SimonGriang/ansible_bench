---
- name: Import assert.yml
  import_tasks: assert.yml
  register: assertions
  changed_when: false
  failed_when: false
  ignore_errors: yes
  once: true

- name: Install requirements
  become: true
  package:
    name: "{{ item }}"
    state: present
  loop: sysctl_requirements

- name: Set sysctl setting
  become: true
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    set: "{{ sysctl_set | default(false) }}"
    reload: "{{ sysctl_reload | default(true) }}"
  loop: sysctl_items
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
    - ansible_containerized is false
  register: sysctl_settings
  changed_when: result.rc != 0


