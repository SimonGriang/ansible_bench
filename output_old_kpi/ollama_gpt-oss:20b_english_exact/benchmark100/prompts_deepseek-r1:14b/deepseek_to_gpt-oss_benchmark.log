---
- name: Download RKE2 installation script
  when: airgap_mode
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'

- name: Copy local RKE2 installation script
  when: airgap_mode and implementation == 'copy'
  copy:
    src: "{{ local_install_script_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'

- name: Create RKE2 artifacts folder
  when: airgap_mode and implementation != 'exists'
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0700'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0640'
        checksum: "{{ rke2_checksum }}"
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"
        mode: '0640'
        checksum: "{{ rke2_artifact_checksum }}"
  rescue:
    - name: Copy local checksum file
      copy:
        src: "{{ local_checksum_path }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0640'
    - name: Copy local RKE2 artifact
      copy:
        src: "{{ local_artifact_path }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"
        mode: '0640'

- name: Copy local RKE2 artifacts
  when: airgap_mode and implementation == 'copy'
  copy:
    src: "{{ local_artifact_path }}"
    dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"
    mode: '0640'
    remote_src: true

- name: Airgap mode - additional images tarballs
  when: airgap_mode and additional_tarballs | length > 0
  block:
    - name: Ensure additional images directory exists
      file:
        path: "{{ rke2_artifacts_path }}/additional_images"
        state: directory
        mode: '0755'
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_artifacts_path }}/additional_images/"
        mode: '0644'
        recurse: true
      loop: "{{ additional_tarballs }}"

- name: Copy local RKE2 artifacts
