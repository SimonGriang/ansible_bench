- name: Set OS and architecture specific variables (II)
  set_fact:
    openjdk_install_path: "{{ openjdk_install_path | default('/usr/lib/jvm') }}"
    openjdk_package_name: "{{ openjdk_package_name | default('openjdk-{{ openjdk_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ openjdk_install_path }}/{{ openjdk_package_name }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop:
        - "ppa:deadsnakes/ppa"
        - "deb http://archive.ubuntu.com/ubuntu {{ ansible_distribution_release }} main"
    - name: Install extra apt tools
      apt:
        name:
          - gnupg
          - apt-transport-https
        state: present
        update_cache: yes
    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop:
        - "https://packages.adoptium.net/artifactory/api/gpg/key/public"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop:
        - "deb https://packages.adoptium.net/artifactory/deb stable main"
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        state: present
        key: "https://packages.adoptium.net/artifactory/api/gpg/key/public"
    - name: Add required repositories
      yum_repository:
        name: "adoptium"
        description: "Adoptium"
        baseurl: "https://packages.adoptium.net/artifactory/rpm/centos/{{ ansible_distribution_major_version }}/x86_64"
        enabled: yes
        gpgcheck: yes
        gpgkey: "https://packages.adoptium.net/artifactory/api/gpg/key/public"
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ openjdk_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ openjdk_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ openjdk_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    mode: '0644'
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java < 11
  shell: update-alternatives --set java {{ java_home }}/jre/bin/java
  when: openjdk_version | int < 11

- name: Correct java version selected for Java >= 11
  shell: update-alternatives --set java {{ java_home }}/bin/java
  when: openjdk_version | int >= 11
```


