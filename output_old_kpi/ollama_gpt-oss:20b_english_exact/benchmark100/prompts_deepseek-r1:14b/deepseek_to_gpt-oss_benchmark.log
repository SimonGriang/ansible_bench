- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - {path: "{{ dns_data_dir }}", mode: "0755"}
    - {path: "{{ dns_conf_dir }}", mode: "0755"}

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    system: true
    groups: "{{ dns_group }}"
    state: present

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -c {{ dns_conf_dir }}/rndc.key -k rndc-key
  args:
    creates: "{{ dns_conf_dir }}/rndc.key"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_conf_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_conf_dir }}/named.root"
    mode: "0644"
  when: dns_caching_dns

- name: Create zone file
  ansible.builtin.template:
    src: "zones/{{ item.name }}.j2"
    dest: "{{ dns_data_dir }}/{{ item.name }}.zone"
    mode: "0644"
    validate: "named-checkzone -z -f -v -c - %s"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  ansible.builtin.template:
    src: "dns.conf.j2"
    dest: "{{ dns_conf_dir }}/named.conf"
    mode: "0644"
  notify: Restart dns

- name: Place systemd override
  ansible.builtin.template:
    src: "override.conf.j2"
    dest: "/etc/systemd/system/bind9.service.d/override.conf"
    mode: "0644"
  when: ansible_service_mgr == "systemd"
  notify: systemd daemon-reload

- name: Start and enable dns
  ansible.builtin.service:
    name: bind9
    state: started
    enabled: true


