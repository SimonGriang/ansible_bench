    state: directory
    owner: "{{ item.owner | default(promtail_user_name) }}"
    group: "{{ item.group | default(promtail_group_name) }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ promtail_config_dirs }}"

- name: Create application directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default(promtail_user_name) }}"
    group: "{{ item.group | default(promtail_group_name) }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ promtail_app_dirs }}"

- name: Check promtail binary existence
  stat:
    path: "{{ promtail_bin_dir }}/promtail"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip"
    checksum: "{{ promtail_checksum }}"
  when: not promtail_binary.stat.exists

- name: Propagate local promtail binaries
  copy:
    src: "{{ promtail_local_binary_path }}"
    dest: "{{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip"
    mode: '0644'
  when: not promtail_binary.stat.exists

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip"
    checksum: "{{ promtail_checksum }}"
  delegate_to: localhost
  when: inventory_hostname == groups['controller'][0]

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip"
    dest: "{{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip"
    mode: '0644'
  delegate_to: localhost
  when: inventory_hostname == groups['controller'][0]

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip"
    dest: "{{ promtail_bin_dir }}"
    remote_src: yes
    mode: '0755'

- name: Create symlink to latest promtail version
  file:
    src: "{{ promtail_bin_dir }}/promtail-{{ promtail_version }}"
    dest: "{{ promtail_bin_dir }}/promtail"
    state: link
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail.conf.j2
    dest: "{{ promtail_config_dir }}/promtail.conf"
    owner: "{{ promtail_user_name }}"
    group: "{{ promtail_group_name }}"
    mode: '0644'
  notify: restart promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail

