---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux booleans
  seboolean:
    name: "{{ item }}"
    state: true
    persistent: true
  loop: "{{ httpd_sebooleans }}"
  when: ansible_selinux.status == 'enabled'

- name: Configure SELinux ports
  seport:
    ports: "{{ item }}"
    proto: tcp
    state: present
  loop: "{{ httpd_port | default([]) + httpd_ssl_port | default([]) }}"
  when: ansible_selinux.status == 'enabled'

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - configuration test
    - service restart

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
    mode: '0644'
  notify:
    - configuration test
    - service restart
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


