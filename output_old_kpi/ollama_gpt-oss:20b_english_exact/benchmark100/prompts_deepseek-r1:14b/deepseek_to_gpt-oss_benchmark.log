---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  command: helm version --short
  register: helm_existing_version
  ignore_errors: yes

- name: Download helm
  unarchive:
    src: https://get.helm.sh/helm-v{{ desired_helm_version }}-linux-amd64.tar.gz
    dest: /tmp/helm-{{ desired_helm_version }}
    remote_src: yes
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout != desired_helm_version

- name: Copy helm binary into place
  copy:
    src: /tmp/helm-{{ desired_helm_version }}/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: '0755'
  become: yes
  when: helm_download.changed


