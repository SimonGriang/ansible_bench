    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - Test httpd config
    - Restart httpd
  when: ansible_facts['os_family'] in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example | default(false)

- name: Start and enable httpd
  service:
    name: "{{ httpd_service_name | default('httpd') }}"
    state: started
    enabled: true


