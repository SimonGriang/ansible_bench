    dest: "/etc/containerd/config.toml"
    mode: '0644'
  when: custom_registry_path is defined
  notify: restart containerd

- name: Start RKE2 service on other nodes
  service:
    name: rke2-server
    state: started
    enabled: true
  when: node_type != 'agent'
  notify: restart rke2

- name: Mask other RKE2 services on nodes
  service:
    name: "{{ 'rke2-agent' if node_type == 'server' else 'rke2-server' }}"
    state: masked
  notify: restart rke2

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes --no-headers | grep -v Ready | wc -l
  register: node_ready
  until: node_ready.stdout | int == 0
  retries: 30
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes -o \
    jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' \
    | tr -d '[:space:]'
  register: node_ready_cni
  until: node_ready_cni.stdout | regex_replace('\\s+', '') == "TrueTrue"
  retries: 30
  delay: 10


