---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: /etc/my.cnf
    regexp: "^{{ item.key }}\\s*="
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  loop: "{{ mysql_configuration_options | dict2items }}"
  notify: Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: /etc/my.cnf
    regexp: "^socket\\s*="
    line: "socket = /var/run/mysqld/mysqld.sock"
    create: yes

- name: Initialize mysql
  command: mysql_install_db --user=mysql
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    login_user: root
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


