---
- name: locations | Enable modules
  apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family in ['Debian', 'Suse']

- name: locations | Configure locations
  template:
    src: "templates/httpd_location.j2"
    dest: "/etc/apache2/sites-available/{{ item.name }}.conf"
    mode: "0644"
  loop: "{{ httpd_locations }}"
  notify:
    - httpd config test
    - httpd restart


