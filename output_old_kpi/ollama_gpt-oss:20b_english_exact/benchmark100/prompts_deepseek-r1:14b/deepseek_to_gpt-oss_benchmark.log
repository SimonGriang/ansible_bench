---
- name: Remove Docker GPG key from trusted.gpg.d directory
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker source list from sources.list.d directory
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove obsolete Docker packages
  apt:
    name:
      - docker-ce
      - docker-ce-cli
      - containerd.io
    state: absent
    purge: yes
    autoremove: yes

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker-legacy.list
    state: absent

- name: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Manage Docker repository
  deb822_repository:
    name: docker
    types: deb
    uris: https://download.docker.com/linux/ubuntu
    suites: "{{ ansible_distribution_release }}"
    components: stable
    signed_by: /usr/share/keyrings/docker-archive-keyring.gpg
    state: "{{ 'present' if docker_add_repo else 'absent' }}"

- name: Flush handlers to update apt cache
  meta: flush_handlers


