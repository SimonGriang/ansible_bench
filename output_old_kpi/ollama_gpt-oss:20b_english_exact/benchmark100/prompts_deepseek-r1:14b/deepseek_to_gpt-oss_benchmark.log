- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'Internet Site'
    vtype: string

- name: Install postfix
  ansible.builtin.apt:
    name: postfix
    state: present
    update_cache: true

- name: Install postfix-mysql
  ansible.builtin.apt:
    name: postfix-mysql
    state: present
    update_cache: true

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate_postfix_transport_maps

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify:
    - reload_postfix

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_maincf_1: {}

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_maincf_2: {}

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate_postfix_maincf

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate_postfix_mastercf

- name: Creates cert/key directory
  ansible.builtin.file:
    path: /etc/postfix/ssl
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: server.crt
    dest: /etc/postfix/ssl/server.crt
    owner: root
    group: root
    mode: '0644'
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: server.key
    dest: /etc/postfix/ssl/server.key
    owner: root
    group: root
    mode: '0600'
  notify:
    - reload_postfix

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    state: present
  loop: "{{ aliases }}"
  notify:
    - rebuild_aliases
    - reload_postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item }}"
    state: present
  loop: "{{ sender_access }}"
  notify:
    - rebuild_sender_access
    - reload_postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item }}"
    state: present
  loop: "{{ recipient_access }}"
  notify:
    - validate_recipient_access
    - rebuild_recipient_access
    - reload_postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_passwd
    owner: root
    group: root
    mode: '0600'
  notify:
    - rebuild_sasl_passwd

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true


