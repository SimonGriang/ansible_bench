    promtail_version: "{{ lookup('pipe', 'curl -s https://api.github.com/repos/grafana/loki/releases/latest | grep -oP \\"tag_name\\":\\s*\\\"\\K[^\\\"]+' ) | regex_replace('^v', '') }}"

- name: Test if zip local archive exists and assert local binary exists
  block:
    - name: Check for local archive
      stat:
        path: "{{ local_directory }}/promtail.zip"
      register: local_archive
      when: local_directory is defined
    - name: Assert local binary archive exists
      assert:
        that:
          - local_archive.stat.exists
        fail_msg: "Local binary archive not found at {{ local_directory }}/promtail.zip"
      when: local_directory is defined

- name: Get checksum list and set checksum for target architecture
  block:
    - name: Fetch checksum file
      uri:
        url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/loki-linux-{{ ('amd64' if ansible_architecture == 'x86_64' else ('arm64' if ansible_architecture == 'aarch64' else ansible_architecture)) }}.zip.sha256"
