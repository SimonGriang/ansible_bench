---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: yes
  loop: "{{ httpd_selinux_booleans }}"
  when: ansible_selinux.status == "enabled"

- name: Allow httpd ports
  seport:
    ports: "{{ httpd_selinux_ports }}"
    proto: tcp
    setype: http_port_t
    state: present
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_conf_src }}"
