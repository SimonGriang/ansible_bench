    mode: '0700'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0640'
        checksum: "{{ rke2_checksum }}"
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"
        mode: '0640'
        checksum: "{{ rke2_artifact_checksum }}"
  rescue:
    - name: Copy local checksum file
      copy:
        src: "{{ local_checksum_path }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0640'
    - name: Copy local RKE2 artifact
      copy:
        src: "{{ local_artifact_path }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"
        mode: '0640'

- name: Copy local RKE2 artifacts
  when: airgap_mode and implementation == 'copy'
  copy:
    src: "{{ local_artifact_path }}"
    dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"
    mode: '0640'
    remote_src: yes

- name: Airgap mode - additional images tarballs
  when: airgap_mode and additional_tarballs | length > 0
  block:
    - name: Create additional images directory
      file:
        path: "{{ additional_images_dir }}"
        state: directory
        mode: '0700'
    - name: Copy additional image tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ additional_images_dir }}/{{ item | basename }}"
        mode: '0640'
      loop: "{{ additional_tarballs }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  when: airgap_mode and implementation == 'exists'
  block:
    - name: Set artifacts permissions to read-only
      file:
        path: "{{ rke2_artifacts_path }}"
        recurse: yes
        mode: '0444'
    - name: Set install script executable
      file:
        path: "{{ rke2_install_script_path }}"
        mode: '0755'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: fs_local

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {% if fs_local.stat.writable and fs_local.stat.mount is defined %}
      /usr/local/bin/rke2
      {% else %}
      /usr/bin/rke2
      {% endif %}

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} --version"
  register: rke2_version_output

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_version_output.stdout | regex_replace('[^0-9.]', '') >= rke2_current_version
    fail_msg: "RKE2 downgrade detected. Please set allow_downgrade=true to proceed."

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_path }} {{ install_script_args | default('') }}"
  environment:
    AIRGAP: "{{ airgap_mode | string }}"
  args:
    executable: /bin/bash

- name: Copy Custom Manifests
  template:
    src: custom_manifests.j2
    dest: "{{ rke2_manifests_dir }}/custom_manifests.yaml"

- name: Copy Static Pods
  copy:
    src: static_pods/
    dest: "{{ rke2_agent_pod_manifests_dir }}/"
    mode: '0644'
    recurse: yes

- name: Copy RKE2 environment file
  when: rke2_env_options is defined
  template:
    src: rke2.env.j2
    dest: "{{ rke2_env_path }}"
    mode: '0640'


