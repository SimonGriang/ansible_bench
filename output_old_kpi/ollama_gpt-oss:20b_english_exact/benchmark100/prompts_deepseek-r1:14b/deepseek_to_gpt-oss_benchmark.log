```yaml
# tasks/main.yml
- name: "Task 1: Set the package state based on how Ansible is installed."
  ansible.builtin.set_fact:
    ansible_package_state: >-
      "{{ ansible_pkg_mgr is defined | ternary('present', 'absent') }}"

- name: "Task 2: Set up Ansible on RedHat."
  ansible.builtin.include_tasks: setup-RedHat.yml
  when:
    - ansible_os_family == 'RedHat'
    - ansible_distribution != 'Fedora'
    - ansible_package_state == 'present'

- name: "Task 3: Set up Ansible on Fedora."
  ansible.builtin.include_tasks: setup-Fedora.yml
  when:
    - ansible_distribution == 'Fedora'
    - ansible_package_state == 'present'

- name: "Task 4: Set up Ansible on Ubuntu."
  ansible.builtin.include_tasks: setup-Ubuntu.yml
  when:
    - ansible_distribution == 'Ubuntu'
    - ansible_package_state == 'present'

- name: "Task 5: Set up Ansible on Debian."
  ansible.builtin.include_tasks: setup-Debian.yml
  when:
    - ansible_distribution == 'Debian'
    - ansible_package_state == 'present'

- name: "Task 6: Set up Ansible using Pip."
  ansible.builtin.include_tasks: setup-pip.yml
  when:
    - ansible_package_state == 'absent'
```

```yaml
# tasks/setup-RedHat.yml
- name: Install required packages on RedHat
  ansible.builtin.package:
    name:
      - epel-release
      - ansible
    state: present
```

```yaml
# tasks/setup-Fedora.yml
- name: Install required packages on Fedora
  ansible.builtin.package:
    name:
      - ansible
    state: present
```

```yaml
# tasks/setup-Ubuntu.yml
- name: Add Ansible PPA repository
  ansible.builtin.apt_repository:
    repo: ppa:ansible/ansible
    state: present

- name: Install required packages on Ubuntu
  ansible.builtin.apt:
    name:
      - ansible
    state: present
    update_cache: true
```

```yaml
# tasks/setup-Debian.yml
- name: Add Ansible repository on Debian
  ansible.builtin.apt_repository:
    repo: deb http://apt.ansible.com/debian/ stable main
    state: present

- name: Ensure apt cache is updated
  ansible.builtin.apt:
    update_cache: true
    cache_valid_time: 3600

- name: Install required packages on Debian
  ansible.builtin.apt:
    name:
      - ansible
    state: present
```

```yaml
# tasks/setup-pip.yml
- name: Install Ansible via pip
  ansible.builtin.pip:
    name: ansible
    state: present
```


