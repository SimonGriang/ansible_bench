- name: Create the RKE2 config directory
  file:
    path: "{{ rke2_config_dir | default('/etc/rancher/rke2/config') }}"
    state: directory
    mode: '0755'
  become: true

- name: Set server taints
  shell: |
    rke2-node taint add {{ item }}
  loop: "{{ rke2_server_node_taints | default([]) }}"
  when: "'server' in group_names"
  become: true

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: "{{ rke2_config_dest | default('/etc/rancher/rke2/config.yaml') }}"
    mode: '0644'
  notify: Restart RKE2
  become: true

- name: Copy kubelet configuration file
  copy:
    content: "{{ rke2_kubelet_config }}"
    dest: "{{ rke2_kubelet_config_dest | default('/etc/rancher/rke2/kubelet-config.yaml') }}"
    mode: '0644'
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: Restart RKE2
  become: true

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: "{{ rke2_containerd_registry_config_dest | default('/etc/rancher/rke2/containerd-registry-config.yaml') }}"
    mode: '0644'
  when: rke2_containerd_registry_config_src is defined
  notify: Restart RKE2
  become: true

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file | length > 0 }}"
  become: true

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: >-
      {{ rke2_s3_options is defined and rke2_s3_options.bucket is defined and
      rke2_s3_options.key is defined }}
  become: true

- name: Restore etcd from file
  block:
    - name: Create etcd restore directory
      file:
        path: /var/lib/rancher/rke2/etcd
        state: directory
        mode: '0755'
      become: true

    - name: Copy etcd snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd/snapshot.db
        mode: '0644'
      become: true

    - name: Run etcd restore command
      command: "/usr/local/bin/rke2 server --restore-from-snapshot /var/lib/rancher/rke2/etcd/snapshot.db"
      become: true
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Download etcd snapshot from S3
      aws_s3:
        bucket: "{{ rke2_s3_options.bucket }}"
        object: "{{ rke2_s3_options.key }}"
        dest: /tmp/snapshot.db
        mode: get
      become: true

    - name: Copy snapshot to etcd directory
      copy:
        src: /tmp/snapshot.db
        dest: /var/lib/rancher/rke2/etcd/snapshot.db
        mode: '0644'
      become: true

    - name: Run etcd restore command
      command: "/usr/local/bin/rke2 server --restore-from-snapshot /var/lib/rancher/rke2/etcd/snapshot.db"
      become: true
  when: etcd_restore_from_s3

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token | default('') }}"
  notify: Restart RKE2
  become: true

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    masked: true
    state: stopped
  become: true

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 300
    state: started
  when: not rke2_cni_enabled | default(false)
  become: true

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 300
    state: started
  when: rke2_cni_enabled | default(false)
  become: true

- name: Restore etcd
  block:
    - name: Clean up old etcd data
      file:
        path: /var/lib/rancher/rke2/etcd
        state: absent
      become: true

    - name: Run etcd restore
      command: "/usr/local/bin/rke2 server --restore-from-snapshot /var/lib/rancher/rke2/etcd/snapshot.db"
      become: true
  when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    rke2_active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_cluster'] }}"
  become: true

- name: Restart RKE2
  systemd:
    name: rke2-server
    state: restarted
    enabled: true
  become: true
