---
- name: Include OS-specific variables
  include_vars:
    dir: vars
    extensions: ['yml', 'yaml']
    files_matching: "{{ ansible_distribution | lower }}.{{ ansible_os_family | lower }}.yml"

- name: Include OS family specific tasks
  include_tasks: redhat.yml
  when: ansible_os_family == "RedHat"

- name: Include OS family specific tasks
  include_tasks: debian.yml
  when: ansible_os_family == "Debian"

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode | bool }}"
  when:
    - ansible_version.full is version('2.12', '<')
    - ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode | bool }}"
  when:
    - ansible_version.full is version('2.12', '>=')
    - ansible_os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode | bool }}"
  when:
    - docker_install_compose_plugin | bool
    - ansible_version.full is version('2.12', '<')
    - ansible_os_family not in ['RedHat', 'Debian']

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode | bool }}"
  when:
    - docker_install_compose_plugin | bool
    - ansible_version.full is version('2.12', '>=')
    - ansible_os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_json }}"
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state | default('started') }}"
    enabled: "{{ docker_service_enabled | default(true) }}"
  ignore_errors: "{{ ansible_check_mode | bool }}"
  when: docker_service_manage | bool

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose | bool

- name: Get docker group information
  getent:
    database: group
    key: docker
  register: docker_group
  when: docker_users is defined

- name: Set fact for user modification
  set_fact:
    docker_users_need_modification: true
  when:
    - docker_users is defined
    - docker_users | difference(docker_group.entries[0].members) | length > 0

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: docker_users_need_modification | bool


