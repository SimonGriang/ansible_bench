      {% endif %}  

- name: Check RKE2 version  
  command: "{{ rke2_bin_path }} --version"  
  register: rke2_version_output  

- name: Prevent accidental RKE2 downgrade  
  assert:  
    that:  
      - rke2_version_output.stdout | regex_replace('[^0-9.]', '') >= rke2_current_version  
    fail_msg: "RKE2 downgrade detected. Please set allow_downgrade=true to proceed."  

- name: Run RKE2 install script  
  shell: "{{ rke2_install_script_path }} {{ install_script_args | default('') }}"  
  environment:  
    AIRGAP: "{{ airgap_mode | string }}"  
  args:  
    executable: /bin/bash  

- name: Copy Custom Manifests  
  template:  
    src: custom_manifests.j2  
    dest: "{{ rke2_manifests_dir }}/custom_manifests.yaml"  

- name: Copy Static Pods  
  copy:  
    src: static_pods/  
    dest: "{{ rke2_agent_pod_manifests_dir }}/"  
    mode: '0644'  
    recurse: yes  

- name: Copy RKE2 environment file  
  when: rke2_env_options is defined  
  template:  
    src: rke2.env.j2  
    dest: "{{ rke2_env_path }}"  
    mode: '0640'


