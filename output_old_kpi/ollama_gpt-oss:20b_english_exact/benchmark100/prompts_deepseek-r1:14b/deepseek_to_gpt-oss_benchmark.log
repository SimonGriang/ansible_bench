---
- name: Task 1: Set the package state based on how Ansible is installed.
  set_fact:
    ansible_package_state: "{{ 'present' if ansible_pkg_mgr is defined else 'absent' }}"

- name: Task 2: Set up Ansible on RedHat.
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat' and ansible_distribution != 'Fedora' and ansible_package_state == 'present'

- name: Task 3: Set up Ansible on Fedora.
