---
- name: Validate all variables are set correctly
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for host to be available
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ wait_port }}"
    timeout: "{{ wait_timeout }}"

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ansible.builtin.ping:
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install raw bootstrap packages
      ansible.builtin.raw: "{{ bootstrap_command }}"
      changed_when: false
  rescue:
    - name: Handle connection failures
      ansible.builtin.debug:
        msg: "Connection failed, skipping bootstrap"

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install packages for Debian
      ansible.builtin.apt:
        name: "{{ debian_packages }}"
        state: present
      when: ansible_os_family == 'Debian'
    - name: Install packages for RedHat
      ansible.builtin.dnf:
        name: "{{ redhat_packages }}"
        state: present
      when: ansible_os_family == 'RedHat'
---
- name: Test if 'bootstrap_user' is set correctly
  ansible.builtin.assert:
    that:
