---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}_{{ ansible_distribution | lower }}_{{ ansible_distribution_version | replace('.', '_') }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "vars/{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_version: "{{ java_version | default('11') }}"
    openjdk_repos: "{{ openjdk_repos | default([]) }}"
    openjdk_libs: "{{ openjdk_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    openjdk_install_path: "{{ openjdk_install_path | default('/usr/lib/jvm') }}"
    openjdk_package_name: "{{ openjdk_package_name | default('openjdk-' + java_version + '-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ openjdk_install_path }}/java-{{ java_version }}-{{ java_jdk_vendor }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop:
        - "deb http://old-repo.example.com/debian"
        - "deb http://deprecated.example.com/debian"
    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
          - gnupg
          - lsb-release
        state: present
        update_cache: yes
    - name: Add key repositories
      apt_key:
        url: "https://packages.example.com/temurin/gpg.key"
        state: present
    - name: Add required repositories
      apt_repository:
        repo: "deb https://packages.example.com/temurin/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} main"
        state: present
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum_repository:
        name: temurin
        description: Temurin Repository
        baseurl: https://packages.example.com/temurin/rhel/$releasever/$basearch/
        gpgkey: https://packages.example.com/temurin/gpg.key
        enabled: yes
        gpgcheck: yes
    - name: Add required repositories
      yum_repository:
        name: temurin
        description: Temurin Repository
        baseurl: https://packages.example.com/temurin/rhel/$releasever/$basearch/
        enabled: yes
        gpgcheck: yes
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ openjdk_libs }}"
  when: openjdk_libs | length > 0

- name: Install Java, Debian
  apt:
    name: "{{ openjdk_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ openjdk_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/jre/bin/java"
    priority: 2000
  when: java_version | int < 11

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/bin/java"
    priority: 2000
  when: java_version | int >= 11


