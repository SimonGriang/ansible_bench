---
- name: "Task 1: Set the package state based on how Ansible is installed."
  ansible.builtin.set_fact:
    ansible_package_state: >-
      "{{ ansible_pkg_mgr is defined | ternary('present', 'absent') }}"

- name: "Task 2: Set up Ansible on RedHat."
  ansible.builtin.include_tasks: setup-RedHat.yml
  when:
    - ansible_os_family == 'RedHat'
    - ansible_distribution != 'Fedora'
    - ansible_package_state == 'present'

- name: "Task 3: Set up Ansible on Fedora."
  ansible.builtin.include_tasks: setup-Fedora.yml
  when:
    - ansible_distribution == 'Fedora'
    - ansible_package_state == 'present'

- name: "Task 4: Set up Ansible on Ubuntu."
  ansible.builtin.include_tasks: setup-Ubuntu.yml
  when:
    - ansible_distribution == 'Ubuntu'
    - ansible_package_state == 'present'

- name: "Task 5: Set up Ansible on Debian."
  ansible.builtin.include_tasks: setup-Debian.yml
  when:
    - ansible_distribution == 'Debian'
    - ansible_package_state == 'present'

- name: "Task 6: Set up Ansible using Pip."
  ansible.builtin.include_tasks: setup-pip.yml
  when:
    - ansible_package_state == 'absent'


