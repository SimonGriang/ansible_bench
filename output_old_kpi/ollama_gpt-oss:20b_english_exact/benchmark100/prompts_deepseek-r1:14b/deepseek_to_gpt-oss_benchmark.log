- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - {path: "{{ dns_data_dir }}", mode: "0755"}
    - {path: "{{ dns_conf_dir }}", mode: "0755"}

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: true
    groups: "{{ dns_group }}"
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -c {{ dns_conf_dir }}/rndc.key -k rndc-key
  args:
    creates: "{{ dns_conf_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_conf_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_conf_dir }}/named.root"
    mode: "0644"
  when: dns_caching_dns

- name: Create zone file
  template:
    src: "zones/{{ item.name }}.j2"
    dest: "{{ dns_data_dir }}/{{ item.name }}.zone"
    validate: "named-checkzone -z -f -v -c - %s"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: "dns.conf.j2"
    dest: "{{ dns_conf_dir }}/named.conf"
  notify: Restart dns

- name: Place systemd override
  template:
    src: "override.conf.j2"
    dest: "/etc/systemd/system/bind9.service.d/override.conf"
  when: ansible_service_mgr == "systemd"
  notify: systemd daemon-reload

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: true


