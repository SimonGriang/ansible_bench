---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  changed_when: false

- name: Configure apt
  apt:
    name: '*'
    state: latest
    update_cache: yes
    dpkg_options: 'hold'
    force: yes
  environment:
    DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude:
      - package1
      - package2

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes

- name: Configure yum
  block:
    - name: Update all packages using dnf on RHEL6
      dnf:
        name: '*'
        state: latest
      when: ansible_distribution_major_version == '6'
    - name: Install yum-utils on non-RHEL6
      yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != '6'
    - name: Update all packages using yum on non-RHEL6
      yum:
        name: '*'
        state: latest
      when: ansible_distribution_major_version != '6'
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    refresh: yes


