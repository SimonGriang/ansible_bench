---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ user }}/ssh_keys"
    state: directory
    owner: "{{ user }}"
    mode: '0750'

- name: Manage user account
  user:
    name: "{{ user }}"
    state: "{{ user_state | default('present') }}"
    comment: "{{ user_comment | default('') }}"
    home: "{{ user_home | default('/home/' + user) }}"
    shell: "{{ user_shell | default('/bin/bash') }}"

- name: Set sudo options for user
  copy:
    dest: "/etc/sudoers.d/{{ user }}"
    content: "%{{ user }} ALL=(ALL) NOPASSWD:ALL"
    mode: '0440'
    owner: root
    group: root

- name: Generate private SSH key for user
  command: >
    ssh-keygen -t rsa -b 4096 -f {{ key_path }}/{{ user }}_id_rsa
    -N '' -C '{{ user }}@{{ inventory_hostname }}'
  args:
    creates: "{{ key_path }}/{{ user }}_id_rsa"

- name: Generate public SSH key for user
  shell: cat {{ key_path }}/{{ user }}_id_rsa.pub
  register: public_key

- name: Convert SSH key to ppk format for user
  command: >
    puttygen {{ key_path }}/{{ user }}_id_rsa -O private
    -o {{ key_path }}/{{ user }}.ppk
  args:
    creates: "{{ key_path }}/{{ user }}.ppk"

- name: Get or set the home directory for user
  user_info:
    name: "{{ user }}"
  register: user_info_result

- name: Set user_home fact
  set_fact:
    user_home: "{{ user_info_result.home | default('/home/' + user) }}"

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    owner: "{{ user }}"
    mode: '0700'

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user }}"
    state: present
    key: "{{ item }}"
  loop: "{{ authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ unauthorized_keys }}"

- name: Copy generated private SSH key for user
  copy:
    src: "{{ key_path }}/{{ user }}_id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    owner: "{{ user }}"
    mode: '0600'

- name: Check users password valid time for user
  command: chage -l {{ user }}
  register: password_validity

- name: Set users password valid time for user
  command: >
    chage -M {{ max_days }} -m {{ min_days }} -W {{ warn_days }}
    {{ user }}

- name: Place private key file for user
  copy:
    src: "{{ key_path }}/{{ user }}_id_rsa"
    dest: "{{ user_home }}/.ssh/{{ user }}_id_rsa"
    owner: "{{ user }}"
    mode: '0600'


