- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  getent:
    database: passwd
    key: "{{ username }}"
  register: user_check
  failed_when: false

- name: Create git config directory
  file:
    path: "{{ user_home }}/.gitconfig"
    state: directory
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig"
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0644'

- name: Create repository destination
  file:
    path: "{{ repo_dest }}"
    state: directory
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0755'

- name: Clone all repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    force: yes
  loop: "{{ repositories }}"
  become: true
  become_user: "{{ username }}"


