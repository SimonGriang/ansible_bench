- name: Import assertion tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install MySQL server packages
  ansible.builtin.package:
    name: "{{ packages }}"
    state: present
  notify:
    - set root password
    - systemctl daemon-reload

- name: Configure MySQL server
  ansible.builtin.template:
    src: mysql_server.conf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'
  notify:
    - restart mysql

- name: Configure MySQL client
  ansible.builtin.template:
    src: mysql_client.conf.j2
    dest: /etc/mysql/client.cnf
    mode: '0644'

- name: Initialize MySQL database
  ansible.builtin.command: "{{ mysql_init_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']
  changed_when: false

- name: Start and enable MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: "{{ mycnf_mode }}"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ root_password }}"
    login_unix_socket: /var/run/mysqld/mysqld.sock
  loop: "{{ databases }}"
  when: initial_import is not defined

- name: List databases
  community.mysql.mysql_db_info:
    login_user: root
    login_password: "{{ root_password }}"
    login_unix_socket: /var/run/mysqld/mysqld.sock
  register: mysql_db_list

- name: Import database
  community.mysql.mysql_db:
    state: import
    name: "{{ item.name }}"
    target: "{{ initial_import }}/{{ item.name }}.sql"
    login_user: root
    login_password: "{{ root_password }}"
    login_unix_socket: /var/run/mysqld/mysqld.sock
  loop: "{{ databases }}"
  when: item.name not in mysql_db_list.databases

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host | default('localhost') }}"
    state: present
    login_user: root
    login_password: "{{ root_password }}"
    login_unix_socket: /var/run/mysqld/mysqld.sock
  loop: "{{ mysql_users }}"
  notify: restart mysql

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


