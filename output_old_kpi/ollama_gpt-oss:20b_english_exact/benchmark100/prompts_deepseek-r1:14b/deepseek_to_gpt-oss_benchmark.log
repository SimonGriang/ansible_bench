---
- name: Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: "{{ key_path }}"
    type: rsa
    size: 2048
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ csr_path }}"
    privatekey_path: "{{ key_path }}"
    common_name: "{{ common_name }}"
    mode: "{{ csr_mode }}"

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ cert_path }}"
    privatekey_path: "{{ key_path }}"
    csr_path: "{{ csr_path }}"
    provider: selfsigned
    days: 365
    mode: "{{ cert_mode }}"

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: "{{ pkcs12_path }}"
    privatekey_path: "{{ key_path }}"
    certificate_path: "{{ cert_path }}"
    passphrase: "{{ pkcs12_passphrase }}"

- name: Read the private key content
  slurp:
