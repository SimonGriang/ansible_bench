---
- name: "Restart RKE2 service on {{ rke2_node_name}}"
  ansible.builtin.service:
    name: "{{ rke2_node_name }}"
    state: restarted
  notify: "Service (re)started"

- name: "Wait for all nodes to be ready again"
  ansible.builtin.command: "kubectl get nodes --no-headers | grep -v 'Ready' | wc -l"
  register: node_ready_check
  changed_when: false
  failed_when: node_ready_check.stdout | int > 0
  retries: 100
  delay: 15
  run_once: true
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: not ansible_check_mode

- name: "Wait for all pods to be ready again"
  ansible.builtin.command: "kubectl get pods --all-namespaces --no-headers | grep -v 'Running' | wc -l"
  register: pod_ready_check
  changed_when: false
  failed_when: pod_ready_check.stdout | int > 0
  retries: 100
  delay: 15
  run_once: true
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready


