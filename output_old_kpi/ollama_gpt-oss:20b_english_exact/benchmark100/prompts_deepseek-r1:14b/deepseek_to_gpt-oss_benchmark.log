- name: Check if EFI firmware exists on the system
  ansible.builtin.stat:
    path: /sys/firmware/efi/efivars/
  register: efi_stat

- name: Remove GRUB configuration file on EFI systems
  ansible.builtin.file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_stat.stat.isdir

- name: Install custom user template for GRUB
  ansible.builtin.template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: '0755'

- name: Add EFI password protection to GRUB
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    line: "password_pbkdf2 grub.pbkdf2.sha512.10000.XXXXX"
    state: present
    create: true
    mode: '0644'
  when: efi_stat.stat.isdir

- name: Add MBR password protection to GRUB
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    line: "password_pbkdf2 grub.pbkdf2.sha512.10000.XXXXX"
    state: present
    create: true
    mode: '0644'
  when: not efi_stat.stat.isdir

- name: Add unrestricted access to GRUB password entries
  ansible.builtin.replace:
    path: "{{ item }}"
    regexp: '^(password_pbkdf2\s+.*)$'
    replace: '\1 --unrestricted'
    mode: '0644'
  loop:
    - /etc/grub2-efi.cfg
    - /etc/grub2.cfg
  when: grub_unrestricted | default(false)


