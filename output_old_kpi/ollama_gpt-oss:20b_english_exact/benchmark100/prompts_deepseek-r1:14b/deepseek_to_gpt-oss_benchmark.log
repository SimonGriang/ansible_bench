---
- name: Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    path: /etc/cron.d/cron_env
    line: "SHELL=/bin/bash"
    state: present
  notify: restart cron

- name: Configure cron path
  lineinfile:
    path: /etc/cron.d/cron_env
    line: "PATH=/usr/local/bin:/usr/bin:/bin"
    state: present
  notify: restart cron

- name: Configure cron mailto
  lineinfile:
    path: /etc/cron.d/cron_env
    line: "MAILTO={{ cron_mailto | default('') }}"
    state: present
  notify: restart cron

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default('root') }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
---


