- name: lookup bootstrap facts (raw)
  block:
    - command: cat /etc/os-release
      register: bootstrap_facts
      changed_when: false
    - set_fact:
        ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: |
      {{ bootstrap_facts.stdout |
         regex_search('VERSION_ID="([0-9]+(?:\\.[0-9]+)?)"', '\\1') }}
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
