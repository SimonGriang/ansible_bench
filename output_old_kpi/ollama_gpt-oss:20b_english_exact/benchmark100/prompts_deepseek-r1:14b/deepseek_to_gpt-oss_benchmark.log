      copy:  
        src: "{{ local_checksum_path }}"  
        dest: "{{ rke2_checksum_path }}"  
        mode: '0640'  
    - name: Copy local RKE2 artifact  
      copy:  
        src: "{{ local_artifact_path }}"  
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"  
        mode: '0640'  

- name: Copy local RKE2 artifacts  
  when: airgap_mode and implementation == 'copy'  
  copy:  
    src: "{{ local_artifact_path }}"  
    dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_name }}"  
    mode: '0640'  
    remote_src: yes  

- name: Airgap mode - additional images tarballs  
  when: airgap_mode and additional_tarballs | length > 0  
  block:  
    - name: Create additional images directory  
      file:  
        path: "{{ additional_images_dir }}"  
        state: directory  
        mode: '0700'  
    - name: Copy additional image tarballs  
      copy:  
        src: "{{ item }}"  
        dest: "{{ additional_images_dir }}/{{ item | basename }}"  
        mode: '0640'  
      loop: "{{ additional_tarballs }}"  

- name: Airgap mode - ensure artifacts exist and have acceptable permissions  
  when: airgap_mode and implementation == 'exists'  
  block:  
    - name: Set artifacts permissions to read-only  
      file:  
        path: "{{ rke2_artifacts_path }}"  
        recurse: yes  
        mode: '0444'  
    - name: Set install script executable  
      file:  
        path: "{{ rke2_install_script_path }}"  
        mode: '0755'  

- name: Populate service facts  
  service_facts:  

- name: Get stats of the FS object  
  stat:  
    path: /usr/local  
  register: fs_local  

- name: Set RKE2 bin path  
  set_fact:  
    rke2_bin_path: >-  
      {% if fs_local.stat.writable and fs_local.stat.mount is defined %}  
      /usr/local/bin/rke2  
      {% else %}  
