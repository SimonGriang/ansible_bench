- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  community.general.apk:
    update_cache: true
    upgrade: true
  changed_when: false

- name: Configure apt
  ansible.builtin.apt:
    upgrade: true
    dpkg_options: 'hold'
    force: true
  environment:
    DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  ansible.builtin.dnf:
    upgrade: true
    exclude:
      - package1
      - package2

- name: Update all software (pacman)
  community.general.pacman:
    upgrade: true

- name: Configure yum
  when: ansible_pkg_mgr == 'yum'
  block:
    - name: Update all packages using dnf on RHEL6
      ansible.builtin.dnf:
        upgrade: true
      when: ansible_distribution_major_version == '6'
    - name: Install yum-utils on non-RHEL6
      ansible.builtin.yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != '6'
    - name: Update all packages using yum on non-RHEL6
      ansible.builtin.yum:
        upgrade: true
      when: ansible_distribution_major_version != '6'

- name: Update all software (zypper)
  community.general.zypper:
    upgrade: true
    refresh: true


