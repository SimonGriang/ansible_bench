---
- name: Create the RKE2 config directory
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: "0755"
    owner: root
    group: root

- name: Set server taints
  set_fact:
    node_taints: "{{ rke2_server_node_taints }}"
  when: "'rke2_server' in group_names"

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: "{{ rke2_config_dir }}/config.yaml"
    mode: "0644"
    owner: root
    group: root
  notify: restart rke2

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: "{{ rke2_config_dir }}/kubelet-config.yaml"
    mode: "0644"
    owner: root
    group: root
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: "{{ rke2_config_dir }}/containerd-registry.conf"
    mode: "0644"
    owner: root
    group: root
  when: rke2_containerd_registry_config is defined and rke2_containerd_registry_config | length > 0
  notify: restart rke2

- name: Gather service facts
  service_facts:

- name: Check for etcd snapshot file
  stat:
    path: "{{ rke2_etcd_snapshot_file }}"
  register: snapshot_file

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ snapshot_file.stat.exists and (service_facts.services['rke2-server'].state != 'running') }}"
  when: snapshot_file.stat.exists

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: "{{ rke2_etcd_s3_bucket is defined and rke2_etcd_s3_bucket | length > 0 and rke2_etcd_s3_region is defined and rke2_etcd_s3_region | length > 0 }}"
  when: rke2_etcd_s3_bucket is defined

- name: Restore etcd from file
  block:
    - name: Ensure etcd data directory exists
      file:
        path: "/var/lib/rancher/rke2/server/db"
        state: directory
        mode: "0700"
    - name: Copy etcd snapshot to server
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: "/var/lib/rancher/rke2/server/db/snapshot.db"
        mode: "0600"
    - name: Run etcd restore from file
      command: >
        /usr/bin/etcdctl snapshot restore
        --data-dir /var/lib/rancher/rke2/server/db
        --name rke2-etcd
        --initial-cluster rke2-etcd=127.0.0.1:2380
        /var/lib/rancher/rke2/server/db/snapshot.db
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Download etcd snapshot from S3
      command: >
        aws s3 cp s3://{{ rke2_etcd_s3_bucket }}/snapshot.db /var/lib/rancher/rke2/server/db/snapshot.db
        --region {{ rke2_etcd_s3_region }}
        --endpoint-url {{ rke2_etcd_s3_endpoint }}
      environment:
        AWS_ACCESS_KEY_ID: "{{ rke2_etcd_s3_access_key }}"
        AWS_SECRET_ACCESS_KEY: "{{ rke2_etcd_s3_secret_key }}"
    - name: Run etcd restore from file
      command: >
        /usr/bin/etcdctl snapshot restore
        --data-dir /var/lib/rancher/rke2/server/db
        --name rke2-etcd
        --initial-cluster rke2-etcd=127.0.0.1:2380
        /var/lib/rancher/rke2/server/db/snapshot.db
  when: etcd_restore_from_s3

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: restart rke2

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    state: stopped
    enabled: false
    masked: true

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: 127.0.0.1
    port: 6443
    timeout: 300
  when: not rke2_cni_enabled

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: 127.0.0.1
    port: 6443
    timeout: 300
  when: rke2_cni_enabled

- name: Restore etcd
  block:
    - name: Clean up old etcd data
      file:
        path: "/var/lib/rancher/rke2/server/db"
        state: absent
    - name: Recreate etcd data directory
      file:
        path: "/var/lib/rancher/rke2/server/db"
        state: directory
        mode: "0700"
  when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_server'] }}"



