    - bootstrap_facts.stdout | regex_search('PRETTY_NAME="([^"]+)"', '\\1') | regex_search(item.key, ignorecase=true)
  become: true

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: item.key == bootstrap_distribution
  become: true


