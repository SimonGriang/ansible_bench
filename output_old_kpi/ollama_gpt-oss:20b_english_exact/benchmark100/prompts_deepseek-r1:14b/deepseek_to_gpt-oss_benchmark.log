---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install using package
  block:
    - name: Install HashiCorp product using package manager on Debian
      apt:
        name: "{{ hashicorp_package_name }}"
        state: present
      when: ansible_os_family == 'Debian'
    - name: Install HashiCorp product using package manager on RedHat
      yum:
        name: "{{ hashicorp_package_name }}"
        state: present
      when: ansible_os_family == 'RedHat'
  when: hashicorp_install_method == 'package'

- name: Configure debian
  block:
    - name: Add HashiCorp GPG key
      apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
    - name: Add HashiCorp repository
      apt_repository:
        repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
        state: present
        filename: hashicorp
  when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package
  block:
    - name: Install latest HashiCorp product
      package:
        name: "{{ hashicorp_package_name }}"
        state: latest
      when: hashicorp_version == 'latest'
    - name: Install specific version of HashiCorp product
      package:
        name: "{{ hashicorp_package_name }}={{ hashicorp_version }}"
        state: present
      when: hashicorp_version != 'latest'
  when: hashicorp_install_method == 'package'

- name: Install manually
  block:
    - name: Download HashiCorp product binary
      get_url:
        url: "{{ hashicorp_download_url }}"
        dest: "/tmp/{{ hashicorp_package_name }}-{{ hashicorp_version }}.zip"
        mode: '0644'
    - name: Extract HashiCorp product
      unarchive:
        src: "/tmp/{{ hashicorp_package_name }}-{{ hashicorp_version }}.zip"
        dest: "{{ hashicorp_install_dir }}"
        remote_src: yes
    - name: Set permissions on HashiCorp binaries
      file:
        path: "{{ hashicorp_install_dir }}/{{ hashicorp_package_name }}"
        mode: '0755'
        state: file
  when: hashicorp_install_method == 'manual'


