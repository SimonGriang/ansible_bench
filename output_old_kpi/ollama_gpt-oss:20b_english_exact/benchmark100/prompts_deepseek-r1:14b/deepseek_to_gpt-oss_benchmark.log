- name: Create the RKE2 configuration directory
  ansible.builtin.file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.lineinfile:
    path: "{{ rke2_config_dir }}/config.yaml"
    regexp: '^taints:'
    line: "taints: [node-role.kubernetes.io/server:NoSchedule]"
  when: node_type == 'server'

- name: Set agent taints
  ansible.builtin.lineinfile:
    path: "{{ rke2_config_dir }}/config.yaml"
    regexp: '^taints:'
    line: "taints: [node-role.kubernetes.io/agent:NoSchedule]"
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  ansible.builtin.template:
    src: rke2_config.j2
    dest: "{{ rke2_config_dir }}/config.yaml"
    mode: '0644'
  notify: restart rke2

- name: Copy Kubelet configuration file
  ansible.builtin.template:
    src: kubelet_config.j2
    dest: "/etc/rancher/rke2/kubelet-config.yaml"
    mode: '0644'
  when: kubelet_config is defined
  notify: restart kubelet

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ custom_registry_path }}"
    dest: "/etc/containerd/config.toml"
    mode: '0644'
  when: custom_registry_path is defined
  notify: restart containerd

- name: Start RKE2 service on other nodes
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: true
  when: node_type != 'agent'
  notify: restart rke2

- name: Mask other RKE2 services on nodes
  ansible.builtin.service:
    name: "{{ 'rke2-agent' if node_type == 'server' else 'rke2-server' }}"
    state: masked
  notify: restart rke2

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.shell: |
    set -o pipefail
    kubectl get nodes --no-headers | grep -v Ready | wc -l
  register: node_ready
  until: node_ready.stdout | int == 0
  retries: 30
  delay: 10
  changed_when: false

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.shell: |
    set -o pipefail
    kubectl get nodes -o \
    jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' \
    | tr -d '[:space:]'
  register: node_ready_cni
  until: node_ready_cni.stdout | regex_replace('\\s+', '') == "TrueTrue"
  retries: 30
  delay: 10
  changed_when: false


