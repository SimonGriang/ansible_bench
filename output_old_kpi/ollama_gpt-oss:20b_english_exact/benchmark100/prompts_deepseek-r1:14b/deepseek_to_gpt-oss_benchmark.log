- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
- name: Configure apk
  ansible.builtin.apk:
    update_cache: yes
    upgrade: yes
  changed_when: false
- name: Hold selected packages
  ansible.builtin.apt:
    pkg: "{{ item }}"
    state: present
  loop: "{{ packages_to_hold }}"
- name: Configure apt
  ansible.builtin.apt:
    update_cache: yes
    upgrade: dist
    force: yes
    cache_valid_time: 86400
  environment:
    DEBIAN_FRONTEND: noninteractive
- name: Update all software (dnf)
  ansible.builtin.dnf:
    name: '*'
    state: latest
    exclude: "{{ packages_to_exclude }}"
    update_cache: yes
    lock_timeout: 60
    force: yes
- name: Update all software (pacman)
  ansible.builtin.pacman:
    update_cache: yes
    upgrade: yes
    refresh: yes
    ignore: "{{ packages_to_ignore }}"
    state: latest
- name: Update all software using yum on CentOS/RHEL 6
  ansible.builtin.yum:
    name: '*'
    state: latest
    exclude: "{{ packages_to_exclude }}"
    update_cache: yes
  when: ansible_distribution_major_version == '6'
- name: Install yum-utils on non-6
  ansible.builtin.yum:
    name: yum-utils
    state: present
  when: ansible_distribution_major_version != '6'
- name: Update all software using dnf on non-6
  ansible.builtin.dnf:
    name: '*'
    state: latest
    exclude: "{{ packages_to_exclude }}"
    update_cache: yes
    force: yes
  when: ansible_distribution_major_version != '6'
- name: Update all software (zypper)
  ansible.builtin.zypper:
    name: '*'
    state: latest
    exclude: "{{ packages_to_exclude }}"
    refresh: yes
    force: yes


