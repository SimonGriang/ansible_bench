- name: "Task 1: hardening | Disable swap"
  when: vault_hardening_disable_swap|bool
  block:
    - name: Disable swap immediately
      ansible.builtin.command: swapoff -a
      changed_when: false
    - name: Comment swap lines in /etc/fstab
      ansible.builtin.replace:
        path: /etc/fstab
        regexp: '^(\s*[^#].*swap.*)$'
        replace: '#\1'

- name: "Task 2: hardening | Disable core dumps"
  when: vault_hardening_disable_core_dumps|bool
  block:
    - name: Set hard core limit to 0
      ansible.builtin.lineinfile:
        path: /etc/security/limits.conf
        regexp: '^\\*\\s+hard\\s+core\\s+'
        line: '* hard core 0'
    - name: Set soft core limit to 0
      ansible.builtin.lineinfile:
        path: /etc/security/limits.conf
        regexp: '^\\*\\s+soft\\s+core\\s+'
        line: '* soft core 0'

- name: "Task 3: hardening | Disable Shell Command History"
  when: vault_hardening_disable_shell_command_history|bool
  block:
    - name: Ensure /etc/profile.d/vault.sh exists
      ansible.builtin.file:
        path: /etc/profile.d/vault.sh
        state: touch
        mode: '0644'
    - name: Add HISTIGNORE rule to vault.sh
      ansible.builtin.lineinfile:
        path: /etc/profile.d/vault.sh
        regexp: '^export HISTIGNORE='
        line: 'export HISTIGNORE="*vault*"'

- name: "Task 4: hardening | Configure SELinux / AppArmor"
  when: vault_hardening_configure_selinux_apparmor|bool
  block:
    - name: Enable SELinux enforcing mode
      ansible.posix.selinux:
        state: enforcing
    - name: Install SELinux targeted policy
      ansible.builtin.package:
        name: selinux-policy-targeted
        state: present
    - name: Ensure AppArmor is installed
      ansible.builtin.package:
        name: apparmor
        state: present
    - name: Enforce AppArmor profile for Vault
      ansible.builtin.command: apparmor_parser -r /etc/apparmor.d/usr.bin.vault
      args:
        creates: /etc/apparmor.d/usr.bin.vault
      changed_when: false


