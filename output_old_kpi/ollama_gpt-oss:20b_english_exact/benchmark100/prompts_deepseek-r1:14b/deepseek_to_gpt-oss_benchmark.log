- name: Import variables
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to become available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare system
  block:
    - name: Test connection with a timeout
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
    - name: Test sudo
      command: sudo -V
  rescue:
    - name: Gather facts
      setup:
        gather_subset: all
    - name: Install bootstrap packages (package)
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"

