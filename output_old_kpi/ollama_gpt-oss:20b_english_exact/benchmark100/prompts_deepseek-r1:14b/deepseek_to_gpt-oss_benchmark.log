---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  become: false
  when: ansible_connection != "local"

- name: Prepare system
  block:
    - name: Test connection
      command: true
      register: test_connection
    - name: Test sudo access
      command: sudo -n true
      register: test_sudo
    - name: Gather facts if tests fail
      setup:
      when: test_connection is failed or test_sudo is failed
    - name: Install necessary packages
      raw: "{{ bootstrap_install_commands }}"
      when: test_connection is failed or test_sudo is failed
    - name: Ensure libdnf5 on RedHat
      package:
        name: libdnf5
        state: present
      when: ansible_facts['os_family'] == 'RedHat'
  become: false

- name: Gather ansible facts
  setup:
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"


