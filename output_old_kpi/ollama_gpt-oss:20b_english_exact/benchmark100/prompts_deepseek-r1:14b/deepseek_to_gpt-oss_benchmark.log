---
- name: Install EPEL on compatible systems
  debug:
    msg: "Installing EPEL on compatible systems"

- name: Install EPEL GPG key
  rpm_key:
    state: present
    key: "{{ epel_gpg_key_url }}"
  when: ansible_distribution in ['Amazon', 'RedHat'] and ansible_distribution_major_version in ['2', '7', '8', '9', '10']

- name: Install EPEL-release package
  yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache
  when: ansible_distribution in ['Amazon', 'RedHat'] and ansible_distribution_major_version in ['2', '7', '8', '9', '10']

- name: Install EPEL-next-release package
  yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | bool and ansible_distribution in ['Amazon', 'RedHat'] and ansible_distribution_major_version in ['2', '7', '8', '9', '10']
  notify: Update package cache

- name: Update package cache
  meta: flush_handlers


