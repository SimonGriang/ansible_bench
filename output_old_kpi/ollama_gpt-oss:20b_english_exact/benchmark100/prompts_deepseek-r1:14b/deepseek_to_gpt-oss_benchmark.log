---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Set SELinux state and policy
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
    - name: Configure SELinux booleans
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
      loop: "{{ selinux_booleans | dict2items }}"
      when: selinux_booleans is defined


