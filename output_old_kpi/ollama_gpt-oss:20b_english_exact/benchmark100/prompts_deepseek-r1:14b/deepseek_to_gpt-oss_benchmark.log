---
- name: Run a shell command to gather Kubernetes node information
  ansible.builtin.shell:
    cmd: kubectl get nodes -o wide
    executable: /bin/bash
  register: node_info
  changed_when: false
  until: node_info is succeeded
  retries: 5
  delay: 0

- name: Display Kubernetes node information
  ansible.builtin.debug:
    var: node_info.stdout_lines


