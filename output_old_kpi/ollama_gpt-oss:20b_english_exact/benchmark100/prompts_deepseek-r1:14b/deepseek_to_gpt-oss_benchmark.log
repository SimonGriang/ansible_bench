---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when: (selinux_status is defined) and (ansible_connection not in ['container', 'docker', 'community.docker.docker'])
  block:
    - name: Task 4.1: Manage SELinux settings using the selinux state and policy variables and notify the Reboot handler.
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Task 4.2: Manage SELinux booleans by iterating over the selinux_booleans variable. Set the state, persistent flag, and use the item name as the label. Only run if selinux_booleans is defined.
      when: selinux_booleans is defined
      selinux_boolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
        persistent: true
      loop: "{{ selinux_booleans | dict2items }}"
      loop_control:
        label: "{{ item.key }}"}


