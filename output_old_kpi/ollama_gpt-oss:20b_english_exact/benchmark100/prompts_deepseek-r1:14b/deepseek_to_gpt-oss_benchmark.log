  when: not rsyslog_deploy_default_config

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item.value.src }}"
    dest: "/etc/rsyslog.d/{{ item.key }}"
    mode: '0644'
  notify: Restart rsyslog
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
  when: item.value.state is defined

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: true


