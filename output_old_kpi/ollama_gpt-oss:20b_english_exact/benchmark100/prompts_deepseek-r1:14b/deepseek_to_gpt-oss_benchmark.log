- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: true
  loop: "{{ httpd_selinux_booleans }}"
  when: ansible_selinux.status == "enabled"

- name: Allow httpd ports
  ansible.posix.seport:
    ports: "{{ httpd_selinux_ports }}"
    proto: tcp
    setype: http_port_t
    state: present
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: '0644'
  notify:
    - Test httpd config
    - Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod {{ item }}
  args:
    creates: /etc/apache2/mods-enabled/{{ item }}.conf
  loop: "{{ httpd_modules_debian }}"
  changed_when: false
  when: ansible_facts['os_family'] == 'Debian'

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - Test httpd config
    - Restart httpd
  when: ansible_facts['os_family'] in ['Debian', 'Suse']

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example | default(false)

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service_name | default('httpd') }}"
    state: started
    enabled: true


