---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  copy:
    dest: /etc/vault.d/vault.env
    content: "{{ vault_environment_settings | to_nice_yaml }}"
  notify: Restart vault

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault (for OSS type)
  systemd:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault (for non-OSS type)
  systemd:
    name: vault
    state: started
    enabled: true
  when: vault_type != "oss"


