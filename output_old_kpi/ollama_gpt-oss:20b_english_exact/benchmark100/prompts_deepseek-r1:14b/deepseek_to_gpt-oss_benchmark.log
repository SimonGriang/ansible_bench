---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  ansible.builtin.lineinfile:
    path: /etc/default/cron
    regexp: '^SHELL='
    line: 'SHELL={{ cron_shell | default("/bin/bash") }}'
    create: true
    mode: '0644'

- name: Configure cron path environment
  ansible.builtin.lineinfile:
    path: /etc/default/cron
    regexp: '^PATH='
    line: 'PATH={{ cron_path | default("/usr/bin:/usr/sbin") }}'
    create: true
    mode: '0644'

- name: Configure cron mailto settings
  ansible.builtin.lineinfile:
    path: /etc/default/cron
    regexp: '^MAILTO='
    line: 'MAILTO={{ cron_mailto | default("") }}'
    create: true
    mode: '0644'

- name: Start and enable cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default('root') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"


