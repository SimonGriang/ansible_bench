- name: Generate an OpenSSL private key
  community.crypto.openssl_privatekey:
    path: "{{ key_dir }}/{{ key_name }}"
    size: 2048
    state: present
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    type: RSA

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    path: "{{ csr_dir }}/{{ csr_name }}"
    privatekey_path: "{{ key_dir }}/{{ key_name }}"
    common_name: "{{ common_name }}"
    mode: "{{ csr_mode }}"
    owner: "{{ csr_owner }}"
    group: "{{ csr_group }}"
    state: present

- name: Generate an OpenSSL X.509 certificate
  community.crypto.openssl_x509:
    path: "{{ cert_dir }}/{{ cert_name }}"
    privatekey_path: "{{ key_dir }}/{{ key_name }}"
    csr_path: "{{ csr_dir }}/{{ csr_name }}"
    selfsigned: true
    days: 365
    mode: "{{ cert_mode }}"
    owner: "{{ cert_owner }}"
    group: "{{ cert_group }}"
    state: present

- name: Generate a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ pkcs12_dir }}/{{ pkcs12_name }}"
    privatekey_path: "{{ key_dir }}/{{ key_name }}"
    certificate_path: "{{ cert_dir }}/{{ cert_name }}"
    friendly_name: "{{ friendly_name }}"
    mode: "{{ pkcs12_mode }}"
    owner: "{{ pkcs12_owner }}"
    group: "{{ pkcs12_group }}"
    state: present

- name: Read private key content
  ansible.builtin.set_fact:
    private_key_content: "{{ lookup('file', key_dir + '/' + key_name) }}"

- name: Read certificate content
  ansible.builtin.set_fact:
    certificate_content: "{{ lookup('file', cert_dir + '/' + cert_name) }}"

- name: Create a combined private key and certificate file
  ansible.builtin.copy:
    dest: "{{ key_dir }}/combined.pem"
    content: "{{ private_key_content + certificate_content }}"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"



