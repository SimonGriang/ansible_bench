---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf_module:
    name: redis
    state: enabled

- name: Install redis
  dnf:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: redis.conf.j2
    dest: "{{ redis_conf_path }}"
    owner: root
    group: root
    mode: '0644'
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


