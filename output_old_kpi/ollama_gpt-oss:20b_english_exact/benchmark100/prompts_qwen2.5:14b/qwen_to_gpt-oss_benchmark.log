- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_dir }}/rke2-checksum.txt"
        mode: '0644'
        timeout: 30
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_artifacts_dir }}/rke2-artifact.tar.gz"
        mode: '0644'
        timeout: 30
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_artifacts_dir }}/rke2-install.sh"
        mode: '0700'
        timeout: 30
  rescue:
    - set_fact:
        download_failed: true
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create local download directory
      file:
        path: "{{ rke2_local_download_dir }}"
        state: directory
        mode: '0755'
    - name: Copy RKE2 artifacts locally
      copy:
        src: "{{ rke2_local_artifacts_src }}"
        dest: "{{ rke2_local_download_dir }}/rke2-artifact.tar.gz"
        mode: '0644'
    - name: Copy RKE2 install script locally
      copy:
        src: "{{ rke2_local_install_script }}"
        dest: "{{ rke2_local_download_dir }}/rke2-install.sh"
        mode: '0700'
    - name: Copy RKE2 artifacts to remote host
      copy:
        src: "{{ rke2_local_download_dir }}/rke2-artifact.tar.gz"
        dest: "{{ rke2_artifacts_dir }}/rke2-artifact.tar.gz"
        mode: '0644'
    - name: Copy RKE2 install script to remote host
      copy:
        src: "{{ rke2_local_download_dir }}/rke2-install.sh"
        dest: "{{ rke2_artifacts_dir }}/rke2-install.sh"
        mode: '0700'
  when: download_failed is defined and download_failed

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_src }}"
    dest: "{{ rke2_artifacts_dir }}/rke2-artifact.tar.gz"
    mode: '0640'
    force: yes
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode | bool
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: '0755'
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/"
        mode: '0644'
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_copy_additional_tarballs | length > 0
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure install script exists
      file:
        path: "{{ rke2_artifacts_dir }}/rke2-install.sh"
        state: file
        mode: '0700'
    - name: Ensure artifacts directory exists
      file:
        path: "{{ rke2_artifacts_dir }}"
        state: directory
        mode: '0700'
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  shell: grep -q '^/usr/local ' /proc/mounts && echo true || echo false
  register: separate_partition
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - >-
        rke2_installed_version is not version(rke2_running_version, '<')
    fail_msg: |-
      Attempted to downgrade RKE2 from {{ rke2_running_version }} to {{ rke2_installed_version }}.

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: >-
      {{ rke2_version_output.stdout | regex_search('v\\d+\\.\\d+\\.\\d+') }}
    rke2_running_version: >-
      {{ ansible_facts.services['rke2-server.service'].state | default('unknown') }}
  when: not ansible_check_mode

- name: Run RKE2 install script
  command: >-
    {{ rke2_artifacts_dir }}/rke2-install.sh {{ rke2_airgap_flag | default('') }}
  args:
    creates: "{{ rke2_bin_path }}/rke2"
  when:
    - rke2_installed_version is defined
    - rke2_running_version is defined
    - rke2_installed_version != rke2_running_version
    - not ansible_check_mode

