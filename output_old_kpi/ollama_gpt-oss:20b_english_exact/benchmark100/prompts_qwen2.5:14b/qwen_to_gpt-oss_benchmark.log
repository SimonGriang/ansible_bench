---
- name: hardening | Disable swap
  shell: |
    swapoff -a
    sed -i '/\sswap\s/d' /etc/fstab
  when: vault_hardening_disable_swap
  changed_when: false

- name: hardening | Disable swap now
  command: swapoff -a
  changed_when: false

- name: hardening | Disable swap permanently
  shell: |
    swapoff -a
    sed -i '/\sswap\s/d' /etc/fstab
  when: vault_hardening_disable_swap
  changed_when: false

- name: hardening | Disable core dumps
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: yes
  with_items:
    - { name: 'fs.suid_dumpable', value: '0' }
    - { name: 'kernel.core_pattern', value: '/dev/null' }
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/disable_history.sh
    mode: '0644'
    content: |
      # Disable shell command history
      HISTFILE=/dev/null
      HISTSIZE=0
      HISTFILESIZE=0
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  debug:
    msg: "SELinux and AppArmor configuration will be applied by subsequent tasks."
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Enable SELinux
  selinux:
    state: enforcing
    policy: targeted
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Install selinux-policy
  package:
    name: selinux-policy
    state: present

- name: hardening | Set SELinux policy
  selinux:
    state: enforcing
    policy: targeted

- name: hardening | Enable AppArmor (enforcing)
  command: aa-enforce /usr/bin/vault
  when: vault_hardening_configure_selinux_apparmor
  changed_when: false


