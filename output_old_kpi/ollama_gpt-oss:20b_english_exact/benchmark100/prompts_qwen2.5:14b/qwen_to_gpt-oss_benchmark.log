    path: "{{ helm_path }}"
  register: helm_stat

- name: Check Helm version
  ansible.builtin.command: "{{ helm_path }} version --short"
  register: helm_version
  when: helm_stat.stat.exists
  changed_when: false

- name: Download helm
  ansible.builtin.get_url:
    url: "{{ helm_repo_url }}"
    dest: "{{ helm_download_path }}"
    mode: '0755'
  when: not helm_stat.stat.exists or helm_version.stdout != desired_helm_version

- name: Copy helm binary into place
  ansible.builtin.copy:
    src: "{{ helm_download_path }}"
    dest: "{{ helm_path }}"
    mode: '0755'
    owner: root
    group: root
  when: not helm_stat.stat.exists or helm_version.stdout != desired_helm_version


