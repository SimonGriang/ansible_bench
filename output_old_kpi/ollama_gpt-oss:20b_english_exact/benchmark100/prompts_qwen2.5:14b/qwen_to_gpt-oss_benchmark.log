---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_check
  ignore_errors: true

- name: Set fact for current Docker Compose version
  set_fact:
    current_version: "{{ docker_compose_check.stdout | regex_search('docker-compose version (\\S+)', '\\1') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when:
    - current_version is defined
    - current_version != desired_version

- name: Install Docker Compose (if configured)
  get_url:
    url: "https://github.com/docker/compose/releases/download/{{ desired_version }}/docker-compose-{{ ansible_system | lower }}-{{ ansible_architecture }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when:
    - current_version is not defined
    - or (current_version is defined and current_version is version(desired_version, '<'))


