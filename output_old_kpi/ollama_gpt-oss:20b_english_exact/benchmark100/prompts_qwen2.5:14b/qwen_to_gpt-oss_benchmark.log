n': 164746559, 'prompt_eval_count': 695, 'prompt_eval_duration': 476057522, 'eval_count': 2061, 'eval_duration': 20794796607, 'model_name': 'gpt-oss:20b'} id='run--e3c0e7c0-cdb7-45b1-a508-87d872fa2a8f-0' usage_metadata={'input_tokens': 695, 'output_tokens': 2061, 'total_tokens': 2756}
