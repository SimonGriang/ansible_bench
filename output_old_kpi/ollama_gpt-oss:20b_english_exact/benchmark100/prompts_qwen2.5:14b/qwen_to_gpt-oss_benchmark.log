---
- name: Create etcd group
  ansible.builtin.group:
    name: etcd
    state: present
    system: true

- name: Create etcd user
  ansible.builtin.user:
    name: etcd
    comment: etcd user
    group: etcd
    shell: /bin/nologin
    system: true
    state: present

- name: Check if /usr/local is writable
  ansible.builtin.access:
    path: /usr/local
    access: w
  register: usr_local_write

- name: Get device of /usr/local
  ansible.builtin.stat:
    path: /usr/local
  register: usr_local_stat

- name: Get device of /opt/rke2
  ansible.builtin.stat:
    path: /opt/rke2
  register: opt_rke2_stat

- name: Set source file to /usr/local path if writable and same device
  ansible.builtin.set_fact:
    source_file: "/usr/local/share/rke2/rke2-cis-sysctl.conf"
  when: >
    usr_local_write.access and
    (usr_local_stat.stat.dev == opt_rke2_stat.stat.dev)

- name: Set source file to /opt/rke2 path otherwise
  ansible.builtin.set_fact:
    source_file: "/opt/rke2/share/rke2/rke2-cis-sysctl.conf"
  when: >
    not (usr_local_write.access and
         (usr_local_stat.stat.dev == opt_rke2_stat.stat.dev))

- name: Copy systemctl config file for kernel hardening
  ansible.builtin.copy:
    src: "{{ source_file }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
    remote_src: true
  notify: restart systemd-sysctl

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


