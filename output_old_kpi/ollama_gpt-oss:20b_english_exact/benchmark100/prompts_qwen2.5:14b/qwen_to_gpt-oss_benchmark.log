  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases | selectattr('import', 'undefined') | list }}"

- name: List databases
  ansible.builtin.command: mysql -e "SHOW DATABASES;"
  register: mysql_databases_list

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import }}"
  loop: "{{ mysql_databases | selectattr('import', 'defined') | list }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"

