- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_directories }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    system: true

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    system: true
    group: "{{ dns_group }}"
    shell: /sbin/nologin
    create_home: false

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -k rndc_key -c "{{ rndc_key_path }}"
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ rndc_key_path }}"
    mode: '0600'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ zone_name }}.zone"
    mode: '0644'

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.zones.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'

- name: Place systemd override
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: /etc/systemd/system/bind9.service.d
        state: directory
        mode: '0755'
    - name: Place systemd override configuration
      ansible.builtin.template:
        src: bind9_override.j2
        dest: /etc/systemd/system/bind9.service.d/override.conf
        mode: '0644'

- name: Start and enable dns
  ansible.builtin.service:
    name: bind9
    state: started
    enabled: true


