- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: selinux_enabled | bool
  block:
    - name: Set SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item }}"
        state: true
        persistent: true
      loop: "{{ selinux_booleans | default([]) }}"
    - name: Allow httpd ports
      community.general.seport:
        ports: "{{ selinux_ports | default([]) }}"
        proto: tcp
        setype: http_port_t
        state: present

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: "0644"
  notify:
    - Test httpd
    - Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod {{ item }}
  args:
    creates: "/etc/apache2/mods-enabled/{{ item }}.load"
  loop: "{{ httpd_modules | default([]) }}"
  when: ansible_facts['os_family'] == 'Debian'
  notify:
    - Test httpd
    - Restart httpd

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml
  when: httpd_ssl_enabled | bool

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations | length > 0

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts | length > 0

- name: Configure ports
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  ansible.builtin.template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: "0644"
  notify:
    - Test httpd
    - Restart httpd

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories | length > 0

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "/var/www/html/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


