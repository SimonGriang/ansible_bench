---
- name: Install Keepalived when HA mode is enabled
  package:
    name: keepalived
    state: present
  when: ha_mode | default(false) and inventory_hostname in groups['rke2_server']

- name: Download RKE2
  get_url:
    url: "{{ rke2_download_url }}"
    dest: /tmp/rke2-install.sh
    mode: '0755'
  register: rke2_download

- name: Install RKE2
  shell: /tmp/rke2-install.sh --version "{{ rke2_version }}"
  args:
    creates: /usr/local/bin/rke2
  when: rke2_download.changed

- name: Perform CIS Hardening
  include_tasks: cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  command: kubectl get nodes --selector='node-role.kubernetes.io/master' -o jsonpath='{.items[0].metadata.name}'
  register: active_server
  changed_when: false

- name: Enable IPVS kernel module
  kernel_module:
    name: ip_vs
    state: present
  when: use_kubevip and ha_mode

- name: Copy kube-vip manifests to the masternode
  copy:
    src: kube-vip.yaml
    dest: /etc/kubernetes/manifests/kube-vip.yaml
  when: not use_keepalived

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: ingress-nginx.yaml
    dest: /etc/kubernetes/manifests/ingress-nginx.yaml
  when: ingress_config is defined

- name: Prepare very first server node in the cluster
  shell: rke2 server --config /etc/rke2/config.yaml
  args:
    creates: /var/lib/rancher/rke2/server/db
  when: inventory_hostname == active_server.stdout

- name: Restore etcd specific tasks
  shell: etcdctl snapshot restore /var/lib/rancher/rke2/server/db/snapshot.db --data-dir /var/lib/rancher/rke2/server/db
  when: restore_etcd | default(false)

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ playbook_dir }}/kubeconfig-{{ inventory_hostname }}"
    flat: yes
  when: download_kubeconfig | default(false)

- name: Prepare and join remaining nodes of the cluster
  shell: rke2 agent --server https://{{ active_server.stdout }}:9345 --token "{{ rke2_token }}"
  when: active_server.stdout is defined and inventory_hostname != active_server.stdout

- name: Rolling cordon and drain restart when version changes - servers
  shell: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
  when: rke2_version_changed | default(false) and inventory_hostname in groups['rke2_server']

- name: Restart rke2 server
  service:
    name: rke2-server
    state: restarted
  when: rke2_version_changed | default(false) and inventory_hostname in groups['rke2_server']

- name: Rolling cordon and drain restart when version changes - agents
  shell: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
  when: rke2_version_changed | default(false) and inventory_hostname in groups['rke2_agent']

- name: Restart rke2 agent
  service:
    name: rke2-agent
    state: restarted
  when: rke2_version_changed | default(false) and inventory_hostname in groups['rke2_agent']

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  meta: flush_handlers
  when: config_files_changed | default(false)

- name: Final steps
  debug:
    msg: "Playbook execution completed."


