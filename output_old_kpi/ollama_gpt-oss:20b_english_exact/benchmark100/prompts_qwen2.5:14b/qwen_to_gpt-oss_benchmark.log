---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: |
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data {{ rke2_drain_additional_args }} --force
  register: drain_result
  until: drain_result.rc == 0
  retries: 100
  delay: 15
  failed_when: drain_result.rc != 0

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    kubectl get nodes --no-headers | grep -v Ready | wc -l
  register: node_ready_check
  until: node_ready_check.stdout == "0"
  retries: 100
  delay: 15
  changed_when: false

- name: Uncordon the node {{ rke2_node_name }}
  shell: |
    kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade|bool
  changed_when: false

- name: Wait for all pods to be ready again
  shell: |
    kubectl get pods --all-namespaces --field-selector status.phase!=Running,status.phase!=Succeeded --no-headers | wc -l
  register: pods_ready_check
  until: pods_ready_check.stdout == "0"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready|bool
  changed_when: false

- name: Wait for all pods to pass readiness checks
  shell: |
    kubectl wait --for=condition=ready pod --all --all-namespaces
  register: pods_health_check
  until: pods_health_check.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy|bool
  failed_when: pods_health_check.rc != 0
  changed_when: false



