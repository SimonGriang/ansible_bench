    name: promtail
    group: promtail
    system: true
    createhome: false
    state: present

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application directories
  file:
    path: "{{ promtail_app_dir }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check if the promtail binary exists
  stat:
    path: "{{ promtail_app_dir }}/promtail"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_app_dir }}/promtail.tar.gz"
    mode: '0644'
  when:
    - not promtail_binary.stat.exists
    - not promtail_local_distributed
    - not promtail_propagated

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_archive_path }}"
    dest: "{{ promtail_app_dir }}/promtail.tar.gz"
    mode: '0644'
  when:
    - not promtail_binary.stat.exists
    - promtail_local_distributed

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  delegate_to: localhost
  when:
    - not promtail_binary.stat.exists
    - promtail_propagated

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail.tar.gz
    dest: "{{ promtail_app_dir }}/promtail.tar.gz"
    mode: '0644'
  when: promtail_propagated

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_app_dir }}/promtail.tar.gz"
    dest: "{{ promtail_app_dir }}"
    remote_src: true
    mode: '0755'
  failed_when: false

- name: Create symlink to latest version
  file:
    src: "{{ promtail_app_dir }}/promtail"
    dest: /usr/local/bin/promtail
    state: link
  notify: restart promtail

- name: Write configuration
  template:
    src: templates/promtail.yaml.j2
    dest: "{{ promtail_config_dir }}/promtail.yaml"
    owner: promtail
    group: promtail
    mode: '0644'
  notify: restart promtail

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
  notify: restart promtail

- name: restart promtail
  service:
    name: promtail
    state: restarted
    enabled: true
  listen: restart promtail


