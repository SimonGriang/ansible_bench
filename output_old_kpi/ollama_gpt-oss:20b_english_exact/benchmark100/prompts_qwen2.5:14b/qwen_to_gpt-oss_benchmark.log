---
- name: Create ssl key
  openssl_privatekey:
    path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    size: 2048
    type: rsa
    mode: '0600'
    owner: root
    group: root

- name: Create ssl csr
  openssl_csr:
    path: "{{ csr_dir }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    mode: '0644'

- name: Create ssl certificates
  openssl_certificate:
    path: "{{ cert_dir }}/{{ inventory_hostname }}.crt"
    csr_path: "{{ csr_dir }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    provider: selfsigned
    mode: '0644'

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ pkcs12_dir }}/{{ inventory_hostname }}.p12"
    privatekey_path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    certificate_path: "{{ cert_dir }}/{{ inventory_hostname }}.crt"
    passphrase: "{{ pkcs12_passphrase | default('changeme') }}"
    mode: '0600'

- name: Read private key
  slurp:
    src: "{{ key_dir }}/{{ inventory_hostname }}.key"
  register: private_key_content

- name: Read certificate
  slurp:
    src: "{{ cert_dir }}/{{ inventory_hostname }}.crt"
  register: cert_content

- name: Create combined private_key and certificate file
  copy:
    dest: "{{ combined_dir }}/{{ inventory_hostname }}.pem"
    content: "{{ private_key_content.data | b64decode }}{{ cert_content.data | b64decode }}"
    mode: '0600'


