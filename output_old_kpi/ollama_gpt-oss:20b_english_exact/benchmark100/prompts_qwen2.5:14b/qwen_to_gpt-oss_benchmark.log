- name: Create Vault group
  ansible.builtin.group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  ansible.builtin.user:
    name: "{{ vault_user }}"
    state: present
    groups: "{{ vault_group }}"
    shell: /bin/false
    system: true

- name: Create Vault download directory
  ansible.builtin.file:
    path: "{{ vault_download_dir }}"
    state: directory
    mode: "0755"

- name: Download Vault binary
  ansible.builtin.unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_dir }}"
    remote_src: true
    mode: "0755"

- name: Check if vault_path exists
  ansible.builtin.stat:
    path: "{{ vault_path }}"
  register: vault_path_check

- name: Create vault_path if it does not exist
  ansible.builtin.file:
    path: "{{ vault_path }}"
    state: directory
    mode: "0755"
  when: not vault_path_check.stat.exists

- name: Create directory in vault_path
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: "0755"
  loop: "{{ vault_directories }}"

- name: Create data directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: "0755"
  loop: "{{ vault_directories }}"

- name: Generate TLS key and certificate
  notify: Restart vault
  block:
    - name: Generate TLS private key
      community.crypto.openssl_privatekey:
        path: "{{ vault_data_directory }}/tls/privkey.pem"
        size: 2048
        state: present
        mode: "0600"

    - name: Generate TLS certificate
      community.crypto.openssl_certificate:
        path: "{{ vault_data_directory }}/tls/cert.pem"
        privatekey_path: "{{ vault_data_directory }}/tls/privkey.pem"
        provider: selfsigned
        days: 1095
        common_name: "{{ vault_common_name | default('localhost') }}"
        state: present
        mode: "0644"

- name: Set ownership of TLS material
  ansible.builtin.file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0644"
    state: file
  loop: "{{ vault_tls_files }}"

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  ansible.builtin.setcap:
    path: "{{ vault_path }}/vault"
    capability: cap_ipc_lock=ep
  changed_when: false

- name: Touch vault.env
  ansible.builtin.file:
    path: "{{ vault_env_file }}"
    state: touch
    mode: "0644"

- name: Create /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    mode: "0755"

- name: Copy Vault service file
  ansible.builtin.template:
    src: templates/vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: "0644"
  notify: Daemon reload

- name: Copy vault configuration
  ansible.builtin.copy:
    src: files/vault.hcl
    dest: "{{ vault_path }}/vault.hcl"
    mode: "0644"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers



