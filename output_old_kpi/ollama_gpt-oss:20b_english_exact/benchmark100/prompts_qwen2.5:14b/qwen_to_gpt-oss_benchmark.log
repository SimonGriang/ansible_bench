- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /usr/local/bin
    - /etc/cadvisor

- name: cadvisor | download
  get_url:
    url: "{{ cadvisor_download_url | replace('\n', '') }}"
    dest: "{{ inventory_dir }}/../tmp/cadvisor.tar"
  when: local_dir is not defined
  vars:
    cadvisor_download_url: |
      https://github.com/google/cadvisor/releases/download/v{{ cadvisor_version }}/cadvisor-{{ cadvisor_version }}-linux-amd64
    cadvisor_version: 0.47.0

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ local_dir }}/cadvisor"
    dest: /usr/local/bin/cadvisor
    mode: '0755'
  when: local_dir is defined
  notify: restart cadvisor

- name: cadvisor | symlink
  file:
    src: /usr/local/bin/cadvisor
    dest: /usr/bin/cadvisor
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  notify: restart cadvisor

- name: test_task
  command: systemctl is-active cadvisor
  register: service_active
  changed_when: false

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: true

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started
    enabled: true

- name: restart cadvisor
  systemd:
    name: cadvisor
    state: restarted



