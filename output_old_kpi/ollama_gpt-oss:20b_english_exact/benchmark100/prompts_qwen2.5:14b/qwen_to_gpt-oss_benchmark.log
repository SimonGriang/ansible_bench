- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    regexp: "^{{ item.key }}="
    line: "{{ item.key }}={{ item.value }}"
    create: true
    mode: '0644'
  loop: "{{ mysql_configuration_options | dict2items }}"
  loop_control:
    label: "{{ item.key }}"

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: /etc/mysql/client.cnf
    regexp: "^socket="
    line: "socket={{ mysql_socket }}"
    create: true
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.command: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases | selectattr('import', 'undefined') | list }}"

- name: List databases
  ansible.builtin.command: mysql -e "SHOW DATABASES;"
  register: mysql_databases_list

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import }}"
  loop: "{{ mysql_databases | selectattr('import', 'defined') | list }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


