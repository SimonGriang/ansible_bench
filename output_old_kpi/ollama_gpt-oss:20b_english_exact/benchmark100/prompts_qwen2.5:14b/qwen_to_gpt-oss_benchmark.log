---
- name: Create document root directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot is not defined or item.create_docroot | bool

- name: Configure virtual hosts using a template
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"

- name: Test httpd configuration validity
  command: apachectl configtest
  register: httpd_test
  changed_when: false
  failed_when: httpd_test.rc != 0

- name: Restart httpd service
  service:
    name: httpd
    state: restarted


