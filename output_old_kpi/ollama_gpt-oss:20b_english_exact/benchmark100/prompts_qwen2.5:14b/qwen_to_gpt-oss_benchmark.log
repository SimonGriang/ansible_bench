---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  package:
    name: "{{ python_pip_name }}"
    state: present

- name: Configure pip proxy
  when: python_pip_proxy is defined
  lineinfile:
    path: /etc/pip.conf
    regexp: '^proxy='
    line: "proxy={{ python_pip_proxy }}"
    insertafter: '\\[global\\]'

- name: Trust hosts
  when: python_pip_trusted_host is defined
  lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host='
    line: "trusted-host={{ python_pip_trusted_host }}"
    insertafter: '\\[global\\]'

- name: Update pip
  when:
    - python_pip_update | bool
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'
  pip:
    name: pip
    state: latest

- name: Install requested modules
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
  loop: "{{ python_pip_modules }}"}


