---
- name: lookup bootstrap facts (raw)
  ansible.builtin.set_fact:
    bootstrap_os_release_raw: "{{ lookup('file', '/etc/os-release') }}"

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: >-
      "{{ bootstrap_os_release_raw | regex_search('^ID=(.*)$', multiline=True) }}"
    bootstrap_major_version: >-
      "{{ bootstrap_os_release_raw | regex_search('^VERSION_ID=(\\d+).*', multiline=True) }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: >-
      "{{ bootstrap__os_family_map[bootstrap_distribution] | default('Unknown') }}"


