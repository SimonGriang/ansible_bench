---
- name: Ensure document root directories are created for each virtual host
  file:
    path: "{{ vhost.document_root }}"
    state: directory
    mode: '0755'
  when: vhost.document_root is defined and (vhost.create_docroot is not defined or vhost.create_docroot | bool)
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: vhost

- name: Create virtual host configuration files
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ vhost.server_name }}.conf"
    mode: '0644'
  notify:
    - Test Apache configuration
    - Restart Apache
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: vhost

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite "{{ vhost.server_name }}.conf"
  args:
    creates: "/etc/apache2/sites-enabled/{{ vhost.server_name }}.conf"
  notify:
    - Test Apache configuration
    - Restart Apache
  when: ansible_os_family == 'Debian'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: vhost


