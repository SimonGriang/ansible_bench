      when: user.manage_ssh_key | default(true)
      register: ssh_keygen_output

    # ------------------------------------------------------------------
    # 3. Generate public key using puttygen on localhost
    # ------------------------------------------------------------------
    - name: Generate public key using puttygen on localhost
      delegate_to: localhost
      command: >
        puttygen
        {{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa
        -o
        {{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa.pub
      when: user.manage_ssh_key | default(true)
      register: puttygen_output

    # ------------------------------------------------------------------
    # 4. Set user_home and group variables
    # ------------------------------------------------------------------
    - name: Set user_home and group variables
      set_fact:
        user_home: "{{ user.home | default('/home/' + user.name) }}"
        group: "{{ user.groups | default('') }}"
      when: user.manage_ssh_key | default(true)

    # ------------------------------------------------------------------
    # 5. Add user to remote host
    # ------------------------------------------------------------------
    - name: Add user to remote host
      user:
        name: "{{ user.name }}"
        state: present
        groups: "{{ group }}"
        shell: "{{ user.shell | default('/bin/bash') }}"
        home: "{{ user_home }}"
        createhome: yes
      become: true
      when: user.manage_ssh_key | default(true)

    # ------------------------------------------------------------------
    # 6. Create .ssh directory for user
    # ------------------------------------------------------------------
    - name: Create .ssh directory for user
      file:
        path: "{{ user_home }}/.ssh"
        state: directory
        mode: '0700'
        owner: "{{ user.name }}"
        group: "{{ group }}"
      become: true
      when: user.manage_ssh_key | default(true)

    # ------------------------------------------------------------------
    # 7. Copy private key to remote host
    # ------------------------------------------------------------------
    - name: Copy private key to remote host
      copy:
        src: "{{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa"
        dest: "{{ user_home }}/.ssh/id_rsa"
        mode: '0600'
        owner: "{{ user.name }}"
        group: "{{ group }}"
      become: true
      when: user.manage_ssh_key | default(true)

    # ------------------------------------------------------------------
    # 8. Add public key to authorized_keys for user
    # ------------------------------------------------------------------
    - name: Add public key to authorized_keys for user
      authorized_key:
        user: "{{ user.name }}"
        state: present
        key: "{{ lookup('file', user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) + '/' + user.name + '_id_rsa.pub') }}"
      become: true
      when: user.manage_ssh_key | default(true)
  loop: "{{ users }}"



