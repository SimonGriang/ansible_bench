- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install requirements
  ansible.builtin.package:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.package:
    name: openjdk-8-jdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  ansible.builtin.yum:
    name: /tmp/oracle-java.rpm
    state: present

- name: Install DEB
  ansible.builtin.apt:
    deb: /tmp/oracle-java.deb
    state: present

- name: Install oracle java (rpm) (repository)
  ansible.builtin.yum:
    name: oracle-java8-installer
    state: present

- name: Configure oracle targz
  ansible.builtin.unarchive:
    src: /tmp/oracle-java.tgz
    dest: /opt/oracle/java
    remote_src: true
    creates: /opt/oracle/java

- name: Install oracle java policy software (targz)
  ansible.builtin.unarchive:
    src: /tmp/jce_policy.zip
    dest: "{{ java_home_result.stdout }}/lib/security"
    remote_src: true
    creates: "{{ java_home_result.stdout }}/lib/security"

- name: Set alternative (targz)
  community.general.alternatives:
    name: java
    link: /usr/bin/java
    path: /opt/oracle/java/bin/java
  when: ansible_os_family != "Alpine"

- name: Find JAVA_HOME
  ansible.builtin.shell: readlink -f $(which java)
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_result.stdout }}"
    state: present


