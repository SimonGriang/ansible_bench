---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_directories }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    system: yes

- name: Create user
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"
    shell: /sbin/nologin
    create_home: no

- name: Generate rndc key
  command: rndc-confgen -a -k rndc_key -c "{{ rndc_key_path }}"
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_path }}"
    mode: '0600'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ zone_name }}.zone"

- name: Add zones to configuration
  template:
    src: named.conf.zones.j2
    dest: /etc/bind/named.conf.local

- name: Place systemd override
  block:
    - file:
        path: /etc/systemd/system/bind9.service.d
        state: directory
        mode: '0755'
    - template:
        src: bind9_override.j2
        dest: /etc/systemd/system/bind9.service.d/override.conf

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: yes


