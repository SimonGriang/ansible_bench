---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    regexp: "^{{ item.key }}="
    line: "{{ item.key }}={{ item.value }}"
    create: yes
  loop: "{{ mysql_configuration_options | dict2items }}"
  loop_control:
    label: "{{ item.key }}"

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/client.cnf
    regexp: "^socket="
    line: "socket={{ mysql_socket }}"
    create: yes

- name: Initialize mysql
  shell: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases | selectattr('import', 'undefined') | list }}"

- name: List databases
  shell: mysql -e "SHOW DATABASES;"
  register: mysql_databases_list

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import }}"
  loop: "{{ mysql_databases | selectattr('import', 'defined') | list }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
