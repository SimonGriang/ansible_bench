---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: No configuration
    vtype: string

- name: Install postfix
  apt:
    name: postfix
    state: present
    update_cache: yes

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
    update_cache: yes
  when: (postfix_virtual_mailbox_maps is defined and 'mysql' in postfix_virtual_mailbox_maps) or (postfix_virtual_mailbox_domains is defined and 'mysql' in postfix_virtual_mailbox_domains) or (postix_virtual_alias_maps is defined and 'mysql' in postix_virtual_alias_maps)

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
  notify:
    - validate_postfix_config
    - rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - validate_postfix_config
    - reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default(omit) }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default(omit) }}"
  when: smtpd_recipient_restrictions is defined or smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ mynetworks | default(omit) }}"
    mydestination: "{{ mydestination | default(omit) }}"
    relay_domains: "{{ relay_domains | default(omit) }}"
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default(omit) }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default(omit) }}"
    virtual_mailbox_domains: "{{ virtual_mailbox_domains | default(omit) }}"
    virtual_alias_domains: "{{ virtual_alias_domains | default(omit) }}"
  when: mynetworks is defined or mydestination is defined or relay_domains is defined or smtpd_recipient_restrictions is defined or smtpd_sender_restrictions is defined or virtual_mailbox_domains is defined or virtual_alias_domains is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - validate_postfix_config
    - restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - validate_postfix_config
    - restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ item | dirname }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ postfix_smtpd_tls_cert_file }}"
    - "{{ postfix_smtpd_tls_key_file }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify:
    - reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
  notify:
    - rebuild_alias_db
    - reload_postfix

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify:
    - rebuild_sender_access_db
    - reload_postfix

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify:
    - validate_postfix_config
    - rebuild_recipient_access_db
    - reload_postfix

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    mode: '0600'
  notify:
    - rebuild_sasl_password_map_db

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


