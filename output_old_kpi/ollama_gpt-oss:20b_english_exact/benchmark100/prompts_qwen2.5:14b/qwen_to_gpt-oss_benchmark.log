---
- name: Restore etcd - get all nodes
  command: kubectl get nodes --no-headers -o custom-columns=NAME:.metadata.name
  register: etcd_nodes

- name: Restore etcd - remove old nodes
  command: >
    kubectl delete node {{ nodes_to_remove | join(' ') }}
  when: nodes_to_remove | length > 0
  vars:
    nodes_to_remove: "{{ etcd_nodes.stdout_lines | difference(groups['rke2_cluster']) }}"


