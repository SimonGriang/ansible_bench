---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  ping:
  become: true
  register: prep_result

- name: Gather bootstrap facts
  setup:
  when: prep_result is failed

- name: Install bootstrap packages (raw)
  raw: "{{ bootstrap_raw_command }}"
  when: ansible_os_family in ['RedHat', 'Debian']

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  when: ansible_distribution in ['Fedora', 'RedHat']

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes


