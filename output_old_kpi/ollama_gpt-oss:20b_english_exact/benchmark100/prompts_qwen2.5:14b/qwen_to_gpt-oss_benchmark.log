---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}"
    state: directory
    mode: '0750'
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    system: "{{ user.system | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    comment: "{{ user.comment | default(omit) }}"

- name: Set sudo options for {{ user.name }}
  copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0640'
    content: "{{ user.sudo_options }}"
    validate: "/usr/sbin/visudo --check %s"
  when: user.sudo_options is defined and user.sudo_options | length > 0

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined or user.sudo_options | length == 0

- name: Generate private ssh key for {{ user.name }}
  openssh_keypair:
    path: "{{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa"
    type: rsa
    size: 2048
    force: false
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Generate public ssh key for {{ user.name }}
  command: "ssh-keygen -y -f {{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa > {{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa.pub"
  args:
    creates: "{{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa.pub"
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Convert ssh key to ppk for {{ user.name }}
  command: "puttygen {{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa -O private -o {{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa.ppk"
  args:
    creates: "{{ user.ssh_key_directory | default('/tmp/ssh_keys/' + user.name) }}/{{ user.name }}_id_rsa.ppk"
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Get or set the home directory for {{ user.name }}
  set_fact:
    user_home: "{{ lookup('getent', 'passwd', user.name).split(':')[5] | default('/home/' + user.name) }}"
  when: user.home is not defined

