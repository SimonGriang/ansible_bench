---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  block:
    - name: Set SHELL env in cron config
      lineinfile:
        path: /etc/default/cron
        regexp: '^SHELL='
        line: "SHELL={{ cron_shell }}"
        state: present
        mode: '0644'
    - name: Restart cron
      service:
        name: "{{ cron_service }}"
        state: restarted

- name: Configure path
  block:
    - name: Set PATH env in cron config
      lineinfile:
        path: /etc/default/cron
        regexp: '^PATH='
        line: "PATH={{ cron_path }}"
        state: present
        mode: '0644'
    - name: Restart cron
      service:
        name: "{{ cron_service }}"
        state: restarted

- name: Configure mailto
  block:
    - name: Set MAILTO env in cron config
      lineinfile:
        path: /etc/default/cron
        regexp: '^MAILTO='
        line: "MAILTO={{ cron_mailto }}"
        state: present
        mode: '0644'
    - name: Restart cron
      service:
        name: "{{ cron_service }}"
        state: restarted

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default(omit) }}"
  loop: "{{ cron_jobs }}"



