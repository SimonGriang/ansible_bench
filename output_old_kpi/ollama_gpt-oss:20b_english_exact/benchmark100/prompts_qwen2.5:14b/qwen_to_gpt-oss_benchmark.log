---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_service_mgr == 'systemd'
  tags: systemd

- name: Get latest release of promtail
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: yes
    status_code: 200
  register: promtail_latest_release
  tags: promtail

- name: Set promtail_version from latest release tag
  set_fact:
    promtail_version: "{{ promtail_latest_release.json.tag_name }}"
  tags: promtail

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.zip"
  register: promtail_zip_stat
  tags: promtail

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_zip_stat.stat.exists
  when: promtail_binary_local_dir is defined
  tags: promtail

- name: Get checksum list
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.zip.sha256"
    method: GET
    return_content: yes
    status_code: 200
  register: promtail_checksums
  tags: promtail

- name: Extract checksum list for architecture
  set_fact:
    promtail_checksum_list: "{{ promtail_checksums.content | regex_findall('^([a-f0-9]+)\\s+' ~ go_arch, multiline=True) }}"
  tags: promtail

- name: Get checksum for specific architecture
  set_fact:
    promtail_checksum: "{{ promtail_checksum_list[0] }}"
  tags: promtail


