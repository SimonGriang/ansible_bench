tadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-03T10:41:35.342145521Z', 'done': True, 'done_reason': 'stop', 'total_duration': 144603189249, 'load_duration': 177074855, 'prompt_eval_count': 999, 'prompt_eval_duration': 616159054, 'eval_count': 12965, 'eval_duration': 143808919167, 'model_name': 'gpt-oss:20b'} id='run--d05fae50-f848-4c8c-824c-6441b51a566f-0' usage_metadata={'input_tokens': 999, 'output_tokens': 12965, 'total_tokens': 13964}
