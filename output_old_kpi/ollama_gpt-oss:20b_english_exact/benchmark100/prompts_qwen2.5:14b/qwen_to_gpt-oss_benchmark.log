---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables based on distribution
  include_vars: "{{ ansible_facts['distribution'] | lower }}.yml"

- name: Include architecture-specific variables
  include_vars: "{{ ansible_facts['architecture'] | lower }}.yml"

- name: Set OS-specific variables (part I)
  set_fact:
    java_package_name: "{{ java_package_name | default('openjdk-' + java_version|string + '-jdk') }}"
    java_repo_key_url: "{{ java_repo_key_url | default('') }}"
    java_repo_url: "{{ java_repo_url | default('') }}"

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_package_name: "{{ java_package_name | default('openjdk-' + java_version|string + '-jdk') }}"
    java_repo_key_url: "{{ java_repo_key_url | default('') }}"
    java_repo_url: "{{ java_repo_url | default('') }}"

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_version }}-openjdk-{{ java_jdk_vendor }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: 'ppa:old-repo'
        state: absent
    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
        state: present
        update_cache: yes
    - name: Add key repositories
      apt_key:
        url: "{{ java_repo_key_url }}"
        state: present
    - name: Add repositories
      apt_repository:
        repo: "{{ java_repo_url }}"
        state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ java_repo_key_url }}"
        state: present
    - name: Add repositories
      yum_repository:
        name: java
        description: Java Repository
        baseurl: "{{ java_repo_url }}"
        enabled: yes
        gpgcheck: yes
  when: ansible_facts['os_family'] == 'RedHat'

- name: Install required libraries
  block:
    - name: Install Debian specific libraries
      package:
        name: libxrender1
        state: present
      when: ansible_facts['os_family'] == 'Debian'
    - name: Install RedHat specific libraries
      package:
        name: libXrender
        state: present
      when: ansible_facts['os_family'] == 'RedHat'

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  register: java_install_result
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  register: java_install_result
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
  template:
    src: java.sh.j2
    dest: /etc/profile.d/java.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    path: "/usr/lib/jvm/{{ java_version }}-openjdk-{{ java_jdk_vendor }}/bin/java"
    priority: 1
  when:
    - ansible_facts['os_family'] == 'Debian'
    - java_version | int < 11

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    path: "/usr/lib/jvm/{{ java_version }}-openjdk-{{ java_jdk_vendor }}/bin/java"
    priority: 2
  when:
    - ansible_facts['os_family'] == 'Debian'
    - java_version | int >= 11


