---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install using package
  package:
    name: "{{ hashicorp_packages }}"
    state: present

- name: Install repository for RedHat
  yum_repository:
    name: hashicorp
    description: HashiCorp Stable
    baseurl: https://rpm.releases.hashicorp.com/RHEL/$releasever/$basearch/stable
    enabled: yes
    gpgcheck: yes
    gpgkey: https://rpm.releases.hashicorp.com/gpg

- name: Configure debian
  apt_repository:
    repo: "deb [arch=amd64] https://apt.releases.hashicorp.com $(lsb_release -sc) main"
    state: present
    filename: hashicorp

- name: Install required package gpg
  package:
    name: gnupg
    state: present

- name: Install apt key for Debian
  apt_key:
    url: https://apt.releases.hashicorp.com/gpg
    state: present

- name: Install repository for Debian
  apt_repository:
    repo: "deb [arch=amd64] https://apt.releases.hashicorp.com $(lsb_release -sc) main"
    state: present
    filename: hashicorp

- name: Install hashicorp product using package
  package:
    name: "{{ hashicorp_product }}"
    state: present

- name: Install versioned hashicorp product using package
  package:
    name: "{{ hashicorp_product }}={{ hashicorp_version }}"
    state: present

- name: Install manually
  unarchive:
    src: "{{ hashicorp_archive }}"
    dest: "{{ hashicorp_dest }}"
    remote_src: yes

- name: Install hashicorp product manually
  unarchive:
    src: "{{ product_src }}"
    dest: "{{ product_dest }}"
    remote_src: yes
    owner: "{{ product_owner }}"
    group: "{{ product_group }}"
    mode: "{{ product_mode }}"


