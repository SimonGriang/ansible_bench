- import_tasks: assert.yml

- name: Pre-configure Debian systems
  debconf:
    name: postfix
    question: main_mailer_type
    value: No configuration
    vtype: select

- name: Install postfix
  apt:
    name: postfix
    state: present
    update_cache: yes

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: >
    ('mysql' in postfix_virtual_mailbox_maps) or
    ('mysql' in postfix_virtual_mailbox_domains) or
    ('mysql' in postix_virtual_alias_maps)

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
  notify:
    - Validate postfix config
    - Rebuild transport_maps database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate postfix config
    - Reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions }}"
  when:
    - postfix_smtpd_recipient_restrictions is defined
    - postfix_smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ postfix_mynetworks }}"
    mydestination: "{{ postfix_mydestination }}"
    relay_domains: "{{ postfix_relay_domains }}"
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains }}"
  when:
    - postfix_mynetworks is defined
    - postfix_mydestination is defined
    - postfix_relay_domains is defined
    - postfix_smtpd_recipient_restrictions is defined
    - postfix_smtpd_sender_restrictions is defined
    - postfix_virtual_mailbox_domains is defined
    - postfix_virtual_alias_domains is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate postfix config
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate postfix config
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_src }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify: Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_src }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify: Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ postfix_alias_line }}"
    create: yes
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ postfix_sender_access_line }}"
    create: yes
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ postfix_recipient_access_line }}"
    create: yes
  notify:
    - Validate postfix config
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    mode: '0600'
  notify: Rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true



