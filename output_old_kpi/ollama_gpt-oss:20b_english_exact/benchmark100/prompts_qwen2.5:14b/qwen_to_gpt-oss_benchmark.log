- name: Install RKE2 package
  ansible.builtin.package:
    name: rke2
    state: present

- name: Download RKE2 installer
  ansible.builtin.get_url:
    url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-installer.sh
    dest: /tmp/rke2-install.sh
    mode: '0755'
  register: rke2_download

- name: Install RKE2
  ansible.builtin.command: /tmp/rke2-install.sh --version "{{ rke2_version }}"
  args:
    creates: /usr/local/bin/rke2
  notify: Install RKE2

