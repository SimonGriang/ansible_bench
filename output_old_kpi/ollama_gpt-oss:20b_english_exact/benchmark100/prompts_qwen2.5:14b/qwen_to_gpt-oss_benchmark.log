---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  package:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  package:
    name: "{{ rsyslog_features }}"
    state: present

- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
  when: rsyslog_deploy_default_config

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    mode: '0755'

- name: Configuring rsyslog forward rule
  template:
    src: rsyslog_forward.conf.j2
    dest: /etc/rsyslog.d/forward.conf
  when: not rsyslog_deploy_default_config

- name: Configuring additional config files
  copy:
    src: "{{ item }}"
    dest: "/etc/rsyslog.d/{{ item | basename }}"
    mode: '0644'
    owner: root
    group: root
  loop: "{{ rsyslog_additional_configs }}"

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: yes


