- name: Check if all variables have been set correctly
  ansible.builtin.assert:
    that:
      - bootstrap_wait_for_host is defined
      - bootstrap_install is defined
      - bootstrap_facts is defined

- name: Wait for host (when configured)
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_wait_for_port | default(22) }}"
    timeout: 300
  when: bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Gather facts
      ansible.builtin.setup:
  rescue:
    - name: Debug connection failure
      ansible.builtin.debug:
        msg: "Connection could not be established"

- name: Include tasks to gather bootstrap facts (raw)
  ansible.builtin.include_tasks: bootstrap_facts_raw.yml

- name: Install bootstrap packages (raw)
  ansible.builtin.raw: "{{ bootstrap_install.raw_command }}"
  when: bootstrap_install.raw is defined and bootstrap_install.raw | bool
  changed_when: false

- name: Ensure system is prepared by issuing ansible modules
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts.packages }}"


