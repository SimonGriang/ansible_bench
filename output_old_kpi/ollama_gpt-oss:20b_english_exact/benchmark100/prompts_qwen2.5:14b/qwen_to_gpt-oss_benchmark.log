- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}"
    state: directory
    mode: '0750'
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | bool

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    comment: "{{ user.comment | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    system: "{{ user.system | default(omit) }}"
  become: true

- name: Set sudo options for {{ user.name }}
  copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo }}"
    mode: '0640'
    validate: '/usr/sbin/visudo -cf %s'
  become: true
  when: user.sudo is defined and user.sudo | length > 0

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  become: true
  when: user.sudo is not defined or user.sudo | length == 0

- name: Generate private ssh key for {{ user.name }}
  openssh_keypair:
    path: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa"
    type: rsa
    size: 2048
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | bool

- name: Generate public ssh key for {{ user.name }}
  command: "ssh-keygen -y -f {{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa > {{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa.pub"
  args:
    creates: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa.pub"
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | bool

- name: Convert ssh key to ppk for {{ user.name }}
  command: >
    puttygen {{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa
    -O private -o {{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa.ppk
  args:
    creates: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa.ppk"
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | bool

- name: Get or set the home directory for {{ user.name }}
  set_fact:
    user_home: "{{ user.home | default(omit) }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  become: true
  when: user.manage_ssh_key | bool or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"
  become: true
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"
  become: true
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  become: true
  when: user.copy_private_key | bool

- name: Check users password valid time for {{ user.name }}
  command: "chage -l {{ user.name }} | grep 'Password expires'"
  register: password_expire
  become: true
  when: user.password_validity_days is defined

- name: Set users password valid time for {{ user.name }}
  command: "chage -M {{ user.password_validity_days }} {{ user.name }}"
  become: true
  when: user.password_validity_days is defined

- name: Place private key file for {{ user.name }}
  copy:
    dest: "{{ user_home }}/.ssh/{{ item.key }}"
    content: "{{ item.value }}"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  loop: "{{ user.private_keys | dict2items | default([]) }}"
  become: true
