---
- name: cadvisor | create directories
  file:
    path: "{{ cadvisor_install_dir }}"
    state: directory
    mode: '0755'

- name: cadvisor | download
  get_url:
    url: "https://github.com/google/cadvisor/releases/download/v{{ cadvisor_version }}/cadvisor-{{ cadvisor_version }}-linux-amd64"
    dest: "{{ cadvisor_install_dir }}/cadvisor"
    checksum: "sha256:{{ cadvisor_checksum }}"
    mode: '0755'
  when: cadvisor_local_dir is not defined

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_dir }}/cadvisor"
    dest: "{{ cadvisor_install_dir }}/cadvisor"
    mode: '0755'
  notify: cadvisor_restart
  when: cadvisor_local_dir is defined

- name: cadvisor | symlink
  file:
    src: "{{ cadvisor_install_dir }}/cadvisor"
    dest: /usr/local/bin/cadvisor
    state: link
    mode: '0755'

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'

- name: test_task
  command: systemctl is-active cadvisor
  register: service_active
  changed_when: false

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: true

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started


