- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables based on distribution
  ansible.builtin.include_vars: "{{ ansible_distribution | lower }}.yml"

- name: Include architecture-specific variables
  ansible.builtin.include_vars: "{{ ansible_architecture | lower }}.yml"

- name: Set OS-specific variables (part I)
  ansible.builtin.set_fact:
    java_package_name: >
      {{ java_package_name | default('openjdk-' + java_version|string + '-jdk') }}
    java_repo_key_url: >
      {{ java_repo_key_url | default('') }}
    java_repo_url: >
      {{ java_repo_url | default('') }}

- name: Set OS and architecture-specific variables (part II)
  ansible.builtin.set_fact:
    java_package_name: >
      {{ java_package_name | default('openjdk-' + java_version|string + '-jdk') }}
    java_repo_key_url: >
      {{ java_repo_key_url | default('') }}
    java_repo_url: >
      {{ java_repo_url | default('') }}

- name: Set specific variables
  ansible.builtin.set_fact:
    java_home: "/usr/lib/jvm/{{ java_version }}-openjdk-{{ java_jdk_vendor }}"

- name: Debian pre-requisites
  when: ansible_facts['os_family'] == 'Debian'
  block:
    - name: Remove deprecated repositories
      ansible.builtin.apt_repository:
        repo: 'ppa:old-repo'
        state: absent
    - name: Add repository
      ansible.builtin.apt_repository:
        repo: "{{ java_repo_url }}"
        state: present
    - name: Add repository key
      ansible.builtin.apt_key:
        url: "{{ java_repo_key_url }}"
        state: present

- name: RedHat pre-requisites
  when: ansible_facts['os_family'] == 'RedHat'
  block:
    - name: Add repository key
      ansible.builtin.rpm_key:
        key: "{{ java_repo_key_url }}"
        state: present
    - name: Add repository
      ansible.builtin.yum_repository:
        name: java
        description: Java Repository
        baseurl: "{{ java_repo_url }}"
        enabled: true
        gpgcheck: true

- name: Install required libraries
  block:
    - name: Install required libraries for Debian
      ansible.builtin.package:
        name: libnss3
        state: present
      when: ansible_facts['os_family'] == 'Debian'
    - name: Install required libraries for RedHat
      ansible.builtin.package:
        name: libnss3
        state: present
      when: ansible_facts['os_family'] == 'RedHat'

- name: Install Java on Debian
  ansible.builtin.apt:
    name: "{{ java_package_name }}"
    state: present
  register: apt_result
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java on RedHat
  ansible.builtin.yum:
    name: "{{ java_package_name }}"
    state: present
  register: yum_result
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
  ansible.builtin.template:
    src: java.j2
    dest: /etc/profile.d/java.sh
    mode: '0644'

- name: Source environment variables
  ansible.builtin.shell: source /etc/profile.d/java.sh
  changed_when: false

- name: Task/Handler: Correct alternatives for Debian
  when: ansible_facts['os_family'] == 'Debian'
  community.general.alternatives:
    path: "{{ java_home }}/bin/java"
    priority: 1
    name: java

- name: Task/Handler: Correct alternatives for RedHat
  when: ansible_facts['os_family'] == 'RedHat'
  community.general.alternatives:
    path: "{{ java_home }}/bin/java"
    priority: 1
    name: java



