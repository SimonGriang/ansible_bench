---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  community.general.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family in ['Debian', 'Suse']
  notify: Reload httpd

- name: Configure locations using a template
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration
    - Restart httpd


