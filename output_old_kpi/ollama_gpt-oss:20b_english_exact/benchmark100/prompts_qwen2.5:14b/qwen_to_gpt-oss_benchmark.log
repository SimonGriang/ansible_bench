    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  command: |
    kubectl taint nodes {{ inventory_hostname }} node-role.kubernetes.io/master- node-role.kubernetes.io/etcd- --overwrite
  when: rke2_type == 'server'

- name: Set agent taints
  command: |
    kubectl taint nodes {{ inventory_hostname }} node-role.kubernetes.io/worker- --overwrite
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: rke2_config.yaml
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: Restart RKE2

- name: Copy kubelet config file
  copy:
    src: kubelet_config.yaml
    dest: /etc/rancher/rke2/kubelet.yaml
    mode: '0644'
  when: kubelet_config is defined and kubelet_config | length > 0
  notify: Restart kubelet

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd_registries.yaml
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0644'
  when: containerd_registry_enabled | bool
  notify: Restart containerd

- name: Start RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
  register: rke2_service
  until: rke2_service is succeeded
  retries: 5
  delay: 10
  notify: Restart RKE2

- name: Mask other RKE2 services
  command: |
    systemctl mask rke2-agent rke2-controller
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl wait --for=condition=Ready nodes --all --timeout=300s
  register: wait_no_cni
  until: wait_no_cni.rc == 0
  retries: 5
  delay: 20

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl wait --for=condition=Ready nodes --all --timeout=300s
    kubectl wait --for=condition=Ready pods --all -n kube-system --timeout=300s
  register: wait_with_cni
  until: wait_with_cni.rc == 0
  retries: 5
  delay: 20


