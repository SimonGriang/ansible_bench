---  
- name: Import assert.yml  
  import_tasks: assert.yml  
  run_once: true  
  delegate_to: localhost  

- name: Install php  
  package:  
    name: "{{ php_packages }}"  
    state: present  

- name: Find used php.ini  
  shell: php -i | grep 'Loaded Configuration File' | awk '{print $4}'  
  register: php_found_ini_location  
  changed_when: false  
  when: php_ini_location is not defined  

- name: Configure php  
  template:  
    src: php.ini.j2  
