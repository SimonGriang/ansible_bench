---
- name: Create ssl key
  openssl_privatekey:
    path: "/etc/ssl/private/{{ item.name }}.key"
    size: 2048
    state: present
    mode: '0640'
    owner: "{{ ssl_owner | default('root') }}"
    group: "{{ ssl_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Create ssl csr
  openssl_csr:
    path: "/etc/ssl/{{ item.name }}.csr"
    privatekey_path: "/etc/ssl/private/{{ item.name }}.key"
    common_name: "{{ item.common_name | default(item.name) }}"
    state: present
    mode: '0644'
    owner: "{{ ssl_owner | default('root') }}"
    group: "{{ ssl_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Create ssl certificates
  openssl_certificate:
    path: "/etc/ssl/{{ item.name }}.crt"
    csr_path: "/etc/ssl/{{ item.name }}.csr"
    privatekey_path: "/etc/ssl/private/{{ item.name }}.key"
    provider: selfsigned
    state: present
    mode: '0644'
    owner: "{{ ssl_owner | default('root') }}"
    group: "{{ ssl_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "/etc/ssl/{{ item.name }}.p12"
    privatekey_path: "/etc/ssl/private/{{ item.name }}.key"
    certificate_path: "/etc/ssl/{{ item.name }}.crt"
    friendly_name: "{{ item.friendly_name | default(item.name) }}"
    mode: '0640'
    owner: "{{ ssl_owner | default('root') }}"
    group: "{{ ssl_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Read private key
  slurp:
    src: "/etc/ssl/private/{{ item.name }}.key"
  register: private_key_content
  loop: "{{ ssl_items }}"

- name: Read certificate
  slurp:
    src: "/etc/ssl/{{ item.name }}.crt"
  register: certificate_content
  loop: "{{ ssl_items }}"

- name: Create combined private_key and certificate file
  copy:
    dest: "/etc/ssl/{{ item.name }}.combined.pem"
    content: "{{ private_key_content.content | b64decode }}{{ certificate_content.content | b64decode }}"
    mode: '0640'
    owner: "{{ ssl_owner | default('root') }}"
    group: "{{ ssl_group | default('root') }}"
  loop: "{{ ssl_items }}"


