---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ packages }}"
    state: present
  notify:
    - root password
    - systemctl daemon reexecution

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item }}"
    state: present
  with_items: "{{ mysql_server_options }}"
  notify:
    - mysql server restart

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item }}"
    state: present
  with_items: "{{ mysql_client_options }}"

- name: Initialize mysql
  command: "{{ mysql_init_command }}"
  args:
    warn: false
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ databases }}"
  when: not initial_import

- name: List databases
  mysql_db:
    name: "{{ item }}"
    state: list
  with_items: "{{ databases }}"
  register: db_info

- name: Import database
  mysql_db:
    name: "{{ item.item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    import_file: "{{ initial_import_location }}/{{ item.item }}.sql"
  with_items: db_info.results
  when: initial_import and item.state == "absent"

- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
  with_items: "{{ users }}"
  notify:
    - mysql server restart

- name: Flush handlers again
  meta: flush_handlers


