---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  command: /usr/sbin/easyrsa init-pki
  args:
    creates: /etc/openvpn/easy-rsa/pki

- name: Generate OpenVPN CA certificate
  command: /usr/sbin/easyrsa build-ca nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate Diffie-Hellman parameters
  command: /usr/sbin/easyrsa gen-dh
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate server certificate
  command: /usr/sbin/easyrsa build-server-full nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate client certificate
  command: /usr/sbin/easyrsa build-client-full nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate Certificate Revocation List
  command: /usr/sbin/easyrsa gen-crl
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate OpenVPN TA key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,dh.pem,issued/{server.crt,server.key}}
    dest: /etc/openvpn/server/
    mode: '0640'

- name: Copy additional PKI files to /etc/openvpn directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/
    mode: '0640'
  notify: restart openvpn

- name: Place OpenVPN server configuration file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart openvpn


