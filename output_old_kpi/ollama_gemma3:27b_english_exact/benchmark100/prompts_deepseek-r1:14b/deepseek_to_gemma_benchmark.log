---
- name: Install Keepalived
  include_tasks: keepalived.yml
  when: ha_enabled

- name: Download and install RKE2
  block:
    - name: Download RKE2
      get_url:
        url: "{{ rke2_download_url }}"
        dest: /tmp/rke2.tar.gz
    - name: Install RKE2
      command: tar -xzf /tmp/rke2.tar.gz -C /usr/local/bin rke2
      args:
        creates: /usr/local/bin/rke2

- name: Perform CIS hardening
  include_tasks: cis_hardening.yml
  when: cis_profile is defined

- name: Find active server
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  block:
    - name: Ensure ipvs module is loaded
      modprobe:
        name: ipvs
        state: present
  when: ha_enabled and ipvs_enabled

- name: Copy kube-vip manifests
  include_tasks: kube_vip_manifests.yml
  when: ha_enabled and kube_vip_enabled

- name: Copy ingress-nginx manifests
  include_tasks: ingress_nginx_manifests.yml
  when: ingress_nginx_values is defined

- name: Prepare the first server node
  include_tasks: prepare_first_server.yml
  when: is_first_server

- name: Perform etcd restore
  include_tasks: etcd_restore.yml
  when: etcd_restore_enabled

- name: Download kubeconfig
  include_tasks: download_kubeconfig.yml
  when: download_kubeconfig_enabled

- name: Join remaining nodes
  include_tasks: join_remaining_nodes.yml
  when: active_server is defined

- name: Rolling restart of servers
  include_tasks: rolling_restart_servers.yml
  when: version_changes

- name: Rolling restart of agents
  include_tasks: rolling_restart_agents.yml
  when: version_changes

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config changes
  include_tasks: rolling_restart_config_changes.yml
  when: config_changes

- name: Perform final steps
  include_tasks: final_steps.yml


