d enable dns\n    service:\n      name: named\n      state: started\n      enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-04T19:57:06.59143073Z', 'done': True, 'done_reason': 'stop', 'total_duration': 36118752869, 'load_duration': 200796790, 'prompt_eval_count': 617, 'prompt_eval_duration': 575427783, 'eval_count': 652, 'eval_duration': 35340753978, 'model_name': 'gemma3:27b'} id='run--d364bc9d-fc7e-4747-88f5-4373ee011877-0' usage_metadata={'input_tokens': 617, 'output_tokens': 652, 'total_tokens': 1269}
