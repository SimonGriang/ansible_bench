```yaml
- name: hardening | Disable swap
  swapoff:
    path: all
  when: vault_hardening_disable_swap == true

- name: hardening | Disable core dumps
  pam_limits:
    domain: '*'
    limit_type: hard
    limit_item: core
    limit_value: 0
  when: vault_hardening_disable_core_dumps == true

- name: hardening | Disable core dumps
  pam_limits:
    domain: '*'
    limit_type: soft
    limit_item: core
    limit_value: 0
  when: vault_hardening_disable_core_dumps == true

- name: hardening | Disable Shell Command History
  lineinfile:
    path: /etc/profile.d/vault.sh
    line: 'HISTSIZE=0'
    create: yes
  when: vault_hardening_disable_shell_command_history == true

- name: hardening | Configure SELinux / AppArmor
  block:
    - name: Ensure SELinux is enabled and enforcing
      selinux:
        state: enforcing

    - name: Install SELinux policies (example - adjust as needed)
      yum:
        name: selinux-policy-targeted
        state: present
      when: ansible_os_family == "RedHat"

    - name: Install AppArmor profiles (example - adjust as needed)
      apt:
        name: apparmor-profiles
        state: present
        update_cache: yes
      when: ansible_os_family == "Debian"
  when: vault_hardening_configure_selinux_apparmor == true
```


