```yaml
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap
  ignore_errors: true

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and rke2_install_script_local is defined

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and not rke2_use_exists

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ item.url }}"
    dest: "{{ rke2_artifacts_dir }}/{{ item.name }}"
    checksum: "{{ item.checksum }}"
    mode: "{{ item.mode }}"
  with_items: "{{ rke2_artifacts }}"
  register: download_artifacts
  retries: 3
  delay: 5

- name: Download RKE2 checksum and artifacts - fallback to local
  get_url:
    url: "file://{{ rke2_local_artifacts_dir }}/{{ item.name }}"
    dest: "{{ rke2_artifacts_dir }}/{{ item.name }}"
    mode: "{{ item.mode }}"
  with_items: "{{ rke2_artifacts }}"
  when: download_artifacts.failed and rke2_local_artifacts_dir is defined

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_dir }}/{{ item.name }}"
    dest: "{{ rke2_artifacts_dir }}/{{ item.name }}"
    mode: 0640
  with_items: "{{ rke2_artifacts }}"
  when: rke2_airgap is defined and rke2_airgap and rke2_local_artifacts_dir is defined

- name: Airgap mode - additional images tarballs
  file:
    path: "{{ rke2_additional_images_dir }}"
    state: directory
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and rke2_additional_tarballs is defined

- name: Airgap mode - additional images tarballs copy
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_additional_images_dir }}/"
  with_items: "{{ rke2_additional_tarballs }}"
  when: rke2_airgap is defined and rke2_airgap and rke2_additional_tarballs is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and rke2_use_exists

- name: Airgap mode - ensure artifacts exist and have acceptable permissions - artifacts
  file:
    path: "{{ rke2_artifacts_dir }}"
    mode: 0555
    recurse: true
  when: rke2_airgap is defined and rke2_airgap and rke2_use_exists

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: usr_local_stats.fstype == 'ext4' or usr_local_stats.fstype == 'xfs'

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version_output
  ignore_errors: true

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_allow_downgrade is defined
      - rke2_allow_downgrade
    fail_msg: "RKE2 downgrade is not allowed unless explicitly permitted."
    success_msg: "RKE2 version check passed."
  when: rke2_version_output.rc == 0

- name: Run RKE2 install script
  command: "{{ rke2_install_script_dest }}/rke2 install --airgap {{ 'true' if rke2_airgap else 'false' }}"
  environment:
    RKE2_ARTIFACTS_DIR: "{{ rke2_artifacts_dir }}"
  when: rke2_install_script_dest is defined

- name: Copy Custom Manifests
  template:
    src: "custom-manifests.yaml.j2"
    dest: "{{ rke2_manifests_dir }}/custom-manifests.yaml"
    mode: 0644
  when: rke2_custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_src }}"
    dest: "{{ rke2_agent_pod_manifests_dir }}"
    mode: 0644
  when: rke2_static_pods_src is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: "/etc/rke2/rke2.yaml"
    mode: 0644
  when: rke2_environment_options is defined
```


