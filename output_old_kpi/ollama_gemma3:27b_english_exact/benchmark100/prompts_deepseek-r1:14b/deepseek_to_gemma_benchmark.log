---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: docker_compose_installation_type == "package"

- name: Install Docker Compose binary
  block:
    - name: Install required packages
      package:
        name:
          - curl
        state: present

    - name: Download Docker Compose binary
      get_url:
        url: https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-{{ docker_compose_version }}
        dest: /usr/local/bin/docker-compose
        mode: 0755
  when: docker_compose_installation_type == "binary"


