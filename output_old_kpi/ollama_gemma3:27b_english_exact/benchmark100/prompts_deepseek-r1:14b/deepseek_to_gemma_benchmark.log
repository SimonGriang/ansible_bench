---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap
  ignore_errors: true

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and rke2_install_script_local is defined

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and not rke2_use_exists

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ item.url }}"
    dest: "{{ rke2_artifacts_dir }}/{{ item.name }}"
    checksum: "{{ item.checksum }}"
    mode: "{{ item.mode }}"
  with_items: "{{ rke2_artifacts }}"
  register: download_artifacts
  retries: 3
  delay: 5

