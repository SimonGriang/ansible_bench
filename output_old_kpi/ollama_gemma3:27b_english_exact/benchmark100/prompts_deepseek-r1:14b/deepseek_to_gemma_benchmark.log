ems: "{{ users }}"\n  notify:\n    - mysql server restart\n\n- name: Flush handlers again\n  ansible.builtin.meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-04T20:28:55.781090139Z', 'done': True, 'done_reason': 'stop', 'total_duration': 35750888430, 'load_duration': 199019400, 'prompt_eval_count': 3081, 'prompt_eval_duration': 2803492615, 'eval_count': 623, 'eval_duration': 32746408462, 'model_name': 'gemma3:27b'} id='run--bb1f05e7-1892-415a-9b1d-3a0fac42cf2c-0' usage_metadata={'input_tokens': 3081, 'output_tokens': 623, 'total_tokens': 3704}
