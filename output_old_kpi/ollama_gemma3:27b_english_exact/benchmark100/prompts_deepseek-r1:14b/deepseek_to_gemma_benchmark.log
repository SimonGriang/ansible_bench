---

- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  ignore_errors: true

- name: Download helm
  unarchive:
    remote_src: true
    src: https://get.helm.sh/helm-v3.12.1-linux-amd64.tar.gz
    dest: /tmp/
    creates: /usr/local/bin/helm
  register: helm_download
  when: helm_check.stat.exists == false or helm_existing_version.stdout != "version.BuildInfo{Version:\"v3.12.1\", GitCommit:\"\", GitTreeState:\"\"}"

- name: Copy helm binary into place
  copy:
    src: /tmp/helm-v3.12.1-linux-amd64/helm
    dest: /usr/local/bin/helm
    remote_src: yes
    owner: root
    group: root
    mode: '0755'
  become: true
  when: helm_download.changed


