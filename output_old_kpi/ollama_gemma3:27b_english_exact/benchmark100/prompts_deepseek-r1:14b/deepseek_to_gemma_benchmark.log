- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  become: false
  ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=\"([0-9]+(\\.[0-9]+)?)\"', '\\1') }}"
  with_items: "{{ bootstrap__os_family_map }}"
  when: bootstrap_facts.stdout is defined and bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') == item.key
  become: "{{ become | default(false) }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  with_items: "{{ bootstrap__os_family_map }}"
  when: bootstrap_distribution is defined and bootstrap_distribution in item.value
  become: "{{ become | default(false) }}"


