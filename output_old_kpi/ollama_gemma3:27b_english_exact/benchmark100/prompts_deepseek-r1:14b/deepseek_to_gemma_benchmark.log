      state: present
      version: "{{ item.version }}"
    loop: "{{ python_pip_modules }}"
    when:
      - ansible_distribution != "Debian"
      - ansible_distribution == "Debian" and ansible_distribution_release in ["bookworm", "noble"]
      - ansible_os_family != "Alpine"


