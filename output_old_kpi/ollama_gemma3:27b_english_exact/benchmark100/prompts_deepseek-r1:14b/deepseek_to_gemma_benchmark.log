---
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Pre-configure debian systems
    apt:
      update_cache: yes
      cache_valid_time: 3600
    become: yes
    when: ansible_os_family == "Debian"

  - name: Install postfix
    apt:
      name: postfix
      state: present
    become: yes

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present
    become: yes
    when: virtual_mailbox_mappings or domains_using_mysql

  - name: Configure postfix (transport_maps)
    template:
      src: transport_maps.j2
      dest: /etc/postfix/transport_maps
    become: yes
    notify:
      - validate postfix configuration
      - rebuild postfix database

  - name: Configure postfix (header_checks)
    template:
      src: header_checks.j2
      dest: /etc/postfix/header_checks
    become: yes
    notify:
      - validate postfix configuration
      - reload postfix

  - name: Setting values for main.cf (1/2)
    set_fact:
      postfix_recipient_restrictions: "{{ recipient_restrictions | default([]) }}"
      postfix_sender_restrictions: "{{ sender_restrictions | default([]) }}"

  - name: Setting values for main.cf (2/2)
    set_fact:
      postfix_mynetworks: "{{ mynetworks | default([]) }}"
      postfix_mydestination: "{{ mydestination | default([]) }}"
      postfix_relay_domains: "{{ relay_domains | default([]) }}"
      postfix_other_settings: "{{ other_settings | default({}) }}"

  - name: Configure postfix (main.cf)
    template:
      src: main.cf.j2
      dest: /etc/postfix/main.cf
    become: yes
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Configure postfix (master.cf)
    template:
      src: master.cf.j2
      dest: /etc/postfix/master.cf
    become: yes
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Creates cert/key directory
    file:
      path: "{{ postfix_tls_key_dir }}"
      state: directory
      mode: '0750'
      owner: root
      group: root
    become: yes

  - name: Deploy Postfix TLS server certificate
    copy:
      src: "{{ postfix_tls_cert_file }}"
      dest: "{{ postfix_tls_cert_file }}"
      owner: root
      group: root
      mode: '0644'
    become: yes
    notify:
      - reload postfix

  - name: Deploy Postfix TLS server key
    copy:
      src: "{{ postfix_tls_key_file }}"
      dest: "{{ postfix_tls_key_file }}"
      owner: root
      group: root
      mode: '0600'
    become: yes
    notify:
      - reload postfix

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      path: /etc/aliases
      line: "{{ item }}"
      create: yes
    become: yes
    with_items: "{{ aliases }}"
    notify:
      - rebuild postfix database
      - reload postfix

  - name: Configure sender_access
    lineinfile:
      path: /etc/postfix/sender_access
      line: "{{ item }}"
      create: yes
    become: yes
    with_items: "{{ sender_access_list }}"
    notify:
      - rebuild postfix database
      - reload postfix

  - name: Configure recipient_access
    lineinfile:
      path: /etc/postfix/recipient_access
      line: "{{ item }}"
      create: yes
    become: yes
    with_items: "{{ recipient_access_list }}"
    notify:
      - validate postfix configuration
      - rebuild postfix database
      - reload postfix

  - name: Place sasl_password_map
    copy:
      content: "{{ sasl_password_map_content }}"
      dest: /etc/postfix/sasl_password_map
      owner: root
      group: root
      mode: '0600'
    become: yes
    notify:
      - rebuild postfix database

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes
    become: yes


