  run_once: true
  delegate_to: localhost

- name: Install requirements
  ansible.builtin.package:
    name: "{{ sysctl_requirements }}"
    state: present
  when: sysctl_requirements is defined

- name: Set sysctl setting
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    reload: true
  loop: "{{ sysctl_items }}"
  when: sysctl_items is defined and ansible_connection != 'container'
```


