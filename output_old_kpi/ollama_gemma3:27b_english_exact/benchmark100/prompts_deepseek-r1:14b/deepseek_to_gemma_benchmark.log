  - name: Check current docker-compose version.
    command: docker-compose --version
    register: docker_compose_version_check
    ignore_errors: true

  - name: Set fact for docker-compose current version.
    set_fact:
      docker_compose_current_version: "{{ docker_compose_version_check.stdout | regex_search('docker-compose version (\\d+\\.\\d+\\.\\d+)') | first }}"
    when: docker_compose_version_check.stdout is defined

  - name: Delete existing docker-compose version if it's different.
