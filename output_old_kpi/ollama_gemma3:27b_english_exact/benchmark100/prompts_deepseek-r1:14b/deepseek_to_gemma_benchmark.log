---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port }}"
      timeout: "{{ bootstrap_timeout }}"
    when: bootstrap_connection_type == 'tcp'

  - name: Prepare system
    block:
      - name: Test connection and sudo access
        command: "echo 'connection and sudo test'"
        register: test_result
        ignore_errors: true
      - name: Gather facts and install necessary packages if connection or sudo fails
        block:
          - name: Gather facts
            setup:
            register: facts_result
          - name: Install necessary packages (raw)
            raw: "yum install -y dnf-plugins-core || apt-get update && apt-get install -y dnf-plugins-core"
            when: ansible_os_family == "RedHat"
          - name: Install libdnf5 (raw)
            raw: "yum install -y libdnf5 || apt-get update && apt-get install -y libdnf5"
            when: ansible_os_family == "RedHat"
        when: test_result.rc != 0
    rescue:
      - name: Handle errors during system preparation
        debug:
          msg: "System preparation failed. Check logs for details."

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
    become: "{{ bootstrap_become }}"


