    - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_config }}"
    dest: /etc/rke2/containerd/config.toml
    mode: '0644'
    owner: root
    group: root
  when: rke2_registry_mirrors or rke2_containerd_config
  notify:
    - restart rke2

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file and rke2_service_status.status.ActiveState != 'active' }}"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: "{{ rke2_etcd_s3_options is defined and rke2_etcd_s3_options and rke2_etcd_s3_bucket }}"

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/db
        state: directory
        mode: '0755'
        owner: rke2
        group: rke2

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/db/snapshot.db
        mode: '0644'
        owner: rke2
        group: rke2

    - name: Restore etcd from file
      command: rke2 etcd-snapshot restore --snapshot-file /var/lib/rke2/etcd/db/snapshot.db
      changed_when: true
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Restore etcd from S3
      command: rke2 etcd-snapshot restore --s3-bucket {{ rke2_etcd_s3_bucket }} --s3-key {{ rke2_etcd_s3_key }} --s3-region {{ rke2_etcd_s3_region }}
      changed_when: true
  when: etcd_restore_from_s3

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify:
    - restart rke2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    state: stopped
    masked: yes
    enabled: no
  when: "'server' in group_names"

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 10250
    timeout: 300
  when: not rke2_cni_plugin

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 10250
    timeout: 300
  when: rke2_cni_plugin

- name: Restore etcd
  block:
    - name: Clean up old nodes and secrets
      command: rke2 node-clean
      changed_when: true
  when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: all
```


