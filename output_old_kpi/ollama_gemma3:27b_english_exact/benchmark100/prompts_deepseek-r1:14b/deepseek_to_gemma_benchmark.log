---
  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port }}"
      timeout: "{{ bootstrap_timeout }}"
    when: "'container' not in ansible_connection and 'docker' not in ansible_connection and 'community.docker.docker' not in ansible_connection"

  - name: Prepare system
    block:
      - name: Test connection
        ping:
          timeout: "{{ bootstrap_timeout }}"
      - name: Test sudo version
        command: sudo -V
        register: sudo_version
        changed_when: false
        failed_when: sudo_version.rc != 0
    rescue:
      - name: Gather facts
        setup:
          gather_subset:
            - hardware
            - network
            - virtual
      - name: Install bootstrap packages (package)
        package:
          name: "{{ bootstrap_facts_packages }}"
          state: present
        become: "{{ bootstrap_become }}"

  - name: Gather ansible facts
    setup:
      gather_subset:
        - all
    become: false

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
    become: "{{ bootstrap_become }}"


