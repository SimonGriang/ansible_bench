---

- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command: cat /etc/os-release
  register: os_release
  changed_when: false
  check_mode: true

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    distribution_name: "{{ os_release.stdout | regex_search('NAME=\"(.*)\"', '\\1') }}"
    distribution_major_version: "{{ os_release.stdout | regex_search('VERSION_ID=\"(.*)\"', '\\1') | split('.')[0] }}"

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: "{{
      'Debian' if distribution_name == 'Debian' or distribution_name == 'Ubuntu'
      else 'RedHat' if distribution_name == 'CentOS' or distribution_name == 'Rocky' or distribution_name == 'AlmaLinux' or distribution_name == 'Red Hat Enterprise Linux'
      else 'Suse' if distribution_name == 'openSUSE Leap' or distribution_name == 'SUSE Linux Enterprise Server'
      else 'Other'
    }}"


