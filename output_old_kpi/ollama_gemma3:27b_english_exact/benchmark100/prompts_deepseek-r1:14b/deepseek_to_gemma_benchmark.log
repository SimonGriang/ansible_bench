    return_content: yes
  register: checksums_file
  changed_when: false
- name: Set checksum for target architecture
  set_fact:
    promtail_checksum: "{{ checksums_file.content | regex_search('{{ promtail_architecture }}\\s+(.*)') | default('') | trim }}"


