content='```yaml\n---\n- name: Import assertion file\n  include_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Enable Redis module stream for RHEL 8\n  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"\n  command: dnf module enable redis -y\n\n- name: Install Redis package\n  package:\n    name: "{{ redis_packages }}"\n    state: present\n\n- name: Configure Redis settings\n  template:\n    src: redis.conf-{{ ansible_distribution }}.j2\n    dest: /etc/redis.conf\n    owner: "{{ redis_owner }}"\n    group: "{{ redis_group }}"\n    mode: "{{ redis_mode }}"\n  notify: Restart Redis\n\n- name: Start and enable Redis service\n  service:\n    name: "{{ redis_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-04T21:22:08.187289556Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11524811749, 'load_duration': 202820642, 'prompt_eval_count': 453, 'prompt_eval_duration': 396815584, 'eval_count': 212, 'eval_duration': 10924406612, 'model_name': 'gemma3:27b'} id='run--5aa9ccc0-5bd6-428f-98cf-67f37084194e-0' usage_metadata={'input_tokens': 453, 'output_tokens': 212, 'total_tokens': 665}
