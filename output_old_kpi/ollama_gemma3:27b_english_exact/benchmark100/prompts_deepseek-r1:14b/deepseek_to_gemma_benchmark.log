- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package
  block:
    - name: Install using package - Debian/Ubuntu
      when: ansible_os_family == "Debian"
      package:
        name: "{{ hashicorp_package }}"
        state: present
        update_cache: true

    - name: Install using package - RedHat/CentOS/Rocky Linux
      when: ansible_os_family == "RedHat"
      package:
        name: "{{ hashicorp_package }}"
        state: present
        update_cache: true

    - name: Install using package - MacOS
      when: ansible_os_family == "Darwin"
      community.general.homebrew:
        name: "{{ hashicorp_package }}"
        state: present
        update_homebrew: true


