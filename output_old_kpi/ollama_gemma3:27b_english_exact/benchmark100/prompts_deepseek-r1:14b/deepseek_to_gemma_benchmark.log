```yaml
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2/
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-server-pdb
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            node-role.kubernetes.io/server: ""
  when: node_type == 'server'

- name: Set agent taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-agent-pdb
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            node-role.kubernetes.io/agent: ""
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify: restart rke2

- name: Copy Kubelet configuration file
  template:
    src: kubelet.yaml.j2
    dest: /var/lib/kubelet/config.yaml
    mode: '0644'
    owner: root
    group: root
  when: kubelet_configuration is defined
  notify: restart kubelet

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ container_registry_config_path }}"
    dest: /etc/containerd/config.toml
    mode: '0644'
    owner: root
    group: root
  when: container_registry_config_path is defined
  notify: restart containerd

- name: Start RKE2 service on other nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  delegate_to: localhost
  run_once: true
  with_items: "{{ groups['all'] }}"
  when: inventory_hostname != ansible_hostname

- name: Mask other RKE2 services on nodes
  systemd:
    name: "{{ item }}"
    masked: yes
  with_items:
    - rke2-agent
    - rke2-server
  when: node_type != 'server' and item == 'rke2-server' or node_type != 'agent' and item == 'rke2-agent'

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    timeout: 600
  with_items: "{{ groups['all'] }}"
  when: not cni_configured and inventory_hostname != ansible_hostname

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    timeout: 600
  with_items: "{{ groups['all'] }}"
  when: cni_configured and inventory_hostname != ansible_hostname
```


