content='```yaml\n---\n- name: Check if EFI firmware exists on the system\n  stat:\n    path: /sys/firmware/efi/efivars/\n  register: efi_check\n\n- name: Remove GRUB configuration file on EFI systems\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_check.stat.exists\n\n- name: Install custom user template for GRUB\n  copy:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    mode: 0755\n\n- name: Add EFI password protection to GRUB\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: "password_pbkdf2 mypassword"\n    state: present\n  when: efi_check.stat.exists\n\n- name: Add MBR password protection to GRUB\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: "password_pbkdf2 mypassword"\n    state: present\n  when: not efi_check.stat.exists\n\n- name: Add unrestricted access to GRUB password entries\n  lineinfile:\n    path: /etc/grub.d/01_users\n    regexp: \'GRUB_ENABLE_PASSWORD=\'\n    line: \'GRUB_ENABLE_PASSWORD=y --unrestricted\'\n    state: present\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-04T20:02:10.458295308Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18685344382, 'load_duration': 221415367, 'prompt_eval_count': 505, 'prompt_eval_duration': 433532748, 'eval_count': 336, 'eval_duration': 18029584792, 'model_name': 'gemma3:27b'} id='run--fcd98d7f-88b8-49c9-8028-3c469191b913-0' usage_metadata={'input_tokens': 505, 'output_tokens': 336, 'total_tokens': 841}
