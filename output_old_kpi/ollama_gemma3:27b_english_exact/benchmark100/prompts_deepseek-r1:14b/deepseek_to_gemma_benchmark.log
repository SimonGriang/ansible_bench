    dest: "{{ rke2_artifacts_dir }}/{{ item.name }}"
    mode: "{{ item.mode }}"
  with_items: "{{ rke2_artifacts }}"
  when: download_artifacts.failed and rke2_local_artifacts_dir is defined

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_dir }}/{{ item.name }}"
    dest: "{{ rke2_artifacts_dir }}/{{ item.name }}"
    mode: 0640
  with_items: "{{ rke2_artifacts }}"
  when: rke2_airgap is defined and rke2_airgap and rke2_local_artifacts_dir is defined

- name: Airgap mode - additional images tarballs
  file:
    path: "{{ rke2_additional_images_dir }}"
    state: directory
    mode: 0700
  when: rke2_airgap is defined and rke2_airgap and rke2_additional_tarballs is defined

- name: Airgap mode - additional images tarballs copy
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_additional_images_dir }}/"
  with_items: "{{ rke2_additional_tarballs }}"
  when: rke2_airgap is defined and rke2_airgap and rke2_additional_tarballs is defined

