content='```yaml\n---\n- name: Restart RKE2 service on {{ rke2_node_name}}\n  systemd:\n    name: rke2-server\n    state: restarted\n  notify: "Service (re)started"\n\n- name: Wait for all nodes to be ready again\n  command: kubectl get nodes -o jsonpath=\'{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\\n"}{end}\'\n  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"\n  retries: 100\n  delay: 15\n  register: node_status\n  until: node_status.stdout == "True\\nTrue\\nTrue\\nTrue\\n" # Adjust the number of "True\\n" based on the number of nodes\n  when: ansible_check_mode == false\n\n- name: Wait for all pods to be ready again\n  command: kubectl get pods --all-namespaces -o jsonpath=\'{range .items[*]}{.status.phase}{"\\n"}{end}\'\n  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"\n  retries: 100\n  delay: 15\n  register: pod_status\n  until: pod_status.stdout == "Running\\nRunning\\nRunning\\nRunning\\n" # Adjust the number of "Running\\n" based on the number of pods\n  when: ansible_check_mode == false and rke2_wait_for_all_pods_to_be_ready\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-04T22:56:08.321841759Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20629922530, 'load_duration': 206596788, 'prompt_eval_count': 527, 'prompt_eval_duration': 495495770, 'eval_count': 362, 'eval_duration': 19925912127, 'model_name': 'gemma3:27b'} id='run--000de557-5bc5-4a75-a8cd-e66c592839e2-0' usage_metadata={'input_tokens': 527, 'output_tokens': 362, 'total_tokens': 889}
