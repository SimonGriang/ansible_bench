      src: master.cf.j2
      dest: /etc/postfix/master.cf
    become: yes
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Creates cert/key directory
    file:
      path: "{{ postfix_tls_key_dir }}"
      state: directory
      mode: '0750'
      owner: root
      group: root
    become: yes

  - name: Deploy Postfix TLS server certificate
    copy:
      src: "{{ postfix_tls_cert_file }}"
      dest: "{{ postfix_tls_cert_file }}"
      owner: root
      group: root
      mode: '0644'
    become: yes
    notify:
      - reload postfix

  - name: Deploy Postfix TLS server key
    copy:
      src: "{{ postfix_tls_key_file }}"
      dest: "{{ postfix_tls_key_file }}"
      owner: root
      group: root
      mode: '0600'
    become: yes
    notify:
      - reload postfix

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      path: /etc/aliases
      line: "{{ item }}"
      create: yes
    become: yes
    with_items: "{{ aliases }}"
    notify:
      - rebuild postfix database
      - reload postfix

  - name: Configure sender_access
    lineinfile:
      path: /etc/postfix/sender_access
      line: "{{ item }}"
      create: yes
    become: yes
    with_items: "{{ sender_access_list }}"
    notify:
      - rebuild postfix database
      - reload postfix

  - name: Configure recipient_access
    lineinfile:
      path: /etc/postfix/recipient_access
      line: "{{ item }}"
      create: yes
    become: yes
    with_items: "{{ recipient_access_list }}"
    notify:
      - validate postfix configuration
      - rebuild postfix database
      - reload postfix

  - name: Place sasl_password_map
    copy:
      content: "{{ sasl_password_map_content }}"
      dest: /etc/postfix/sasl_password_map
      owner: root
      group: root
      mode: '0600'
    become: yes
    notify:
