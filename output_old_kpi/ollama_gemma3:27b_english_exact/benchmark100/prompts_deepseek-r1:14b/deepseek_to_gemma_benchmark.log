---

- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
  with_items: "{{ java_certs }}"
  register: java_cert_status

- name: Fail if Java certificates are missing
  fail:
    msg: "Java certificate missing at path: {{ item.item }}"
  when: item.stat.exists is not defined or not item.stat.exists
  with_items: "{{ java_cert_status.results }}"

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "/opt/java/keystore"
  when: java_version|int < 11

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "/opt/java/new_keystore"
  when: java_version|int >= 11

- name: Import SSL certificates into Java keystore
  command: keytool -importcert -alias "{{ item.alias }}" -file "{{ item.path }}" -keystore "{{ java_keystore_dir }}/keystore.jks" -storepass "{{ keystore_password }}" -noprompt
  with_items: "{{ ssl_certs }}"
  args:
    creates: "{{ java_keystore_dir }}/keystore.jks"


