---

  - name: Import assertion tasks
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install Python pip
    package:
      name: python3-pip
      state: present

  - name: Configure pip proxy settings
    lineinfile:
      path: /etc/pip.conf
      section: global
      line: index-url = {{ python_pip_proxy }}
    when: python_pip_proxy is defined

  - name: Configure pip trusted hosts
    lineinfile:
      path: /etc/pip.conf
      section: global
      line: trusted-host = {{ python_pip_trusted_host }}
    when: python_pip_trusted_host is defined

  - name: Update pip
    pip:
      name: pip
      state: latest
    when: ansible_distribution != "Debian" or (ansible_distribution == "Debian" and ansible_distribution_release in ["bookworm", "noble"]) or ansible_os_family != "Alpine"

  - name: Install Python modules
    pip:
      name: "{{ item }}"
      state: present
      version: "{{ item.version }}"
    loop: "{{ python_pip_modules }}"
    when: ansible_distribution != "Debian" or (ansible_distribution == "Debian" and ansible_distribution_release in ["bookworm", "noble"]) or ansible_os_family != "Alpine"


