---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost

  - name: Install dns
    package:
      name: "{{ dns_packages }}"
      state: present

  - name: Create directories
    file:
      path: "{{ item.path }}"
      mode: "{{ item.mode }}"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      state: directory
    loop:
      - path: "{{ dns_data_dir }}"
        mode: "0750"
      - path: "{{ dns_config_dir }}"
        mode: "0750"

  - name: Create group
    group:
      name: "{{ dns_group }}"
      state: present

  - name: Create user
    user:
      name: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      system: yes
      state: present

  - name: Generate rndc key
    command: rndc-confgen -a -k rndc-key -n {{ inventory_hostname }}
    args:
      creates: "{{ dns_config_dir }}/rndc-key"

  - name: Set permissions on rndc key file
    file:
      path: "{{ dns_config_dir }}/rndc-key"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: "0640"

  - name: Get the hints/root file
    get_url:
      url: "{{ dns_root_hints_url }}"
      dest: "{{ dns_config_dir }}/named.root"
      mode: "0644"
    when: dns_caching_dns

  - name: Create zone file
    template:
      src: "zone.j2"
      dest: "{{ dns_data_dir }}/{{ item }}.db"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: "0640"
    loop: "{{ dns_zones }}"
    notify: Rndc reload

  - name: Add zones to configuration
    template:
      src: "named.conf.j2"
      dest: "{{ dns_config_dir }}/named.conf"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: "0640"
    notify: Restart dns

  - name: Place systemd override
    template:
      src: "named.service.j2"
      dest: "/etc/systemd/system/named.service.d/override.conf"
    when: use_systemd
    notify: Reload systemd

  - name: Start and enable dns
    service:
      name: named
      state: started
      enabled: yes


