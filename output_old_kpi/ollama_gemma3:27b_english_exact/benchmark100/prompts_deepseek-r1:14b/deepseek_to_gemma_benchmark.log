---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Check if SELinux is enabled
      ansible.builtin.command: sestatus
      register: selinux_status
      ignore_errors: true

    - name: Set SELinux boolean settings
      ansible.posix.sebool:
        name: "{{ item }}"
        state: "on"
      loop: "{{ selinux_booleans }}"
      when: selinux_status.rc == 0

    - name: Allow connections to specified ports
      ansible.posix.firewalld:
        port: "{{ item }}/tcp"
        permanent: true
        state: enabled
      loop: "{{ httpd_ports }}"
      when: ansible_os_family == "RedHat" and selinux_status.rc == 0
  when: enable_selinux

- name: Configure httpd
  ansible.builtin.template:
    src: httpd.conf.j2
    dest: "{{ httpd_config }}"
    mode: "0644"
  notify:
    - configtest
    - restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules }}"
  changed_when: false
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml
  when: enable_ssl

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml
  when: locations_defined

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml
  when: vhosts_defined

- name: Configure ports
  ansible.builtin.template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_file }}"
    mode: "0644"
  notify:
    - configtest
    - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml
  when: directories_defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "{{ httpd_docroot }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


