```yaml
- name: Import assertion tasks
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required software packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  with_items: "{{ users_requirements }}"
  when: users_requirements | length > 0

- name: Manage user groups
  ansible.builtin.include_tasks:
    file: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group_name

- name: Configure sudoers directory inclusion
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: include /etc/sudoers.d/*
    state: present
    validate: visudo -cf %s

- name: Manage user configurations
  ansible.builtin.include_tasks:
    file: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user_name

- name: Configure cron allow permissions
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow

- name: Remove cron allow file if not needed
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow
```


