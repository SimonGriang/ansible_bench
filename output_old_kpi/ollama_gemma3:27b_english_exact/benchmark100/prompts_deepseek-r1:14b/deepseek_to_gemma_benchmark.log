        owner: rke2
        group: rke2

    - name: Restore etcd from file
      command: rke2 etcd-snapshot restore --snapshot-file /var/lib/rke2/etcd/db/snapshot.db
      changed_when: true
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Restore etcd from S3
      command: rke2 etcd-snapshot restore --s3-bucket {{ rke2_etcd_s3_bucket }} --s3-key {{ rke2_etcd_s3_key }} --s3-region {{ rke2_etcd_s3_region }}
      changed_when: true
  when: etcd_restore_from_s3

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify:
    - restart rke2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    state: stopped
    masked: yes
    enabled: no
  when: "'server' in group_names"

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 10250
    timeout: 300
  when: not rke2_cni_plugin

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 10250
    timeout: 300
  when: rke2_cni_plugin

- name: Restore etcd
  block:
    - name: Clean up old nodes and secrets
      command: rke2 node-clean
      changed_when: true
  when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: all
```


