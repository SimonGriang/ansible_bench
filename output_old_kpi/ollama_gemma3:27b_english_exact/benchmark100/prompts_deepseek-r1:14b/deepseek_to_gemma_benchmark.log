- name: Configure Docker Nightly repo
  ansible.builtin.lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enabled=.*$'
    line: "enabled={{ docker_yum_repo_enable_nightly }}"
  when: docker_add_repo

- name: Configure Docker Test repo
  ansible.builtin.lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^test=.*$'
    line: "test={{ docker_yum_repo_enable_test }}"
  when: docker_add_repo

- name: Configure containerd on RHEL 8
  block:
    - name: Remove runc package
      ansible.builtin.yum:
        name: runc
        state: absent

    - name: Ensuring container-selinux is installed
      ansible.builtin.yum:
        name: container-selinux
        state: present

    - name: Ensuring containerd.io is installed
      ansible.builtin.yum:
        name: containerd.io
        state: present
  when: ansible_facts.distribution_major_version == 8
```


