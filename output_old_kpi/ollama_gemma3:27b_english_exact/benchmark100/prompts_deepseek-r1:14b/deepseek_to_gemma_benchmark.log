---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present
    notify:
      - Set root password
      - Systemctl daemon-reexec

  - name: Configure mysql server
    lineinfile:
      path: /etc/mysql/my.cnf
      line: "{{ item.key }} = {{ item.value }}"
      create: yes
    with_dict: "{{ mysql_configuration_options }}"
    notify: Restart mysql server

  - name: Configure mysql client
    lineinfile:
      path: /etc/mysql/my.cnf
      line: "socket = {{ mysql_client_socket }}"
      create: yes

  - name: Initialize mysql
    command: mysql_install_db --user=mysql
    args:
      creates: /var/lib/mysql/mysql.sock
    when: ansible_distribution in ["Alpine", "Archlinux"]

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: /etc/mysql/my.cnf
      mode: 0644

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
    loop: "{{ mysql_databases }}"
    when: mysql_databases is defined

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      host: "{{ item.host }}"
      state: present
    loop: "{{ mysql_users }}"
    when: mysql_users is defined

  - name: Flush handlers again
    meta: flush_handlers


