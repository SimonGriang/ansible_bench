---
- name: Migrate adoptopenjdk to temurin
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}_{{ ansible_os_family }}_{{ ansible_distribution_version }}.yml"
  ignore_errors: yes

- name: Gather architecture specific variables
  include_vars:
    file: "vars/{{ ansible_architecture }}.yml"
  ignore_errors: yes

- name: Set OS specific variables (I)
  set_fact:
    openjdk_version: "{{ openjdk_version | default('8') }}"
    openjdk_repositories: "{{ openjdk_repositories | default([]) }}"
    openjdk_libs: "{{ openjdk_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    openjdk_install_path: "{{ openjdk_install_path | default('/usr/lib/jvm') }}"
    openjdk_package_name: "{{ openjdk_package_name | default('openjdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ openjdk_install_path }}/{{ openjdk_version }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://ppa.launchpad.net/webupd8/java/ubuntu {{ ansible_distribution_release }} main"
        state: absent
      when: ansible_os_family == 'Debian'

    - name: Install extra apt tools
      apt:
        name:
          - software-properties-common
          - apt-transport-https
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add key repositories
      apt_key:
        url: "{{ item.url }}"
        state: present
      with_items: "{{ openjdk_key_repos }}"
      when: ansible_os_family == 'Debian'

    - name: Add required repositories
      apt_repository:
        repo: "{{ item.repo }}"
        state: present
      with_items: "{{ openjdk_debian_repos }}"
      when: ansible_os_family == 'Debian'
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item.key }}"
        state: present
      with_items: "{{ openjdk_key_repos }}"
      when: ansible_os_family == 'RedHat'

    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
        enabled: yes
      with_items: "{{ openjdk_redhat_repos }}"
      when: ansible_os_family == 'RedHat'
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  apt:
    name: "{{ openjdk_libs }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install required libs
  yum:
    name: "{{ openjdk_libs }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install Java, Debian
  apt:
    name: "{{ openjdk_package_name }}-{{ openjdk_version }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ openjdk_package_name }}-{{ openjdk_version }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: 0755

- name: Source environment variables
  shell: "source /etc/profile.d/java.sh"

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: openjdk_version | int < 11

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: openjdk_version | int >= 11


