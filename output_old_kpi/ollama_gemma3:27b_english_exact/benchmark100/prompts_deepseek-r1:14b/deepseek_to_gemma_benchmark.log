---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  become: yes
  no_log: yes

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: yes
    autoremove: yes
    autoclean: yes
  become: yes
  no_log: yes
  vars:
    apt_update_cache_retries: 3
    apt_update_cache_timeout: 300

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: kernel*
  become: yes
  no_log: yes

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  become: yes
  no_log: yes

- name: Configure yum
  block:
    - name: Check OS version
      setup:
      become: yes
      no_log: yes

    - name: Update all software (dnf)
      dnf:
        name: '*'
        state: latest
      become: yes
      when: ansible_distribution_major_version == "7" or ansible_distribution_major_version == "8"
      no_log: yes

    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
      become: yes
      when: ansible_distribution_major_version != "7" and ansible_distribution_major_version != "8"
      no_log: yes

    - name: Update all software (yum)
      yum:
        name: '*'
        state: latest
      become: yes
      when: ansible_distribution_major_version != "7" and ansible_distribution_major_version != "8"
      no_log: yes
  no_log: yes

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
  become: yes
  no_log: yes


