content='```yaml\n---\n\n- name: Restore etcd - get all nodes\n  kubernetes.core.k8s:\n    api_version: v1\n    kind: Node\n    namespace: ""\n    state: list\n  register: all_nodes\n\n- name: Restore etcd - remove old nodes\n  kubernetes.core.k8s:\n    api_version: v1\n    kind: Node\n    name: "{{ item }}"\n    state: absent\n  loop: "{{ all_nodes.resources | selectattr(\'metadata.name\', \'notin\', groups[rke2_cluster_group_name]) | map(attribute=\'metadata.name\') | list }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-04T22:48:26.4581851Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8103644741, 'load_duration': 202938846, 'prompt_eval_count': 365, 'prompt_eval_duration': 375547632, 'eval_count': 149, 'eval_duration': 7523400459, 'model_name': 'gemma3:27b'} id='run--10017aac-fc3f-4c16-80ce-41bf1b71cc6a-0' usage_metadata={'input_tokens': 365, 'output_tokens': 149, 'total_tokens': 514}
