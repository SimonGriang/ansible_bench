---
- name: Ensure Vault package is installed
  package:
    name: vault
    state: present

- name: Ensure Vault service is enabled and started
  service:
    name: vault
    state: started
    enabled: yes

- name: Configure Vault unseal key
  copy:
    src: files/unseal_key
    dest: /root/unseal_key
    mode: '0600'

- name: Initialize Vault
  command: "vault operator init"
  register: vault_init_output
  changed_when: "'Initial root token' in vault_init_output.stdout"
  no_log: true

- name: Set initial root token
  command: "vault login {{ vault_init_output.stdout_lines[0].split(':')[1].strip() }}"
  no_log: true

- name: Unseal Vault
  command: "vault unseal {{ lookup('file', '/root/unseal_key') }}"
  no_log: true

- name: Enable transit secret engine
  command: "vault secrets enable -path=transit transit"
  no_log: true

- name: Create a root policy
  copy:
    src: files/root_policy.hcl
    dest: /tmp/root_policy.hcl

- name: Create root policy
  command: "vault policy write root /tmp/root_policy.hcl"
  no_log: true

- name: Create root token
  command: "vault write auth/token/root role_name=root token_ttl=3600 token_max_ttl=7200"
  no_log: true


