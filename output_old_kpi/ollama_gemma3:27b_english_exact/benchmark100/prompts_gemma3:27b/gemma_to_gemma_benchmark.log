---
- name: Load OS-specific variables
  include_vars:
    file: "{{ lookup('first_found', ['vars/' + ansible_distribution + '.yml', 'vars/' + ansible_os_family + '.yml', 'vars/main.yml']) }}"

- name: Include RedHat setup tasks
  include_tasks: redhat.yml
  when: ansible_facts.os_family == 'RedHat'

- name: Include Debian setup tasks
  include_tasks: debian.yml
  when: ansible_facts.os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when: ansible_version.major < 2 and (ansible_facts.os_family != 'RedHat' and ansible_facts.os_family != 'Debian')

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    update_cache: true
    allow_downgrade: true
  notify: restart docker
  ignore_errors: true
  when: ansible_version.major >= 2 and (ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian')

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: true
  when: docker_install_compose_plugin and ansible_version.major < 2 and \
        (ansible_facts.os_family != 'RedHat' and ansible_facts.os_family != 'Debian')

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    update_cache: true
    allow_downgrade: true
  notify: restart docker
  ignore_errors: true
  when: docker_install_compose_plugin and ansible_version.major >= 2 and \
        (ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian')

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_json(indent=2) }}"
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true

- name: Ensure handlers are notified now to avoid firewall conflicts.
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group.
  set_fact:
    at_least_one_user_to_modify: "{{ docker_users | length > 0 and \
                                    (docker_group_info.group.members | length < (docker_users | length)) }}"

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify is defined


