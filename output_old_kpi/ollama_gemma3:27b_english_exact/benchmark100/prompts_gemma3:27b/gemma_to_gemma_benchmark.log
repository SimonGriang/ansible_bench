---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: default-jdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "-jre-doc -jre-src"

- name: Install RPM
  package:
    name: "{{ java_source_rpm }}"
    state: present
  when: java_source == "local" and java_format == "rpm"
  become: true
  become_method: copy
  args:
    chdir: /tmp/
    creates: "{{ java_source_rpm }}"

- name: Install DEB
  package:
    name: "{{ java_source_deb }}"
    state: present
  when: java_source == "local" and java_format == "deb"
  become: true
  become_method: copy
  args:
    chdir: /tmp/
    creates: "{{ java_source_deb }}"

- name: Install oracle java (rpm) (repository)
  package:
    name: java
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
  when: java_format == "targz" and java_vendor == "oracle"
  become: true

- name: Configure oracle targz
  unarchive:
    src: "{{ java_source_targz }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
    creates: "{{ java_install_dir }}/{{ java_version }}"
  when: java_format == "targz" and java_vendor == "oracle"
  become: true

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_url }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
    creates: "{{ java_install_dir }}/{{ java_jce_file }}"
  when: java_jce and java_version == "8" and java_vendor == "oracle"
  become: true

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_install_dir }}/{{ java_version }}/bin/java"
    state: present
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  become: true

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java | sed 's/\/bin\/java//'"
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home_result.stdout }}"'
    create: yes
    state: present
  become: true


