---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "/etc/mysql/conf.d/{{ mysql_name }}-server.cnf"
    owner: root
    group: root
    mode: 0644
  notify:
    - Restart mysql server

- name: Configure mysql client
  ansible.builtin.template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "/etc/mysql/conf.d/{{ mysql_name }}-client.cnf"
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.copy:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


