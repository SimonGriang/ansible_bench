  register: bootstrap_facts

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search(item.version_regex, '\\1') | first | default('') }}"
  loop:
    - version_regex: "release=(\\d+)"
      value: "Ubuntu"
    - version_regex: "version=(\\d+)"
      value: "CentOS"
    - version_regex: "VERSION=(\\d+)"
      value: "Debian"
    - version_regex: "VERSION_ID=(\\d+)"
      value: "AlmaLinux"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search(item.version_regex)

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: bootstrap_distribution in item.value
  loop_control:
    label: "{{ item.key }}"
```


