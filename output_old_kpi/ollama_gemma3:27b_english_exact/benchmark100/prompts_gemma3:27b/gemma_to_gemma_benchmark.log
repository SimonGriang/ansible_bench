pd_remove_example\n\n- name: Start and enable httpd\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-06T17:25:12.650799453Z', 'done': True, 'done_reason': 'stop', 'total_duration': 30771811087, 'load_duration': 212808938, 'prompt_eval_count': 853, 'prompt_eval_duration': 815322236, 'eval_count': 610, 'eval_duration': 29742692134, 'model_name': 'gemma3:27b'} id='run--64a57207-c29f-4244-aae4-1b5a4c2e6ebd-0' usage_metadata={'input_tokens': 853, 'output_tokens': 610, 'total_tokens': 1463}
