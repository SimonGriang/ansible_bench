---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  template:
    src: kubelet.yaml.j2
    dest: /var/lib/kubelet/config.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  template:
    src: container-registry.yaml.j2
    dest: /etc/containerd/config.toml
    mode: '0644'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: restart rke2

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  retries: 5
  delay: 10
  register: rke2_service_result
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    state: masked
    enabled: no
  loop:
    - rke2-agent
    - rke2-cri-socket
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o wide | awk '{print $1}' | while read node; do
      kubectl describe node "$node" | grep -q "Memory:.*Available" &&
      kubectl describe node "$node" | grep -q "Disk:.*Available" &&
      kubectl describe node "$node" | grep -q "PID:.*Running" &&
      kubectl get pods --all-namespaces -o wide --field-selector status.phase=Running | grep -q "$node"
      if [ $? -eq 0 ]; then
        echo "$node is ready"
      else
        echo "$node is not ready"
        exit 1
      fi
    done
  retries: 60
  delay: 10
  when: rke2_cni == 'none' and (inventory_hostname == 'server' or inventory_hostname == 'first_server')

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes -o wide | grep Ready | wc -l
  retries: 60
  delay: 10
  register: node_count
  when: rke2_cni != 'none' and (inventory_hostname == 'server' or inventory_hostname == 'first_server')


