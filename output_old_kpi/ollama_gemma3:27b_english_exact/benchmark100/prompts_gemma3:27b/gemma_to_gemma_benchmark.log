  command: rndc-confgen -a -k rndc.key -n .
  args:
    chdir: "{{ dns_confdir }}"
  when: not lookup('file', "{{ dns_confdir }}/rndc.key", errors='ignore')

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: "0644"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.zone }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/{{ dns_service }}.d
        state: directory
        mode: "0755"
    - name: Copy systemd override file
      copy:
        src: systemd_override.conf
        dest: /etc/systemd/system/{{ dns_service }}.d/override.conf
        mode: "0644"
    - name: Reload systemd daemon
      systemd:
        daemon_reload: true
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


