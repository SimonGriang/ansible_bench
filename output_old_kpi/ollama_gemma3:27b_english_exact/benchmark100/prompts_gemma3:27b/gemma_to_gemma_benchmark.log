- Last generated (faulty) playbook:
---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.posix.selinux:
    state: enforcing
    policy: targeted
  when: selinux_enabled

- name: Configure selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  loop: "{{ httpd_sebooleans }}"
  when: selinux_enabled

- name: Allow httpd connections to custom ports
  ansible.posix.firewalld:
    port: "{{ item }}"
    permanent: true
    state: enabled
  loop:
    - "{{ httpd_port }}"
    - "{{ httpd_ssl_port }}"
  when: selinux_enabled and ansible_facts['distribution'] == "CentOS"

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_facts['distribution'] == "Debian"

- name: Import ssl.yml
  ansible.builtin.include_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  ansible.builtin.include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  ansible.builtin.include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_ports_conf }}"
    mode: 0644
  notify:
    - test httpd configuration
    - restart httpd
  when: ansible_facts['distribution'] in ["Debian", "Suse"]

- name: Import directories.yml
  ansible.builtin.include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


