---
- name: Create logrotate.d files
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "/etc/logrotate.d/{{ item.name }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries }}"
  when: item.state == 'present'

- name: Ensure logrotate configuration exists
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: file
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries }}"

- name: Update logrotate configuration
  ansible.builtin.lineinfile:
    path: "/etc/logrotate.d/{{ item.name }}"
    regexp: "^rotate "
    line: "rotate {{ item.rotate }}"
  loop: "{{ logrotate_entries }}"
  when: item.rotate is defined

- name: Update logrotate configuration
  ansible.builtin.lineinfile:
    path: "/etc/logrotate.d/{{ item.name }}"
    regexp: "^daily"
    line: "{{ item.frequency }}"
  loop: "{{ logrotate_entries }}"
  when: item.frequency is defined

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.state == 'absent'


