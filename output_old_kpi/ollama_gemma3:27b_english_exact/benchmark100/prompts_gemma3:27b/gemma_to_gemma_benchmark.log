pip_modules }}"\n    loop_control:\n      label: "{{ item.name }}"\n    when:\n      - ansible_facts[\'distribution\'] != "Debian"\n      - ansible_facts[\'distribution_version\'] not in ["bookworm", "noble"]\n      - ansible_facts[\'os_family\'] != "Alpine"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-06T16:47:18.953194169Z', 'done': True, 'done_reason': 'stop', 'total_duration': 37449784117, 'load_duration': 195760341, 'prompt_eval_count': 1044, 'prompt_eval_duration': 1004274744, 'eval_count': 706, 'eval_duration': 36248630643, 'model_name': 'gemma3:27b'} id='run--555c1070-f0b4-4d9e-a047-acf7dab719d6-0' usage_metadata={'input_tokens': 1044, 'output_tokens': 706, 'total_tokens': 1750}
