---
- name: Ensure RKE2 service is installed
  ansible.builtin.package:
    name: rke2
    state: present

- name: Ensure RKE2 service is enabled and started
  ansible.builtin.service:
    name: rke2
    state: started
    enabled: true

- name: Wait for all nodes to be ready
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    state: started
    delay: 10
    timeout: 300
  register: rke2_ready
  until: rke2_ready.state == "started"

- name: Service (re)started
  ansible.builtin.service:
    name: rke2
    state: restarted
  listen: "restart_rke2"
  delegate_to: localhost
  run_once: true


