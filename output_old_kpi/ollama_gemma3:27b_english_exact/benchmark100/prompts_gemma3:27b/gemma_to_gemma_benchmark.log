2, 'eval_duration': 26273143280, 'model_name': 'gemma3:27b'} id='run--4fdb9b7f-23ad-4cb2-8eb7-26724d9ceba4-0' usage_metadata={'input_tokens': 674, 'output_tokens': 512, 'total_tokens': 1186}
