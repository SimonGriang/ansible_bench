---

  - name: Check OS compatibility
    ansible.builtin.setup:
      gather_subset:
        - '!hardware'
    when: ansible_distribution in ["Amazon", "RedHat"] and ansible_distribution_major_version in ["7", "8", "9", "10"]

  - name: Install epel gpg key
    ansible.builtin.rpm_key:
      key: "{{ epel_gpg_key }}"
      state: present

  - name: Install epel-release package
    ansible.builtin.yum:
      name: epel-release
      state: present
      update_cache: yes
    notify: Update package cache

  - name: Install epel-next-release package
    ansible.builtin.yum:
      name: epel-next-release
      state: present
      update_cache: yes
    when: epel_next
    notify: Update package cache


