---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'container'
    - bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Test connection and sudo
      command: echo "Testing connection and sudo access"
      register: test_result
      failed_when: test_result.rc != 0
  rescue:
    - name: Gather facts
      setup:
    - name: Install bootstrap packages via raw
      raw: "yum install -y {{ bootstrap_facts_packages | join(' ') }}"
      become: true
      when: ansible_os_family == "RedHat"
    - name: Ensure libdnf5 is present on RedHat-based systems
      package:
        name: libdnf5
        state: present
      become: true
      when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"


