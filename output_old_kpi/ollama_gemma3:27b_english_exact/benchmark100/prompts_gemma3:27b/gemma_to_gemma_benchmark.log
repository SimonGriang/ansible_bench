---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    createhome: false
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
    state: directory

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}/vault.zip"
    validate_certs: false
  become: true

- name: Unarchive Vault binary
  unarchive:
    src: "{{ vault_download_path }}/vault.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
  become: true

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
    state: directory
  when: not vault_check_path.stat.exists and vault_path

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: "openssl req -newkey rsa:2048 -nodes -keyout tls.key -x509 -days 365 -out tls.crt"
  args:
    chdir: "{{ vault_data_directory }}/tls"
  become: true
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: 0755
  become: true
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    cap: cap_ipc_lock=ep
    path: /usr/bin/vault
  become: true

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    state: touch
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: 0755
    state: directory
  become: true

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644
  become: true
  notify: Daemon reload
  when: ansible_service_mgr == "systemd"

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: 0644
  become: true
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


