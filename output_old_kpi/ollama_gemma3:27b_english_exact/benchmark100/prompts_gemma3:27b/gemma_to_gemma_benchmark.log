---
- name: Create ssh_key_directory for user
  file:
    path: "{{ ssh_key_directory }}"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    comment: "{{ user.comment }}"
    home: "{{ user.home }}"
    password: "{{ user.password }}"
    uid: "{{ user.uid }}"
    group: "{{ user.group }}"
    shell: "{{ user.shell }}"
    expiry: "{{ user.expiry }}"
  register: user_result

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
    validate: /usr/bin/visudo -cf %s
  loop: "{{ users }}"
  loop_control:
    label: "User {{ item.name }}"
  when: user.sudo is defined

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  loop_control:
    label: "User {{ item.name }}"
  when: user.sudo is not defined

- name: Generate private ssh key for user
  command: "ssh-keygen -t rsa -N '' -f {{ ssh_private_key_path }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for user
  command: "ssh-keygen -y -f {{ ssh_private_key_path }} > {{ ssh_public_key_path }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Convert ssh key to ppk for user
  command: "ssh-keygen -p -f {{ ssh_private_key_path }} -m PEM"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Get or set the home directory for user
  command: "getent passwd {{ user.name }}"
  register: user_info
  changed_when: false
  failed_when: user_info.rc != 0
  ignore_errors: true
  when: user.name is defined
- name: Set fact for base directory
  set_fact:
    base_directory: "/home"
  when: user_info.rc != 0
- name: Set fact for home directory
  set_fact:
    home_directory: "{{ user_info.stdout | regex_search(':[^:]+')[0] | regex_replace('^[^:]+:', '') }}"
  when: user_info.rc == 0

- name: Create .ssh directory for user
  file:
    path: "{{ home_directory }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.manage_ssh_key is defined or private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ ssh_private_key_path }}"
    dest: "{{ home_directory }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  command: "grep '{{ user.name }}:' /etc/shadow"
  register: shadow_entry
  changed_when: false
  ignore_errors: true

- name: Set users password valid time
  lineinfile:
    path: /etc/shadow
    regexp: "^{{ user.name }}:.*"
    line: "{{ user.name }}:{{ user.password_hash }}:{{ user.password_age }}:{{ user.password_max_age }}:{{ user.password_warn_age }}:"
    state: present

- name: Place private key file for user
  copy:
    content: "{{ user.private_key_content }}"
    dest: "{{ home_directory }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.private_keys is defined


