```yaml
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_exists
  failed_when: not user_exists.passwd and fail_key

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0700'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0600'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(false) }}"
    accept_hostkey: true
  loop: "{{ git_repositories }}"
  become: true
  become_user: "{{ git_username }}"
  loop_label: "Cloning {{ item.name }} to {{ git_repository_destination }}"
```


