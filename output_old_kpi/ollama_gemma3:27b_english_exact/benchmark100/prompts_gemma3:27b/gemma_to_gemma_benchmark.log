---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  when: ansible_connection is defined and ansible_connection != 'container' and bootstrap_wait_for_host is true
  become: false

- name: Prepare system
  block:
    - ping:
    - command: "sudo -n true"
      register: sudo_test
      ignore_errors: true
    - fail:
        msg: "Sudo access is required but not configured."
      when: sudo_test.rc != 0
  rescue:
    - name: Gather bootstrap facts
      setup:
    - name: Install bootstrap packages (package)
      package:
        name:
          - curl
          - net-tools
        state: present
      become: true

- name: Gather ansible facts
  setup:
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages | split(',') }}"
    state: present
  become: "{{ bootstrap_become | default(false) }}"


