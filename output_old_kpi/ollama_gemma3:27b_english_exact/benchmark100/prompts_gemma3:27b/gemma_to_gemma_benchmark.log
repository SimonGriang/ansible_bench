---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is defined and ansible_connection != 'container'
  notify: Reboot

- name: Manage selinux booleans
  selinux_boolean:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: true
  loop: "{{ selinux_booleans | default([]) }}"
  when: selinux_booleans is defined


