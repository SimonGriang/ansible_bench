---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/rke2.yaml
    owner: root
    group: root
    mode: '0644'
  notify: "Config file changed"

- name: Copy kubelet config
  template:
    src: kubelet.yaml.j2
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  notify: "Config file changed"
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd-registry.yaml.j2
    dest: /etc/containerd/config.toml
    owner: root
    group: root
    mode: '0644'
  notify: "Config file changed"
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and (ansible_service_mgr == 'systemd' and ansible_systemd_state == 'running') and rke2_server_service is not defined

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options != ""

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshot
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshot/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Restore etcd from file
      command: "rke2 server --restore-from-file=/var/lib/rke2/etcd/snapshot/snapshot.db"
  when: do_etcd_restore and not do_etcd_restore_from_s3

- name: Restore etcd from s3
  command: "rke2 server --restore-from-s3={{ rke2_etcd_snapshot_s3_options }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    daemon_reload: yes
    environment:
      RKE2_TOKEN: "{{ rke2_server_token }}"
  notify: "Service (re)started"

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    masked: yes
    disabled: yes

- name: Wait for the first server be ready - no CNI
  command: "kubectl get pods -A"
  register: kubectl_output
  until: "'Running' in kubectl_output.stdout and 'kube-system' in kubectl_output.stdout"
  retries: 30
  delay: 10

- name: Wait for the first server be ready - with CNI
  command: "kubectl get pods -A"
  register: kubectl_output
  until: "'Ready' in kubectl_output.stdout and 'kube-system' in kubectl_output.stdout"
  retries: 30
  delay: 10

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: "kubectl get nodes --output=jsonpath='{.items[*].metadata.name}'"
      register: registered_nodes

    - name: Get node names
      set_fact:
        node_names: "{{ registered_nodes.stdout | split(' ') }}"

    - name: Remove old secrets
      command: "kubectl delete secrets -A"

    - name: Remove old nodes
      command: "kubectl delete nodes --all"
  when: do_etcd_restore

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ hostvars[item] }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"


