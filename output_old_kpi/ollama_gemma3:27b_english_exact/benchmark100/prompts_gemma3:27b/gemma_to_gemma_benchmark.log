```yaml
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: /tmp/rke2-install.sh
    mode: '0755'
  when: rke2_airgap is defined and not rke2_airgap

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: /tmp/rke2-install.sh
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_install_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_install_implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Attempt remote download of artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2.tar.gz"
        checksum: "{{ rke2_artifacts_checksum }}"
      register: remote_download
      ignore_errors: true

    - name: Download artifacts locally and copy if remote download fails
      get_url:
        url: "{{ rke2_artifacts_local_url }}"
        dest: /tmp/rke2.tar.gz
        checksum: "{{ rke2_artifacts_local_checksum }}"
      when: remote_download.failed

    - name: Copy local artifacts to remote host
      copy:
        src: /tmp/rke2.tar.gz
        dest: "{{ rke2_artifacts_path }}/rke2.tar.gz"
        mode: '0644'
      when: remote_download.failed
  when: rke2_airgap is defined and rke2_airgap

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_path }}"
    dest: "{{ rke2_artifacts_path }}/rke2.tar.gz"
    mode: '0644'
  when: rke2_airgap is defined and rke2_airgap and rke2_install_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  get_url:
    url: "{{ item.url }}"
    dest: "{{ rke2_artifacts_path }}/{{ item.filename }}"
    mode: '0644'
  loop: "{{ rke2_additional_images }}"
  when: rke2_airgap is defined and rke2_airgap

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  file:
    path: "{{ rke2_artifacts_path }}/rke2.tar.gz"
    mode: '0644'
  when: rke2_airgap is defined and rke2_airgap

- name: Populate service facts
  setup:
    filter: ansible_service_units
  delegate_to: localhost

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stats

- name: Check if separate partition
  set_fact:
    rke2_usr_local_separate_partition: "{{ usr_local_stats.stats.mount is defined }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin/rke2
  when: not rke2_usr_local_separate_partition

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | regex_search('rke2 version (.*)', '\\1') | default('unknown') }}"
    rke2_running_version: "{{ rke2_version.stdout | default('unknown') }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_desired_version is not defined
      - rke2_desired_version is defined and rke2_desired_version == rke2_installed_version
    msg: "Downgrade to {{ rke2_desired_version }} is not allowed unless explicitly permitted."

- name: Run RKE2 install script
  command: /tmp/rke2-install.sh
  environment:
    RKE2_VERSION: "{{ rke2_version_string }}"
  register: rke2_install_result

- name: Copy Custom Manifests
  copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_data_dir }}/{{ item.dest }}"
    mode: '0644'
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_agent_dir }}/{{ item.dest }}"
    mode: '0644'
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: /etc/rke2/rke2.yaml
    mode: '0644'
  when: rke2_environment_file is defined
```


