---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Enable redis module stream (RHEL 8)
    block:
      - name: Check if the system is RHEL 8
        ansible.builtin.command: cat /etc/redhat-release
        register: redhat_release
        changed_when: false

      - name: Enable redis module stream
        ansible.builtin.dnf:
          name: redis
          state: present
          module_stream: redis
        when: "'Red Hat Enterprise Linux release 8' in redhat_release.stdout"

    become: true

  - name: Install redis
    ansible.builtin.package:
      name: "{{ redis_packages }}"
      state: present
    become: true

  - name: Configure redis
    ansible.builtin.template:
      src: redis.conf-{{ ansible_distribution }}.j2
      dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
      owner: "{{ redis_configuration_owner }}"
      group: "{{ redis_configuration_group }}"
      mode: "{{ redis_configuration_mode }}"
    notify: Restart redis
    become: true

  - name: Start and enable redis
    ansible.builtin.service:
      name: "{{ redis_service }}"
      state: started
      enabled: true
    become: true


