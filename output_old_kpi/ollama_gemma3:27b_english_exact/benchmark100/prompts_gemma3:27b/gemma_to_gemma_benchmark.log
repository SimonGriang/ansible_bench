      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr in ["dnf", "dnf5"]
    notify: Reboot

  - name: Update all software (pacman)
    pacman:
      update_cache: yes
      upgrade: yes
    when: ansible_pkg_mgr == "pacman"
    notify: Reboot

  - name: Configure yum
    yum:
      name: '*'
      state: latest
      exclude: "{{ update_excluded_packages | default([]) }}"
      update_cache: yes
    when: ansible_pkg_mgr == "yum"
    vars:
      update_excluded_packages: "{{ update_excluded_packages | default([]) }}"
    notify: Reboot

  - name: Update all software (zypper)
    zypper:
      name: '*'
      state: latest
    when: ansible_pkg_mgr == "zypper"
    notify: Reboot


