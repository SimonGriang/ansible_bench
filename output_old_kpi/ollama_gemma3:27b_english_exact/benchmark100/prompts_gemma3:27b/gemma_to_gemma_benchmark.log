---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.copy:
    dest: "{{ mysql_name }}-server.cnf"
    content: "{{ mysql_configuration_options | join('\n') }}"
    owner: root
    group: root
    mode: 0644

- name: Configure mysql client
  ansible.builtin.copy:
    dest: "{{ mysql_name }}-client.cnf"
    content: "socket = {{ mysql_socket }}"
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    query: "SHOW DATABASES;"
  register: mysql_databases_output

- name: Log database list
  ansible.builtin.debug:
    msg: "{{ mysql_databases_output.stdout }}"

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    import_file: "{{ item.target }}"
    only_if: mysql_initial_import_target is defined
  loop: "{{ mysql_databases }}"
  when: item.target is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


