word }}"\n    socket: "{{ mysql_socket }}"\n    import_file: "{{ item.target }}"\n  loop: "{{ mysql_databases }}"\n  when: item.target is defined\n\n- name: Create users\n  community.mysql.mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.privileges }}"\n    host: "{{ item.host }}"\n    state: present\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    socket: "{{ mysql_socket }}"\n  loop: "{{ mysql_users }}"\n\n- name: Flush handlers again\n  ansible.builtin.meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-06T16:38:06.342229662Z', 'done': True, 'done_reason': 'stop', 'total_duration': 41756088708, 'load_duration': 194578051, 'prompt_eval_count': 4038, 'prompt_eval_duration': 3838168053, 'eval_count': 734, 'eval_duration': 37721468924, 'model_name': 'gemma3:27b'} id='run--97a08eb7-5665-4c48-ab82-07b251a1c1ec-0' usage_metadata={'input_tokens': 4038, 'output_tokens': 734, 'total_tokens': 4772}
