content='```yaml\n---\n\n  - name: gather_facts | Lookup bootstrap facts\n    raw: cat /etc/os-release\n    register: bootstrap_facts\n\n  - name: gather_facts | Set bootstrap facts (I)\n    set_fact:\n      bootstrap_distribution: "{{ item.value }}"\n      bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search(item.version_regex) | first | default(\'\') }}"\n    loop:\n      - version_regex: "release=(\\\\d+)"\n        value: "Ubuntu"\n      - version_regex: "version=(\\\\d+)"\n        value: "CentOS"\n      - version_regex: "VERSION=(\\\\d+)"\n        value: "Debian"\n      - version_regex: "VERSION_ID=(\\\\d+)"\n        value: "AlmaLinux"\n    when:\n      - bootstrap_facts.rc == 0\n      - bootstrap_distribution is not defined\n      - bootstrap_facts.stdout | regex_search(item.version_regex)\n\n  - name: gather_facts | Set bootstrap facts (II)\n    set_fact:\n      bootstrap_os_family: "{{ item.key }}"\n    loop: "{{ bootstrap_os_family_map | dict2items }}"\n    when: bootstrap_distribution in item.value\n    loop_control:\n      label: "{{ item.key }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-06T16:57:33.233046651Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17867611009, 'load_duration': 193135760, 'prompt_eval_count': 562, 'prompt_eval_duration': 539218052, 'eval_count': 315, 'eval_duration': 17134444096, 'model_name': 'gemma3:27b'} id='run--25acbd05-dcc1-4848-a168-e285f3132dd7-0' usage_metadata={'input_tokens': 562, 'output_tokens': 315, 'total_tokens': 877}
