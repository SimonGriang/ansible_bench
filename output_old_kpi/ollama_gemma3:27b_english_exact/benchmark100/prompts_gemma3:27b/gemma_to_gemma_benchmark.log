```yaml
- name: Set a fact based on installation method.
  ansible.builtin.set_fact:
    ansible_package_state: present
  when: ansible_install_method == 'package'

- name: Set a fact based on installation method.
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_install_method != 'package'

- name: Set up Ansible on RedHat.
  ansible.builtin.include_tasks:
    file: setup-RedHat.yml
  when:
    - ansible_os_family == 'RedHat'
    - ansible_distribution != 'Fedora'
    - ansible_install_method == 'package'

- name: Set up Ansible on Fedora.
  ansible.builtin.include_tasks:
    file: setup-Fedora.yml
  when:
    - ansible_distribution == 'Fedora'
    - ansible_install_method == 'package'

- name: Set up Ansible on Ubuntu.
  ansible.builtin.include_tasks:
    file: setup-Ubuntu.yml
  when:
    - ansible_distribution == 'Ubuntu'
    - ansible_install_method == 'package'

- name: Set up Ansible on Debian.
  ansible.builtin.include_tasks:
    file: setup-Debian.yml
  when:
    - ansible_distribution == 'Debian'
    - ansible_install_method == 'package'

- name: Set up Ansible using Pip.
  ansible.builtin.include_tasks:
    file: setup-pip.yml
  when: ansible_install_method == 'pip'
```


