---

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/cron.d/environment
    line: "SHELL=/bin/bash"
    mode: '0644'
  notify: restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/cron.d/environment
    line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    mode: '0644'
  notify: restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/cron.d/environment
    line: "MAILTO=root"
    mode: '0644'
  notify: restart cron

- name: Start and enable cron
  ansible.builtin.service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"


