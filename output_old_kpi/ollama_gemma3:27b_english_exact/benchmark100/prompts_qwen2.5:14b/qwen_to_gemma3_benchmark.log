  set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version_number }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://ppa.launchpad.net/webupd8/java/ubuntu {{ ansible_distribution_release }} main"
        state: absent
      when: ansible_os_family == 'Debian'

    - name: Install extra apt tools
      apt:
        name:
          - software-properties-common
          - apt-transport-https
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add key repositories
      apt_key:
        url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x4E236A34
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add repositories
      apt_repository:
        repo: "deb https://ppa.launchpad.net/openjdk-ppa/ppa/ubuntu {{ ansible_distribution_release }} main"
        state: present
      when: ansible_os_family == 'Debian'
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: https://download.java.net/java/jdk8/GPG-KEY-jdk8
