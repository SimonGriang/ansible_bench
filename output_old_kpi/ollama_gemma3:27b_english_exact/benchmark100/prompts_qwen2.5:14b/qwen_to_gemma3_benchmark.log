```yaml
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: ansible_service_mgr == "systemd"
    fail_msg: "This playbook requires systemd as the init system."

- name: Get latest release of promtail
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: latest_release
  changed_when: false

- name: Get latest release of promtail
  ansible.builtin.set_fact:
    promtail_version: "{{ latest_release.json.tag_name | regex_replace('^v', '') }}"

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"
  register: promtail_zip

- name: Assert local binary exists
  ansible.builtin.assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_zip.stat.exists
    fail_msg: "Local promtail archive does not exist at {{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"
    when: promtail_binary_local_dir is defined

- name: Get checksum list
  ansible.builtin.uri:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip.sha256
    return_content: true
  register: checksum_file
  changed_when: false

- name: Get checksum for specific architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ checksum_file.content | regex_search('^[0-9a-f]{64}\\s+.*$', multiline=True) | split(' ', 1) | first }}"
```


