---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Configure apk
    apk:
      update_cache: true
      upgrade: true
    notify: Reboot

  - name: Configure apt
    apt:
      update_cache: true
      upgrade: true
      autoremove: true
      package_hold:
        - kernel-headers
        - linux-headers
    notify: Reboot

  - name: Update all software (dnf)
    dnf:
      name: "*"
      state: latest
      exclude:
        - kernel*
        - glibc*
    notify: Reboot

  - name: Update all software (pacman)
    pacman:
      update_cache: true
      upgrade: true
    notify: Reboot

  - name: Configure yum
    yum:
      name: "*"
      state: latest
    when: ansible_pkg_mgr == "yum"
    become: true
    notify: Reboot

  - name: Configure yum - install yum-utils if needed
    yum:
      name: yum-utils
      state: present
    become: true
    when: ansible_pkg_mgr == "yum"

  - name: Update all software (zypper)
    zypper:
      name: "*"
      state: latest
    notify: Reboot

handlers:
  - name: Reboot
    reboot:
      msg: "Reboot initiated by Ansible"
      connect_timeout: 5
      reboot_timeout: 300
      pre_delay: 0


