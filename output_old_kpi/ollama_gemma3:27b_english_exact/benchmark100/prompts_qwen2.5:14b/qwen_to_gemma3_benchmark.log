---

- name: Create the RKE2 config directory
  file:
    path: /etc/rke2/
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-server-pdb
        labels:
          node-role.kubernetes.io/server: ""
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            node-role.kubernetes.io/server: ""
  when: rke2_type == 'server'

- name: Set agent taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-agent-pdb
        labels:
          node-role.kubernetes.io/agent: ""
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            node-role.kubernetes.io/agent: ""
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: "{{ rke2_config_file }}"
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify:
    - restart rke2

- name: Copy kubelet config file
  copy:
    src: "{{ kubelet_config_file }}"
    dest: /etc/rke2/kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config_file is defined and kubelet_config_file != ""
  notify:
    - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_file }}"
    dest: /etc/containerd/config.toml
    owner: root
    group: root
    mode: '0644'
  when: containerd_registry_config_file is defined and containerd_registry_config_file != ""
  notify:
    - restart rke2

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  retries: 5
  delay: 10
  notify:
    - restart rke2

- name: Mask other RKE2 services
  systemd:
    name: "{{ item }}"
    masked: yes
    enabled: no
  loop:
    - rke2-agent
    - rke2-kubelet
  when: inventory_hostname != groups['rke2_server'][0]

- name: Wait for remaining nodes to be ready - no CNI
  kubernetes.core.k8s_info:
    kind: Node
    name: "{{ item }}"
    kubeconfig: "{{ kubeconfig }}"
  register: node_info
  until: node_info.resources[0].status.conditions[0].type == "Ready" and node_info.resources[0].status.conditions[0].status == "True"
  retries: 30
  delay: 10
  loop: "{{ groups['rke2_agent'] }}"

- name: Wait for remaining nodes to be ready - with CNI
  kubernetes.core.k8s_info:
    kind: Node
    name: "{{ item }}"
    kubeconfig: "{{ kubeconfig }}"
  register: node_info
  until: node_info.resources[0].status.conditions[0].type == "Ready" and node_info.resources[0].status.conditions[0].status == "True" and node_info.resources[0].status.addresses[0].type == "InternalIP"
  retries: 30
  delay: 10
  loop: "{{ groups['rke2_agent'] }}"


