- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: ansible_service_mgr == "systemd"
    fail_msg: "This playbook requires systemd as the init system."

- name: Get latest release of promtail
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: latest_release
  changed_when: false

- name: Get latest release of promtail
  ansible.builtin.set_fact:
    promtail_version: "{{ latest_release.json.tag_name | regex_replace('^v', '') }}"

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"
  register: promtail_zip

