---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  command: "id -u {{ git_user }}"
  register: git_user_check
  ignore_errors: true

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_user }}/.gitconfig"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: '0755'
  when: git_user_check.rc == 0 and git_user is defined

- name: Place git configuration
  copy:
    src: files/gitconfig
    dest: "/home/{{ git_user }}/.gitconfig"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: '0644'
  when: git_user_check.rc == 0 and git_user is defined and gitconfig_file is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: '0755'
  when: git_user_check.rc == 0 and git_user is defined and repository_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item }}"
    dest: "{{ repository_destination }}/{{ item | split('/') | last }}"
    clone: yes
    update: yes
    force: yes
    accept_hostkey: yes
    key_file: "{{ git_key_file }}"
    user: "{{ git_user }}"
  with_items: "{{ git_repositories }}"
  become: true
  become_user: "{{ git_user }}"
  when: git_user_check.rc == 0 and git_user is defined and git_repositories is defined


