---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  community.general.dnf:
    name: redis
    state: present
    module_stream: redis
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: redis.conf.j2
    dest: "{{ redis_config_dir }}/redis.conf"
    owner: redis
    group: redis
    mode: '0640'
  notify: restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


