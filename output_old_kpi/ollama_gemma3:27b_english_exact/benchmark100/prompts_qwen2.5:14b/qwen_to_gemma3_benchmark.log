```yaml
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ dns_data_dir }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0750'
  
- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes

- name: Create user
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"
    createhome: no

- name: Generate rndc key
  command: "rndc-confgen -a -k rndc-key -n {{ dns_server_ip }}"
  args:
    creates: "{{ rndc_key_file }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ root_hints_file }}"
    mode: '0644'

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_zone_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Restart DNS

- name: Place systemd override
  file:
    path: "{{ dns_systemd_override_dir }}"
    state: directory
    mode: '0755'

- name: Place systemd override file
  copy:
    src: dns.service.d.conf
    dest: "{{ dns_systemd_override_file }}"
    owner: root
    group: root
    mode: '0644'
  notify: Restart DNS

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes
```


