---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Pre-configure debian systems
    apt:
      update_cache: yes
      cache_valid_time: 3600
    when: ansible_os_family == "Debian"
    become: true

  - name: Install postfix
    apt:
      name: postfix
      state: present
    become: true

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present
    when:
      - postfix_virtual_mailbox_maps is defined and "mysql" in postfix_virtual_mailbox_maps
      - postfix_virtual_mailbox_domains is defined and "mysql" in postfix_virtual_mailbox_domains
      - postfix_virtual_alias_maps is defined and "mysql" in postfix_virtual_alias_maps
    become: true

  - name: Configure postfix (transport_maps)
    template:
      src: transport_maps.j2
      dest: /etc/postfix/transport_maps
    notify:
      - validate postfix configuration
      - rebuild transport_maps database

  - name: Configure postfix (header_checks)
    template:
      src: header_checks.j2
      dest: /etc/postfix/header_checks
    notify:
      - validate postfix configuration
      - reload postfix

  - name: Setting values for main.cf (1/2)
    set_fact:
      smtpd_recipient_restrictions_value: "{{ postfix_smtpd_recipient_restrictions | default([]) }}"
    when: postfix_smtpd_recipient_restrictions is defined

  - name: Setting values for main.cf (2/2)
    set_fact:
      main_cf_values:
        mynetworks: "{{ postfix_mynetworks | default([]) }}"
        mydestination: "{{ postfix_mydestination | default([]) }}"
        relay_domains: "{{ postfix_relay_domains | default([]) }}"
        smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions_value + postfix_smtpd_recipient_restrictions_additional | default([]) }}"
        smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default([]) }}"
        virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) }}"
        virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) }}"

  - name: Configure postfix (main.cf)
    template:
      src: main.cf.j2
      dest: /etc/postfix/main.cf
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Configure postfix (master.cf)
    template:
      src: master.cf.j2
      dest: /etc/postfix/master.cf
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Creates cert/key directory
    file:
      path: "{{ item }}"
      state: directory
      owner: postfix
      group: postfix
      mode: 0750
    with_items:
      - "{{ postfix_smtpd_tls_cert_file | dirname }}"
      - "{{ postfix_smtpd_tls_key_file | dirname }}"
    become: true

  - name: Deploy Postfix TLS server certificate
    copy:
      src: "{{ postfix_smtpd_tls_cert_file }}"
      dest: "{{ postfix_smtpd_tls_cert_file }}"
      owner: postfix
      group: postfix
      mode: 0644
    notify: reload postfix

  - name: Deploy Postfix TLS server key
    copy:
      src: "{{ postfix_smtpd_tls_key_file }}"
      dest: "{{ postfix_smtpd_tls_key_file }}"
      owner: postfix
      group: postfix
      mode: 0600
    notify: reload postfix

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      path: /etc/aliases
      line: "{{ item }}"
      create: yes
    with_items: "{{ postfix_aliases }}"
    notify:
      - rebuild alias database
      - reload postfix

  - name: Configure sender_access
    copy:
      dest: /etc/postfix/sender_access
      content: "{{ postfix_sender_access_content }}"
    notify:
      - rebuild sender_access database
      - reload postfix

  - name: Configure recipient_access
    copy:
      dest: /etc/postfix/recipient_access
      content: "{{ postfix_recipient_access_content }}"
    notify:
      - validate postfix configuration
      - rebuild recipient_access database
      - reload postfix

  - name: Place sasl_password_map
    copy:
      dest: /etc/postfix/sasl_password_map
      content: "{{ postfix_sasl_password_map_content }}"
      owner: postfix
      group: postfix
      mode: 0600
    notify:
      - rebuild sasl_password_map database

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes


