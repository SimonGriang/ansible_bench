---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  package:
    deb: /tmp/java.rpm
    state: present
  when: java_vendor == "oracle" and ansible_os_family == "RedHat"

- name: Install DEB
  package:
    deb: /tmp/java.deb
    state: present
  when: java_vendor == "oracle" and ansible_os_family == "Debian"

- name: Install oracle java (rpm) (repository)
  yum:
    name: java-1.8.0-openjdk
    state: present
  when: java_vendor == "oracle" and ansible_os_family == "RedHat"

- name: Configure oracle targz
  block:
    - name: Create installation directory
      file:
        path: "{{ java_targz_install_dir }}"
        state: directory
        mode: '0755'

    - name: Extract Oracle Java TARGZ
      unarchive:
        src: /tmp/{{ java_targz_archive }}
        dest: "{{ java_targz_install_dir }}"
        remote_src: yes
  when: java_vendor == "oracle" and java_installation_type == "targz"

- name: Install oracle java policy software (targz)
  copy:
    src: /tmp/{{ java_policy_archive }}
    dest: "{{ java_targz_install_dir }}/{{ java_policy_dest }}"
  when: java_vendor == "oracle" and java_installation_type == "targz" and java_version == "8"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_targz_install_dir }}/bin/java"
    state: present
  when: java_vendor == "oracle" and java_installation_type == "targz" and ansible_os_family != "Alpine"

- name: Find JAVA_HOME
  shell: "readlink -f {{ java_targz_install_dir }}/bin/java | sed 's/\/bin\/java//'"
  register: java_home_result
  changed_when: false
  when: java_vendor == "oracle" and java_installation_type == "targz"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: 'JAVA_HOME={{ java_home_result.stdout }}'
    state: present
    create: yes


