---

  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install cron
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure shell
    lineinfile:
      path: /etc/cron.d/0hourly
      line: "SHELL={{ cron_shell }}"
      state: present
      create: yes
    file:
      path: /etc/cron.d/0hourly
      mode: 0600
    notify: Restart cron

  - name: Configure path
    lineinfile:
      path: /etc/cron.d/0hourly
      line: "PATH={{ cron_path }}"
      state: present
      create: yes
    file:
      path: /etc/cron.d/0hourly
      mode: 0600
    notify: Restart cron

  - name: Configure mailto
    lineinfile:
      path: /etc/cron.d/0hourly
      line: "MAILTO={{ cron_mailto }}"
      state: present
      create: yes
    file:
      path: /etc/cron.d/0hourly
      mode: 0600
    notify: Restart cron

  - name: Start and enable cron
    service:
      name: cron
      state: started
      enabled: yes
    when: cron_service is defined and cron_service == true

  - name: Schedule requested cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute | default('0') }}"
      hour: "{{ item.hour | default('0') }}"
      day: "{{ item.day | default('*') }}"
      month: "{{ item.month | default('*') }}"
      weekday: "{{ item.weekday | default('*') }}"
      job: "{{ item.command }}"
    loop: "{{ cron_jobs }}"


