---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: inventory_hostname in groups['rke2_servers']

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: "Config file changed"

- name: Copy kubelet configuration file
  template:
    src: kubelet.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  notify: "Config file changed"
  when: rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  notify: "Config file changed"
  when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file != "" and (rke2_server_service_enabled is undefined or not rke2_server_service_enabled)

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshot
        state: directory
        mode: '0755'

    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshot/snapshot.db
        remote_src: yes

    - name: Restore etcd from the snapshot file
      command: rke2 etcd-snapshot restore
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from an S3 snapshot
      command: rke2 etcd-snapshot restore --s3-bucket "{{ rke2_etcd_snapshot_s3_options.bucket }}" --s3-key "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}" --s3-access-key "{{ rke2_etcd_snapshot_s3_options.access_key }}" --s3-secret-key "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  environment:
    RKE2_TOKEN: "{{ rke2_server_token }}"
  when: inventory_hostname in groups['rke2_servers'] and inventory_hostname == groups['rke2_servers'][0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    state: stopped
    enabled: no
    masked: yes
  when: inventory_hostname in groups['rke2_servers'] and inventory_hostname == groups['rke2_servers'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /var/lib/rke2/server/node-status.json
    timeout: 600
  when: inventory_hostname in groups['rke2_servers'] and inventory_hostname == groups['rke2_servers'][0]

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /var/lib/rke2/server/node-status.json
    timeout: 600
  when: inventory_hostname in groups['rke2_servers'] and inventory_hostname == groups['rke2_servers'][0]

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes
      changed_when: false

    - name: Remove old node secrets
      file:
        path: "/etc/rke2/node-internal/{{ item }}"
        state: absent
      loop: "{{ registered_nodes.stdout.split(' ') }}"
      ignore_errors: true

    - name: Remove old nodes
      command: kubectl delete node {{ item }}
      loop: "{{ registered_nodes.stdout.split(' ') }}"
      ignore_errors: true
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups['rke2_cluster']
