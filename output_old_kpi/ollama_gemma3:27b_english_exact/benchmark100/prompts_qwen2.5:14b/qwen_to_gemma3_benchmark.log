    shell: "{{ user.shell | default('/bin/bash') }}"
    createhome: "{{ user.createhome | default(true) }}"
    groups: "{{ user.groups | default([]) }}"
    append: "{{ user.append | default(false) }}"
    comment: "{{ user.comment | default('') }}"

- name: Set sudo options for {{ user.name }}
  copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo }}"
    mode: 0640
  when: user.sudo != ""
  validate: /usr/sbin/visudo --check

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo == ""

- name: Generate private ssh key for {{ user.name }}
  command:
    cmd: ssh-keygen -t rsa -N "" -f "{{ ssh_private_key }}"
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  command:
    cmd: ssh-keygen -t rsa -N "" -f "{{ ssh_private_key }}" -y > "{{ ssh_public_key }}"
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  command:
    cmd: puttygen -i "{{ ssh_private_key }}" -o "{{ ssh_ppk_key }}" -O private
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  set_fact:
    user_home: "{{ ansible_facts.users[user.name].home if ansible_facts.users[user.name] is defined else '/home/' + user.name }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user.manage_ssh_key or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ ssh_private_key }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  command: "chage -l {{ user.name }}"
  register: chage_output
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  command: "chage -M {{ user.password_validity_days }} {{ user.name }}"
  when: user.password_validity_days is defined and user.password_validity_days != chage_output.stdout | regex_search('Maximum password age', '(\\d+)') | int

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ user.private_keys[0] }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user.private_keys is defined
```


