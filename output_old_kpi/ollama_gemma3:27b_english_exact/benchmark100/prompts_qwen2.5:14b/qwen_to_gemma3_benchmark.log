---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    comment: etcd user
    group: etcd
    shell: /bin/nologin
    system: true

- name: Copy systemctl config file for kernel hardening
  stat:
    path: /usr/local
  register: usr_local_writable

- name: Check partition for /opt/rke2
  stat:
    path: /opt/rke2
  register: opt_rke2_exists

- name: Copy sysctl config file
  copy:
    src: "/usr/local/share/rke2/rke2-cis-sysctl.conf"
    dest: "/etc/sysctl.d/60-rke2-cis.conf"
    mode: 0600
  when: usr_local_writable.stat.writable == true or opt_rke2_exists.stat.exists == true

- name: Copy sysctl config file (alternative)
  copy:
    src: "/opt/rke2/share/rke2/rke2-cis-sysctl.conf"
    dest: "/etc/sysctl.d/60-rke2-cis.conf"
    mode: 0600
  when: usr_local_writable.stat.writable == false and opt_rke2_exists.stat.exists == true

- name: Restart systemd-sysctl
  systemd:
    name: systemd-sysctl
    state: restarted

- name: Flush handlers
  meta: flush_handlers


