---

- name: Remove externally managed from Debian 12
  file:
    path: /etc/apt/sources.list.d/external.list
    state: absent
  when: ansible_facts['os_family'] == "Debian" and ansible_facts['distribution_version'] == "12"

- name: Ensure Pip is installed
  apt:
    name: python3-pip
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present
  become: true
  when: ansible_os_family == "RedHat"

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ pip_install_packages }}"
    version: "{{ pip_install_version | default(omit) }}"
    virtualenv: "{{ pip_virtualenv | default(omit) }}"
    extra_args: "{{ pip_extra_args | default(omit) }}"


