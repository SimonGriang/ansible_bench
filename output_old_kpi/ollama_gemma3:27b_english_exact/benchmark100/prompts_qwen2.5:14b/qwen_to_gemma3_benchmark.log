---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "vars/{{ ansible_os_family }}.yml"
    name: java_os_vars

- name: Include architecture-specific variables
  include_vars:
    file: "vars/{{ ansible_architecture }}.yml"
    name: java_arch_vars

- name: Set OS-specific variables (part I)
  set_fact:
    java_pkg_name: "{{ java_os_vars.java_pkg_name | default('') }}"
    java_state: "{{ java_os_vars.java_state | default('present') }}"

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_arch_pkg_name: "{{ java_arch_vars.java_arch_pkg_name | default('') }}"
    java_version_number: "{{ java_arch_vars.java_version_number | default('') }}"

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version_number }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://ppa.launchpad.net/webupd8/java/ubuntu {{ ansible_distribution_release }} main"
        state: absent
      when: ansible_os_family == 'Debian'

    - name: Install extra apt tools
      apt:
        name:
          - software-properties-common
          - apt-transport-https
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add key repositories
      apt_key:
        url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x4E236A34
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add repositories
      apt_repository:
        repo: "deb https://ppa.launchpad.net/openjdk-ppa/ppa/ubuntu {{ ansible_distribution_release }} main"
        state: present
      when: ansible_os_family == 'Debian'
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: https://download.java.net/java/jdk8/GPG-KEY-jdk8
        state: present
      when: ansible_os_family == 'RedHat'

    - name: Add repositories
      yum_repository:
        name: java
        description: Java Repository
        baseurl: https://download.java.net/java/jdk8/
        gpgcheck: yes
        gpgkey: https://download.java.net/java/jdk8/GPG-KEY-jdk8
        enabled: yes
      when: ansible_os_family == 'RedHat'
  when: ansible_os_family == 'RedHat'

- name: Install required libraries
  apt:
    name:
      - ca-certificates
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, Debian
  apt:
    name: "{{ java_pkg_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_pkg_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh
    mode: 0755

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    path: "/usr/lib/jvm/java-{{ java_version_number }}/bin/java"
    state: present
    priority: 1000
  when: ansible_os_family == 'Debian' and java_version_number | int < 11

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    path: "/usr/lib/jvm/java-{{ java_version_number }}/bin/java"
    state: present
    priority: 1000
  when: ansible_os_family == 'Debian' and java_version_number | int >= 11


