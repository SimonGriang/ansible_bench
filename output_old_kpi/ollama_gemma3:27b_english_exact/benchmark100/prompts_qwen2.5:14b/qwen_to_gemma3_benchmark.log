---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: hashicorp_install_method == 'package'

- name: Install repository for RedHat
  yum_repository:
    name: hashicorp
    description: HashiCorp Repository
    baseurl: https://rpm.releases.hashicorp.com/
    gpgcheck: yes
    gpgkey: https://releases.hashicorp.com/gpg
  when: ansible_os_family == 'RedHat' and hashicorp_install_method == 'package'

- name: Configure debian
  apt_repository:
    repo: deb https://apt.releases.hashicorp.com {{ hashicorp_os_release }} main
    state: present
    filename: hashicorp
  when: ansible_os_family == 'Debian' and hashicorp_install_method == 'package'

- name: Install required package gpg
  package:
    name: gnupg
    state: present
  when: ansible_os_family == 'Debian' and hashicorp_install_method == 'package'

- name: Install apt key for Debian
  apt_key:
    url: https://releases.hashicorp.com/gpg
    state: present
  when: ansible_os_family == 'Debian' and hashicorp_install_method == 'package'

- name: Install repository for Debian
  apt_repository:
    repo: deb https://apt.releases.hashicorp.com {{ hashicorp_os_release }} main
    state: present
    filename: hashicorp
  when: ansible_os_family == 'Debian' and hashicorp_install_method == 'package'

- name: Install hashicorp product using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: hashicorp_install_method == 'package' and hashicorp_version is not defined

- name: Install versioned hashicorp product using package
  package:
    name: "{{ hashicorp_product }}-{{ hashicorp_version }}"
    state: present
  when: hashicorp_install_method == 'package' and hashicorp_version is defined

- name: Install manually
  unarchive:
    src: "{{ hashicorp_download_url }}"
    dest: "{{ hashicorp_install_dir }}"
    remote_src: yes
    creates: "{{ hashicorp_install_dir }}/{{ hashicorp_product }}"
  when: hashicorp_install_method == 'manual'

- name: Install hashicorp product manually
  file:
    path: "{{ hashicorp_install_dir }}/{{ hashicorp_product }}"
    state: directory
    owner: "{{ hashicorp_user }}"
    group: "{{ hashicorp_group }}"
    mode: '0755'
  when: hashicorp_install_method == 'manual'


