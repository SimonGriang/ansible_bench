---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /python3.11/EXTERNALLY-MANAGED
  register: python311_managed_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  file:
    path: /python3.11/EXTERNALLY-MANAGED
    state: absent
    name: /python3.11/EXTERNALLY-MANAGED.old
  when: python311_managed_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /python3.12/EXTERNALLY-MANAGED
  register: python312_managed_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  file:
    path: /python3.12/EXTERNALLY-MANAGED
    state: absent
    name: /python3.12/EXTERNALLY-MANAGED.old
  when: python312_managed_file.stat.exists

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  package:
    name: python3-pip
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    create: yes
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
  when: python_pip_trusted_host is defined

- name: Update pip
  command: pip3 install --upgrade pip
  when: python_pip_update and ansible_distribution != "Debian" and ansible_distribution_release != "bookworm" and ansible_distribution_release != "noble" and ansible_distribution != "Alpine"

- name: Install requested modules
  pip:
    name: "{{ python_pip_modules }}"
  when: python_pip_modules is defined and ansible_distribution != "Debian" and ansible_distribution_release != "bookworm" and ansible_distribution_release != "noble" and ansible_distribution != "Alpine"


