---
- name: Update apt cache
  apt:
    update_cache: yes
  become: yes
  when: ansible_os_family == "Debian"

- name: Update dnf cache
  dnf:
    update_cache: yes
  become: yes
  when: ansible_os_family == "RedHat"

- name: Install packages
  package:
    name: keepalived
    state: present
  become: yes

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'
  become: yes

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: kubernetes_api_health_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_health_check.sh
    mode: '0755'
  become: yes
  when: ansible_os_family == "Debian"
  notify: restart keepalived

- name: Create Kubernetes API health check script for RedHat OS famliy
  template:
    src: kubernetes_api_health_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_health_check.sh
    mode: '0755'
  become: yes
  when: ansible_os_family == "RedHat"
  notify: restart keepalived

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: rke2_server_health_check.sh.j2
    dest: /etc/keepalived/rke2_server_health_check.sh
    mode: '0755'
  become: yes
  when: ansible_os_family == "Debian"
  notify: restart keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: rke2_server_health_check.sh.j2
    dest: /etc/keepalived/rke2_server_health_check.sh
    mode: '0755'
  become: yes
  when: ansible_os_family == "RedHat"
  notify: restart keepalived

- name: Create keepalived config file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
  become: yes
  notify: restart keepalived

- name: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  become: yes
  notify: restart keepalived

- name: Flush handlers
  meta: flush_handlers


