---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set selinux http port
      sebool:
        name: httpd_can_network_connect
        state: true
    - name: Allow custom ports
      sebool:
        name: httpd_can_network_connect_{{ item }}
        state: true
      loop: "{{ custom_ports }}"
  when: selinux_enabled

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: "{{ httpd_config }}"
    owner: root
    group: root
    mode: '0644'
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  when: ansible_os_family == "Debian"
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: enable_ssl

- name: Import locations.yml
  import_tasks: locations.yml
  when: locations_defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: vhosts_defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_file }}"
    owner: root
    group: root
    mode: '0644'
  when: ansible_os_family in ["Debian", "Suse"]
  notify:
    - test httpd configuration
    - restart httpd

- name: Import directories.yml
  import_tasks: directories.yml
  when: directories_defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_html }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


