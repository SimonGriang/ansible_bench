---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present

  - name: Configure mysql server
    lineinfile:
      path: /etc/mysql/my.cnf
      line: "{{ item.key }} = {{ item.value }}"
      state: present
    loop: "{{ mysql_configuration_options }}"

  - name: Configure mysql client
    lineinfile:
      path: /etc/mysql/my.cnf
      line: "socket = {{ mysql_client_socket }}"
      state: present

  - name: Initialize mysql
    command: mysql_install_db --user=mysql
    become: true
    when: ansible_distribution in ["Alpine", "Archlinux"]

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: true

  - name: Place my.cnf
    copy:
      src: my.cnf
      dest: /etc/mysql/conf.d/my.cnf
      owner: mysql
      group: mysql
      mode: '0644'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: present
    loop: "{{ mysql_databases }}"
    when: item.initial_import is not defined

  - name: List databases
    mysql_query:
      login_user: root
      login_password: "{{ mysql_root_password }}"
      query: "SHOW DATABASES;"
    register: mysql_databases_list

  - name: Import database
    shell: "mysql -u root -p'{{ mysql_root_password }}' {{ item.name }} < {{ item.file }}"
    become: true
    when: item.file is defined and item.file != "" and item.initial_import is defined and item.initial_import == true
    loop: "{{ mysql_databases }}"

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.privileges }}"
      host: "{{ item.host }}"
      state: present
    loop: "{{ mysql_users }}"

  - name: Flush handlers
    meta: flush_handlers

  - name: Flush handlers again
    meta: flush_handlers


