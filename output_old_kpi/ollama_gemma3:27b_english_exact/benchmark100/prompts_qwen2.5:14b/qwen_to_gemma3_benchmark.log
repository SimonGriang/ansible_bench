---

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install prerequisites
  ansible.builtin.apt:
    name: "{{ vault_prerequisites }}"
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"
  become: true

- name: Add Vault environment variables
  ansible.builtin.copy:
    dest: /etc/vault.d/vault.env
    content: "{{ vault_environment_settings | to_nice_yaml }}"
    owner: root
    group: root
    mode: "0644"
  notify: Restart vault

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml

- name: Start and enable vault
  ansible.builtin.systemd:
    name: vault
    state: started
    enabled: true
  become: true
  when: vault_type == "oss"

- name: Enable vault
  ansible.builtin.systemd:
    name: vault
    enabled: true
  become: true
  when: vault_type != "oss"


