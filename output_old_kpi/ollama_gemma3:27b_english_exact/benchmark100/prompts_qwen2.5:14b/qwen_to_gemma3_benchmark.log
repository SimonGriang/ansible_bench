---
- name: create | Create ssl key
  openssl_key:
    path: "{{ item.path }}"
    size: "{{ item.size | default(2048) }}"
    type: "{{ item.type | default('rsa') }}"
    force: yes
  loop: "{{ ssl_keys }}"
  become: true
  become_user: "{{ ssl_user | default('root') }}"
  become_group: "{{ ssl_group | default('root') }}"
  register: ssl_key_result
  tags:
    - ssl
    - key

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ item.path }}"
    key: "{{ item.key_path }}"
    common_name: "{{ item.common_name }}"
    force: yes
  loop: "{{ ssl_csrs }}"
  become: true
  become_user: "{{ ssl_user | default('root') }}"
  become_group: "{{ ssl_group | default('root') }}"
  register: ssl_csr_result
  tags:
    - ssl
    - csr

- name: create | Create ssl certificates
  openssl_cert:
    path: "{{ item.path }}"
    csr: "{{ item.csr_path }}"
    key: "{{ item.key_path }}"
    self_signed: yes
    force: yes
  loop: "{{ ssl_certs }}"
  become: true
  become_user: "{{ ssl_user | default('root') }}"
  become_group: "{{ ssl_group | default('root') }}"
  register: ssl_cert_result
  tags:
    - ssl
    - cert

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ item.path }}"
    key: "{{ item.key_path }}"
    cert: "{{ item.cert_path }}"
    name: "{{ item.friendly_name }}"
    exportable: yes
    force: yes
  loop: "{{ ssl_pkcs12 }}"
  become: true
  become_user: "{{ ssl_user | default('root') }}"
  become_group: "{{ ssl_group | default('root') }}"
  register: ssl_pkcs12_result
  tags:
    - ssl
    - pkcs12

- name: create | Read private key
  slurp:
    src: "{{ item.path }}"
  loop: "{{ ssl_keys }}"
  register: ssl_key_content
  tags:
    - ssl
    - key

- name: create | Read certificate
  slurp:
    src: "{{ item.path }}"
  loop: "{{ ssl_certs }}"
  register: ssl_cert_content
  tags:
    - ssl
    - cert

- name: create | Create combined private_key and certificate file
  copy:
    dest: "{{ item.path }}"
    content: "{{ ssl_key_content.content | combine(ssl_cert_content.content) }}"
    mode: 0640
    owner: "{{ ssl_user | default('root') }}"
    group: "{{ ssl_group | default('root') }}"
  loop: "{{ ssl_combined }}"
  tags:
    - ssl
    - combined


