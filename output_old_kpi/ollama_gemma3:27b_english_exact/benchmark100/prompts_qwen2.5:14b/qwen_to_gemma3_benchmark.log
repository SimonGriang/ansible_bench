---
- name: Ensure old versions of Docker are not installed.
  apt:
    name: docker-engine
    state: absent
  become: true
  when: ansible_os_family == "Debian"

- name: Ensure old versions of Docker are not installed.
  yum:
    name: docker
    state: absent
  become: true
  when: ansible_os_family == "RedHat"

- name: Add Docker GPG key.
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Add Docker GPG key.
  rpm_key:
    url: https://download.docker.com/linux/centos/gpg
    state: present
  become: true
  when: ansible_os_family == "RedHat"

- name: Add Docker repository.
  apt_repository:
    repo: deb https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Add Docker repository.
  yum_repository:
    name: docker-ce
    description: Docker CE Repository
    baseurl: https://download.docker.com/linux/centos/{{ ansible_distribution_major_version }}/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    state: present
  become: true
  when: ansible_os_family == "RedHat"

- name: Configure Docker Nightly repo.
  yum_repository:
    name: docker-ce-nightly
    description: Docker CE Nightly Repository
    baseurl: https://download.docker.com/linux/centos/{{ ansible_distribution_major_version }}/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    state: present
  become: true
  when: docker_nightly | bool

- name: Configure Docker Test repo.
  yum_repository:
    name: docker-ce-test
    description: Docker CE Test Repository
    baseurl: https://download.docker.com/linux/centos/{{ ansible_distribution_major_version }}/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    state: present
  become: true
  when: docker_test | bool

- name: Configure containerd on RHEL 8.
  block:
    - name: Remove runc
      yum:
        name: runc
        state: absent
      become: true
      when: ansible_distribution_major_version == "8" and ansible_distribution == "RedHat"

    - name: Install container-selinux
      yum:
        name: container-selinux
        state: present
      become: true
      when: ansible_distribution_major_version == "8" and ansible_distribution == "RedHat"

    - name: Install containerd.io
      yum:
        name: containerd.io
        state: present
      become: true
      when: ansible_distribution_major_version == "8" and ansible_distribution == "RedHat"
  when: ansible_distribution_major_version == "8" and ansible_distribution == "RedHat"


