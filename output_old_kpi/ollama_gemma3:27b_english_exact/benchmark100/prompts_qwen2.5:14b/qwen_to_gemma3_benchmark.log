ion': 30175016338, 'load_duration': 188025586, 'prompt_eval_count': 1322, 'prompt_eval_duration': 1255092271, 'eval_count': 547, 'eval_duration': 28730581998, 'model_name': 'gemma3:27b'} id='run--5484910d-d872-4997-8fc3-0bd875ca5cc3-0' usage_metadata={'input_tokens': 1322, 'output_tokens': 547, 'total_tokens': 1869}
