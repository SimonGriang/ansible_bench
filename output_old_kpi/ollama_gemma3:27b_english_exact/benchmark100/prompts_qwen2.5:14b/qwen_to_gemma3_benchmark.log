- name: Populate service facts
  setup:
    filter: ansible_service_units

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  shell: grep -q /usr/local /proc/mounts
  register: separate_partition
  ignore_errors: true

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: not separate_partition.rc == 0

- name: Check RKE2 version
  shell: |
    rke2 --version 2>&1 | grep -Po '(?<=version ).*'
  register: rke2_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version.stdout | default('') }}"
    running_rke2_version: "{{ rke2_version.stdout | default('') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "Downgrading RKE2 is not allowed. Installed version is {{ installed_rke2_version }}. Attempted version is {{ rke2_target_version }}"
  when: rke2_target_version is defined and rke2_target_version != installed_rke2_version and not rke2_allow_downgrade

- name: Run RKE2 install script
  shell: |
    {{ rke2_install_script_dest }} --channel {{ rke2_channel }} --version {{ rke2_target_version }}
  args:
    chdir: /tmp
  environment:
    RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode | bool }}"
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"
