---

  - name: create | Create ssl key
    openssl_private_key:
      path: "{{ ssl_key_path }}"
      size: 2048
    become: true

  - name: create | Create ssl csr
    openssl_csr:
      path: "{{ ssl_csr_path }}"
      private_key: "{{ ssl_key_path }}"
      common_name: "{{ inventory_hostname }}"
      state: present
    become: true

  - name: create | Create ssl certificates
    openssl_certificate:
      path: "{{ ssl_cert_path }}"
      private_key: "{{ ssl_key_path }}"
      csr: "{{ ssl_csr_path }}"
      state: present
      self_signed: true
    become: true

  - name: create | Create PKCS#12 file
    openssl_pkcs12:
      path: "{{ ssl_pkcs12_path }}"
      private_key: "{{ ssl_key_path }}"
      certificate: "{{ ssl_cert_path }}"
      state: present
    become: true

  - name: create | Read private key
    slurp:
      src: "{{ ssl_key_path }}"
    register: ssl_key_content

  - name: create | Read certificate
    slurp:
      src: "{{ ssl_cert_path }}"
    register: ssl_cert_content

  - name: create | Create combined private_key and certificate file
    copy:
      content: "{{ ssl_key_content.content }}\n{{ ssl_cert_content.content }}"
      dest: "{{ combined_ssl_path }}"
      mode: '0644'
    become: true


