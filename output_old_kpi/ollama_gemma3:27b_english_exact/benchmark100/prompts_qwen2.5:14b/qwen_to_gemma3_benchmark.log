  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[ansible_distribution] }}"
  when: ansible_distribution is defined and ansible_distribution != "" and bootstrap_os_family_map[ansible_distribution] is defined
  delegate_to: localhost


