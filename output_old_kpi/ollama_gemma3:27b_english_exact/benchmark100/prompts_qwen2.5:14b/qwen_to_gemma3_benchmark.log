---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "{{ rke2_install_script_mode }}"
    timeout: "{{ rke2_install_script_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script_src }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
    force: yes
  when: rke2_airgap_mode | bool and rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when: rke2_airgap_mode | bool and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_dest }}"
        mode: 0644
        timeout: "{{ rke2_download_timeout }}"

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: 0644
        timeout: "{{ rke2_download_timeout }}"

    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: "{{ rke2_install_script_mode }}"
        timeout: "{{ rke2_download_timeout }}"
  when: rke2_airgap_mode | bool and rke2_airgap_implementation == 'download'

- name: Rescue for failed download
  block:
    - name: Create rescue directory
      file:
        path: "{{ rke2_rescue_path }}"
        state: directory
        mode: 0700

    - name: Download RKE2 artifacts locally
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_rescue_path }}/artifacts.tar.gz"
        mode: 0644
        timeout: "{{ rke2_download_timeout }}"

    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_rescue_path }}/rke2.sh"
        mode: "{{ rke2_install_script_mode }}"
        timeout: "{{ rke2_download_timeout }}"

    - name: Copy local artifacts to remote hosts
      copy:
        src: "{{ rke2_rescue_path }}/artifacts.tar.gz"
        dest: "{{ rke2_artifacts_path }}/artifacts.tar.gz"
        mode: 0644
        force: yes

    - name: Copy local install script to remote hosts
      copy:
        src: "{{ rke2_rescue_path }}/rke2.sh"
        dest: "{{ rke2_install_script_dest }}"
        mode: "{{ rke2_install_script_mode }}"
        force: yes
  when: rke2_download_failed | bool

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_src }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0640
    force: yes
  when: rke2_airgap_mode | bool and rke2_airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_tarball_images_path }}"
    mode: 0644
    force: yes
  with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: rke2_airgap_mode | bool and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions
  stat:
    path: "{{ rke2_artifacts_path }}"
  register: rke2_artifacts_stat

- name: Check RKE2 install script permissions
  stat:
    path: "{{ rke2_install_script_dest }}"
  register: rke2_install_script_stat

- name: Fix RKE2 artifacts permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    mode: 0644
  when: rke2_artifacts_stat.stat.mode != '0644' and rke2_airgap_mode | bool and rke2_airgap_implementation == 'exists'

- name: Fix RKE2 install script permissions
  file:
    path: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_install_script_stat.stat.mode != '0700' and rke2_airgap_mode | bool and rke2_airgap_implementation == 'exists'

- name: Populate service facts
  setup:
    filter: ansible_service_units

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  shell: grep -q /usr/local /proc/mounts
  register: separate_partition
  ignore_errors: true

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: not separate_partition.rc == 0

- name: Check RKE2 version
  shell: |
    rke2 --version 2>&1 | grep -Po '(?<=version ).*'
  register: rke2_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version.stdout | default('') }}"
    running_rke2_version: "{{ rke2_version.stdout | default('') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "Downgrading RKE2 is not allowed. Installed version is {{ installed_rke2_version }}. Attempted version is {{ rke2_target_version }}"
  when: rke2_target_version is defined and rke2_target_version != installed_rke2_version and not rke2_allow_downgrade

- name: Run RKE2 install script
  shell: |
    {{ rke2_install_script_dest }} --channel {{ rke2_channel }} --version {{ rke2_target_version }}
  args:
    chdir: /tmp
  environment:
    RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode | bool }}"
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"
  when: rke2_target_version != installed_rke2_version and not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_manifests_path }}"
    mode: 0644
  with_items: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_static_pod_manifests_path }}"
    mode: 0644
  with_items: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: "{{ rke2_environment_file_dest }}"
    mode: 0644
  when: rke2_environment_options is defined and rke2_environment_options | length > 0


