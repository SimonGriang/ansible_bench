---

- name: Check if the system is EFI
  assert:
    that: "'/sys/firmware/efi/efivars' in ansible_facts['sysinfo']['kernel_modules'][0]['name']"
    msg: "This system does not appear to be using EFI firmware"

- name: Remove the grub.cfg file if the system is EFI
  file:
    path: "/boot/grub2/grub.cfg"
    state: absent
  when: "'/sys/firmware/efi/efivars' in ansible_facts['sysinfo']['kernel_modules'][0]['name']"

- name: Install a user template for GRUB
  template:
    src: "templates/01_users.j2"
    dest: "/etc/grub.d/01_users"
    owner: root
    group: root
    mode: '0700'
  notify: grub update

- name: Add a password to the EFI GRUB configuration
  lineinfile:
    dest: "/etc/grub2-efi.cfg"
    line: "set superusers="root""
    state: present
  notify: grub update

- name: Add a password to the MBR GRUB configuration
  lineinfile:
    dest: "/etc/grub2.cfg"
    line: "set superusers="root""
    state: present
  notify: grub update

- name: Add --unrestricted option to specified files
  replace:
    path: "{{ item }}"
    regexp: '^CLASS="([^"]*)"$'
    replace: 'CLASS="\1 --unrestricted"'
  with_items: "{{ grub_password_unrestricted_files|default([]) }}"
  when: grub_password_unrestricted
  notify: grub update


