--- 

- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  template:
    src: templates/main_mailer_type.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - restart postfix

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: "'mysql' in (postfix_virtual_mailbox_maps, postfix_virtual_mailbox_domains, postfix_virtual_alias_maps)"

- name: Configure postfix (transport_maps)
  template:
    src: templates/transport_maps.j2
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - transport_maps notify
    - restart postfix

- name: Configure postfix (header_checks)
  template:
    src: templates/header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - header_checks notify
    - restart postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_smtpd_restricted_recipients: "{{ postfix_smtpd_restricted_recipients | default([]) + postfix_smtpd_restricted_recipients_items }}"
  when: smtpd_restricted_recipients
  run_once: true

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mydestination: "{{ postfix_mydestination | default([]) + postfix_mydestination_items }}"
    postfix_relay_domains: "{{ postfix_relay_domains | default([]) + postfix_relay_domains_items }}"
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default([]) + postfix_smtpd_recipient_restrictions_items }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default([]) + postfix_smtpd_sender_restrictions_items }}"
    postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) + postfix_virtual_mailbox_domains_items }}"
    postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) + postfix_virtual_alias_domains_items }}"
  when:
    - postfix_mydestination
    - postfix_relay_domains
    - postfix_smtpd_recipient_restrictions
    - postfix_smtpd_sender_restrictions
    - postfix_virtual_mailbox_domains
    - postfix_virtual_alias_domains

- name: Configure postfix (main.cf)
  template:
    src: templates/main.cf.j2
