---
- name: Bootstrap Tasks
  hosts: localhost
  become: true

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for port to be available
    wait_for:
      host: localhost
      port: 22
      timeout: "{{ bootstrap_timeout }}"

  - name: Prepare system
    connection: local
    become: false
    become_method: sudo
    become_user: root
    tasks:
    - name: Test connection
      ping:
        enabled: false
    - name: Test sudo
      setup:
        run_sudo: true
        run_as_root: true

  - name: Gather bootstrap facts
    setup:
      run_sudo: true
      run_as_root: true

  - name: Install bootstrap packages (raw)
    raw:
      cmd: |
        if [ -n "$OS_FAMILIES" ]; then
          case $OS_FAMILIES in
            {debian,ubuntu}*) apt-get install -y curl ;;
            fedora) dnf install -y curl ;;
            rhel*) yum install -y curl ;;
          esac
        fi
      changed_when: false

  - name: Ensure libdnf5 is present on Fedora/RedHat
    package:
      name: libdnf5
      state: present
    when: "'Fedora' in OS_FAMILIES or 'RedHat' in OS_FAMILIES"

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages (package)
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ bootstrap_packages }}"
    when: bootstrap_packages is defined



