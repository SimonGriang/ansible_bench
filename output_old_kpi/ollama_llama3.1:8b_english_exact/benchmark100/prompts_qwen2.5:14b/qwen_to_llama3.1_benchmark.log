content="---\n- name: Ensure /etc/openvpn/easy-rsa directory exists\n  file:\n    path: /etc/openvpn/easy-rsa\n    state: directory\n    mode: '0755'\n\n- name: Easyrsa init-pki\n  command: easyrsa init-pki\n\n- name: Easyrsa build-ca\n  command: easyrsa build-ca --keysize 2048\n\n- name: Easyrsa gen-dh\n  command: easyrsa gen-dh\n\n- name: Easyrsa build-server-full server nopass\n  command: easyrsa build-server-full server nopass\n\n- name: Easyrsa build-client-full client nopass\n  command: easyrsa build-client-full client nopass\n\n- name: Easyrsa gen-crl\n  command: easyrsa gen-crl\n\n- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key\n  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key\n\n- name: Copy files to /etc/openvpn/server\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/*\n    dest: /etc/openvpn/server\n    mode: '0644'\n    owner: root\n    group: root\n\n- name: Copy files to /etc/openvpn\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/*\n    dest: /etc/openvpn\n    mode: '0644'\n    owner: root\n    group: root\n\n- name: Place server.conf\n  template:\n    src: templates/server.conf.j2\n    dest: /etc/openvpn/server.conf\n    mode: '0644'\n    owner: root\n    group: root\n  notify: restart openvpn" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-02T20:04:37.617247295Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3715867016, 'load_duration': 98698662, 'prompt_eval_count': 655, 'prompt_eval_duration': 143235903, 'eval_count': 376, 'eval_duration': 3473033856, 'model_name': 'llama3.1:8b'} id='run--e4277ef8-779f-48f7-94c0-b96f90e6cf0d-0' usage_metadata={'input_tokens': 655, 'output_tokens': 376, 'total_tokens': 1031}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Easyrsa init-pki
  command: easyrsa init-pki

- name: Easyrsa build-ca
  command: easyrsa build-ca --keysize 2048

- name: Easyrsa gen-dh
  command: easyrsa gen-dh

- name: Easyrsa build-server-full server nopass
  command: easyrsa build-server-full server nopass

- name: Easyrsa build-client-full client nopass
  command: easyrsa build-client-full client nopass

- name: Easyrsa gen-crl
  command: easyrsa gen-crl

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: /etc/openvpn/easy-rsa/pki/*
    dest: /etc/openvpn/server
    mode: '0644'
    owner: root
    group: root

- name: Copy files to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/*
    dest: /etc/openvpn
    mode: '0644'
    owner: root
    group: root

- name: Place server.conf
  template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0644'
    owner: root
    group: root
  notify: restart openvpn


