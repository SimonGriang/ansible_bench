---
- name: "Task 1: Import assert.yml"
  include: assert.yml
  run_once: true
  when: ansible_local.assert.exists

- name: "Task 2: Install requirements"
  apt:
    name: "{{ openssl_requirements }}"
    state: present

- name: "Task 3: Install pip packages"
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  when: openssl_pip_packages is not empty

- name: "Task 4: Create key directory"
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: '0700'
  owner: "{{ openssl_file_owner }}"
  group: "{{ openssl_file_group }}"

- name: "Task 5: Create csr directory"
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: '0755'
  owner: "{{ openssl_file_owner }}"
  group: "{{ openssl_file_group }}"

- name: "Task 6: Create crt directory"
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: '0755'
  owner: "{{ openssl_file_owner }}"
  group: "{{ openssl_file_group }}"

- name: "Task 7: Include create.yml"
  include: create.yml
  when: openssl_items is not empty
  loop: "{{ openssl_items }}"



