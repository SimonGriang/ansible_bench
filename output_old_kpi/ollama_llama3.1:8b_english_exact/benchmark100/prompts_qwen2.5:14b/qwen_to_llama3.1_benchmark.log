---
- name: Gather Facts
  tasks:
  - name: Gather Facts
    gather_facts:
      method: fact-gathering

- name: Set Bootstrap Facts (I)
  tasks:
  - name: Set Bootstrap Facts (I)
    set_fact:
      bootstrap_distribution_name: "{{ bootstrap_os_family_map[ansible_distribution] }}"
      bootstrap_major_version: ""
    loop:
      - "{{ lookup('file', '/etc/os-release') }}"
    when: bootstrap_distribution_name == "Ubuntu" or bootstrap_distribution_name == "Debian"

- name: Set Bootstrap Facts (II)
  tasks:
  - name: Set Bootstrap Facts (II)
    set_fact:
      bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution_name] }}"


