---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
    notify: gather_facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when: (ansible_distribution == 'CentOS') or (ansible_distribution == 'RedHat') or (ansible_distribution == 'Fedora') or (ansible_distribution == 'Amazon Linux')
  block:
    - name: Manage selinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: reboot

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        persistent: "{{ item.persistent }}"
        state: "{{ item.state }}"
      loop: "{{ selinux_booleans }}"

  notify: reboot

- meta: flush_handlers



