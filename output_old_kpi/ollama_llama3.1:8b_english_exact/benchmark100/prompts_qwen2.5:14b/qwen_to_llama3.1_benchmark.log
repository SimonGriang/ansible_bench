- name: Configure redis
  ansible.builtin.template:
    src: redis.conf.j2
    dest: /etc/redis/redis.conf
    mode: '0644'
    owner: redis
    group: redis
  notify: restart redis

- name: Start and enable redis
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


