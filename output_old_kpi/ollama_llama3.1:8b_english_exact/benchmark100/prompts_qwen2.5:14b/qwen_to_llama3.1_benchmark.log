---
- name: Download RKE2 installation script
  get_url:
    url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/{{ rke2_installation_script }}'
    dest: '/tmp/{{ rke2_installation_script }}'
    mode: '0644'
    timeout: 30

- name: Copy local RKE2 installation script
  copy:
    src: '/tmp/{{ rke2_installation_script }}'
    dest: '{{ rke2_airgap_path }}/{{ rke2_installation_script }}'
    mode: '0700'
    force: yes
  when: rke2_airgap_mode or rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    path: '{{ rke2_airgap_path }}'
    state: directory
    mode: '0700'
  when: not rke2_airgap_mode or not rke2_airgap_implementation == "exists"

- name: Download RKE2 checksum and artifacts
  get_url:
    url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/{{ rke2_checksum }}'
    dest: '{{ rke2_airgap_path }}/{{ rke2_checksum }}'
    mode: '0644'
    timeout: 30
    checksum: sha256={{ rke2_checksum_sha256 }}
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Download RKE2 checksum and artifacts
  get_url:
    url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/{{ rke2_artifacts }}'
    dest: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
    mode: '0644'
    timeout: 30
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Download RKE2 installation script
  get_url:
    url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/{{ rke2_installation_script }}'
    dest: '{{ rke2_airgap_path }}/{{ rke2_installation_script }}'
    mode: '0644'
    timeout: 30
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create a directory for rescue
      file:
        path: '{{ rke2_airgap_path }}/{{ rke2_installation_script }}'
        state: directory
        mode: '0700'
    - name: Download RKE2 artifacts and install script
      get_url:
        url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/{{ rke2_artifacts }}'
        dest: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        mode: '0644'
        timeout: 30
    - name: Copy local RKE2 artifacts
      copy:
        src: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        dest: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        mode: '0640'
        force: yes
      when: rke2_airgap_mode and rke2_airgap_implementation == "copy"
  rescue:
    - name: Download RKE2 artifacts and install script
      get_url:
        url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/{{ rke2_artifacts }}'
        dest: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        mode: '0644'
        timeout: 30
    - name: Copy local RKE2 artifacts
      copy:
        src: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        dest: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        mode: '0640'
        force: yes
      when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Copy local RKE2 artifacts
  copy:
    src: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
    dest: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
    mode: '0640'
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create a folder for additional images tarballs
      file:
        path: '{{ rke2_airgap_path }}/additional-images'
        state: directory
        mode: '0700'
    - name: Copy additional images tarballs
      copy:
        src: '{{ rke2_airgap_path }}/additional-images/*.tar'
        dest: '{{ rke2_rke_path }}/tar/images'
        mode: '0644'
        force: yes
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs > 0 and not rke2_airgap_implementation == "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts and install script exist
      file:
        path: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        state: file
    - name: Ensure RKE2 artifacts and install script have acceptable permissions
      file:
        path: '{{ rke2_airgap_path }}/{{ rke2_artifacts }}'
        mode: '0644'
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Populate service facts
  setup

- name: Get stats of the FS object
  command:
    cmd: df -h /usr/local
    chdir: /root

- name: Check if separate partition
  command:
    cmd: grep /usr/local /proc/mounts
    chdir: /root
    register: result
  failed_when: not result.stdout

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ (result.stdout | splitlines | map('regex_replace', '^/dev/disk/.*:/usr/local', '/usr/local') | list | first) }}"

- name: Check RKE2 version
  shell:
    cmd: rke2 version
    chdir: "{{ rke2_bin_path }}"
  register: result
  changed_when: False

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ result.stdout | regex_findall('v[\\d.]+') | list | first }}"
    rke2_running_version: "{{ result.stdout | regex_findall('v[\\d.]+') | list | last }}"

- name: Prevent accidental RKE2 downgrade
  block:
    - name: Check if downgrading RKE2 version
      failed_when: rke2_installed_version < rke2_running_version
  when: rke2_running_version and rke2_running_version != ""

- name: Run RKE2 install script
  block:
    - name: Run the RKE2 install script
      shell:
        cmd: "{{ rke2_bin_path }}/rke2 install --airgap {{ rke2_airgap_path }}"
        chdir: "{{ rke2_bin_path }}"
  when: rke2_running_version and rke2_running_version != ""

- name: Copy Custom Manifests
  block:
    - name: Copy custom manifests
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_data_path }}/{{ item|basename }}"
        mode: '0644'
        force: yes
      with_fileglob:
        - "{{ rke2_airgap_path }}/custom-manifests/*.yaml"
  when: rke2_airgap_mode == "copy" and rke2_airgap_copy_custom_manifests

- name: Copy Static Pods
  block:
    - name: Copy static pods
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_agent_pod_manifests_path }}/{{ item|basename }}"
        mode: '0644'
        force: yes
      with_fileglob:
        - "{{ rke2_airgap_path }}/static-pods/*.yaml"
  when: rke2_airgap_mode == "copy" and rke2_airgap_copy_static_pods

- name: Copy RKE2 environment file
  block:
    - name: Copy RKE2 environment file
      copy:
        src: "{{ rke2_airgap_path }}/rke2-environment-options"
        dest: "{{ rke2_bin_path }}/rke2-environment-options"
        mode: '0644'
        force: yes
  when: rke2_airgap_mode == "copy" and rke2_environment_options



