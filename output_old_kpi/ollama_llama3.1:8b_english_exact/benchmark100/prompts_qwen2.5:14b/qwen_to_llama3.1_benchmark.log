---
- import_tasks: assert.yml

  tasks:
  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present

  - name: Configure mysql server
    template:
      src: mysql.conf.j2
      dest: /etc/mysql/my.cnf
      mode: '0644'
    notify:
      - restart mysql

  - name: Configure mysql client
    template:
      src: mysql_client.conf.j2
      dest: /etc/mysql/client.cnf
      mode: '0644'

  - name: Initialize mysql
    when: (ansible_distribution == 'Alpine') or (ansible_distribution == 'Archlinux')
    apt:
      name: libmysqlclient-dev
      state: present

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Place my.cnf
    copy:
      content: "{{ mycnf_content }}"
      dest: /etc/mysql/my.cnf
      mode: '0644'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: present
      db: "{{ item.db }}"
      user: "{{ item.user }}"
      password: "{{ item.password }}"
      skip_init: yes
      when: item.initial_import == 'no'
    loop: "{{ mysql_databases }}"

  - name: List databases
    shell: mysql -uroot -e "show databases;"
    register: db_list

  - name: Import database
    mysql_db:
      name: "{{ item.name }}"
      state: import
      db: "{{ item.name }}"
      file: "{{ item.file }}"
      user: "{{ item.user }}"
      password: "{{ item.password }}"
      when: item.exists == 'no'
    loop: "{{ mysql_imports }}"

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      user_host: "{{ item.user_host }}"
      login_host: "{{ item.login_host }}"
      login_unix_socket: "{{ item.login_unix_socket }}"
      append_privs: yes
    loop: "{{ mysql_users }}"

  - name: Flush handlers
    meta: flush_handlers

  - name: Flush handlers again
    meta: flush_handlers


