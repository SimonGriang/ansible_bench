--- 
- name: Import assert.yml
  import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    host: localhost
    port: "{{ port_number }}"
    state: started
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - debug:
        msg: Connection and sudo are available
      when: ansible_connection and ansible_become
    - debug:
        msg: Connection is available, but sudo is not
      when: ansible_connection and not ansible_become
    - raw:
        "python -c 'import pip; pip.main(['install', '-U', 'sudo'])'"
      when: not ansible_connection or not ansible_become
    - setup: 
        gather_subset: ['all']
    - raw:
        "apt update && apt install -y {{ item }}"
      with_items: "{{ bootstrap_facts_packages }}"
  rescue:
    - setup: 
        gather_subset: ['all']
    - raw:
        "apt update && apt install -y {{ item }}"
      with_items: "{{ bootstrap_facts_packages }}"

- name: Gather ansible facts
  setup: 
    gather_subset: ['all']

- name: Install bootstrap packages
  package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_facts_packages }}"


