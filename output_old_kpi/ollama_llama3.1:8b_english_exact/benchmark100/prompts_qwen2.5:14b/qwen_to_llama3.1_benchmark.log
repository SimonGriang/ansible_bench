- name: Tasks for role
  tasks:
    - name: Import assert.yml
      include_vars:
        file: assert.yml

    - name: Install git
      package:
        name: "{{ git_packages }}"
        state: present

    - name: See if the specified user exists
      getent:
        database: passwd
        name: "{{ git_user }}"

    - name: Create directory for git configuration
      file:
        path: "{{ git_config_dir }}"
        state: directory
      when:
        - git_user is defined
        - git_user exists
        - git_config_dir is defined
        - git_config_dir is not empty

    - name: Place git configuration
      template:
        src: gitconfig.j2
        dest: "{{ git_config_dir }}/.gitconfig"
        mode: '0644'
      when:
        - git_user is defined
        - git_user exists
        - git_config_dir is defined
        - git_config_dir is not empty
        - git_user is defined
        - git_user exists
        - git_config_dir is defined
