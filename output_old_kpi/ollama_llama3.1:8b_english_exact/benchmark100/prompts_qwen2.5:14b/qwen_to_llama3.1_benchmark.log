--- 

- name: Enable proxy modules in Apache
  apt:
    name: libapache2-mod-proxy
    state: present
  when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'
- name: Enable proxy modules in Apache
  zypper:
    name: mod_proxy
    state: present
  when: ansible_distribution == 'SUSE'
- name: Enable proxy_http modules in Apache
  apt:
    name: libapache2-mod-proxy-http
    state: present
  when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'
- name: Enable proxy_http modules in Apache
  zypper:
    name: mod_proxy_http
    state: present
  when: ansible_distribution == 'SUSE'
- name: Configure Apache locations
  template:
    src: templates/apache.conf.j2
    dest: /etc/apache2/apache2.conf
    mode: '0644'
    notify: reload apache
  notify: restart apache


