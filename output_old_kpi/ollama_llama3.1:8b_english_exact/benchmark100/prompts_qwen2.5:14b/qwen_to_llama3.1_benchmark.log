- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: "Service (re)started"

- name: Wait for all nodes to be ready again
  kubectl:
    cmd: get
    api: nodes
  retries: "{{ rke2_nodes_retries }}"
  delay: 15
  until: kubectl get nodes -o json | jq -r '.items[] | .status.conditions[].reason == "Ready"'

- name: Uncordon the node {{ rke2_node_name }}
  kubectl:
    cmd: uncordon
    name: "{{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubectl:
    cmd: get
    api: pods
  retries: "{{ rke2_pods_retries }}"
  delay: 15
  until: kubectl get pods -o json | jq -r 'length(.items[] | select(.status.phase in ["Running", "Succeeded"])) == length(.items[])'
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubectl:
    cmd: wait
    api: pods
    timeout: "{{ rke2_pods_timeout }}"
  retries: "{{ rke2_pods_retries }}"
  delay: 15
  until: kubectl wait --for=condition=Ready pods -n "{{ rke2_namespace }}"
  when: rke2_wait_for_all_pods_to_be_healthy
```

