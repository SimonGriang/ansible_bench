---
- name: cadvisor installation tasks
  hosts: []
  tasks:
  - name: cadvisor | create directories
    file:
      path: /etc/cadvisor
      state: directory
      mode: '0755'
  - name: cadvisor | download
    get_url:
      url: 'https://github.com/google/cadvisor/releases/download/{{ cadvisor_version }}/cadvisor'
      dest: '/tmp/cadvisor'
      checksum: '{{ cadvisor_checksum }}'
      mode: '0755'
  - name: cadvisor | propagate locally distributed cadvisor binary
    copy:
      content: '{{ lookup("file", "/tmp/cadvisor") }}'
      dest: '/etc/cadvisor/cadvisor'
      mode: '0755'
    notify: restart cadvisor
  - name: cadvisor | symlink
    file:
      path: '/usr/local/bin/cadvisor'
      state: link
      target: '/etc/cadvisor/cadvisor'
  - name: cadvisor | server systemd service
    template:
      src: templates/cadvisor.service.j2
      dest: '/etc/systemd/system/cadvisor.service'
      mode: '0644'
  - name: test_task
    systemd:
      name: cadvisor
      state: started
      enabled: yes
    register: service_active
  - name: debug: var=service_active
    debug:
      var: service_active
  - name: cadvisor | enable server systemd
    systemd:
      name: cadadvisor
      enabled: yes
  - name: cadvisor | start server systemd
    systemd:
      name: cadvisor
      state: started
      enabled: yes



