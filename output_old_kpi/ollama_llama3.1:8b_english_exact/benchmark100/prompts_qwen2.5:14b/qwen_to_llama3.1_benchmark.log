        dest: '{{ rke2_download_kubeconf_path }}'
        flat: yes
        src: '{{ inventory_hostname }}'
        validate: none
      when: rke2_download_kubeconf == true and inventory_hostname == groups[rke2_servers_group_name][0]

    - name: Replace loopback IP by master server IP
      replace:
        path: '{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}'
        regexp: '(127\.0\.0\.1|::1)'
        replace: '{{ rke2_api_ip|default(groups[rke2_servers_group_name][0].ansible_all_ipv4_addresses[0]) }}'
      when: not check_mode and rke2_download_kubeconf == true and inventory_hostname == groups[rke2_servers_group_name][0]

