---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"

- name: Configure selinux
  block:
    - name: Enable connection to custom ports
      selinux:
        allow_httpd_port: yes
        allow_httpd_modules: yes
        allow_httpd_script_urls: yes
        allow_httpd_ssl_urls: yes
      when: ansible_os_family == 'RedHat'
    - name: Enable connection to custom ports on Debian
      selinux:
        allow_httpd_port: yes
        allow_httpd_modules: yes
        allow_httpd_script_urls: yes
        allow_httpd_ssl_urls: yes
      when: ansible_os_family == 'Debian'

- name: Configure httpd
  template:
    src: templates/httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
    notify: test and restart httpd

- name: Activate httpd module | Debian
  shell:
    cmd: a2enmod "{{ item }}"
  with_items:
    - "{{ httpd_modules }}"
  notify: test and restart httpd

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl == true

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations == true

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts == true

- name: Configure ports
  template:
    src: templates/ports.conf.j2
    dest: /etc/httpd/conf.d/ports.conf
  when: (ansible_distribution == 'Ubuntu' or ansible_distribution == 'Suse')
  notify: test and restart httpd

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories == true

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example == true

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: yes


