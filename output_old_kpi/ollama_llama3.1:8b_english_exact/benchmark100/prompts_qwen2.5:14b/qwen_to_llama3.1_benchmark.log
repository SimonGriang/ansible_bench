- name: Import assert.yml
  include: assert.yml

- name: Install python pip
  apt:
    name: "{{ python_pip }}"
    state: present

- name: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
