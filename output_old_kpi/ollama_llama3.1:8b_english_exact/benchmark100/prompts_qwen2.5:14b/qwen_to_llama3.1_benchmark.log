---
- name: Install and configure MySQL
  hosts: localhost
  become: true

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ item }}"
      state: present
    notify:
      - Set root password
      - Systemctl daemon-reexec
    loop: "{{ mysql_packages }}"

  - name: Configure mysql server
    template:
      src: mysql-server.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
      mode: '0644'
    notify:
      - Restart mysql server
    loop: "{{ mysql_configuration_options }}"

  - name: Configure mysql client
    template:
      src: mysql-client.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
      mode: '0644'

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when: ansible_distribution in ['Alpine', 'Archlinux']

  - name: Start and enable mysql
    service:
      name: "{{ mysql_name }}"
      state: started
      enabled: true

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: '/root/.my.cnf'
      mode: '0600'

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
      user: root
    loop: "{{ mysql_databases }}"

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      state: present
      user: root
    loop: "{{ mysql_users }}"

  - name: Flush handlers again
    meta: flush_handlers



