    - name: Create repository_destination
      file:
        path: "{{ git_repository_dir }}"
        state: directory
      when:
        - git_user is defined
        - git_user exists
        - git_repository_dir is defined
        - git_repository_dir is not empty

    - name: Clone all roles
      git:
        repo: "{{ item }}"
