---
- name: hardening | Disable swap
  set_fact:
    swap_enabled: "{{ (swap_enabled is defined) | ternary(swap_enabled, lookup('swap', 'swap_enabled')) }}"
  when: vault_hardening_disable_swap

- name: hardening | Disable swap now
  swapoff:
    state: disabled
  when: swap_enabled

- name: hardening | Disable swap permanently
  mount:
    name: swap
    state: absent
  when: swap_enabled and vault_hardening_disable_swap

- name: hardening | Disable core dumps
  seuser:
    name: "{{ ansible_user }}"
    coredump_limit: 0
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  copy:
    content: "HISTSIZE=0 HISTFILESIZE=0"
    dest: "/etc/profile.d/disable-shell-command-history.sh"
    mode: '0755'
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  set_fact:
    selinux_enabled: "{{ (selinux_enabled is defined) | ternary(selinux_enabled, lookup('selinux', 'selinux_enabled')) }}"
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Enable SELinux
  selinux:
    policy: targeted
    state: enabled
  when: selinux_enabled and vault_hardening_configure_selinux_apparmor

- name: hardening | Install selinux-policy
  package:
    name: selinux-policy
    state: present
  when: not selinux_policy_installed

- name: hardening | Set SELinux policy
  selinux:
    policy: targeted
    state: enabled
  when: selinux_policy_installed

- name: hardening | Enable AppArmor (enforcing)
  apparmor:
    state: enabled
    packages: ["apparmor"]
    profiles: ["/usr/bin/vault"]



