n': 4653123096, 'load_duration': 108406262, 'prompt_eval_count': 652, 'prompt_eval_duration': 150847260, 'eval_count': 468, 'eval_duration': 4392370677, 'model_name': 'llama3.1:8b'} id='run--faeead72-6003-4c88-b298-c7086dbe95e6-0' usage_metadata={'input_tokens': 652, 'output_tokens': 468, 'total_tokens': 1120}
