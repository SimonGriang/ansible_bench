-02T20:30:55.640209296Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5877590254, 'load_duration': 105560577, 'prompt_eval_count': 1227, 'prompt_eval_duration': 29108656, 'eval_count': 553, 'eval_duration': 5741938956, 'model_name': 'llama3.1:8b'} id='run--b81311bc-f625-4fe0-ab75-a28f79271a50-0' usage_metadata={'input_tokens': 1227, 'output_tokens': 553, 'total_tokens': 1780}
