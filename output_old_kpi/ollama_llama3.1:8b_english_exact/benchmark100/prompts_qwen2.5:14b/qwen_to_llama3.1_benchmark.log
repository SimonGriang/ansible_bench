---
- name: Import assert.yml
  include: assert.yml

- name: Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  package:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  package:
    name: "{{ rsyslog_features }}"
    state: present

- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    mode: '0644'
  when: rsyslog_deploy_default_config == true

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configuring rsyslog forward rule
  template:
    src: rsyslog-forward.conf.j2
    dest: /etc/rsyslog.d/rsyslog-forward.conf
    mode: '0644'
  when: rsyslog_deploy_default_config == false

- name: Configuring additional config files
  template:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/{{ item | basename }}
    mode: '0644'
  loop: "{{ rsyslog_features }}"
  loop_control:
    depth: 1

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: true



