---
- name: Java Installation
  hosts: all
  become: yes

  tasks:
    - name: Update java_jdk_vendor to temurin if it is adoptopenjdk
      set_fact:
        java_jdk_vendor: "temurin"
      when: java_jdk_vendor == "adoptopenjdk"

    - name: Include OS-specific variables based on distribution
      include_vars: "{{ ansible_distribution }}-{{ ansible_distribution_version }}-vars.yml"

    - name: Include architecture-specific variables
      include_vars: "{{ ansible_architecture }}-vars.yml"

    - name: Set OS-specific variables (part I)
      set_fact:
        openjdk_home: "{{ ansible_distribution }}-openjdk-home"
        openjdk_version: "{{ ansible_distribution }}-openjdk-version"

    - name: Set OS and architecture-specific variables (part II)
      set_fact:
        openjdk_arch: "{{ ansible_architecture }}-openjdk-arch"
        openjdk_dist: "{{ ansible_distribution }}-openjdk-dist"

    - name: Set specific variables
      set_fact:
        java_home: "{{ openjdk_home }}/{{ openjdk_version }}"

    - name: Debian pre-requisites
      when: ansible_distribution == "Debian"
      block:
        - name: Remove deprecated repositories
          apt:
            name: "{{ item }}"
            state: absent
          loop:
            - "{{ item }}"
              when: item != "openjdk-repo"
              with_file: /etc/apt/sources.list.d/openjdk-repo.list

        - name: Install extra apt tools
          apt:
            name: "{{ item }}"
            state: present
          loop:
            - "{{ item }}"
              with_items:
                - software-properties-common

        - name: Add key repositories
          apt_key:
            id: "{{ item.id }}"
            keyserver: "{{ item.server }}"
          loop:
            - id: "9EA649B95EE727F9E55D23FEF52A5661E2836D4B"
              server: "keyserver.ubuntu.com"

        - name: Add repositories
          apt_repository:
            repo: "{{ item.repo }}"
            state: present
          loop:
            - repo: "ppa:openjdk/ppa"
            - repo: "ppa:openjdk/riscv64"

    - name: RedHat pre-requisites
      when: ansible_distribution == "RedHat"
      block:
        - name: Add key repositories
          yum_key:
            state: present
            key: "{{ item.id }}"
          loop:
            - id: "9EA649B95EE727F9E55D23FEF52A5661E2836D4B"

        - name: Add repositories
          yum_repository:
            name: "{{ item.name }}"
            description: "{{ item.description }}"
            state: present
          loop:
            - name: openjdk
              description: OpenJDK repository

    - name: Install required libraries
      when: java_jdk_vendor == "temurin"
      apt:
        name: "{{ item }}"
        state: present
        cache_valid_time: 0
      loop:
        - "{{ item }}"
          with_items:
            - libgtk2.0-dev
            - libatk1.0-dev
            - libcairo2-dev
            - libpango1.0-dev
            - libdconf-dev

    - name: Install Java, Debian
      when: ansible_distribution == "Debian"
      apt:
        name: "{{ item }}"
        state: present
        cache_valid_time: 0
      loop:
        - "{{ item }}"
          with_items:
            - openjdk-{{ openjdk_version }}-{{ openjdk_dist }}
            - openjdk-{{ openjdk_version }}-{{ openjdk_arch }}

    - name: Install Java, RedHat
      when: ansible_distribution == "RedHat"
      yum:
        name: "{{ item }}"
        state: present
        cache_valid_time: 0
      loop:
        - "{{ item }}"
          with_items:
            - java-{{ openjdk_version }}-{{ openjdk_dist }}
            - java-{{ openjdk_version }}-{{ openjdk_arch }}

    - name: Export environment variables
      template:
        src: templates/java.env.j2
        dest: /etc/profile.d/java.env
        mode: '0644'

    - name: Source environment variables
      shell: 'source /etc/profile.d/java.env'

    - name: Correct java version selected for Java versions less than 11
      when: openjdk_version < 11
      apt:
        name: "{{ item }}"
        state: present
        cache_valid_time: 0
      loop:
        - "{{ item }}"
          with_items:
            - openjdk-{{ openjdk_version }}-{{ openjdk_dist }}-default

    - name: Correct java version selected for Java versions greater than or equal to 11
      when: openjdk_version >= 11
      apt:
        name: "{{ item }}"
        state: present
        cache_valid_time: 0
      loop:
        - "{{ item }}"
          with_items:
            - openjdk-{{ openjdk_version }}-{{ openjdk_dist }}-default



