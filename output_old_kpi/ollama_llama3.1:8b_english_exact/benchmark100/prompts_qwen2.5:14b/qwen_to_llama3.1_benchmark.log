---
- name: SSL Certificate Generation Tasks

  tasks:
  - name: Create ssl key
    file:
      path: "{{ item.ssl_dir }}/private_key.pem"
      state: touch
      mode: '0600'
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
    with_items: "{{ inventory_items }}"

  - name: Create ssl csr
    openssl_csr:
      csr: "{{ item.ssl_dir }}/cert.csr"
      private_key_path: "{{ item.ssl_dir }}/private_key.pem"
      common_name: "{{ item.common_name }}"
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
    with_items: "{{ inventory_items }}"

  - name: Create ssl certificates
    openssl_certificate:
      csr: "{{ item.ssl_dir }}/cert.csr"
      private_key_path: "{{ item.ssl_dir }}/private_key.pem"
      cert_path: "{{ item.ssl_dir }}/certificate.pem"
      state: present
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
    with_items: "{{ inventory_items }}"

  - name: Create PKCS#12 file
    openssl_pkcs12:
      src: "{{ item.ssl_dir }}/private_key.pem"
      dst: "{{ item.ssl_dir }}/PKCS12.p12"
      cert: "{{ item.ssl_dir }}/certificate.pem"
      password: "{{ item.ssl_password }}"
      state: present
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
    with_items: "{{ inventory_items }}"

  - name: Read private key
    fetch_url:
      url: "https://{{ item.ssl_dir }}/private_key.pem"
      dest: "{{ item.ssl_dir }}/private_key.pem"
      mode: '0600'
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
    with_items: "{{ inventory_items }}"
    register: private_key_contents
    when: item.ssl_dir | is_searchable

  - name: Read certificate
    fetch_url:
      url: "https://{{ item.ssl_dir }}/certificate.pem"
      dest: "{{ item.ssl_dir }}/certificate.pem"
      mode: '0644'
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
    with_items: "{{ inventory_items }}"
    register: certificate_contents
    when: item.ssl_dir | is_searchable

  - name: Create combined private_key and certificate file
    file:
      path: "{{ item.ssl_dir }}/combined.pem"
      state: touch
      mode: '0644'
    owner: "{{ item.user }}"
