```yaml
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required packages
  apt:
    name: "{{ service_required_packages }}"
    state: present
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: '0644'
  loop: "{{ service_list }}"
  when: ansible_service_mgr == 'systemd'
  notify: Systemctl daemon-reload

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: '0755'
  loop: "{{ service_list }}"
  when: (ansible_service_mgr == 'sysvinit') or (ansible_service_mgr == 'upstart') or (ansible_service_mgr == 'openrc')

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ (item.state if item.state is defined else 'started') if item.enabled is not defined else (item.enabled ? 'started' : 'stopped') }}"
    enabled: "{{ item.enabled if item.enabled is defined else true }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers
```


