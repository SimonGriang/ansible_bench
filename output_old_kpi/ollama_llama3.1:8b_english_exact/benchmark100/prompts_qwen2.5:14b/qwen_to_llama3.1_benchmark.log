---
- name: Create the RKE2 config directory
  become: yes
  become_method: sudo
  become_user: root
  file:
    path: /etc/rke2
    state: directory

- name: Set server taints
  become: yes
  become_method: sudo
  become_user: root
  set_fact:
    server_taints: "node.kubernetes.io/rke2-type='server'"

- name: Set agent taints
  become: yes
  become_method: sudo
  become_user: root
  set_fact:
    agent_taints: "node.kubernetes.io/rke2-type='agent'"

- name: Copy RKE2 config file
  become: yes
  become_method: sudo
  become_user: root
  copy:
    content: "{{ lookup('template', 'rke2_config.yml.j2') }}"
    dest: /etc/rke2/config.yaml
    mode: '0644'
  notify:
    - RKE2 config changed

- name: Copy kubelet config file
  become: yes
  become_method: sudo
  become_user: root
  copy:
    content: "{{ lookup('template', 'kubelet_config.yml.j2') }}"
    dest: /etc/kubernetes/kubelet.yaml
    mode: '0644'
    when: rke2_type == 'server'
  notify:
    - Kubelet config changed

- name: Copy Containerd Registry Configuration file
  become: yes
  become_method: sudo
  become_user: root
  copy:
    content: "{{ lookup('template', 'containerd_registry_config.yml.j2') }}"
    dest: /etc/containerd/config.toml
    mode: '0644'
    when: rke2_type == 'server' and containerd_registry_url is defined
  notify:
    - Containerd registry config changed

- name: Start RKE2 service
  become: yes
  become_method: sudo
  become_user: root
  service:
    name: rke2
    state: started
    enabled: yes
  retries: 10
  delay: 5
  until: service(rke2).state.start.recursive(true).active
  notify:
    - RKE2 service started

- name: Mask other RKE2 services
  become: yes
  become_method: sudo
  become_user: root
  service:
    name: "{{ item }}"
    state: masked
  with_items:
    - rke2-agent
    - rke2-apiserver
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  become: yes
  become_method: sudo
  become_user: root
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: 300
    delay: 10
    state: started
    connect_timeout: 10
    message: "Node {{ inventory_hostname }} is ready"
  until: wait_for("ansible_connection.local.host == '{{ inventory_hostname }}'")

- name: Wait for remaining nodes to be ready - with CNI
  become: yes
  become_method: sudo
  become_user: root
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: 300
    delay: 10
    state: started
    connect_timeout: 10
    message: "Node {{ inventory_hostname }} is ready with CNI"
  until: wait_for("ansible_connection.local.host == '{{ inventory_hostname }}' and ansible_facts['cni_initialized']")




