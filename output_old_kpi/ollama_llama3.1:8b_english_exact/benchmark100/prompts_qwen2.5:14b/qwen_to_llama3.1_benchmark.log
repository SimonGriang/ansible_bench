- name: SSL/TLS Configuration Tasks
  tasks:
  - name: Create ssl key
    file:
      path: /path/to/{{ item }}.key
      state: touch
      mode: '0640'
    owner: "{{ item }}"
    group: "{{ item }}"
    with_items:
      - item1
      - item2
      - item3

  - name: Create ssl csr
    file:
      path: /path/to/{{ item }}.csr
      state: touch
      mode: '0644'
    owner: "{{ item }}"
    group: "{{ item }}"
    with_items:
      - item1
      - item2
      - item3
    args:
      stdin: |
        {{ lookup('file', '/path/to/{{ item }}.key') }}

  - name: Create ssl certificates
    file:
      path: /path/to/{{ item }}.crt
      state: touch
      mode: '0644'
    owner: "{{ item }}"
    group: "{{ item }}"
    with_items:
      - item1
      - item2
      - item3
    args:
      stdin: |
        {{ lookup('file', '/path/to/{{ item }}.csr') }}

  - name: Create PKCS#12 file
    file:
      path: /path/to/{{ item }}.p12
      state: touch
      mode: '0640'
    owner: "{{ item }}"
    group: "{{ item }}"
    with_items:
      - item1
      - item2
      - item3
    args:
      stdin: |
        {{ lookup('file', '/path/to/{{ item }}.key') }}
        {{ lookup('file', '/path/to/{{ item }}.crt') }}
        friendly_name: "{{ item }}"

  - name: Read private key
    slurp:
      src: /path/to/{{ item }}.key
      dest: /path/to/{{ item }}.key.content
    with_items:
      - item1
      - item2
      - item3

