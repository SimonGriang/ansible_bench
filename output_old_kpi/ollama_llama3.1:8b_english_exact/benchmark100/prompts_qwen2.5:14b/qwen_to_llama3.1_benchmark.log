---
- name: Ensure the unzip package is available on the target system
  apt:
    name: unzip
    state: present
  when: ansible_distribution != 'Ubuntu'
  notify: update-cache

- name: Ensure the unzip package is available on the target system
  yum:
    name: unzip
    state: present
  when: ansible_distribution == 'Ubuntu'

- name: Create a system group for promtail
  group:
    name: promtail
    state: present
    system: yes

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    system: yes
    create_home: false
    append: false

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  notify: restart promtail

- name: Create application directories
  file:
    path: /usr/local/bin/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  notify: restart promtail

- name: Check if the promtail binary exists
  stat:
    path: /usr/local/bin/promtail/promtail
    state: file
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: https://example.com/promtail-binary
    dest: /usr/local/bin/promtail/promtail
    mode: '0755'
  when: not promtail_binary.stat.exists

- name: Propagate locally distributed promtail archive
  copy:
    content: '{{ lookup("file", "/path/to/promtail-archive") }}'
    dest: /usr/local/bin/promtail/promtail
    mode: '0755'
  when: not promtail_binary.stat.exists

- name: Download promtail binaries to controller node
  get_url:
    url: https://example.com/promtail-binary
    dest: /usr/local/bin/promtail/promtail
    mode: '0755'
  when: ansible_host == 'controller-node'

- name: Propagate promtail binaries
  copy:
    content: '{{ lookup("file", "/usr/local/bin/promtail/promtail") }}'
    dest: /usr/local/bin/promtail/promtail
    mode: '0755'
  when: ansible_host != 'controller-node'

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/bin/promtail/promtail
    dest: /usr/local/bin/promtail
    compression: tar
    compression_options: --strip-components=1
    mode: '0755'
    group: promtail
    owner: promtail
  notify: restart promtail

- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    src: /usr/local/bin/promtail/promtail
  notify: restart promtail

- name: Write configuration
  template:
    src: templates/promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0644'
    owner: promtail
    group: promtail
  notify: restart promtail

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  notify: restart promtail



