      template:
        src: templates/registries.yaml.j2
        dest: /etc/rancher/rke2/registries.yaml
      when: (rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty)
      notify: Config file changed

    - name: Register if we need to do a etcd restore from file
      set_fact:
