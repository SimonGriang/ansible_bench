---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  block:
    - name: Enable proxy module for Debian
      modprobe:
        name: http_proxy_module
      when: ansible_distribution == 'Debian'
    - name: Enable proxy_http module for Debian
      modprobe:
        name: proxy_http_module
      when: ansible_distribution == 'Debian'
    - name: Enable proxy module for Suse
      modprobe:
        name: http_proxy_module
      when: ansible_distribution == 'SUSE'
    - name: Enable proxy_http module for Suse
      modprobe:
        name: proxy_http_module
      when: ansible_distribution == 'SUSE'

- name: Configure locations using a template
  block:
    - name: Create destination directories
      file:
        path: "{{ item.path }}"
        state: directory
        mode: '0755'
      loop: "{{ httpd_locations }}"
    - name: Create destination files
      template:
        src: location.conf.j2
        dest: "{{ item.path }}"
        mode: '0644'
      loop: "{{ httpd_locations }}"
      notify: httpd configuration test and restart
  notify: httpd configuration test and restart


