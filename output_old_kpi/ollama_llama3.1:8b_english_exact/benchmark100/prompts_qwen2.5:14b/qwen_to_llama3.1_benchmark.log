---
- name: Configure package management
  hosts: localhost
  tasks:

  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Configure apk
    apt:
      cache_valid_time: 0
      update_cache: yes
      upgrade: yes
    notify: reboot

  - name: Configure apt
    apt_preferences:
      package_blacklist:
        - package1
        - package2
    apt:
      cache_valid_time: 0
      update_cache: yes
      upgrade: yes
      autoremove: yes
    notify: reboot

  - name: Update all software (dnf)
    dnf:
      cache_enabled: yes
      exclude:
        - package1
        - package2
      update_cache: yes
      list: all
    notify: reboot

  - name: Update all software (pacman)
    pacman:
      refresh: yes
    notify: reboot

  - name: Configure yum
    yum:
      update_cache: yes
      update_only: yes
    yum_repository:
      name: yumutils
      enabled: yes
    notify: reboot

  - name: Update all software (zypper)
    zypper:
      update: yes
    notify: reboot



