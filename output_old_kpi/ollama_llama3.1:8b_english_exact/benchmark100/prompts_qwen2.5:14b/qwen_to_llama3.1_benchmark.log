content='---\n\n- name: Import assert.yml\n  include: assert.yml\n\n- name: Install dns\n  package:\n    name: "{{ dns_packages }}"\n    state: present\n\n- name: Create directories\n  file:\n    path: "{{ item.path }}"\n    mode: "{{ item.mode }}"\n    owner: "{{ item.owner }}"\n    group: "{{ item.group }}"\n    state: present\n  loop:\n    - { path: /var/named, mode: \'0755\', owner: \'named\', group: \'named\' }\n    - { path: /var/named/slaves, mode: \'0755\', owner: \'named\', group: \'named\' }\n    - { path: /var/named/dynamic, mode: \'0755\', owner: \'named\', group: \'named\' }\n\n- name: Create group\n  group:\n    name: named\n    state: present\n\n- name: Create user\n  user:\n    name: named\n    group: named\n    create_home: no\n    system: yes\n\n- name: Generate rndc key\n  command: rndc-keygen -a -r /dev/urandom -f /etc/named/rndc.key\n  notify: rndc-key changed\n\n- name: Set permissions on rndc key file\n  file:\n    path: /etc/named/rndc.key\n    mode: \'0600\'\n\n- name: Get the hints/root file\n  get_url:\n    url: \'ftp://rs.internic.net/domain/named.root\'\n    dest: /var/named/named.root\n    mode: \'0644\'\n\n- name: Create zone file\n  template:\n    src: templates/named.conf.j2\n    dest: /etc/named.conf\n    mode: \'0644\'\n\n- name: Add zones to configuration\n  template:\n    src: templates/named.conf.j2\n    dest: /etc/named.conf\n    mode: \'0644\'\n    notify: service restarted\n\n- name: Place systemd override\n  file:\n    path: /etc/systemd/system/dns.service.d/override.conf\n    mode: \'0644\'\n    content: |\n      [Service]\n      ExecStartPost=/usr/sbin/named -g /var/named/chroot\n\n- name: Start and enable dns\n  service:\n    name: named\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-02T19:55:35.558734463Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4339829437, 'load_duration': 118748654, 'prompt_eval_count': 594, 'prompt_eval_duration': 130199601, 'eval_count': 501, 'eval_duration': 4090166609, 'model_name': 'llama3.1:8b'} id='run--0388d84f-df4a-43a6-9165-8e6e4ba3ac88-0' usage_metadata={'input_tokens': 594, 'output_tokens': 501, 'total_tokens': 1095}
