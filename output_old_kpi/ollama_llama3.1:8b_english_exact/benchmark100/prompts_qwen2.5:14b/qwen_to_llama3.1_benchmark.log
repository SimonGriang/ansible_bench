- name: Enable proxy and proxy_http modules on Debian and Suse systems
  block:
    - name: Enable proxy module for Debian
      community.general.modprobe:
        name: http_proxy_module
      when: ansible_distribution == 'Debian'
    - name: Enable proxy_http module for Debian
      community.general.modprobe:
        name: proxy_http_module
      when: ansible_distribution == 'Debian'
    - name: Enable proxy module for Suse
      community.general.modprobe:
        name: http_proxy_module
      when: ansible_distribution == 'SUSE'
