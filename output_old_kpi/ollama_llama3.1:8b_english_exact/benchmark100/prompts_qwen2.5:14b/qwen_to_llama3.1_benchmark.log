---
- name: Install Oracle Java
  import_tasks: assert.yml

- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "{{ java_vendor }}"
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  get_url:
    url: "http://example.com/path/to/oracle-java-rpm-package.rpm"
    dest: /tmp
  unarchive:
    src: /tmp/oracle-java-rpm-package.rpm
    dest: /usr/lib/jvm
    compression: rpm
  package:
    name: oracle-java
    state: present

- name: Install DEB
  get_url:
    url: "http://example.com/path/to/oracle-java-deb-package.deb"
    dest: /tmp
  unarchive:
    src: /tmp/oracle-java-deb-package.deb
    dest: /usr/lib/jvm
    compression: bzip2
  package:
    name: oracle-java
    state: present

- name: Install oracle java (rpm) (repository)
  apt_repository:
    repo: 'ppa:webupd8team/java'
  package:
    name: oracle-java
    state: present

- name: Configure oracle targz
  get_url:
    url: "http://example.com/path/to/oracle-java-targz-package.tar.gz"
    dest: /tmp
  unarchive:
    src: /tmp/oracle-java-targz-package.tar.gz
    dest: /usr/lib/jvm
    compression: tar
  file:
    path: /usr/lib/jvm/oracle-java-targz-package
    state: directory

- name: Install oracle java policy software (targz)
  get_url:
    url: "http://example.com/path/to/oracle-java-policy-software.tar.gz"
    dest: /tmp
  unarchive:
    src: /tmp/oracle-java-policy-software.tar.gz
    dest: /usr/lib/jvm
    compression: tar
  file:
    path: /usr/lib/jvm/oracle-java-policy-software
    state: directory

- name: Set alternative (targz)
  when: ansible_distribution != "Alpine Linux"
  shell:
    cmd: update-alternatives --install /usr/bin/java java /usr/lib/jvm/oracle-java-targz-package/bin/java 1

- name: Find JAVA_HOME
  shell:
    cmd: readlink -f /usr/lib/jvm/default-java

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME=/usr/lib/jvm/default-java"

