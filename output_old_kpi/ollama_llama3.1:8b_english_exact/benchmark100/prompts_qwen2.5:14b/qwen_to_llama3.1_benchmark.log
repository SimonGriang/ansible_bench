---
- name: Configure Apache HTTPD
  hosts: localhost

  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install apache httpd
    package:
      name: "{{ httpd_packages }}"

  - name: Configure selinux
    selinux:
      allow_httpd_anon_write: true
      allow_httpd_sys_content_t: true
      allow_httpd_log_read: true
      allow_httpd_user_content_t: true
      allow_httpd_t_exec_content: true
      allow_httpd_t_exec_t: true
      allow_httpd_t_log_write: true

  - name: Configure httpd
    template:
      src: httpd_config_src
      dest: httpd_config_dest
      notify: test configuration and restart httpd

  - name: Activate httpd module | Debian
    shell: a2enmod {{ item }}
    with_items:
      - mod_ssl
      - mod_socache_shmcb
    notify: test configuration and restart httpd

  - name: Import ssl.yml
    include_tasks: ssl.yml
    when: https_ssl_enable

  - name: Import locations.yml
    include_tasks: locations.yml
    when: httpd_locations is defined

  - name: Import vhosts.yml
    include_tasks: vhosts.yml
    when: httpd_vhosts is defined

  - name: Configure ports
    template:
      src: ports_src
      dest: ports_dest
    notify: test configuration and restart httpd
    when:
      - ansible_distribution == 'Debian'
      - ansible_distribution == 'Suse'

  - name: Import directories.yml
    include_tasks: directories.yml
    when: httpd_directories is defined

  - name: Flush handlers
    meta: flush_handlers

  - name: Removing default html
    file:
      path: /var/www/html/index.html
      state: absent
    when: httpd_remove_example

  - name: Start and enable httpd
    service:
      name: httpd
      state: started
      enabled: true



