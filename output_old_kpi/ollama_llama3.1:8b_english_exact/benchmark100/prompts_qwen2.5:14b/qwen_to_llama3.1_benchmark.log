---
- name: Bootstrap Tasks
  hosts: all

  tasks:
  - name: Assert all required variables are set correctly
    assert:
      that:
        - bootstrap_install.raw is defined
        - bootstrap_wait_for_host is defined
        - bootstrap_hostname is defined
        - bootstrap_port is defined

  - name: Wait for host
    wait_for:
      host: '{{ bootstrap_hostname }}'
      port: '{{ bootstrap_port }}'
      state: started
    when: bootstrap_wait_for_host

  - name: Prepare system
    become: true
    setup:
      filter:
        - bootstrap_facts
    debug:
      msg: "Can't connect to {{ bootstrap_hostname }} on port {{ bootstrap_port }}"
    rescue:
      - debug:
          msg: "Can't connect to {{ bootstrap_hostname }} on port {{ bootstrap_port }}"

  - name: Gather bootstrap facts (raw)
    include_tasks: gather_bootstrap_facts.yml

  - name: Install bootstrap packages (raw)
    raw: '{{ bootstrap_install.raw }}'
    when:
      - ansible_distribution in ['CentOS', 'RedHat']
      - bootstrap_install.raw is defined

  - name: Ensure system is prepared
    become: true
    setup:
      filter:
        - ansible_facts
    package:
      name: '{{ item }}'
      state: present
    with_items: '{{ bootstrap_facts.packages }}'
    when: bootstrap_facts.packages is defined

