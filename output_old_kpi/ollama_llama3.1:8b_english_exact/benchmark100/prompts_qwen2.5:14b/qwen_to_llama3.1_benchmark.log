---
- name: Check systemd usage
  assert:
    that: systemd.enabled

- name: Get latest promtail release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: true
  register: promtail_release

- name: Set promtail version
  set_fact:
    promtail_version: "{{ promtail_release.json.tag_name }}"

- name: Check zip local archive
  stat:
    path: "/path/to/promtail_v{{ promtail_version }}_{{ go_arch }}.zip"
  register: promtail_zip

- name: Assert local binary
  assert:
    that: promtail_binary_local_dir is defined
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: true
  register: promtail_release

- name: Get checksum for specific architecture
  set_fact:
    promtail_checksum: "{{ promtail_release.json.assets | json_query(\"[?name == 'promtail_v{{ promtail_version }}_{{ go_arch }}.zip'].sha256\") }}"


