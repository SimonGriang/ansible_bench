---
tasks:
  Create Vault group:
    name: Create {{ vault_group }} group
    group:
      name: "{{ vault_group }}"

  Create Vault user:
    name: Create {{ vault_user }} user
    user:
      name: "{{ vault_user }}"
      group: "{{ vault_group }}"
      create_home: no
      shell: "{{ vault_user_shell }}"

  Create Vault download directory:
    name: Create {{ vault_download_path }} directory
    file:
      path: "{{ vault_download_path }}"
      mode: '0755'
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"

  Download Vault binary:
    name: Download Vault binary
    get_url:
      url: "{{ vault_binary_url }}"
      dest: "{{ vault_download_path }}/vault"
    unarchive:
      src: "{{ vault_download_path }}/vault"
      dest: "{{ vault_download_path }}"
      compression: tar
    file:
      path: "{{ vault_download_path }}/vault"
      owner: 'root'

  Check if vault_path exists:
    name: Check if {{ vault_path }} exists
    stat:
      path: "{{ vault_path }}"
      register: vault_path_stat

  Create vault_path if it does not exist:
    name: Create {{ vault_path }} directory
    file:
      path: "{{ vault_path }}"
      state: directory
      mode: '0755'
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
    when: vault_path_stat.stat.exists == false

  Create directory in vault_path:
    name: Create directories in {{ vault_path }}
    file:
      path: "{{ item.path }}"
      state: directory
      mode: '0755'
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
    with_items: "{{ vault_directories }}"
    when: vault_path_stat.stat.exists == true

  Create data directory:
    name: Create data directories
    file:
      path: "{{ item.path }}"
      state: directory
      mode: '0755'
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
    with_items: "{{ vault_data_directories }}"
    when: vault_path_stat.stat.exists == true

  Generate TLS key and certificate:
    name: Generate TLS key and certificate
    openssl_private_key:
      path: "{{ vault_data_directory }}/tls/{{ vault_tls_private_key }}.pem"
      key_length: 2048
      key_format: PEM
      provider: crypto_openssl
    openssl_certificate:
      path: "{{ vault_data_directory }}/tls/{{ vault_tls_certificate }}.pem"
      privatekey_path: "{{ vault_data_directory }}/tls/{{ vault_tls_private_key }}.pem"
      days_valid: 1095
    notify: Restart vault

  Set ownership of tls material:
    name: Set ownership of TLS files
    file:
      path: "{{ item.path }}"
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
    with_items: "{{ vault_tls_files }}"

  Copy Vault binary:
    name: Copy Vault binary
    copy:
      content: "{{ lookup('file', '{{ vault_download_path }}/vault') }}"
      dest: "{{ vault_path }}/usr/bin/vault"
      mode: '0755'
    notify: Restart vault

  Set cap_ipc_lock=ep on /usr/bin/vault:
    name: Set cap_ipc_lock=ep on /usr/bin/vault
    file:
      path: "{{ vault_path }}/usr/bin/vault"
      state: file
      mode: '0755'
      follow: yes
    seuser: root
    segroup: root
    selevel: system_u
    selabel: {{ vault_path }}/usr/bin/vault
    setype: bin_t
    setransaction: no
    setype_transition: no

  Touch vault.env:
    name: Touch {{ vault_path }}/etc/vault.d/vault.env
    file:
      path: "{{ vault_path }}/etc/vault.d/vault.env"
      state: touch
      mode: '0644'
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
    notify: Restart vault

  Create /usr/lib/systemd/system:
    name: Create /usr/lib/systemd/system
    file:
      path: "/usr/lib/systemd/system"
      state: directory
      mode: '0755'

  Copy Vault service file:
    name: Copy Vault service file
    template:
      src: "vault.service.j2"
      dest: "/usr/lib/systemd/system/vault.service"
      mode: '0644'
      owner: 'root'
      group: 'root'
      notify: Daemon reload
    when: ansible_distribution == 'Ubuntu'

  Copy vault configuration:
    name: Copy vault configuration
    template:
      src: "vault.hcl.j2"
      dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
      mode: '0644'
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      notify: Restart vault

  Flush handlers:
    meta:
      flush_handlers: yes



