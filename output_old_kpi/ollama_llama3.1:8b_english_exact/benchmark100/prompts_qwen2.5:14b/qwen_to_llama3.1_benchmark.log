---
- name: Update apt cache
  ansible.builtin.apt:
    update_cache: true

- name: Update dnf cache
  ansible.builtin.dnf:
    update_cache: true

- name: Install packages
  ansible.builtin.apt:
    name: keepalived
    state: present

- name: Create directory for keepalived
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.template:
    src: templates/kubernetes_api_health_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_health_check.sh
    mode: '0755'
  notify: restart keepalived

- name: Create Kubernetes API health check script for RedHat OS family
  ansible.builtin.template:
    src: templates/kubernetes_api_health_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_health_check.sh
    mode: '0755'
  notify: restart keepalived

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.template:
    src: templates/rke2_server_health_check.sh.j2
    dest: /etc/keepalived/rke2_server_health_check.sh
    mode: '0755'
  notify: restart keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.template:
    src: templates/rke2_server_health_check.sh.j2
    dest: /etc/keepalived/rke2_server_health_check.sh
    mode: '0755'
  notify: restart keepalived

- name: Create keepalived config file
  ansible.builtin.template:
    src: templates/keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    mode: '0644'
  notify: restart keepalived

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.service:
    name: keepalived
    enabled: true
    state: started
  notify: restart keepalived

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true



