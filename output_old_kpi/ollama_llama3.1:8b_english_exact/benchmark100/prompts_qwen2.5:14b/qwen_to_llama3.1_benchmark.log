  command: rndc-keygen -a -r /dev/urandom -f /etc/named/rndc.key
  notify: rndc-key changed

- name: Set permissions on rndc key file
  file:
    path: /etc/named/rndc.key
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: 'ftp://rs.internic.net/domain/named.root'
    dest: /var/named/named.root
    mode: '0644'

- name: Create zone file
  template:
    src: templates/named.conf.j2
    dest: /etc/named.conf
    mode: '0644'

- name: Add zones to configuration
  template:
    src: templates/named.conf.j2
    dest: /etc/named.conf
    mode: '0644'
    notify: service restarted

- name: Place systemd override
  file:
    path: /etc/systemd/system/dns.service.d/override.conf
    mode: '0644'
    content: |
      [Service]
      ExecStartPost=/usr/sbin/named -g /var/named/chroot

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes


