---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    create_home: no
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  get_url:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    mode: '0755'
  become: yes

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
    state: file

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"
  loop_control:
    loop_var: item

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"
  loop_control:
    loop_var: item

- name: Generate TLS key and certificate
  openssl_private_key:
    path: "{{ vault_data_directory }}/{{ vault_tls_directory }}/tls.key"
    state: present
  notify: 'Restart vault'

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    state: file
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"
  loop_control:
    loop_var: item

- name: Copy Vault binary
  copy:
    content: "{{ lookup('file', '{{ vault_download_path }}/vault') }}"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: 'Restart vault'

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setfacl:
    path: "{{ vault_path }}/usr/bin/vault"
    set: "d:cap_ipc_lock=ep"
    state: present

- name: Touch vault.env
  file:
