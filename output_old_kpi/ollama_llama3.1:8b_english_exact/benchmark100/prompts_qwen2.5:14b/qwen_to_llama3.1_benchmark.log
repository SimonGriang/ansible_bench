--- 

- name: Create directories
  become: yes
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ httpd_directories }}"

- name: Configure directories
  become: yes
  template:
    src: directory.conf.j2
    dest: "{{ item.path }}/directory.conf"
    mode: '0644'
  loop: "{{ httpd_directories }}"

- name: Test the httpd configuration
  become: yes
  service:
    name: httpd
    state: restarted
    enabled: yes

- name: Test the httpd configuration
  become: yes
  httpd_test_config:
    config_file: "/etc/httpd/conf/httpd.conf"
    mode: "0644"
  register: result

- name: Restart the httpd service
  become: yes
  service:
    name: httpd
    state: restarted
    enabled: yes


