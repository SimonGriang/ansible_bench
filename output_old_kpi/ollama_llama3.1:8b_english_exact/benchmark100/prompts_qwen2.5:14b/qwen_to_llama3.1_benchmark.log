---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: /home/{{ user.name }}/ssh_key_directory
    state: directory
    mode: '0750'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.manage_ssh_key

- name: Manage user {{ user.name }}
  user:
    name: {{ user.name }}
    state: present
    password: {{ user.password }}
    sudo: true
    append: true
    groups: {{ user.groups }}
  when: user.state == 'present'

- name: Set sudo options for {{ user.name }}
  template:
    src: templates/sudoers.j2
    dest: /etc/sudoers.d/{{ user.name }}
    mode: '0640'
  notify: sudo configuration changed
  when: user.sudo_options

- name: Remove sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: not user.sudo_options

- name: Generate private ssh key for {{ user.name }}
  ssh_keypair:
    user: {{ user.name }}
    state: present
    key_format: openssh
    mode: '0750'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.manage_ssh_key

- name: Generate public ssh key for {{ user.name }}
  ssh_keypair:
    user: {{ user.name }}
    state: present
    key_format: openssh
    mode: '0750'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.manage_ssh_key

- name: Convert ssh key to ppk for {{ user.name }}
  ssh_keypair:
    user: {{ user.name }}
    state: present
    key_format: ppk
    mode: '0750'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.manage_ssh_key

- name: Get or set the home directory for {{ user.name }}
  file:
    path: /home/{{ user.name }}
    state: directory
    mode: '0750'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.home_directory is undefined

- name: Create .ssh directory for {{ user.name }}
  file:
    path: /home/{{ user.name }}/.ssh
    state: directory
    mode: '0750'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.manage_ssh_key or user.private_keys

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: {{ user.name }}
    state: present
    key: "{{ user.authorized_keys }}"
  when: user.authorized_keys

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: {{ user.name }}
    state: absent
    key: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    content: "{{ lookup('file', '/etc/ssh/keys/{{ user.name }}.key') }}"
    dest: /home/{{ user.name }}/.ssh/{{ user.name }}_private_key
    mode: '0644'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  shell:
    cmd: "chage -l {{ user.name }}"
    register: user_password_validity
  when: user.check_password_validity

- name: Set users password valid time for {{ user.name }}
  shell:
    cmd: "chage -l {{ user.name }}"
    register: user_password_validity
  notify: password configuration changed
  when: user.password_validity_days and user_password_validity.stdout != ""

- name: Place private key file for {{ user.name }}
  file:
    path: /home/{{ user.name }}/.ssh/{{ user.private_keys[0] }}
    state: file
    mode: '0644'
    owner: {{ user.name }}
    group: {{ user.name }}
  when: user.private_keys



