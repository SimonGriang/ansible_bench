---
- name: Configure RKE2
  tasks:
    - name: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory

    - name: Set server taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"

    - name: Copy RKE2 configuration file
      template:
        src: templates/config.yaml.j2
        dest: /etc/rancher/rke2/config.yaml
        notify: Config file changed

    - name: Copy kubelet configuration file
      template:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        when: rke2_kubelet_config is not empty
        notify: Config file changed

    - name: Copy Containerd Registry Configuration file
      template:
        src: templates/registries.yaml.j2
        dest: /etc/rancher/rke2/registries.yaml
        when: (rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty)
        notify: Config file changed

    - name: Register if we need to do a etcd restore from file
      set_fact:
        do_etcd_restore: true
      when: (rke2_etcd_snapshot_file is not empty and (rke2-server.service is disabled or undefined))

    - name: Register if we need to do a etcd restore from s3
      set_fact:
        do_etcd_restore_from_s3: true
      when: (rke2_etcd_snapshot_file is not empty and rke2_etcd_snapshot_s3_options is defined)

    - name: Restore etcd from file
      block:
        - file:
            path: /etc/rancher/rke2/etcd-snapshots
            state: directory
        - copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: /etc/rancher/rke2/etcd-snapshots
        - shell:
            cmd: 'rke2 etcd restore --path /etc/rancher/rke2/etcd-snapshots'
      when: do_etcd_restore is defined

    - name: Restore etcd from s3
      block:
        - file:
            path: /etc/rancher/rke2/etcd-snapshots
            state: directory
        - rke2_etcd_snapshot_s3:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: /etc/rancher/rke2/etcd-snapshots
        - shell:
            cmd: 'rke2 etcd restore --path /etc/rancher/rke2/etcd-snapshots'
      when: do_etcd_restore_from_s3 is defined

    - name: Start RKE2 service on the first server
      service:
        name: rke2-server
        state: started
        enabled: true
      when: inventory_hostname in groups['rke2_cluster_group_name']

    - name: Mask RKE2 agent service on the first server
      service:
        name: rke2-agent
        state: masked
      when: inventory_hostname in groups['rke2_cluster_group_name']

    - name: Wait for the first server be ready - no CNI
      wait_for:
        delay: 10
        timeout: 300
        host: "{{ groups['rke2_cluster_group_name'][0] }}"
        state: "active"
        condition: "node.status == 'ready' and node.cni == 'false'"

    - name: Wait for the first server be ready - with CNI
      wait_for:
        delay: 10
        timeout: 300
        host: "{{ groups['rke2_cluster_group_name'][0] }}"
        state: "active"
        condition: "node.status == 'ready' and node.cni == 'true'"

    - name: Restore etcd
      block:
        - rke2_etcd:
          state: restored
        - rke2_node:
          state: restored
      when: (do_etcd_restore or do_etcd_restore_from_s3) is defined

    - name: Set an Active Server variable
      set_fact:
        active_server: "{{ inventory_hostname }}"
      when: inventory_hostname in groups['rke2_cluster_group_name']


