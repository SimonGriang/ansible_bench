--- 

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    dest: /etc/crontab
    line: SHELL="{{ cron_shell }}"
    create: yes
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure path
  lineinfile:
    dest: /etc/crontab
    line: PATH="{{ cron_path }}"
    create: yes
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    dest: /etc/crontab
    line: MAILTO="{{ cron_mailto }}"
    create: yes
    state: present
    mode: '0600'
  notify: Restart cron

- name: Start and enable cron
  service:
    name: cron
    enabled: true
    state: started
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('0') }}"
    hour: "{{ item.hour | default('0') }}"
    day: "{{ item.day | default('0') }}"
    month: "{{ item.month | default('0') }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


