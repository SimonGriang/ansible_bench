---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/bin/python3.11/EXTERNALLY-MANAGED
  register: python3_11_file_exists

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  copy:
    content: ""
    dest: /usr/bin/python3.11/EXTERNALLY-MANAGED.old
  when: python3_11_file_exists.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/bin/python3.12/EXTERNALLY-MANAGED
  register: python3_12_file_exists

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  copy:
    content: ""
    dest: /usr/bin/python3.12/EXTERNALLY-MANAGED.old
  when: python3_12_file_exists.stat.exists

- import_tasks: assert.yml

- name: Install python pip
  apt:
    name: python3-pip
    state: present

- name: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
    backup: yes
  when: python_pip_trusted_host is defined

- name: Update pip.
  apt:
    name: python3-pip
    state: present
    update_cache: yes
    cache_valid_time: 3600
  when:
    - python_pip_update is true
    - (ansible_distribution != 'Ubuntu' or ansible_distribution_release not in ['bookworm', 'noble'])
    - ansible_distribution != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ python_pip_modules }}"
    state: present
  when:
    - python_pip_modules is defined
    - (ansible_distribution != 'Ubuntu' or ansible_distribution_release not in ['bookworm', 'noble'])
    - ansible_distribution != 'Alpine'



