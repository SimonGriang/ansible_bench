---
- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: '{{ rke2_service_name }}'
    state: restarted

- name: Wait for all nodes to be ready again
  wait_for:
    host: '{{ active_server | default(in_group_members(rke2_servers_group_name)[0]) }}'
    port: 22
    delay: 15
    timeout: 100
    status: 0
  delegate_to: '{{ active_server | default(in_group_members(rke2_servers_group_name)[0]) }}'
  run_once: true
  check_mode: true

- name: Wait for all pods to be ready again
  kubernetes_info:
    api_version: v1
    kind: Pod
    namespace: default
    label_selectors:
      - status=Running
      - status=Succeeded
  delegate_to: '{{ active_server | default(in_group_members(rke2_servers_group_name)[0]) }}'
  when: rke2_wait_for_all_pods_to_be_ready
  run_once: true
  check_mode: true

