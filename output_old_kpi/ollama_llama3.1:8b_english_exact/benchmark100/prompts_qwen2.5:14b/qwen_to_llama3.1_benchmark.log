content='```\n---\n- name: Check if certificates exist\n  stat:\n    path: "{{ item.path }}"\n  loop: "{{ java_certs }}"\n  register: cert_stat\n\n- name: Fail if some certificate doesn\'t exist\n  fail:\n    msg: "Certificate {{ item.path | basename }} missing"\n  loop: "{{ java_certs }}"\n  when: not cert_stat[item.path].stat.exists\n\n- name: Setting keystore variables in java < 11\n  set_fact:\n    java_keystore_dir: "{{ java_keystore_dir_old }}"\n\n- name: Setting keystore variables in java >= 11\n  set_fact:\n    java_keystore_dir: "{{ java_keystore_dir_new }}"\n\n- name: Import SSL certificates\n  java_cert:\n    cert_dir: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"\n    certificates: "{{ java_certs }}"\n    state: present\n  when: (java_open_jdk_version_major | int) >= 11\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-02T20:22:33.033019172Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2261955996, 'load_duration': 113727692, 'prompt_eval_count': 502, 'prompt_eval_duration': 34986740, 'eval_count': 207, 'eval_duration': 2111399435, 'model_name': 'llama3.1:8b'} id='run--498e2f1f-c8e1-48ce-a094-8901d0b644ca-0' usage_metadata={'input_tokens': 502, 'output_tokens': 207, 'total_tokens': 709}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Check if certificates exist
  stat:
    path: "{{ item.path }}"
  loop: "{{ java_certs }}"
  register: cert_stat

- name: Fail if some certificate doesn't exist
  fail:
    msg: "Certificate {{ item.path | basename }} missing"
  loop: "{{ java_certs }}"
  when: not cert_stat[item.path].stat.exists

- name: Setting keystore variables in java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"

- name: Setting keystore variables in java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"

- name: Import SSL certificates
  java_cert:
    cert_dir: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    certificates: "{{ java_certs }}"
    state: present
  when: (java_open_jdk_version_major | int) >= 11



