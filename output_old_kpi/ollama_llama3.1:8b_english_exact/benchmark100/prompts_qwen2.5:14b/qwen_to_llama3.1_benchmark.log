  ansible.builtin.command: easyrsa build-ca
  when: not ansible.builtin.stat(path='/etc/openvpn/easy-rsa/pki/ca.crt').exists

- name: Easyrsa gen-dh
  ansible.builtin.command: easyrsa gen-dh
  when: not ansible.builtin.stat(path='/etc/openvpn/easy-rsa/pki/dh.pem').exists

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command: easyrsa build-server-full server nopass
  when: not ansible.builtin.stat(path='/etc/openvpn/easy-rsa/pki/private/server.key').exists

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command: easyrsa build-client-full client nopass
  when: not ansible.builtin.stat(path='/etc/openvpn/easy-rsa/pki/private/client.key').exists

- name: Easyrsa gen-crl
  ansible.builtin.command: easyrsa gen-crl
  when: not ansible.builtin.stat(path='/etc/openvpn/easy-rsa/pki/crl.pem').exists

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/*
    dest: /etc/openvpn/server
    mode: '0644'
    owner: root
    group: root

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/*
    dest: /etc/openvpn
    mode: '0644'
    owner: root
    group: root

- name: Place server.conf
  ansible.builtin.template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0644'
    owner: root
    group: root
  notify: restart openvpn



