    shell: helm version
    when: helm_exists.stat.exists
    register: helm_version
    changed_when: False

  - name: Download helm
    get_url:
      url: 'https://get.helm.sh/helm-v{{ helm_version.stdout.split(" ")[1] }}-linux-amd64.tar.gz'
      dest: /tmp/helm
      mode: '0644'
    when: (not helm_exists.stat.exists) or (helm_version.stdout.split(' ')[1] != helm_version.stdout)
    notify:
      - helm download

  - name: Copy helm binary into place
    copy:
      content: "{{ lookup('file', '/tmp/helm/helm') }}"
      dest: /usr/local/bin/helm
      mode: '0755'
    when: (not helm_exists.stat.exists) or (helm_version.stdout.split(' ')[1] != helm_version.stdout)
  handlers:
  - name: helm download
    shell: echo "Download complete"



