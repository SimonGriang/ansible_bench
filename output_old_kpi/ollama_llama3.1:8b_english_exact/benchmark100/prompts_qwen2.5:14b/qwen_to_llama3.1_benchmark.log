---
- name: Install Keepalived when HA mode is enabled
  block:
    - name: Check if HA mode is enabled
      set_fact:
        ha_mode_enabled: true
    - name: Install Keepalived when HA mode is enabled
      when: ha_mode_enabled
      apt:
        name: keepalived
        state: present
  when: group_names == 'rke2_servers'

- name: Download and install RKE2
  get_url:
    url: 'https://github.com/rancher/rke/releases/download/{{ rke2_version }}/rke2_{{ rke2_version }}_linux_amd64'
    dest: /tmp/rke2
    mode: '0755'
  become: true
  run_once: true
  delegate_to: localhost
  notify: restart rke2

- name: CIS Hardening
  include_tasks: cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  set_fact:
    active_server: "{{ groups['rke2_servers'][0] }}"

- name: Enable IPVS kernel module
  modprobe:
    name: ipvs
    state: present
  when: ha_mode_enabled and kube_vip_enabled

- name: Copy kube-vip manifests to the masternode
  copy:
    content: "{{ lookup('template', 'kube-vip.yml') }}"
    dest: /etc/kubernetes/kube-vip.yml
  when: not ha_mode_enabled

- name: Copy ingress-nginx manifests to the masternode
  copy:
    content: "{{ lookup('template', 'ingress-nginx.yml') }}"
    dest: /etc/kubernetes/ingress-nginx.yml
  when: ingress_nginx_config is defined

- name: Prepare very first server node in the cluster
  block:
    - name: Ensure etcd is initialized
      command: etcdctl init
      become: true
      become_user: etcd
    - name: Ensure etcd is started
      service:
        name: etcd
        state: started
        enabled: true
  when: inventory_hostname == active_server

- name: Restore etcd specific tasks
  include_tasks: etcd_restore.yml
  when: etcd_restore is defined

- name: Download kubeconfig to ansible localhost
  uri:
    url: "{{ rke2_server_url }}/v1/config/kubeconfig"
    method: GET
    return_content: true
    status_code: 200
    body_format: json
  delegate_to: localhost
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  block:
    - name: Ensure cluster is initialized
      command: rke2 init
      become: true
      become_user: root
    - name: Ensure cluster is joined
      command: rke2 join
      become: true
      become_user: root
  when: active_server is defined

- name: Rolling cordon and drain restart when version changes - servers
  block:
    - name: Cordon nodes
      systemd:
        name: etcd
        state: stopped
    - name: Drain nodes
      systemd:
        name: etcd
        state: stopped
  when: rke2_version is defined

- name: Rolling cordon and drain restart when version changes - agents
  block:
    - name: Cordon nodes
      systemd:
        name: agent
        state: stopped
    - name: Drain nodes
      systemd:
        name: agent
        state: stopped
  when: rke2_version is defined

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Rolling restart when config files change
  systemd:
    name: etcd
    state: restarted
  when: config_files_changed

- name: Final steps
  block:
    - name: Ensure cluster is healthy
      command: rke2 cluster health
      become: true
      become_user: root
    - name: Ensure etcd is healthy
      command: etcdctl member list
      become: true
      become_user: etcd
  notify: restart etcd



