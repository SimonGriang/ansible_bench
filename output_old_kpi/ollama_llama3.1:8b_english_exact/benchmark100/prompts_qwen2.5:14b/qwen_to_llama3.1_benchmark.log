---
- name: Pre-execution checks
  include_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    dest: /etc/cron.d/crontab
    line: SHELL=/bin/bash
    regexp: '^SHELL$'
    state: present
  notify: restart cron

- name: Configure path
  lineinfile:
    dest: /etc/cron.d/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    regexp: '^PATH$'
    state: present
  notify: restart cron

- name: Configure mailto
  lineinfile:
    dest: /etc/cron.d/crontab
    line: MAILTO=root
    regexp: '^MAILTO$'
    state: present
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    dayOfWeek: "{{ item.dayOfWeek }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    loop_var: item



