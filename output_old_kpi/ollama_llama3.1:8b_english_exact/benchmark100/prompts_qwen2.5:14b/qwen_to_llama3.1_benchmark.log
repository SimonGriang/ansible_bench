ining nodes to be ready - no CNI\n  become: yes\n  become_method: sudo\n  become_user: root\n  wait_for:\n    host: "{{ inventory_hostname }}"\n    port: 22\n    timeout: 300\n    delay: 10\n    state: started\n    connect_timeout: 10\n    message: "Node {{ inventory_hostname }} is ready"\n  until: wait_for("ansible_connection.local.host == \'{{ inventory_hostname }}\'")\n\n- name: Wait for remaining nodes to be ready - with CNI\n  become: yes\n  become_method: sudo\n  become_user: root\n  wait_for:\n    host: "{{ inventory_hostname }}"\n    port: 22\n    timeout: 300\n    delay: 10\n    state: started\n    connect_timeout: 10\n    message: "Node {{ inventory_hostname }} is ready with CNI"\n  until: wait_for("ansible_connection.local.host == \'{{ inventory_hostname }}\' and ansible_facts[\'cni_initialized\']")\n\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-02T20:31:34.028759396Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8041886915, 'load_duration': 119061018, 'prompt_eval_count': 634, 'prompt_eval_duration': 146293031, 'eval_count': 781, 'eval_duration': 7775386950, 'model_name': 'llama3.1:8b'} id='run--e50e7dfb-f6b2-49bf-8dc8-a668d638831b-0' usage_metadata={'input_tokens': 634, 'output_tokens': 781, 'total_tokens': 1415}
