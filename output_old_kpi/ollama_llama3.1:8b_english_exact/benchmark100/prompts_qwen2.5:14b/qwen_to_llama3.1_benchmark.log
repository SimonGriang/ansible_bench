---
- name: Import assert.yml
  include: assert.yml

- name: Install using package
  package:
    name: "{{ item }}"
    state: present
  loop:
    - "hashicorp/product-{{ product_version }}-{{ product_name }}-linux-amd64.zip"

- name: Install repository for RedHat
  yum_repository:
    name: hashicorp
    description: HashiCorp repository
    display_name: HashiCorp
    baseurl: "https://rpm.releases.hashicorp.com/RHEL={{ ansible_distribution_major_version }}-{{ ansible_distribution_release }}/{{ product_name }}"
    gpgcheck: true
    gpgkey: "https://rpm.releases.hashicorp.com/GPG-PUB-KEY-HASHICORP"

- name: Configure debian
  apt_repository:
    repo: 'ppa:hashicorp/{{ product_name }}'
    state: present

- name: Install required package gpg
  apt:
    name: gnupg2
    state: present

- name: Install apt key for Debian
  apt_key:
    keyserver: keyserver.ubuntu.com
    id: C3E8D41BE60B8F8FA0EC3105C705E48CD318FA2D

- name: Install repository for Debian
  apt_repository:
    repo: "ppa:hashicorp/{{ product_name }}"
    state: present

- name: Install hashicorp product using package
  package:
    name: "{{ item }}"
    state: present
  loop:
    - "hashicorp/product-{{ product_version }}-{{ product_name }}-linux-amd64.zip"

- name: Install versioned hashicorp product using package
  package:
    name: "{{ item }}"
    state: present
  loop:
    - "hashicorp/product-{{ product_version }}-{{ product_name }}-linux-amd64.zip"

- name: Install manually
  unarchive:
    src: "{{ product_path }}/{{ product_name }}-linux-amd64.zip"
    dest: "{{ product_path }}"
    compression: zip

- name: Install hashicorp product manually
  file:
    path: "{{ product_path }}/{{ product_name }}-linux-amd64"
    state: directory
    owner: "{{ product_owner }}"
    group: "{{ product_group }}"
    mode: '0755'
  become: true
  notify:
    - restart service



