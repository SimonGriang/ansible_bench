  - name: Copy helm binary into place
    copy:
      content: "{{ lookup('file', '/tmp/helm/helm') }}"
      dest: /usr/local/bin/helm
      mode: '0755'
    when: helm_exists.stat.exists == False or helm_version.stdout.split(' ')[1] != helm_version.stdout


