      mode: '0600'

  - name: Check users password valid time for user
    shell: chage -l {{ user }}

  - name: Set users password valid time for user
    shell: chage -E {{ password_valid_time }} {{ user }}

  - name: Place private key file for user
    copy:
      content: "{{ lookup('file', '/home/{{ user }}/.ssh/{{ user }}_id_rsa') }}"
      dest: "/home/{{ user }}/.ssh/{{ user }}_id_rsa"
