---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2
    state: restarted
    notify: Service (re)started

- name: Wait for all nodes to be ready again
  block:
    - kubectl:
        cmd: get nodes
        executable: kubectl
        register: kubectl_output
        delegate_to: "{{ rke2_servers_group_name[0] | default(inventory_hostname) }}"
        retries: 100
        retry_delay: 15
        until: "'status' in kubectl_output.stdout and kubectl_output.stdout['status'] == 'Ready'"
    - meta: flush_handlers

- name: Wait for all pods to be ready again
  block:
    - kubectl:
        cmd: get pods --all-namespaces
        executable: kubectl
        register: kubectl_output
        delegate_to: "{{ rke2_servers_group_name[0] | default(inventory_hostname) }}"
        retries: 100
        retry_delay: 15
        until: "'status' in kubectl_output.stdout and kubectl_output.stdout['status'] == 'Running'"
      when: rke2_wait_for_all_pods_to_be_ready|bool and not ansible_check_mode
    - meta: flush_handlers

