---
- name: Configure Fail2ban
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Install fail2ban
    package:
      name: "{{ fail2ban_packages }}"
      state: present

  - name: Copy filters in filter.d
    copy:
      src: "{{ item }}"
      dest: "{{ fail2ban_filterd_path }}"
      owner: root
      group: root
      mode: '0640'
    notify: Restart fail2ban
    when: fail2ban_filterd_path is defined
    loop: "{{ lookup('file', '{{ lookup('env', 'HOME') }}/fail2ban_filters') }}"

  - name: Configure fail2ban.local
    template:
      src: fail2ban.local.j2
      dest: /etc/fail2ban/fail2ban.local
      mode: '0640'
      owner: root
      group: root
    notify: Restart fail2ban
    loop_control:
      label: "{{ item.option }}"
    loop:
      - option: "{{ fail2ban_base_configuration }}"
        values: "{{ fail2ban_configuration }}"
    when: fail2ban_base_configuration is defined and fail2ban_configuration is defined

  - name: Configure jail.local
    template:
      src: jail.local.j2
      dest: /etc/fail2ban/jail.local
      mode: '0640'
      owner: root
      group: root
    notify: Restart fail2ban
    loop_control:
      label: "{{ item.option }}"
    loop:
      - option: "{{ fail2ban_base_jail_configuration }}"
        values: "{{ fail2ban_jail_configuration }}"
    when: fail2ban_base_jail_configuration is defined and fail2ban_jail_configuration is defined

  - name: Stat auth log file
    stat:
      path: /var/log/auth.log
    register: fail2ban_auth

  - name: Touch auth log file
    file:
      path: /var/log/auth.log
      state: touch
      mode: '0640'
    when: fail2ban_auth.stat.exists != true

  - name: Start and enable fail2ban
    service:
      name: "{{ fail2ban_service }}"
      state: started
      enabled: true


