--- 

- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  shell:
    cmd: helm version
  register: helm_existing_version

- name: Download helm
  unarchive:
    src: https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz
    dest: /tmp
    src_dir: helm-{{ helm_version }}-linux-amd64
    compression: tar
    owner: root
    group: root
  when: helm_check.stat.exists == False or helm_existing_version.stdout != helm_version
  register: helm_download

- name: Copy helm binary into place
  copy:
    content: "{{ helm_download.extracted.helm }}"
    dest: /usr/local/bin/helm
    mode: '0755'
  when: helm_download is not failed

