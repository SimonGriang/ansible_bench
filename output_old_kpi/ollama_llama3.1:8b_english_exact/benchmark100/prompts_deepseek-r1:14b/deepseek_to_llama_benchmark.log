ry\n  find:\n    paths: /usr/bin/java\n    file_type: link\n  register: java_home\n\n- name: Set JAVA_HOME in environment\n  lineinfile:\n    dest: /etc/profile.d/java_home.sh\n    line: "export JAVA_HOME={{ java_home.path }}"\n    state: present' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-05T11:18:26.44967296Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6500544218, 'load_duration': 105659479, 'prompt_eval_count': 605, 'prompt_eval_duration': 175940130, 'eval_count': 584, 'eval_duration': 6217415728, 'model_name': 'llama3.1:8b'} id='run--7a148e49-e523-49ff-8925-63b5d188a837-0' usage_metadata={'input_tokens': 605, 'output_tokens': 584, 'total_tokens': 1189}
