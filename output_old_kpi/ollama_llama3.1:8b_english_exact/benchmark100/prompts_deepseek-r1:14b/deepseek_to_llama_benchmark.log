content='---\n\n\n- name: Create RKE2 config directory\n  become: true\n  file:\n    path: /etc/rke2/config\n    state: directory\n    owner: root\n    group: root\n    mode: \'0755\'\n\n\n- name: Set server taints\n  set_fact:\n    rke2_server_node_taints: "{{ rke2_server_node_taints | default([]) + [item.node_name] }}"\n  when: "\'server\' in item.labels | string"\n\n\n- name: Copy RKE2 configuration file\n  become: true\n  copy:\n    content: "{{ lookup(\'template\', source + \'/rke2.yaml.j2\') }}"\n    dest: /etc/rke2/config/rke2.yaml\n    owner: root\n    group: root\n    mode: \'0644\'\n  notify:\n    restart RKE2\n\n\n- name: Copy kubelet configuration file\n  become: true\n  copy:\n    content: "{{ lookup(\'template\', source + \'/kubelet.yaml.j2\') }}"\n    dest: /etc/kubernetes/config/kubelet.yaml\n    owner: root\n    group: root\n    mode: \'0644\'\n    when: rke2_kubelet_config is defined and rke2_kubelet_config|length > 0\n  notify:\n    restart kubelet\n\n\n- name: Copy Containerd Registry Configuration file\n  become: true\n  copy:\n    content: "{{ lookup(\'template\', source + \'/containerd-registry.yaml.j2\') }}"\n    dest: /etc/containerd/config.toml\n    owner: root\n    group: root\n    mode: \'0644\'\n    when: custom_registry_mirrors is defined and custom_registry_mirrors|length > 0 or custom_registry_config is defined and custom_registry_config|length > 0\n  notify:\n    restart containerd\n\n\n- name: Register etcd restore from file\n  set_fact:\n    etcd_restore_from_file: yes\n  when: (rke2_restore_etcd_from_file is defined and rke2_restore_etcd_from_file == true) and (snapshot_file is defined and snapshot_file|length > 0)\n\n\n- name: Register etcd restore from S3\n  set_fact:\n    etcd_restore_from_s3: yes\n  when: (rke2_restore_etcd_from_s3 is defined and rke2_restore_etcd_from_s3 == true) and (s3_options is defined and s3_options|length > 0 and (s3_region is defined and s3_region|length > 0) and (s3_bucket is defined and s3_bucket|length > 0))\n\n\n- name: Restore etcd from file\n  become: true\n  block:\n    - name: Create etcd directories\n      become: true\n      file:\n        path: "{{ item.path }}"\n        state: directory\n        owner: root\n        group: root\n        mode: \'0755\'\n      with_items:\n        - path: /var/lib/etcd\n        - path: /var/lib/etcd/data\n    - name: Copy etcd snapshot file\n      become: true\n      copy:\n        content: "{{ lookup(\'file\', snapshot_file) }}"\n        dest: /var/lib/etcd/data/etcd-snapshot-latest.db\n        owner: root\n        group: root\n        mode: \'0644\'\n    - name: Restore etcd from file\n      become: true\n      shell: "{{ rke2_restore_etcd_command }} /var/lib/etcd/data/etcd-snapshot-latest.db"\n      when: etcd_restore_from_file == yes\n  when: etcd_restore_from_file == yes\n\n\n- name: Restore etcd from S3\n  become: true\n  block:\n    - name: Copy etcd snapshot from S3\n      become: true\n      s3:\n        aws_access_key_id: "{{ s3_options.aws_access_key_id }}"\n        aws_secret_access_key: "{{ s3_options.aws_secret_access_key }}"\n        bucket: "{{ s3_bucket }}"\n        object: "{{ s3_options.object }}"\n        dest: /var/lib/etcd/data/etcd-snapshot-latest.db\n        mode: \'0644\'\n    - name: Restore etcd from S3\n      become: true\n      shell: "{{ rke2_restore_etcd_command }} /var/lib/etcd/data/etcd-snapshot-latest.db"\n      when: etcd_restore_from_s3 == yes\n  when: etcd_restore_from_s3 == yes\n\n\n- name: Start RKE2 service\n  become: true\n  service:\n    name: rke2\n    state: started\n    enabled: yes\n  notify:\n    restart RKE2\n  when: rke2_server_node_taints is defined and rke2_server_node_taints|length > 0\n\n\n- name: Mask RKE2 agent service\n  become: true\n  service:\n    name: rke2-agent\n    state: masked\n  when: rke2_server_node_taints is defined and rke2_server_node_taints|length > 0 and (rke2_node_role is defined and rke2_node_role == \'server\')\n\n\n- name: Wait for first server to be ready (no CNI)\n  become: true\n  wait_for:\n    host: "{{ groups.rke2_server[0] }}"\n    port: 22\n    timeout: 300\n    delay: 10\n    state: started\n    connect_timeout: 5\n    timeout_message: "Timed out waiting for first server node"\n    body: "status: \'ready\'"\n    body_format: json\n  when: rke2_node_role is defined and rke2_node_role == \'server\' and (rke2_cni is defined and rke2_cni == false)\n\n\n- name: Wait for first server to be ready (with CNI)\n  become: true\n  wait_for:\n    host: "{{ groups.rke2_server[0] }}"\n    port: 22\n    timeout: 300\n    delay: 10\n    state: started\n    connect_timeout: 5\n    timeout_message: "Timed out waiting for first server node"\n    body: "status: \'ready\'"\n    body_format: json\n  when: rke2_node_role is defined and rke2_node_role == \'server\' and (rke2_cni is defined and rke2_cni == true)\n\n\n- name: Restore etcd\n  become: true\n  block:\n    - name: Clean up old nodes\n      become: true\n      shell: "{{ rke2_restore_etcd_command }} --cleanup"\n    - name: Clean up old secrets\n      become: true\n      shell: "{{ rke2_restore_etcd_command }} --cleanup --secrets"\n    - name: Restore etcd data\n      become: true\n      shell: "{{ rke2_restore_etcd_command }} --data"\n  when: (etcd_restore_from_file == yes or etcd_restore_from_s3 == yes) and (rke2_node_role is defined and rke2_node_role == \'server\')\n\n\n- name: Set Active Server variable\n  set_fact:\n    active_server: "{{ groups.rke2_server[0] }}"\n  delegate_to: "{{ groups.rke2_server[0] }}"\n  delegate_facts: yes\n  when: rke2_node_role is defined and rke2_node_role == \'server\'' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-05T10:20:42.886807252Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13551154417, 'load_duration': 111319507, 'prompt_eval_count': 868, 'prompt_eval_duration': 144284282, 'eval_count': 1590, 'eval_duration': 13293859394, 'model_name': 'llama3.1:8b'} id='run--a40210