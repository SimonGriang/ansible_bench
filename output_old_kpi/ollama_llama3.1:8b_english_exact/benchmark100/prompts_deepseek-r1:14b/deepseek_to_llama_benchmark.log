---
- name: Configure Cron
  tasks:
  - name: Import assertion file
    assert:
      file: "{{ lookup('file', 'assert.yml') }}"
      state: present
    when: not ansible_check_mode

  - name: Install cron package
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ cron_packages }}"

  - name: Configure cron shell environment
    lineinfile:
      dest: /etc/crontab
      line: "SHELL=/bin/bash"
      state: present

  - name: Configure cron path environment
    lineinfile:
      dest: /etc/crontab
      line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      state: present

  - name: Configure cron mailto settings
    lineinfile:
      dest: /etc/crontab
      line: "MAILTO=root"
      state: present

  - name: Start and enable cron service
    service:
      name: "{{ cron_service }}"
      enabled: yes
      state: started
    when: cron_service is defined

  - name: Schedule cron jobs
    cron:
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      dayweek: "{{ item.dayweek }}"
      job: "{{ item.job }}"
    loop: "{{ cron_jobs }}"

