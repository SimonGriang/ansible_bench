```yaml
- name: Import assertion file
  ansible.builtin.assert:
    state: present
    msg: 'assert.yml not found'
    path: "/path/to/assert.yml"
    src: "{{ lookup('file', '/path/to/assert.yml') }}"
  run_once: true

- name: Install system requirements
  ansible.builtin.package:
    name: bash
    state: present

- name: Install OpenJDK Java
  ansible.builtin.package:
    name: "{{ java_vendor }}-java"
    state: present
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  ansible.builtin.copy:
    content: "{{ lookup('file', '/path/to/oracle-java.rpm') }}"
    dest: "/tmp/oracle-java.rpm"
    mode: '0644'
  notify: restart java
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java DEB from local
  ansible.builtin.copy:
    content: "{{ lookup('file', '/path/to/oracle-java.deb') }}"
    dest: "/tmp/oracle-java.deb"
    mode: '0644'
  notify: restart java
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  ansible.builtin.package:
    name: oracle-java
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  ansible.builtin.unarchive:
    src: "{{ lookup('file', '/path/to/oracle-java.targz') }}"
    dest: "{{ java_home }}"
    compression: tar.gz
  notify: restart java
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  ansible.builtin.package:
    name: java-{{ java_version }}-openjdk-jce-policy
    state: present
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set Java alternative
  ansible.builtin.file:
    src: "/usr/lib/jvm/java-{{ java_version }}-oracle/bin/java"
    dest: "/etc/alternatives/java"
    state: link
  when: java_format == "targz" and ansible_distribution not in ["Alpine"]

- name: Find Java home directory
  ansible.builtin.find:
    paths: /usr/bin/java
    file_type: link
  register: java_home

- name: Set JAVA_HOME in environment
  ansible.builtin.lineinfile:
    dest: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home.path }}"
    state: present
```


