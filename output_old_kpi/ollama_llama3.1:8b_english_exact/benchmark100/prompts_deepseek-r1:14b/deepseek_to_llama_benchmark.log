--- 

- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: cert_status

- name: Fail if Java certificates are missing
  fail:
    msg: "Missing Java certificate: {{ item.stat.path }}"
  loop: "{{ cert_status.results }}"
  when: not item.stat.exists

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "/path/to/legacy/keystore"

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "/path/to/new/keystore"
  when: ansible_java_version >= "11"

- name: Import SSL certificates into Java keystore
  java_key_store:
    src: "{{ item.src }}"
    dest: "{{ java_keystore_dir }}"
    keyalg: "{{ item.keyalg }}"
    keystore_properties: "{{ item.keystore_properties }}"
    state: present
  loop: "{{ java_certs | json_query('*.ssl_cert[*]') }}"

