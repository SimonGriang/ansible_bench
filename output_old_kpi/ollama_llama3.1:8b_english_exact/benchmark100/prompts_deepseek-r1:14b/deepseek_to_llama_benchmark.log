---
- name: Manage user account and SSH keys
  hosts: localhost
  become: true

  tasks:
  - name: Create local SSH key directory for user
    file:
      path: /home/{{ user }}/.ssh
      state: directory
      owner: {{ user }}
      group: {{ user }}
      mode: '0750'

  - name: Manage user account
    user:
      name: {{ user }}
      comment: User account for {{ user }}
      home: /home/{{ user }}
      shell: /bin/bash
      state: present

  - name: Set sudo options for user
    template:
      src: templates/sudoers.j2
      dest: /etc/sudoers.d/{{ user }}
      mode: '0644'

  - name: Generate private SSH key for user
    command: ssh-keygen -t rsa -N '' -f /home/{{ user }}/.ssh/{{ user }}_id_rsa

  - name: Generate public SSH key for user
    command: ssh-keygen -y -f /home/{{ user }}/.ssh/{{ user }}_id_rsa > /home/{{ user }}/.ssh/{{ user }}_id_rsa.pub

  - name: Convert SSH key to ppk format for user
    command: ssh-keygen -p -f /home/{{ user }}/.ssh/{{ user }}_id_rsa

  - name: Get or set the home directory for user
    set_fact:
      user_home: /home/{{ user }}

  - name: Create .ssh directory for user
    file:
      path: /home/{{ user }}/.ssh
      state: directory
      owner: {{ user }}
      group: {{ user }}
      mode: '0700'

  - name: Deploy authorized keys for user
    authorized_key:
      user: {{ user }}
      state: present
      key: "{{ lookup('file', '/home/{{ user }}/.ssh/{{ user }}_id_rsa.pub') }}"

  - name: Remove unauthorized keys for user
    authorized_key:
      user: {{ user }}
      state: absent
      key: "{{ item }}"
    loop: "{{ lookup('file', '/home/{{ user }}/.ssh/authorized_keys').split('\n') }}"
    when: item not in [lookup('file', '/home/{{ user }}/.ssh/{{ user }}_id_rsa.pub')]

  - name: Copy generated private SSH key for user
    copy:
      content: "{{ lookup('file', '/home/{{ user }}/.ssh/{{ user }}_id_rsa') }}"
      dest: /home/{{ user }}/.ssh/{{ user }}_id_rsa
      mode: '0600'

  - name: Check users password valid time for user
    shell: chage -l {{ user }}

  - name: Set users password valid time for user
    shell: chage -E {{ password_valid_time }} {{ user }}

  - name: Place private key file for user
    copy:
      content: "{{ lookup('file', '/home/{{ user }}/.ssh/{{ user }}_id_rsa') }}"
      dest: /home/{{ user }}/.ssh/{{ user }}_id_rsa
      mode: '0600'

