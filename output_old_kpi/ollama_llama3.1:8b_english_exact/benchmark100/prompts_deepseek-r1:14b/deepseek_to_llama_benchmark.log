---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec
  loop: "{{ mysql_packages }}"

- name: Configure mysql server
  template:
    src: "mysql-server.cnf.j2"
    dest: "/etc/mysql/my.cnf"
    mode: '0644'
  notify: Restart mysql server
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  template:
    src: "client.cnf.j2"
    dest: "/etc/mysql/client.cnf"
    mode: '0644'

- name: Initialize mysql
  command: "{{ item }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']
  loop:
    - mysql_install_db
    - mysql_upgrade

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: "my.cnf.j2"
    dest: "/etc/mysql/my.cnf"
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  when: mysql_databases is defined
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  when: mysql_users is defined
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers

