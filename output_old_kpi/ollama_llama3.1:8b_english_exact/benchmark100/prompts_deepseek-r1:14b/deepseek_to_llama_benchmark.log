---
- name: Configure GRUB on EFI and MBR systems
  hosts: localhost

  tasks:
  - name: Check if EFI firmware exists on the system
    stat:
      path: /sys/firmware/efi/efivars/
    register: efi_firmware

  - name: Remove GRUB configuration file on EFI systems
    file:
      path: /boot/grub2/grub.cfg
      state: absent
    when: efi_firmware.stat.exists

  - name: Install custom user template for GRUB
    template:
      src: 01_users.j2
      dest: /etc/grub.d/01_users
      mode: '0644'
    notify: grub-reconfigure

  - name: Add EFI password protection to GRUB
    lineinfile:
      dest: /etc/grub2-efi.cfg
      line: "password_pbkdf2 {{ efi_firmware.stat.exists | ternary('grub.pbkdf2.sha512.10000', '') }}"
      state: present
    when: efi_firmware.stat.exists

  - name: Add MBR password protection to GRUB
    lineinfile:
      dest: /etc/grub2.cfg
      line: "password_pbkdf2 grub.pbkdf2.sha512.10000"
      state: present
    when: not efi_firmware.stat.exists

  - name: Add unrestricted access to GRUB password entries
    lineinfile:
      dest: /etc/grub.d/40_custom
      line: "{{ item }}"
      state: present
      backrefs: yes
    with_items:
      - "set superusers='root'"
    when: grub_password_unrestricted is yes

