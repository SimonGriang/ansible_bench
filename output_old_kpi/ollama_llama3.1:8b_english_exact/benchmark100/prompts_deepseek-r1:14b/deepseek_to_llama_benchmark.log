--- 

- name: lookup bootstrap facts (raw)
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  untilansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('PRETTY_NAME=(.*?), VERSION_ID=(.*?),' | group(1) }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('PRETTY_NAME=(.*?), VERSION_ID=(.*?),' | group(2) }}"
  when: bootstrap_distribution is not undefined
  become: "{{ bootstrap_user | bool }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map[bootstrap_distribution] }}"
  when: bootstrap_distribution is not undefined
  become: "{{ bootstrap_user | bool }}"

