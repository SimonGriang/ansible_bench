55, 'prompt_eval_count': 415, 'prompt_eval_duration': 29351903, 'eval_count': 410, 'eval_duration': 4435769868, 'model_name': 'llama3.1:8b'} id='run--7f7be481-e951-4089-b225-9a20c541b1b0-0' usage_metadata={'input_tokens': 415, 'output_tokens': 410, 'total_tokens': 825}
