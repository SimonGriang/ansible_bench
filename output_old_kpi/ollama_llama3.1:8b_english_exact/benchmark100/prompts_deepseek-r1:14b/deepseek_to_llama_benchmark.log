---
- name: Bootstrap tasks
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port }}"
      timeout: "{{ bootstrap_timeout }}"
    when: not ansible_connection.connection_type in ['container', 'docker', 'community.docker.docker']

  - name: Prepare system
    connection: local
    become: true
    tasks:
    - name: Test connection
      ping:
        timeout: "{{ bootstrap_timeout }}"
    - name: Test sudo version
      setup:
        become: true
    - name: Rescue
      rescue:
        tasks:
        - name: Gather facts
          setup:
            gather_facts: true
        - name: Install bootstrap packages
          apt:
            name: "{{ item }}"
            state: present
          loop: "{{ bootstrap_facts_packages }}"
          when: bootstrap_become

  - name: Gather ansible facts
    setup:
      gather_facts: true
      become: false

  - name: Install bootstrap packages
    apt:
      name: "{{ item }}"
      state: present
    loop: "{{ bootstrap_facts_packages }}"
    when: bootstrap_become

