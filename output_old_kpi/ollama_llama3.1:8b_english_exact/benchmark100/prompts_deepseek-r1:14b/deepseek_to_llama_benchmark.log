- name: Import assert.yml
  include_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix/mailname
    value: '{{ postfix_mailname }}'
    set_seemed_safe: yes
    template: 'pam'
  when: ansible_distribution == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_mysql is defined

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
    mode: '0644'
  notify: postfix reload

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify: postfix reload

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_recipient_access: '{{ postfix_recipient_access | default("") }}'
    postfix_sender_access: '{{ postfix_sender_access | default("") }}'

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: '{{ postfix_mynetworks | default("") }}'
    postfix_mydestination: '{{ postfix_mydestination | default("") }}'
    postfix_relay_domains: '{{ postfix_relay_domains | default("") }}'

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify: postfix reload

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify: postfix reload

- name: Creates cert/key directory
  file:
    path: /etc/ssl/private/postfix
    state: directory
    mode: '0750'
  when: postfix_tls is defined

- name: Deploy Postfix TLS server certificate
  copy:
    content: '{{ postfix_tls_cert | force_quote }}'
    dest: /etc/ssl/private/postfix/{{ postfix_tls_cert | basename }}
    mode: '0644'
  notify: postfix reload
  when: postfix_tls is defined

- name: Deploy Postfix TLS server key
  copy:
    content: '{{ postfix_tls_key | force_quote }}'
    dest: /etc/ssl/private/postfix/{{ postfix_tls_key | basename }}
    mode: '0600'
  notify: postfix reload
  when: postfix_tls is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    dest: /etc/aliases
    line: '{{ item }}'
    state: present
  with_items: '{{ postfix_aliases | default([]) }}'
  notify: postfix rebuild
  notify: postfix reload

- name: Configure sender_access
  lineinfile:
    dest: /etc/postfix/access
    line: '{{ item }}'
    state: present
  with_items: '{{ postfix_sender_access | default([]) }}'
  notify: postfix rebuild
  notify: postfix reload

- name: Configure recipient_access
  lineinfile:
    dest: /etc/postfix/access
    line: '{{ item }}'
    state: present
  with_items: '{{ postfix_recipient_access | default([]) }}'
  notify: postfix rebuild
  notify: postfix reload

- name: Place sasl_password_map
  copy:
    content: '{{ postfix_sasl_password_map | force_quote }}'
    dest: /etc/postfix/sasldb.txt
    mode: '0644'
  notify: postfix rebuild
  when: postfix_sasl_password_map is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

