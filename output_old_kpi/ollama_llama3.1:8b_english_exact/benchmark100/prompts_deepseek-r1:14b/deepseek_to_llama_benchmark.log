---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rancher/rke2/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: templates/kube-vip.conf.j2
    dest: /etc/rancher/rke2/manifests/kube-vip.conf
    mode: '0644'
    owner: root
    group: root

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: templates/kube-vip-lb.yml.j2
    dest: /etc/rancher/rke2/manifests/kube-vip-lb.yml
    mode: '0644'
    owner: root
    group: root
  when: "'rancher_kube_vip' in group_names"


