- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Manage automatic service management
  block:
    - name: Set apt_autostart_state to "disabled" and copy policy-rc.d file when apt_autostart_state is "disabled"
      copy:
        content: "exit 101"
        dest: /usr/sbin/policy-rc.d
        mode: '0755'
      when: apt_autostart_state == "disabled"

    - name: Remove policy-rc.d file when apt_autostart_state is "enabled"
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == "enabled"

