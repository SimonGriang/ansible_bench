content='---\n\n\n---\n\n- name: Install Keepalived service when High Availability (HA) mode is enabled and specific conditions are met.\n  block:\n    - name: Install keepalived package\n      apt:\n        name: keepalived\n        state: present\n      when: ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n    - name: Start and enable keepalived service\n      service:\n        name: keepalived\n        state: started\n        enabled: yes\n      when: ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Download and install RKE2\n  block:\n    - name: Download rke2 binary\n      get_url:\n        url: https://github.com/rancher/rke/releases/download/v{{ rke2_version }}/rke2_{{ rke2_version }}_linux_amd64\n        dest: /tmp/rke2\n        mode: \'0755\'\n      when: rke2_enabled\n\n    - name: Install rke2 binary\n      copy:\n        src: /tmp/rke2\n        dest: /usr/local/bin/rke2\n        mode: \'0755\'\n      when: rke2_enabled\n\n\n---\n\n- name: CIS hardening\n  block:\n    - name: Install CIS profile\n      apt:\n        name: cis-profile\n        state: present\n      when: cis_profile_defined\n\n    - name: Run CIS hardening\n      cis:\n        name: cis-profile\n      when: cis_profile_defined\n\n\n---\n\n- name: Find active server\n  block:\n    - name: Get active server from etcd\n      shell: etcdctl --endpoints={{ etcd_endpoints }} get /registry/server/active\n      register: active_server\n      when: etcd_enabled\n\n\n---\n\n- name: Enable IPVS kernel module\n  block:\n    - name: Enable ipvs kernel module\n      modprobe:\n        name: ip_vs\n        state: present\n      when: ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Copy kube-vip manifests\n  block:\n    - name: Copy kube-vip manifests to master node\n      copy:\n        content: "{{ lookup(\'template\', \'kube-vip.yaml\') }}"\n        dest: /etc/kubernetes/kube-vip.yaml\n      when: ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Copy ingress-nginx manifests\n  block:\n    - name: Copy ingress-nginx manifests to master node\n      copy:\n        content: "{{ lookup(\'template\', \'ingress-nginx.yaml\') }}"\n        dest: /etc/kubernetes/ingress-nginx.yaml\n      when: ingress_nginx_values_enabled\n\n\n---\n\n- name: Prepare first server node\n  block:\n    - name: Prepare first server node\n      shell: rke2 init --etcd-endpoints={{ etcd_endpoints }} --etcd-ca-cert={{ etcd_ca_cert }} --etcd-cert={{ etcd_cert }} --etcd-key={{ etcd_key }} --cluster-name={{ cluster_name }} --cluster-ca-cert={{ cluster_ca_cert }} --cluster-cert={{ cluster_cert }} --cluster-key={{ cluster_key }}\n      when: etcd_enabled and active_server == inventory_hostname and ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Etcd restore\n  block:\n    - name: Run etcd restore\n      shell: rke2 etcd restore --etcd-endpoints={{ etcd_endpoints }} --etcd-ca-cert={{ etcd_ca_cert }} --etcd-cert={{ etcd_cert }} --etcd-key={{ etcd_key }} --cluster-name={{ cluster_name }} --cluster-ca-cert={{ cluster_ca_cert }} --cluster-cert={{ cluster_cert }} --cluster-key={{ cluster_key }}\n      when: etcd_enabled and ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Download kubeconfig\n  block:\n    - name: Download kubeconfig\n      get_url:\n        url: https://{{ cluster_name }}.{{ cluster_domain }}:6443/api/v1/namespaces/kube-system/secrets/default-kubeconfig\n        dest: /etc/kubernetes/kubeconfig\n        mode: \'0600\'\n      when: kubeconfig_enabled\n\n\n---\n\n- name: Join remaining nodes\n  block:\n    - name: Join remaining nodes\n      shell: rke2 join --etcd-endpoints={{ etcd_endpoints }} --etcd-ca-cert={{ etcd_ca_cert }} --etcd-cert={{ etcd_cert }} --etcd-key={{ etcd_key }} --cluster-name={{ cluster_name }} --cluster-ca-cert={{ cluster_ca_cert }} --cluster-cert={{ cluster_cert }} --cluster-key={{ cluster_key }} {{ inventory_hostname }}\n      when: etcd_enabled and active_server != inventory_hostname and ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Rolling restart servers\n  block:\n    - name: Rolling restart servers\n      shell: rke2 rolling restart\n      when: rke2_enabled and ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Rolling restart agents\n  block:\n    - name: Rolling restart agents\n      shell: rke2 rolling restart agents\n      when: rke2_enabled and ha_mode_enabled and (ha_enabled or ha_mode_enabled)\n\n\n---\n\n- name: Flush handlers\n  meta:\n    flush_handlers: yes\n\n\n---\n\n- name: Rolling restart when config changes\n  block:\n    - name: Rolling restart when config changes\n      shell: rke2 rolling restart\n      when: rke2_enabled and ha_mode_enabled and (ha_enabled or ha_mode_enabled) and config_changed\n\n\n---\n\n- name: Final steps\n  block:\n    - name: Print summary\n      debug:\n        msg: "Cluster setup completed successfully."\n    - name: Save current state\n      shell: rke2 save-state\n\n\n---\n\nNote: The above playbook is a direct result of the given tasks and their descriptions. It is structured and formatted according to the provided instructions and ensures the tasks are included in the correct order.' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-05T10:39:59.667471146Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13128270355, 'load_duration': 2308221575, 'prompt_eval_count': 720, 'prompt_eval_duration': 348298812, 'eval_count': 1267, 'eval_duration': 10470972250, 'model_name': 'llama3.1:8b'} id='run--2bd74ef6-fa9e-4a87-a65c-50c912dc52d2-0' usage_metadata={'input_tokens': 720, 'output_tokens': 1267, 'total_tokens': 1987}
