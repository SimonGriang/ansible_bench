content='---\n\n\n---\n- name: Download RKE2 installation script\n  get_url:\n    url: \'https://raw.githubusercontent.com/rancher/rke2/main/install.sh\'\n    dest: \'/tmp/rke2_install.sh\'\n    mode: \'0700\'\n  when: not airgap\n\n- name: Copy local RKE2 installation script\n  copy:\n    src: \'{{ playbook_dir }}/files/rke2_install.sh\'\n    dest: \'/tmp/rke2_install.sh\'\n    mode: \'0700\'\n  when: airgap and playbook_dir != \'/tmp\'\n\n- name: Create RKE2 artifacts folder\n  file:\n    path: \'/usr/local/rke2/artifacts\'\n    state: directory\n    mode: \'0700\'\n  when: airgap and not uses_exists_implementation\n\n- name: Download RKE2 checksum and artifacts\n  get_url:\n    url: \'https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2-{{ rke2_version }}.tar.gz\'\n    dest: \'/tmp/rke2-artifacts.tar.gz\'\n    checksum: \'sha256={{ rke2_checksum }}\'\n  when: remote_download\n\n  get_url:\n    url: \'https://example.com/rke2-artifacts.tar.gz\'\n    dest: \'/tmp/rke2-artifacts.tar.gz\'\n    mode: \'0600\'\n  when: not remote_download\n\n- name: Copy local RKE2 artifacts\n  copy:\n    src: \'{{ playbook_dir }}/files/rke2-artifacts.tar.gz\'\n    dest: \'/tmp/rke2-artifacts.tar.gz\'\n    mode: \'0640\'\n  when: airgap and uses_copy_implementation\n\n- name: Airgap mode - additional images tarballs\n  file:\n    path: \'/usr/local/rke2/additional-images\'\n    state: directory\n  when: airgap and additional_images\n\n  copy:\n    src: \'{{ playbook_dir }}/files/rke2-additional-images.tar.gz\'\n    dest: \'/usr/local/rke2/additional-images.tar.gz\'\n    mode: \'0640\'\n  when: airgap and additional_images\n\n- name: Airgap mode - ensure artifacts exist and have acceptable permissions\n  file:\n    path: \'/usr/local/rke2/artifacts\'\n    state: directory\n    mode: \'0700\'\n  when: airgap and uses_exists_implementation\n\n  file:\n    path: \'/usr/local/rke2/artifacts\'\n    state: directory\n    mode: \'0700\'\n  when: airgap and not uses_exists_implementation\n\n- name: Populate service facts\n  setup:\n    filter:\n      - name: rke2_service_facts\n\n- name: Get stats of the FS object\n  shell:\n    cmd: \'df --output=avail /usr/local\'\n  register: rke2_fs_stats\n\n- name: Set RKE2 bin path\n  set_fact:\n    rke2_bin_path: \'/usr/local/bin/rke2\'\n  when: rke2_fs_stats.stats[0].free > 0\n\n- name: Check RKE2 version\n  shell:\n    cmd: \'rke2 version\'\n  register: rke2_version_output\n\n- name: Prevent accidental RKE2 downgrade\n  assert:\n    that: \'rke2_version_output.stdout|regex_search("{{ rke2_version }}")\'\n  when: not downgrade_allowed\n\n- name: Run RKE2 install script\n  shell:\n    cmd: \'bash /tmp/rke2_install.sh\'\n  when: not airgap\n\n  shell:\n    cmd: \'bash /tmp/rke2_install.sh\'\n    environment:\n      RKE2_AIRGAP_MODE: \'1\'\n  when: airgap\n\n- name: Copy Custom Manifests\n  template:\n    src: \'{{ playbook_dir }}/files/rke2-custom-manifests.j2\'\n    dest: \'/usr/local/rke2/manifests/{{ rke2_version }}\'\n    mode: \'0644\'\n\n- name: Copy Static Pods\n  template:\n    src: \'{{ playbook_dir }}/files/rke2-static-pods.j2\'\n    dest: \'/usr/local/rke2/agent-pod-manifests/{{ rke2_version }}\'\n    mode: \'0644\'\n\n- name: Copy RKE2 environment file\n  template:\n    src: \'{{ playbook_dir }}/files/rke2-env.j2\'\n    dest: \'/usr/local/rke2/env\'\n    mode: \'0644\'\n  when: environment_options is defined' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-05T10:19:41.53672816Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10363260435, 'load_duration': 2243717161, 'prompt_eval_count': 876, 'prompt_eval_duration': 327258450, 'eval_count': 957, 'eval_duration': 7791364479, 'model_name': 'llama3.1:8b'} id='run--b4c70d9e-b3b3-4207-8661-3c0cc551ac4a-0' usage_metadata={'input_tokens': 876, 'output_tokens': 957, 'total_tokens': 1833}
