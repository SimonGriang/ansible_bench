---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify:
    - Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  notify:
    - Reboot
  when: selinux_booleans is defined
  block:
    - name: Configure selinux booleans
      seboolean:
        present: true
        name: "{{ item }}"
      loop: "{{ selinux_booleans }}"

- name: Configure selinux booleans
  seboolean:
    present: true
    name: "{{ item }}"
  loop: "{{ selinux_booleans }}"


