---
- name: MySQL Database Tasks
  tasks:
  - name: Import assertion tasks
    include_tasks: assert.yml

  - name: Install MySQL
    apt:
      name: "{{ packages }}"
      state: present
    notify:
      - mysql_root_password
      - systemctl_daemon_reexecution

  - name: Configure MySQL server
    template:
      src: mysql-server.conf.j2
      dest: /etc/mysql/mysql.conf.d/mysqld.cnf
      mode: '0644'
    notify:
      - mysql_server_restart

  - name: Configure MySQL client
    template:
      src: mysql-client.conf.j2
      dest: /etc/mysql/mysql.conf.d/client.cnf
      mode: '0644'

  - name: Initialize MySQL
    command: "{{ item.initialization_command }}"
    args:
      chdir: /var/lib/mysql
    when: (ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux') and (initial_import is False)
    loop:
      - "/usr/bin/mysql_install_db"
      - "/usr/bin/mysqld_safe --skip-networking &"

  - name: Start and enable MySQL
    service:
      name: "{{ service_name }}"
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: /etc/mysql/my.cnf
      mode: '0644'

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
      db: "{{ item }}"
    loop: "{{ databases }}"
    when: (initial_import is False)

  - name: List databases
    mysql_db_info:
      databases: all
    register: db_info

  - name: Import database
    mysql_db:
      name: "{{ item }}"
      state: import
      db: "{{ item }}"
      src: "{{ initial_import }}"
    loop: "{{ databases }}"
    when: (initial_import is not False)

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      host: "{{ item.host }}"
      priv: "{{ item.priv }}"
      state: present
    loop: "{{ users }}"
    notify:
      - mysql_server_restart

  - name: Flush handlers again
    meta: flush_handlers

