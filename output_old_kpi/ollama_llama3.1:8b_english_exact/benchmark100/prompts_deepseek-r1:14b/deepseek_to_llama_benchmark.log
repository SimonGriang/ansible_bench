arted and enabled\n  when:\n    - docker_service_manage is true\n  service:\n    name: docker\n    state: "{{ service_state }}"\n    enabled: "{{ service_enabled }}"\n  ignore_errors: true\n\n- name: Flush handlers to avoid firewall conflicts\n  meta:\n    flush_handlers: true\n\n- name: Include docker-compose.yml tasks\n  include_tasks:\n    file: docker-compose.yml\n  when:\n    - docker_install_compose is true\n\n- name: Get docker group information\n  when:\n    - users_to_add is defined\n  shell:\n    cmd: getent group docker\n  register: docker_group_info\n\n- name: Set fact for user modification\n  when:\n    - users_to_add is defined\n    - docker_group_info is not defined or docker_group_info is changed\n  set_fact:\n    users_to_modify: true\n\n- name: Include docker-users.yml tasks\n  include_tasks:\n    file: docker-users.yml\n  when:\n    - users_to_modify is true\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-05T09:22:31.429815839Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6936201739, 'load_duration': 90729422, 'prompt_eval_count': 1658, 'prompt_eval_duration': 417911508, 'eval_count': 684, 'eval_duration': 6426539689, 'model_name': 'llama3.1:8b'} id='run--33e10a58-9253-4ad8-852f-42c5a9d74cae-0' usage_metadata={'input_tokens': 1658, 'output_tokens': 684, 'total_tokens': 2342}
