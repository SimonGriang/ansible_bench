---
- name: Bootstrap Role
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Wait for port to be available
    wait_for:
      host: localhost
      port: 8080
      timeout: "{{ bootstrap_timeout }}"
    connection: local

  - name: Prepare system
    block:
      - name: Test connection
        ping:
          enabled: True
      - name: Test sudo access
        become: yes
        become_method: sudo
        become_user: root
      - name: Gather facts
        setup:
          filter: 'ansible_all_*'
      - name: Install necessary packages
        raw: |
          {%- if ansible_distribution == 'RedHat' %}
          dnf install -y libdnf5
          {%- endif %}
          {{ bootstrap_raw_packages }}
    rescue:
      - name: Install necessary packages
        raw: |
          {%- if ansible_distribution == 'RedHat' %}
          dnf install -y libdnf5
          {%- endif %}
          {{ bootstrap_raw_packages }}

  - name: Gather ansible facts
    setup:
      filter: 'ansible_*'

  - name: Install bootstrap packages (package)
    package:
      name: "{{ item }}"
      state: present
      become: "{{ bootstrap_become }}"
    loop: "{{ bootstrap_facts_packages }}"


