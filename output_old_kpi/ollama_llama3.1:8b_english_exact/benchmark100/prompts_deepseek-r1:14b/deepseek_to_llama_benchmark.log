---
- name: OpenVPN client configuration tasks
  become: true
  vars:
    openvpn_group: openvpn_group
  tasks:
  - name: Create the OpenVPN client configuration directory
    file:
      path: /etc/openvpn/client
      owner: root
      group: "{{ openvpn_group }}"
      mode: '0750'
  - name: Place the OpenVPN client configuration file
    template:
      src: client.conf.j2
      dest: /etc/openvpn/client/client.conf
      owner: root
      group: "{{ openvpn_group }}"
      mode: '0640'
    notify:
      - Restart openvpn

