- name: Task 1: Import assertion file
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2: Enable Redis module stream for RHEL 8
  package:
    name: redis-{{ ansible_distribution_version }}
    state: present
