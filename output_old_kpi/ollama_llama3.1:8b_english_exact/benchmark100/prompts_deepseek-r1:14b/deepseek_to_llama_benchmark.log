---
- name: Enable modules
  become: yes
  apt:
    name: apache2
    state: present
  when: ansible_distribution in ["Debian", "Ubuntu"]
  notify: apache2 restart

- name: Enable modules
  become: yes
  zypper:
    name: apache2
    state: present
  when: ansible_distribution in ["SLES", "SUSE"]
  notify: apache2 restart

- name: Configure locations
  become: yes
  template:
    src: templates/location.j2
    dest: /etc/apache2/conf.d/{{ item.location }}
    mode: '0644'
  with_items: "{{ httpd_locations }}"
  notify:
    - httpd-foreground
    - httpd-testconfig

