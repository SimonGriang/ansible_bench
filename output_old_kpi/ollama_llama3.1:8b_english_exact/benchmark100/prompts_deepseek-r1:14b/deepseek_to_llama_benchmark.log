---
- name: Generate an OpenSSL private key
  become: yes
  become_user: root
  become_method: sudo
  openssl_private_key:
    path: /path/to/key_directory/private_key.key
    key_type: rsa
    key_length: 2048
    key_usage: digitalSignature, keyEncipherment
    subjectAltName: DNS=example.com
    state: present
    mode: '0640'
    owner: your_username
    group: your_username

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  become: yes
  become_user: root
  become_method: sudo
  openssl_csr:
    path: /path/to/CSR_directory/CSR.csr
    private_key: /path/to/key_directory/private_key.key
    common_name: example.com
    organization_name: Example Organization
    organizational_unit_name: Example Unit
    state: present
    mode: '0644'
    owner: your_username
    group: your_username

- name: Generate an OpenSSL X.509 certificate
  become: yes
  become_user: root
  become_method: sudo
  openssl_certificate:
    path: /path/to/certificate_directory/certificate.crt
    csr: /path/to/CSR_directory/CSR.csr
    private_key: /path/to/key_directory/private_key.key
    state: present
    mode: '0644'
    owner: your_username
    group: your_username

- name: Generate a PKCS#12 file
  become: yes
  become_user: root
  become_method: sudo
  openssl_pkcs12:
    path: /path/to/key_directory/pkcs12.p12
    privatekey: /path/to/key_directory/private_key.key
    certificate: /path/to/certificate_directory/certificate.crt
    friendly_name: example
    algorithm: sha256
    state: present
    mode: '0644'
    owner: your_username
    group: your_username

- name: Read private key content
  become: yes
  become_user: root
  become_method: sudo
  slurp:
    src: /path/to/key_directory/private_key.key
    dest: /path/to/key_directory/private_key.txt
    state: present

- name: Read certificate content
  become: yes
  become_user: root
  become_method: sudo
  slurp:
    src: /path/to/certificate_directory/certificate.crt
    dest: /path/to/certificate_directory/certificate.txt
    state: present

- name: Create a combined private key and certificate file
  become: yes
  become_user: root
  become_method: sudo
  copy:
    content: |
      {{ lookup('file', '/path/to/key_directory/private_key.txt') }}
      {{ lookup('file', '/path/to/certificate_directory/certificate.txt') }}
    dest: /path/to/key_directory/combined_key_and_certificate.txt
    mode: '0644'
    owner: your_username
    group: your_username


