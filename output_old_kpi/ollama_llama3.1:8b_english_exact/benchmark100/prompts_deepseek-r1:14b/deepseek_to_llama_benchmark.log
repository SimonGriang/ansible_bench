---
- name: cadvisor tasks
  hosts: localhost

  tasks:
  - name: cadvisor | create directories
    file:
      path: /usr/local/bin/cadvisor
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: cadvisor | download
    get_url:
      url: 'https://github.com/google/cadvisor/releases/download/{{ cAdvisorVersion }}/cadvisor'
      dest: /usr/local/bin/cadvisor
      checksum: sha256:{{ cAdvisorChecksum }}

  - name: cadadvisor | propagate locally distributed cadvisor binary
    copy:
      src: /usr/local/bin/cadvisor
      dest: /usr/local/bin/cadvisor
      mode: '0755'
    notify: restart cadvisor

  - name: cadvisor | symlink
    file:
      path: /usr/local/bin/cadvisor
      state: link
      target: /usr/local/bin/cadvisor

  - name: cadvisor | server systemd service
    template:
      src: templates/cadvisor.service.j2
      dest: /etc/systemd/system/cadvisor.service
      mode: '0644'

  - name: test_task
