ion': 4406017044, 'model_name': 'llama3.1:8b'} id='run--fa36a345-23dc-460c-bdef-04e5c285c325-0' usage_metadata={'input_tokens': 720, 'output_tokens': 431, 'total_tokens': 1151} 46%|████▌     | 46/100 [44:58<29:52, 33.20s/it]
