---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    policy: targeted
    state: enabled
  when: selinux_enabled
  notify:
    - selinux_configured
  handlers:
    - name: selinux_configured
      selinux:
        state: enabled

- name: Configure httpd
  template:
    src: "{{ source }}/{{ source_name }}"
    dest: "{{ dest }}"
    mode: '0644'
  notify:
    - httpd_configured
    - httpd_service_restart

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  when: ansible_distribution == 'Debian'
  loop: "{{ httpd_modules }}"

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: ssl_enabled

- name: Import locations.yml
  include_tasks: locations.yml
  when: locations_defined

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: vhosts_defined

- name: Configure ports
  template:
    src: "{{ source }}/{{ source_name }}"
    dest: "{{ dest }}"
    mode: '0644'
  notify:
    - httpd_configured
    - httpd_service_restart
  when: ansible_distribution in ['Debian', 'Suse']

- name: Import directories.yml
  include_tasks: directories.yml
  when: directories_defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: yes


