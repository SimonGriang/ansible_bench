content='---\n\n\n---\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Install dns\n  package:\n    name: "{{ dns_packages }}"\n    state: present\n\n- name: Create directories\n  file:\n    path: "{{ item.path }}"\n    mode: "{{ item.mode }}"\n    owner: "{{ item.owner }}"\n    group: "{{ item.group }}"\n  loop:\n    - path=/var/named/{{ dns_zone }}\n      mode=0755\n      owner=named\n      group=named\n    - path=/etc/named.conf.d\n      mode=0755\n      owner=named\n      group=named\n\n- name: Create group\n  group:\n    name: "{{ dns_group }}"\n    state: present\n\n- name: Create user\n  user:\n    name: "{{ dns_owner }}"\n    system: yes\n    state: present\n\n- name: Generate rndc key\n  command: rndc-keygen -a -r /dev/urandom -n 32 -o /etc/rndc.key\n\n- name: Set permissions on rndc key file\n  file:\n    path: /etc/rndc.key\n    mode: \'0644\'\n    owner: root\n    group: root\n\n- name: Get the hints/root file\n  get_url:\n    url: "https://www.internic.net/domain/named.root"\n    dest: /var/named/chroot/etc/named.root\n    mode: \'0644\'\n  when: dns_caching_dns\n\n- name: Create zone file\n  template:\n    src: templates/{{ item.name }}.j2\n    dest: /var/named/chroot/etc/named/{{ item.name }}\n    mode: \'0644\'\n    owner: named\n    group: named\n  loop:\n    - name={{ dns_zone }}.conf\n      validate: /bin/echo \'{{ item.name }}\' > {{ item.name }}\n  notify: Rndc reload\n\n- name: Add zones to configuration\n  template:\n    src: templates/named.conf.j2\n    dest: /etc/named.conf\n    mode: \'0644\'\n    owner: root\n    group: named\n  notify: Restart dns\n\n- name: Place systemd override\n  template:\n    src: templates/override.conf.j2\n    dest: /etc/systemd/system/named.service.d/override.conf\n    mode: \'0644\'\n    owner: root\n    group: root\n  when: using_systemd\n\n- name: Start and enable dns\n  service:\n    name: named\n    state: started\n    enabled: yes' additional_k