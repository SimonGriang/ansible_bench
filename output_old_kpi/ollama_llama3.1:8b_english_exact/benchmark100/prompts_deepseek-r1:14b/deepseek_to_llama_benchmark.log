    gather_facts:
      gather_subset: ['os-release']

  - name: Set distribution name and major version
    set_fact:
      distribution: "{{ ansible_distribution | default('Unknown') }}"
      major_version: "{{ ansible_distribution_major_version | default('Unknown') }}"

  - name: Map distribution to OS family
    set_fact:
      os_family: "{{ distribution_map[ distribution ] | default('Unknown') }}"
    vars:
      distribution_map:
        Ubuntu: 'Debian'
        Debian: 'Debian'
        CentOS: 'RedHat'
        RedHat: 'RedHat'
        Fedora: 'RedHat'
        AlmaLinux: 'RedHat'
        Amazon: 'RedHat'


