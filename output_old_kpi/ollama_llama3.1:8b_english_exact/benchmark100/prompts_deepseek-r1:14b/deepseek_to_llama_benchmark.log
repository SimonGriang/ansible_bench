    state: present

- name: Configure SELinux settings
  selinux:
    policy: targeted
    state: enabled
  when: selinux_enabled == true

- name: Set SELinux boolean settings
  selinux:
    allow_httpd_anon_write: true
    allow_httpd_mod_auth_pam: true
    allow_httpd_mod_auth_zap: true
  when: httpd_sebooleans is defined

- name: Allow connections on specified ports
  selinux:
    port: "{{ httpd_port }}"
    state: allowed
  when: httpd_port is defined

- name: Allow connections on specified SSL port
  selinux:
    port: "{{ httpd_ssl_port }}"
    state: allowed
  when: httpd_ssl_port is defined

- name: Configure Apache HTTPD
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - httpd configuration test
    - httpd service restart

- name: Activate Apache HTTPD modules (Debian)
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_distribution == "Debian"

- name: Import SSL configuration tasks
  import_tasks: ssl.yml
  when: https_ssl_enable == true

- name: Import locations configuration tasks
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts configuration tasks
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure Apache HTTPD ports (Debian and Suse)
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - httpd configuration test
    - httpd service restart
  when: ansible_distribution == "Debian" or ansible_distribution == "Suse"

- name: Import directories configuration tasks
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush all registered handlers
  meta: flush_handlers

- name: Remove default HTML file
  file:
    path: "{{ httpd_data_directory }}/{{ httpd_remove_example_file }}"
    state: absent
  when: httpd_remove_example == true

- name: Start and enable Apache HTTPD service
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


