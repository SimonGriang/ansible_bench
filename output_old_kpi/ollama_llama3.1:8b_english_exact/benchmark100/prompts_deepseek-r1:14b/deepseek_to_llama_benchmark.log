---
- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    state: present
    system: yes

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    create_home: no
    append: yes
    system: yes

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'

- name: Create application directories
  file:
    path: /var/log/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
  get_url:
    url: 'https://example.com/promtail.zip'
    dest: /tmp/promtail.zip
    checksum: 'sha256:1234567890abcdef'

- name: Propagate local promtail binaries
  copy:
    src: /tmp/promtail.zip
    dest: /usr/local/bin/promtail.zip

- name: Download promtail binaries for controller node
  get_url:
    url: 'https://example.com/promtail-controller.zip'
    dest: /tmp/promtail-controller.zip
    checksum: 'sha256:fedcba9876543210'

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail-controller.zip
    dest: /usr/local/bin/promtail-controller.zip

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/bin/promtail.zip
    dest: /usr/local/bin
    compression: zip

- name: Create symlink to latest promtail version
  file:
    path: /usr/local/bin/promtail
    state: link
    linkname: /usr/local/bin/promtail-latest
  notify: restart promtail

- name: Write promtail config file
  template:
    src: templates/promtail.conf.j2
    dest: /etc/promtail/promtail.conf
    owner: promtail
    group: promtail
    mode: '0644'

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail



