---
- name: Package Management
  tasks:
    - name: Import tasks from assert.yml
      include_tasks: assert.yml
      delegate_to: localhost

    - name: Configure apk
      package:
        name: '*'
        state: latest
      always_run: yes

    - name: Configure apt
      apt:
        upgrade: 'no'
        update_cache: yes
        cache_valid_time: 3600

    - name: Update all software (dnf)
      dnf:
        update_cache: yes
        cache_expires: 7200
        exclude: kernel*

    - name: Update all software (pacman)
      pacman:
        update_cache: yes
        refresh: yes

    - name: Configure yum
      when: ansible_distribution == 'CentOS' or ansible_distribution == 'RedHat'
      block:
        - name: Update all software using dnf for yum on CentOS/RHEL 6
          dnf:
            update_cache: yes
            cache_expires: 7200
        - name: Handle non-6 cases by using yum and installing yum-utils
          yum:
            name: yum-utils
            state: present
      when: ansible_distribution != 'CentOS' and ansible_distribution != 'RedHat'

    - name: Update all software (zypper)
      zypper:
        update: yes
        refresh: yes

