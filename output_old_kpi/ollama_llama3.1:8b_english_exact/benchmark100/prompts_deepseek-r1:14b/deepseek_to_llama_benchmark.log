  notify:
    - restart docker

- name: Install Docker packages with downgrade option
  when:
    - ansible_version.major >= 2
    - ansible_os_family in ['RedHat', 'Debian']
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    auto_update: true
  notify:
    - restart docker

- name: Install docker-compose plugin
  when:
    - docker_install_compose_plugin is true
    - not ansible_version.major >= 2
    - not ansible_os_family in ['RedHat', 'Debian']
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify:
    - restart docker

- name: Install docker-compose-plugin with downgrade option
  when:
    - docker_install_compose_plugin is true
    - ansible_version.major >= 2
    - ansible_os_family in ['RedHat', 'Debian']
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    auto_update: true
  notify:
    - restart docker

- name: Ensure /etc/docker directory exists
  when:
    - docker_daemon_options is defined
  file:
    path: /etc/docker
    state: directory
    mode: '0755'

- name: Configure Docker daemon options
  when:
    - docker_daemon_options is defined
  template:
    src: docker-daemon-options.j2
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify:
    - restart docker

- name: Ensure Docker service is started and enabled
  when:
    - docker_service_manage is true
  service:
    name: docker
    state: "{{ service_state }}"
    enabled: "{{ service_enabled }}"

- name: Flush handlers to avoid firewall conflicts
  meta:
    flush_handlers: true

- name: Include docker-compose.yml tasks
  include_tasks:
    file: docker-compose.yml
  when:
    - docker_install_compose is true

- name: Get docker group information
  ansible.builtin.getent:
    name: docker
  register: docker_group_info
  when:
    - users_to_add is defined

- name: Set fact for user modification
  ansible.builtin.set_fact:
    users_to_modify: true
  when:
    - users_to_add is defined
    - (docker_group_info is not defined or docker_group_info is changed)

- name: Include docker-users.yml tasks
  include_tasks:
    file: docker-users.yml
  when:
    - users_to_modify is true


