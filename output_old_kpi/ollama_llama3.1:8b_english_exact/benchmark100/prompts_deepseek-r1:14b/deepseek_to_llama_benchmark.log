---
- name: Configure Cron Service
  hosts: localhost
  tasks:
    - name: Import assertion file
      include: assert.yml
      notify: handler

    - name: Install cron packages
      package:
        name: "{{ cron_packages }}"
        state: present

    - name: Configure cron shell
      lineinfile:
        dest: /etc/cron.d/crontab
        regexp: '^SHELL'
        line: 'SHELL=/bin/bash'
      notify: restart cron

    - name: Configure cron path
      lineinfile:
        dest: /etc/cron.d/crontab
        regexp: '^PATH'
        line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
      notify: restart cron

    - name: Configure cron mailto
      lineinfile:
        dest: /etc/cron.d/crontab
        regexp: '^MAILTO'
        line: 'MAILTO=root'
      notify: restart cron

    - name: Start and enable cron service
      service:
        name: cron
        state: started
        enabled: yes
      when: cron_service is defined and cron_service != ''

    - name: Schedule cron jobs
      cron:
        name: "{{ item.name }}"
        minute: "{{ item.minute }}"
        hour: "{{ item.hour }}"
        day: "{{ item.day }}"
        month: "{{ item.month }}"
        dayofweek: "{{ item.dayofweek }}"
        job: "{{ item.job }}"
      loop: "{{ cron_jobs }}"


