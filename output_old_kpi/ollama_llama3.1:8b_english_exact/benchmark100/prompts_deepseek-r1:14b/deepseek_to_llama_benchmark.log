--- 

- name: hardening | Disable swap
  name: 
  become: yes
  line:
    - "sudo swapoff -a"

- name: hardening | Disable core dumps
  name: 
  become: yes
  line:
    - "sudo sed -i 's/\/core/\/dev/null/g' /etc/pam.d/common-session"
    - "sudo sed -i 's/\/core/\/dev/null/g' /etc/pam.d/common-password"

- name: hardening | Disable Shell Command History
  name: 
  become: yes
  line:
    - "echo 'HISTFILESIZE=0' >> /etc/profile.d/vault.sh"
    - "echo 'HISTSIZE=0' >> /etc/profile.d/vault.sh"
    - "echo 'export HISTFILESIZE=0' >> /etc/profile.d/vault.sh"
    - "echo 'export HISTSIZE=0' >> /etc/profile.d/vault.sh"

- name: hardening | Configure SELinux / AppArmor
  name: 
  become: yes
  apt:
    name: libselinux1
    state: present
  shell:
    cmd: "sudo setenforce 1"
  line:
    - "sudo semanage fcontext -a -t vault_exec_t '/etc/vault/*'"
    - "sudo semanage fcontext -a -t vault_exec_t '/var/lib/vault/*'"
    - "sudo semanage fcontext -a -t vault_exec_t '/var/log/vault/*'"
    - "sudo a2enconf vault"

  apt:
    name: apparmor
    state: present
  shell:
    cmd: "sudo service apparmor restart"
  line:
    - "sudo aa-enforce /etc/apparmor.d/usr.sbin.vault"

