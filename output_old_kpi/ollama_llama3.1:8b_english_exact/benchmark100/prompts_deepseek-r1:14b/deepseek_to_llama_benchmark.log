---
- name: Import assertion tasks from assert.yml for validation purposes
  assert:
    module_path: '{{ lookup("ansible.builtin.path", "/path/to/assert.yml") }}'

- name: Install HashiCorp product using package manager
  package:
    name: '{{ item }}'
    state: present
  when: ansible_distribution == 'Ubuntu' and ansible_distribution_version is version('18.04', '>=')
  with_items:
    - hashicorp-{{ product_name }}
  condition: product_name is defined

- name: Install HashiCorp product using package manager (RPM based systems)
  package:
    name: '{{ item }}'
    state: present
  when: ansible_distribution == 'CentOS' and ansible_distribution_version is version('7', '=')
  with_items:
    - "{{ product_name }}-{{ product_version }}"
  condition: product_name is defined and product_version is defined

- name: Configure Debian-specific settings for HashiCorp product installation
  apt_key:
    url: 'https://apt.releases.hashicorp.com/gpg'
    state: present
  apt_repository:
    repo: 'https://apt.releases.hashicorp.com/ubuntu'
    state: present

- name: Install HashiCorp products using package manager
  package:
    name: '{{ item }}'
    state: present
  with_items:
    - hashicorp-{{ product_name }}
    - "{{ product_name }}-{{ product_version }}"
  condition: product_name is defined and product_version is defined

- name: Install HashiCorp product manually by extracting files
  unarchive:
    src: '{{ remote_source }}'
    dest: '{{ destination }}'
    compression: gzip
  become: yes
  become_method: sudo
  become_user: root
  file:
    path: '{{ destination }}/{{ product_name }}'
    mode: '0755'
  condition: product_name is defined and remote_source is defined and destination is defined


