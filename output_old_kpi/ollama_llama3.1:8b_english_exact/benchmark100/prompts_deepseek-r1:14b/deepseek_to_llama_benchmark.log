content='---\n\n\n- name: Create the RKE2 configuration directory\n  file:\n    path: /etc/rke2/operator.yaml\n    state: directory\n    owner: root\n    group: root\n    mode: \'0755\'\n\n- name: Set server taints\n  set_fact:\n    server_taints: |\n      taints:\n      - key: node-role.kubernetes.io/master\n        value: "true"\n        effect: NoSchedule\n\n- name: Set agent taints\n  set_fact:\n    agent_taints: |\n      taints:\n      - key: node-role.kubernetes.io/agent\n        value: "true"\n        effect: NoSchedule\n\n- name: Copy RKE2 configuration file\n  template:\n    src: templates/operator.yaml.j2\n    dest: /etc/rke2/operator.yaml\n    owner: root\n    group: root\n    mode: \'0644\'\n  notify:\n    - restart rke2\n\n- name: Copy Kubelet configuration file\n  template:\n    src: templates/kubelet.conf.j2\n    dest: /etc/kubernetes/kubelet.conf\n    owner: root\n    group: root\n    mode: \'0644\'\n  when: kubelet_config is defined\n  notify:\n    - restart kubelet\n\n- name: Copy Containerd Registry Configuration file\n  copy:\n    src: "/etc/rke2/agent/registries.yaml"\n    dest: /etc/containerd/config.toml\n    owner: root\n    group: root\n    mode: \'0644\'\n  when: containerd_registry_config is defined\n  notify:\n    - restart containerd\n\n- name: Start RKE2 service on other nodes\n  service:\n    name: rke2\n    state: started\n    enabled: yes\n  when: inventory_hostname != groups[\'nodes\'][0]\n\n- name: Mask other RKE2 services on nodes\n  ufw:\n    rule: deny\n    name: rke2/agent\n  when: inventory_hostname in groups[\'nodes\'] and server_taints is defined\n  notify:\n    - restart rke2\n\n- name: Mask other RKE2 services on nodes\n  ufw:\n    rule: deny\n    name: rke2/server\n  when: inventory_hostname in groups[\'nodes\'] and agent_taints is defined\n  notify:\n    - restart rke2\n\n- name: Wait for remaining nodes to be ready - no CNI\n  wait_for:\n    host_pattern: \'{{ inventory_hostname }}\'\n    state: started\n    timeout: 300\n    connect_timeout: 10\n    warn: no\n  when: cni_config is not defined\n  loop: groups[\'nodes\']\n  loop_control:\n    loop_var: node\n\n- name: Wait for remaining nodes to be ready - with CNI\n  wait_for:\n    host_pattern: \'{{ inventory_hostname }}\'\n    state: started\n    timeout: 300\n    connect_timeout: 10\n    warn: no\n  when: cni_config is defined\n  loop: groups[\'nodes\']\n  loop_control:\n    loop_var: node' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-05T10:34:32.737957905Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7458799644, 'load_duration': 1863395449, 'prompt_eval_count': 629, 'prompt_eval_duration': 277024305, 'eval_count': 665, 'eval_duration': 5317536154, 'model_name': 'llama3.1:8b'} id='run--8c7e68ab-dc94-4043-9611-1f9d64f6d536-0' usage_metadata={'input_tokens': 629, 'output_tokens': 665, 'total_tokens': 1294}
