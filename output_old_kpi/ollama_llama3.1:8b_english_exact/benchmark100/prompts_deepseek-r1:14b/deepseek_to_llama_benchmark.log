---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml
  run_once: true

- name: Install git
  ansible.builtin.apt:
    name: git
    state: present

- name: Check if user exists
  ansible.builtin.user:
    name: git
    present: false

- name: Create git config directory
  ansible.builtin.file:
    path: /home/git/.gitconfig
    state: directory
    mode: '0755'

- name: Place git configuration
  ansible.builtin.template:
    src: templates/gitconfig.j2
    dest: /home/git/.gitconfig
    mode: '0644'

- name: Create repository destination
  ansible.builtin.file:
    path: /home/git/repositories
    state: directory
    mode: '0755'

- name: Clone all repositories
  ansible.builtin.git:
    repo: 'https://github.com/user/repo1.git'
    dest: '/home/git/repositories/repo1'
    version: "{{ git_repo_versions['repo1'] }}"
    clone: true
  loop:
    - name: 'https://github.com/user/repo1.git'
      dest: '/home/git/repositories/repo1'
      version: "{{ git_repo_versions['repo1'] }}"
    - name: 'https://github.com/user/repo2.git'
      dest: '/home/git/repositories/repo2'
      version: "{{ git_repo_versions['repo2'] }}"

