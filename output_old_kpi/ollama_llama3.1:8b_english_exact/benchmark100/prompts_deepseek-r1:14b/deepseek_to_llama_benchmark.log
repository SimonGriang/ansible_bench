---
- name: Configure SELinux
  block:
    - name: Configure SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify:
        - Reboot

    - name: Configure SELinux booleans
      selinux_booleans:
        booleans:
          "{{ selinux_booleans }}"
        state: "{{ selinux_state }}"
        persistent: yes
      when: selinux_booleans is defined

  when:
    - selinux_status is defined
    - ansible_connection.type not in ['container', 'docker', 'community.docker.docker']

- name: Install packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify:
    - Gather facts

- name: Flush handlers
  meta: flush_handlers

- include_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

