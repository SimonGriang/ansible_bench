---
- name: Configure services
  hosts: localhost
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: true

  - name: Install required packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ service_required_packages }}"
    notify: Gather facts

  - name: Configure systemd service
