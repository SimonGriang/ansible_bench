--- 

- name: Install EPEL repository on compatible systems
  block:
    - name: Add EPEL GPG key
      rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"
    - name: Install EPEL release package
      yum:
        name: epel-release
        state: present
      notify: Update package cache
    - name: Install EPEL next release package
      yum:
        name: epel-next-release
        state: present
      when: epel_next
      notify: Update package cache

  when: (ansible_distribution == 'Amazon') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version is 7 or ansible_distribution_major_version is 8 or ansible_distribution_major_version is 9)

- name: Add EPEL GPG key
  rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install EPEL release package
  yum:
    name: epel-release
    state: present
  notify: Update package cache

- name: Install EPEL next release package
  yum:
    name: epel-next-release
    state: present
  when: epel_next
  notify: Update package cache

