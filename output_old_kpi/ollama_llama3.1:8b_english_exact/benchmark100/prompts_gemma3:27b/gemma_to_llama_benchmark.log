  block:
    - name: Wait for port to be available
      wait_for:
        host: "{{ inventory_hostname }}"
        port: 22
        timeout: "{{ bootstrap_timeout }}"
      when:
        - ansible_connection is defined
        - ansible_connection.type != 'docker'
        - bootstrap_wait_for_host == true
  rescue:
    - name: Gather facts
      setup: {}
    - name: Install bootstrap packages
      raw: |
        {{ bootstrap_packages_raw }}
      when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora']
    - name: Ensure libdnf5 is present
      package:
        name: libdnf5
        state: present

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
    become: "{{ bootstrap_become }}"
  when: bootstrap_become == true


