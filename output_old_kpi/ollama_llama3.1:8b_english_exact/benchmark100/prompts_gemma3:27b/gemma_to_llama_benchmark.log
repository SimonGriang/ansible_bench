---
- name: Tasks
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install git
    apt:
      name: "{{ git_packages }}"
      state: present

  - name: See if the specified user exists
    getent:
      database: passwd
      name: "{{ git_username }}"
    register: user_exists
    failed_when: user_exists is undefined or not user_exists.stdout
    when: fail_key is not defined or fail_key == true

  - name: Create directory for git configuration
    file:
      path: /home/{{ git_username }}
      state: directory
      owner: "{{ git_username }}"
      group: "{{ git_username }}"
      mode: '0755'

  - name: Place git configuration
    copy:
      content: "{{ lookup('template', 'gitconfig.j2') }}"
      dest: "/home/{{ git_username }}/.gitconfig"
      mode: '0644'
      owner: "{{ git_username }}"
      group: "{{ git_username }}"

  - name: Create repository_destination
    file:
      path: "{{ git_repository_destination }}"
      state: directory
      owner: "{{ git_username }}"
      group: "{{ git_username }}"
      mode: '0755'

  - name: Clone all roles
    git:
      repo: "{{ item.repository_url }}"
      dest: "{{ item.repository_destination }}"
      version: "{{ item.repository_version }}"
      update: yes
      force: yes
      clone: yes
    loop: "{{ git_repositories }}"
    loop_control:
      loop_var: item
    run_as_user: "{{ git_username }}"
    with_items:
      - repository_url: "{{ item.repository_url }}"
        repository_destination: "{{ git_repository_destination }}"
        repository_version: "{{ item.repository_version }}"
        force: yes
        clone: yes
    notify:
      - git repository cloned
      - destination path is {{ item.repository_destination }}


