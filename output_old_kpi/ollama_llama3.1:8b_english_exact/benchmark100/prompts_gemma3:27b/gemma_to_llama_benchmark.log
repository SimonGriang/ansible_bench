    src: templates/rke2-config.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify:
    - rke2_config_changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.j2
    dest: /etc/rancher/rke2/kubelet/config.yaml
  when: rke2_kubelet_config | length > 0
  notify:
    - kubelet_config_changed

- name: Copy Containerd Registry Configuration file
  template:
    src: templates/containerd-registry-config.j2
    dest: /etc/rancher/rke2/containerd-registry.conf
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
  notify:
    - containerd_registry_config_changed

- name: Start RKE2 service on the rest of the nodes
  service:
    name: rke2
    state: started
    enabled: yes
  retries: 5
  delay: 10
  ignore_errors: false
  environment:
    RKE2_TOKEN: rke2_token
  register: rke2_service
  notify:
    - rke2_service_restart

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: "{{ item }}"
    state: masked
    enabled: no
  with_items:
    - rke2-server
    - rke2-agent
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell:
    cmd: "kubectl get nodes -o jsonpath='{.items[?(@.metadata.labels.node-role.kubernetes.io/server==true)].status.conditions[?(@.type==\"Ready\")]}'"
    register: node_ready
  retries: 30
  delay: 10
  until: node_ready.stdout != "[]"
  when: CNI == 'none' and (rke2_type == 'server' or rke2_type == 'first-server')

- name: Wait for remaining nodes to be ready - with CNI
  shell:
    cmd: "kubectl get nodes -o jsonpath='{.items[?(@.metadata.labels.node-role.kubernetes.io/server==true)].status.conditions[?(@.type==\"Ready\")]}'"
    register: node_ready
  retries: 30
  delay: 10
  until: node_ready.stdout =~ "Ready"
  when: CNI != 'none' and (rke2_type == 'server' or rke2_type == 'first-server')


