---
- name: Configure Vault
  hosts: all
  become: yes

  tasks:
  - name: Set file permissions
    file:
      path: /etc/vault.json
      mode: '0644'
    notify: handlers

  - name: Set owner and group
    file:
      path: /etc/vault.json
      owner: root
      group: root
    notify: handlers

  - name: Configure SELinux / AppArmor
    block:
      - name: Install selinux-policy
        when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
        apt:
          name: selinux-policy
          state: present

      - name: Set SELinux policy to targeted and state to enforcing
        when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
        selinux:
          policy: targeted
          state: enforcing

      - name: Install apparmor
        when: vault_hardening_configure_selinux_apparmor and ansible_apparmor.status == "enabled"
        apt:
          name: apparmor
          state: present

      - name: Enable AppArmor
        when: vault_hardening_configure_selinux_apparmor and ansible_apparmor.status == "enabled"
        apparmor:
          state: enabled

  handlers:
  - name: handlers
    file:
      path: /etc/vault.json
      state: touch


