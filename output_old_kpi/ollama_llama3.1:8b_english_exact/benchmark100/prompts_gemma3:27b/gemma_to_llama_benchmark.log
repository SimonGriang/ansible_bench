---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apt:
    cache_valid_time: 3600
  notify:
    - Reboot
  when: package_manager == 'apk'
  handlers:
    - Reboot:
        reboot:
          msg: 'Rebooting'

- name: Configure apt
  apt:
    cache_valid_time: 3600
    upgrade: true
    apt_autoremove: "{{ apt_autoremove | bool }}"
  notify:
    - Reboot
  when: package_manager == 'apt'

- name: Update all software (dnf)
  dnf:
    cache_enabled: true
    update_cache: true
    update_only: true
    exclude: "{{ update_excluded_packages }}"
  notify:
    - Reboot
  when: package_manager == 'dnf' or package_manager == 'dnf5'

- name: Update all software (pacman)
  pacman:
    update_cache: true
    update_packages: true
  notify:
    - Reboot
  when: package_manager == 'pacman'

- name: Configure yum
  yum:
    cache_last_check_seconds: 3600
  notify:
    - Reboot
  handlers:
    - Reboot:
        reboot:
          msg: 'Rebooting'

- name: Update all software (zypper)
  zypper:
    update: true
  notify:
    - Reboot
  when: package_manager == 'zypper'
