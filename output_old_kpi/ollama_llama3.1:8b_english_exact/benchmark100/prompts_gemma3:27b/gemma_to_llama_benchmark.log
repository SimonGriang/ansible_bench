---
- name: Perform initial assertions
  include_tasks: assert.yml

- name: Install DNS packages
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ dns_packages }}"
  delegate_to: localhost

- name: Create DNS data and configuration directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop:
    - { path: "{{ dns_datadir }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}", mode: '0755' }
    - { path: "{{ dns_confdir }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}", mode: '0755' }

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: yes
    group: "{{ dns_group }}"

- name: Generate rndc key
  command:
    cmd: rndc-confgen -a /etc/named/rndc.key
  when: not stat.exists(path="/etc/named/rndc.key")

- name: Set permissions on rndc key file
  file:
    path: /etc/named/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_caching_dns_url }}"
    dest: "{{ dns_datadir }}/named.ca"
    mode: '0644'
  when: dns_caching_dns

- name: Create zone files
  template:
    src: templates/named.conf-zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    mode: '0644'
  loop: "{{ dns_zones }}"
  notify: Rndc reload
  loop_control:
    loop_var: item

- name: Validate zone files
  shell:
    cmd: named-checkzone "{{ item.name }}" "{{ dns_datadir }}/{{ item.name }}.zone"
  loop: "{{ dns_zones }}"
  loop_control:
    loop_var: item

- name: Set zone file permissions
  file:
    path: "{{ dns_datadir }}/{{ item.name }}.zone"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'
  loop: "{{ dns_zones }}"
  loop_control:
    loop_var: item

- name: Update named configuration
  template:
    src: templates/named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    mode: '0644'
  notify: Restart dns

- name: Validate named configuration
  shell:
    cmd: named-checkconf
  notify: Restart dns

- name: Create named configuration backup
  copy:
    content: "{{ lookup('template', 'named.conf.j2') }}"
    dest: "{{ dns_confdir }}/named.conf.bak"
    mode: '0644'

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/named.service.d
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy systemd override configuration
      copy:
        content: "{{ lookup('template', 'named.service.d/override.conf.j2') }}"
        dest: /etc/systemd/system/named.service.d/override.conf
        mode: '0644'
    - name: Reload systemd daemon
      systemd:
        daemon_reload: yes

- name: Start and enable DNS service
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


