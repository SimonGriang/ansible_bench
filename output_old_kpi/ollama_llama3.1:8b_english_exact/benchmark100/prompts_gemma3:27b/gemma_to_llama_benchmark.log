---
- name: Check Java Certificate Existence
  stat:
    path: "{{ item }}"
    register: check_java_certs
  loop: "{{ java_certs }}"

- name: Fail if Java Certificate Doesn't Exist
  fail:
    msg: "Java certificate {{ item.stat.path }} does not exist"
  loop: "{{ check_java_certs.results }}"
  when: not item.stat.exists

- name: Set Keystore Directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when:
    - java_keystore_dir is not undefined or java_keystore_dir is None
    - java_open_jdk_version_major < 11

- name: Set Keystore Directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when:
    - java_keystore_dir is not defined or java_keystore_dir is None
    - java_open_jdk_version_major >= 11

- name: Import SSL Certificates into Java Keystore
  java_cert:
    cert_path: "{{ item }}"
    keystore_path: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}"
    keystore_pass: "{{ java_cert_keystore_pass }}"
    cert_alias: "{{ item | basename }}"
    state: "present"
    keystore_create: yes
  loop: "{{ java_certs }}"
  loop_control:
    loop_var: item

