- name: Include assert.yml
  include_tasks: assert.yml

- name: Install required software
  apt:
    name: "{{ item }}"
    state: present
  when: users_requirements is defined
  loop: "{{ users_requirements }}"

- name: Include group tasks
  include_tasks: "group.yml"
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"

- name: Include sudoers.d directory
  lineinfile:
    dest: /etc/sudoers
    line: "{{ users_sudo_includedir }} ALL=(ALL) NOPASSWD: ALL"
    state: present
  when: users_sudo_includedir is defined
  notify: reload sudo

