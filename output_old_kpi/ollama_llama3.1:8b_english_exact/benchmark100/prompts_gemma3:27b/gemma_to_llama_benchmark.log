- name: Remove logrotate.d files
  hosts: localhost
  become: yes
  tasks:
    - name: Create logrotate_entries
      set_fact:
        logrotate_entries: "{{ logrotate_entries | default([]) }}"

    - name: Remove configuration files
      file:
