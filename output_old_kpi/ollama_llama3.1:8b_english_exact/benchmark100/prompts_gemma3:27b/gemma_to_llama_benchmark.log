content="---\n\n\n- name: Assert systemd as init system\n  assert:\n    that: system == 'linux'\n    msg: 'Target system does not use systemd'\n\n- name: Get latest release\n  uri:\n    url: 'https://api.github.com/repos/grafana/loki/releases/latest'\n    method: GET\n    return_content: true\n    status_code: 200\n    headers:\n      Authorization: 'Bearer {{ GH_TOKEN }}'\n    body_format: json\n    retries: 5\n    retry_delay: 1\n  register: _latest_release\n\n- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}\n  set_fact:\n    promtail_version: '{{ _latest_release.json.tag_name[1:] }}'\n\n- name: Test if zip local archive exists\n  stat:\n    path: '{{ promtail_binary_local_dir }}/{{ _latest_release.json.tag_name }}.zip'\n    state: 'file'\n  register: promtail_binary_local_archive\n\n- name: Assert local binary exists\n  assert:\n    that: promtail_binary_local_dir is defined and promtail_binary_local_archive.stat.exists\n    msg: 'Local promtail binary archive does not exist'\n\n- name: Get checksum list\n  get_url:\n    url: 'https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS'\n    dest: '/tmp/SHA256SUMS'\n    checksum: sha256\n\n- name: Get checksum for {{ go_arch }} architecture\n  set_fact:\n    __promtail_checksum: ''\n  when: promtail_binary_local_dir is not defined\n  block:\n  - name: Get checksum list\n    get_url:\n      url: 'https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS'\n      dest: '/tmp/SHA256SUMS'\n      checksum: sha256\n  - name: Find checksum for {{ go_arch }} architecture\n    find:\n      paths: '/tmp/SHA256SUMS'\n      patterns: '^{{ promtail_version }}-promtail-*.{{ go_arch }}'\n      recurse: true\n    register: promtail_checksum\n  - name: Set promtail checksum\n    set_fact:\n      __promtail_checksum: '{{ promtail_checksum.files[0].path }}'" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T07:50:13.06576