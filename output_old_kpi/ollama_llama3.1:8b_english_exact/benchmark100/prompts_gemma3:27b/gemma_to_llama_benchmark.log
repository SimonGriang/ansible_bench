content='---\n- name: Tasks\n  tasks:\n  - name: Include assert.yml\n    include_tasks: assert.yml\n\n  - name: Install apache httpd\n    apt:\n      name: "{{ httpd_packages }}"\n      state: present\n\n  - name: Configure selinux\n    selinux:\n      allow_httpd_anon_write: yes\n    when: selinux_enabled\n\n  - name: Configure httpd\n    template:\n      src: "{{ httpd_config_src }}"\n      dest: "{{ httpd_config_dest }}"\n      mode: \'0644\'\n    notify:\n      - test and restart httpd\n\n  - name: Activate httpd module | Debian\n    shell:\n      cmd: "{{ item }}"\n      chdir: /etc/apache2/mods-available\n    loop: "{{ httpd_modules_to_activate_with_command }}"\n    when: "\'Debian\' in ansible_distribution"\n\n  - name: Include ssl.yml\n    include_tasks: ssl.yml\n    when: https_ssl_enable is true\n\n  - name: Include locations.yml\n    include_tasks: locations.yml\n    when: httpd_locations is defined\n\n  - name: Include vhosts.yml\n    include_tasks: vhosts.yml\n    when: httpd_vhosts is defined\n\n  - name: Configure ports\n    template:\n      src: "{{ httpd_ports_conf.j2 }}"\n      dest: "{{ httpd_server_root }}/ports.conf"\n      mode: \'0644\'\n    notify:\n      - test and restart httpd\n    when: "\'Debian\' in ansible_distribution or \'Suse\' in ansible_distribution"\n\n  - name: Include directories.yml\n    include_tasks: directories.yml\n    when: httpd_directories is defined\n\n  - name: Flush handlers\n    meta: flush_handlers\n\n  - name: Removing default html\n    file:\n      path: "{{ httpd_data_directory }}/index.html"\n      state: absent\n    when: httpd_remove_example is true\n\n  - name: Start and enable httpd\n    service:\n      name: "{{ httpd_service }}"\n      state: started\n      enabled: yes' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T08:01:03.707447578Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4036243125, 'load_duration': 118399478, 'prompt_eval_count': 752, 'prompt_eval_duration': 132998433, 'eval_count': 432, 'eval_duration': 3783938406, 'model_name': 'llama3.1:8b'} id='run--e27b8e50-80b4-44aa-ade5-f0f6ff347bd1-0' usage_metadata={'input_tokens': 752, 'output_tokens': 432, 'total_tokens': 1184}
