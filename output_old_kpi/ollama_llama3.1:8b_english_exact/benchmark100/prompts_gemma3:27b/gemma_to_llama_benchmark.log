content='---\n\n\n---\n\n- name: Import tasks from assert.yml, running only once on localhost\n  assert:\n    module_path: assert.yml\n    state: present\n    run_once: true\n\n- block:\n  - name: Install Hashicorp products using a package manager, conditional on `hashicorp_installation_method` being "package"\n    when: hashicorp_installation_method == "package"\n  tasks:\n    - name: Install Hashicorp products using a package manager\n      package:\n        name: "{{ item }}"\n        state: present\n      loop: "{{ hashicorp_products }}"\n\n- block:\n  - name: Download the Hashicorp repository file for RedHat-based systems (RedHat, Rocky) and place it in /etc/yum.repos.d/hashicorp.repo with permissions 0640\n    when: ansible_distribution in ["RedHat", "Rocky"]\n  tasks:\n    - name: Download the Hashicorp repository file for RedHat-based systems\n      get_url:\n        url: "https://apt.hashicorp.com/hashicorp-repo-{{ ansible_distribution }}.rpm"\n        dest: "/etc/yum.repos.d/hashicorp.repo"\n        mode: "0640"\n\n- block:\n  - name: Configure the Debian package manager, conditional on `ansible_os_family` being "Debian"\n    when: ansible_os_family == "Debian"\n  tasks:\n    - name: Install the `gpg` package on Debian systems\n      when: ansible_os_family == "Debian"\n      apt:\n        name: gpg\n        state: present\n\n    - name: Add the Hashicorp apt key to Debian systems, ignoring certificate validation\n      when: ansible_os_family == "Debian"\n      apt_key:\n        id: "1C4F8BFCF82B609E"\n        keyserver: keyserver.ubuntu.com\n        state: present\n        validate_certs: no\n\n    - name: Add the Hashicorp apt repository to Debian systems, specifying the architecture using `hashicorp_architecture_mapping` and the distribution release\n      when: ansible_os_family == "Debian"\n      apt:\n        deb: "https://apt.hashicorp.com/ansible_{{ hashicorp_architecture_mapping[ansible_architecture] }}_{{ ansible_distribution }}.deb"\n        state: present\n\n- block:\n  - name: Install Hashicorp products using the package manager, conditional on `hashicorp_products` being defined\n    when: hashicorp_products is defined\n  tasks:\n    - name: Install the latest version of each Hashicorp product defined in `hashicorp_products`, looping through the list and setting a label for each product\n      when: hashicorp_products is defined\n      package:\n        name: "{{ item }}"\n        state: latest\n      loop: "{{ hashicorp_products | map(\'split\', \',\') | map(\'join\', \',\') }}"\n\n    - name: Install a specific version of each Hashicorp product defined in `hashicorp_products` (if a version is specified), looping through the list and setting a label for each product\n      when: hashicorp_products is defined\n      package:\n        name: "{{ item | join(\', \') }}-{{ version_coupler }}{{ item[1] if item[1] else \'\' }}"\n        state: present\n      loop: "{{ hashicorp_products | map(\'split\', \',\') | map(\'join\', \',\') }}"\n\n- block:\n  - name: Install Hashicorp products manually, conditional on `hashicorp_installation_method` being "manual"\n    when: hashicorp_installation_method == "manual"\n  tasks:\n    - name: Unarchive each Hashicorp product defined in `hashicorp_products` to the destination directory with specified group, mode, and owner\n      when: hashicorp_installation_method == "manual"\n      unarchive:\n        src: "{{ hashicorp_src }}"\n        dest: "/path/to/destination"\n        group: "group"\n        mode: "0644"\n        owner: "user"\n      loop: "{{ hashicorp_products }}"' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T08:54:04.155108786Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7601847598, 'load_duration': 110874917, 'prompt_eval_count': 757, 'prompt_eval_duration': 132429159, 'eval_count': 867, 'eval_duration': 7357656303, 'model_name': 'llama3.1:8b'} id='run--4e3bfcdb-8feb-4b78-baa3-c67ff44e989f-0' usage_meta