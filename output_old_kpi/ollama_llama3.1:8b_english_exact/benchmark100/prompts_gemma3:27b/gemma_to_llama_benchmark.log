---
- name: Verify variable settings
  import_tasks: assert.yml

- name: Wait for host to be reachable
  wait_for_connection:
    host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection != 'docker' and bootstrap_wait_for_host
  delegate_to: localhost
  become: true

- name: Prepare system
  block:
    - name: Wait for connection
      wait_for_connection:
        host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
        port: 22
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect

    - name: Debug bootstrap timeout if connection fails
      debug:
        msg: "bootstrap_timeout: {{ bootstrap_timeout }}"
      when: not bootstrap_connect.connected

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw:
    cmd: "{{ 'apk add -q {{ item }}' if ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux' or ansible_distribution == 'Gentoo' else 'yum install -y {{ item }}' if ansible_distribution == 'RedHat' or ansible_distribution == 'Rocky' or ansible_distribution == 'Suse' else 'apt-get install -y {{ item }}' }}"
    stdin: "{{ bootstrap_user }}"
    stdin_add_newline: yes
  register: bootstrap_install_packages
  become_user: "{{ bootstrap_user }}"
  become: true
  changed_when: "'{{ bootstrap_install_packages.stdout }}' | regex_search('complete|installed') if ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux' or ansible_distribution == 'Gentoo' else 'not {{ bootstrap_install_packages.stdout }}' | regex_search('complete|installed') if ansible_distribution == 'RedHat' or ansible_distribution == 'Rocky' or ansible_distribution == 'Suse'"

- name: Ensure system is prepared
  block:
    - name: Gather ansible facts
      setup:
        gather_subset: "!all"

    - name: Install bootstrap packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap__facts_packages }}"
      when: bootstrap__facts_packages is defined


