---
- name: Postfix configuration playbook
  hosts: localhost
  gather_facts: no

  tasks:
  - import_tasks: assert.yml

  - name: Pre-configure debian systems
    debconf:
      name='postfix/mailname'
      value='{{ mailname }}'
      select=True

  - name: Install postfix
    apt:
      name: postfix
      state: present

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present
    when: virtual_mailbox_maps|type_debug|string == 'mysql' or virtual_mailbox_domains|type_debug|string == 'mysql'

  - name: Configure postfix (transport_maps)
    template:
      src: transport_maps.j2
      dest: /etc/postfix/transport_maps
      mode: '0644'
    notify: [ postconf, postfix_rebuild_database ]

  - name: Configure postfix (header_checks)
    template:
      src: header_checks.j2
      dest: /etc/postfix/header_checks
      mode: '0644'
    notify: [ postconf, postfix_reload ]

  - name: Setting values for main.cf (1/2)
    set_fact:
      mail_location: '{{ mail_location }}'
      home_mailbox: '{{ home_mailbox }}'
      message_size_limit: '{{ message_size_limit }}'
    when: mail_location is defined or home_mailbox is defined or message_size_limit is defined

  - name: Setting values for main.cf (2/2)
    set_fact:
      mailbox_command: '{{ mailbox_command }}'
      mailbox_command_virtual: '{{ mailbox_command_virtual }}'
      virtual_alias_maps: 'virtual_alias_maps'
      virtual_mailbox_domains: 'virtual_mailbox_domains'
      virtual_mailbox_maps: 'virtual_mailbox_maps'
      virtual_minimum_uidgid: '10000'
    when: mailbox_command is defined or mailbox_command_virtual is defined or virtual_alias_maps is defined or virtual_mailbox_domains is defined or virtual_mailbox_maps is defined or virtual_minimum_uidgid is defined

  - name: Configure postfix (main.cf)
    template:
      src: main.cf.j2
      dest: /etc/postfix/main.cf
      mode: '0644'
    notify: [ postconf, postfix_restart ]

  - name: Configure postfix (master.cf)
    template:
      src: master.cf.j2
      dest: /etc/postfix/master.cf
      mode: '0644'
    notify: [ postconf, postfix_restart ]

  - name: Creates cert/key directory
    file:
      path: '{{ tls_cert_dir }}'
      state: directory
      mode: '0755'
    when: tls_cert_dir is defined

  - name: Deploy Postfix TLS server certificate
    copy:
      content: '{{ tls_server_cert }}'
      dest: '{{ tls_cert_dir }}/server.crt'
      mode: '0644'
    when: tls_server_cert is defined

  - name: Deploy Postfix TLS server key
    copy:
      content: '{{ tls_server_key }}'
      dest: '{{ tls_cert_dir }}/server.key'
      mode: '0644'
    when: tls_server_key is defined

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    template:
      src: aliases.j2
      dest: /etc/aliases
      mode: '0644'

  - name: Configure sender_access
    template:
      src: sender_access.j2
      dest: /etc/postfix/sender_access
      mode: '0644'

  - name: Configure recipient_access
    template:
      src: recipient_access.j2
      dest: /etc/postfix/recipient_access
      mode: '0644'

  - name: Place sasl_password_map
    file:
      path: /etc/postfix/sasl_password_map
      content: '{{ sasl_password_map }}'
      mode: '0644'

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes


