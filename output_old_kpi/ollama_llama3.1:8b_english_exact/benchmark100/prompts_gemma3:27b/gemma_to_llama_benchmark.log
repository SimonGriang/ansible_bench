- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apt:
    cache_valid_time: 3600
  handlers:
    - name: Reboot
      reboot:
        msg: 'Rebooting'

- name: Configure apt
  apt:
    cache_valid_time: 3600
    upgrade: true
  notify:
    - Reboot
  when: package_manager == 'apt'
  apt_autoremove: "{{ apt_autoremove | bool }}"

- name: Update all software (dnf)
  dnf:
