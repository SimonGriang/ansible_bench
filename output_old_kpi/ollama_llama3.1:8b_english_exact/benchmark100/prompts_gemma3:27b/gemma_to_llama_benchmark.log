content='---\n\n\n- name: Create the RKE2 config directory\n  file:\n    path: /etc/rancher/rke2\n    state: directory\n    mode: \'0755\'\n\n\n- name: Set server taints\n  set_fact:\n    combined_node_taints: "{{ rke2_server_node_taints | default([]) }}"\n  when: rke2_type == \'server\'\n\n\n- name: Copy rke2 config\n  template:\n    src: templates/rke2.conf.j2\n    dest: /etc/rancher/rke2/config\n    mode: \'0600\'\n  notify: "Config file changed"\n\n\n- name: Copy kubelet config\n  template:\n    src: templates/kubelet.conf.j2\n    dest: /etc/rancher/rke2/kubelet.conf\n    mode: \'0600\'\n  notify: "Config file changed"\n  when: rke2_kubelet_config | length > 0\n\n\n- name: Copy Containerd Registry Configuration file\n  template:\n    src: templates/containers.json.j2\n    dest: /etc/rancher/rke2/containers.json\n    mode: \'0600\'\n  notify: "Config file changed"\n  when:\n    (rke2_custom_registry_mirrors | length > 0) or\n    (rke2_custom_registry_configs | length > 0)\n\n\n- name: Register if we need to do a etcd restore from file\n  set_fact:\n    do_etcd_restore: true\n  when:\n    (rke2_etcd_snapshot_file is defined) and\n    (rke2-server.service is not defined or rke2-server.service is disabled)\n\n\n- name: Register if we need to do a etcd restore from s3\n  set_fact:\n    do_etcd_restore_from_s3: true\n  when:\n    (rke2_etcd_snapshot_file is defined) and\n    (rke2_etcd_snapshot_s3_options is defined and\n     (rke2_etcd_snapshot_s3_options.access_key_id is defined) and\n     (rke2_etcd_snapshot_s3_options.secret_access_key is defined) and\n     (rke2_etcd_snapshot_s3_options.bucket_name is defined) and\n     (rke2_etcd_snapshot_s3_options.prefix is defined))\n\n\n- name: Restore etcd from file\n  block:\n    - name: Create the destination directory\n      file:\n        path: /etc/rke2/etcd\n        state: directory\n        mode: \'0755\'\n    - name: Copy the snapshot\n      copy:\n        content: "{{ rke2_etcd_snapshot_file }}"\n        dest: /etc/rke2/etcd/snapshot.db\n        mode: \'0600\'\n    - name: Run the rke2 server command\n      command:\n        cmd: rke2 server --etcd-from-file\n        chdir: /etc/rancher/rke2\n  when: do_etcd_restore\n\n\n- name: Restore etcd from s3\n  block:\n    - name: Run the rke2 server command\n      command:\n        cmd: rke2 server --etcd-from-s3\n        chdir: /etc/rancher/rke2\n      environment:\n        RKE2_ETCD_SNAPSHOT_S3_ACCESS_KEY_ID: "{{ rke2_etcd_snapshot_s3_options.access_key_id }}"\n        RKE2_ETCD_SNAPSHOT_S3_SECRET_ACCESS_KEY: "{{ rke2_etcd_snapshot_s3_options.secret_access_key }}"\n        RKE2_ETCD_SNAPSHOT_S3_BUCKET_NAME: "{{ rke2_etcd_snapshot_s3_options.bucket_name }}"\n        RKE2_ETCD_SNAPSHOT_S3_PREFIX: "{{ rke2_etcd_snapshot_s3_options.prefix }}"\n  when: do_etcd_restore_from_s3\n\n\n- name: Start RKE2 service on the first server\n  service:\n    name: rke2-server.service\n    enabled: yes\n    state: started\n  environment:\n    RKE2_TOKEN: "{{ rke2_server_token }}"\n  notify: "Service (re)started"\n\n\n- name: Mask RKE2 agent service on the first server\n  service:\n    name: rke2-agent.service\n    enabled: no\n    state: masked\n\n\n- name: Wait for the first server be ready - no CNI\n  block:\n    - name: Run the kubectl command\n      command:\n        cmd: kubectl get nodes --no-headers\n        chdir: /etc/rancher/rke2\n      register: kubectl_output\n    - name: Check the output\n      assert:\n        that: "\'Ready\' in \'{{ kubectl_output.stdout }}\'"\n  when: ansible_hostname == rke2_cluster_first_server\n\n\n- name: Wait for the first server be ready - with CNI\n  block:\n    - name: Run the kubectl command\n      command:\n        cmd: kubectl get nodes --no-headers\n        chdir: /etc/rancher/rke2\n      register: kubectl_output\n    - name: Check the output\n      assert:\n        that: "\'Ready\' in \'{{ kubectl_output.stdout }}\'"\n  when: ansible_hostname == rke2_cluster_first_server and rke2_use_cni\n\n\n- name: Restore etcd\n  block:\n    - name: Get registered nodes\n      command:\n        cmd: rke2 server --get-registered-nodes\n        chdir: /etc/rancher/rke2\n      register: registered_nodes\n    - name: Get node names\n      command:\n        cmd: rke2 server --get-node-names\n        chdir: /etc/rancher/rke2\n      register: node_names\n    - name: Remove old secrets and nodes\n      command:\n        cmd: rke2 server --remove-old-secrets-and-nodes\n        chdir: /etc/rancher/rke2\n      register: removed_secrets_and_nodes\n      environment:\n        RKE2_TOKEN: "{{ rke2_server_token }}"\n\n\n- name: Set an Active Server variable\n  set_fact:\n    active_server: "{{ ansible_hostname }}"\n  delegate_to: "{{ rke2_cluster_group_name }}"' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T08:11:26.616612882Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14561619699, 'load_duration': 109454714, 'prompt_eval_count': 1016, 'prompt_eval_duration': 203918320, 'eval_count': 1313, 'eval_duration': 14246756027, 'model_name': 'llama3.1:8b'} id='run--7b54f2ed-97f8-4784-9056-f5ecc98e8a06-0' usage_metadata={'input_tokens': 1016, 'output_tokens': 1313, 'total_tokens': 2329}
