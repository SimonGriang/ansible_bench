---
- include_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: mysql.cnf.j2
    dest: /etc/mysql/conf.d/{{ mysql_name }}-server.cnf
    mode: '0644'
  notify: Restart mysql server

- name: Configure mysql client
  template:
    src: mysql-client.cnf.j2
    dest: /etc/mysql/conf.d/{{ mysql_name }}-client.cnf
    mode: '0644'
    loop: no
  vars:
    mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- meta: flush_handlers

- name: Place my.cnf
  copy:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    host: unix
    user: root
    password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    host: unix
    user: root
    password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
