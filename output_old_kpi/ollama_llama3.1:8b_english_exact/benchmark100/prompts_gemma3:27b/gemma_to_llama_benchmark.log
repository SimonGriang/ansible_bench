      java_open_jdk_repositories: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_repositories | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome', 'ppa:openjdk/temurin']) }}"
      java_open_jdk_libs: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_libs | default(['libgcj-dev', 'libstdc++6-dev']) }}"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Set OS specific variables (I)
