---
- name: RKE2 setup tasks
  hosts: localhost

  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: 'https://example.com/rke2-install.sh'
      dest: '/tmp/rke2-install.sh'
      mode: '0755'
    when: airgap == false

  - name: Copy local RKE2 installation script
    copy:
      content: '{{ lookup("file", "/path/to/rke2-install.sh") }}'
      dest: '/tmp/rke2-install.sh'
      mode: '0755'
    when: airgap and implementation == 'copy'

  - name: Create RKE2 artifacts folder
    file:
      path: '/path/to/rke2-artifacts'
      state: directory
      mode: '0755'
    when: airgap and implementation != 'exists'

  - name: Download RKE2 checksum and artifacts
    block:
      - name: Download RKE2 artifacts and checksums remotely
        get_url:
          url: 'https://example.com/rke2-artifacts.tar.gz'
          dest: '/path/to/rke2-artifacts.tar.gz'
          mode: '0644'
      - name: Download RKE2 artifacts and checksums locally and copy to remote hosts
        copy:
          content: '{{ lookup("file", "/path/to/rke2-artifacts.tar.gz") }}'
          dest: '/path/to/rke2-artifacts.tar.gz'
          mode: '0644'
        when: download_remote == false
    when: airgap

  - name: Copy local RKE2 artifacts
    copy:
      content: '{{ lookup("file", "/path/to/rke2-artifacts.tar.gz") }}'
      dest: '/path/to/rke2-artifacts.tar.gz'
      mode: '0644'
    when: airgap and implementation == 'copy'

  - name: Airgap mode - additional images tarballs
    copy:
      content: '{{ lookup("file", "/path/to/additional-images.tar.gz") }}'
      dest: '/path/to/additional-images.tar.gz'
      mode: '0644'
    when: airgap and additional_images

  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    file:
      path: '/path/to/rke2-artifacts'
      state: directory
      mode: '0755'
    when: airgap
    notify: ensure rke2 artifacts have correct permissions

  - name: Populate service facts
    setup:
      gather_facts: yes

  - name: Get stats of the FS object
    shell: "df -h | grep /usr/local | awk '{print $5}'"

  - name: Check if separate partition
    stat:
      path: /usr/local
    register: partition

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: '/usr/local/bin/rke2'

  - name: Check RKE2 version
    shell: rke2 version

  - name: Set RKE2 versions
    set_fact:
      rke2_installed_version: '{{ rke2_version }}'
      rke2_running_version: '{{ rke2_running_version }}'

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: airgap == false or rke2_running_version > rke2_installed_version
      message: "Downgrade not allowed"

  - name: Run RKE2 install script
    shell: /tmp/rke2-install.sh

  - name: Copy Custom Manifests
    copy:
      content: '{{ lookup("file", "/path/to/custom-manifests.yaml") }}'
      dest: '/path/to/rke2-data/custom-manifests.yaml'
      mode: '0644'

  - name: Copy Static Pods
    copy:
      content: '{{ lookup("file", "/path/to/static-pods.yaml") }}'
      dest: '/path/to/rke2-agent/static-pods.yaml'
      mode: '0644'

  - name: Copy RKE2 environment file
    copy:
      content: '{{ lookup("file", "/path/to/rke2-env.yaml") }}'
      dest: '/path/to/rke2-env.yaml'
      mode: '0644'


