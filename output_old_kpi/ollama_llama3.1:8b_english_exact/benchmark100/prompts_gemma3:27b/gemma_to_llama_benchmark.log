---
- name: Configure Java
  tasks:
  - name: Migrate from adoptopenjdk to temurin if selected
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "vars/{{ java_jdk_vendor }}.yml"
      name: "java_os_{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}"
    when: java_jdk_vendor == "adoptopenjdk" or java_jdk_vendor == "temurin"

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"
      name: "java_architecture_{{ ansible_architecture }}"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_version: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_version | default('8') }}"
      java_open_jdk_repositories: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_repositories | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome', 'ppa:openjdk/temurin']) }}"
      java_open_jdk_libs: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_libs | default(['libgcj-dev', 'libstdc++6-dev']) }}"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_version: "{{ java_os_temurin_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_version | default('11') }}"
      java_open_jdk_repositories: "{{ java_os_temurin_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_repositories | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome', 'ppa:openjdk/temurin']) }}"
      java_open_jdk_libs: "{{ java_os_temurin_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_libs | default(['libgcj-dev', 'libstdc++6-dev']) }}"
    when: java_jdk_vendor == "temurin"

  - name: Set OS and architecture specific variables (II)
