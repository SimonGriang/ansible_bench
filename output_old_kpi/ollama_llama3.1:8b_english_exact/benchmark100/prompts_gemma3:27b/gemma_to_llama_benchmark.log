e:\n    src: templates/server.conf.j2\n    dest: /etc/openvpn/server.conf\n    state: file\n    mode: \'0640\'\n    owner: openvpn\n    group: openvpn\n  notify: Restart openvpn' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T07:46:58.293698325Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6115133087, 'load_duration': 116544195, 'prompt_eval_count': 960, 'prompt_eval_duration': 151477956, 'eval_count': 629, 'eval_duration': 5845192019, 'model_name': 'llama3.1:8b'} id='run--c7124ace-e04b-450b-bdc5-bc5e696b6795-0' usage_metadata={'input_tokens': 960, 'output_tokens': 629, 'total_tokens': 1589}
