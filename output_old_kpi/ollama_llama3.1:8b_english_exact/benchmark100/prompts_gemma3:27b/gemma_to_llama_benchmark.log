- name: Install Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == "RedHat" and ansible_distribution != "Fedora" and ansible_install_method == "package"

- name: Install Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when: ansible_distribution == "Fedora" and ansible_install_method == "package"

- name: Install Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when: ansible_distribution == "Ubuntu" and ansible_install_method == "package"

- name: Install Ansible on Debian
  include_tasks: setup-Debian.yml
  when: ansible_distribution == "Debian" and ansible_install_method == "package"

- name: Install Ansible using pip
  include_tasks: setup-pip.yml
  when: ansible_install_method == "pip"


