': 3873980834, 'load_duration': 112108326, 'prompt_eval_count': 632, 'prompt_eval_duration': 130784523, 'eval_count': 449, 'eval_duration': 3630184075, 'model_name': 'llama3.1:8b'} id='run--ea4e119d-00b6-43c8-b92f-7a36acc37e5d-0' usage_metadata={'input_tokens': 632, 'output_tokens': 449, 'total_tokens': 1081}
