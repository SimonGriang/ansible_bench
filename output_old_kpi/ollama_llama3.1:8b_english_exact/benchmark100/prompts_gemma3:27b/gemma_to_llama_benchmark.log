      java_open_jdk_home_dir: "{{ java_architecture_x86_64.java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
      java_open_jdk_package: "{{ java_architecture_x86_64.java_open_jdk_package | default('openjdk-11-jdk') }}"
    when: java_architecture == "x86_64"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_architecture_arm64.java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
      java_open_jdk_package: "{{ java_architecture_arm64.java_open_jdk_package | default('openjdk-11-jdk') }}"
    when: java_architecture == "arm64"

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home_dir }}/{{ java_open_jdk_package }}"

  - name: Remove deprecated repositories (Debian)
    apt:
      name: "{{ java_deprecated_repositories_adoptopenjdk | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome']) }}"
      state: absent
    when: ansible_distribution == "Debian"

  - name: Install extra apt tools (Debian)
    apt:
      name: "{{ java_open_jdk_apt_extra_packages | default(['apt-transport-https', 'ca-certificates']) }}"
      state: present
