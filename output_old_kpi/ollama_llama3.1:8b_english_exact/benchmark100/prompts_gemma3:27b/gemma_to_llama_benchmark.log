---
- name: Mysql playbook
  hosts: localhost
  become: true

  tasks:

  - include: assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present
    notify:
      - Set root password
      - Systemctl daemon-reexec

  - name: Configure mysql server
    lineinfile:
      dest: /etc/mysql/mysql.conf.d/{{ mysql_name }}-server.cnf
      regexp: '^{{ item }}'
      line: '{{ item }} = "{{ item_value }}"'
      state: present
    loop:
      - "{{ item.value }} = \"{{ item.value }}\""
    loop_control:
      loop_var: item
    with_items: mysql_configuration_options

  - name: Configure mysql client
    lineinfile:
      dest: /etc/mysql/mysql.conf.d/{{ mysql_name }}-client.cnf
      regexp: '^socket'
      line: 'socket = /var/run/mysqld/mysqld.sock'
      state: present

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when: ansible_distribution in ['Alpine', 'Archlinux']

  - name: Start and enable mysql
    service:
      name: "{{ mysql_service }}"
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: templates/my.cnf.j2
      dest: /root/.my.cnf
      mode: '0640'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: "{{ item.state | default('present') }}"
      target: "{{ item.target | default('mysql') }}"
      encoding: "{{ item.encoding | default('utf8') }}"
      collation: "{{ item.collation | default('utf8_general_ci') }}"
      login_user: root
      login_password: mysql_root_password
      login_host: "{{ mysql_socket }}"
    loop: "{{ mysql_databases }}"
    loop_control:
      loop_var: item

  - name: List databases
    mysql_info:
      login_user: root
      login_password: mysql_root_password
      login_host: "{{ mysql_socket }}"
      state: info
    register: mysql_databases
    run_once: true
    when: mysql_databases is defined

  - name: Import database
    mysql_db:
      name: "{{ item.name }}"
      target: "{{ item.target | default('mysql') }}"
      login_user: root
      login_password: mysql_root_password
      login_host: "{{ mysql_socket }}"
      state: import
    loop: "{{ mysql_databases }}"
    loop_control:
      loop_var: item
    when: mysql_databases_import_target is defined and item.name not in mysql_databases

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password | hash('md5') }}"
      priv: "{{ item.priv | default('N/a') }}@{{ item.host | default('N/a') }}"
      login_user: root
      login_password: mysql_root_password
      login_host: "{{ mysql_socket }}"
    loop: "{{ mysql_users }}"
    loop_control:
      loop_var: item

  - name: Flush handlers again
    meta: flush_handlers


