---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: no

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/{{ vault_architecture }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}"
    mode: '0644'
    force: yes
    checksum: sha256:{{ vault_checksum }}
  unarchive:
    src: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}"
    compression: zip
    interactive: yes

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
    register: vault_check_path

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  when: not vault_check_path.stat.exists and vault_path is not empty

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  shell: openssl req -x509 -newkey rsa:4096 -nodes -keyout tls.key -out tls.crt -days 365
  args:
    chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: file
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    content: "{{ lookup('file', vault_download_path + '/vault') }}"
    dest: /usr/bin/vault
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/bin/vault
  when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora']

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    state: touch
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: '0755'
    state: directory

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora']
  notify: Daemon reload

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers

