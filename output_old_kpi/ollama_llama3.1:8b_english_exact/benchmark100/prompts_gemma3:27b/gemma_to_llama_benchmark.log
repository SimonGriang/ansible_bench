--- 

- name: Create necessary directories for cadvisor
  file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: Download cadvisor binary
  get_url:
    url: '{{ cadvisor_download }}'
    dest: '/opt/cadvisor/cadvisor-{{ cadvisor_version }}'
    checksum: '{{ cadvisor_checksum }}'
    mode: '0755'
  when: cadvisor_binary_local_dir != ''

- name: Propagate locally distributed cadvisor binary
  copy:
    src: '{{ cadvisor_binary_local_dir }}/cadvisor-{{ cadadvisor_version }}'
    dest: '/opt/cadvisor/cadvisor-{{ cadvisor_version }}'
    mode: '0755'
    owner: root
    group: root
  notify: restart cadvisor
  when: cadvisor_binary_local_dir != ''

- name: Symlink cadvisor
  file:
    src: '/opt/cadvisor/cadvisor-{{ cadadvisor_version }}'
    dest: '/opt/cadvisor/cadvisor'
    state: link
    force: yes

- name: Create cadvisor systemd service
  template:
    src: systemd-system-cadvisor-service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  notify: restart cadvisor

- name: Test cadvisor service
  shell:
    cmd: systemctl status cadvisor.service
    register: service_active
  run_once: yes
  ignore_errors: yes

- name: Print service_active variable
  debug:
    var: service_active

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor.service
    enabled: yes

- name: Start cadvisor systemd service
  systemd:
    name: cadadvisor.service
    state: started
    daemon_reload: yes

