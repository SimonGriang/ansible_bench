content='--- \n\n---\n\n- name: Install Keepalived when HA mode is enabled\n  include_tasks: keepalived.yml\n  when: "\'ha\' in rke2_mode and inventory_hostname in groups(\'rke2_servers_group_name\') and rke2_api_ip is defined"\n\n- name: Download and install RKE2\n  include_tasks: rke2.yml\n  vars:\n    rke2_version: "{{ rke2_version }}"\n\n- name: CIS Hardening\n  include_tasks: cis.yml\n  when: rke2_cis_profile is defined and rke2_cis_profile|length > 0\n\n- name: Find Active Server\n  include_tasks: find_active_server.yml\n\n- name: Enable IPVS kernel module\n  block:\n    - name: Enable and persist the ip_vs kernel module\n      modprobe: \n        name: ip_vs\n        state: present\n      when: rke2_kubevip_ipvs_lb_enable and inventory_hostname in groups(\'rke2_servers_group_name\') and "\'ha\' in rke2_mode and not rke2_use_keepalived"\n    - name: Enable and persist the ip_vs kernel module\n      modprobe: \n        name: ip_vs\n        state: present\n      when: rke2_kubevip_ipvs_lb_enable and "\'ha\' in rke2_mode and not rke2_use_keepalived"\n\n- name: Copy kube-vip manifests to the masternode\n  include_tasks: kubevip.yml\n  when: "\'ha\' in rke2_mode and rke2_kubevip_use_keepalived is false"\n\n- name: Copy ingress-nginx manifests to the masternode\n  include_tasks: ingress-nginx.yml\n  when: rke2_ingress_nginx_values is defined and rke2_ingress_nginx_values|length > 0\n\n- name: Prepare very first server node in the cluster\n  include_tasks: first_server.yml\n  when: inventory_hostname in groups(\'rke2_servers_group_name\') and ((active_server is undefined or groups(\'rke2_cluster_group_name\')|length == 1))\n\n- name: Restore etcd specific tasks\n  include_tasks: first_server_restore.yml\n  when: (active_server is defined and (inventory_hostname == active_server or inventory_hostname in groups(\'rke2_servers_group_name\'))) and (do_etcd_restore or do_etcd_restore_from_s3 is defined)\n\n- name: Download kubeconfig to ansible localhost\n  include_tasks: download_kubeconfig.yaml\n  when: rke2_download_kubeconf and inventory_hostname in groups(\'rke2_servers_group_name\')\n\n- name: Prepare and join remaining nodes of the cluster\n  include_tasks: remaining_nodes.yml\n  when: active_server is defined and groups(\'rke2_cluster_group_name\')|length >= 2\n\n- name: Rolling cordon and drain restart when version changes - servers\n  block:\n    - name: Install a specific version of RKE2\n      get_url: \n        url: "{{ rke2_url }}/{{ rke2_version }}/{{ rke2_architecture }}/rke2"\n        dest: /tmp/rke2\n        mode: \'0755\'\n      when: rke2_version is defined and installed_version != rke2_version\n    - name: Rolling cordon and drain restart on the rke2_servers_group_name group\n      k8s_pod_facts: \n        kubeconfig: "{{ lookup(\'env\', \'KUBECONFIG\') }}"\n        api_version: v1\n        kind: Pod\n      when: rke2_version is defined and installed_version != rke2_version\n      delegate_to: localhost\n      run_once: true\n\n- name: Rolling cordon and drain restart when version changes - agents\n  block:\n    - name: Install a specific version of RKE2\n      get_url: \n        url: "{{ rke2_url }}/{{ rke2_version }}/{{ rke2_architecture }}/rke2"\n        dest: /tmp/rke2\n        mode: \'0755\'\n      when: rke2_version is defined and installed_version != rke2_version and inventory_hostname not in groups(\'rke2_servers_group_name\')\n    - name: Rolling cordon and drain restart on the rke2_agents_group_name group\n      k8s_pod_facts: \n        kubeconfig: "{{ lookup(\'env\', \'KUBECONFIG\') }}"\n        api_version: v1\n        kind: Pod\n      when: rke2_version is defined and installed_version != rke2_version and inventory_hostname not in groups(\'rke2_servers_group_name\')\n      delegate_to: localhost\n      run_once: true\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Rolling restart when config files change\n  block:\n    - name: Rolling restart on the rke2_cluster_group_name group\n      k8s_pod_facts: \n        kubeconfig: "{{ lookup(\'env\', \'KUBECONFIG\') }}"\n        api_version: v1\n        kind: Pod\n      when: rke2_restart_needed\n      delegate_to: localhost\n      run_once: true\n\n- name: Final steps\n  include_tasks: summary.yml' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T08:20:51.566812706Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10463047785, 'load_duration': 101805496, 'prompt_eval_count': 1085, 'prompt_eval_duration': 270427595, 'eval_count': 1099, 'eval_duration': 10089079986, 'model_name': 'llama3.1:8b'} id='run--58d077f9-ebea-439e-abaa-6b121280109b-0' usage_metadata={'input_tokens': 1085, 'output_tokens': 1099, 'total_tokens': 2184}
