--- 

- name: Create ssh_key_directory for user
  become: yes
  become_method: sudo
  become_user: root
  file:
    path: /home/{{ user.name }}/.ssh
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user account
  user:
    name: "{{ user.name }}"
    comment: "{{ user.comment }}"
    home: "{{ user.home | default('/home/{{ user.name }}') }}"
    password: "{{ user.password | password_hash('sha512') if user.password is defined else '' }}"
    uid: "{{ user.uid | default('1000') }}"
    group: "{{ user.group | default('users') }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    state: present
    update_password: always
  register: user_result

- name: Set sudo options for user
  template:
    src: templates/sudo.j2
    dest: /etc/sudoers.d/{{ user.name }}
    mode: '0440'
  notify: restart sudo
  loop: "{{ user }}"
  loop_control:
    label: '{{ item.name }}'

- name: Remove sudo options for user
  file:
    path: /etc/sudoers.d/{{ item.name }}
    state: absent
  loop: "{{ user }}"
  loop_control:
    label: '{{ item.name }}'
  when: item.sudo_options is not defined

- name: Generate private ssh key for user
  command: ssh-keygen -t rsa -N '' -f /home/{{ user.name }}/.ssh/{{ user.name }}_private_key
  become: yes
  become_method: sudo
  become_user: root
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for user
  command: ssh-keygen -y -f /home/{{ user.name }}/.ssh/{{ user.name }}_private_key > /home/{{ user.name }}/.ssh/{{ user.name }}_public_key
  become: yes
  become_method: sudo
  become_user: root
  when: user.manage_ssh_key is defined

- name: Convert ssh key to ppk for user
  command: ssh-keygen -p -m PEM -f /home/{{ user.name }}/.ssh/{{ user.name }}_private_key
  become: yes
  become_method: sudo
  become_user: root
  when: user.manage_ssh_key is defined

- name: Get or set the home directory for user
  set_fact:
    user_home: "{{ lookup('file', '/etc/passwd').split(':')[5] if lookup('file', '/etc/passwd') is defined else '/home' }}"
  when: user.home is not defined

- name: Create .ssh directory for user
  become: yes
  become_method: sudo
  become_user: root
  file:
    path: /home/{{ user.name }}/.ssh
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined or user.private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item.public_key }}"
    keystate: present
  loop: "{{ user.authorized_keys }}"
  loop_control:
    label: '{{ item.public_key }}'
  when: user.manage_ssh_key is defined

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item.public_key }}"
  loop: "{{ user.unauthorized_keys }}"
  loop_control:
    label: '{{ item.public_key }}'
  when: user.manage_ssh_key is defined

- name: Copy generated private ssh key for user
  copy:
    content: "{{ lookup('file', '/home/{{ user.name }}/.ssh/{{ user.name }}_private_key') }}"
    dest: /home/{{ user.name }}/.ssh/{{ user.name }}_private_key
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  shell: grep "{{ user.name }}:" /etc/shadow | cut -d: -f4
  register: password_valid_time
  when: user.password is defined

- name: Set users password valid time
  shell: chage -E "{{ user.password_valid_time }}" "{{ user.name }}"
  when: user.password is defined

- name: Place private key file for user
  copy:
    content: "{{ user.private_keys | default('') }}"
    dest: /home/{{ user.name }}/.ssh/{{ item.name }}
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  loop: "{{ user.private_keys }}"
  loop_control:
    label: '{{ item.name }}'
  when: user.private_keys is defined

