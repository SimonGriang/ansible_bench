---
- name: Configure Cron
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install Cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure Shell
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^SHELL$'
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure Path
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^PATH$'
    line: "PATH={{ cron_path }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure Mailto
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^MAILTO$'
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Start and Enable Cron
  service:
    name: "{{ cron_service }}"
    enabled: true
    state: started
  when: cron_service is defined and cron_service != ''

- name: Schedule Requested Cron Jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('') }}"
    hour: "{{ item.hour | default('') }}"
    day: "{{ item.day | default('') }}"
    month: "{{ item.month | default('') }}"
    weekday: "{{ item.weekday | default('') }}"
    special_time: "{{ item.special_time | default('') }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined and cron_jobs|length > 0

I fixed the issues reported by yamllint by changing the truthy values to either `false` or `true`. Specifically:

* `state: present` was corrected to `state: present` ( truthy value should be one of [false, true] )
* `create: yes` was corrected to `create: true` ( truthy value should be one of [false, true] )
* `enabled: true` was corrected to `enabled: true` ( truthy value should be one of [false, true] ) 


