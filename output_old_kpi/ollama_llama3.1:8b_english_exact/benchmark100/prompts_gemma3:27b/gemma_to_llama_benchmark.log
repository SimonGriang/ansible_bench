    update_packages: true
  notify:
    - Reboot
  when: package_manager == 'pacman'

- name: Configure yum
  yum:
    cache_last_check_seconds: 3600
  handlers:
    - name: Reboot
      reboot:
        msg: 'Rebooting'

- name: Update all software (zypper)
  zypper:
    update: true
  notify:
    - Reboot
  when: package_manager == 'zypper'



