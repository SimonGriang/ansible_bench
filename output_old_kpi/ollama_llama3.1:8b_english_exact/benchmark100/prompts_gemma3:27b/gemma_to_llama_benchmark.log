---
- name: Apache httpd configuration and setup
  tasks:

  - import_tasks: assert.yml

  - name: Install apache httpd
    package:
      name: "{{ httpd_packages }}"
      state: present

  - name: Configure selinux
    selinux:
      policy: targeted
      allow_httpd_anon_write: yes
      allow_httpd_mod_auth: yes
      allow_httpd_sys_content_t: yes
      allow_httpd_sys_rw_content_t: yes
      allow_httpd_user_content_t: yes
      allow_httpd_user_rw_content_t: yes
      allow_httpd_user_exec_t: yes
      allow_httpd_user_rw_exec_t: yes

  - name: Configure httpd
    template:
      src: "{{ httpd_config_src }}"
      dest: "{{ httpd_config_dest }}"
      mode: '0644'
      notify: [ Test httpd configuration validity, Restart httpd ]

  - name: Activate httpd module | Debian
    command:
      cmd: a2enmod {{ item }}
      chdir: /etc/apache2/mods-enabled
    with_items:
      - "{{ httpd_modules_to_activate_with_command }}"

  - import_tasks: ssl.yml
    when: https_ssl_enable == true

  - import_tasks: locations.yml
    when: httpd_locations is defined == true

  - import_tasks: vhosts.yml
    when: httpd_vhosts is defined == true

  - name: Configure ports
    template:
      src: "{{ httpd_ports_conf }}"
      dest: "{{ httpd_server_root }}/ports.conf"
      mode: '0644'
      notify: [ Test httpd configuration validity, Restart httpd ]
    when: (ansible_distribution == "Debian") or (ansible_distribution == "Suse")

  - import_tasks: directories.yml
    when: httpd_directories is defined == true

  - meta: flush_handlers

  - name: Removing default html
    file:
      path: "{{ httpd_data_root }}/index.html"
      state: absent
    when: httpd_remove_example == true

  - name: Start and enable httpd
    service:
      name: "{{ httpd_service }}"
      state: started
      enabled: yes

