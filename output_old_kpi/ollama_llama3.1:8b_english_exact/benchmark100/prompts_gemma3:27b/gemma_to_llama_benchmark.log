content='```yml\n---\n- name: Download RKE2 kubeconfig to localhost\n  fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    flat: yes\n  when:\n    - rke2_download_kubeconf\n    - rke2_servers_group_name | list | first == inventory_hostname\n\n- name: Replace loopback IP by master server IP\n  replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'^(127\\.0\\.0\\.1|::1):\'\n    replace: "{{ rke2_api_ip if rke2_api_ip is defined else inventory_hostname }}"\n  delegate_to: localhost\n  become: false\n  when: ansible_check_mode == False and\n        rke2_download_kubeconf and\n        rke2_servers_group_name | list | first == inventory_hostname\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T08:09:44.412924854Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2416688262, 'load_duration': 112971146, 'prompt_eval_count': 610, 'prompt_eval_duration': 161642251, 'eval_count': 219, 'eval_duration': 2140659415, 'model_name': 'llama3.1:8b'} id='run--74e453e5-e043-44c3-8527-d913c015dfac-0' usage_metadata={'input_tokens': 610, 'output_tokens': 219, 'total_tokens': 829}
