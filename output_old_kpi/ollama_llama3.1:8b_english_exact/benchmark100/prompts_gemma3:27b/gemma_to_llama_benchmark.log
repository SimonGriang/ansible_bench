     setup:\n        gather_subset: "!all"\n\n    - name: Install bootstrap packages\n      package:\n        name: "{{ item }}"\n        state: present\n        update_cache: yes\n      loop: "{{ bootstrap__facts_packages }}"\n      when: bootstrap__facts_packages is defined\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T07:39:14.661193564Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5443627077, 'load_duration': 106711780, 'prompt_eval_count': 611, 'prompt_eval_duration': 150338225, 'eval_count': 497, 'eval_duration': 5185056601, 'model_name': 'llama3.1:8b'} id='run--0f5cbca4-c573-4321-b80d-b819161d81a2-0' usage_metadata={'input_tokens': 611, 'output_tokens': 497, 'total_tokens': 1108}
