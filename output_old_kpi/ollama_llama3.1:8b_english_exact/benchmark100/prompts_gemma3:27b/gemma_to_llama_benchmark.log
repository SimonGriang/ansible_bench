---
- name: Configure sysvinit service
  hosts: all
  become: yes
  vars:
    service_list:
      - name: service1
        enabled: yes
        running: yes
      - name: service2
        enabled: yes
        running: yes
  tasks:
  - name: Configure sysvinit service
    template:
      src: sysvinit.j2
      dest: /etc/init.d/{{ item.name }}
      mode: '0755'
    loop: "{{ service_list }}"
    when: ansible_service_mgr in ['sysvinit', 'upstart', 'openrc']


