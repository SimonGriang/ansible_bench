---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  ansible.builtin.template:
    src: templates/grub_timeout.j2
    dest: /etc/default/grub
    mode: '0644'
  notify: Update grub
  when: grub_timeout is defined

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ansible.builtin.template:
    src: templates/grub_recordfail_timeout.j2
    dest: /etc/default/grub
    mode: '0644'
  notify: Update grub
  when: grub_recordfail_timeout is defined

- name: Add options to GRUB_CMDLINE_LINUX
  block:
    - name: Set grub_options_length
      ansible.builtin.set_fact:
        grub_options_length: "{{ grub_options | length }}"
      when: grub_options is defined and grub_options_length > 0
    - name: Set grub_options_length to 0 when not defined or empty
      ansible.builtin.set_fact:
        grub_options_length: 0
      when: not grub_options is defined or grub_options_length <= 0
    - name: Add options to GRUB_CMDLINE_LINUX
      ansible.builtin.template:
        src: templates/grub_options.j2
        dest: /etc/default/grub
        mode: '0644'
      notify: Update grub
      when: grub_options is defined and grub_options_length > 0

- name: Add kernel command-line option to GRUB_CMDLINE_LINUX
  ansible.builtin.lineinfile:
    dest: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX=".*"'
    line: "GRUB_CMDLINE_LINUX=\"{{ item }}\""
  notify: Update grub
  loop:
    - grub_options
  when: grub_options is defined and grub_options_length > 0

- name: Import password.yml
  ansible.builtin.include_tasks: password.yml
  when: grub_set_password is true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

