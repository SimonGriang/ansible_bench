- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is defined and ansible_distribution != "Container"
  notify: Reboot

- name: Manage selinux booleans
  selinux_boolean:
    name: "{{ item }}"
    state: "{{ selinux_booleans[item].state | default('yes') }}"
    persistent: yes
  loop: "{{ selinux_booleans | dict2items }}"
  when: selinux_booleans is defined

