---
- name: Configure Cron
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install Cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure Shell
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^SHELL'
    line: 'SHELL="{{ cron_shell }}"'
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure Path
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^PATH'
    line: 'PATH="{{ cron_path }}"'
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure Mailto
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^MAILTO'
    line: 'MAILTO="{{ cron_mailto }}"'
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Start and Enable Cron
  service:
    name: "{{ cron_service }}"
    enabled: yes
    state: started
  when: cron_service is defined and cron_service != ''

- name: Schedule Requested Cron Jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('') }}"
    hour: "{{ item.hour | default('') }}"
    day: "{{ item.day | default('') }}"
    month: "{{ item.month | default('') }}"
