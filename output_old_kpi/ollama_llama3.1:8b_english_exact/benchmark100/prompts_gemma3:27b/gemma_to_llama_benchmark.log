--- 

- name: Gather initial facts
  setup: 

- name: Gather initial facts (II)
  raw: cat /etc/os-release
  register: bootstrap_facts

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: ""
    bootstrap_distribution_major_version: ""
  when: 
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - "'{{ bootstrap_facts.stdout | regex_search(regexp_escape(bootstrap_search)) | regex_findall(regexp_escape('(?<=VERSION_ID=").*?(?=")') | string) | first }}" in bootstrap_facts.stdout'
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    label: item.key
  loop_var: bootstrap_search

- name: Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_search | from_yaml | dict.get(bootstrap_distribution) }}"
  loop: "{{ bootstrap_os_family_map | dict2items | group_by('value') }}"
  loop_control:
    label: item.key
  when: bootstrap_distribution in item.value

