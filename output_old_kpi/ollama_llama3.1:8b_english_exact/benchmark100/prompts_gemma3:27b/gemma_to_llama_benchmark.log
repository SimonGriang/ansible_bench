content='```yml\n---\n- name: Tasks\n  tasks:\n  - name: Check OS compatibility\n    become: true\n    block:\n      - name: Check if OS is Amazon Linux 2 or RedHat-based\n        ansible_distribution in [ \'amzn2\', \'RedHat\' ]\n      - name: Check major OS version\n        ansible_distribution_major_version in [\'7\', \'8\', \'9\', \'10\']\n    when: ansible_distribution in [ \'amzn2\', \'RedHat\' ] and ansible_distribution_major_version in [\'7\', \'8\', \'9\', \'10\']\n\n  - name: Install epel gpg key\n    become: true\n    apt_key:\n      url: "{{ epel_gpg_key }}"\n      state: present\n\n  - name: Install epel-release package\n    become: true\n    yum:\n      name: epel-release\n      state: present\n      update_cache: yes\n    notify: Update package cache\n\n  - name: Install epel-next-release package\n    become: true\n    yum:\n      name: epel-next-release\n      state: present\n      update_cache: yes\n    when: epel_next == true\n    notify: Update package cache\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-07T08:57:02.823072976Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2365125636, 'load_duration': 110169833, 'prompt_eval_count': 445, 'prompt_eval_duration': 23681889, 'eval_count': 257, 'eval_duration': 2230102074, 'model_name': 'llama3.1:8b'} id='run--c0873d46-4ef0-45f9-b8fd-3541be08a529-0' usage_metadata={'input_tokens': 445, 'output_tokens': 257, 'total_tokens': 702}
