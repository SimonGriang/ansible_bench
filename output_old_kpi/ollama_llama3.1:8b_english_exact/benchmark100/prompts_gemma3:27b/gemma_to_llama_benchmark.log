---
- name: Configure Cron
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install Cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure Shell
  ansible.builtin.lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^SHELL$'
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: '0600'
  notify: Restart cron

- name: Configure Path
  ansible.builtin.lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^PATH$'
    line: "PATH={{ cron_path }}"
    create: true
    mode: '0600'
  notify: Restart cron

- name: Configure Mailto
  ansible.builtin.lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: '^MAILTO$'
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: '0600'
  notify: Restart cron

- name: Start and Enable Cron
  ansible.builtin.service:
    name: "{{ cron_service }}"
    enabled: true
    state: started
  when: cron_service is defined and cron_service != ''

- name: Schedule Requested Cron Jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('') }}"
    hour: "{{ item.hour | default('') }}"
    day: "{{ item.day | default('') }}"
    month: "{{ item.month | default('') }}"
    weekday: "{{ item.weekday | default('') }}"
    special_time: "{{ item.special_time | default('') }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined and cron_jobs|length > 0

