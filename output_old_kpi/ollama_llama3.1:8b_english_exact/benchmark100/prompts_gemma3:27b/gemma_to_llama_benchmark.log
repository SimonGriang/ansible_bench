---
- name: Check OS compatibility
  assert:
    that: "'Amazon Linux 2' in {{ ansible_distribution }} or (ansible_distribution in ['RedHat', 'CentOS', 'Fedora'] and ansible_major_version in ['7', '8', '9'])"

- name: Install epel gpg key
  rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install epel-release package
  dnf:
    name: epel-release
    state: present
    repo: "{{ epel_url }}"
  notify: Update package cache

- name: Install epel-next-release package
  dnf:
    name: epel-next-release
    state: present
    repo: "{{ epel_next_url }}"
  when: epel_next
  notify: Update package cache

