---

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Pre-configure debian systems
  become: true
  debconf:
    name: postfix
    set: mailer_type=No configuration

- name: Install postfix
  become: true
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  become: true
  apt:
    name: postfix-mysql
    state: present
  when: (virtual_mailbox_maps|virtual_mailbox_domains) is defined and (virtual_mailbox_maps|virtual_mailbox_domains) is mysql

- name: Configure postfix (transport_maps)
  become: true
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  notify: [ validation, database_rebuild ]

- name: Configure postfix (header_checks)
  become: true
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify: [ validation, postfix_reload ]

- name: Setting values for main.cf (1/2)
  become: true
  set_fact:
    {{ item.key }}: "{{ item.value }}"
  with_dict: "{{ postfix_main_cf_settings }}"
  when: item.value is defined

- name: Setting values for main.cf (2/2)
  become: true
  set_fact:
    {{ item.key }}: "{{ item.value }}"
  with_dict: "{{ postfix_main_cf_settings }}"
  when: item.value is defined

- name: Configure postfix (main.cf)
  become: true
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify: [ validation, postfix_restart ]

- name: Configure postfix (master.cf)
  become: true
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify: [ validation, postfix_restart ]

- name: Creates cert/key directory
  become: true
  file:
    path: /path/to/cert/key
    state: directory
  when: key_directory is defined

- name: Deploy Postfix TLS server certificate
  become: true
  copy:
    content: "{{ postix_tls_server_certificate }}"
    dest: /path/to/cert/key/certificate.crt
    mode: '0644'

- name: Deploy Postfix TLS server key
  become: true
  copy:
    content: "{{ postix_tls_server_key }}"
    dest: /path/to/cert/key/key.key
    mode: '0644'

- name: Flush handlers
  become: true
  meta:
    flush_handlers: yes

- name: Configure aliases
  become: true
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: '0644'

- name: Configure sender_access
  become: true
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'

- name: Configure recipient_access
  become: true
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'

- name: Place sasl_password_map
  become: true
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    mode: '0644'
    group: postfix
    owner: postfix

- name: Flush handlers again
  become: true
  meta:
    flush_handlers: yes

- name: Start and enable postfix
  become: true
  service:
    name: postfix
    state: started
    enabled: yes

