---
- name: Ensure the easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize the easy-rsa PKI
  command: easyrsa --batch --cwd /etc/openvpn/easy-rsa init-pki
  when: not file.exists("/etc/openvpn/easy-rsa/pki")

- name: Build the Certificate Authority (CA)
  command: easyrsa --batch --cwd /etc/openvpn/easy-rsa build-ca nopass
  when: not file.exists("/etc/openvpn/easy-rsa/pki/ca.crt")

- name: Generate Diffie-Hellman parameters
  command: easyrsa --batch --cwd /etc/openvpn/easy-rsa gen-dh
  when: not file.exists("/etc/openvpn/easy-rsa/pki/dh.pem")

- name: Build the server certificate
  command: easyrsa --batch --cwd /etc/openvpn/easy-rsa build-server-full server nopass
  when: not file.exists("/etc/openvpn/easy-rsa/pki/issued/server.crt")

- name: Build the client certificate
  command: easyrsa --batch --cwd /etc/openvpn/easy-rsa build-client-full client nopass
  when: not file.exists("/etc/openvpn/easy-rsa/pki/issued/client.crt")

- name: Generate the Certificate Revocation List (CRL)
  command: easyrsa --batch --cwd /etc/openvpn/easy-rsa gen-crl
  when: not file.exists("/etc/openvpn/easy-rsa/pki/crl.pem")

- name: Generate TLS authentication key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  when: not file.exists("/etc/openvpn/easy-rsa/pki/ta.key")

- name: Copy PKI files to the server configuration directory
  file:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server
    state: file
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - client.crt
    - server.crt
    - ca.key
    - client.key
    - server.key

- name: Copy ca.crt and ta.key to /etc/openvpn
  file:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn
    state: file
    mode: '0640'
  loop:
    - ca.crt
    - ta.key

- name: Place the server configuration file
  template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server.conf
    state: file
    mode: '0640'
    owner: openvpn
    group: openvpn
  notify: Restart openvpn


