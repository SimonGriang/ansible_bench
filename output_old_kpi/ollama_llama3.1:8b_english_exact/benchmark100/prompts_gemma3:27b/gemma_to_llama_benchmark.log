--- 

- name: Enable Apache modules
  become: yes
  when: ansible_distribution == 'Debian' or ansible_distribution == 'Suse'
  community.general.apache2_module:
    state: present
    name: proxy
  community.general.apache2_module:
    state: present
    name: proxy_http

- name: Configure Apache locations
  become: yes
  loop: "{{ httpd_locations }}"
  template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

