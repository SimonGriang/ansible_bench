---
- name: Load OS-specific variables
  include_vars:
    file: "{{ lookup('first_found', ['os_specific', 'default']) }}"
    name: "{{ os_family }}_specific"

- name: Include RedHat setup tasks
  include_tasks: redhat_setup.yml
  when: ansible_facts.os_family == 'RedHat'

- name: Include Debian setup tasks
  include_tasks: debian_setup.yml
  when: ansible_facts.os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    notify: restart docker
    ignore_errors: true
  when: (ansible_version < '2.12' or ansible_facts.os_family not in ['RedHat', 'Debian'])

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "present"
    notify: restart docker
    ignore_errors: true
  when: (ansible_version >= '2.12' and ansible_facts.os_family in ['RedHat', 'Debian'])

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    notify: restart docker
    ignore_errors: true
  when: docker_install_compose_plugin and (ansible_version < '2.12' or ansible_facts.os_family not in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "present"
    notify: restart docker
    ignore_errors: true
  when: docker_install_compose_plugin and (ansible_version >= '2.12' and ansible_facts.os_family in ['RedHat', 'Debian'])

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options

- name: Configure Docker daemon options
  template:
    src: docker/daemon.json.j2
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state | default('started') }}"
    enabled: "{{ docker_service_enabled | default(true) }}"
    ignore_errors: true

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    name: docker

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ docker_users | difference(getent.group(docker).members) | length > 0 }}"

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify


