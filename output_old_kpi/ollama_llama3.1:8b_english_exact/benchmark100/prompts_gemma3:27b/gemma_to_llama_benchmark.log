---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
  notify:
    - Gather facts

- name: Flush handlers
  meta:
    flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when:
    - ansible_selinux.status is defined
    - ansible_distribution != "container"
  notify:
    - Reboot

- name: Manage selinux booleans
  selinux_boolean:
    name: "{{ item.key }}"
    state: "{{ item.value.state | default('yes') }}"
    persistent: yes
  loop: "{{ selinux_booleans | dict2items }}"
  when: selinux_booleans is defined


