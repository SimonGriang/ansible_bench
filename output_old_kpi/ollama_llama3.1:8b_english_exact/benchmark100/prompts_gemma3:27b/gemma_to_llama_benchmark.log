---
- name: Configure Java
  tasks:
  - name: Migrate from adoptopenjdk to temurin if selected
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "vars/{{ java_jdk_vendor }}.yml"
      name: "java_os_{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}"
    when: java_jdk_vendor == "adoptopenjdk" or java_jdk_vendor == "temurin"

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"
      name: "java_architecture_{{ ansible_architecture }}"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_version: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_version | default('8') }}"
      java_open_jdk_repositories: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_repositories | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome', 'ppa:openjdk/temurin']) }}"
      java_open_jdk_libs: "{{ java_os_adoptopenjdk_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_libs | default(['libgcj-dev', 'libstdc++6-dev']) }}"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_version: "{{ java_os_temurin_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_version | default('11') }}"
      java_open_jdk_repositories: "{{ java_os_temurin_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_repositories | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome', 'ppa:openjdk/temurin']) }}"
      java_open_jdk_libs: "{{ java_os_temurin_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.java_open_jdk_libs | default(['libgcj-dev', 'libstdc++6-dev']) }}"
    when: java_jdk_vendor == "temurin"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_architecture_x86_64.java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
      java_open_jdk_package: "{{ java_architecture_x86_64.java_open_jdk_package | default('openjdk-11-jdk') }}"
    when: java_architecture == "x86_64"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_architecture_arm64.java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
      java_open_jdk_package: "{{ java_architecture_arm64.java_open_jdk_package | default('openjdk-11-jdk') }}"
    when: java_architecture == "arm64"

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home_dir }}/{{ java_open_jdk_package }}"

  - name: Remove deprecated repositories (Debian)
    apt:
      name: "{{ java_deprecated_repositories_adoptopenjdk | default(['ppa:openjdk/riscv64', 'ppa:openjdk/rome']) }}"
      state: absent
    when: ansible_distribution == "Debian"

  - name: Install extra apt tools (Debian)
    apt:
      name: "{{ java_open_jdk_apt_extra_packages | default(['apt-transport-https', 'ca-certificates']) }}"
      state: present
    when: ansible_distribution == "Debian"

  - name: Add required key repositories (Debian)
    apt_key:
      keyserver: "{{ java_required_key_repositories_openjdk | default('hkp://keyserver.ubuntu.com') }}"
      keyid: "{{ java_required_key_repositories_openjdk | default('9DC8 5822 9FC7 DD38 854E E2D9 8DCA 6FEB E289 6CE5') }}"
      state: present
    when: ansible_distribution == "Debian"

  - name: Add required repositories (Debian)
    apt_repository:
      repo: "{{ java_required_repositories_openjdk | default('ppa:openjdk/riscv64') }}"
      state: present
    when: ansible_distribution == "Debian"

  - name: Add required key repositories (RedHat)
    rpm_key:
      state: present
      key: "{{ java_required_key_repositories_openjdk | default('9DC8 5822 9FC7 DD38 854E E2D9 8DCA 6FEB E289 6CE5') }}"
    when: ansible_distribution == "RedHat"

  - name: Add required repositories (RedHat)
    yum_repository:
      name: "{{ java_required_repositories_openjdk | default('openjdk') }}"
      description: "{{ java_required_repositories_openjdk | default('OpenJDK Repository') }}"
      gpgcheck: yes
      gpgkey: "{{ java_required_key_repositories_openjdk | default('https://www.openjdk.org/repositories/mirrorlist') }}"
      state: present
    when: ansible_distribution == "RedHat"

  - name: Install required libs
    package:
      name: "{{ java_required_libs_openjdk | default(['libgcj-dev', 'libstdc++6-dev']) }}"
      state: present

  - name: Install Java (Debian)
    apt:
      name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}-{{ java_architecture }}-{{ ansible_distribution_major_version }}"
      state: present

  - name: Install Java (RedHat)
    yum:
      name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}-{{ java_architecture }}-{{ ansible_distribution_major_version }}"
      state: present

  - name: Export environment variables
    template:
      src: templates/jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: '0644'

  - name: Source environment variables
    shell: source /etc/profile

  - name: Correct java version selected (Debian, Java < 11)
    shell: update-alternatives --set java /usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java
    when: java_open_jdk_version < 11 and ansible_distribution == "Debian"

  - name: Correct java version selected (Debian, Java >= 11)
    shell: update-alternatives --set java /usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java
    when: java_open_jdk_version >= 11 and ansible_distribution == "Debian"

