---
- name: Task 1: Import assert tasks file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2: Uninstall conflicting systemd-logger package
  package:
    name: systemd-logger
    state: absent

- name: Task 3: Install rsyslog packages
  package:
    name: "{{ rsyslog_packages }}"
    state: "{{ rsyslog_package_state }}"

- name: Task 4: Install additional rsyslog features
  package:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_features | map('upper') | list }}"
  notify: restart rsyslog

- name: Task 5: Configure default rsyslog configuration
  template:
    src: "{{ rsyslog_config_file_format }}"
    dest: "{{ rsyslog_dest_conf_file }}"
    mode: '0644'
  when: rsyslog_deploy_default_config
  notify: restart rsyslog

- name: Task 6: Create the rsyslog.d directory
  file:
    path: '/etc/rsyslog.d/'
    state: directory
    mode: '0755'

- name: Task 7: Configure rsyslog forward rule
  template:
    src: 'forward_rule.conf.j2'
    dest: '/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf'
    mode: '0644'
  when: rsyslog_deploy_default_config
  notify: restart rsyslog

- name: Task 8: Configure additional rsyslog config files
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  loop: "{{ rsyslog_rsyslog_d_files | items }}"
  when: item.state
  notify: restart rsyslog

- name: Task 9: Start and enable rsyslog service
  service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: yes


