---
- name: Run assert tasks
  ansible.builtin.assert:
    module_path: '{{ lookup("ansible.builtin.file", "assert.yml") }}'
    content: ''
  delegate_to: localhost
  run_once: true

- name: Install vsftpd package
  ansible.builtin.package:
    name: vsftpd
    state: present

- name: Configure vsftpd using a template
  ansible.builtin.template:
    src: vsftpd.conf.j2
    dest: '{{ vsftpd_configuration_file }}'
    mode: '{{ vsftpd_configuration_file_mode }}'
    owner: root
    group: root
    notify: Restart vsftpd
  when: vsftpd_configuration_file is defined

- name: Start and enable vsftpd service
  ansible.builtin.service:
    name: vsftpd
    state: started
    enabled: true


