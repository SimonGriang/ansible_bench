- name: Prepare summary
  hosts: rke2_servers_group_name
  gather_facts: no

  tasks:
  - name: Retrieve Kubernetes node information
    shell: kubectl get nodes --kubeconfig=/etc/rancher/rke2/rke2.yaml --v=4 -o wide
    args:
      chdir: "{{ rke2_data_path }}"
      executable: /bin/bash
    register: nodes_summary
    retry: 5

  - name: Display the standard output lines of the nodes_summary variable
    debug:
      var: nodes_summary.stdout_lines


