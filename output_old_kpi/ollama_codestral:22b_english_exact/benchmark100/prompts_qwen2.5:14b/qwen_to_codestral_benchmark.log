     delegate_to: localhost
     run_once: true

   - name: Wait for port to be available
     wait_for:
       port: "{{ specified_port }}"
       timeout: "{{ bootstrap_timeout }}"
     connection: "{{ specified_connection }}"

   - name: Prepare system
     become: true
     become_user: root
     become_flags: "-H"
     connection: local
     action: setup

   - name: Gather bootstrap facts
     setup:
     when: ansible_failed_result

   - name: Install bootstrap packages (raw)
     raw: "{{ bootstrap_install_command }}"
     when: ansible_os_family != 'RedHat' and ansible_os_family != 'Fedora'

   - name: Ensure libdnf5 is present on Fedora/RedHat
     package:
       name: libdnf5
       state: present
     when: ansible_os_family == 'RedHat' or ansible_os_family == 'Fedora'

   - name: Gather ansible facts
     setup:

   - name: Install bootstrap packages (package)
     package:
       name: "{{ bootstrap_packages }}"
       state: present
       update_cache: true

