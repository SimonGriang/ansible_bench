---
- name: Restart RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready
  command: "kubectl wait --for=condition=Ready nodes --all --timeout=900s"
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  changed_when: false
  check_mode: true

- name: Wait for all pods to be ready
  command: "kubectl wait --for=condition=Ready pods --all --all-namespaces --timeout=900s"
