 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
       state: present

   - name: Configure mysql server
     ini_file:
       path: "{{ mysql_configuration_file }}"
       section: mysqld
       option: "{{ item.option }}"
       value: "{{ item.value }}"
       create: yes
     with_items: "{{ mysql_configuration_options }}"
     notify: Restart mysql

   - name: Configure mysql client
     ini_file:
       path: "{{ mysql_client_configuration_file }}"
       section: client
       option: socket
       value: "{{ mysql_socket }}"
       create: yes

   - name: Initialize mysql
     command: mysql_install_db
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"
     notify: Restart mysql

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Place my.cnf
     copy:
       src: my.cnf
       dest: /etc/mysql/my.cnf
       mode: 0644

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
     with_items: "{{ mysql_databases }}"
     when: item.initial_import is not defined or item.initial_import != "true"

   - name: List databases
     command: mysql -e "SHOW DATABASES;"
     register: databases
     changed_when: false

   - name: Import database
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.initial_import }}"
     with_items: "{{ mysql_databases }}"
     when: item.initial_import is defined and item.initial_import != "false" and item.name not in databases.stdout

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
     with_items: "{{ mysql_users }}"
     no_log: true

   - name: Flush handlers
     meta: flush_handlers

   - name: Flush handlers again
     meta: flush_handlers

