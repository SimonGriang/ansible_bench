---
- name: Import assert
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes
      notify: Reboot
    - name: Upgrade all apk packages
      apk:
        upgrade: yes
      notify: Reboot

- name: Configure apt
  block:
    - name: Prevent apt upgrade for selected packages
      dpkg_selections:
        name: "{{ item }}"
        selection: hold
      with_items:
        - package1
        - package2
