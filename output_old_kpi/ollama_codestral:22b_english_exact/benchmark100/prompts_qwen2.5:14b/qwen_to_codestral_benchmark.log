 - name: Remove Docker apt key
    file:
      path: /etc/apt/trusted.gpg.d/docker.gpg
      state: absent

  - name: Remove old Docker source list file
    file:
      path: /etc/apt/sources.list.d/docker.list
      state: absent

  - name: Uninstall old versions of Docker
    apt:
      name: docker
      state: absent

  - name: Remove legacy Docker repository file
    file:
      path: /etc/apt/sources.list.d/docker.list.save
      state: absent

  - name: Install necessary dependencies
    apt:
      name: ['apt-transport-https', 'ca-certificates', 'python3-debian']
      state: present

  - name: Add or remove Docker repository
    apt_repository:
      repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_lsb.id | lower }} {{ ansible_lsb.codename }} stable"
      state: "{{ docker_add_repo }}"
    notify: Update apt cache

  - name: Update apt cache
    apt:
      update_cache: yes
    changed_when: false

  - name: Flush handlers
    meta: flush_handlers

