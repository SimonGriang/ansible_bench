---
   - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_install_script_url }}"
       dest: "{{ rke2_bin_path }}/rke2-install.sh"
       mode: "{{ rke2_download_mode }}"
       timeout: "{{ rke2_download_timeout }}"

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_install_script }}"
       dest: "{{ rke2_bin_path }}/rke2-install.sh"
       mode: "0700"
       force: yes
     when: rke2_airgap_mode is defined and rke2_airgap_implementation is defined

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifacts_path }}"
       state: directory
       mode: "0700"
     when: rke2_airgap_mode != "exists" and rke2_airgap_implementation != "exists"

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Download RKE2 checksum file
         get_url:
           url: "{{ rke2_checksum_url }}"
           dest: "{{ rke2_artifacts_path }}"
       - name: Download RKE2 artifacts
         get_url:
           url: "{{ item }}"
           dest: "{{ rke2_artifacts_path }}"
           checksum: "sha256:{{ lookup('file', rke2_checksum_file) }}"
         with_items: "{{ rke2_artifact_urls }}"
       - name: Download RKE2 install script
         get_url:
           url: "{{ rke2_install_script_url }}"
           dest: "{{ rke2_artifacts_path }}"
     when: rke2_airgap_mode == "download" and rke2_airgap_implementation == "download"

   - name: Rescue for failed download
     block:
       - name: Create local directory for RKE2 artifacts
         file:
           path: "{{ local_rke2_artifacts_path }}"
           state: directory
       - name: Download RKE2 artifacts and install script locally
         get_url:
           url: "{{ item }}"
           dest: "{{ local_rke2_artifacts_path }}"
         with_items: "{{ rke2_artifact_urls + [rke2_install_script_url] }}"
       - name: Copy RKE2 artifacts to remote hosts
         copy:
           src: "{{ local_rke2_artifacts_path }}/"
           dest: "{{ rke2_artifacts_path }}"
     rescue:
       - debug:
           msg: "Failed to download RKE2 artifacts, using locally copied artifacts"

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ local_rke2_artifacts_path }}/"
       dest: "{{ rke2_artifacts_path }}"
       mode: "0640"
       force: yes
     when: rke2_airgap_mode == "copy" and rke2_airgap_implementation == "copy"

   - name: Airgap mode - additional images tarballs
     block:
       - name: Create folder for additional images tarballs
         file:
           path: "{{ rke2_additional_tarballs_path }}"
           state: directory
       - name: Copy additional images tarballs to RKE2 tarball images path
         copy:
           src: "{{ item }}"
           dest: "{{ rke2_tarball_images_path }}"
         with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
     when: rke2_airgap_mode is defined and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != "exists"

   - name: Ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ item }}"
       state: file
       mode: "0640"
     with_items: "{{ rke2_artifacts + [rke2_install_script] }}"
     when: rke2_airgap_mode == "exists" and rke2_airgap_implementation == "exists"

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: "/usr/local"
     register: usr_local_stat

   - name: Check if separate partition
     shell: "grep '/usr/local' /proc/mounts"
     register: mount_output

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if mount_output.stdout_lines | length > 0 else '/var/lib/rancher/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version"
     register: rke2_version
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       rke2_installed_version: "{{ rke2_version.stdout_lines[0].split(':')[1].strip() }}"
       rke2_running_version: "{{ ansible_facts['services']['rke2-server.service']['state'] == 'running' | ternary(rke2_version.stdout_lines[0].split(':')[1].strip(), '') }}"
     when: not ansible_check_mode

   - name: Prevent accidental RKE2 downgrade
     fail:
       msg: "Downgrading RKE2 is not allowed"
     when: rke2_installed_version is defined and rke2_running_version is defined and rke2_installed_version != rke2_running_version and rke2_installed_version < rke2_running_version and not allow_rke2_downgrade

   - name: Run RKE2 install script
     shell: "{{ rke2_bin_path }}/rke2-install.sh {{ rke2_airgap_install_options if rke2_airgap_mode is defined else '' }}"
     when: rke2_version.stdout_lines[0].split(':')[1].strip() != rke2_installed_version and not ansible_check_mode

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/manifests/custom/"
     with_fileglob: "{{ rke2_custom_manifests_path }}/*"
     when: rke2_custom_manifests_path is defined and rke2_custom_manifests_path | length > 0

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_agent_pod_manifests_path }}/"
     with_fileglob: "{{ rke2_static_pods_path }}/*"
     when: rke2_static_pods_path is defined and rke2_static_pods_path | length > 0

   - name: Copy RKE2 environment file
     copy:
       src: "{{ rke2_environment_file }}"
       dest: "/etc/default/rke2"
     when: rke2_environment_options is defined and rke2_environment_options | length > 0
   

