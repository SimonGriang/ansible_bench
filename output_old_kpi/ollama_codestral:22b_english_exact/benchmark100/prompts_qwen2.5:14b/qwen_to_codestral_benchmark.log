 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install requirements
     package:
       name: bash
       state: present

   - name: Install openjdk java (package)
     package:
       name: openjdk-jdk
       state: present
     when: java_vendor == "openjdk"

   - name: Install RPM
     yum:
       name: /path/to/java_package.rpm
       state: present

   - name: Install DEB
     apt:
       deb: /path/to/java_package.deb
       state: present

   - name: Install oracle java (rpm) (repository)
     yum:
       name: oracle-java
       state: present

   - name: Configure oracle targz
     unarchive:
       src: /path/to/java_package.tgz
       dest: /usr/lib/jvm/
       remote_src: yes
       creates: /usr/lib/jvm/java-version-folder

   - name: Install oracle java policy software (targz)
     unarchive:
       src: /path/to/jce_policy_files.tgz
       dest: /usr/lib/jvm/java-version-folder/lib/security
       remote_src: yes

   - name: Set alternative (targz)
     alternatives:
       name: java
       link: /usr/bin/java
       path: /usr/lib/jvm/java-version-folder/bin/java
     when: ansible_os_family != "Alpine"

   - name: Find JAVA_HOME
     shell: "readlink -f /usr/bin/java | sed 's:/bin/java::'"
     register: java_home

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/environment
       regexp: '^JAVA_HOME='
       line: 'JAVA_HOME={{ java_home.stdout }}'
     when: java_home.stdout != ""

