---
   - name: Create the RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: server_type == 'server'

   - name: Copy RKE2 configuration file
     template:
       src: config.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
     notify: Config file changed

   - name: Copy kubelet configuration file
     template:
       src: kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
     when: rke2_kubelet_config != ""
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yaml.j2
       dest: /etc/rancher/rke2/registries.yaml
     when: rke2_custom_registry_mirrors != "" or
           rke2_custom_registry_configs != ""
     notify: Config file changed

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when: >
       rke2_etcd_snapshot_file != "" and
       (ansible_facts['services']['rke2-server.service'] is not defined or
       ansible_facts['services']['rke2-server.service']['state'] != "running")

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when: >
       rke2_etcd_snapshot_file != "" and
       rke2_etcd_snapshot_s3_options is defined and
       rke2_etcd_snapshot_s3_options.access_key is defined and
       rke2_etcd_snapshot_s3_options.secret_key is defined and
       rke2_etcd_snapshot_s3_options.bucket is defined and
       rke2_etcd_snapshot_s3_options.snapshot_name is defined

   - name: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/
       - command: >
           /var/lib/rancher/rke2/bin/kubectl etcd snapshot restore
           /var/lib/rancher/rke2/server/db/snapshots/{{ rke2_etcd_snapshot_file }}
     when: do_etcd_restore is defined

   - name: Restore etcd from s3
     command: >
       /var/lib/rancher/rke2/bin/kubectl etcd snapshot restore s3://{{
       rke2_etcd_snapshot_s3_options.bucket }}/{{
       rke2_etcd_snapshot_s3_options.snapshot_name }} --s3-access-key-id={{
       rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-access-key={{
       rke2_etcd_snapshot_s3_options.secret_key }}
     when: do_etcd_restore_from_s3 is defined

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     when: inventory_hostname == groups['rke2_cluster_group_name'][0]

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       state: stopped
       enabled: no
       masked: yes
     when: inventory_hostname == groups['rke2_cluster_group_name'][0]

   - name: Wait for the first server be ready - no CNI
     command: >
       /var/lib/rancher/rke2/bin/kubectl get nodes {{ inventory_hostname }}
       -o jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}'
     register: result
     until: result.stdout == "True"
     retries: 30
     delay: 10
     when: inventory_hostname == groups['rke2_cluster_group_name'][0]

   - name: Wait for the first server be ready - with CNI
     command: >
       /var/lib/rancher/rke2/bin/kubectl get nodes {{ inventory_hostname }}
       -o jsonpath='{.status.conditions[?(@.type==\"NetworkUnavailable\")].status}'
     register: result
     until: result.stdout == "False"
     retries: 30
     delay: 10
     when: inventory_hostname == groups['rke2_cluster_group_name'][0]

   - name: Restore etcd
     block:
       - command: /var/lib/rancher/rke2/bin/kubectl get nodes -o json
         register: nodes
       - set_fact:
           nodes_list: "{{ nodes.stdout | from_json }}"
       - command: >
           /var/lib/rancher/rke2/bin/kubectl delete secret {{ item.metadata.name }}
         loop: "{{ nodes_list.items }}"
         when: item.metadata.labels['node.cattle.io/etcd'] == 'true'
       - command: >
           /var/lib/rancher/rke2/bin/kubectl delete node {{ item.metadata.name }}
         loop: "{{ nodes_list.items }}"
         when: item.metadata.labels['node.cattle.io/etcd'] == 'true'
     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     with_items: "{{ groups['rke2_cluster_group_name'] }}"

