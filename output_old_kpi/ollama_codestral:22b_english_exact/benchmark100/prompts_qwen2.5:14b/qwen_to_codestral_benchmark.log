---
   - name: Import assertions
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Wait for port to be available
     wait_for:
       port: "{{ item }}"
       timeout: "{{ bootstrap_timeout }}"
     loop: "{{ bootstrap_ports }}"
     connection: "{{ bootstrap_connection }}"

   - name: Prepare system
     raw: /bin/true
     become: true
     become_user: root
     become_method: sudo
     register: prepare_system_result
     ignore_unreachable: true
     ignore_errors: true

   - name: Gather bootstrap facts
     setup:
     when: prepare_system_result is failed

   - name: Install bootstrap packages (raw)
     raw: |
       {% if ansible_os_family == 'RedHat' %}
       yum install -y {{ bootstrap_packages }}
       {% elif ansible_os_family == 'Debian' %}
       apt-get install -y --force-yes {{ bootstrap_packages }}
       {% endif %}
     when: prepare_system_result is failed

   - name: Ensure libdnf5 is present on Fedora/RedHat
     package:
       name: libdnf5
       state: present
     when: ansible_distribution in ['Fedora', 'RedHat']

   - name: Gather ansible facts
     setup:

   - name: Install bootstrap packages (package)
     package:
       name: "{{ bootstrap_packages }}"
       state: present
       update_cache: yes

