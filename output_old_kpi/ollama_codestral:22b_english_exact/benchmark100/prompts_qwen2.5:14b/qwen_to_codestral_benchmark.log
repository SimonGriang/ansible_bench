        name: find_active_server

    - name: Enable IPVS kernel module
      when: ha_enabled and not use_keepalived
      community.general.modprobe:
        name: ip_vs
        state: present

    - name: Copy kube-vip manifests to the masternode
      when: not use_keepalived
      ansible.builtin.copy:
        src: kube-vip-manifests
        dest: /etc/rancher/rke2/manifests/

    - name: Copy ingress-nginx manifests to the masternode
      when: ingress_nginx_config is defined
      ansible.builtin.copy:
        src: ingress-nginx-manifests
        dest: /etc/rancher/rke2/manifests/

    - name: Prepare very first server node in the cluster
      ansible.builtin.include_role:
        name: prepare_first_server

    - name: Restore etcd specific tasks
      when: etcd_restore_needed
      ansible.builtin.include_role:
        name: restore_etcd

    - name: Download kubeconfig to ansible localhost
      when: kubeconfig_download_enabled
      ansible.builtin.fetch:
        src: /etc/rancher/rke2/rke2.yaml
        dest: /tmp/rke2.yaml
        flat: yes

    - name: Prepare and join remaining nodes of the cluster
      when: active_server is defined
      ansible.builtin.include_role:
        name: join_nodes

    - name: Rolling cordon and drain restart when version changes - servers
      when: rke2_version_changed
      ansible.builtin.include_role:
        name: rolling_restart_servers

    - name: Rolling cordon and drain restart when version changes - agents
      when: rke2_version_changed
      ansible.builtin.include_role:
        name: rolling_restart_agents

    - name: Flush handlers
      ansible.builtin.meta: flush_handlers

    - name: Rolling restart when config files change
      when: config_files_changed
      ansible.builtin.include_role:
        name: rolling_restart_config

    - name: Final steps
      ansible.builtin.include_role:
        name: final_steps

