---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'No configuration'
    vtype: select

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: >
    'mysql' in postfix_virtual_mailbox_maps or
    'mysql' in postfix_virtual_mailbox_domains or
    'mysql' in postix_virtual_alias_maps

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
  notify:
    - Validate postfix configuration
    - Rebuild transport_maps database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate postfix configuration
    - Reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions_base }}, {{ postfix_smtpd_recipient_restrictions_extra }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions_base }}, {{ postfix_smtpd_sender_restrictions_extra }}"
  when:
    - postfix_smtpd_recipient_restrictions_extra is defined
    - postfix_smtpd_sender_restrictions_extra is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: "{{ postfix_mynetworks_extra }}"
    postfix_mydestination: "{{ postfix_mydestination_extra }}"
    postfix_relay_domains: "{{ postfix_relay_domains_extra }}"
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions_base }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions_base }}"
    postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains_extra }}"
    postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains_extra }}"
  when:
    - postfix_mynetworks_extra is defined
    - postfix_mydestination_extra is defined
    - postfix_relay_domains_extra is defined
    - postfix_virtual_mailbox_domains_extra is defined
    - postfix_virtual_alias_domains_extra is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ item | dirname }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  loop:
    - "{{ postfix_smtpd_tls_cert_file }}"
    - "{{ postfix_smtpd_tls_key_file }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file }}"
    dest: "/etc/postfix/{{ postfix_smtpd_tls_cert_file | basename }}"
    owner: root
    group: root
    mode: 0644
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file }}"
    dest: "/etc/postfix/{{ postfix_smtpd_tls_key_file | basename }}"
    owner: root
    group: root
    mode: 0600
  notify:
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify:
    - Validate postfix configuration
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_passwd
    owner: root
    group: root
    mode: 0600
  notify:
    - Rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


