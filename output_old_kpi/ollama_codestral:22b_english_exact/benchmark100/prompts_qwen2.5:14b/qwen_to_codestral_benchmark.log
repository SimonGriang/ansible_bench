       name: "{{ git_packages }}"
       state: present

   - name: See if the specified user exists
     getent:
       key: passwd
       database: "{{ git_user }}"

   - name: Create directory for git configuration
     file:
       path: "{{ git_user_home }}/.config/git"
       state: directory
       owner: "{{ git_user }}"
       group: "{{ git_user }}"
       mode: 0755
     when: git_user is defined and git_user_home is defined and getent_passwd[git_user]

   - name: Place git configuration
     template:
       src: gitconfig.j2
       dest: "{{ git_user_home }}/.gitconfig"
       owner: "{{ git_user }}"
       group: "{{ git_user }}"
       mode: 0644
     when: git_user is defined and git_user_home is defined and getent_passwd[git_user] and git_config is defined

