     file:
       path: "{{ repository_destination }}"
       state: directory
       owner: "{{ git_user }}"
       group: "{{ git_user }}"
       mode: 0755
     when: repository_destination is defined and getent_passwd[git_user]

   - name: Clone all roles
     git:
       repo: "{{ item.repo }}"
       dest: "{{ repository_destination }}/{{ item.dest }}"
       version: "{{ item.version | default('HEAD') }}"
     become: yes
     become_user: "{{ git_user }}"
     loop: "{{ git_repositories }}"
     when: repository_destination is defined and getent_passwd[git_user] and git_repositories is defined

