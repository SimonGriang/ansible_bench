 - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory

   - name: Set server taints
     command: >-
       kubectl taint nodes
       {{ inventory_hostname }}
       node-role.kubernetes.io/rke2-server:NoSchedule={{ rke2_type }}-server
     when: rke2_type == 'server'

   - name: Set agent taints
     command: >-
       kubectl taint nodes
       {{ inventory_hostname }}
       node-role.kubernetes.io/rke2-agent:NoSchedule={{ rke2_type }}-agent
     when: rke2_type == 'agent'

   - name: Copy RKE2 config file
     copy:
       src: files/rke2-config.yaml
       dest: /etc/rancher/rke2/config.yaml
     notify: restart rke2

   - name: Copy kubelet config file
     copy:
       src: files/kubelet-config.yaml
       dest: /etc/rancher/kubelet/kubelet-config.yaml
     when: >-
       kubelet_config_content is defined and
       kubelet_config_content | length > 0
     notify: restart rke2

   - name: Copy Containerd Registry Configuration file
     copy:
       src: files/registries.yaml
       dest: /etc/rancher/rke2/registries.yaml
     when: >-
       rke2_registries is defined and
       rke2_registries | length > 0
     notify: restart rke2

   - name: Start RKE2 service
     service:
       name: rke2-server
       state: started
     register: rke2_start_result
     until: rke2_start_result is succeeded
     notify: restart rke2

   - name: Mask other RKE2 services
     systemd:
       name: "{{ item }}"
       masked: yes
     loop:
       - rke2-agent.service
       - rke2-server.service
     when: rke2_type == 'agent' or rke2_type == 'server'

   - name: Wait for remaining nodes to be ready - no CNI
     shell: kubectl get nodes | grep NotReady | wc -l
     register: not_ready_nodes
     until: not_ready_nodes.stdout == "0"
     retries: 60
     delay: 10
     when: rke2_type == 'server'

   - name: Wait for remaining nodes to be ready - with CNI
     shell: kubectl get nodes | grep -v -E "Ready|SchedulingDisabled" | wc -l
     register: not_ready_nodes
     until: not_ready_nodes.stdout == "0"
     retries: 60
     delay: 10
     when: rke2_type == 'server' and cni_initialized | default(false)

