 - name: Check if the system is EFI
     stat:
       path: /sys/firmware/efi/efivars
     register: efi_check

   - name: Remove the grub.cfg file if the system is EFI
     file:
       path: /boot/grub2/grub.cfg
       state: absent
     when: efi_check.stat.exists

   - name: Install a user template for GRUB
     copy:
       src: 01_users
       dest: /etc/grub.d/01_users
       owner: root
       group: root
       mode: '0700'
     notify: update grub

   - name: Add a password to the EFI GRUB configuration
     lineinfile:
       path: /etc/grub2-efi.cfg
       line: 'GRUB_CMDLINE_LINUX="${GRUB_CMDLINE_LINUX} grub_password=GRUB_PASSWORD"'
     notify: update grub

   - name: Add a password to the MBR GRUB configuration
     lineinfile:
       path: /etc/grub2.cfg
       line: 'GRUB_CMDLINE_LINUX="${GRUB_CMDLINE_LINUX} grub_password=GRUB_PASSWORD"'
     notify: update grub

   - name: Add --unrestricted option to specified files
     lineinfile:
       path: "{{ item }}"
       regexp: '^(CLASS="[^"]*)"$'
       line: '\1 --unrestricted"'
       backrefs: yes
     with_items: "{{ grub_password_unrestricted_files }}"
     when: grub_password_unrestricted | bool
     notify: update grub

   - name: Update GRUB
     command: grub2-mkconfig -o /boot/grub2/grub.cfg
     when: efi_check.stat.exists or grub_password_unrestricted | bool
     changed_when: true

