 - name: Remove old versions of Docker
     yum:
       name:
         - docker
         - docker-common
         - docker-engine
         - docker-client
       state: absent

   - name: Add Docker GPG key
     rpm_key:
       key: https://download.docker.com/linux/centos/gpg
       state: present

   - name: Add Docker repository
     yum_repository:
       name: docker-ce-stable
       description: Docker CE Stable - $basearch
       baseurl: https://download.docker.com/linux/centos/$releasever/$basearch/stable
       gpgkey: https://download.docker.com/linux/centos/gpg
       gpgcheck: yes

   - name: Configure Docker Nightly repo
     yum_repository:
       name: docker-ce-nightly
       description: Docker CE Nightly - $basearch
       baseurl: "https://download.docker.com/linux/centos/$releasever/$basearch/nightly"
       gpgkey: "https://download.docker.com/linux/centos/gpg"
       gpgcheck: yes
       enabled: "{{ docker_nightly_repo }}"

   - name: Configure Docker Test repo
     yum_repository:
       name: docker-ce-test
       description: Docker CE Test - $basearch
       baseurl: "https://download.docker.com/linux/centos/$releasever/$basearch/test"
       gpgkey: "https://download.docker.com/linux/centos/gpg"
       gpgcheck: yes
       enabled: "{{ docker_test_repo }}"

   - name: Configure containerd on RHEL 8
     when: ansible_distribution == 'CentOS' and ansible_distribution_major_version == '8'
     block:
       - name: Remove runc
         package:
           name: runc
           state: absent
       - name: Install container-selinux and containerd.io
         package:
           name:
             - container-selinux
             - containerd.io
           state: present

