       state: present

   - name: Create etcd user
     user:
       name: etcd
       comment: etcd user
       group: etcd
       shell: /bin/nologin
       system: yes
       createhome: no

   - name: Check if /usr/local is writeable and partition check
     shell: >
       if [ -w "/usr/local/" ] && [ -f "/usr/local/share/rke2/rke2-cis-sysctl.conf" ]; then
         echo "/usr/local/share/rke2/rke2-cis-sysctl.conf"
       elif [ -f "/opt/rke2/share/rke2/rke2-cis-sysctl.conf" ]; then
         echo "/opt/rke2/share/rke2/rke2-cis-sysctl.conf"
