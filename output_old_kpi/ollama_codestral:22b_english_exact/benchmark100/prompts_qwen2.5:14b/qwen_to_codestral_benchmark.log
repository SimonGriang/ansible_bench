      update_cache: yes
      upgrade: yes
    notify: reboot

  - name: Configure yum
    yum:
      name: "*"
      state: latest
    notify: reboot
    register: yum_status
  - name: Install yum-utils if needed
    yum:
      name: yum-utils
      state: present
    when: yum_status.changed

  - name: Update all software (zypper)
    zypper:
      name: "*"
      state: latest
    notify: reboot

