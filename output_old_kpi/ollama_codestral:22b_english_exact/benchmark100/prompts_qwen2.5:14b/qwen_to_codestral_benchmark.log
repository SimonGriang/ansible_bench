 - name: gather_facts | Lookup bootstrap facts
    shell: |
      set -o pipefail
      cat /etc/os-release | grep -E '^ID=|^ID_LIKE=' |
      awk -F '=' '{print $2}' |
      tr -d '"'
    register: bootstrap_os_release
    changed_when: false

  - name: gather_facts | Set bootstrap facts (I)
    set_fact:
      bootstrap_distribution_name: >-
        {{ bootstrap_os_release.stdout_lines |
           select('match', '^(.*)-.*') |
           first | default(bootstrap_os_release.stdout_lines[0]) }}
      bootstrap_distribution_major_version: >-
        {{ bootstrap_os_release.stdout_lines |
           select('match', '^.*-(\\d+)') |
           first | regex_replace('^.*-(\\d+)', '\\1') }}
    loop: "{{ bootstrap_os_family_map }}"
    when: item.name == bootstrap_distribution_name

  - name: gather_facts | Set bootstrap facts (II)
    set_fact:
      bootstrap_os_family: >-
        {{ bootstrap_os_family_map |
           selectattr('name', 'equalto', bootstrap_distribution_name) |
           first | default({}) |
           community.general.json_query('family') }}

  # Note: The new line character at the end of the file is necessary.

