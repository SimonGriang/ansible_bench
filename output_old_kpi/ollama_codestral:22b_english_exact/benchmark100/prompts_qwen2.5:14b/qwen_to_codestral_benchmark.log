   - name: Install apache httpd
     package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure selinux
     seboolean:
       name: "{{ item }}"
       state: yes
       persistent: yes
     with_items:
       - httpd_can_network_connect
       - httpd_can_network_connect_db
     when: ansible_selinux.status == "enabled"

   - name: Configure httpd
     template:
       src: "{{ httpd_conf_src }}"
       dest: "{{ httpd_conf_dest }}"
     notify:
       - test httpd
       - restart httpd

   - name: Activate httpd module | Debian
     apache2_module:
       name: "{{ item }}"
       state: present
     with_items: "{{ httpd_modules }}"
     notify:
       - test httpd
       - restart httpd
     when: ansible_os_family == 'Debian'

   - name: Import ssl.yml
     import_tasks: ssl.yml
     when: httpd_ssl_enabled

   - name: Import locations.yml
     import_tasks: locations.yml
     when: httpd_locations is defined and httpd_locations

   - name: Import vhosts.yml
     import_tasks: vhosts.yml
     when: httpd_vhosts is defined and httpd_vhosts

   - name: Configure ports
     template:
       src: "{{ httpd_ports_src }}"
       dest: "{{ httpd_ports_dest }}"
     notify:
       - test httpd
       - restart httpd
     when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

   - name: Import directories.yml
     import_tasks: directories.yml
     when: httpd_directories is defined and httpd_directories

   - name: Flush handlers
     meta: flush_handlers

   - name: Removing default html
     file:
       path: "/var/www/html/index.html"
       state: absent
     when: httpd_remove_example

   - name: Start and enable httpd
     service:
       name: "{{ httpd_service }}"
       state: started
       enabled: true

