 - name: Ensure document root directories are created for each virtual host
    file:
      path: "{{ item.document_root }}"
      state: directory
      mode: '0755'
    when: item.document_root is defined and (item.create_docroot is not defined or item.create_docroot)
    with_items: "{{ httpd_vhosts }}"

  - name: Create virtual host configuration files
    template:
      src: vhost_conf_template
      dest: "{{ httpd_vhosts_directory }}/{{ item.server_name }}.conf"
      mode: '0644'
    with_items: "{{ httpd_vhosts }}"
    notify:
      - test httpd configuration
      - restart httpd

  - name: Enable virtual hosts on Debian-based systems
    command: a2ensite "{{ item.server_name }}"
    args:
      creates: "/etc/apache2/sites-enabled/{{ item.server_name }}.conf"
    with_items: "{{ httpd_vhosts }}"
    when: ansible_os_family == 'Debian'
    notify:
      - test httpd configuration
      - restart httpd

