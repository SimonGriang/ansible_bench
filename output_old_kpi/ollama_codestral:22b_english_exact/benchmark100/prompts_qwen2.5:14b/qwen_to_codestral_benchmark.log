---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       mode: "{{ item.mode }}"
     with_items:
       - { path: '/etc/dns', owner: 'dns', group: 'dns', mode: '0750' }
       - { path: '/var/dns', owner: 'dns', group: 'dns', mode: '0750' }

   - name: Create group
     group:
       name: dns
       system: yes

   - name: Create user
     user:
       name: dns
       group: dns
       system: yes

   - name: Generate rndc key
     command:
       cmd: rndc-confgen -a -c /etc/dns -r /dev/urandom -k rndc-key
     args:
       creates: /etc/dns/rndc.key

   - name: Set permissions on rndc key file
     file:
       path: /etc/dns/rndc.key
       owner: dns
       group: dns
       mode: '0640'

   - name: Get the hints/root file
     get_url:
       url: ftp://ftp.internic.net/domain/named.cache
       dest: /var/dns/root.hints
       owner: dns
       group: dns
       mode: '0644'

   - name: Create zone file
     template:
       src: zone.j2
       dest: /etc/dns/zones/{{ item }}.zone
       owner: dns
       group: dns
       mode: '0644'
     with_items: "{{ dns_zones }}"

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: /etc/dns/named.conf
       owner: dns
       group: dns
       mode: '0644'

   - name: Place systemd override
     template:
       src: dns.service.override.j2
       dest: /etc/systemd/system/dns.service.d/override.conf
       owner: root
       group: root
       mode: '0644'

   - name: Start and enable dns
     systemd:
       name: dns
       state: started
       enabled: yes

