         echo "File not found"
       fi
     register: sysctl_file
     changed_when: false

   - name: Copy systemctl config file for kernel hardening
     copy:
       src: "{{ sysctl_file.stdout }}"
       dest: /etc/sysctl.d/60-rke2-cis.conf
       mode: '0600'
     when: sysctl_file.stdout != "File not found"
     notify: Restart systemd-sysctl

   - name: Flush handlers
     meta: flush_handlers

   - name: Restart systemd-sysctl
     systemd:
       name: systemd-sysctl
       state: restarted
     listen: Restart systemd-sysctl
     when: sysctl_file.stdout != "File not found"

