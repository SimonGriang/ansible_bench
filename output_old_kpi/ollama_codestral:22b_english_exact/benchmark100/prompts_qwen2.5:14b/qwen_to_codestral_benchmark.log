 - name: hardening | Disable swap
     command: swapoff -a
     when: vault_hardening_disable_swap | bool

   - name: hardening | Disable swap now
     command: swapoff -a
     when: ansible_swaptotal_mb > 0

   - name: hardening | Disable swap permanently
     mount:
       name: swap
       fstype: swap
       state: absent
     when: vault_hardening_disable_swap | bool

   - name: hardening | Disable core dumps
     sysctl:
       name: fs.suid_dumpable
       value: "0"
       sysctl_set: yes
       state: present
       reload: yes
     when: vault_hardening_disable_core_dumps | bool

   - name: hardening | Disable Shell Command History
     copy:
       dest: /etc/profile.d/no_shell_history.sh
       content: |
         unset HISTFILE
         export HISTFILE=/dev/null
       mode: 0644
     when: vault_hardening_disable_shell_command_history | bool

   - name: hardening | Configure SELinux / AppArmor
     block:
       - name: hardening | Enable SELinux
         package:
           name: selinux-policy-targeted
           state: present
       - name: hardening | Install selinux-policy
         package:
           name: selinux-policy
           state: present
       - name: hardening | Set SELinux policy
         selinux:
           policy: targeted
           state: enforcing
     when: vault_hardening_configure_selinux_apparmor | bool and ansible_selinux.status == 'enabled'

   - name: hardening | Enable AppArmor (enforcing)
     systemd:
       name: apparmor
       enabled: yes
       state: started
     when: vault_hardening_configure_selinux_apparmor | bool and ansible_apparmor.status == 'enabled'

   - name: hardening | Configure AppArmor profile for vault binary
     copy:
       dest: /etc/apparmor.d/local/usr.bin.vault
       content: |
         /usr/bin/vault {
           # Your AppArmor profile rules here
         }
     notify: reload apparmor
     when: vault_hardening_configure_selinux_apparmor | bool and ansible_apparmor.status == 'enabled'

   - name: Reload AppArmor profiles
     systemd:
       name: apparmor
       state: reloaded
     listen: reload apparmor
     when: vault_hardening_configure_selinux_apparmor | bool and ansible_apparmor.status == 'enabled'


