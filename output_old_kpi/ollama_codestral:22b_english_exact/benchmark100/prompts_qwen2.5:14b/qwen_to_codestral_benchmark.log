---
- name: Update java_jdk_vendor
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables
  include_vars: "{{ ansible_os_family }}.yml"

- name: Include architecture-specific variables
  include_vars: "{{ ansible_architecture }}.yml"

- name: Set OS-specific variables
  set_fact:
    java_package: "{{ __java_package }}"
    java_extra_packages: "{{ __java_extra_packages }}"
  when: >
    java_package is not defined or java_package == None or
    java_extra_packages is not defined or java_extra_packages == None

- name: Set OS and architecture-specific variables
  set_fact:
    java_home: "{{ __java_home }}"
  when: java_home is not defined or java_home == None

- name: Set java_home variable
  set_fact:
    java_home: "{{ openjdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated apt repositories
      apt_repository:
        repo: "deb http://ppa.launchpad.net/webupd8team/java/ubuntu {{ ansible_lsb.codename }} main"
        state: absent
    - name: Install extra apt tools
      apt:
        name: software-properties-common
        state: present
    - name: Add key repository
      apt_key:
        url: https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public
        state: present
    - name: Add repository
      apt_repository:
        repo: "deb https://adoptopenjdk.jfrog.io/adoptopenjdk/deb/ {{ ansible_lsb.codename }} main"
        state: present
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repository
      rpm_key:
        key: https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public
        state: present
    - name: Add repository
      yum_repository:
        name: AdoptOpenJDK
        description: AdoptOpenJDK Repository
        baseurl: https://adoptopenjdk.jfrog.io/adoptopenjdk/rpm/centos/$releasever/$basearch
        gpgcheck: yes
        gpgkey: https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public
        enabled: yes
  when: ansible_os_family == 'RedHat'

- name: Install required libraries
  package:
    name: "{{ java_extra_packages }}"
    state: present

- name: Install Java on Debian
  apt:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'
  register: java_install_result

- name: Install Java on RedHat
  yum:
    name: "{{ java_package }}"
    state: present
  when: ansible_os_family == 'RedHat'
  register: java_install_result

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java versions less than 11
  command: "update-alternatives --set java /usr/lib/jvm/java-{{ java_version }}-openjdk-{{ java_jdk_vendor }}/bin/java"
  when: ansible_os_family == 'Debian' and java_version is version('11', '<')

- name: Correct java version selected for Java versions greater than or equal to 11
  command: "update-alternatives --set java /usr/lib/jvm/java-{{ java_version }}-openjdk-{{ java_jdk_vendor }}-{{ ansible_architecture }}/bin/java"
  when: ansible_os_family == 'Debian' and java_version is version('11', '>=')


