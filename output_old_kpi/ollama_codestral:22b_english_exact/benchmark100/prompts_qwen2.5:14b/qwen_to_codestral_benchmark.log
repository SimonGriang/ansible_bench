     become: true
     when: hashicorp_product_version is not defined

   - name: "Install versioned hashicorp product using package"
     package:
       name: "{{ hashicorp_product }}{{ hashicorp_product_version }}"
       state: present
     become: true
     when: hashicorp_product_version is defined

   - name: "Install manually"
     unarchive:
       src: "{{ hashicorp_product_url }}"
       dest: "{{ hashicorp_install_path }}"
       remote_src: true
     become: true

   - name: "Install hashicorp product manually"
     file:
       path: "{{ hashicorp_install_path }}"
       state: directory
       mode: '0755'
       owner: root
       group: root
     become: true


