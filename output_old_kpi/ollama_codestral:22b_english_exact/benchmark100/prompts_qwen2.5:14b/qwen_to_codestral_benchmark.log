 - name: Ensure unzip package is available
     apt:
       name: unzip
       state: present
       update_cache: yes
     when: ansible_os_family == 'Debian'

   - name: Ensure unzip package is available
     yum:
       name: unzip
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Create promtail system group
     group:
       name: promtail
       system: yes
       state: present

   - name: Create promtail system user
     user:
       name: promtail
       system: yes
       group: promtail
       state: present

   - name: Ensure /usr/local/bin directory exists
     file:
       path: /usr/local/bin
       state: directory
       mode: '0755'

   - name: Create config directories
     file:
       path: "{{ item }}"
       state: directory
       mode: '0755'
       owner: promtail
       group: promtail
     with_items:
       - /etc/promtail
       - /etc/promtail/config.d

   - name: Create application directories
     file:
       path: "{{ item }}"
       state: directory
       mode: '0755'
       owner: promtail
       group: promtail
     with_items:
       - /var/lib/promtail
       - /var/log/promtail

   - name: Check if promtail binary exists
     stat:
       path: /usr/local/bin/promtail
     register: promtail_binary

   - name: Download promtail binaries
     get_url:
       url: "{{ promtail_url }}"
       dest: /tmp/promtail.zip
     when: not promtail_binary.stat.exists and not local_promtail_archive and not propagate_binaries

   - name: Propagate locally distributed promtail archive
     copy:
       src: "{{ local_promtail_archive }}"
       dest: /tmp/promtail.zip
     when: not promtail_binary.stat.exists and local_promtail_archive and not propagate_binaries

   - name: Download promtail binaries to controller node
     get_url:
       url: "{{ promtail_url }}"
       dest: /tmp/promtail.zip
       delegate_to: localhost
     when: not promtail_binary.stat.exists and propagate_binaries

   - name: Propagate promtail binaries
     copy:
       src: /tmp/promtail.zip
       dest: /tmp/promtail.zip
     when: propagate_binaries

   - name: Unpack promtail binaries
     unarchive:
       src: /tmp/promtail.zip
       dest: /var/lib/promtail
       mode: '0755'
       creates: /var/lib/promtail/promtail
       remote_src: yes

   - name: Create symlink to latest version
     file:
       src: /var/lib/promtail/promtail
       dest: /usr/local/bin/promtail
       state: link
     notify:
       - Restart promtail service

   - name: Write configuration
     template:
       src: promtail.yml.j2
       dest: /etc/promtail/promtail.yml
       mode: '0644'
       owner: promtail
       group: promtail
     notify:
       - Restart promtail service

   - name: Create systemd service unit
     template:
       src: promtail.service.j2
       dest: /etc/systemd/system/promtail.service
       mode: '0644'
     notify:
       - Restart promtail service

   - name: Restart promtail service
     systemd:
       name: promtail
       state: restarted
       daemon_reload: yes
     when: not ansible_check_mode

