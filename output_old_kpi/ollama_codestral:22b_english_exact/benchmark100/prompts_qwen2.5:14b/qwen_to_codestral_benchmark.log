---
   - include_tasks: assert.yml

   - name: Pre-configure debian systems
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: 'No configuration'
       vtype: string
     when: ansible_os_family == 'Debian'

   - name: Install postfix
     package:
       name: postfix
       state: present

   - name: Install postfix-mysql
     package:
       name: postfix-mysql
       state: present
     when: >
       (postfix_virtual_mailbox_maps is defined
       and 'mysql' in postfix_virtual_mailbox_maps)
       or (postfix_virtual_mailbox_domains is defined
       and 'mysql' in postfix_virtual_mailbox_domains)
       or (postfix_virtual_alias_maps is defined
       and 'mysql' in postfix_virtual_alias_maps)

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - validate_postfix
       - rebuild_transport_maps

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - validate_postfix
       - reload_postfix

   - name: Setting values for main.cf (1/2)
     set_fact:
       main_cf_smtpd_restrictions: >-
         {% if postfix_smtpd_sender_restrictions is defined -%}
           {{ postfix_smtpd_sender_restrictions }},
         {%- endif %}
         {% if postfix_smtpd_recipient_restrictions is defined -%}
           {{ postfix_smtpd_recipient_restrictions }},
         {%- endif %}
           reject_unauth_destination

   - name: Setting values for main.cf (2/2)
     set_fact:
       main_cf_mynetworks: >-
         {{ postfix_mynetworks
         | default('127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128') }}
       main_cf_mydestination: >-
         {{ postfix_mydestination | default('') }}
       main_cf_relay_domains: >-
         {{ postfix_relay_domains | default('') }}
       main_cf_smtpd_recipient_restrictions: >-
         {{ postfix_smtpd_recipient_restrictions | default('') }}
       main_cf_smtpd_sender_restrictions: >-
         {{ postfix_smtpd_sender_restrictions | default('') }}
       main_cf_virtual_mailbox_domains: >-
         {{ postfix_virtual_mailbox_domains | default('') }}
       main_cf_virtual_alias_domains: >-
         {{ postfix_virtual_alias_domains | default('') }}

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - validate_postfix
       - restart_postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - validate_postfix
       - restart_postfix

   - name: Creates cert/key directory
     file:
       path: "{{ item | dirname }}"
       state: directory
     loop:
       - "{{ postfix_smtpd_tls_cert_file }}"
       - "{{ postfix_smtpd_tls_key_file }}"
     when: item is defined

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_smtpd_tls_cert_file }}"
       dest: "/etc/postfix/{{ postfix_smtpd_tls_cert_file | basename }}"
     notify: reload_postfix

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_smtpd_tls_key_file }}"
       dest: "/etc/postfix/{{ postfix_smtpd_tls_key_file | basename }}"
     notify: reload_postfix

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     template:
       src: aliases.j2
       dest: /etc/aliases
     notify:
       - rebuild_alias_maps
       - reload_postfix

   - name: Configure sender_access
     template:
       src: sender_access.j2
       dest: /etc/postfix/sender_access
     notify:
       - rebuild_sender_access
       - reload_postfix

   - name: Configure recipient_access
     template:
       src: recipient_access.j2
       dest: /etc/postfix/recipient_access
     notify:
       - validate_postfix
       - rebuild_recipient_access
       - reload_postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_sasl_password_map }}"
       dest: /etc/postfix/sasl_password_map
     notify: rebuild_sasl_password_map

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
       enabled: true 66%|██████▌   | 66/100 [1:20:40<1:06:47, 117.87s/it]

