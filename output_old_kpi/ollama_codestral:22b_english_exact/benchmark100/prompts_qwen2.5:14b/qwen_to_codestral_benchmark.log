 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install apache httpd
     package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure selinux
     block:
       - name: Modify SELinux booleans
         seboolean:
           name: "{{ item }}"
           state: yes
           persistent: yes
         loop: "{{ httpd_selinux_booleans }}"

       - name: Allow connections to custom ports
         seport:
           ports: "{{ item }}"
           proto: tcp
           setype: http_port_t
           state: present
         loop: "{{ httpd_ports }}"
     when: ansible_selinux.status == "enabled"

   - name: Configure httpd
     template:
       src: "{{ httpd_config_file }}"
       dest: "{{ httpd_config_dest }}"
     notify:
       - test httpd configuration
       - restart httpd

   - name: Activate httpd module | Debian
     command: a2enmod {{ item }}
     loop: "{{ httpd_modules }}"
     notify:
       - test httpd configuration
       - restart httpd
     when: ansible_os_family == "Debian"

   - name: Import ssl.yml
     import_tasks: ssl.yml
     when: httpd_ssl_enabled

   - name: Import locations.yml
     import_tasks: locations.yml
     when: httpd_locations | length > 0

   - name: Import vhosts.yml
     import_tasks: vhosts.yml
     when: httpd_vhosts | length > 0

   - name: Configure ports
     template:
       src: "{{ httpd_ports_config_file }}"
       dest: "{{ httpd_ports_config_dest }}"
     notify:
       - test httpd configuration
       - restart httpd
     when: ansible_os_family in ["Debian", "Suse"]

   - name: Import directories.yml
     import_tasks: directories.yml
     when: httpd_directories | length > 0

   - name: Flush handlers
     meta: flush_handlers

   - name: Removing default html
     file:
       path: "{{ httpd_default_index_html }}"
       state: absent
     when: httpd_remove_example

   - name: Start and enable httpd
     service:
       name: "{{ httpd_service }}"
       state: started
       enabled: yes

