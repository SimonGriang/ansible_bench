    group: "{{ ssl_group }}"
    mode: 0600

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ ssl_csr_directory }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ ssl_key_directory }}/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: create | Create ssl certificates
  openssl_certificate:
    path: "{{ ssl_cert_directory }}/{{ inventory_hostname }}.crt"
    privatekey_path: "{{ ssl_key_directory }}/{{ inventory_hostname }}.key"
    csr_path: "{{ ssl_csr_directory }}/{{ inventory_hostname }}.csr"
    provider: selfsigned
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    action: export
    path: "{{ pkcs12_directory }}/{{ inventory_hostname }}.p12"
    friendly_name: "{{ inventory_hostname }}"
    privatekey_path: "{{ ssl_key_directory }}/{{ inventory_hostname }}.key"
    certificate_path: "{{ ssl_cert_directory }}/{{ inventory_hostname }}.crt"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: create | Read private key
  slurp:
    src: "{{ ssl_key_directory }}/{{ inventory_hostname }}.key"
  register: ssl_private_key

- name: create | Read certificate
  slurp:
    src: "{{ ssl_cert_directory }}/{{ inventory_hostname }}.crt"
  register: ssl_certificate

- name: create | Create combined private_key and certificate file
  copy:
    content: |
      {{ ssl_private_key['content'] | b64decode }}
      {{ ssl_certificate['content'] | b64decode }}
    dest: "{{ combined_directory }}/{{ inventory_hostname }}.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 0600



