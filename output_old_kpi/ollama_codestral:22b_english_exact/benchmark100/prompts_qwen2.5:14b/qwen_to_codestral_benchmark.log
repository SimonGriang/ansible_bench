 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
       state: present

   - name: Configure mysql server
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       regexp: "{{ item.regexp }}"
       line: "{{ item.line }}"
       state: present
     loop: "{{ mysql_configuration_options }}"
     notify: restart mysql

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/client.cnf
       regexp: "^socket"
       line: "socket = /var/run/mysqld/mysqld.sock"
       state: present

   - name: Initialize mysql
     command: mysql_install_db
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Place my.cnf
     copy:
       src: my.cnf
       dest: /etc/mysql/my.cnf
       owner: root
       group: root
       mode: 0644

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
     loop: "{{ mysql_databases }}"
     when: item.initial_import is not defined

   - name: List databases
     command: mysql -e "SHOW DATABASES;"
     register: databases

   - name: Import database
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.initial_import }}"
     loop: "{{ mysql_databases }}"
     when: item.initial_import is defined and item.name not in databases.stdout

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
     loop: "{{ mysql_users }}"

   - name: Flush handlers
     meta: flush_handlers

   - name: Flush handlers again
     meta: flush_handlers

