22, 'eval_count': 509, 'eval_duration': 10677202552, 'model_name': 'codestral:22b'} id='run--ded638fd-512e-4657-9e89-7ee73fd5832b-0' usage_metadata={'input_tokens': 668, 'output_tokens': 509, 'total_tokens': 1177}
