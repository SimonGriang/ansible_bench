---
   - name: Ensure the unzip package is available
     package:
       name: unzip
       state: present
       update_cache: yes

   - name: Create a system group for promtail
     group:
       name: promtail
       system: yes
       state: present

   - name: Create the promtail user
     user:
       name: promtail
       system: yes
       group: promtail
       state: present

   - name: Ensure the /usr/local/bin directory exists
     file:
       path: /usr/local/bin
       state: directory
       mode: '0755'

   - name: Create config directories
     file:
       path: /etc/promtail
       state: directory
       mode: '0755'
       owner: promtail
       group: promtail

   - name: Create application directories
     file:
       path: /opt/promtail
       state: directory
       mode: '0755'
       owner: promtail
       group: promtail

   - name: Check if the promtail binary exists
     stat:
       path: /opt/promtail/promtail
     register: promtail_binary

   - name: Download promtail binaries
     get_url:
       url: "{{ promtail_download_url }}"
       dest: /tmp/promtail.zip
     when: not promtail_binary.stat.exists and not promtail_local_archive and not promtail_propagate

   - name: Propagate locally distributed promtail archive
     copy:
       src: "{{ promtail_local_archive }}"
       dest: /tmp/promtail.zip
     when: not promtail_binary.stat.exists and promtail_local_archive and not promtail_propagate

   - name: Download promtail binaries to controller node
     get_url:
       url: "{{ promtail_download_url }}"
       dest: /tmp/promtail.zip
       delegate_to: localhost
     when: not promtail_binary.stat.exists and promtail_propagate

   - name: Propagate promtail binaries
     copy:
       src: /tmp/promtail.zip
       dest: /tmp/promtail.zip
     when: promtail_propagate

   - name: Unpack promtail binaries
     unarchive:
       src: /tmp/promtail.zip
       dest: /opt/promtail
       mode: '0755'
       owner: promtail
       group: promtail
       ignore_errors: "{{ ansible_check_mode }}"

   - name: Create symlink to latest version
     file:
       src: /opt/promtail/promtail
       dest: /usr/local/bin/promtail
       state: link
     notify: Restart promtail service

   - name: Write configuration
     template:
       src: promtail.yaml.j2
       dest: /etc/promtail/promtail.yaml
       mode: '0644'
       owner: promtail
       group: promtail
     notify: Restart promtail service

   - name: Create systemd service unit
     template:
       src: promtail.service.j2
       dest: /etc/systemd/system/promtail.service
       mode: '0644'
     notify: Restart promtail service

   - name: Ensure promtail service is enabled and started
     service:
       name: promtail
       enabled: yes
       state: started

