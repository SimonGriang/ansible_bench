 - name: Import assert
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: yes

  - name: Configure apk
    apk:
      update_cache: yes
      upgrade: yes
    notify: reboot

  - name: Configure apt
    apt:
      upgrade: safe
      update_cache: yes
      autoremove: yes
      autoclean: yes
    notify: reboot

  - name: Update all software (dnf)
    dnf:
      name: "*"
      state: latest
      exclude: "package1,package2"
    notify: reboot

  - name: Update all software (pacman)
