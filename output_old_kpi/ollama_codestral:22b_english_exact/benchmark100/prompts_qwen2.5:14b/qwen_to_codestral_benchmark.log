 - name: Create local ssh_key_directory for {{ user.name }}
     file:
       path: "{{ ssh_key_directory }}"
       state: directory
       mode: '0750'
     when: user.manage_ssh_key
     delegate_to: localhost
     become: false

   - name: Manage user {{ user.name }}
     user:
       name: "{{ user.name }}"
       state: "{{ user.state | default('present') }}"
       password: "{{ user.password | default(omit) }}"
       sudo: "{{ user.sudo | default(omit) }}"

   - name: Set sudo options for {{ user.name }}
     template:
       src: sudoers.d.j2
       dest: "/etc/sudoers.d/{{ user.name }}"
       mode: '0640'
       validate: '/usr/sbin/visudo --check %s'
     when: user.sudo is defined

   - name: Remove sudo options for {{ user.name }}
     file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     when: user.sudo is not defined

   - name: Generate private ssh key for {{ user.name }}
     openssh_keypair:
       path: "{{ ssh_key_directory }}/{{ user.name }}"
       type: rsa
       size: 2048
       state: present
     when: user.manage_ssh_key
     delegate_to: localhost
     become: false

   - name: Generate public ssh key for {{ user.name }}
     openssh_keypair:
       path: "{{ ssh_key_directory }}/{{ user.name }}"
       type: rsa
       size: 2048
       state: present
       force: no
     when: user.manage_ssh_key
     delegate_to: localhost
     become: false

   - name: Convert ssh key to ppk for {{ user.name }}
     shell:
       cmd: "ssh-keygen -p -N '' -m PEM -f {{ ssh_key_directory }}/{{ user.name }}"
     when: user.manage_ssh_key
     delegate_to: localhost
     become: false

   - name: Get or set the home directory for {{ user.name }}
     command: "echo ~{{ user.name }}"
     register: user_home
     changed_when: false

   - name: Create .ssh directory for {{ user.name }}
     file:
       path: "{{ user_home.stdout }}/.ssh"
       state: directory
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
       mode: '0700'
     when: user.manage_ssh_key or user.private_keys is defined
     become: true

   - name: Deploy authorized keys for {{ user.name }}
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: present
     with_items: "{{ user.authorized_keys }}"
     when: user.authorized_keys is defined

   - name: Remove unauthorized keys for {{ user.name }}
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: absent
     with_items: "{{ user.unauthorized_keys }}"
     when: user.unauthorized_keys is defined

   - name: Copy generated private ssh key for {{ user.name }}
     copy:
       src: "{{ ssh_key_directory }}/{{ user.name }}"
       dest: "{{ user_home.stdout }}/.ssh/id_rsa"
       mode: '0600'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     when: user.copy_private_key

   - name: Check users password valid time for {{ user.name }}
     shell: "chage -l {{ user.name }} | grep 'Password expires' | awk '{print $3}'"
     register: password_expiration
     changed_when: false

   - name: Set users password valid time for {{ user.name }}
     command: "chage -M {{ user.password_validity_days }} {{ user.name }}"
     when: user.password_validity_days is defined and password_expiration.stdout != user.password_validity_days

   - name: Place private key file for {{ user.name }}
     copy:
       content: "{{ item.content }}"
       dest: "{{ user_home.stdout }}/.ssh/{{ item.name }}"
       mode: "{{ item.mode | default('0600') }}"
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     with_items: "{{ user.private_keys }}"
     when: user.private_keys is defined

