---
   - name: Import assert.yml
     import_tasks: assert.yml
     run_once: yes
     delegate_to: localhost

   - name: Install python pip
     package:
       name: "{{ name }}"
       state: present

   - name: Configure pip proxy
     blockinfile:
       path: /etc/pip.conf
       block: |
         [global]
         proxy = {{ python_pip_proxy }}
       create: yes
       mode: 0644
     when: python_pip_proxy is defined

   - name: Trust hosts
     blockinfile:
       path: /etc/pip.conf
       block: |
         [global]
         trusted-host = {{ python_pip_trusted_host }}
       create: yes
       mode: 0644
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       state: latest
     when: python_pip_update and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

   - name: Install requested modules
     pip:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
     loop: "{{ python_pip_modules }}"
     when: ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

