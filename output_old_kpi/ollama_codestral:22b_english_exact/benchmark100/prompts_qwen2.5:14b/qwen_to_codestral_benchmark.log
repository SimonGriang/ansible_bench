---
   - name: Task 1 - Import assert.yml
     import_tasks: assert.yml

   - name: Task 2 - Uninstall conflicting systemd-logger
     package:
       name: systemd-logger
       state: absent

   - name: Task 3 - Install rsyslog
     package:
       name: rsyslog
       state: present

   - name: Task 4 - Install additional rsyslog packages
     package:
       name: "{{ rsyslog_features }}"
       state: present

   - name: Task 5 - Configuring default rsyslog
     template:
       src: rsyslog_default.conf.j2
       dest: /etc/rsyslog.conf
     when: rsyslog_deploy_default_config | bool

   - name: Task 6 - Make configuration directory
     file:
       path: /etc/rsyslog.d/
       state: directory
       mode: '0755'

   - name: Task 7 - Configuring rsyslog forward rule
     template:
       src: rsyslog_forward_rule.conf.j2
       dest: /etc/rsyslog.d/forward_rule.conf
     when: not rsyslog_deploy_default_config | bool

   - name: Task 8 - Configuring additional config files
     copy:
       src: "{{ item }}"
       dest: /etc/rsyslog.d/
       owner: root
       group: root
       mode: '0644'
     with_fileglob:
       - "files/rsyslog.d/*"

   - name: Task 9 - Start and enable rsyslog
     service:
       name: rsyslog
       state: started
       enabled: yes

