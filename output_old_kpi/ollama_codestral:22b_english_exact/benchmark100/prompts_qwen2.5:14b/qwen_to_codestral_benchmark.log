 - name: Assert usage of systemd as an init system
     assert:
       that:
         - "ansible_service_mgr == 'systemd'"
       fail_msg: "This role only works with systemd"

   - name: Get latest release of promtail
     uri:
       url: "https://api.github.com/repos/grafana/loki/releases/latest"
       return_content: true
     register: promtail_latest_release
     set_fact:
       promtail_version: "{{ promtail_latest_release.json.tag_name }}"

   - name: Test if zip local archive exists
     stat:
       path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.linux-{{ go_arch }}.zip"
     register: zip_local_archive

   - name: Assert local binary exists
     assert:
       that:
         - "promtail_binary_local_dir is defined and zip_local_archive.stat.exists"
       fail_msg: "promtail_binary_local_dir must be defined and the zip file must exist"

   - name: Get checksum list
     uri:
       url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS"
       return_content: true
     register: checksum_list

   - name: Get checksum for specific architecture
