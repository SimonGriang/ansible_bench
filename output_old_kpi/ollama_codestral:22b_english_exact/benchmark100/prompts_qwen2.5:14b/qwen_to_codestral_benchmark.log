---
- name: check if all variables have been set correctly
  assert:
    that:
      - variable1 is defined
      - variable2 is defined
      # Add more variables as necessary

- name: wait for host
  wait_for:
    host: "{{ bootstrap_wait_for_host_address }}"
    port: "{{ bootstrap_wait_for_host_port }}"
    search_regex: "{{ bootstrap_wait_for_host_search_regex }}"
  when: bootstrap_wait_for_host | bool

- name: prepare system
  block:
    - name: establish connection to host
      setup:
      register: system_facts

    - name: include tasks to gather bootstrap facts
      include_tasks: gather_bootstrap_facts.yml

- name: install bootstrap packages (raw)
  raw: "{{ bootstrap_install_command }}"
  when:
    - ansible_os_family == 'RedHat' or ansible_os_family == 'Debian'
    - bootstrap_install | bool

- name: ensure system is prepared by issuing ansible modules
  block:
    - name: gather ansible facts
      setup:

    - name: install bootstrap packages
      package:
        name: "{{ bootstrap_facts.packages }}"


