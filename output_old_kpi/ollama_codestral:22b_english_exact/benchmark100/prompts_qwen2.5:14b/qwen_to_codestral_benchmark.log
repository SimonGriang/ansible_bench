---
- name: lookup bootstrap facts (raw)
  ansible.builtin.slurp:
    src: /etc/os-release
  register: bootstrap_os_release

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: >-
      {{ bootstrap_os_release['content'] | b64decode |
      regex_search('^ID=(.*)$', '\\1') | first }}
    bootstrap_major_version: >-
      {{ bootstrap_os_release['content'] | b64decode |
      regex_search('^VERSION_ID=(.*)$', '\\1') | first |
      regex_replace('\\..*', '') }}

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map[bootstrap_distribution] }}"
  vars:
    bootstrap__os_family_map:
      ubuntu: debian
      debian: debian
      centos: redhat
      redhat: redhat
      amazon: redhat
      oracle: redhat
