content=' - name: Create the RKE2 config directory\n     file:\n       path: /etc/rancher/rke2\n       state: directory\n\n   - name: Set server taints\n     set_fact:\n       combined_node_taints: "{{ rke2_server_node_taints }}"\n     when: server_type == \'server\'\n\n   - name: Copy RKE2 configuration file\n     template:\n       src: config.yaml.j2\n       dest: /etc/rancher/rke2/config.yaml\n     notify: Config file changed\n\n   - name: Copy kubelet configuration file\n     template:\n       src: kubelet-config.yaml.j2\n       dest: /etc/rancher/rke2/kubelet-config.yaml\n     when: rke2_kubelet_config != ""\n     notify: Config file changed\n\n   - name: Copy Containerd Registry Configuration file\n     template:\n       src: registries.yaml.j2\n       dest: /etc/rancher/rke2/registries.yaml\n     when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""\n     notify: Config file changed\n\n   - name: Register if we need to do a etcd restore from file\n     set_fact:\n       do_etcd_restore: true\n     when: rke2_etcd_snapshot_file != "" and (ansible_facts[\'services\'][\'rke2-server.service\'] is not defined or ansible_facts[\'services\'][\'rke2-server.service\'][\'state\'] != "running")\n\n   - name: Register if we need to do a etcd restore from s3\n     set_fact:\n       do_etcd_restore_from_s3: true\n     when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined\n\n   - name: Restore etcd from file\n     block:\n       - file:\n           path: /var/lib/rancher/rke2/server/db/snapshots\n           state: directory\n       - copy:\n           src: "{{ rke2_etcd_snapshot_file }}"\n           dest: /var/lib/rancher/rke2/server/db/snapshots/\n       - command: "/var/lib/rancher/rke2/bin/kubectl etcd snapshot restore /var/lib/rancher/rke2/server/db/snapshots/{{ rke2_etcd_snapshot_file }}"\n     when: do_etcd_restore is defined\n\n   - name: Restore etcd from s3\n     command: "/var/lib/rancher/rke2/bin/kubectl etcd snapshot restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }} --s3-access-key-id={{ rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-access-key={{ rke2_etcd_snapshot_s3_options.secret_key }}"\n     when: do_etcd_restore_from_s3 is defined\n\n   - name: Start RKE2 service on the first server\n     systemd:\n       name: rke2-server.service\n       state: started\n       enabled: yes\n       daemon_reload: yes\n     environment:\n       RKE2_TOKEN: "{{ rke2_token }}"\n     when: inventory_hostname == groups[\'rke2_cluster_group_name\'][0]\n\n   - name: Mask RKE2 agent service on the first server\n     systemd:\n       name: rke2-agent.service\n       state: stopped\n       enabled: no\n       masked: yes\n     when: inventory_hostname == groups[\'rke2_cluster_group_name\'][0]\n\n   - name: Wait for the first server be ready - no CNI\n     command: "/var/lib/rancher/rke2/bin/kubectl get nodes {{ inventory_hostname }} -o jsonpath=\'{.status.conditions[?(@.type==\\"Ready\\")].status}\'"\n     register: result\n     until: result.stdout == "True"\n     retries: 30\n     delay: 10\n     when: inventory_hostname == groups[\'rke2_cluster_group_name\'][0]\n\n   - name: Wait for the first server be ready - with CNI\n     command: "/var/lib/rancher/rke2/bin/kubectl get nodes {{ inventory_hostname }} -o jsonpath=\'{.status.conditions[?(@.type==\\"NetworkUnavailable\\")].status}\'"\n     register: result\n     until: result.stdout == "False"\n     retries: 30\n     delay: 10\n     when: inventory_hostname == groups[\'rke2_cluster_group_name\'][0]\n\n   - name: Restore etcd\n     block:\n       - command: "/var/lib/rancher/rke2/bin/kubectl get nodes -o json"\n         register: nodes\n       - set_fact:\n           nodes_list: "{{ nodes.stdout | from_json }}"\n       - command: "/var/lib/rancher/rke2/bin/kubectl delete secret {{ item.metadata.name }}"\n         loop: "{{ nodes_list.items }}"\n         when: item.metadata.labels[\'node.cattle.io/etcd\'] == \'true\'\n       - command: "/var/lib/rancher/rke2/bin/kubectl delete node {{ item.metadata.name }}"\n         loop: "{{ nodes_list.items }}"\n         when: item.metadata.labels[\'node.cattle.io/etcd\'] == \'true\'\n     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined\n\n   - name: Set an Active Server variable\n     set_fact:\n       active_server: "{{ inventory_hostname }}"\n     with_items: "{{ groups[\'rke2_cluster_group_name\'] }}"' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-03T09:56:57.247312324Z', 'done': True, 'done_reason': 'stop', 'total_duration': 41724100975, 'load_duration': 14611121, 'prompt_eval_count': 1102, 'prompt_eval_duration': 1040435958, 'eval_count': 1566, 'eval_duration': 40668276431, 'model_name': 'codestral:22b'} id='run--678e73ce-7fc9-4e6b-a645-54d896894e7a-0' usage_metadata={'input_tokens': 1102, 'output_tokens': 1566, 'total_tokens': 2668}
