       line: "SHELL=/bin/bash"
       regexp: '^SHELL='
       create: yes

   - name: Configure cron path environment
     lineinfile:
       path: /etc/cron.env
       line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
       regexp: '^PATH='
       create: yes

   - name: Configure cron mailto settings
     lineinfile:
       path: /etc/cron.env
       line: "MAILTO=root"
       regexp: '^MAILTO='
       create: yes

   - name: Start and enable cron service
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined

   - name: Schedule cron jobs
     cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute | default(omit) }}"
       hour: "{{ item.hour | default(omit) }}"
       day: "{{ item.day | default(omit) }}"
       month: "{{ item.month | default(omit) }}"
       weekday: "{{ item.weekday | default(omit) }}"
       job: "{{ item.job }}"
     loop: "{{ cron_jobs }}"
     when: cron_jobs is defined


