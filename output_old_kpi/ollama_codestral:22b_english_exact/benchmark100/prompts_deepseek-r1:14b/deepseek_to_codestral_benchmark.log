 - name: Import assertion tasks
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Install Python pip
     package:
       name: "{{ python_pip_packages }}"
       state: present

   - name: Configure pip proxy settings
     ini_file:
       path: /etc/pip.conf
       section: global
       option: index-url
       value: "{{ python_pip_proxy }}"
     when: python_pip_proxy is defined

   - name: Configure pip trusted hosts
     ini_file:
       path: /etc/pip.conf
       section: global
       option: trusted-host
       value: "{{ python_pip_trusted_host }}"
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       state: latest
     when: >
       ansible_distribution_release not in ['bookworm', 'noble']
       and ansible_os_family != 'Alpine'

   - name: Install Python modules
     pip:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
     loop: "{{ python_pip_modules }}"
     when: >
       ansible_distribution_release not in ['bookworm', 'noble']
       and ansible_os_family != 'Alpine'

