---
   - name: Create local SSH key directory for user
     file:
       path: "/home/{{ user }}/.ssh"
       state: directory
       owner: "{{ user }}"
       mode: '0750'

   - name: Manage user account
     user:
       name: "{{ user }}"
       state: "{{ user_state }}"
       comment: "{{ user_comment }}"
       home: "{{ user_home_directory | default('/home/' + user) }}"
       shell: "{{ user_shell }}"

   - name: Set sudo options for user
     copy:
       content: "{{ user }} ALL=(ALL) NOPASSWD: ALL\n"
       dest: "/etc/sudoers.d/{{ user }}"
       owner: root
       group: root
       mode: '0440'
     when: sudo_access

   - name: Generate private SSH key for user
     command: "{{ ssh_keygen_command }}"
     args:
       creates: "/home/{{ user }}/.ssh/id_rsa"

   - name: Generate public SSH key for user
     shell: "ssh-keygen -y -f /home/{{ user }}/.ssh/id_rsa > /home/{{ user }}/.ssh/id_rsa.pub"
     args:
       creates: "/home/{{ user }}/.ssh/id_rsa.pub"

   - name: Convert SSH key to ppk format for user
     command: "puttygen /home/{{ user }}/.ssh/id_rsa -o /home/{{ user }}/.ssh/id_rsa.ppk -O private"
     args:
       creates: "/home/{{ user }}/.ssh/id_rsa.ppk"

   - name: Get or set the home directory for user
     set_fact:
       user_home_directory: "{{ user_home_directory | default('/home/' + user) }}"

   - name: Create .ssh directory for user
     file:
       path: "{{ user_home_directory }}/.ssh"
       state: directory
       owner: "{{ user }}"
       group: "{{ user }}"
       mode: '0700'

   - name: Deploy authorized keys for user
     authorized_key:
       user: "{{ user }}"
       state: present
       key: "{{ item }}"
     with_items: "{{ authorized_keys }}"

   - name: Remove unauthorized keys for user
     authorized_key:
       user: "{{ user }}"
       state: absent
       key: "{{ item }}"
     with_items: "{{ unauthorized_keys }}"

   - name: Copy generated private SSH key for user
     copy:
       src: "/home/{{ user }}/.ssh/id_rsa"
       dest: "{{ user_home_directory }}/id_rsa"
       owner: "{{ user }}"
       group: "{{ user }}"
       mode: '0600'

   - name: Check users password valid time for user
     shell: "chage -l {{ user }}"
     register: chage_output
     changed_when: false

   - name: Set users password valid time for user
     command: "chage -M {{ password_max_days }} -m {{ password_min_days }} -W {{ password_warn_days }} {{ user }}"
     when: password_max_days is defined or password_min_days is defined or password_warn_days is defined

   - name: Place private key file for user
     copy:
       src: "/home/{{ user }}/.ssh/id_rsa"
       dest: "{{ user_home_directory }}/.ssh/id_rsa"
       owner: "{{ user }}"
       group: "{{ user }}"
       mode: '0600'

