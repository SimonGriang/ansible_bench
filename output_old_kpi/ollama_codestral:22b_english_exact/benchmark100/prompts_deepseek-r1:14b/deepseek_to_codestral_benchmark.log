 - name: Validate all variables
     ansible.builtin.import_tasks: assert.yml
     delegate_to: localhost

   - name: Wait for host to be available
     ansible.builtin.wait_for:
       host: "{{ inventory_hostname }}"
       port: "{{ port }}"
       timeout: "{{ timeout }}"

   - name: Prepare system for bootstrap
     block:
       - name: Test connection
         ansible.builtin.ping:

       - name: Handle connection failures
         ansible.builtin.meta: end_play
         when: not ansible_ping.pinged

       - name: Gather facts
         ansible.builtin.setup:

       - name: Install raw bootstrap packages
         ansible.builtin.package:
           name: "{{ raw_bootstrap_packages }}"
           state: present
     rescue:
       - ansible.builtin.debug:
           msg: "Failed to prepare system for bootstrap"

   - name: Ensure system preparation with Ansible modules
     block:
       - name: Gather facts
         ansible.builtin.setup:

       - name: Install packages based on OS family
         ansible.builtin.package:
           name: "{{ packages[ansible_os_family] }}"
           state: present
     rescue:
