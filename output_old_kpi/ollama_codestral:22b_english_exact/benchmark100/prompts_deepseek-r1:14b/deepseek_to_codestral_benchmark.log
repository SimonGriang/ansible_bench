 - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop:
       - {path: '/var/lib/dns', mode: '0750', owner: 'root', group: 'root'}
       - {path: '/etc/dns', mode: '0750', owner: 'root', group: 'root'}

   - name: Create group
     group:
       name: "{{ dns_group }}"
       state: present

   - name: Create user
     user:
       name: "{{ dns_owner }}"
       system: true
       createhome: false
       group: "{{ dns_group }}"

   - name: Generate rndc key
     shell:
       cmd: "rndc-confgen -a -c {{ dns_configuration_directory }}"
       creates: "{{ dns_configuration_directory }}/rndc.key"

   - name: Set permissions on rndc key file
     file:
       path: "{{ dns_configuration_directory }}/rndc.key"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0640'

   - name: Get the hints/root file
     get_url:
       url: "https://www.internic.net/domain/named.cache"
       dest: "{{ dns_configuration_directory }}/named.cache"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0640'
     when: dns_caching_dns | bool
     notify: Restart dns

   - name: Create zone file
     template:
       src: "zone.j2"
       dest: "{{ dns_configuration_directory }}/{{ item.name }}.zone"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0640'
       validate: "named-checkzone {{ item.name }} %s"
     loop: "{{ dns_zones }}"
     notify: Rndc reload

   - name: Add zones to configuration
     template:
       src: "named.conf.j2"
       dest: "{{ dns_configuration_directory }}/named.conf"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0640'
     notify: Restart dns

   - name: Place systemd override
     template:
       src: "systemd_override.conf.j2"
       dest: "/etc/systemd/system/dns.service.d/override.conf"
     notify: Reload systemd
     when: ansible_service_mgr == 'systemd'

   - name: Start and enable dns
     service:
       name: dns
       state: started
       enabled: true

