---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'Internet Site'
    vtype: string

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.cf.j2
    dest: /etc/postfix/transport_maps.cf
  notify:
    - Validate postfix
    - Rebuild transport maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks.cf.j2
    dest: /etc/postfix/header_checks.cf
  notify:
    - Validate postfix
    - Reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_sender_access_restrictions: "{{ sender_access_restrictions }}"
    postfix_recipient_access_restrictions: "{{ recipient_access_restrictions }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: "{{ mynetworks }}"
    postfix_mydestination: "{{ mydestination }}"
    postfix_relay_domains: "{{ relay_domains }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate postfix
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate postfix
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: /etc/postfix/cert
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: postfix_tls_cert.pem
    dest: /etc/postfix/cert/cert.pem
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: postfix_tls_key.pem
    dest: /etc/postfix/cert/key.pem
  notify:
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  blockinfile:
    path: /etc/aliases
    block: |
      {{ aliases_content }}
  notify:
    - Rebuild aliases
    - Reload postfix

- name: Configure sender_access
  template:
    src: sender_access.cf.j2
    dest: /etc/postfix/sender_access.cf
  notify:
    - Rebuild sender_access
    - Reload postfix

- name: Configure recipient_access
  template:
    src: recipient_access.cf.j2
    dest: /etc/postfix/recipient_access.cf
  notify:
    - Validate postfix
    - Rebuild recipient_access
    - Reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
  notify:
    - Rebuild sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes


