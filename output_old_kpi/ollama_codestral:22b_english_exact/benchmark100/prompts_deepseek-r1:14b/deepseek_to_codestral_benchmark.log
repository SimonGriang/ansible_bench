 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       regexp: "{{ item.regexp }}"
       line: "{{ item.line }}"
     loop: "{{ mysql_configuration_options }}"
     notify: Restart mysql server

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/client.cnf
       regexp: '^socket'
       line: 'socket = /var/run/mysqld/mysqld.sock'

   - name: Initialize mysql
     command: mysql_install_db
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql
     systemd:
       name: mysql
       state: started
       enabled: yes

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /etc/my.cnf
       mode: '0644'

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
     loop: "{{ mysql_databases | default([]) }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       host: "{{ item.host | default('localhost') }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv | default('*.*:ALL') }}"
       state: present
     loop: "{{ mysql_users | default([]) }}"

   - name: Flush handlers again
     meta: flush_handlers

