 - name: Generate an OpenSSL private key
     openssl_privatekey:
       path: "{{ key_directory }}/{{ private_key_filename }}"
       mode: "{{ private_key_mode }}"
       owner: "{{ private_key_owner }}"

   - name: Generate an OpenSSL Certificate Signing Request (CSR)
     openssl_csr:
       path: "{{ csr_directory }}/{{ csr_filename }}"
       privatekey_path: "{{ key_directory }}/{{ private_key_filename }}"
       common_name: "{{ common_name }}"
       mode: "{{ csr_mode }}"
       owner: "{{ csr_owner }}"

   - name: Generate an OpenSSL X.509 certificate
     openssl_certificate:
       path: "{{ cert_directory }}/{{ cert_filename }}"
       privatekey_path: "{{ key_directory }}/{{ private_key_filename }}"
       csr_path: "{{ csr_directory }}/{{ csr_filename }}"
       provider: selfsigned
       mode: "{{ cert_mode }}"
       owner: "{{ cert_owner }}"

   - name: Generate a PKCS#12 file
     openssl_pkcs12:
       path: "{{ pkcs12_directory }}/{{ pkcs12_filename }}"
       privatekey_path: "{{ key_directory }}/{{ private_key_filename }}"
       certificate_path: "{{ cert_directory }}/{{ cert_filename }}"
       friendly_name: "{{ friendly_name }}"
       mode: "{{ pkcs12_mode }}"
       owner: "{{ pkcs12_owner }}"

   - name: Read private key content
     slurp:
       src: "{{ key_directory }}/{{ private_key_filename }}"
     register: private_key_content

   - name: Read certificate content
     slurp:
       src: "{{ cert_directory }}/{{ cert_filename }}"
     register: cert_content

   - name: Create a combined private key and certificate file
     copy:
       content: |
         {{ private_key_content['content'] | b64decode }}
         {{ cert_content['content'] | b64decode }}
       dest: "{{ combined_file_directory }}/{{ combined_file_filename }}"
       mode: "{{ combined_file_mode }}"
       owner: "{{ combined_file_owner }}"

