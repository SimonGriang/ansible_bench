 - name: Migrate adoptopenjdk to temurin
     set_fact:
       java_jdk_vendor: temurin
     when: java_jdk_vendor == 'adoptopenjdk'

   - name: Gather OS specific variables
     include_vars:
       file: "{{ java_jdk_vendor }}_{{ ansible_os_family }}_{{ ansible_distribution_major_version }}.yml"

   - name: Gather architecture specific variables
     include_vars:
       file: "{{ ansible_architecture }}.yml"

   - name: Set OS specific variables
     set_fact:
       openjdk_version: "{{ openjdk_version | default('11') }}"
       openjdk_repos: "{{ openjdk_repos | default([]) }}"
       openjdk_libs: "{{ openjdk_libs | default([]) }}"

   - name: Set OS and architecture specific variables
     set_fact:
       openjdk_install_path: "{{ openjdk_install_path | default('/usr/lib/jvm') }}"
       openjdk_package_name: "{{ openjdk_package_name | default('openjdk-' + openjdk_version + '-jdk') }}"

   - name: Set specific variables
     set_fact:
       java_home: "{{ openjdk_install_path }}/{{ openjdk_package_name }}"

   - name: Debian pre-requisites
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: "{{ item }}"
           state: absent
         loop: "{{ openjdk_deprecated_repos }}"
       - name: Install extra apt tools
         apt:
           name: software-properties-common
           state: present
       - name: Add key repositories
         apt_key:
           url: "{{ item }}"
           state: present
         loop: "{{ openjdk_key_repos }}"
       - name: Add required repositories
         apt_repository:
           repo: "{{ item }}"
           state: present
         loop: "{{ openjdk_repos }}"
     when: ansible_os_family == 'Debian'

   - name: RedHat pre-requisites
     block:
       - name: Add key repositories
         rpm_key:
           state: present
           key: "{{ item }}"
         loop: "{{ openjdk_key_repos }}"
       - name: Add required repositories
         yum_repository:
           name: openjdk
           description: OpenJDK Repository
           baseurl: "{{ openjdk_repos }}"
           gpgcheck: yes
           enabled: yes
     when: ansible_os_family == 'RedHat'

   - name: Install required libs
     package:
       name: "{{ openjdk_libs }}"
       state: present

   - name: Install Java, Debian
     apt:
       name: "{{ openjdk_package_name }}"
       state: present
     when: ansible_os_family == 'Debian'

   - name: Install Java, RedHat
     yum:
       name: "{{ openjdk_package_name }}"
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Export environment variables
     template:
       src: java.sh.j2
       dest: /etc/profile.d/java.sh

   - name: Source environment variables
     shell: source /etc/profile.d/java.sh
     args:
       executable: /bin/bash

   - name: Correct java version selected for Java < 11
     alternatives:
       name: java
       path: "{{ java_home }}/jre/bin/java"
     when: openjdk_version is version('11', '<')

   - name: Correct java version selected for Java >= 11
     alternatives:
       name: java
       path: "{{ java_home }}/bin/java"
     when: openjdk_version is version('11', '>=')


