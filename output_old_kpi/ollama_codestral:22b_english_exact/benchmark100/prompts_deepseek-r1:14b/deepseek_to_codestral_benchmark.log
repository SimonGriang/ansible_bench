 - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       mode: '0755'

   - name: Set server taints
     when: rke2_role == "server"
     command: "rke2 server --config /etc/rancher/rke2/config.yaml --set-taints {{ rke2_server_node_taints }}"

   - name: Copy RKE2 configuration file
     copy:
       src: rke2_config.yaml
       dest: /etc/rancher/rke2/config.yaml
       mode: '0644'
     notify: Restart RKE2 service

   - name: Copy kubelet configuration file
     when: rke2_kubelet_config | length > 0
     copy:
       content: "{{ rke2_kubelet_config }}"
       dest: /etc/rancher/rke2/kubelet-config.yaml
       mode: '0644'
     notify: Restart RKE2 service

   - name: Copy Containerd Registry Configuration file
     when: rke2_registries_config is defined or rke2_registries_mirrors is defined
     copy:
       content: |
         {% if rke2_registries_config is defined %}{{ rke2_registries_config | to_nice_yaml }}{% endif %}
         {% if rke2_registries_mirrors is defined %}mirrors: {{ rke2_registries_mirrors }}{% endif %}
       dest: /etc/rancher/rke2/registries.yaml
       mode: '0644'
     notify: Restart RKE2 service

   - name: Register etcd restore from file
     set_fact:
       rke2_etcd_restore_from_file: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file | length > 0 and rke2_service_state == 'stopped' }}"

   - name: Register etcd restore from S3
     set_fact:
       rke2_etcd_restore_from_s3: "{{ rke2_s3_options is defined and rke2_s3_options | length > 0 and rke2_s3_endpoint is defined and rke2_s3_endpoint | length > 0 and rke2_s3_bucket is defined and rke2_s3_bucket | length > 0 and rke2_s3_access_key is defined and rke2_s3_access_key | length > 0 and rke2_s3_secret_key is defined and rke2_s3_secret_key | length > 0 }}"

   - name: Restore etcd from file
     when: rke2_etcd_restore_from_file
     block:
       - name: Create etcd data directory
         file:
           path: /var/lib/rancher/rke2/server/db/etcd/member/snapshots
           state: directory
           mode: '0755'
       - name: Copy etcd snapshot file
         copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/etcd/member/snapshots/snapshot.db
       - name: Run etcd restore command
         command: "rke2 etcd-snapshot-restore /var/lib/rancher/rke2/server/db/etcd/member/snapshots/snapshot.db"

   - name: Restore etcd from S3
     when: rke2_etcd_restore_from_s3
     command: "rke2 server --config /etc/rancher/rke2/config.yaml --etcd-s3 {{ rke2_s3_options }} --etcd-s3-endpoint {{ rke2_s3_endpoint }} --etcd-s3-bucket {{ rke2_s3_bucket }} --etcd-s3-access-key {{ rke2_s3_access_key }} --etcd-s3-secret-key {{ rke2_s3_secret_key }}"

   - name: Start RKE2 service
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Restart RKE2 service

   - name: Mask RKE2 agent service
     systemd:
       name: rke2-agent.service
       state: stopped
       enabled: no
       masked: yes

   - name: Wait for first server to be ready (no CNI)
     when: rke2_cni_plugin is not defined or rke2_cni_plugin == "none"
     command: "rke2 status --config /etc/rancher/rke2/config.yaml"
     register: rke2_status
     until: rke2_status.stdout is search('sufficient resources and ready')
     retries: 60
     delay: 10

   - name: Wait for first server to be ready (with CNI)
     when: rke2_cni_plugin is defined and rke2_cni_plugin != "none"
     command: "kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml wait --for=condition=Ready node/{{ inventory_hostname }}"
     register: kubectl_status
     until: kubectl_status.rc == 0
     retries: 60
     delay: 10

   - name: Restore etcd
     when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3
     block:
       - name: Clean up old nodes and secrets
         # Add tasks to clean up old nodes and secrets
       # Add additional tasks as needed for etcd restoration

   - name: Set Active Server variable
     set_fact:
       rke2_active_server: "{{ inventory_hostname if rke2_role == 'server' and rke2_service_state == 'started' else none }}"
     delegate_to: "{{ item }}"
     loop: "{{ groups['cluster_group'] }}"
     run_once: yes

