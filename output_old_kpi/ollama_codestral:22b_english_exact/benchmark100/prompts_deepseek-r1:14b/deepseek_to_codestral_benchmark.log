 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop:
       - { path: '/var/lib/dns', mode: '0770', owner: 'root', group: 'root' }
       - { path: '/etc/dns', mode: '0750', owner: 'root', group: 'root' }

   - name: Create group
     group:
       name: "{{ dns_group }}"
       state: present

   - name: Create user
     user:
       name: "{{ dns_owner }}"
       system: yes
       state: present

   - name: Generate rndc key
     shell: rndc-confgen -a -c /etc/dns
     args:
       creates: /etc/dns/rndc.key

   - name: Set permissions on rndc key file
     file:
       path: /etc/dns/rndc.key
       owner: root
       group: "{{ dns_group }}"
       mode: 0640

   - name: Get the hints/root file
     get_url:
       url: ftp://ftp.internic.net/domain/named.root
       dest: /etc/dns/named.root
       mode: 0644
     when: dns_caching_dns | bool

   - name: Create zone file
     template:
       src: zone.j2
       dest: "/etc/dns/zones/{{ item }}.zone"
     vars:
       zone: "{{ item }}"
     loop: "{{ dns_zones }}"
     notify: Rndc reload

   - name: Add zones to configuration
     template:
       src: main.conf.j2
       dest: /etc/dns/main.conf
     notify: Restart dns

   - name: Place systemd override
     template:
       src: dns.service.j2
       dest: /etc/systemd/system/dns.service.d/override.conf
     notify: Reload systemd
     when: use_systemd | bool

   - name: Start and enable dns
     service:
       name: dns
       state: started
       enabled: yes

