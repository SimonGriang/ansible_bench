 - name: Install unzip package
     package:
       name: unzip
       state: present

   - name: Create system group for promtail
     group:
       name: promtail
       system: yes
       state: present

   - name: Create system user for promtail
     user:
       name: promtail
       group: promtail
       shell: /usr/sbin/nologin
       system: yes
       createhome: no

   - name: Ensure /usr/local/bin directory exists
     file:
       path: /usr/local/bin
       state: directory
       mode: '0755'

   - name: Create config directories
     file:
       path: "{{ item }}"
       state: directory
       owner: promtail
       group: promtail
       mode: '0755'
     with_items:
       - /etc/promtail
       - /etc/promtail/configs

   - name: Create application directories
     file:
       path: "{{ item }}"
       state: directory
       owner: promtail
       group: promtail
       mode: '0755'
     with_items:
       - /var/lib/promtail
       - /var/log/promtail

   - name: Check promtail binary existence
     stat:
       path: /usr/local/bin/promtail
     register: promtail_binary

   - name: Download promtail binaries
     get_url:
       url: "{{ promtail_distribution_url }}/promtail-{{ promtail_version }}-{{ platform_architecture }}.zip"
       dest: /tmp/promtail-{{ promtail_version }}.zip
       checksum: "sha256:{{ promtail_checksum }}"

   - name: Propagate local promtail binaries
     copy:
       src: "files/promtail-{{ promtail_version }}-{{ platform_architecture }}.zip"
       dest: /tmp/promtail-{{ promtail_version }}.zip
     when: not promtail_binary.stat.exists

   - name: Download promtail binaries for controller node
     get_url:
       url: "{{ promtail_distribution_url }}/promtail-{{ promtail_version }}-{{ platform_architecture }}.zip"
       dest: /tmp/promtail-{{ promtail_version }}.zip
       checksum: "sha256:{{ promtail_checksum }}"
     delegate_to: localhost

   - name: Propagate promtail binaries
     copy:
       src: /tmp/promtail-{{ promtail_version }}.zip
       dest: /tmp/promtail-{{ promtail_version }}.zip
     delegate_to: localhost

   - name: Unpack promtail binaries
     unarchive:
       src: /tmp/promtail-{{ promtail_version }}.zip
       dest: /usr/local/bin
       remote_src: yes

   - name: Create symlink to latest promtail version
     file:
       src: /usr/local/bin/promtail
       dest: /usr/local/bin/promtail-latest
       state: link
     notify: Restart promtail

   - name: Write promtail config file
     template:
       src: promtail.yaml.j2
       dest: /etc/promtail/config.yaml

   - name: Create systemd service unit
     template:
       src: promtail.service.j2
       dest: /etc/systemd/system/promtail.service
     notify: Restart promtail

