---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       regexp: "{{ item.key }}"
       line: "{{ item.key }} = {{ item.value }}"
       mode: 0644
     with_items: "{{ mysql_configuration_options }}"
     notify: Restart mysql server

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/client.cnf
       regexp: '^socket'
       line: 'socket = /var/run/mysqld/mysqld.sock'

   - name: Initialize mysql
     command: mysql_install_db
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /etc/my.cnf
       mode: 0644

   - name: Create databases
     mysql_db:
       name: "{{ item }}"
       state: present
     with_items: "{{ mysql_databases }}"
     when: mysql_databases is defined

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
     with_items: "{{ mysql_users }}"
     when: mysql_users is defined

   - name: Flush handlers again
     meta: flush_handlers

