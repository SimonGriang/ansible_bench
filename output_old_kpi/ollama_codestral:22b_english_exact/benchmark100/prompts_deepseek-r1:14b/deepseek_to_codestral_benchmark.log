      postfix_relay_domains: "{{ relay_domains }}"

  - name: Configure postfix (main.cf)
    template:
      src: main.cf.j2
      dest: /etc/postfix/main.cf
    notify:
      - Validate postfix
      - Restart postfix

  - name: Configure postfix (master.cf)
    template:
      src: master.cf.j2
      dest: /etc/postfix/master.cf
    notify:
      - Validate postfix
      - Restart postfix

  - name: Creates cert/key directory
    file:
      path: /etc/postfix/cert
      state: directory
      mode: '0700'

  - name: Deploy Postfix TLS server certificate
    copy:
      src: postfix_tls_cert.pem
      dest: /etc/postfix/cert/cert.pem
    notify:
      - Reload postfix

  - name: Deploy Postfix TLS server key
    copy:
      src: postfix_tls_key.pem
      dest: /etc/postfix/cert/key.pem
    notify:
      - Reload postfix

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    blockinfile:
      path: /etc/aliases
      block: |
        {{ aliases_content }}
    notify:
      - Rebuild aliases
      - Reload postfix

  - name: Configure sender_access
    template:
      src: sender_access.cf.j2
      dest: /etc/postfix/sender_access.cf
    notify:
      - Rebuild sender_access
      - Reload postfix

  - name: Configure recipient_access
    template:
      src: recipient_access.cf.j2
      dest: /etc/postfix/recipient_access.cf
    notify:
