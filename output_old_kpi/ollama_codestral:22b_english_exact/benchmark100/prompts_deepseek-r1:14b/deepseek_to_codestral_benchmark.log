---
- name: hardening | Disable swap
  when: vault_hardening_disable_swap
  block:
    - command: swapoff -a
    - replace:
        path: /etc/fstab
        regexp: '^([^#].*?\sswap\s+sw\s+.*)$'
        replace: '# \1'

- name: hardening | Disable core dumps
  when: vault_hardening_disable_core_dumps
  pam_limits:
    domain: '*'
    limit_type: '{{ item }}'
    limit_item: core
    value: 0
  loop:
    - hard
    - soft

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history
  lineinfile:
    path: /etc/profile.d/vault.sh
    line: HISTCONTROL=ignorespace:erasedups:ignoredups
    create: yes

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor
  block:
    - name: Enable SELinux
      ansible.posix.selinux:
        policy: targeted
        state: enforcing
    - name: Install required SELinux policies
      command: semodule -i /path/to/policy.pp
    - name: Enforce AppArmor profiles for Vault
      command: apparmor_parser -r /etc/apparmor.d/usr.bin.vault

