 - name: Download RKE2 installation script
     when: not airgap_mode
     get_url:
       url: "{{ rke2_install_script_url }}"
       dest: "{{ rke2_artifacts_dir }}/rke2.sh"
       mode: "0700"

   - name: Copy local RKE2 installation script
     when: airgap_mode and rke2_install_script_src is defined
     copy:
       src: "{{ rke2_install_script_src }}"
       dest: "{{ rke2_artifacts_dir }}/rke2.sh"
       mode: "0700"

   - name: Create RKE2 artifacts folder
     when: airgap_mode and not rke2_artifacts_exist
     file:
       path: "{{ rke2_artifacts_dir }}"
       state: directory
       mode: "0700"

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Download RKE2 checksum and artifacts
         get_url:
           url: "{{ item.url }}"
           dest: "{{ rke2_artifacts_dir }}/{{ item.filename }}"
           checksum: "sha256:{{ item.checksum }}"
         loop: "{{ rke2_artifacts }}"
     rescue:
       - name: Fallback to local download
         copy:
           src: "{{ rke2_artifacts_local_dir }}/{{ item.filename }}"
           dest: "{{ rke2_artifacts_dir }}/{{ item.filename }}"
           mode: preserve
         loop: "{{ rke2_artifacts }}"
         when: airgap_mode

   - name: Copy local RKE2 artifacts
     when: airgap_mode and rke2_artifacts_src is defined
     copy:
       src: "{{ rke2_artifacts_src }}/"
       dest: "{{ rke2_artifacts_dir }}/"
       mode: "0640"

   - name: Airgap mode - additional images tarballs
     when: airgap_mode and additional_tarballs is defined
     block:
       - name: Create directory for additional images tarballs
         file:
           path: "{{ additional_tarballs_dir }}"
           state: directory
       - name: Copy additional images tarballs
         copy:
           src: "{{ item }}"
           dest: "{{ additional_tarballs_dir }}/"
         loop: "{{ additional_tarballs }}"

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     when: airgap_mode and rke2_artifacts_exist
     file:
       path: "{{ item.path }}"
       state: "{{ item.state }}"
       mode: "{{ item.mode }}"
     loop:
       - { path: "{{ rke2_artifacts_dir }}", state: directory, mode: "0700" }
       - { path: "{{ rke2_artifacts_dir }}/rke2.sh", state: file, mode: "0700" }

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: usr_local_stat

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if usr_local_stat.stat.writeable and usr_local_stat.stat.isdir else '/var/lib/rancher/rke2/bin' }}"

   - name: Check RKE2 version
     shell: |
       set -o pipefail
       {{ rke2_bin_path }}/rke2 --version | head -1 | cut -d ' ' -f 2
     register: installed_rke2_version
     changed_when: false
     ignore_errors: true

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - not (installed_rke2_version.stdout | regex_replace('^v', '')) is version(rke2_version, '<') or allow_downgrade
