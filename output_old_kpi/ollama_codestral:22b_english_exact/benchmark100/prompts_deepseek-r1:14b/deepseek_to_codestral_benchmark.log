 - name: Create the RKE2 configuration directory
     file:
       path: /etc/rancher/rke2
       state: directory
       mode: '0755'

   - name: Set server taints
     lineinfile:
       path: /var/lib/rancher/rke2/server/config.yaml
       regexp: '^server-taint:'
       line: "server-taint: {{ rke2_server_taint }}"
     when: rke2_node_type == 'server'

   - name: Set agent taints
     lineinfile:
       path: /var/lib/rancher/rke2/agent/config.yaml
       regexp: '^agent-taint:'
       line: "agent-taint: {{ rke2_agent_taint }}"
     when: rke2_node_type == 'agent'

   - name: Copy RKE2 configuration file
     template:
       src: config.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
       mode: '0644'
     notify:
       - Restart RKE2 service

   - name: Copy Kubelet configuration file
     template:
       src: kubelet.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       mode: '0644'
     when: rke2_kubelet_config is defined
     notify:
       - Restart RKE2 service

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_containerd_registry_config_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       mode: '0644'
     when: rke2_containerd_registry_config_path is defined
     notify:
       - Restart RKE2 service

   - name: Start RKE2 service on other nodes
     systemd:
       name: rke2-server.service
       state: started
       enabled: true
     when: inventory_hostname != ansible_hostname
     notify:
       - Check node readiness - no CNI
       - Check node readiness - with CNI

   - name: Mask other RKE2 services on nodes
     systemd:
       name: "{{ 'rke2-server.service' if rke2_node_type == 'agent' else 'rke2-agent.service' }}"
       masked: true

   - name: Wait for remaining nodes to be ready - no CNI
     wait_for:
       host: "{{ item }}"
       port: 6443
       timeout: 300
     loop: "{{ groups['all'] | difference([ansible_hostname]) }}"
     when: rke2_configure_cni is not defined

   - name: Wait for remaining nodes to be ready - with CNI
     wait_for:
       host: "{{ item }}"
       port: 6443
       timeout: 600
     loop: "{{ groups['all'] | difference([ansible_hostname]) }}"
     when: rke2_configure_cni is defined

