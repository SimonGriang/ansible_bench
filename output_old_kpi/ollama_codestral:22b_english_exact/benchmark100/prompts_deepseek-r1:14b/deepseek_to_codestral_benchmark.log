     command: "realpath $(readlink -f /usr/bin/java)"
     register: java_home

   - name: Set JAVA_HOME in environment
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: 'export JAVA_HOME="{{ java_home.stdout }}"'
       create: yes
     become: yes

   - name: Ensure new line at end of file
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: ''
       state: present
       insertafter: EOF
     become: yes

