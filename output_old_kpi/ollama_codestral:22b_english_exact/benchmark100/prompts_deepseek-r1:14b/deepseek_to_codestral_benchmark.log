 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Configure apk
     apk:
       update_cache: yes
       upgrade: dist
       cache_valid_time: 0
     changed_when: false

   - name: Configure apt
     apt:
       upgrade: dist
       update_cache: yes
       dpkg_options: 'force-confold,force-confdef'
       autoclean: yes
       autoremove: yes

   - name: Update all software (dnf)
     dnf:
       name: '*'
       state: latest
       exclude: 'package1,package2'

   - name: Update all software (pacman)
     pacman:
       update_cache: yes
       upgrade: yes

   - name: Configure yum
     block:
       - name: Check CentOS/RHEL version
         shell: "grep -oP '(?<=^release )[0-9]' /etc/redhat-release"
         register: release
         changed_when: false

       - name: Update all software (yum) for CentOS/RHEL 6
         yum:
           name: '*'
           state: latest
         when: release.stdout == '6'

       - name: Update all software (dnf) for non-CentOS/RHEL 6
         dnf:
           name: '*'
           state: latest
         when: release.stdout != '6'
     rescue:
       - name: Install yum-utils
         yum:
           name: yum-utils
           state: present

   - name: Update all software (zypper)
     zypper:
       name: '*'
       state: latest
       update_cache: yes

