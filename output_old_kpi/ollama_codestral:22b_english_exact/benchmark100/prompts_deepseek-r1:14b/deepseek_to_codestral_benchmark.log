content=' ```yaml\n---\n- name: Import assertion tasks\n  import_tasks: assert.yml\n  run_once: yes\n  delegate_to: localhost\n\n- name: Install prerequisites\n  package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    line: "{{ item }}"\n  loop: "{{ vault_environment_settings }}"\n  notify: Restart vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n\n- name: Start and enable vault (for OSS type)\n  systemd:\n    name: vault\n    state: started\n    enabled: yes\n  when: vault_type == "oss"\n\n- name: Enable vault (for non-OSS type)\n  systemd:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"\n```' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-05T12:50:51.352547487Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7133137537, 'load_duration': 25089746, 'prompt_eval_count': 573, 'prompt_eval_duration': 571994082, 'eval_count': 273, 'eval_duration': 6535026152, 'model_name': 'codestral:22b'} id='run--a99876f2-ff65-4c93-9a5c-6189925d97a6-0' usage_metadata={'input_tokens': 573, 'output_tokens': 273, 'total_tokens': 846}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Import assertion tasks
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
  loop: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault (for OSS type)
  systemd:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault (for non-OSS type)
  systemd:
    name: vault
    enabled: yes
  when: vault_type != "oss"


