    register: pods_ready
    until: pods_ready.stdout == "0"
    retries: 100
    delay: 15
    delegate_to: "{{ groups[rke2_servers_group_name].0 }}"
    when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready


