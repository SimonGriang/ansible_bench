---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install mysql
     package:
       name: "{{ packages }}"
     notify:
       - root password
       - systemctl daemon reexecute

   - name: Configure mysql server
     lineinfile:
       path: /etc/my.cnf
       regexp: '^bind-address'
       line: 'bind-address = 0.0.0.0'
     notify: mysql server restart

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       regexp: '^socket'
       line: 'socket = /var/run/mysqld/mysqld.sock'

   - name: Initialize mysql
     command: mysql_install_db --user=mysql
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql
     systemd:
       name: "{{ mysql_service_name }}"
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /etc/my.cnf
       mode: '0644'

   - name: List databases
     mysql_info:
       login_user: root
       login_password: "{{ mysql_root_password }}"
       filter: databases
     register: mysql_databases

   - name: Create databases
     mysql_db:
       name: "{{ item }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       state: present
     loop: "{{ mysql_databases_to_create }}"
     when: initial_import is not defined

   - name: Import database
     mysql_db:
       name: all
       login_user: root
       login_password: "{{ mysql_root_password }}"
       state: import
       target: "{{ initial_import }}"
     when: initial_import is defined and item not in mysql_databases.databases

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
     loop: "{{ mysql_users }}"
     notify: mysql server restart

   - name: Flush handlers again
     meta: flush_handlers

