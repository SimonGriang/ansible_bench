Task 1: Download RKE2 installation script
Description Task 1: Download the RKE2 installation script from a URL if not in airgap mode.

Task 2: Copy local RKE2 installation script
Description Task 2: Copy the RKE2 installation script from a local source path if in airgap mode and the implementation is 'copy'.

Task 3: Create RKE2 artifacts folder
Description Task 3: Create the directory for RKE2 artifacts if in airgap mode and the implementation is not 'exists'.

Task 4: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
Description Task 4: Attempt to download RKE2 artifacts and checksums remotely in airgap mode. If that fails, download locally and copy to remote hosts.

Task 5: Copy local RKE2 artifacts
Description Task 5: Copy local RKE2 artifacts to the remote artifact path when in airgap mode and the implementation is 'copy'.

Task 6: Airgap mode - additional images tarballs
Description Task 6: Copy additional tarball images for RKE2 components in airgap mode if defined.

Task 7: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
Description Task 7: Ensure RKE2 artifacts exist and have appropriate permissions in airgap mode, adjusting if needed.

Task 8: Populate service facts
Description Task 8: Gather facts about running services.

Task 9: Get stats of the FS object
Description Task 9: Get filesystem statistics for /usr/local.

Task 10: Check if separate partition
Description Task 10: Determine if /usr/local is on a separate partition.

Task 11: Set RKE2 bin path
Description Task 11: Set the path to the RKE2 binary based on filesystem configuration.

Task 12: Check RKE2 version
Description Task 12: Check the installed and running versions of RKE2.

Task 13: Set RKE2 versions
Description Task 13: Set the installed and running RKE2 versions as facts.

Task 14: Prevent accidental RKE2 downgrade
Description Task 14: Assert that a downgrade is not attempted unless explicitly allowed.

Task 15: Run RKE2 install script
Description Task 15: Run the RKE2 installation script with appropriate environment variables.

Task 16: Copy Custom Manifests
Description Task 16: Copy custom Kubernetes manifests to the RKE2 data directory.

Task 17: Copy Static Pods
Description Task 17: Copy static pod manifests to the RKE2 agent directory.

Task 18: Copy RKE2 environment file
Description Task 18: Copy the RKE2 environment file with defined options.


- Last generated (faulty) playbook: 
 - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_install_url }}"
       dest: "{{ rke2_tmp_install_script_path }}"
       mode: '0755'
     when:
       - not rke2_airgap_mode

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_install_script_path }}"
       dest: "{{ rke2_tmp_install_script_path }}"
       mode: '0755'
     when:
       - rke2_airgap_mode
       - rke2_airgap_implementation == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_airgap_image_path }}"
       state: directory
     when:
       - rke2_airgap_mode
       - rke2_airgap_implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Attempt to download RKE2 artifacts and checksums remotely
         get_url:
           url: "{{ item.url }}"
           dest: "{{ rke2_airgap_image_path }}/"
           checksum: "sha256:{{ item.sha256 }}"
         loop: "{{ rke2_airgap_images }}"
         register: remote_download_result
         ignore_errors: true

       - name: Download locally and copy to remote hosts if remote download failed
         block:
           - name: Download locally
             get_url:
               url: "{{ item.url }}"
               dest: "/tmp/"
               checksum: "sha256:{{ item.sha256 }}"
             loop: "{{ rke2_airgap_images }}"

           - name: Copy to remote hosts
             copy:
               src: "/tmp/{{ item.url | basename }}"
               dest: "{{ rke2_airgap_image_path }}/"
             loop: "{{ rke2_airgap_images }}"
         when: remote_download_result.results | selectattr('failed') | list | length > 0
     when:
       - rke2_airgap_mode

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_local_image_path }}/{{ item.url | basename }}"
       dest: "{{ rke2_airgap_image_path }}/"
     loop: "{{ rke2_airgap_images }}"
     when:
       - rke2_airgap_mode
       - rke2_airgap_implementation == 'copy'

   - name: Airgap mode - additional images tarballs
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_airgap_image_path }}/"
     loop: "{{ rke2_airgap_additional_images }}"
     when:
       - rke2_airgap_mode
       - rke2_airgap_additional_images is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_airgap_image_path }}/{{ item.url | basename }}"
       mode: '0644'
     loop: "{{ rke2_airgap_images }}"
     when:
       - rke2_airgap_mode

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: rke2_usr_local_stat

   - name: Check if separate partition
     set_fact:
       rke2_separate_partition: "{{ rke2_usr_local_stat.stat.dev !=
         ansible_mounts | selectattr('mount', 'equalto', '/') |
         map(attribute='dev') | first }}"

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if rke2_separate_partition else
         '/opt/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version"
     register: rke2_version_check
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       rke2_installed_version: "{{ rke2_version_check.stdout_lines[0].split(' ')[2]
         if rke2_version_check.stdout_lines | length > 0 else '' }}"
       rke2_running_version: "{{ ansible_facts.services['rke2-server.service'].state
         == 'running' | ternary(rke2_installed_version, '') }}"

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - rke2_allow_downgrade or
           (rke2_installed_version == '' or
           rke2_running_version == '' or
           rke2_installed_version is version(rke2_running_version, '>=') or
           rke2_installed_version is version(rke2_version, '>='))
       fail_msg: >-
         Downgrading RKE2 is not allowed.
         To force the installation, set rke2_allow_downgrade to true.

   - name: Run RKE2 install script
     shell: >-
       {{ rke2_tmp_install_script_path }}
       INSTALL_RKE2_TYPE={{ rke2_type }}
       INSTALL_RKE2_VERSION={{ rke2_version }}

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/"
     loop: "{{ rke2_custom_manifests }}"
     when:
       - rke2_custom_manifests is defined

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_agent_data_path }}/manifests/rke2/"
     loop: "{{ rke2_static_pods }}"
     when:
       - rke2_static_pods is defined

   - name: Copy RKE2 environment file
     template:
       src: rke2-environment.j2
       dest: /etc/default/rke2
       mode: '0644'

