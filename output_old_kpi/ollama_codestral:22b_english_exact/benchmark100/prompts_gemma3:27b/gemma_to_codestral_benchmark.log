     template:
       src: server.conf.j2
       dest: "{{ openvpn_configuration_directory }}/server.conf"
       owner: "{{ openvpn_user }}"
       group: "{{ openvpn_group }}"
       mode: '0640'
     notify: Restart openvpn

   - name: Ensure openvpn is enabled and started
     service:
       name: openvpn
       enabled: yes
       state: started

