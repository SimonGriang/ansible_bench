     block:
       - seboolean:
           name: "{{ item }}"
           state: yes
           persistent: yes
         loop: "{{ httpd_sebooleans }}"
       - seport:
           ports: "{{ httpd_port }},{{ httpd_ssl_port }}"
           proto: tcp
           setype: http_port_t
           state: present

