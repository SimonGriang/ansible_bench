     file:
       path: "{{ item }}"
       state: directory
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0755'
     loop:
       - "{{ dns_datadir }}"
       - "{{ dns_confdir }}"

   - name: Create group
     group:
       name: "{{ dns_group }}"
       state: present

   - name: Create user
     user:
       name: "{{ dns_owner }}"
       system: yes

   - name: Generate rndc key
     shell: rndc-confgen -a -c "{{ dns_confdir }}/rndc.key"
     args:
       creates: "{{ dns_confdir }}/rndc.key"

   - name: Set permissions on rndc key file
     file:
       path: "{{ dns_confdir }}/rndc.key"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0640'

   - name: Get the hints/root file
     get_url:
       url: "{{ dns_root_hints_url }}"
       dest: "{{ dns_datadir }}/root.hints"
     when: dns_caching_dns | bool
     notify: Rndc reload

   - name: Create zone file
     template:
       src: zone.j2
       dest: "{{ dns_confdir }}/{{ item.name }}.zone"
     loop: "{{ dns_zones }}"
     notify: Rndc reload

   - name: Validate zone file
     shell: named-checkzone "{{ item.name }}" "{{ dns_confdir }}/{{ item.name }}.zone"
     loop: "{{ dns_zones }}"

   - name: Set permissions on zone file
     file:
       path: "{{ dns_confdir }}/{{ item.name }}.zone"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0644'
     loop: "{{ dns_zones }}"

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: /etc/named.conf
       validate: named-checkconf -t -z %s
       backup: yes
     notify: Restart dns

   - name: Place systemd override
     block:
       - name: Create systemd override directory
         file:
           path: /etc/systemd/system/named.service.d
           state: directory
       - name: Copy override configuration file
         copy:
           src: override.conf
           dest: /etc/systemd/system/named.service.d/override.conf
       - name: Reload systemd daemon
         systemd:
           daemon_reload: yes
     when: ansible_service_mgr == "systemd"

   - name: Start and enable dns
     service:
       name: "{{ dns_service }}"
       state: started
       enabled: yes
