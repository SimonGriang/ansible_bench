The corrected YAML playbook is as follows:

```yaml
---
- name: Manage RKE2 Cluster
  hosts: rke2_cluster
  tasks:
    - name: Restart Service
      systemd:
        name: rke2-server.service
        state: restarted
      notify:
        - Restart Service Handler

    - name: Wait for Nodes Ready
      command: >
        rke2 etcd snapshot status
        --config /etc/rke2/rke2.yaml | grep "Finished"
      register: etcd_status
      until: etcd_status.stdout.find("Finished") != -1
      retries: 60
      delay: 10

  handlers:
    - name: Restart Service Handler
      systemd:
        name: rke2-server.service
        state: restarted
```

