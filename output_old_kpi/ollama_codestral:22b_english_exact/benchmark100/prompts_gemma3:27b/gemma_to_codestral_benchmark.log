Here's the corrected playbook:

```yaml
- name: gather bootstrap facts
  raw: cat /etc/*release
  register: bootstrap_facts
  become: false
  tags:
    - always

- name: set bootstrap facts (I) based on OS release information
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('(?<=\\b' ~ item.value ~ '\\b\\s*[=|\\s]\\s*)\\d+') }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is search(item.value)
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    loop_var: item

- name: set bootstrap facts (II) based on OS family
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  when: bootstrap_distribution in item.value
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    loop_var: item
    label: "{{ item.key }}"
```
