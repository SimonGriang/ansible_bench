         block:
           - name: Install latest hashicorp product using package
             apt:
               name: "{{ item }}"
             loop: "{{ hashicorp_products }}"
             loop_control:
               label: "{{ item }}"
             when: hashicorp_products is defined and
                   (item.split(version_coupler)[-1] | regex_search('^[0-9]+\.[0-9]+\.[0-9]+$')) is none

           - name: Install versioned hashicorp product using package
             apt:
               name: "{{ item }}{{ version_coupler }}{{ item.split(version_coupler)[-1] }}"
             loop: "{{ hashicorp_products }}"
             loop_control:
               label: "{{ item }}"
             when: hashicorp_products is defined and
                   (item.split(version_coupler)[-1] | regex_search('^[0-9]+\.[0-9]+\.[0-9]+$')) is not none
         when: hashicorp_products is defined
     when: hashicorp_installation_method == "package"

   - name: Install manually
     block:
       - name: Install hashicorp product manually
         unarchive:
           src: "{{ hashicorp_src }}/{{ item }}_{{ hashicorp_version }}_
