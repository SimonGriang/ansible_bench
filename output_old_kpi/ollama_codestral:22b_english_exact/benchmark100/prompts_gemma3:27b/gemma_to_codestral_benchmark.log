 - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     lineinfile:
       path: "/etc/mysql/{{ mysql_name }}-server.cnf"
       regexp: "^(.*\\s){{ item.option }}\\s*=.*$"
       line: "{{ item.option }} = {{ item.value }}"
       state: present
     with_items: "{{ mysql_configuration_options }}"
     notify:
       - Restart mysql server

   - name: Configure mysql client
     lineinfile:
       path: "/etc/mysql/{{ mysql_name }}-client.cnf"
       regexp: "^socket\\s*=.*$"
       line: "socket = {{ mysql_socket }}"
       state: present

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family in ['Alpine', 'Archlinux']

   - name: Start and enable mysql
     service:
       name: "{{ mysql_service }}"
       state: started
       enabled: true

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: '0640'

   - name: Create databases
     mysql_db:
       name: "{{ item }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     with_items: "{{ mysql_databases }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       host: "{{ item.host }}"
       priv: "{{ item.priv }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     with_items: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers

