 - name: Task 1 - Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Task 2 - Install git
     package:
       name: "{{ git_packages }}"
       state: present

   - name: Task 3 - See if the specified user exists
     getent:
       key: passwd
       database: "{{ git_username }}"
     register: getent_result
     ignore_errors: yes
     failed_when: getent_result is failed and not (fail_key | default(false))

   - name: Task 4 - Create directory for git configuration
     file:
       path: "/home/{{ git_username }}"
       state: directory
       owner: "{{ git_username }}"
       group: "{{ git_username }}"
       mode: "0755"

   - name: Task 5 - Place git configuration
     template:
       src: gitconfig.j2
       dest: "/home/{{ git_username }}/.gitconfig"
       owner: "{{ git_username }}"
       group: "{{ git_username }}"
       mode: "0644"

   - name: Task 6 - Create repository_destination
     file:
       path: "{{ git_repository_destination }}"
       state: directory
       owner: "{{ git_username }}"
       group: "{{ git_username }}"
       mode: "0755"

   - name: Task 7 - Clone all roles
     git:
       repo: "{{ item.repository_url }}"
       dest: "{{ git_repository_destination }}/{{ item.destination_path }}"
       version: "{{ item.version }}"
       force: "{{ item.force | default(omit) }}"
     loop: "{{ git_repositories }}"
     loop_control:
       label: "{{ git_repository_destination }}/{{ item.destination_path }}"
     become: yes
     become_user: "{{ git_username }}"

