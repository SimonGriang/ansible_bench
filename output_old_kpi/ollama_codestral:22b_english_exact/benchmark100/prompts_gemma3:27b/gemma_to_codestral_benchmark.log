       src: registry.j2
       dest: /etc/rancher/rke2/registries.yaml
       mode: '0640'
     when:
       - rke2_custom_registry_mirrors | length > 0 or
         rke2_custom_registry_configs | length > 0
     notify: restart rke2

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: rke2-server.service
       state: started
       enabled: true
       daemon_reload: true
     environment:
       RKE2_TOKEN: "{{ rke2_server_token }}"
     register: rke2_service_status
     until: rke2_service_status is succeeded
     retries: 10
     delay: 10
     notify: restart rke2

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       masked: true
       state: stopped
     with_items:
       - rke2-agent.service
       - rke2-server.socket
     when: rke2_type == 'agent'

   - name: Wait for remaining nodes to be ready - no CNI
     shell: |
       kubectl get nodes |
       grep -E 'memory|disk|pid|network-uninitialized' || true
     register: nodes_status
     until: nodes_status.stdout_lines | length == 0
     retries: 20
     delay: 15
     when:
       - cni == 'none'
       - inventory_hostname == groups['rke2_server'][0] or rke2_type == 'server'

   - name: Wait for remaining nodes to be ready - with CNI
     shell: |
       kubectl get nodes |
       grep -c ' Ready ' |
       grep -E '^[1-9][0-9]*$'
     register: ready_nodes
     until: ready_nodes.stdout | int == groups['rke2_cluster'] | length
     retries: 20
     delay: 15
     when:
       - cni != 'none'
       - inventory_hostname == groups['rke2_server'][0] or rke2_type == 'server'

Changes Made:
1. Added 'or' in the 'when' condition of the 'Copy Containerd Registry Configuration file' task to fix the syntax error.
2. Formatted the commands in the 'Wait for remaining nodes to be ready' tasks to ensure they comply with the line-length rule.
3. Fixed the indentation in the 'Wait for remaining nodes to be ready' tasks for consistency.
