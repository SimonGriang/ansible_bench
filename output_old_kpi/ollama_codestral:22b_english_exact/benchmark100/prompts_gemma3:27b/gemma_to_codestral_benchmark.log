       name: "{{ item.name }}"
       state: "{{ item.state }}"
       version: "{{ item.version }}"
     loop: "{{ python_pip_modules }}"
     loop_control:
       label: "{{ item.name }}"
     when: ansible_os_family != "Debian" or (ansible_distribution_release != "bookworm" and ansible_distribution_release != "noble") and ansible_os_family != "Alpine"
