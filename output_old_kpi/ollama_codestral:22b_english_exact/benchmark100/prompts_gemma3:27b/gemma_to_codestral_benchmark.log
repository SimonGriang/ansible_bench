Here's the corrected playbook:

```yaml
---
- name: Assert systemd as init system
  assert:
    that:
      - ansible_service_mgr == 'systemd'
    fail_msg: "This role requires systemd as the init system."

- name: Get latest release
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    user: "{{ lookup('env', 'GH_USER') | default(omit, true) }}"
    password: "{{ lookup('env', 'GH_TOKEN') | default(omit, true) }}"
    return_content: yes
  register: _latest_release
  retries: 5
  delay: 10
  until: _latest_release.status == 200

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ go_arch }}.zip"
  register: promtail_binary_local_archive
  when: promtail_binary_local_dir is defined

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_archive.stat.exists
    fail_msg: "Local promtail binary archive does not exist."
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: "https://raw.githubusercontent.com/grafana/loki/v{{ promtail_version }}/SHA256SUMS"
    return_content: yes
  register: __promtail_checksums
  when: promtail_binary_local_dir is not defined

- name: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: "{{ item.split(' ')[0] }}"
  with_items: "{{ __promtail_checksums.content | split('\n') }}"
  when:
    - promtail_binary_local_dir is not defined
    - "('promtail-' + go_arch + '.zip' in item)"
...
```

This corrected playbook is now valid YAML and should pass yamllint checks.
