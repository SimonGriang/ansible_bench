---
   - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "SHELL={{ cron_shell }}"
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Configure path
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "PATH={{ cron_path }}"
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Configure mailto
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "MAILTO={{ cron_mailto }}"
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Start and enable cron
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.job }}"
       minute: "{{ item.minute }}"
       hour: "{{ item.hour }}"
       day: "{{ item.day }}"
       month: "{{ item.month }}"
       weekday: "{{ item.weekday }}"
       special_time: "{{ item.special_time }}"
       job: "{{ item.command }}"
       state: "{{ item.state | default('present') }}"
       user: "{{ item.user | default('root') }}"
     loop: "{{ cron_jobs | default([]) }}"
     loop_control:
       label: "{{ item.job }}"
     when: cron_jobs is defined2025-10-07 14:38:22,657 [INFO] __main__: Cleaned LLM output: ---
