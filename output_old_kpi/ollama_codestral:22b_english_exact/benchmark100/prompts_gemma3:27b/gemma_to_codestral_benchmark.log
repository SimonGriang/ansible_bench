2025-10-07 14:18:52,565 [INFO] __main__: Raw output is an AIMessage. Extracted content:  - name: Include keepalived tasks
     ansible.builtin.include_tasks: keepalived.yml
     when:
       - rke2_ha_mode
       - inventory_hostname in groups[rke2_servers_group_name]
       - rke2_api_ip is defined

   - name: Include RKE2 installation tasks
     ansible.builtin.include_tasks: rke2.yml
     vars:
       rke2_version: "{{ rke2_version }}"

   - name: Include CIS hardening tasks
     ansible.builtin.include_tasks: cis.yml
     when:
       - rke2_cis_profile is defined
       - rke2_cis_profile | length > 0

   - name: Include find active server tasks
     ansible.builtin.include_tasks: find_active_server.yml

   - name: Enable IPVS kernel module
     ansible.builtin.modprobe:
       name: ip_vs
       state: present
     when:
       - rke2_kubevip_ipvs_lb_enable
       - inventory_hostname in groups[rke2_servers_group_name]
       - rke2_ha_mode
       - not rke2_keepalived_enabled

   - name: Include kube-vip tasks
     ansible.builtin.include_tasks: kubevip.yml
     when:
       - rke2_ha_mode
       - rke2_kubevip_enabled
       - not rke2_keepalived_enabled
       - inventory_hostname == ansible_play_hosts[0]

   - name: Include ingress-nginx tasks
     ansible.builtin.include_tasks: ingress-nginx.yml
     when:
       - rke2_ingress_nginx_values is defined
       - rke2_ingress_nginx_values | length > 0
       - inventory_hostname == ansible_play_hosts[0]

   - name: Include first server tasks
     ansible.builtin.include_tasks: first_server.yml
     when:
       - inventory_hostname == ansible_play_hosts[0]
       - (active_server is not defined or groups[rke2_cluster_group_name] | length == 1)

   - name: Include first server restore tasks
     ansible.builtin.include_tasks: first_server_restore.yml
     when:
       - active_server is defined
       - (inventory_hostname == active_server or inventory_hostname == ansible_play_hosts[0])
       - (do_etcd_restore is defined or do_etcd_restore_from_s3 is defined)

   - name: Include download kubeconfig tasks
     ansible.builtin.include_tasks: download_kubeconfig.yaml
     when:
       - rke2_download_kubeconf
       - inventory_hostname == ansible_play_hosts[0]

   - name: Include remaining nodes tasks
     ansible.builtin.include_tasks: remaining_nodes.yml
     when:
       - active_server is defined
       - groups[rke2_cluster_group_name] | length >= 2

   - name: Rolling cordon and drain restart on servers
     ansible.builtin.include_tasks: rolling_cordon_drain.yml
     vars:
       target_group: "{{ rke2_servers_group_name }}"
     when:
       - installed_version is defined
       - installed_version != rke2_version

   - name: Rolling cordon and drain restart on agents
     ansible.builtin.include_tasks: rolling_cordon_drain.yml
     vars:
       target_group: "{{ rke2_agents_group_name }}"
     when:
       - installed_version is defined
       - installed_version != rke2_version
       - inventory_hostname not in groups[rke2_servers_group_name]

   - name: Flush handlers
     ansible.builtin.meta: flush_handlers

   - name: Rolling restart when config files change
     ansible.builtin.include_tasks: rolling_restart.yml
     vars:
       target_group: "{{ rke2_cluster_group_name }}"
     when:
       - rke2_restart_needed

   - name: Include summary tasks
     ansible.builtin.include_tasks: summary.yml

The corrected YAML playbook adheres to the yamllint checks, with proper indentation and line length. The playbook structure and tasks are maintained as per the original instructions.
