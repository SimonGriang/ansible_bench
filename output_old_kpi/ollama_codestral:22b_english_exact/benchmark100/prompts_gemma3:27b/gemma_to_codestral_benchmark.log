     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       dest: "{{ cron_configuration }}"
       regexp: '^SHELL='
       line: 'SHELL={{ cron_shell }}'
       create: yes
       mode: '0600'
     notify: Restart cron

   - name: Configure path
     lineinfile:
       dest: "{{ cron_configuration }}"
       regexp: '^PATH='
       line: 'PATH={{ cron_path }}'
       create: yes
       mode: '0600'
     notify: Restart cron

   - name: Configure mailto
     lineinfile:
       dest: "{{ cron_configuration }}"
       regexp: '^MAILTO='
       line: 'MAILTO={{ cron_mailto }}'
       create: yes
       mode: '0600'
     notify: Restart cron

   - name: Start and enable cron
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       job: "{{ item.job }}"
       minute: "{{ item.minute | default('*') }}"
       hour: "{{ item.hour | default('*') }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       special_time: "{{ item.special_time | default(omit) }}"
     loop: "{{ cron_jobs }}"
     loop_control:
       label: "{{ item.name }}"
     when: cron_jobs is defined

