 - name: Ensure the easy-rsa directory exists
     file:
       path: /etc/openvpn/easy-rsa
       state: directory
       mode: '0755'

   - name: Initialize the easy-rsa PKI
     shell: easyrsa init-pki
     args:
       chdir: /etc/openvpn/easy-rsa
     when: >
       pki_dir.stat.exists == false or
       pki_dir.stat.isdir == false
     vars:
       pki_dir:
         path: /etc/openvpn/easy-rsa/pki

   - name: Build the Certificate Authority (CA)
     shell: EASYRSA_BATCH=yes easyrsa build-ca nopass
     args:
       chdir: /etc/openvpn/easy-rsa
     when: >
       ca_crt.stat.exists == false or
       ca_crt.stat.isfile == false
     vars:
       ca_crt:
         path: /etc/openvpn/easy-rsa/pki/ca.crt

   - name: Generate Diffie-Hellman parameters
     shell: easyrsa gen-dh
     args:
       chdir: /etc/openvpn/easy-rsa
     when: >
       dh_pem.stat.exists == false or
       dh_pem.stat.isfile == false
     vars:
       dh_pem:
         path: /etc/openvpn/easy-rsa/pki/dh.pem

   - name: Build the server certificate
     shell: EASYRSA_BATCH=yes easyrsa build-server-full server nopass
     args:
       chdir: /etc/openvpn/easy-rsa
     when: >
       server_crt.stat.exists == false or
       server_crt.stat.isfile == false
     vars:
       server_crt:
         path: /etc/openvpn/easy-rsa/pki/issued/server.crt

   - name: Build the client certificate
     shell: EASYRSA_BATCH=yes easyrsa build-client-full client nopass
     args:
       chdir: /etc/openvpn/easy-rsa
     when: >
       client_crt.stat.exists == false or
       client_crt.stat.isfile == false
     vars:
       client_crt:
         path: /etc/openvpn/easy-rsa/pki/issued/client.crt

   - name: Generate the Certificate Revocation List (CRL)
     shell: easyrsa gen-crl
     args:
       chdir: /etc/openvpn/easy-rsa
     when: >
       crl_pem.stat.exists == false or
       crl_pem.stat.isfile == false
     vars:
       crl_pem:
         path: /etc/openvpn/easy-rsa/pki/crl.pem

   - name: Generate TLS authentication key
     shell: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
     when: >
       ta_key.stat.exists == false or
       ta_key.stat.isfile == false
     vars:
       ta_key:
         path: /etc/openvpn/easy-rsa/pki/ta.key

   - name: Copy PKI files to the server configuration directory
     copy:
       src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
       dest: "/etc/openvpn/server/{{ item }}"
       mode: '0640'
     loop:
       - ca.crt
       - dh.pem
       - ta.key
       - client.crt
       - server.crt
       - ca.key
       - client.key
       - server.key

   - name: Copy ca.crt and ta.key to /etc/openvpn
     copy:
       src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
       dest: "/etc/openvpn/{{ item }}"
       mode: '0640'
     loop:
       - ca.crt
       - ta.key

   - name: Place the server configuration file
     template:
       src: server.conf.j2
       dest: "{{ openvpn_configuration_directory }}/server.conf"
       owner: "{{ openvpn_user }}"
       group: "{{ openvpn_group }}"
       mode: '0640'
     notify: Restart openvpn

   - name: Ensure openvpn is enabled and started
     service:
       name: openvpn
       enabled: true
       state: started

