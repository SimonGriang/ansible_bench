---
   - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install using package
     block:
       - name: Install repository for RedHat
         get_url:
           url: "{{ hashicorp_repository_file }}"
           dest: /etc/yum.repos.d/hashicorp.repo
           mode: '0640'
         when: ansible_os_family == "RedHat"

       - name: Configure debian
         block:
           - name: Install required package gpg
             apt:
               name: gpg
               state: present

           - name: Install apt key for Debian
             apt_key:
               url: "{{ hashicorp_gpg_key_url }}"
               validate_certs: no

           - name: Install repository for Debian
             apt_repository:
               repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] {{ hashicorp_repository_url }} {{ ansible_lsb.codename }} main"
               state: present
               filename: hashicorp
         when: ansible_os_family == "Debian"

       - name: Install hashicorp product using package
         block:
           - name: Install latest hashicorp product using package
             apt:
               name: "{{ item }}"
             loop: "{{ hashicorp_products }}"
             loop_control:
               label: "{{ item }}"
             when: hashicorp_products is defined and (item.split(version_coupler)[-1] | regex_search('^[0-9]+\.[0-9]+\.[0-9]+$')) is none

           - name: Install versioned hashicorp product using package
             apt:
               name: "{{ item }}{{ version_coupler }}{{ item.split(version_coupler)[-1] }}"
             loop: "{{ hashicorp_products }}"
             loop_control:
               label: "{{ item }}"
             when: hashicorp_products is defined and (item.split(version_coupler)[-1] | regex_search('^[0-9]+\.[0-9]+\.[0-9]+$')) is not none
         when: hashicorp_products is defined
     when: hashicorp_installation_method == "package"

   - name: Install manually
     block:
       - name: Install hashicorp product manually
         unarchive:
           src: "{{ hashicorp_src }}/{{ item }}_{{ hashicorp_version }}_{{ ansible_system | lower }}_{{ hashicorp_architecture_mapping[ansible_architecture] }}.zip"
           dest: "{{ hashicorp_destination_directory }}"
           group: "{{ hashicorp_group }}"
           mode: "{{ hashicorp_mode }}"
           owner: "{{ hashicorp_owner }}"
         loop: "{{ hashicorp_products }}"
         loop_control:
           label: "{{ item }}"
     when: hashicorp_installation_method == "manual"2025-10-07 14:39:52,827 [INFO] __main__: Cleaned LLM output: ---
