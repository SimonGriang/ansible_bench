 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Wait for port to be available
     wait_for:
       port: "{{ bootstrap_port | default(22) }}"
       timeout: "{{ bootstrap_timeout }}"
     when:
       - ansible_connection is defined
       - ansible_connection != 'container'
       - bootstrap_wait_for_host | default(true) | bool

   - name: Prepare system
     block:
       - name: Test connection
         ping:

       - name: Test sudo access
         command: whoami
         become: true
     rescue:
       - name: Gather facts
         setup:

       - name: Install bootstrap packages (raw)
         raw: |
           if [ -x "$(command -v dnf)" ]; then
             dnf install -y python3
           elif [ -x "$(command -v apt-get)" ]; then
             apt-get update && apt-get install -y python
           fi

       - name: Ensure libdnf5 is present on RedHat-based systems
         package:
           name: libdnf5
         when: ansible_os_family == 'RedHat'

   - name: Gather ansible facts
     setup:

   - name: Install bootstrap packages (package)
     package:
       name: "{{ bootstrap_facts_packages }}"
       update_cache: yes
     become: "{{ bootstrap_become }}"

