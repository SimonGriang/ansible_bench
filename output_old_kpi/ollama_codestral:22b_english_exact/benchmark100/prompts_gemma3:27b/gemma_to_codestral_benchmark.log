 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Configure apk
     block:
       - name: Update apk cache
         apk:
           update_cache: true
       - name: Upgrade all software
         apk:
           upgrade: true
         notify: Reboot
     when: ansible_pkg_mgr == 'apk'

   - name: Configure apt
     block:
       - name: Exclude packages from upgrade
         dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop: "{{ update_excluded_packages }}"
       - name: Update apt cache
         apt:
           update_cache: true
       - name: Upgrade all software
         apt:
           upgrade: dist
         notify: Reboot
       - name: Autoremove unused packages
         apt:
           autoremove: true
         when: apt_autoremove_enabled | bool
     when: ansible_pkg_mgr == 'apt'

   - name: Update all software (dnf)
     block:
       - name: Update all software
         dnf:
           name: '*'
           exclude: "{{ update_excluded_packages | join(',') }}"
         notify: Reboot
     when: ansible_pkg_mgr in ['dnf', 'dnf5']

   - name: Update all software (pacman)
     block:
       - name: Update all software
         pacman:
           update_cache: true
           upgrade: true
         notify: Reboot
     when: ansible_pkg_mgr == 'pacman'

   - name: Configure yum
     block:
       - name: Update all software (yum 6)
         block:
           - name: Update all software
             yum:
               name: '*'
               exclude: "{{ update_excluded_packages | join(',') }}"
             notify: Reboot
         when: ansible_distribution_major_version == '6'
       - name: Update all software (other yum versions)
         block:
           - name: Update all software
             yum:
               name: '*'
               exclude: "{{ update_excluded_packages | join(',') }}"
             notify: Reboot
         when: ansible_distribution_major_version != '6'
     when: ansible_pkg_mgr == 'yum'

   - name: Update all software (zypper)
     block:
       - name: Update all software
         zypper:
           name: '*'
           update_cache: true
         notify: Reboot
     when: ansible_pkg_mgr == 'zypper'

