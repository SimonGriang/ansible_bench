```yaml
---
- name: gather_facts | Lookup bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_search in bootstrap_facts.stdout
  vars:
    bootstrap_search: >-
      {{ '.*(' ~ item ~ ').*' | regex_escape() }}
  loop: "{{ bootstrap_os_family_map.keys() | list }}"
  set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: >-
      {{ bootstrap_facts.stdout | regex_search('PRETTY_NAME="' ~ bootstrap_search ~ '\s*(\d+)\.') | last }}

- name: gather_facts | Set bootstrap facts (II)
  vars:
    bootstrap_os_family_value: >-
      {{ bootstrap_os_family_map[item.key] }}
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  when: bootstrap_distribution in bootstrap_os_family_value
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
```
