content=' ---\n   - name: Create ssh_key_directory for user\n     local_action: file path="{{ ssh_key_directory }}" state=directory mode=0700\n     when: user.manage_ssh_key | default(false)\n\n   - name: Manage user account\n     user: name="{{ user.name }}" state="{{ user.state }}" comment="{{ user.comment }}" createhome="{{ user.create_home }}" password="{{ user.password | password_hash(\'sha512\') }}" uid="{{ user.uid }}" group="{{ user.group }}" shell="{{ user.shell }}" expires="{{ user.expires }}"\n     register: user_account\n\n   - name: Set sudo options for user\n     template: src=sudoers.j2 dest="/etc/sudoers.d/{{ user.name }}" validate=\'visudo -cf %s\'\n     loop: "{{ users }}"\n     loop_control:\n       label: "{{ user.name }}"\n     when: user.sudo_options is defined\n\n   - name: Remove sudo options for user\n     file: path="/etc/sudoers.d/{{ user.name }}" state=absent\n     loop: "{{ users }}"\n     loop_control:\n       label: "{{ user.name }}"\n     when: user.sudo_options is not defined\n\n   - name: Generate private ssh key for user\n     local_action: command ssh-keygen -t rsa -b 4096 -f "{{ ssh_key_directory }}/{{ user.name }}" -q -N ""\n     when: user.manage_ssh_key | default(false)\n\n   - name: Generate public ssh key for user\n     local_action: shell ssh-keygen -y -f "{{ ssh_key_directory }}/{{ user.name }}" > "{{ ssh_key_directory }}/{{ user.name }}.pub"\n     when: user.manage_ssh_key | default(false)\n\n   - name: Convert ssh key to ppk for user\n     local_action: command puttygen "{{ ssh_key_directory }}/{{ user.name }}" -o "{{ ssh_key_directory }}/{{ user.name }}.ppk" -O private\n     when: user.manage_ssh_key | default(false)\n\n   - name: Get or set the home directory for user\n     set_fact:\n       base_directory: "{{ user_account.home | default(\'/home\') }}"\n\n   - name: Create .ssh directory for user\n     file: path="{{ base_directory }}/.ssh" state=directory mode=0700 owner="{{ user.name }}"\n     when: user.manage_ssh_key | default(false) or user.private_keys is defined\n\n   - name: Deploy authorized keys for user\n     authorized_key: user="{{ user.name }}" key="{{ item }}" state=present\n     loop: "{{ user.authorized_keys }}"\n\n   - name: Remove unauthorized keys for user\n     authorized_key: user="{{ user.name }}" key="{{ item }}" state=absent\n     loop: "{{ user.unauthorized_keys }}"\n\n   - name: Copy generated private ssh key for user\n     copy: src="{{ ssh_key_directory }}/{{ user.name }}" dest="{{ base_directory }}/.ssh/id_rsa" mode=0600 owner="{{ user.name }}"\n     when: user.copy_private_key | default(false)\n\n   - name: Check users password valid time\n     shell: "chage -l {{ user.name }} | grep \'Password expires\' | awk \'{print $3, $4, $5}\'"\n     register: password_expiry\n\n   - name: Set users password valid time\n     command: chage -I {{ user.password_inactive_days }} -m {{ user.password_min_days }} -M {{ user.password_max_days }} -W {{ user.password_warning_days }} {{ user.name }}\n\n   - name: Place private key file for user\n     copy: content="{{ user.private_keys }}" dest="{{ base_directory }}/.ssh/id_rsa" mode=0600 owner="{{ user.name }}"\n     when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-07T11:36:47.822263623Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25538745440, 'load_duration': 19243366, 'prompt_eval_count': 1116, 'prompt_eval_duration': 1073452734, 'eval_count': 1034, 'eval_duration': 24443889697, 'model_name': 'codestral:22b'} id='run--acfe7a73-40fe-4f49-8329-9a21fa556649-0' usage_metadata={'input_tokens': 1116, 'output_tokens': 1034, 'total_tokens': 2150}2025-10-07 13:36:47,824 [INFO] __main__: Raw LLM output: content=' ---\n   - name: Create ssh_key_directory for user\n     local_action: file path="{{ ssh_key_directory }}" state=directory mode=0700\n     when: user.manage_ssh_key | default(false)\n\n   - name: Manage user account\n     user: na