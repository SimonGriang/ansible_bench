 - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_install_url }}"
       dest: "{{ rke2_tmp_install_script_path }}"
       mode: '0755'
     when:
       - not rke2_airgap_mode

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_install_script_path }}"
       dest: "{{ rke2_tmp_install_script_path }}"
       mode: '0755'
     when:
       - rke2_airgap_mode
       - rke2_airgap_implementation == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_airgap_image_path }}"
       state: directory
     when:
       - rke2_airgap_mode
       - rke2_airgap_implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Attempt to download RKE2 artifacts and checksums remotely
         get_url:
           url: "{{ item.url }}"
           dest: "{{ rke2_airgap_image_path }}/"
           checksum: "sha256:{{ item.sha256 }}"
         loop: "{{ rke2_airgap_images }}"
         register: remote_download_result
         ignore_errors: true

       - name: Download locally and copy to remote hosts if remote download failed
         block:
           - name: Download locally
             get_url:
               url: "{{ item.url }}"
               dest: "/tmp/"
               checksum: "sha256:{{ item.sha256 }}"
             loop: "{{ rke2_airgap_images }}"

           - name: Copy to remote hosts
             copy:
               src: "/tmp/{{ item.url | basename }}"
               dest: "{{ rke2_airgap_image_path }}/"
             loop: "{{ rke2_airgap_images }}"
         when: remote_download_result.results | selectattr('failed') | list | length > 0
     when:
       - rke2_airgap_mode

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_local_image_path }}/{{ item.url | basename }}"
       dest: "{{ rke2_airgap_image_path }}/"
     loop: "{{ rke2_airgap_images }}"
     when:
       - rke2_airgap_mode
       - rke2_airgap_implementation == 'copy'

   - name: Airgap mode - additional images tarballs
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_airgap_image_path }}/"
     loop: "{{ rke2_airgap_additional_images }}"
     when:
       - rke2_airgap_mode
       - rke2_airgap_additional_images is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_airgap_image_path }}/{{ item.url | basename }}"
       mode: '0644'
     loop: "{{ rke2_airgap_images }}"
     when:
       - rke2_airgap_mode

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: rke2_usr_local_stat

   - name: Check if separate partition
     set_fact:
       rke2_separate_partition: "{{ rke2_usr_local_stat.stat.dev != ansible_mounts |
         selectattr('mount', 'equalto', '/') |
         map(attribute='dev') |
         first }}"

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if rke2_separate_partition else
         '/opt/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version"
     register: rke2_version_check
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       rke2_installed_version: "{{ rke2_version_check.stdout_lines[0].split(' ')[2]
         if rke2_version_check.stdout_lines | length > 0 else '' }}"
       rke2_running_version: "{{ ansible_facts.services['rke2-server.service'].state
         == 'running' | ternary(rke2_installed_version, '') }}"

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - rke2_allow_downgrade or
           (rke2_installed_version == '' or
           rke2_running_version == '' or
           rke2_installed_version is version(rke2_running_version, '>=') or
           rke2_installed_version is version(rke2_version, '>='))
       fail_msg: "Downgrading RKE2 is not allowed. To force the installation, set
         rke2_allow_downgrade to true."

   - name: Run RKE2 install script
     shell: "{{ rke2_tmp_install_script_path }} INSTALL_RKE2_TYPE={{ rke2_type }}
       INSTALL_RKE2_VERSION={{ rke2_version }}"

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/"
     loop: "{{ rke2_custom_manifests }}"
     when:
       - rke2_custom_manifests is defined

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_agent_data_path }}/manifests/rke2/"
     loop: "{{ rke2_static_pods }}"
     when:
       - rke2_static_pods is defined

   - name: Copy RKE2 environment file
     template:
       src: rke2-environment.j2
       dest: /etc/default/rke2
       mode: '0644'2025-10-07 13:59:30,933 [INFO] __main__: Total generation time for /home/studgoetsi5301/documents/ansible_bench/output/ollama_codestral:22b_english_exact/benchmark100/prompts_gemma3:27b/molecule_test/ansible-role-rke2/tasks/rke2.yml: 91.15460038895253 seconds
