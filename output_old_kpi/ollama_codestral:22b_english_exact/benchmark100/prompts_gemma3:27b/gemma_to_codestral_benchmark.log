2025-10-07 13:53:28,541 [INFO] __main__: Raw output is an AIMessage. Extracted content:  - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Pre-configure debian systems
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: 'No configuration'
       vtype: select

   - name: Install postfix
     apt:
       name: postfix
       state: present

   - name: Install postfix-mysql
     apt:
       name: postfix-mysql
       state: present
     when: >
       (virtual_mailbox_maps is defined and 'mysql' in virtual_mailbox_maps)
       or (virtual_mailbox_domains is defined and 'mysql' in virtual_mailbox_domains)

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - Validate postfix
       - Rebuild database
     when: transport_maps_template is defined

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - Validate postfix
       - Reload postfix
     when: header_checks_template is defined

   - name: Setting values for main.cf (1/2)
     set_fact:
       postfix_main_cf_settings: >
         {{ postfix_main_cf_settings|default({})
         |combine({item.key: item.value}) }}
     loop: "{{ postfix_main_cf_settings_list|default([]) }}"
     when: item.key is defined and item.value is defined

   - name: Setting values for main.cf (2/2)
     set_fact:
       postfix_main_cf_settings: >
         {{ postfix_main_cf_settings|default({})
         |combine({item.key: item.value}) }}
     loop:
       - { key: 'mydestination', value: '{{ [ansible_fqdn] + [ansible_hostname] + mydestination_extra }}' }
       - { key: 'mynetworks', value: '{{ ["127.0.0.0/8"] + mynetworks_extra }}' }

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix
       - Restart postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix
       - Restart postfix

   - name: Creates cert/key directory
     file:
       path: "/etc/postfix/certs"
       state: directory
     when: tls_server_cert_src is defined and tls_server_key_src is defined

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ tls_server_cert_src }}"
       dest: /etc/postfix/certs/postfix.crt
     when: tls_server_cert_src is defined

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ tls_server_key_src }}"
       dest: /etc/postfix/certs/postfix.key
     when: tls_server_key_src is defined

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     template:
       src: aliases.j2
       dest: /etc/aliases
     when: postfix_aliases is defined

   - name: Configure sender_access
     template:
       src: sender_access.j2
       dest: /etc/postfix/sender_access
     when: postfix_sender_access is defined

   - name: Configure recipient_access
     template:
       src: recipient_access.j2
       dest: /etc/postfix/recipient_access
     when: postfix_recipient_access is defined

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_sasl_password_map }}"
       dest: /etc/postfix/sasl_password_map
     when: postfix_sasl_password_map is defined

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     systemd:
       name: postfix
       state: started
       enabled: yes
