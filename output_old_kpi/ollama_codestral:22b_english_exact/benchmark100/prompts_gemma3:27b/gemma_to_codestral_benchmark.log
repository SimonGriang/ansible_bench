 - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       mode: '0755'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Copy rke2 config
     template:
       src: rke2.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed
     when: rke2_kubelet_config | length > 0

   - name: Copy Containerd Registry Configuration file
     template:
       src: registry-config.toml.j2
       dest: /etc/rancher/rke2/registry-config.toml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed
     when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when:
       - rke2_etcd_snapshot_file is defined
       - (rke2_services.rke2_server.service is not defined or not rke2_services.rke2_server.service.enabled)

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when:
       - rke2_etcd_snapshot_file is defined
       - rke2_etcd_snapshot_s3_options is defined
       - rke2_etcd_snapshot_s3_options.access_key is defined
       - rke2_etcd_snapshot_s3_options.secret_key is defined
       - rke2_etcd_snapshot_s3_options.bucket is defined

   - name: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
           mode: '0755'
       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/etcd-snapshot-latest
       - command: >-
           rke2 server
           --config /etc/rancher/rke2/config.yaml
           --etcd-snapshot-restore-extra-args=--snapstore-temp-directory=/var/lib/rancher/rke2/server/db/snapshots

   - name: Restore etcd from s3
     command: >-
       rke2 server
       --config /etc/rancher/rke2/config.yaml
       --etcd-s3
       --etcd-s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint | default('') }}
       --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}
       --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
       --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
       --etcd-s3-ca-file {{ rke2_etcd_snapshot_s3_options.ca_file | default('') }}
       --etcd-s3-cert-file {{ rke2_etcd_snapshot_s3_options.cert_file | default('') }}
       --etcd-s3-key-file {{ rke2_etcd_snapshot_s3_options.key_file | default('') }}
       --etcd-s3-insecure-skip-tls-verify {{ rke2_etcd_snapshot_s3_options.insecure_skip_tls_verify | default(false) }}

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       state: stopped
       enabled: no
       masked: yes

   - name: Wait for the first server be ready - no CNI
     command: kubectl get nodes -o json
     register: result
     until: "'NotReady' not in result.stdout"
     retries: 30
     delay: 10
     changed_when: false

   - name: Wait for the first server be ready - with CNI
     command: kubectl get nodes -o json
     register: result
     until: "'Ready' in (result.stdout | from_json).items[0].status.conditions[-1].type"
     retries: 30
     delay: 10
     changed_when: false

   - name: Restore etcd
     block:
       - command: kubectl get nodes -o json
         register: nodes_data
       - set_fact:
           nodes: "{{ (nodes_data.stdout | from_json).items | map(attribute='metadata.name') | list }}"
       - command: kubectl get secrets -n kube-system -o json
         register: secrets_data
       - set_fact:
           secrets: "{{ (secrets_data.stdout | from_json).items | selectattr('metadata.annotations', 'defined') | selectattr('metadata.annotations.' ~ 'k8s.cattle.io/etcd-snapshot-restore', 'defined') | map(attribute='metadata.name') | list }}"
       - command: kubectl delete secrets -n kube-system {{ secrets | join(' ') }}
       - command: kubectl delete nodes {{ nodes | join(' ') }}

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
