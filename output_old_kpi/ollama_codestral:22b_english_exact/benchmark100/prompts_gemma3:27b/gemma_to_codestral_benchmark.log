       src: sudoers.j2
       dest: "/etc/sudoers.d/{{ user.name }}"
       validate: 'visudo -cf %s'
     loop: "{{ users }}"
     loop_control:
       label: "{{ user.name }}"
     when: user.sudo_options is defined

   - name: Remove sudo options for user
     file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     loop: "{{ users }}"
     loop_control:
       label: "{{ user.name }}"
     when: user.sudo_options is not defined

   - name: Generate private ssh key for user
     local_action: command
       ssh-keygen -t rsa -b 4096 -f "{{ ssh_key_directory }}/{{ user.name }}" -q -N ""
     when: user.manage_ssh_key | default(false)

   - name: Generate public ssh key for user
     local_action: shell
       cmd: ssh-keygen -y -f "{{ ssh_key_directory }}/{{ user.name }}" > "{{ ssh_key_directory }}/{{ user.name }}.pub"
     when: user.manage_ssh_key | default(false)

   - name: Convert ssh key to ppk for user
     local_action: command
       cmd: puttygen "{{ ssh_key_directory }}/{{ user.name }}" -o "{{ ssh_key_directory }}/{{ user.name }}.ppk" -O private
     when: user.manage_ssh_key | default(false)

   - name: Get or set the home directory for user
     set_fact:
       base_directory: "{{ user_account.home | default('/home') }}"

   - name: Create .ssh directory for user
     file:
       path: "{{ base_directory }}/.ssh"
       state: directory
       mode: '0700'
       owner: "{{ user.name }}"
     when: user.manage_ssh_key | default(false) or user.private_keys is defined

   - name: Deploy authorized keys for user
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: present
     loop: "{{ user.authorized_keys }}"

   - name: Remove unauthorized keys for user
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: absent
     loop: "{{ user.unauthorized_keys }}"

   - name: Copy generated private ssh key for user
     copy:
       src: "{{ ssh_key_directory }}/{{ user.name }}"
       dest: "{{ base_directory }}/.ssh/id_rsa"
       mode: '0600'
       owner: "{{ user.name }}"
     when: user.copy_private_key | default(false)

   - name: Check users password valid time
     shell: >
       chage -l {{ user.name }} | grep 'Password expires' | awk '{print $3, $4, $5}'
     register: password_expiry

   - name: Set users password valid time
     command: >
       cmd: chage -I {{ user.password_inactive_days }} -m {{ user.password_min_days }}
       -M {{ user.password_max_days }} -W {{ user.password_warning_days }} {{ user.name }}

   - name: Place private key file for user
     copy:
       content: "{{ user.private_keys }}"
       dest: "{{ base_directory }}/.ssh/id_rsa"
       mode: '0600'
       owner: "{{ user.name }}"
     when: user.private_keys is defined


