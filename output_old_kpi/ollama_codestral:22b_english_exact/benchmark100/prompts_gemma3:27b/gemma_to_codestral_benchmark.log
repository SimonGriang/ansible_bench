       path: "/etc/mysql/{{ mysql_name }}-server.cnf"
       regexp: "^{{ item.name }}"
       line: "{{ item.name }} = {{ item.value }}"
     loop: "{{ mysql_configuration_options }}"

   - name: Configure mysql client
     lineinfile:
       path: "/etc/mysql/{{ mysql_name }}-client.cnf"
       regexp: "^socket"
       line: "socket = {{ mysql_socket }}"

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable mysql
     service:
       name: "{{ mysql_service }}"
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: '0640'

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       target: "{{ item.target | default(omit) }}"
       encoding: "{{ item.encoding | default(omit) }}"
       collation: "{{ item.collation | default(omit) }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     loop: "{{ mysql_databases }}"

   - name: List databases
     mysql_info:
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
       filter: databases
     register: databases

   - name: Debug databases
     debug:
       var: databases.databases

   - name: Import database
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.import_target }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     loop: "{{ mysql_databases }}"
     when:
       - item.import_target is defined
       - item.name not in databases.databases

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv | default(omit) }}"
       host: "{{ item.host | default('localhost') }}"
       state: present
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     loop: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers
