 - name: Check if all variables have been set correctly
     include_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Wait for host to be reachable
     wait_for:
       port: "{{ ansible_port | default(22) }}"
       host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
       search_regex: OpenSSH
       timeout: "{{ bootstrap_timeout }}"
     when:
       - bootstrap_wait_for_host | bool
       - ansible_connection != "container"
     connection: local
     become: "{{ bootstrap_become }}"

   - name: Prepare the system
     block:
       - name: Test connection
         wait_for_connection:
           timeout: "{{ bootstrap_timeout }}"
         register: bootstrap_connect
         ignore_errors: true

       - name: Debug bootstrap_timeout
         debug:
           msg: "Connection failed: {{ bootstrap_timeout }}"
         when: bootstrap_connect is failed

       - name: Gather bootstrap facts
         setup:

   - name: Install bootstrap packages
     raw: "{{ bootstrap_install_packages_cmd }}"
     register: bootstrap_install_packages
     changed_when: >-
       (ansible_os_family == 'Alpine' and 'expected stdout regex' in bootstrap_install_packages.stdout) or
       (ansible_os_family == 'Archlinux' and 'expected stdout regex' in bootstrap_install_packages.stdout) or
       (ansible_os_family == 'Gentoo' and 'expected stdout regex' in bootstrap_install_packages.stdout) or
       (ansible_os_family == 'Debian' and 'expected stdout regex' not in bootstrap_install_packages.stdout) or
       (ansible_os_family == 'RedHat' and 'expected stdout regex' not in bootstrap_install_packages.stdout) or
       (ansible_os_family == 'Rocky' and 'expected stdout regex' not in bootstrap_install_packages.stdout) or
       (ansible_os_family == 'Suse' and 'expected stdout regex' not in bootstrap_install_packages.stdout)
     connection: "{{ bootstrap_user }}"
     become: "{{ bootstrap_become }}"

   - name: Ensure system is prepared by issuing ansible modules
     block:
       - name: Gather ansible facts
         setup:

       - name: Install packages
         package:
           name: "{{ bootstrap__facts_packages }}"
           state: present
           update_cache: true
         register: bootstrap_install_facts_packages

