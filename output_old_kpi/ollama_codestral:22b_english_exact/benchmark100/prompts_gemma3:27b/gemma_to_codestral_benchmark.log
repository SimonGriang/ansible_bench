 - name: Restart RKE2 service
     service:
       name: "{{ rke2_service_name }}"
       state: restarted
     notify: Service (re)started

   - name: Wait for all nodes to be ready
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     run_once: true
     shell: >
       {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get
       nodes --field-selector status.phase=Ready --no-headers | wc -l
     register: rke2_ready_nodes
     retries: 100
     delay: 15
     until: rke2_ready_nodes.stdout | int == groups[rke2_cluster_group_name] | length

   - name: Wait for all pods to be ready
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     run_once: true
     shell: >
       {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get
       pods --all-namespaces --field-selector status.phase!=Running,status.phase!=Succeeded
       --no-headers | wc -l
     register: rke2_pending_pods
     retries: 100
     delay: 15
     until: rke2_pending_pods.stdout | int == 0
     when: rke2_wait_for_all_pods_to_be_ready and not ansible_check_mode

