 - name: Import assert tasks file
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Uninstall conflicting systemd-logger package
     package:
       name: systemd-logger
       state: absent

   - name: Install rsyslog packages
     package:
       name: "{{ rsyslog_packages }}"
       state: "{{ rsyslog_package_state }}"

   - name: Install additional rsyslog features
     package:
       name: "{{ item }}"
       state: "{{ rsyslog_package_state }}"
     loop: "{{ rsyslog_features }}"

   - name: Configure default rsyslog configuration
     template:
       src: "{{ rsyslog_config_file_format }}"
       dest: "{{ rsyslog_dest_conf_file }}"
       mode: '0644'
     notify: Restart rsyslog
     when: rsyslog_deploy_default_config | bool

   - name: Create the rsyslog.d directory
     file:
       path: /etc/rsyslog.d/
       state: directory
       mode: '0755'

   - name: Configure rsyslog forward rule
     template:
       src: forward_rule.conf.j2
       dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf"
       mode: '0644'
     notify: Restart rsyslog
     when: rsyslog_deploy_default_config | bool

   - name: Configure additional rsyslog config files
     copy:
       content: "{{ item.value.content }}"
       dest: "/etc/rsyslog.d/{{ item.key }}"
       owner: "{{ item.value.owner | default('root') }}"
       group: "{{ item.value.group | default('root') }}"
       mode: "{{ item.value.mode | default('0644') }}"
     loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
     when: item.value.state | default(true)
     notify: Restart rsyslog

   - name: Start and enable rsyslog service
     systemd:
       name: "{{ rsyslog_service }}"
       state: started
       enabled: yes

