 - name: Create Vault group
     group:
       name: "{{ vault_group }}"
       system: yes

   - name: Create Vault user
     user:
       name: vault
       group: "{{ vault_group }}"
       shell: "{{ vault_user_shell }}"
       create_home: no

   - name: Create Vault download directory
     file:
       path: "{{ vault_download_path }}"
       state: directory
       owner: vault
       group: "{{ vault_group }}"
       mode: '0755'

   - name: Download Vault binary
     get_url:
       url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_{{ vault_architecture }}.zip"
       dest: "{{ vault_download_path }}/vault.zip"
     register: vault_download

   - name: Extract Vault binary
     unarchive:
       src: "{{ vault_download.dest }}"
       dest: "{{ vault_download_path }}"
       remote_src: yes

   - name: Check if vault_path exists
     stat:
       path: "{{ vault_path }}"
     register: vault_check_path

   - name: Create vault_path if it does not exist
     file:
       path: "{{ vault_path }}"
       state: directory
       owner: vault
       group: "{{ vault_group }}"
       mode: '0755'
     when:
       - not vault_check_path.stat.exists
       - vault_path != ""

   - name: Create directory in vault_path
     file:
       path: "{{ vault_path }}/{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
     loop: "{{ vault_directories }}"

   - name: Create data directory
     file:
       path: "{{ vault_path }}/{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
     loop: "{{ vault_data_directories }}"

   - name: Generate TLS key and certificate
     shell: >
       openssl req
       -newkey rsa:2048
       -nodes
       -x509
       -days 365
       -out tls.cert
       -keyout tls.key
       -subj '/CN=localhost'
       -addext 'subjectAltName=DNS:localhost,DNS:localhost.localdomain'
     args:
       chdir: "{{ vault_path }}/tls/"
     notify: Restart vault

   - name: Set ownership of tls material
     file:
       path: "{{ vault_path }}/tls/{{ item }}"
       owner: vault
       group: "{{ vault_group }}"
       mode: '0600'
     loop: "{{ vault_tls_files }}"

   - name: Copy Vault binary
     copy:
       src: "{{ vault_download_path }}/vault"
       dest: /usr/bin/vault
       owner: root
       group: root
       mode: '0755'
     notify: Restart vault

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: /usr/bin/vault
       capability: cap_ipc_lock=ep
       state: present

   - name: Touch vault.env
     file:
       path: "{{ vault_path }}/etc/vault.d/vault.env"
       state: touch
       owner: vault
       group: "{{ vault_group }}"
       mode: '0644'
       access_time: preserve
       modification_time: preserve
     notify: Restart vault

   - name: Create /usr/lib/systemd/system
     file:
       path: /usr/lib/systemd/system
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Copy Vault service file
     copy:
       src: vault.service.j2
       dest: /usr/lib/systemd/system/vault.service
       owner: root
       group: root
       mode: '0644'
     notify: Daemon reload
     when: ansible_service_mgr == "systemd"

   - name: Copy vault configuration
     copy:
       src: vault.hcl
       dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
       owner: root
       group: root
       mode: '0644'
     notify: Restart vault

   - name: Flush handlers
     meta: flush_handlers

