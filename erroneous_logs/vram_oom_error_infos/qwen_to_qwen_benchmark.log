---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    home: /nonexistent
    system: true
    groups: "{{ vault_group }}"

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}/vault.zip"
    force_basic_auth: true
    mode: 0644
    remote_src: true
  register: vault_download
  notify: restart vault
  become: true
  become_user: root
  when: vault_download_path is defined and vault_download_path | length > 0

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  when: vault_check_path.stat.exists == false and vault_path is defined and vault_path | length > 0

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"
  when: vault_directories is defined and vault_directories | length > 0

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"
  when: vault_data_directories is defined and vault_data_directories | length > 0

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_data_directories[0].name }}/tls/cert.pem"
    privatekey_path: "{{ vault_data_directories[0].name }}/tls/key.pem"
    csr_path: "{{ vault_data_directories[0].name }}/tls/csr.pem"
    provider: selfsigned
    privatekey_pass: "{{ vault_tls_private_key_passphrase }}"
    privatekey_size: 2048
    privatekey_type: RSA
    type: rsa
    days: 365
    country_name: "{{ vault_tls_country_name }}"
    state_or_province_name: "{{ vault_tls_state_or_province_name }}"
    locality_name: "{{ vault_tls_locality_name }}"
    organization_name: "{{ vault_tls_organization_name }}"
    organizational_unit_name: "{{ vault_tls_organizational_unit_name }}"
    common_name: "{{ vault_tls_common_name }}"
    subject_alt_name: "{{ vault_tls_subject_alt_name }}"
  notify: restart vault
  when: vault_tls_files is defined and vault_tls_files | length > 0

- name: Set ownership of tls material
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"
  when: vault_tls_files is defined and vault_tls_files | length > 0

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: 0755
  notify: restart vault
  when: vault_path is defined and vault_path | length > 0

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock+ep "{{ vault_path }}/usr/bin/vault"
  changed_when: false
  when: vault_path is defined and vault_path | length > 0

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
  notify: restart vault
  when: vault_path is defined and vault_path | length > 0

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644
  notify: reload daemon
  when: >
    ansible_facts['distribution'] == 'CentOS' and
    ansible_facts['distribution_major_version'] >= 7

- name: Copy vault configuration
  template:
    src: vault.hcl.j2
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: 0644
  notify: restart vault
  when: vault_path is defined and vault_path | length > 0

- name: Flush handlers
  meta: flush_handlers


