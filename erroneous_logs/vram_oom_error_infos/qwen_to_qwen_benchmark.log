---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  with_items:
    - /opt/cadvisor
    - /etc/cadvisor

- name: cadvisor | download
  get_url:
    url: "{{ cadvisor_binary_url }}"
    dest: "/opt/cadvisor/cadvisor"
    checksum: "{{ cadvisor_binary_checksum }}"
  notify: restart cadvisor

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_path }}/cadvisor"
    dest: "/opt/cadvisor/cadvisor"
    owner: root
    group: root
    mode: '0755'
  when: cadvisor_local_path is defined
  notify: restart cadvisor

- name: cadvisor | symlink
  file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    state: link
  notify: restart cadvisor

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  notify: restart cadvisor

- name: test_task
  shell: systemctl is-active cadvisor
  register: service_active
  ignore_errors: true

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started
    daemon_reload: yes



