---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install docker-compose package
  package:
    name: docker-compose
    state: present
  when: docker_compose_installation_type == "package"

- name: Install docker-compose as a binary
  block:
    - name: Install required packages
      package:
        name: curl
        state: present

    - name: Download docker-compose binary
      get_url:
        url: "{{ docker_compose_binary_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
  when: docker_compose_installation_type == "binary"


