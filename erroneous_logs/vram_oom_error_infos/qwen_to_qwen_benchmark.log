    home: /nonexistent

- name: Generate rndc key
  command: rndc-confgen -a -k rndc.key -c /etc/named/rndc.key
  args:
    chdir: /etc/named

- name: Set permissions on rndc key file
  file:
    path: /etc/named/rndc.key
    owner: named
    group: named
    mode: 0640

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: /var/named/named.root
    mode: 0644
  when: dns_caching_dns
  notify: Reload Rndc

- name: Create zone file
  template:
    src: zone.j2
    dest: /var/named/{{ item.name }}.zone
    owner: named
    group: named
    mode: 0644
  with_items: "{{ dns_zones }}"
  when: "item.type is undefined or item.type == 'primary'"
  notify: Reload Rndc

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf
    owner: named
    group: named
    mode: 0644
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Check if systemd is used
      stat:
        path: /etc/systemd/system/named.service.d
      register: systemd_check

    - name: Ensure directory exists
      file:
        path: /etc/systemd/system/named.service.d
        state: directory
        mode: 0755
      when: not systemd_check.stat.exists

    - name: Create override file
      copy:
        content: |
          [Service]
          Restart=always
        dest: /etc/systemd/system/named.service.d/override.conf
        owner: root
        group: root
        mode: 0644
      when: systemd_check.stat.exists

    - name: Reload systemd daemon
      systemd:
        daemon_reload: yes
      when: systemd_check.stat.exists
  when: ansible_service_mgr == 'systemd'

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes


