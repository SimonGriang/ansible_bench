---
- name: hardening | Disable swap
  when: vault_hardening_disable_swap
  block:
    - name: hardening | Disable swap now
      ansible.builtin.command: swapoff -a
      when: ansible_swaptotal_mb > 0

    - name: hardening | Disable swap permanently
      ansible.builtin.lineinfile:
        path: /etc/fstab
        state: absent
        regexp: '^.*swap'
      when: ansible_swaptotal_mb > 0

- name: hardening | Disable core dumps
  setrlimit:
    type: 'core'
    items:
      - hard
      - soft
    value: 0
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  ansible.builtin.template:
    src: disable_shell_command_history.sh.j2
    dest: /etc/profile.d/disable_shell_command_history.sh
    owner: root
    group: root
    mode: '0755'
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor
  block:
    - name: hardening | Enable SELinux
      when: ansible_selinux.status != 'permissive'
      block:
        - name: hardening | Install selinux-policy
          ansible.builtin.package:
            name: selinux-policy
            state: present

        - name: hardening | Set SELinux policy
          ansible.posix.selinux:
            policy: targeted
            state: enforcing

    - name: hardening | Enable AppArmor (enforcing)
      ansible.builtin.service:
        name: apparmor
        state: restarted
        enabled: true
      when: ansible_apparmor.status != 'enforcing'


