---
- name: Ensure old versions of Docker are not installed
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  block:
    - name: Add the Docker GPG key
      get_url:
        url: "{{ docker_yum_gpg_key }}"
        dest: /etc/pki/rpm-gpg/KEY-Docker
  when: docker_add_repo|bool

- name: Add Docker repository
  block:
    - name: Download and install the Docker repository file
      get_url:
        url: "{{ docker_yum_repo_url }}"
        dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
        owner: root
        group: root
        mode: '0644'
  when: docker_add_repo|bool

- name: Configure Docker Nightly repo
  block:
    - name: Enable or disable Docker nightly repository
      lineinfile:
        path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
        regexp: '^enabled=1$'
        line: "enabled={{ '1' if docker_yum_repo_enable_nightly|bool else '0' }}"
  when: docker_add_repo|bool

- name: Configure Docker Test repo
  block:
    - name: Enable or disable Docker test repository
      lineinfile:
        path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
        regexp: '^enabled=1$'
        line: "enabled={{ '1' if docker_yum_repo_enable_test|bool else '0' }}"
  when: docker_add_repo|bool

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is not installed
      yum:
        name: runc
        state: absent
    - name: Ensure container-selinux is installed
      yum:
        name: container-selinux
        state: present
    - name: Ensure containerd.io is installed
      yum:
        name: containerd.io
        state: present
  when: ansible_distribution_major_version == '8'


