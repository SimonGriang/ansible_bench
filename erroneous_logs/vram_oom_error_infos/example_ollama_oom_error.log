  file:
    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  file:
    path: /etc/apt/sources.list.d/docker-{{ ansible_distribution|lower }}.list
    state: absent

- name: Ensure old versions of Docker are not installed.
  package:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Ensure legacy repo file is not present.
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure dependencies are installed.
  package:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository.
  apt_repository:
    repo: "{{ docker_repo }}"
    state: "{{ 'present' if docker_add_repo == 'true' else 'absent' }}"
    filename: docker
    update_cache: false
    apt_key_url: "{{ docker_gpg_key }}"
  notify: update apt cache

- name: Ensure handlers are notified immediately to update the apt cache.
  meta: flush_handlers

- name: update apt cache
  apt:
    update_cache: true
  listen: true


