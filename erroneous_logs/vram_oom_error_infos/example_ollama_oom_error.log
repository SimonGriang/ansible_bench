    group: "{{ item.group }}"
  loop:
    - { path: "/var/named", mode: '0755', owner: 'named', group: 'named' }
    - { path: "/etc/named", mode: '0750', owner: 'named', group: 'named' }
- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present
- name: Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    system: yes
    state: present
- name: Generate rndc key
  ansible.builtin.command:
    cmd: rndc-confgen -a -c /etc/named/rndc.key
  args:
    creates: /etc/named/rndc.key
- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: /etc/named/rndc.key
    owner: named
    group: named
    mode: 0640
- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ named_root_url }}"
    dest: /var/named/named.root
    owner: named
    group: named
    mode: 0644
  when: dns_caching_dns | bool
  notify: Rndc reload
- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: /var/named/{{ item }}
    owner: named
    group: named
    mode: 0644
  loop: "{{ zone_files }}"
  when: dns_zone_type | default('primary') in ['primary', 'undefined']
  notify: Rndc reload
- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/named.conf
    owner: named
    group: named
    mode: 0644
  notify: [Restart dns, Rndc reload]
- name: Place systemd override
  ansible.builtin.template:
    src: named.service.j2
    dest: /etc/systemd/system/named.service.d/override.conf
    owner: root
    group: root
    mode: 0644
  when: ansible_service_mgr == 'systemd'
  notify: Reload systemd daemon
- name: Start and enable dns
  ansible.builtin.service:
    name: named
    state: started
    enabled: yes


