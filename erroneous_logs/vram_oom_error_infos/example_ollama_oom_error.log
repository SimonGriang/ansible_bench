  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap facts (I) based on the output of /etc/os-release
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_major_version: "{{ item.major }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is search('(?i){{ item.search | default(item) }}')
  loop: "{{ bootstrap_os_family_map }}"

- name: Set bootstrap facts (II) to determine the OS family
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  when:
    - bootstrap_distribution is defined
    - item.value is search(bootstrap_distribution)
  loop: "{{ bootstrap_os_family_map | dict2items }}"


