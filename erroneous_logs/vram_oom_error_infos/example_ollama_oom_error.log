---
- name: Get efi path
  ansible.builtin.stat:
    path: /sys/firmware/efi/efivars
  register: efi_path

- name: Remove unwanted grub.cfg on EFI systems
  ansible.builtin.file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_path.stat.exists

- name: Install user template
  ansible.builtin.copy:
    src: user_template
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: '0755'
  notify: Update grub

- name: EFI | add password
  ansible.builtin.lineinfile:
    path: /boot/efi/EFI/*/grub.cfg
    regexp: '^set superusers="root"$'
    line: 'set superusers="root"'
    state: present
  when: efi_path.stat.exists
  notify: Update grub

- name: MBR | add password
  ansible.builtin.lineinfile:
    path: /boot/grub2/grub.cfg
    regexp: '^set superusers="root"$'
    line: 'set superusers="root"'
    state: present
  when: not efi_path.stat.exists
  notify: Update grub

- name: Add --unrestricted
  ansible.builtin.replace:
    path: "{{ item }}"
    regexp: '^password_pbkdf2 root .*$'
    replace: 'password_pbkdf2 --unrestricted root $1$uX2fJL2N$S4o7QyJwQ9XyS8uLJ2Fq5.'
    backup: yes
  when: grub_password_unrestricted is defined and grub_password_unrestricted | bool
  with_items: "{{ grub_password_unrestricted_files }}"
  notify: Update grub


