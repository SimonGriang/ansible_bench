---
- name: check if all variables have been set correctly
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: wait for host (when configured)
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    host: "{{ inventory_hostname }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: prepare system
  block:
    - name: test connection
      raw: echo "Connection test succeeded"
    - name: log connection failure
      block:
        - name: log note
          debug:
            msg: "Connection failure detected"
      when: ansible_failed_result is defined
    - name: gather bootstrap facts (raw)
      raw: uname -a
    - name: install bootstrap packages (raw)
      raw: "{{ bootstrap_install.raw }}"
      when: >
        bootstrap_os_family is defined and
        bootstrap_install.raw is defined

- name: ensure system is prepared by issuing ansible modules.
  block:
    - name: gather ansible facts
      setup:
    - name: install bootstrap packages using package module
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages.split() }}"


