---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  package:
    name: mysql
    state: present
  notify:
    - set root password
    - re-exec mysql daemon

- name: Configure mysql server
  ini_file:
    dest: /etc/mysql/my.cnf
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  with_items: "{{ mysql_configuration_options }}"
  notify: restart mysql

- name: Configure mysql client
  ini_file:
    dest: /etc/mysql/client.cnf
    section: client
    option: socket
    value: /var/run/mysqld/mysqld.sock

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux'

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: not initial_import is defined

- name: List databases
  mysql_info:
  register: mysql_info

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: imported
    target: "{{ item.target }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined and not mysql_info.databases[item.name] is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


