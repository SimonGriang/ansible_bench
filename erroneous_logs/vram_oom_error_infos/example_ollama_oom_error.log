---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Check if status is defined and connection type is not container, docker, or community.docker.docker
      set_fact:
        selinux_configured: "{{ (status is defined and (ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker')) }}"
    - name: Configure SELinux if conditions are met
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      when: selinux_configured | bool
      notify: Reboot
  when: status is defined and ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Manage selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  notify: Reboot

- name: Manage selinux booleans
  selinux:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: "{{ item.persistent }}"
  with_items: "{{ selinux_booleans }}"
  when: selinux_booleans is defined


