---
- name: hardening | Disable swap
  block:
    - name: hardening | Disable swap now
      command: swapoff -a
      when: ansible_swaptotal_mb > 0
    - name: hardening | Disable swap permanently
      lineinfile:
        path: /etc/fstab
        regexp: '^.*swap.*'
        state: absent
      when: ansible_swaptotal_mb > 0
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps
  sysctl:
    name: fs.suid_dumpable
    value: 0
    state: present
  notify:
    - reload sysctl
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  block:
    - name: Create shell script to disable recording of certain commands in shell history
      copy:
        content: |
          export HISTIGNORE="ls:cd:pwd"
          export HISTCONTROL="ignorespace:ignoredups"
        dest: /etc/profile.d/disable_shell_history.sh
      notify:
        - restart ssh
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  block:
    - name: hardening | Enable SELinux
      block:
        - name: hardening | Install selinux-policy
          package:
            name: selinux-policy
            state: present
        - name: hardening | Set SELinux policy
          selinux:
            policy: targeted
            state: enforcing
      when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == 'enabled'
    - name: hardening | Enable AppArmor (enforcing)
      apparmor:
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor and ansible_apparmor.status == 'enabled'
  when: vault_hardening_configure_selinux_apparmor

- name: reload sysctl
  systemd:
    daemon_reload: true
    state: restarted
    name: systemd-sysctl

- name: restart ssh
  service:
    name: ssh
    state: restarted


