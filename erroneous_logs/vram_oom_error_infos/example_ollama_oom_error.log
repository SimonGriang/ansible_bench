---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    system: true
    state: present

- name: Create Vault user
  user:
    name: vault_user
    system: true
    shell: "{{ vault_user_shell }}"
    home: /nonexistent
    group: "{{ vault_group }}"
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}/vault.zip"
    mode: '0644'
  notify: restart vault
  become: true
  register: vault_binary_downloaded
  changed_when: vault_binary_downloaded.changed

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  when: vault_check_path.stat is not defined or not vault_check_path.stat.exists or vault_check_path.stat.isdir

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
    state: directory
  with_items: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
    state: directory
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_path }}/tls/tls.crt"
    privatekey_path: "{{ vault_path }}/tls/tls.key"
    csr_path: "{{ vault_path }}/tls/tls.csr"
    provider: selfsigned
    generate_csr: true
    type: cert
    privatekey_size: 2048
  notify: restart vault
  become: true
  when: not (ansible_facts.filesystem_mounts[vault_path].exists and ansible_facts.filesystem_mounts[vault_path].is_directory)

- name: Set ownership of tls material
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: '0755'
  notify: restart vault
  become: true
  register: vault_binary_copied
  changed_when: vault_binary_copied.changed

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  file:
    path: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
    capabilities: 'cap_ipc_lock=ep'
  notify: restart vault
  become: true
  changed_when: false

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    state: touch
  notify: restart vault
  become: true

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: '0755'
    state: directory
  become: true

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify:
    - restart vault
    - reload daemon
  when: ansible_facts.systemd_mgr is defined and ansible_facts.systemd_mgr
  become: true

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: restart vault
  become: true

- name: Flush handlers
  meta: flush_handlers


