stat.exists\n\n- block:\n  - name: Check if the package manager is pacman\n    stat:\n      path: /usr/bin/pacman\n    register: pacman_check\n\n  - name: Update pacman cache and upgrade all software\n    become: yes\n    pacman:\n      name: \'*\'\n      state: latest\n      update_cache: yes\n    notify: Reboot system\n    when: pacman_check.stat.exists\n\n- block:\n  - name: Check if the package manager is yum\n    stat:\n      path: /usr/bin/yum\n    register: yum_check\n\n  - name: Update yum software\n    become: yes\n    yum:\n      name: \'*\'\n      state: latest\n      exclude: "{{ yum_excluded_packages }}"\n    notify: Reboot system\n    when: yum_check.stat.exists\n\n- block:\n  - name: Check distribution major version\n    shell: lsb_release -rs\n    register: distro_version\n\n  - name: Update yum non-6\n    become: yes\n    yum:\n      name: [\'@*\', \'yum-utils\']\n      state: latest\n    when: yum_check.stat.exists and distro_version.stdout.split(\'.\')[0] != \'6\'\n\n- block:\n  - name: Check if the package manager is zypper\n    stat:\n      path: /usr/bin/zypper\n    register: zypper_check\n\n  - name: Update all software (zypper)\n    become: yes\n    zypper:\n      name: \'*\'\n      state: latest\n    notify: Reboot system\n    when: zypper_check.stat.exists' additional_kwargs={} response_metadata={'model': 'qwen2.5:32b', 'created_at': '2025-09-29T13:32:12.640816236Z', 'done': True, 'done_reason': 'stop', 'total_duration': 88138061124, 'load_duration': 96066383, 'prompt_eval_count': 654, 'prompt_eval_duration': 1293470165, 'eval_count': 877, 'eval_duration': 86737291404, 'model_name': 'qwen2.5:32b'} id='run--0c419287-5299-4073-9425-23cb221dea5b-0' usage_metadata={'input_tokens': 654, 'output_tokens': 877, 'total_tokens': 1531}
