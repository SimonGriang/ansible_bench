  when: externally_managed_file_py312.stat.exists and not externally_managed_file_py312.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip
  pip:
    name: "{{ python_pip_packages }}"

- name: Configure pip proxy
  block:
    - name: Configure pip proxy in pip configuration file
      lineinfile:
        path: /etc/pip.conf
        line: "proxy = {{ python_pip_proxy }}"
        state: present
  when: python_pip_proxy is defined

- name: Trust hosts
  block:
