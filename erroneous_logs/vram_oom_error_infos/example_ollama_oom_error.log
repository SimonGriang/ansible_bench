---
- import_tasks: assert.yml
  tags: assert

- block:
    - name: Check if the package manager is apk
      stat:
        path: /sbin/apk
      register: apk_check

    - name: Update apk cache and upgrade all software
      become: true
      apk:
        update_cache: true
        upgrade: true
      notify: Reboot system
      when: apk_check.stat.exists

- block:
    - name: Check if the package manager is apt
      stat:
        path: /usr/bin/apt-get
      register: apt_check

    - name: Prevent upgrade for selected packages
      apt:
        name: "{{ item }}"
        state: held
      loop: "{{ update_excluded_packages }}"
      when: apt_check.stat.exists

- block:
    - name: Update apt package cache and upgrade all software
      become: true
      apt:
        update_cache: true
        upgrade: dist
        autoclean: true
        autoremove: true
        dpkg_options: '--force-confold'
        cache_valid_time: 3600
        install_recommends: false
        upgrade_command: '/usr/bin/apt-get -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confnew -o APT::Get::force-yes=true -fuy dist-upgrade'
        force_yes: true
      notify: Reboot system
      when: apt_check.stat.exists

- block:
    - name: Autoremove unused packages (apt)
      become: true
      apt:
        autoclean: true
        autoremove: true
        dpkg_options: '--force-confold'
        cache_valid_time: 3600
        install_recommends: false
        force_yes: true
      notify: Reboot system
      when: apt_check.stat.exists and autoremove

- block:
    - name: Check if the package manager is dnf or dnf5
      stat:
        path: /usr/bin/dnf
      register: dnf_check

    - name: Check if the package manager is dnf5
      stat:
        path: /usr/bin/dnf5
      register: dnf5_check

    - name: Update all software (dnf)
      become: true
      dnf:
        name: '*'
        state: latest
        exclude: "{{ dnf_excluded_packages }}"
      notify: Reboot system
      when: dnf_check.stat.exists or dnf5_check.stat.exists

- block:
    - name: Check if the package manager is pacman
      stat:
        path: /usr/bin/pacman
      register: pacman_check

    - name: Update pacman cache and upgrade all software
      become: true
      pacman:
        name: '*'
        state: latest
        update_cache: true
      notify: Reboot system
      when: pacman_check.stat.exists

- block:
    - name: Check if the package manager is yum
      stat:
        path: /usr/bin/yum
      register: yum_check

    - name: Update yum software
      become: true
      yum:
        name: '*'
        state: latest
        exclude: "{{ yum_excluded_packages }}"
      notify: Reboot system
      when: yum_check.stat.exists

- block:
    - name: Check distribution major version
      shell: lsb_release -rs
      register: distro_version

    - name: Update yum non-6
      become: true
      yum:
        name: ['@*', 'yum-utils']
        state: latest
      when: yum_check.stat.exists and distro_version.stdout.split('.')[0] != '6'

- block:
    - name: Check if the package manager is zypper
      stat:
        path: /usr/bin/zypper
      register: zypper_check

    - name: Update all software (zypper)
      become: true
      zypper:
        name: '*'
        state: latest
      notify: Reboot system
      when: zypper_check.stat.exists


