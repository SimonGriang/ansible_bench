---
- name: Import tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    host: "{{ inventory_hostname }}"
  when: not (bootstrap_connected_via_container or
             bootstrap_connected_via_docker or
             not bootstrap_wait_for_host)

- name: Prepare system
  block:
    - name: Test connection and sudo capability
      ansible.builtin.raw: uptime
      check_mode: false
      become: false
      changed_when: false

    - name: Gather bootstrap facts and install bootstrap packages if setup fails
      block:
        - name: Gather bootstrap facts
          ansible.builtin.setup:
            filter: ansible_all_ipv4_addresses
          register: bootstrap_facts
          become: false

        - name: Install bootstrap packages using raw commands
          ansible.builtin.raw: "{{ item }}"
          loop: "{{ bootstrap_facts_packages }}"
          check_mode: false
          become: "{{ bootstrap_become }}"
          changed_when: false
      when: ansible_os_family != "Debian" and
            ansible_os_family != "RedHat"
      rescue:
        - name: Debug message for system preparation failure
          ansible.builtin.debug:
            msg: "System preparation failed, skipping further tasks."

- name: Gather ansible facts
  ansible.builtin.setup:
  become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


