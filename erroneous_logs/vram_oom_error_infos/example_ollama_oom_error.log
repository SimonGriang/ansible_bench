---
- name: Load OS-specific vars
  include_vars: "{{ item }}"
  with_first_found:
    - files:
        - "{{ ansible_distribution }}.yml"
        - "{{ ansible_os_family }}.yml"
        - main.yml
      abs_path: "{{ role_path }}/vars"

- name: Include tasks for RedHat setup
  block:
    - name: Include RedHat setup tasks
      include_tasks: redhat_setup.yml
  when: ansible_os_family == 'RedHat'

- name: Include tasks for Debian setup
  block:
    - name: Include Debian setup tasks
      include_tasks: debian_setup.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    notify: restart docker
  ignore_errors: true
  when: >
    (ansible_version.major + '.' + ansible_version.minor < '2.12') or
    ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    notify: restart docker
    allow_downgrade: yes
  ignore_errors: true
  when: >
    (ansible_version.major + '.' + ansible_version.minor >= '2.12') and
    ansible_os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    notify: restart docker
  ignore_errors: true
  when: >
    docker_install_compose_plugin and
    ((ansible_version.major + '.' + ansible_version.minor < '2.12') or
    ansible_os_family not in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    notify: restart docker
    allow_downgrade: yes
  ignore_errors: true
  when: >
    docker_install_compose_plugin and
    ((ansible_version.major + '.' + ansible_version.minor >= '2.12') and
    ansible_os_family in ['RedHat', 'Debian'])

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options

- name: Configure Docker daemon options
  block:
    - name: Ensure /etc/docker/daemon.json exists
      copy:
        content: "{{ docker_daemon_options | to_nice_json }}"
        dest: /etc/docker/daemon.json
        owner: root
        group: root
        mode: '0644'
        validate: json -q %
      notify: restart docker
  when: docker_daemon_options

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true
  when: docker_service_manage

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include tasks for Docker Compose setup
  include_tasks: compose_setup.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info
  when: docker_users

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: true
  when: (docker_users | difference(docker_group_info.gid.members)) | length > 0

- name: Include tasks for managing Docker users
  include_tasks: manage_docker_users.yml
  when: at_least_one_user_to_modify is defined


