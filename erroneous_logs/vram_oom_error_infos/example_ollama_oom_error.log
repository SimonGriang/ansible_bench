---
- name: Check current docker-compose version
  command: docker-compose version --short
  register: docker_compose_version

- name: Extract current docker-compose version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version.stdout }}"
  when: docker_compose_version.stdout is defined and docker_compose_version.stdout != ''

- name: Delete existing docker-compose if version is different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is defined and current_docker_compose_version != '{{ desired_docker_compose_version }}'

- name: Install Docker Compose (if configured)
  get_url:
    url: "{{ docker_compose_download_url }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: current_docker_compose_version is undefined or current_docker_compose_version == '' or current_docker_compose_version < '{{ desired_docker_compose_version }}'


