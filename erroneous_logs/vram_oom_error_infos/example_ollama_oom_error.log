- name: Install epel
  block:
    - name: Install epel gpg key
      yum:
        name: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
        state: present
      when: ansible_os_family == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9'] or ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'
      vars:
