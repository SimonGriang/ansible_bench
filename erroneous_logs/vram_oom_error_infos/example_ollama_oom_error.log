---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "{{ helm_bin_path }} version"
  register: helm_existing_version
  ignore_errors: true

- name: Download helm
  ansible.builtin.get_url:
    url: "https://example.com/helm-{{ helm_version }}.tar.gz"
    dest: "/tmp/helm.tar.gz"
    validate_certs: yes
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout.find(helm_version) == -1

- name: Copy helm binary into place
  become: yes
  copy:
    src: /tmp/helm.tar.gz
    dest: "{{ helm_bin_path }}"
    mode: '0755'
  when: helm_download is changed


