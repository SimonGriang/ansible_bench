---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection is search('ssh|docker') and bootstrap_wait_for_host|bool

- name: Prepare system
  block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      delegate_to: "{{ inventory_hostname }}"
      become: "{{ bootstrap_become | bool }}"
      become_method: sudo

    - name: Test if sudo is available
      raw: sudo -n uptime
      register: sudo_test
      ignore_errors: true

    - name: Gather bootstrap facts and install packages
      block:
        - name: Gather bootstrap facts
          setup:

        - name: Install packages using raw
          raw: apt-get update && apt-get install -y {{ item }}
          loop: "{{ bootstrap_facts_packages.split(',') }}"
      when: sudo_test is failed

- name: Gather ansible facts
  setup:
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  become: "{{ bootstrap_become | bool }}"
  loop: "{{ bootstrap_facts_packages.split(',') }}"


