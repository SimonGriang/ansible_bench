---
- name: Import assert tasks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ service_required_packages }}"
    state: present
  notify:
    - gather facts

- name: Configure systemd service
  ansible.builtin.template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: '0644'
  when: service_manager == 'systemd'
  with_items: "{{ service_list }}"
  notify:
    - reload systemd daemon

- name: Configure sysvinit service
  ansible.builtin.template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: '0755'
  when: service_manager in ['sysvinit', 'upstart', 'openrc']
  with_items: "{{ service_list }}"

- name: Manage service
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state | default('started') }}"
    enabled: "{{ item.enabled | default(True) }}"
  with_items: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


