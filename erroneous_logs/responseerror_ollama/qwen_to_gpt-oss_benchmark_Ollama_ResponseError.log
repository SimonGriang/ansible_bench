---
- name: "Task 1: Import assert.yml"
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: "Task 2: Install docker-compose package"
  package:
    name: docker-compose
    state: present
  when: installation_type == 'package'

- name: "Task 3: Install docker-compose as a binary"
  shell: |
    if command -v yum > /dev/null 2>&1; then
      yum -y install curl
    elif command -v apt-get > /dev/null 2>&1; then
      apt-get update
      apt-get -y install curl
    fi
    url_part1="https://github.com/docker/compose/releases/download/"
    url_part2a="{{ docker_compose_version }}/docker-compose-{{ ansible_system | lower }}"
    url_part2b="-{{ ansible_architecture | lower }}"
    curl -L "$url_part1$url_part2a$url_part2b" -o /usr/local/bin/docker-compose
    chmod 0755 /usr/local/bin/docker-compose
  args:
    creates: /usr/local/bin/docker-compose
  when: installation_type == 'binary'


