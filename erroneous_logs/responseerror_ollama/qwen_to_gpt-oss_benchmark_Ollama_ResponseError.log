---  
- name: Create Vault group  
  ansible.builtin.group:  
    name: "{{ vault_group }}"  
    state: present  

- name: Create Vault user  
  ansible.builtin.user:  
    name: "{{ vault_user }}"  
    system: true  
    home: /nonexistent  
    create_home: false  
    shell: "{{ vault_user_shell }}"  
    groups: "{{ vault_group }}"  
    state: present  

- name: Create Vault download directory  
  ansible.builtin.file:  
    path: "{{ vault_download_path }}"  
    state: directory  
    mode: '0755'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  

- name: Download Vault binary  
  ansible.builtin.unarchive:  
    src: "{{ vault_download_url }}"  
    dest: "{{ vault_download_path }}"  
    remote_src: true  
    owner: root  
    group: root  
    mode: '0755'  

- name: Check if vault_path exists  
  ansible.builtin.stat:  
    path: "{{ vault_path }}"  
  register: vault_path_stat  

- name: Create vault_path if it does not exist  
  ansible.builtin.file:  
    path: "{{ vault_path }}"  
    state: directory  
    mode: '0755'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  
  when: not vault_path_stat.stat.exists and vault_path is defined  

- name: Create directories in vault_data_directories  
  ansible.builtin.file:  
    path: "{{ item }}"  
    state: directory  
    mode: '0755'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  
  loop: "{{ vault_data_directories }}"  

- name: Create directories in vault_data_directories  
  ansible.builtin.file:  
    path: "{{ item }}"  
    state: directory  
    mode: '0755'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  
  loop: "{{ vault_data_directories }}"  

- name: Generate TLS key and certificate  
  community.crypto.x509_certificate:  
    path: "{{ vault_data_directory }}/tls/vault.crt"  
    privatekey_path: "{{ vault_data_directory }}/tls/vault.key"  
    provider: selfsigned  
    subject: "/CN=localhost"  
    days: 1095  
    state: present  
  notify: Restart vault  

- name: Set ownership of tls material  
  ansible.builtin.file:  
    path: "{{ item.path }}"  
    owner: "{{ item.owner }}"  
    group: "{{ item.group }}"  
    mode: '0600'  
  loop: "{{ vault_tls_files }}"  

- name: Copy vault binary to target location  
  ansible.builtin.copy:  
    src: "{{ vault_download_path }}/vault"  
    dest: "{{ vault_path }}/usr/bin/vault"  
    mode: '0644'  
  notify: Restart vault  

- name: Set setcap for vault binary  
  ansible.builtin.setcap:  
    path: "{{ vault_path }}/usr/bin/vault"  
    capability: cap_setuid+ep  
  changed_when: false  

- name: Create directories in vault_data_directories  
  ansible.builtin.file:  
    path: "{{ item }}"  
    state: directory  
    mode: '0755'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  
  loop: "{{ vault_data_directories }}"  

- name: Create directories in vault_data_directories  
  ansible.builtin.file:  
    path: "{{ item }}"  
    state: directory  
    mode: '0755'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  
  loop: "{{ vault_data_directories }}"  

- name: Touch vault.env  
  ansible.builtin.file:  
    path: "{{ vault_path }}/etc/vault.env"  
    state: touch  
    mode: '0644'  
    owner: "{{ vault_user }}"  
    group: "{{ vault_group }}"  

- name: Set ownership of tls material  
  ansible.builtin.file:  
