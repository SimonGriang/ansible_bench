    name: epel-release
    state: present
    update_cache: true

- name: Install epel gpg key
  rpm_key:
    state: present
    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-9

- name: Install epel-release
  yum:
    name: epel-release
    state: present

- name: Install epel-next-release
  yum:
    name: epel-next-release
    state: present
  when: epel_next | bool
  notify: update package cache


