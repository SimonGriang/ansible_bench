---
- name: hardening | Disable swap
  become: true
  command: swapoff -a
  when: vault_hardening_disable_swap | bool

- name: hardening | Disable swap now
  become: true
  command: swapoff -a
  when: vault_hardening_disable_swap | bool

- name: hardening | Disable swap permanently
  become: true
  lineinfile:
    path: /etc/fstab
    regexp: '^\s*[^#]*\s+swap\s+'
    line: '# \0'
    state: present
  when: vault_hardening_disable_swap | bool

- name: hardening | Disable core dumps
  become: true
  copy:
    dest: /etc/security/limits.d/10-disable-core-dump.conf
    content: |
      * hard core 0
      @* hard core 0
  when: vault_hardening_disable_core_dumps | bool

- name: hardening | Disable Shell Command History
  become: true
  copy:
    dest: /etc/profile.d/disable_history.sh
    mode: '0644'
    content: |
      HISTSIZE=0
      HISTFILESIZE=0
      export HISTSIZE HISTFILESIZE
  when: vault_hardening_disable_shell_command_history | bool

- name: hardening | Configure SELinux / AppArmor
  become: true
  debug:
    msg: "Configuring SELinux and AppArmor"
  when: vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Enable SELinux
  become: true
  selinux:
    policy: targeted
    state: enforcing
  when: vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Install selinux-policy
  become: true
  package:
    name: selinux-policy
    state: present
  when: vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Set SELinux policy
  become: true
  selinux:
    policy: targeted
    state: enforcing
  when: vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Enable AppArmor (enforcing)
  become: true
  shell: aa-enforce /etc/apparmor.d/usr.bin.vault
  args:
    warn: false
  when: vault_hardening_configure_selinux_apparmor | bool


