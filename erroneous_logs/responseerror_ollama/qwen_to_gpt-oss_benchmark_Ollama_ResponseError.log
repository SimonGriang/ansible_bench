---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install vsftpd
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd/vsftpd.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart vsftpd

- name: Start and enable vsftpd
  service:
    name: vsftpd
    state: started
    enabled: true


