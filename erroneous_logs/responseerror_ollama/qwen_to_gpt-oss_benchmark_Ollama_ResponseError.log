---
- name: Cadvisor | create directories
  ansible.builtin.file:
    path: "{{ cadvisor_install_dir | default('/opt/cadvisor') }}"
    state: directory
    mode: '0755'

- name: Cadvisor | download
  ansible.builtin.get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "{{ cadvisor_install_dir | default('/opt/cadvisor') }}/cadvisor"
    mode: '0755'
    checksum: "{{ cadvisor_checksum }}"
  when: cadvisor_local_bin is not defined

- name: Cadvisor | propagate locally distributed cadvisor binary
  ansible.builtin.copy:
    src: "{{ cadvisor_local_bin }}/cadvisor"
    dest: "{{ cadvisor_install_dir | default('/opt/cadvisor') }}/cadvisor"
    mode: '0755'
  notify: cadvisor_restart
  when: cadvisor_local_bin is defined

- name: Cadvisor | symlink
  ansible.builtin.file:
    src: "{{ cadvisor_install_dir | default('/opt/cadvisor') }}/cadvisor"
    dest: /usr/local/bin/cadvisor
    state: link

- name: Cadvisor | server systemd service
  ansible.builtin.template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'

- name: Test_task
  ansible.builtin.service_info:
    name: cadvisor
  register: service_active
  changed_when: false

- name: Debug: var=service_active
  ansible.builtin.debug:
    var: service_active

- name: Cadvisor | enable server systemd
  ansible.builtin.service:
    name: cadvisor
    enabled: true

- name: Cadvisor | start server systemd
  ansible.builtin.service:
    name: cadvisor
    state: started


