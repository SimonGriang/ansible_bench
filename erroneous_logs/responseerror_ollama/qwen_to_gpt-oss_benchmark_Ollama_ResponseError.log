---
- name: hardening | Disable swap
  become: true
  ansible.builtin.command: swapoff -a
  when: vault_hardening_disable_swap | bool
  changed_when: false

- name: hardening | Disable swap now
  become: true
  ansible.builtin.command: swapoff -a
  when: vault_hardening_disable_swap | bool
  changed_when: false

- name: hardening | Disable swap permanently
  become: true
  ansible.builtin.lineinfile:
    path: /etc/fstab
    regexp: '^\s*[^#]*\s+swap\s+'
    line: '# \0'
  when: vault_hardening_disable_swap | bool

- name: hardening | Disable core dumps
  become: true
  ansible.builtin.copy:
    dest: /etc/security/limits.d/10-disable-core-dump.conf
    content: |
      * hard core 0
      @* hard core 0
    mode: '0644'
  when: vault_hardening_disable_core_dumps | bool

- name: hardening | Disable Shell Command History
  become: true
  ansible.builtin.copy:
    dest: /etc/profile.d/disable_history.sh
    mode: '0644'
    content: |
      HISTSIZE=0
      HISTFILESIZE=0
      export HISTSIZE HISTFILESIZE
  when: vault_hardening_disable_shell_command_history | bool

- name: hardening | Configure SELinux / AppArmor
  become: true
