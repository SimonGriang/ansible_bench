---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ dns_directories }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    system: yes

- name: Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    system: yes
    shell: /usr/sbin/nologin
    create_home: no

- name: Generate rndc key
  command: "rndc-confgen -a -c {{ rndc_key_path }} -b 256"
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_path }}"
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'

- name: Create zone file
  template:
    src: "zone.j2"
    dest: "{{ dns_zone_dir }}/{{ dns_zone_file }}"
    mode: '0644'

- name: Add zones to configuration
  template:
    src: "named.conf.zones.j2"
    dest: "/etc/named.conf"
    mode: '0644'

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: "/etc/systemd/system/{{ dns_service_name }}.service.d"
        state: directory
        mode: '0755'
    - name: Place systemd override file
      template:
        src: "systemd_override.conf.j2"
        dest: "/etc/systemd/system/{{ dns_service_name }}.service.d/override.conf"
        mode: '0644'

- name: Start and enable dns
  service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: yes


