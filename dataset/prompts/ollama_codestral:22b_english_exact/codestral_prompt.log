    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify:
    - Restart redis

- name: Start and enable redis
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true

