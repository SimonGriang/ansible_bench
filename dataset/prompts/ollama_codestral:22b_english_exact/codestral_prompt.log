    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    regexp: "^MAILTO"
    create: true
    mode: "0600"
  notify:
    - Restart cron

- name: Start and enable cron
  ansible.builtin.service:
