    - name: Manage selinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state | default('yes') }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"
      when:
        - selinux_booleans is defined

