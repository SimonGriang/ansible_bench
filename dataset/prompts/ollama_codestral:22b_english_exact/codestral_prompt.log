# tasks file for epel

- name: Install epel
  when:
    - (ansible_distribution == "Amazon" and
      ansible_distribution_major_version == "2") or
      (ansible_os_family == "RedHat" and
      ansible_distribution_major_version in [ "7", "8", "9", "10" ])
  block:
