- name: "Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11"
  alternatives:
    name: java
    path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
