    replace: 'GRUB_CMDLINE_LINUX="\1 {{ item.option }}={{ item.value }}"'
    validate: /bin/sh %s
    mode: "0664"
  loop: "{{ grub_options }}"
  loop_control:
    label: "{{ item.option }}"
  notify:
    - Update grub
  when:
    - grub_options is defined
    - grub_options | length > 0

- name: Import password.yml
  ansible.builtin.import_tasks: password.yml
  when:
    - grub_set_password

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


