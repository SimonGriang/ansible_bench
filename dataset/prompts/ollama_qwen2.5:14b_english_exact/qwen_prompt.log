- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.raw: "cat /etc/os-release"
  become: false
  check_mode: false
  register: bootstrap_facts
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
