    - "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"

- name: Java | Gather architecture specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - "architecture.yml"

