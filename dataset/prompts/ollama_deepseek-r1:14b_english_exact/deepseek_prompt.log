  loop_control:
    label: "{{ item.name }}"

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when:
