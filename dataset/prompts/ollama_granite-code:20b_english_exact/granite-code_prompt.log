    creates: "{{ users_ssh_key_directory }}/{{ user.name }}"
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key
  loop_control:
    label: "{{ user.name }}"
  delegate_to: localhost
  become: false

- name: user | Generate public ssh key for {{ user.name }}
